{
  "name": "e-learning_test",
  "version": "0.0.1",
  "description": "<p align=\"center\">\r   <a href=\"http://nestjs.com/\" target=\"blank\"><img src=\"https://nestjs.com/img/logo-small.svg\" width=\"120\" alt=\"Nest Logo\" /></a>\r </p>",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:editor": "esbuild src/common/public/js/editor.js --bundle --outfile=src/common/public/assets/editor.bundle.js --minify",
    "build:script": "esbuild src/common/public/js/alpine.js --bundle --outfile=src/common/public/assets/main.js --minify",
    "build": "nest build && npm run build:css:prod && npm run build:script && npm run build:editor",
    "build:css": "tailwindcss -i ./src/common/public/style.css -o ./src/common/public/css/style.css --watch",
    "build:css:prod": "tailwindcss -i ./src/common/public/style.css -o ./src/common/public/css/style.css --minify",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "concurrently \"npm run build:css\" \"npm run build:script\" \"npm run build:editor\" \"nest start --watch\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:generate": "npm run build && npx typeorm-ts-node-commonjs migration:generate -d ./src/data-source.ts",
    "migration:create": "npx typeorm-ts-node-commonjs migration:create",
    "migration:run": "npm run build && npx typeorm-ts-node-commonjs migration:run -d ./src/data-source.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d ./src/data-source.ts",
    "migrate:run": "npm run build && npx typeorm-ts-node-commonjs migration:run -d ./src/data-source.ts",
    "migrate:revert": "npx typeorm-ts-node-commonjs migration:revert -d ./src/data-source.ts",
    "seed": "node dist/database/seeds/user.seed.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./src/data-source.ts"
  },
