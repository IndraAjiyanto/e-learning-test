<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <div class='mb-6'>
      <h2 class='text-2xl font-bold text-gray-900'>Create Log Book</h2>
    </div>

    <form
      action='/logbook/create/{{pertemuanId}}'
      method='POST'
      enctype='multipart/form-data'
      class='space-y-6'
      x-data="{
        errorMessage: '',
        isValid: true,
        fileName: '',
        fileSize: 0,
        hasFile: false,
        previewUrl: null,
        maxSize: 5 * 1024 * 1024,
        allowedTypes: ['image/jpeg', 'image/jpg', 'image/png'],
        allowedExtensions: ['.jpg', '.jpeg', '.png'],
        validateFile(file) {
          if (!file) {
            this.hasFile = false;
            this.previewUrl = null;
            return;
          }
          
          this.hasFile = true;
          this.fileName = file.name;
          this.fileSize = file.size;
          this.errorMessage = '';
          this.isValid = true;
          
          // Validasi ukuran file
          if (file.size > this.maxSize) {
            this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum ${(this.maxSize / 1024 / 1024).toFixed(0)}MB`;
            this.isValid = false;
            this.previewUrl = null;
            return;
          }
          
          // Validasi tipe file
          if (!this.allowedTypes.includes(file.type)) {
            this.errorMessage = `File type not allowed. Allowed: JPG, JPEG, PNG`;
            this.isValid = false;
            this.previewUrl = null;
            return;
          }
          
          // Validasi extension
          const fileName = file.name.toLowerCase();
          const hasValidExtension = this.allowedExtensions.some(ext => fileName.endsWith(ext));
          
          if (!hasValidExtension) {
            this.errorMessage = `File extension not allowed. Allowed: ${this.allowedExtensions.join(', ')}`;
            this.isValid = false;
            this.previewUrl = null;
            return;
          }
          
          // Create preview
          this.previewUrl = URL.createObjectURL(file);
        },
        clearFile() {
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '';
          this.fileSize = 0;
          this.hasFile = false;
          this.previewUrl = null;
          $refs.fileInput.value = null;
        },
        canSubmit() {
          return this.hasFile && this.isValid;
        }
      }"
      @submit.prevent="if(canSubmit()) { $el.submit(); } else { alert('Please select a valid image before submitting.'); }"
    >

      <!-- User Selection -->
      <div
        x-data="{
          open: false,
          search: '',
          selected: null,
          users: [
            {{#each users}}
              { id: {{this.id}}, username: '{{this.username}}', email: '{{this.email}}' },
            {{/each}}
          ],
          get filteredUsers() {
            if (!this.search) return this.users;
            return this.users.filter(user => 
              user.username.toLowerCase().includes(this.search.toLowerCase()) ||
              user.email.toLowerCase().includes(this.search.toLowerCase())
            );
          },
          selectUser(user) {
            this.selected = user;
            this.search = user.username;
            this.open = false;
          }
        }"
        @click.away="open = false"
        class="relative"
      >
        <label for="userId" class="block text-sm font-semibold text-gray-700 mb-1">
          Select User
        </label>
        <input type="hidden" name="userId" :value="selected ? selected.id : ''" required />
        <div class="relative">
          <input
            type="text"
            x-model="search"
            @focus="open = true"
            @input="open = true"
            placeholder="Search user..."
            class="w-full border bg-white border-gray-300 rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700"
            autocomplete="off"
          />
          <i class="fas fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
        </div>
        
        <div
          x-show="open"
          x-transition
          class="absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto"
        >
          <template x-if="filteredUsers.length === 0">
            <div class="px-4 py-3 text-sm text-gray-500">No users found</div>
          </template>
          <template x-for="user in filteredUsers" :key="user.id">
            <div
              @click="selectUser(user)"
              class="px-4 py-2 hover:bg-gray-100 cursor-pointer transition-colors"
              :class="{ 'bg-gray-50': selected && selected.id === user.id }"
            >
              <div class="font-medium text-gray-900" x-text="user.username"></div>
              <div class="text-xs text-gray-500" x-text="user.email"></div>
            </div>
          </template>
        </div>
      </div>

      <!-- Activity -->
      <div>
        <label
          for='kegiatan'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Activity</label>
        <input
          type='text'
          id='kegiatan'
          name='kegiatan'
          required
          placeholder='Enter activity...'
          class='w-full border text-gray-700 bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900'
        />
      </div>

      <!-- Activity Details -->
      <div>
        <label
          for='rincian_kegiatan'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Activity Details</label>
        <textarea
          name='rincian_kegiatan'
          id='rincian_kegiatan'
          rows="4"
          placeholder='Enter activity details...'
          class='w-full text-gray-700 bg-white border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900'
        ></textarea>
      </div>

      <!-- Obstacle -->
      <div>
        <label
          for='kendala'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Obstacle</label>
        <input
          type='text'
          id='kendala'
          name='kendala'
          required
          placeholder='Enter obstacle...'
          class='w-full border text-gray-700 bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900'
        />
      </div>

      <!-- Photo Documentation -->
      <div class='space-y-3'>
        <label
          for='dokumentasi'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Photo Documentation
          <span class='text-xs text-gray-500 font-normal'>(max 5MB, JPG/JPEG/PNG)</span>
        </label>

        <input
          type='file'
          id='dokumentasi'
          name='dokumentasi'
          accept='.jpg,.jpeg,.png'
          required
          x-ref='fileInput'
          :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border rounded-lg px-4 py-2 text-gray-700 focus:outline-none focus:ring-2 transition-colors file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-900 file:text-white hover:file:bg-gray-700 file:cursor-pointer'
          @change='validateFile($event.target.files[0])'
        />

        <!-- Error Message -->
        <template x-if='!isValid && errorMessage'>
          <div
            class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <div>
              <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
              <p class='text-xs text-red-700' x-text='errorMessage'></p>
            </div>
          </div>
        </template>

        <!-- Success Message with Preview -->
        <template x-if='hasFile && isValid && previewUrl'>
          <div class='space-y-2'>
            <div class='flex items-start gap-3 p-3 bg-green-50 border border-green-300 rounded-lg'>
              <i class='fas fa-check-circle text-green-500 mt-0.5'></i>
              <div class='flex-1'>
                <p class='text-sm font-semibold text-green-800'>Valid Image</p>
                <p class='text-xs text-green-700' x-text='`${fileName} (${(fileSize / 1024).toFixed(1)}KB)`'></p>
              </div>
              <button
                type='button'
                class='text-red-500 hover:text-red-700 transition-colors'
                @click='clearFile()'
                title='Remove image'
              >
                <i class='fas fa-times-circle'></i>
              </button>
            </div>
            
            <!-- Image Preview -->
            <div class='relative w-32 h-32'>
              <img
                :src='previewUrl'
                alt='Photo Preview'
                class='w-32 h-32 object-cover rounded-lg border-2 border-green-300 shadow-md'
              />
            </div>
          </div>
        </template>
      </div>

            <div>
        <label
          for='dokumentasi_lain'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Link Documentation</label>
        <input
          type='text'
          id='dokumentasi_lain'
          name='dokumentasi_lain'
          required
          placeholder='Enter link documentation...'
          class='w-full border text-gray-700 bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900'
        />
      </div>

      <!-- Buttons -->
      <div class='flex justify-start gap-3 pt-4'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Add Log Book
        </button>
        <a
          href='/logbook'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFile && !isValid'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix the image validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>