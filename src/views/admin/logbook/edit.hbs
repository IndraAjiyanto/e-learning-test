<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <div class='mb-6'>
      <h2 class='text-2xl font-bold mt-0 mb-0 text-gray-900 text-center'>Edit Log Book</h2>
    </div>

    <form
      action='/logbook/{{logbook.id}}?_method=PATCH'
      method='POST'
      enctype='multipart/form-data'
      class='space-y-6'
      x-data="{
        errorMessage: '',
        isValid: true,
        fileName: '{{#if logbook.dokumentasi}}Existing Image{{/if}}',
        fileSize: 0,
        hasFile: {{#if logbook.dokumentasi}}true{{else}}false{{/if}},
        previewUrl: '{{logbook.dokumentasi}}',
        maxSize: 5 * 1024 * 1024,
        allowedTypes: ['image/jpeg', 'image/jpg', 'image/png'],
        allowedExtensions: ['.jpg', '.jpeg', '.png'],
        validateFile(file) {
          if (!file) {
            this.hasFile = {{#if logbook.dokumentasi}}true{{else}}false{{/if}};
            this.previewUrl = '{{logbook.dokumentasi}}';
            this.fileName = '{{#if logbook.dokumentasi}}Existing Image{{/if}}';
            return;
          }
          
          this.hasFile = true;
          this.fileName = file.name;
          this.fileSize = file.size;
          this.errorMessage = '';
          this.isValid = true;
          
          // Validasi ukuran file
          if (file.size > this.maxSize) {
            this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum ${(this.maxSize / 1024 / 1024).toFixed(0)}MB`;
            this.isValid = false;
            this.previewUrl = '{{logbook.dokumentasi}}';
            return;
          }
          
          // Validasi tipe file
          if (!this.allowedTypes.includes(file.type)) {
            this.errorMessage = `File type not allowed. Allowed: JPG, JPEG, PNG`;
            this.isValid = false;
            this.previewUrl = '{{logbook.dokumentasi}}';
            return;
          }
          
          // Validasi extension
          const fileName = file.name.toLowerCase();
          const hasValidExtension = this.allowedExtensions.some(ext => fileName.endsWith(ext));
          
          if (!hasValidExtension) {
            this.errorMessage = `File extension not allowed. Allowed: ${this.allowedExtensions.join(', ')}`;
            this.isValid = false;
            this.previewUrl = '{{logbook.dokumentasi}}';
            return;
          }
          
          // Create preview
          this.previewUrl = URL.createObjectURL(file);
        },
        clearFile() {
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '{{#if logbook.dokumentasi}}Existing Image{{/if}}';
          this.fileSize = 0;
          this.hasFile = {{#if logbook.dokumentasi}}true{{else}}false{{/if}};
          this.previewUrl = '{{logbook.dokumentasi}}';
          $refs.fileInput.value = null;
        },
        canSubmit() {
          return this.hasFile && this.isValid;
        }
      }"
      @submit.prevent="if(canSubmit()) { $el.submit(); } else { alert('Please ensure a valid image is selected before submitting.'); }"
    >

      <!-- User Display (Read-only for edit) -->
      <div>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          User
        </label>
        <input
          type='text'
          value='{{logbook.user.username}} ({{logbook.user.email}})'
          readonly
          class='w-full border bg-gray-50 border-gray-300 rounded-lg px-4 py-2 text-gray-700 cursor-not-allowed'
        />
        <input type='hidden' name='userId' value='{{logbook.user.id}}' />
      </div>

      <!-- Activity -->
      <div>
        <label
          for='kegiatan'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Activity</label>
        <input
          type='text'
          id='kegiatan'
          name='kegiatan'
          required
          value='{{logbook.kegiatan}}'
          placeholder='Enter activity...'
          class='w-full border text-gray-700 bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900'
        />
      </div>

      <!-- Activity Details -->
      <div>
        <label
          for='rincian_kegiatan'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Activity Details</label>
        <textarea
          name='rincian_kegiatan'
          id='rincian_kegiatan'
          rows='4'
          placeholder='Enter activity details...'
          class='w-full text-gray-700 bg-white border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900'
        >{{logbook.rincian_kegiatan}}</textarea>
      </div>

      <!-- Obstacle -->
      <div>
        <label
          for='kendala'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Obstacle</label>
        <input
          type='text'
          id='kendala'
          name='kendala'
          required
          value='{{logbook.kendala}}'
          placeholder='Enter obstacle...'
          class='w-full border text-gray-700 bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900'
        />
      </div>

      <!-- Photo Documentation -->
      <div class='space-y-3'>
        <label
          for='dokumentasi'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Photo Documentation
          <span class='text-xs text-gray-500 font-normal'>(max 5MB,
            JPG/JPEG/PNG)</span>
        </label>

        <input
          type='file'
          id='dokumentasi'
          name='dokumentasi'
          accept='.jpg,.jpeg,.png'
          x-ref='fileInput'
          :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border rounded-lg px-4 py-2 text-gray-700 focus:outline-none focus:ring-2 transition-colors file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-900 file:text-white hover:file:bg-gray-700 file:cursor-pointer'
          @change='validateFile($event.target.files[0])'
        />

        <!-- Error Message -->
        <template x-if='!isValid && errorMessage'>
          <div
            class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <div>
              <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
              <p class='text-xs text-red-700' x-text='errorMessage'></p>
            </div>
          </div>
        </template>

        <!-- Success Message with Preview -->
        <template x-if='hasFile && isValid && previewUrl'>
          <div class='space-y-2'>
            <div
              class='flex items-start gap-3 p-3 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500 mt-0.5'></i>
              <div class='flex-1'>
                <p class='text-sm font-semibold text-green-800'>Valid Image</p>
                <p
                  class='text-xs text-green-700'
                  x-text='fileName + (fileSize ? ` (${(fileSize / 1024).toFixed(1)}KB)` : "")'
                ></p>
              </div>
              <button
                type='button'
                class='text-red-500 hover:text-red-700 transition-colors'
                @click='clearFile()'
                title='Remove image'
              >
                <i class='fas fa-times-circle'></i>
              </button>
            </div>

            <!-- Image Preview -->
            <div class='relative w-32 h-32'>
              <img
                :src='previewUrl'
                alt='Photo Preview'
                class='w-32 h-32 object-cover rounded-lg border-2 border-green-300 shadow-md'
              />
            </div>
          </div>
        </template>

        <!-- Existing Image Info -->
        <template x-if='!hasFile || (hasFile && fileName === "Existing Image")'>
          <div
            class='flex items-start gap-3 p-3 bg-blue-50 border border-blue-300 rounded-lg'
          >
            <i class='fas fa-info-circle text-blue-500 mt-0.5'></i>
            <div class='flex-1'>
              <p class='text-sm font-semibold text-blue-800'>Current Image</p>
              <p class='text-xs text-blue-700'>Leave file input empty to keep
                the current image</p>
            </div>
          </div>
        </template>
      </div>

      <!-- Link Documentation -->
      <div>
        <label
          for='dokumentasi_lain'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Link Documentation</label>
        <input
          type='text'
          id='dokumentasi_lain'
          name='dokumentasi_lain'
          value='{{logbook.dokumentasi_lain}}'
          placeholder='Enter link documentation...'
          class='w-full border text-gray-700 bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900'
        />
      </div>

      <!-- Buttons -->
      <div class='flex justify-start gap-3 pt-4'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Update Log Book
        </button>
        <a
          href='/pertemuans/{{logbook.pertemuan.id}}'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFile && !isValid'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix the image validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>