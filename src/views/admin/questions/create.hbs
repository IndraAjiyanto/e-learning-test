<div class="py-10">
  <div class="max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg">
    <h2 class="text-2xl font-semibold mb-6 text-gray-900">Create New Question</h2>

    <form action="/question/{{quiz.id}}" method="POST" class="space-y-6" enctype="multipart/form-data" x-data="{ loading: false }" @submit="loading = true">

       <div x-data="{ previewUrl: null }">
  <label for="image" class="block text-sm font-semibold text-gray-700 mb-1">
              Upload Gambar (optional)
  </label>
  <input 
    type="file" 
    id="image" 
    name="image" 
    accept="image/*" 
    x-ref="fileInput"
    class="w-full border file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-900 rou border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700"
    @change="previewUrl = $event.target.files[0] ? URL.createObjectURL($event.target.files[0]) : null"
  >

  <template x-if="previewUrl">
    <div class="relative w-32 h-32">
      <img 
        :src="previewUrl" 
        alt="Preview Photos" 
        class="w-32 h-32 object-cover rounded-lg border border-gray-300"
      >

      <button 
        type="button" 
        class="absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center shadow hover:bg-red-600"
        @click="previewUrl = null; $refs.fileInput.value = null;">
        &times;
      </button>
    </div>
  </template>
</div>

      <div>
        <label for="questionText" class="block text-sm font-medium text-gray-700 mb-1">
          Quiz
        </label>
        <textarea id="questionText" name="questionText" rows="4"
          class="w-full border bg-white rounded-lg p-3 focus:ring-2 focus:ring-gray-900 text-gray-700"
          placeholder="Tulis pertanyaan di sini..." required></textarea>
      </div>

      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <input type="radio" name="answers" value="0" required
            class="h-5 w-5 border-gray-400 text-gray-900 focus:ring-gray-900" />
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">Pilihan A</label>
            <input type="text" name="options" 
              class="w-full border bg-white rounded-lg px-3 py-2 focus:ring-2 focus:ring-gray-900 text-gray-700"
              placeholder="Tulis pilihan A" required />
          </div>
        </div>

        <div class="flex items-center gap-3">
          <input type="radio" name="answers" value="1" required
            class="h-5 w-5 border-gray-400 text-gray-900 focus:ring-gray-900" />
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">Pilihan B</label>
            <input type="text" name="options" 
              class="w-full border bg-white rounded-lg px-3 py-2 focus:ring-2 focus:ring-gray-900 text-gray-700"
              placeholder="Tulis pilihan B" required />
          </div>
        </div>

        <div class="flex items-center gap-3">
          <input type="radio" name="answers" value="2" required
            class="h-5 w-5 border-gray-400 text-gray-900 focus:ring-gray-900" />
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">Pilihan C</label>
            <input type="text" name="options" 
              class="w-full border bg-white rounded-lg px-3 py-2 focus:ring-2 focus:ring-gray-900 text-gray-700"
              placeholder="Tulis pilihan C" required />
          </div>
        </div>

        <div class="flex items-center gap-3">
          <input type="radio" name="answers" value="3" required
            class="h-5 w-5 border-gray-400 text-gray-900 focus:ring-gray-900" />
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">Pilihan D</label>
            <input type="text" name="options" 
              class="w-full border bg-white rounded-lg px-3 py-2 focus:ring-2 focus:ring-gray-900 text-gray-700"
              placeholder="Tulis pilihan D" required />
          </div>
        </div>
      </div>

      <div class="flex justify-start gap-3 pt-4">
        <button type="submit"
        :disabled="loading"
        :class="loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class="text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2">
          <span x-show='loading' class="loading loading-spinner loading-sm"></span>
          <span x-show='!loading'>Create Question</span>
        </button>
        <a href="/quiz/{{quiz.id}}"
        :disabled='loading'
        :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300  transition'>
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>
