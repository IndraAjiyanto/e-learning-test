{{!--
  Page: Admin — Create Question (Container - Quiz Question Form, slicing.pen CRmv1)
  Path: admin/questions/create.hbs
  Route: GET /question/formCreate/:quizId -> POST /question/:quizId (create)
  Data: { user, quiz }
  Design: Container w1052 vertical gap28 → Title (Create Question 34 #003060 /
          "Add a new question to the logbook and mark the correct answer" 16 #718096)
          → Form Card (white, stroke #D9D9D9, radius 12, pad 20, gap 20) berisi
          Upload Gambar (optional) + Question textarea + 4 Answer Options (A-D)
          → Action row (Cancel + Save Question).
  Komponen (reuse): text/page-header, form/form-card (noNumber), form/form-field,
          form/form-label, form/textarea-input, form/question-photo-upload,
          form/answer-option-row, button/primary-button, button/secondary-button.
--}}
<div class='py-10 px-6'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px]'
    x-data="{
      ...adminFormGate(),
      questionPreviewUrl: null,
      loading: false,

      questionClearFile() {
        this.questionPreviewUrl = null;
        this.$refs.questionFile.value = null;
      }
    }"
    x-init="recomputeFormValid()"
    @input="recomputeFormValid()"
    @change="recomputeFormValid()">

    {{!-- Title --}}
    {{> components/ui/admin/text/page-header title="Create Question" subtitle="Add a new question to the logbook and mark the correct answer"}}

    {{!-- Form --}}
    <form method='POST' action='/question/{{quiz.id}}' enctype='multipart/form-data'
      class='flex flex-col gap-[16px] w-full'
      novalidate @focusout="markField($event.target)" @submit='submitGate($event)'>

      {{!-- Feature Card --}}
      {{#> components/ui/admin/form/form-card noNumber=true}}

        {{!-- Upload Gambar (optional) --}}
        {{> components/ui/admin/form/question-photo-upload}}

        {{!-- Question --}}
        {{#> components/ui/admin/form/form-field label="Question*" for="questionText"}}
          {{> components/ui/admin/form/textarea-input
            id="questionText" name="questionText" rows="4" required=true
            placeholder="Enter your question here"
          }}
        {{/components/ui/admin/form/form-field}}

        {{!-- Answer Options --}}
        <div class='flex flex-col gap-[12px] w-full'>
          {{> components/ui/admin/form/answer-option-row label="A" value="0"}}
          {{> components/ui/admin/form/answer-option-row label="B" value="1"}}
          {{> components/ui/admin/form/answer-option-row label="C" value="2"}}
          {{> components/ui/admin/form/answer-option-row label="D" value="3"}}
        </div>

      {{/components/ui/admin/form/form-card}}

      {{!-- Action row --}}
      {{#> components/ui/admin/form/form-card noNumber=true}}
        <div class='flex flex-col sm:flex-row justify-end sm:justify-between items-stretch sm:items-center gap-[12px] w-full'>
          {{> components/ui/admin/button/secondary-button text='Cancel' href=(concat '/quiz/' quiz.id) width='90'}}
          {{> components/ui/admin/button/primary-button text='Save Question' type='submit' loading='loading' width='163'}}
        </div>
      {{/components/ui/admin/form/form-card}}

    </form>
  </div>
</div>
