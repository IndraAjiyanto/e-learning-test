{{!--
  Page: Admin — Edit Question
  Path: admin/questions/edit.hbs
  Route: GET /question/FormEdit/:questionId -> PATCH /question/:questionId/:quizId (update)
         GET /program/edit-question-syllabus/:courseId (syllabus mock context)
  Design: Figma node 1883-14160 (font-inter only)
--}}
<div class='min-h-screen bg-[#F3F3F3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px] items-start'
    x-data='{
      ...adminFormGate(),
      loading: false,
      isSyllabus: {{#if isSyllabus}}true{{else}}false{{/if}},
      questionPreviewUrl: null,
      questionOldPhoto: {{#if question.image}}"{{question.image}}"{{else}}null{{/if}},
      questionText: {{#if question.questionText}}{{json question.questionText}}{{else if isSyllabus}}"Apa tujuan utama dari User Research dalam proses desain?"{{else}}""{{/if}},
      optionA: {{#if question.answers.[0].answer}}{{json question.answers.[0].answer}}{{else if isSyllabus}}"Memilih warna yang paling disukai desainer"{{else}}""{{/if}},
      optionB: {{#if question.answers.[1].answer}}{{json question.answers.[1].answer}}{{else if isSyllabus}}"Memahami kebutuhan, perilaku, dan motivasi pengguna"{{else}}""{{/if}},
      optionC: {{#if question.answers.[2].answer}}{{json question.answers.[2].answer}}{{else if isSyllabus}}"Membuat visual antarmuka dengan software desain"{{else}}""{{/if}},
      optionD: {{#if question.answers.[3].answer}}{{json question.answers.[3].answer}}{{else if isSyllabus}}"Menentukan arsitektur teknologi backend sistem"{{else}}""{{/if}},
      selectedAnswer: {{#if isSyllabus}}1{{else}}{{#each question.answers}}{{#if this.isCorrect}}{{@index}}{{/if}}{{/each}}{{/if}},

      init() {
        if (this.selectedAnswer === undefined || this.selectedAnswer === "") {
          this.selectedAnswer = 1;
        }
      },
      questionClearFile() {
        this.questionPreviewUrl = null;
        this.questionOldPhoto = null;
        if (this.$refs.questionFile) this.$refs.questionFile.value = null;
      },
      handleFileChange(event) {
        const file = event.target.files?.[0];
        if (file) {
          this.questionPreviewUrl = URL.createObjectURL(file);
        }
      },
      handleFileDrop(event) {
        const file = event.dataTransfer?.files?.[0];
        if (file && (file.type === "image/jpeg" || file.type === "image/jpg" || file.type === "image/png")) {
          if (this.$refs.questionFile) {
            const dt = new DataTransfer();
            dt.items.add(file);
            this.$refs.questionFile.files = dt.files;
          }
          this.questionPreviewUrl = URL.createObjectURL(file);
        }
      },
      canSubmit() {
        return (
          String(this.questionText).trim() !== "" &&
          String(this.optionA).trim() !== "" &&
          String(this.optionB).trim() !== "" &&
          String(this.optionC).trim() !== "" &&
          String(this.optionD).trim() !== "" &&
          this.selectedAnswer !== null &&
          this.selectedAnswer !== undefined
        );
      },
      handleCancel() {
        if (window.history.length > 1) {
          window.history.back();
        } else if (this.isSyllabus) {
          window.location.href = "{{#if question.quiz.id}}/syllabus/quiz/detail/{{question.quiz.id}}{{else if courseId}}/program/detail/program/admin/{{courseId}}{{else}}/program{{/if}}";
        } else {
          window.location.href = "{{#if question.quiz.id}}/quiz/{{question.quiz.id}}{{else}}/program{{/if}}";
        }
      },
      handleSubmit(e) {
        if (!this.canSubmit()) {
          e.preventDefault();
          return;
        }
        this.loading = true;
      }
    }'>

    {{!-- Title: Heading + Sub heading --}}
    <div class='box-border w-full flex flex-col gap-[4px] items-start'>
      <h1 class='w-full font-inter font-bold text-[34px] leading-[36px] tracking-[-1px] text-[#003060]'>
        Edit Question
      </h1>
      <p class='w-full font-inter font-medium text-[16px] leading-[20px] text-[#718096]'>
        Fill in the information below to edit a question.
      </p>
    </div>

    {{!-- Edit question form --}}
    <form method='POST' action='{{#if isSyllabus}}#{{else}}/question/{{question.id}}/{{question.quiz.id}}?_method=PATCH{{/if}}'
      enctype='multipart/form-data'
      class='box-border w-full flex flex-col gap-[16px] items-start'
      novalidate
      @input="recomputeFormValid()"
      @change="recomputeFormValid()"
      @focusout="markField($event.target)"
      @submit='handleSubmit($event)'>
      <input type='hidden' name='_method' value='PATCH'>

      {{!-- Form Logbook: Card Container --}}
      <div class='box-border w-full bg-[#FFFFFF] border border-[#D9D9D9] rounded-[12px] p-[20px] flex flex-col gap-[20px] items-start'>

        {{!-- Upload Gambar (optional) Container --}}
        <div class='box-border w-full flex flex-col gap-[8px] items-start'>
          <label class='w-full font-inter font-medium text-[14px] leading-[20px] text-[#404040]'>
            Upload Gambar (optional)
          </label>

          <input
            type='file'
            id='question_image'
            name='image'
            x-ref='questionFile'
            accept='image/jpeg,image/jpg,image/png'
            class='hidden'
            @change='handleFileChange($event)'
          />

          {{!-- Drag and drop / browse button container (1010px x 200px) --}}
          <label
            for='question_image'
            @dragover.prevent
            @dragleave.prevent
            @drop.prevent='handleFileDrop($event)'
            class='box-border w-full h-[200px] bg-[#F8F9FA] border border-[#D9D9D9] rounded-[8px] p-[8px_16px] flex flex-col justify-center items-center gap-[10px] cursor-pointer hover:bg-[#EFF3F6] transition-colors relative overflow-hidden'>
            
            {{!-- Empty state --}}
            <template x-if='!questionPreviewUrl && !questionOldPhoto'>
              <div class='w-full max-w-[976px] flex flex-col items-center gap-[8px]'>
                {{!-- Image upload icon (40x40) --}}
                <div class='w-[40px] h-[40px] flex items-center justify-center text-[#718096]'>
                  <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' class='w-[36px] h-[36px]'>
                    <rect width='18' height='18' x='3' y='3' rx='2' ry='2'></rect>
                    <circle cx='9' cy='9' r='2'></circle>
                    <path d='m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21'></path>
                  </svg>
                </div>
                <p class='w-full font-inter font-medium text-[12px] leading-[16px] text-center text-[#718096]'>
                  Drag &amp; Drop your Image here or click to browse
                </p>
                <p class='w-full font-inter font-medium text-[10px] leading-[12px] text-center text-[#ADB7C5]'>
                  JPEG, JPG, PNG &middot; Max 5 MB
                </p>
              </div>
            </template>

            {{!-- Preview newly chosen image --}}
            <template x-if='questionPreviewUrl'>
              <div class='w-full h-full relative flex items-center justify-center'>
                <img :src='questionPreviewUrl' alt='Question Image Preview' class='max-h-full max-w-full object-contain rounded-[6px]' />
                <button
                  type='button'
                  @click.prevent='questionClearFile()'
                  class='absolute top-2 right-2 bg-white/90 hover:bg-white text-[#EF4444] rounded-full p-1 shadow-md transition-colors'
                  title='Remove image'>
                  <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4'>
                    <line x1='18' y1='6' x2='6' y2='18'></line>
                    <line x1='6' y1='6' x2='18' y2='18'></line>
                  </svg>
                </button>
              </div>
            </template>

            {{!-- Preview existing old photo --}}
            <template x-if='!questionPreviewUrl && questionOldPhoto'>
              <div class='w-full h-full relative flex items-center justify-center'>
                <img :src='questionOldPhoto' alt='Current Question Image' class='max-h-full max-w-full object-contain rounded-[6px]' />
                <button
                  type='button'
                  @click.prevent='questionClearFile()'
                  class='absolute top-2 right-2 bg-white/90 hover:bg-white text-[#EF4444] rounded-full p-1 shadow-md transition-colors'
                  title='Remove image'>
                  <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4'>
                    <line x1='18' y1='6' x2='6' y2='18'></line>
                    <line x1='6' y1='6' x2='18' y2='18'></line>
                  </svg>
                </button>
              </div>
            </template>
          </label>
        </div>

        {{!-- Question* Textarea Container --}}
        <div class='box-border w-full flex flex-col gap-[8px] items-start'>
          <label for='questionText' class='w-full font-inter font-medium text-[14px] leading-[20px] text-[#404040]'>
            Question*
          </label>
          <div class='box-border w-full h-[128px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] p-[10px_14px] flex flex-row items-start focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
            <textarea
              id='questionText'
              name='questionText'
              x-model='questionText'
              required
              rows='4'
              placeholder='Enter question...'
              class='w-full h-[108px] font-inter font-normal text-[16px] leading-[24px] text-[#171717] placeholder-[#737373] bg-transparent border-none outline-none resize-none p-0 focus:ring-0 focus:outline-none'></textarea>
          </div>
          <p x-show="String(questionText).trim() === ''" x-cloak class="mt-1 text-xs text-[#dc2626] font-inter">Question is required.</p>
        </div>

        {{!-- Frame 2147229625: Answer Options --}}
        <div class='box-border w-full flex flex-col gap-[14px] items-start'>

          {{!-- Option A --}}
          <div class='box-border w-full flex flex-row items-start gap-[12px]'>
            <button
              type='button'
              @click='selectedAnswer = 0'
              :class="selectedAnswer == 0 ? 'bg-[#16A34A] border-[#16A34A]' : 'bg-white border-[#D4D4D4]'"
              class='w-[20px] h-[20px] rounded-full border flex items-center justify-center shrink-0 mt-[28px] transition-colors focus:outline-none'>
              <template x-if='selectedAnswer == 0'>
                <svg class='w-3 h-3 text-white' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='3'>
                  <path stroke-linecap='round' stroke-linejoin='round' d='M5 13l4 4L19 7' />
                </svg>
              </template>
            </button>
            <input type='radio' name='answers' value='0' x-model='selectedAnswer' class='hidden' />

            <div class='box-border flex-1 flex flex-col gap-[8px] items-start'>
              <label for='option_a' class='w-full font-inter font-medium text-[14px] leading-[20px] text-[#404040]'>
                Option A*
              </label>
              <div class='box-border w-full h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[14px] py-[10px] flex items-center focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
                <input
                  id='option_a'
                  type='text'
                  name='answer'
                  x-model='optionA'
                  required
                  placeholder='Enter option A...'
                  class='w-full h-[24px] font-inter font-normal text-[16px] leading-[24px] text-[#171717] placeholder-[#737373] bg-transparent border-none outline-none p-0 focus:ring-0 focus:outline-none'
                />
              </div>
              <p x-show="String(optionA).trim() === ''" x-cloak class="mt-1 text-xs text-[#dc2626] font-inter">Option A is required.</p>
            </div>
          </div>

          {{!-- Option B --}}
          <div class='box-border w-full flex flex-row items-start gap-[12px]'>
            <button
              type='button'
              @click='selectedAnswer = 1'
              :class="selectedAnswer == 1 ? 'bg-[#16A34A] border-[#16A34A]' : 'bg-white border-[#D4D4D4]'"
              class='w-[20px] h-[20px] rounded-full border flex items-center justify-center shrink-0 mt-[28px] transition-colors focus:outline-none'>
              <template x-if='selectedAnswer == 1'>
                <svg class='w-3 h-3 text-white' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='3'>
                  <path stroke-linecap='round' stroke-linejoin='round' d='M5 13l4 4L19 7' />
                </svg>
              </template>
            </button>
            <input type='radio' name='answers' value='1' x-model='selectedAnswer' class='hidden' />

            <div class='box-border flex-1 flex flex-col gap-[8px] items-start'>
              <label for='option_b' class='w-full font-inter font-medium text-[14px] leading-[20px] text-[#404040]'>
                Option B*
              </label>
              <div class='box-border w-full h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[14px] py-[10px] flex items-center focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
                <input
                  id='option_b'
                  type='text'
                  name='answer'
                  x-model='optionB'
                  required
                  placeholder='Enter option B...'
                  class='w-full h-[24px] font-inter font-normal text-[16px] leading-[24px] text-[#171717] placeholder-[#737373] bg-transparent border-none outline-none p-0 focus:ring-0 focus:outline-none'
                />
              </div>
              <p x-show="String(optionB).trim() === ''" x-cloak class="mt-1 text-xs text-[#dc2626] font-inter">Option B is required.</p>
            </div>
          </div>

          {{!-- Option C --}}
          <div class='box-border w-full flex flex-row items-start gap-[12px]'>
            <button
              type='button'
              @click='selectedAnswer = 2'
              :class="selectedAnswer == 2 ? 'bg-[#16A34A] border-[#16A34A]' : 'bg-white border-[#D4D4D4]'"
              class='w-[20px] h-[20px] rounded-full border flex items-center justify-center shrink-0 mt-[28px] transition-colors focus:outline-none'>
              <template x-if='selectedAnswer == 2'>
                <svg class='w-3 h-3 text-white' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='3'>
                  <path stroke-linecap='round' stroke-linejoin='round' d='M5 13l4 4L19 7' />
                </svg>
              </template>
            </button>
            <input type='radio' name='answers' value='2' x-model='selectedAnswer' class='hidden' />

            <div class='box-border flex-1 flex flex-col gap-[8px] items-start'>
              <label for='option_c' class='w-full font-inter font-medium text-[14px] leading-[20px] text-[#404040]'>
                Option C*
              </label>
              <div class='box-border w-full h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[14px] py-[10px] flex items-center focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
                <input
                  id='option_c'
                  type='text'
                  name='answer'
                  x-model='optionC'
                  required
                  placeholder='Enter option C...'
                  class='w-full h-[24px] font-inter font-normal text-[16px] leading-[24px] text-[#171717] placeholder-[#737373] bg-transparent border-none outline-none p-0 focus:ring-0 focus:outline-none'
                />
              </div>
              <p x-show="String(optionC).trim() === ''" x-cloak class="mt-1 text-xs text-[#dc2626] font-inter">Option C is required.</p>
            </div>
          </div>

          {{!-- Option D --}}
          <div class='box-border w-full flex flex-row items-start gap-[12px]'>
            <button
              type='button'
              @click='selectedAnswer = 3'
              :class="selectedAnswer == 3 ? 'bg-[#16A34A] border-[#16A34A]' : 'bg-white border-[#D4D4D4]'"
              class='w-[20px] h-[20px] rounded-full border flex items-center justify-center shrink-0 mt-[28px] transition-colors focus:outline-none'>
              <template x-if='selectedAnswer == 3'>
                <svg class='w-3 h-3 text-white' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='3'>
                  <path stroke-linecap='round' stroke-linejoin='round' d='M5 13l4 4L19 7' />
                </svg>
              </template>
            </button>
            <input type='radio' name='answers' value='3' x-model='selectedAnswer' class='hidden' />

            <div class='box-border flex-1 flex flex-col gap-[8px] items-start'>
              <label for='option_d' class='w-full font-inter font-medium text-[14px] leading-[20px] text-[#404040]'>
                Option D*
              </label>
              <div class='box-border w-full h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[14px] py-[10px] flex items-center focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
                <input
                  id='option_d'
                  type='text'
                  name='answer'
                  x-model='optionD'
                  required
                  placeholder='Enter option D...'
                  class='w-full h-[24px] font-inter font-normal text-[16px] leading-[24px] text-[#171717] placeholder-[#737373] bg-transparent border-none outline-none p-0 focus:ring-0 focus:outline-none'
                />
              </div>
              <p x-show="String(optionD).trim() === ''" x-cloak class="mt-1 text-xs text-[#dc2626] font-inter">Option D is required.</p>
            </div>
          </div>

          {{!-- Helper text below options --}}
          <p class='w-full font-inter font-normal text-[16px] leading-[24px] text-[#737373]'>
            *Select the radio button next to the option to mark the correct answer.
          </p>
          <p x-show="selectedAnswer === null || selectedAnswer === undefined" x-cloak class="mt-1 text-xs text-[#dc2626] font-inter">Please select the correct answer.</p>

        </div>

      </div>

      {{!-- Feature Card 1: Partnership / Action Bar --}}
      <div class='box-border w-full h-[86px] bg-[#FFFFFF] border border-[#D9D9D9] rounded-[12px] p-[20px] flex flex-row justify-end items-center gap-[24px]'>
        <div class='flex flex-row items-center gap-[12px]'>
          {{!-- Cancel button --}}
          <button
            type='button'
            @click='handleCancel()'
            class='box-border w-[90px] h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#F5F5F5] transition-colors'>
            <span class='font-inter font-semibold text-[16px] leading-[24px] text-[#003060]'>
              Cancel
            </span>
          </button>

          {{!-- Update Question button (width: 147px) --}}
          <button
            type='submit'
            :disabled='loading || !canSubmit()'
            class='box-border w-[147px] h-[44px] bg-[#003060] border border-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#002244] disabled:opacity-70 transition-colors'>
            <span x-show='!loading' class='font-inter font-semibold text-[16px] leading-[24px] text-[#FFFFFF] whitespace-nowrap'>
              Update Question
            </span>
            <span x-show='loading' style='display: none;' class='font-inter font-semibold text-[16px] leading-[24px] text-[#FFFFFF] flex items-center gap-2 whitespace-nowrap'>
              <svg class='animate-spin h-4 w-4 text-white' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24'>
                <circle class='opacity-25' cx='12' cy='12' r='10' stroke='currentColor' stroke-width='4'></circle>
                <path class='opacity-75' fill='currentColor' d='M4 12a8 8 0 018-8v8H4z'></path>
              </svg>
              Updating...
            </span>
          </button>
        </div>
      </div>

    </form>
  </div>
</div>
