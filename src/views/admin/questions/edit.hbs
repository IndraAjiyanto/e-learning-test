{{!--
  Page: Admin — Edit Question (Container - Quiz Question Form, slicing.pen CRmv1)
  Path: admin/questions/edit.hbs
  Route: GET /question/FormEdit/:questionId -> PATCH /question/:questionId/:quizId
  Data: { user, question }
  Design: mirror Container - Quiz Question Form (same layout as create, pre-filled).
  Komponen (reuse): text/page-header, form/form-card (noNumber), form/form-field,
          form/form-label, form/textarea-input, form/question-photo-upload (showOldPhoto),
          form/answer-option-row, button/primary-button, button/secondary-button.
--}}
<div class='py-10 px-6'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px]'
    x-data="{
      ...adminFormGate(),
      questionPreviewUrl: null,
      questionOldPhoto: {{#if question.image}}'{{question.image}}'{{else}}null{{/if}},
      loading: false,

      questionClearFile() {
        this.questionPreviewUrl = null;
        this.$refs.questionFile.value = null;
      }
    }"
    x-init="initGate()"
    @input="recomputeFormValid()"
    @change="recomputeFormValid()">

    {{!-- Title --}}
    {{> components/ui/admin/text/page-header title="Edit Question" subtitle="Update the question and answer options below"}}

    {{!-- Form --}}
    <form method='POST' action='/question/{{question.id}}/{{question.quiz.id}}?_method=PATCH' enctype='multipart/form-data'
      class='flex flex-col gap-[16px] w-full'
      @submit='loading = true'>
      <input type='hidden' name='_method' value='PUT'>

      {{!-- Feature Card --}}
      {{#> components/ui/admin/form/form-card noNumber=true}}

        {{!-- Upload Gambar (optional) --}}
        {{> components/ui/admin/form/question-photo-upload showOldPhoto=true}}

        {{!-- Question --}}
        {{#> components/ui/admin/form/form-field label="Question*" for="questionText"}}
          {{> components/ui/admin/form/textarea-input
            id="questionText" name="questionText" rows="4" required=true
            placeholder="Enter your question here"
            value=question.questionText
          }}
        {{/components/ui/admin/form/form-field}}

        {{!-- Answer Options --}}
        <div class='flex flex-col gap-[12px] w-full'>
          {{#each question.answers}}
          {{> components/ui/admin/form/answer-option-row
            label=(lookup "ABCD" @index)
            value=@index
            inputName="answer"
            inputValue=this.answer
            checked=this.isCorrect
          }}
          {{/each}}
        </div>

      {{/components/ui/admin/form/form-card}}

      {{!-- Action row --}}
      {{#> components/ui/admin/form/form-card noNumber=true}}
        <div class='flex flex-row justify-between items-center w-full'>
          {{> components/ui/admin/button/secondary-button text='Cancel' href=(concat '/quiz/' question.quiz.id) width='90'}}
          {{> components/ui/admin/button/primary-button text='Update Question' type='submit' loading='loading' disabled='!formValid || !isDirty' width='163'}}
        </div>
      {{/components/ui/admin/form/form-card}}

    </form>
  </div>
</div>
