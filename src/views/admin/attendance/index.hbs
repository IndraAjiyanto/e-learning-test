<div class="max-w-5xl mx-auto px-6 py-10 pt-28" x-data="{ search: '' }">
  <div class="flex justify-between items-center mb-6">
            <h2 class="text-3xl font-bold text-centertext-gray-800">Daftar Absens</h2>

            <div class="flex items-center gap-3">
      <input 
        type="text" 
        placeholder="Cari attendance" 
        x-model="search"
        class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900"
      />
    <a href="/attendance/create" class="bg-gray-900 text-white px-4 py-2 rounded-lg shadow hover:bg-gray-600 transition">
      Tambah Attendance
    </a>
  </div>
  </div>

  <div class="overflow-x-auto bg-white shadow-lg rounded-xl">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-100">
        <tr>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">No</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Kelas</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Pertemuan Ke</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Username</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">LinkedIn</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Status</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Keterangan</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Aksi</th>
          <th class="px-6 py-3 text-center text-sm font-semibold text-gray-700">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        {{#each attendance}}
        <tr class="hover:bg-gray-50 transition" x-show="'{{status}} {{user.username}} {{session.weeks.course.name}} {{session.sessionOrder}}'.toLowerCase().includes(search.toLowerCase())">
          <td class="px-6 py-4 text-sm text-gray-800">{{addOne @index}}</td>
          <td class="px-6 py-4 text-sm text-gray-800">{{session.weeks.course.name}}</td>
          <td class="px-6 py-4 text-sm text-gray-800">{{session.sessionOrder}}</td>
          <td class="px-6 py-4 text-sm text-gray-800">{{user.username}}</td>
          {{!-- LinkedIn: entity User tidak punya field linkedin — tampil "-" sampai BE menyediakannya --}}
          <td class="px-6 py-4 text-sm text-gray-800">{{#if user.linkedin}}<a href="{{user.linkedin}}" target="_blank" rel="noopener noreferrer" class="text-[#3B82F6] hover:underline">{{user.linkedin}}</a>{{else}}-{{/if}}</td>
          <td class="px-6 py-4 text-sm text-gray-800">{{status}}</td>
          <td class="px-6 py-4 text-sm text-gray-800">{{notes}}</td>
          <td class="px-6 py-4 text-sm text-gray-800 space-x-2">
            <a href="/attendance/{{id}}" class="inline-block text-gray-600 font-medium hover:underline">Lihat Attendance</a>
          </td>
          <td class="px-6 py-4 text-sm text-gray-800">
            <div class="flex items-center justify-center gap-2">
              <a href="/attendance/formEdit/{{id}}" title="Edit"
                class="p-2 rounded-lg bg-white text-[#525252] hover:bg-[#f5f5f5] transition">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#525252" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                  <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/>
                  <path d="m15 5 4 4"/>
                </svg>
              </a>
              <form action="/attendance/{{id}}/{{session.id}}?_method=DELETE" method="post" class="inline">
                <button type="button" onclick="openDeleteModal(this, 'Delete Attendance?', 'Are you sure you want to delete this attendance record?')" title="Delete"
                  class="p-2 rounded-lg bg-white text-[#C80606] hover:bg-[#FEF2F2] transition">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#C80606" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                    <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/>
                  </svg>
                </button>
              </form>
            </div>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

{{> components/ui/admin/modal/delete_confirm/index}}
