<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-bold mb-6 text-gray-900'>Create Attendance</h2>

    <form
      method='POST'
      action='/attendance/{{pertemuanId}}'
      class='space-y-6'
      @submit="loading = true"
      x-data="{
      loading: false,
      users: {{json users}},
      searchUser: '',
      showUserDropdown: false,
      selectedUser: null,
      statuses: [
        { value: 'present', label: 'Present' },
        { value: 'permission', label: 'Permission' },
        { value: 'sick', label: 'Sick' },
        { value: 'absent', label: 'Absent' },
        { value: 'no_information', label: 'No Information' }
      ],
      searchStatus: '',
      showStatusDropdown: false,
      selectedStatus: null,
      get filteredUsers() {
        if (!this.searchUser) return this.users;
        return this.users.filter(u => 
          u.username.toLowerCase().includes(this.searchUser.toLowerCase())
        );
      },
      get filteredStatuses() {
        if (!this.searchStatus) return this.statuses;
        return this.statuses.filter(s => 
          s.label.toLowerCase().includes(this.searchStatus.toLowerCase())
        );
      },
      selectUser(user) {
        this.selectedUser = user;
        this.searchUser = user.username;
        this.showUserDropdown = false;
      },
      selectStatus(status) {
        this.selectedStatus = status;
        this.searchStatus = status.label;
        this.showStatusDropdown = false;
      }
    }"
    >

      <!-- User -->
      <div class='relative'>
        <label
          for='userId'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Select User</label>
        <input type='hidden' name='userId' :value='selectedUser?.id' required />
        <input
          type='text'
          x-model='searchUser'
          @focus='showUserDropdown = true'
          @input='showUserDropdown = true'
          placeholder='Search user...'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          autocomplete='off'
        />
        <div
          x-show='showUserDropdown'
          @click.away='showUserDropdown = false'
          class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'
        >
          <template x-for='user in filteredUsers' :key='user.id'>
            <div
              @click='selectUser(user)'
              class='px-4 py-2 hover:bg-gray-100 cursor-pointer text-gray-700'
            >
              <div class="font-medium text-gray-900" x-text="user.username"></div>
              <div class="text-xs text-gray-500" x-text="user.email"></div>
            </div>
          </template>
          <div
            x-show='filteredUsers.length === 0'
            class='px-4 py-2 text-gray-500 text-sm'
          >
            No user found
          </div>
        </div>
      </div>

      <!-- Status -->
      <div class='relative'>
        <label
          for='status'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Status</label>
        <input
          type='hidden'
          name='status'
          :value='selectedStatus?.value'
          required
        />
        <input
          type='text'
          x-model='searchStatus'
          @focus='showStatusDropdown = true'
          @input='showStatusDropdown = true'
          placeholder='Search status...'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          autocomplete='off'
        />
        <div
          x-show='showStatusDropdown'
          @click.away='showStatusDropdown = false'
          class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'
        >
          <template x-for='status in filteredStatuses' :key='status.value'>
            <div
              @click='selectStatus(status)'
              class='px-4 py-2 hover:bg-gray-100 cursor-pointer text-gray-700'
              x-text='status.label'
            >
            </div>
          </template>
          <div
            x-show='filteredStatuses.length === 0'
            class='px-4 py-2 text-gray-500 text-sm'
          >
            No status found
          </div>
        </div>
      </div>

      <!-- Date -->
      <div>
        <label
          for='waktu_absen'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Attendance Date</label>
        <input
          type='date'
          id='waktu_absen'
          name='waktu_absen'
          required
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700 cursor-pointer'
          style='color-scheme: light;'
        />
      </div>

      <!-- Note -->
      <div>
        <label
          for="description"
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Note</label>
        <textarea
          id="description"
          name="description"
          rows='3'
          placeholder='Enter additional note...'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        ></textarea>
      </div>

      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='loading'
          :class="loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-600 '"
          class=' text-white px-6 py-2 rounded-lg shadow transition'
        >
        <span x-show="!loading">Create</span>
        <span x-show="loading" class="loading loading-spinner loading-sm"></span>
          
        </button>
        <a
          href='/session/{{pertemuanId}}'
        :disabled='loading'
        :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300  transition'>
          Cancel
        </a>
      </div>

    </form>
  </div>
</div>