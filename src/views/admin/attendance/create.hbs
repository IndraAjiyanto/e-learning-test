{{!--
  Page: Admin — Add Attendance
  Path: admin/attendance/create.hbs
  Route: GET /attendance/create/:sessionId -> POST /attendance/:sessionId (createAttendance)
  Data: { user, users, sessionId }
  Komponen (reuse): text/page-header, form/form-card (noNumber),
          form/searchable_select (User*), button/primary-button,
          button/secondary-button, form/text-input (Date* icon calendar, Note*).
          Baru (prefix attendance-): attendance/attendance-status-select.
  BE: POST /attendance/:sessionId { userId, status, attendanceTime, notes }
      → CreateAttendanceDto (status enum: permission|present|sick|absent|
      no_information). Cancel → /session/:sessionId.
--}}
<div class='py-10 px-6'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px] w-full'
    x-data='{ ...adminFormGate(), loading: false }'
    x-init="recomputeFormValid()"
    @input="recomputeFormValid()"
    @change="recomputeFormValid()">

    {{!-- Title --}}
    {{> components/ui/admin/text/page-header title="Add Attendance" subtitle="Record attendance for the session participants"}}

    {{!-- Form --}}
    <form method='POST' action='/attendance/{{sessionId}}'
      class='flex flex-col gap-[16px] w-full'
      novalidate @focusout="markField($event.target)" @submit='submitGate($event)'>

      {{!-- Feature Card --}}
      {{#> components/ui/admin/form/form-card noNumber=true}}

        {{!-- Row: User* + Status* --}}
        <div class='flex flex-col sm:flex-row gap-[12px] w-full'>
          {{> components/ui/admin/form/searchable_select/index
            required=true
            label="User*"
            forId="userId"
            errorId="userId_error"
            name="userId"
            displayField="username"
            placeholder="Select user"
            itemsJson=(json users)
          }}
          {{> components/ui/admin/attendance/attendance-status-select}}
        </div>

        {{!-- Row: Date* + Note* --}}
        <div class='flex flex-col sm:flex-row gap-[12px] w-full'>
          <div class='flex-1 min-w-0'>
            {{#> components/ui/admin/form/form-field label="Date*" for="attendanceTime" errorId="attendanceTime_error"}}
              {{> components/ui/admin/form/text-input
                type="date" id="attendanceTime" name="attendanceTime"
                icon="calendar" required=true
              }}
            {{/components/ui/admin/form/form-field}}
          </div>
          <div class='flex-1 min-w-0'>
            {{#> components/ui/admin/form/form-field label="Note*" for="notes" errorId="notes_error"}}
              {{> components/ui/admin/form/text-input
                id="notes" name="notes"
                placeholder="Enter note" required=true
              }}
            {{/components/ui/admin/form/form-field}}
          </div>
        </div>

      {{/components/ui/admin/form/form-card}}

      {{!-- Footer: Cancel + Save Attendance --}}
      {{#> components/ui/admin/form/form-card noNumber=true}}
        <div class='flex flex-col sm:flex-row justify-end items-stretch sm:items-center gap-[12px] w-full'>
          {{> components/ui/admin/button/secondary-button text='Cancel' href=(concat '/session/' sessionId) width='90'}}
          {{> components/ui/admin/button/primary-button text='Save Attendance' type='submit' loading='loading' width='183'}}
        </div>
      {{/components/ui/admin/form/form-card}}

    </form>
  </div>
</div>
