{{!--
  Page: Admin — Edit Attendance (mirror Container - Attendance Form, slicing.pen Z8kPt)
  Path: admin/attendance/edit.hbs
  Route: GET /attendance/formEdit/:id -> PATCH /attendance/:attendanceId/:sessionId
  Data: { user, attendance } (Attendance + session + user)
  Design: mirror Add Attendance (form-card p20 gap20, footer Cancel w90 +
          Update Attendance w183). Tanpa field User (perilaku lama: user tidak
          diubah saat edit) — kolom Status/Date/Note pre-filled.
  Komponen: sama seperti create (page-header, form-card, form-field,
          text-input, primary/secondary-button,
          attendance/attendance-status-select dengan initialStatus).
  BE: PATCH /attendance/:id/:sessionId { status?, attendanceTime?, notes? }
      → UpdateAttendanceDto (PartialType CreateAttendanceDto).
--}}
<div class='py-10 px-6'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px] w-full'
    x-data='{ ...adminFormGate(), loading: false }'
    x-init="initGate()"
    @input="recomputeFormValid()"
    @change="recomputeFormValid()">

    {{!-- Title --}}
    {{> components/ui/admin/text/page-header title="Edit Attendance" subtitle="Update the attendance record below"}}

    {{!-- Form --}}
    <form method='POST' action='/attendance/{{attendance.id}}/{{attendance.session.id}}?_method=PATCH'
      class='flex flex-col gap-[16px] w-full'
      @submit='loading = true'>

      {{!-- Feature Card --}}
      {{#> components/ui/admin/form/form-card noNumber=true}}

        {{!-- Row: User (read-only) + Status* --}}
        <div class='flex flex-col sm:flex-row gap-[12px] w-full'>
          <div class='flex-1 min-w-0'>
            {{#> components/ui/admin/form/form-field label="User" for="username"}}
              {{> components/ui/admin/form/text-input
                id="username" name="username"
                value=attendance.user.username
                disabled=true
              }}
            {{/components/ui/admin/form/form-field}}
          </div>
          {{> components/ui/admin/attendance/attendance-status-select initialStatus=attendance.status}}
        </div>

        {{!-- Row: Date* + Note* --}}
        <div class='flex flex-col sm:flex-row gap-[12px] w-full'>
          <div class='flex-1 min-w-0'>
            {{#> components/ui/admin/form/form-field label="Date*" for="attendanceTime" errorId="attendanceTime_error"}}
              {{> components/ui/admin/form/text-input
                type="date" id="attendanceTime" name="attendanceTime"
                icon="calendar" required=true
                value=(formDate attendance.attendanceTime)
              }}
            {{/components/ui/admin/form/form-field}}
          </div>
          <div class='flex-1 min-w-0'>
            {{#> components/ui/admin/form/form-field label="Note*" for="notes" errorId="notes_error"}}
              {{> components/ui/admin/form/text-input
                id="notes" name="notes"
                placeholder="Enter note" required=true
                value=attendance.notes
              }}
            {{/components/ui/admin/form/form-field}}
          </div>
        </div>

      {{/components/ui/admin/form/form-card}}

      {{!-- Footer: Cancel + Update Attendance --}}
      {{#> components/ui/admin/form/form-card noNumber=true}}
        <div class='flex flex-col sm:flex-row justify-end items-stretch sm:items-center gap-[12px] w-full'>
          {{> components/ui/admin/button/secondary-button text='Cancel' href=(concat '/session/' attendance.session.id) width='90'}}
          {{> components/ui/admin/button/primary-button text='Update Attendance' type='submit' loading='loading' disabled='!formValid || !isDirty' width='183'}}
        </div>
      {{/components/ui/admin/form/form-card}}

    </form>
  </div>
</div>
