<script>
function absenTable({ peserta }) {
  return {
    searchInput: "",
    search: "",
    pageNumber: 0,
    size: 5,
    peserta,
    amount: 0,
    get filteredPeserta() {
      let filtered = this.peserta.filter(u =>
        (`${u.username} ${u.email} ${u.status || ''}`).toLowerCase()
          .includes(this.search.toLowerCase())
      );
      this.amount = filtered.length;

      const start = this.pageNumber * this.size;
      const end = start + this.size;
      return filtered.slice(start, end).map(u => u.id.toString());
    },
    pages() { return Array.from({ length: this.pageCount() }); },
    pageCount() { return Math.ceil(this.amount / this.size); },
    nextPage() { if (this.pageNumber < this.pageCount()-1) this.pageNumber++; },
    prevPage() { if (this.pageNumber > 0) this.pageNumber--; },
    viewPage(index) { this.pageNumber = index; },
  }
}
</script>

<!-- Modal untuk View Materi -->
<div x-data="materiModal()" 
     @open-materi-modal.window="openModal($event.detail)"
     x-show="isOpen"
     x-cloak
     class="fixed inset-0 z-50 overflow-y-auto"
     style="display: none;">
  
  <!-- Backdrop -->
  <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity z-40"
       @click="closeModal()"></div>
  
  <!-- Modal Content -->
  <div class="relative flex items-center justify-center min-h-screen p-4 z-50">
    <div class="relative bg-white rounded-xl shadow-2xl max-w-6xl w-full max-h-[90vh] overflow-hidden"
         @click.stop>
      
      <!-- Header -->
      <div class="flex items-center justify-between p-6 border-b">
        <div>
          <h2 class="text-2xl font-bold text-gray-900" x-text="materi.judul"></h2>
          <p class="text-sm text-gray-600 mt-1">
            File Type: <span class="uppercase font-semibold" x-text="materi.jenis_file"></span>
          </p>
        </div>
        <button @click="closeModal()" 
                class="p-2 hover:bg-gray-100 rounded-lg transition">
          <svg xmlns="http://www.w3.org/2000/svg" 
               class="h-6 w-6 text-gray-600" 
               fill="none" viewBox="0 0 24 24" 
               stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                  d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <!-- Content -->
      <div class="p-6 overflow-y-auto bg-white" style="max-height: calc(90vh - 180px);">
        
        <!-- PDF Viewer -->
        <template x-if="materi.jenis_file === 'pdf'">
          <div class="w-full h-[600px] bg-white">
            <iframe :src="'https://mozilla.github.io/pdf.js/web/viewer.html?file=' + encodeURIComponent(materi.file)" 
                    class="w-full h-full border rounded-lg bg-white"
                    frameborder="0">
            </iframe>
          </div>
        </template>

        <!-- Video Player -->
        <template x-if="materi.jenis_file === 'video'">
          <div class="w-full aspect-video">
            <iframe :src="materi.file" 
                    class="w-full h-full rounded-lg"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen>
            </iframe>
          </div>
        </template>

        <!-- PPT Slides Viewer -->
        <template x-if="materi.jenis_file === 'ppt'">
          <div class="space-y-4">
            <div class="flex justify-between items-center bg-gray-50 p-4 rounded-lg">
              <button @click="prevSlide()" 
                      :disabled="currentSlide === 0"
                      class="px-4 py-2 bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition disabled:opacity-50 disabled:cursor-not-allowed">
                ← Previous
              </button>
              <span class="text-gray-700 font-semibold">
                Slide <span x-text="currentSlide + 1"></span> / <span x-text="totalSlides"></span>
              </span>
              <button @click="nextSlide()" 
                      :disabled="currentSlide === totalSlides - 1"
                      class="px-4 py-2 bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition disabled:opacity-50 disabled:cursor-not-allowed">
                Next →
              </button>
            </div>

            <div class="w-full bg-gray-900 rounded-lg p-4 flex items-center justify-center" style="min-height: 500px;">
              <img :src="materi.slides[currentSlide]" 
                   alt="Slide"
                   class="max-w-full max-h-[500px] object-contain rounded shadow-lg">
            </div>

            <!-- Thumbnail Navigation -->
            <div class="grid grid-cols-5 gap-2">
              <template x-for="(slide, index) in materi.slides" :key="index">
                <div @click="currentSlide = index"
                     :class="currentSlide === index ? 'ring-4 ring-blue-500' : 'ring-1 ring-gray-300'"
                     class="cursor-pointer rounded overflow-hidden hover:ring-4 hover:ring-blue-300 transition">
                  <img :src="slide" 
                       :alt="'Slide ' + (index + 1)"
                       class="w-full h-20 object-cover">
                  <div class="text-xs text-center py-1 bg-gray-100" x-text="index + 1"></div>
                </div>
              </template>
            </div>
          </div>
        </template>

      </div>
      
      <!-- Footer -->
      <div class="flex items-center justify-between p-6 border-t bg-gray-50">
        <a :href="materi.file" 
           target="_blank"
           download
           class="inline-flex items-center gap-2 px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition shadow">
          <svg xmlns="http://www.w3.org/2000/svg" 
               fill="none" viewBox="0 0 24 24" 
               stroke-width="1.5" stroke="currentColor" 
               class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" 
                  d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          Download File
        </a>
        <button @click="closeModal()"
                class="px-6 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition shadow">
          Close
        </button>
      </div>
      
    </div>
  </div>
</div>

<script>
function materiModal() {
  return {
    isOpen: false,
    currentSlide: 0,
    materi: {
      id: null,
      judul: '',
      jenis_file: '',
      file: '',
      slides: []
    },
    
    get totalSlides() {
      return this.materi.slides ? this.materi.slides.length : 0;
    },
    
    openModal(data) {
      console.log('Opening modal with data:', data);
      console.log('Jenis file:', data.jenis_file);
      console.log('Slides:', data.slides);
      
      this.materi = data;
      
      // Pastikan slides adalah array
      if (data.slides && !Array.isArray(data.slides)) {
        console.log('Slides bukan array, converting...');
        this.materi.slides = [];
      }
      
      this.currentSlide = 0;
      this.isOpen = true;
      document.body.style.overflow = 'hidden';
      
      console.log('Modal opened, isOpen:', this.isOpen);
    },
    
    closeModal() {
      this.isOpen = false;
      document.body.style.overflow = 'auto';
    },
    
    nextSlide() {
      if (this.currentSlide < this.totalSlides - 1) {
        this.currentSlide++;
      }
    },
    
    prevSlide() {
      if (this.currentSlide > 0) {
        this.currentSlide--;
      }
    }
  }
}
</script>

