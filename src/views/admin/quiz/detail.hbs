{{!--
  Page: Admin — Quiz Detail
  Path: admin/quiz/detail.hbs
  Design: pen design language (matching weeks/detail.hbs pattern)
  Route: GET /quiz/:quizId — data: { quiz (weeks.course), scores (user), questions (answers) }}
  Feature Card - Quiz: back link, quiz info, Delete (red text) + Edit (navy)
  Table Detail Quiz: underline tabs (Question + Answer), question accordion + answer table
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='box-border w-full max-w-[1052px] mx-auto flex flex-col gap-[16px] justify-start items-start'>

    {{!-- Feature Card - Quiz --}}
    <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[14px] p-[20px] justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px]'>

      {{!-- Back Row --}}
      <div class='w-full flex flex-row justify-between items-center'>
        <a href='/week/{{quiz.weeks.id}}'
          class='flex flex-row gap-[4px] justify-start items-center hover:opacity-70 transition-opacity'
          title='Back' aria-label='Back'>
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#718096' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'><polyline points='15 18 9 12 15 6'/></svg>
          <span class='text-[16px]/[normal] text-[#718096] font-montserrat font-medium'>Back</span>
        </a>
      </div>

      {{!-- Title Row --}}
      <div class='w-full flex flex-row gap-[12px] justify-between items-start'>
        <div class='flex flex-col gap-[16px] flex-1 min-w-0 justify-start items-start'>
          <div class='flex flex-col gap-[4px] w-full'>
            <div class='text-[34px]/[normal] w-full text-[#003060] font-montserrat font-bold text-left'>Quiz {{quiz.quizName}}</div>
          </div>
          <div class='flex flex-row flex-wrap gap-[8px] w-full justify-start items-center'>
            <div class='box-border flex flex-row p-[2px_8px] justify-center items-center bg-[#F5F5F5] rounded-[16px]'>
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#718096' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[14px] h-[14px] shrink-0 mr-[4px]'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg>
              <span class='text-[12px]/[normal] text-[#404040] font-inter font-medium text-center whitespace-nowrap'>{{quiz.duration}} min</span>
            </div>
            <div class='box-border flex flex-row p-[2px_8px] justify-center items-center bg-[#F5F5F5] rounded-[16px]'>
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#718096' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[14px] h-[14px] shrink-0 mr-[4px]'><circle cx='12' cy='8' r='6'/><path d='M15.477 12.89L17 22l-5-3-5 3 1.523-9.11'/></svg>
              <span class='text-[12px]/[normal] text-[#404040] font-inter font-medium text-center whitespace-nowrap'>Min: {{quiz.minScore}}</span>
            </div>
            <div class='box-border flex flex-row p-[2px_8px] justify-center items-center bg-[#F5F5F5] rounded-[16px]'>
              <span class='text-[12px]/[normal] text-[#404040] font-inter font-medium text-center whitespace-nowrap'>{{quiz.weeks.course.name}} · Week {{quiz.weeks.week_number}}</span>
            </div>
          </div>
        </div>

        {{!-- Actions --}}
        <div class='flex flex-row gap-[12px] shrink-0 justify-start items-center'>
          <form action='/quiz/{{quiz.id}}/{{quiz.weeks.id}}?_method=DELETE' method='POST'>
            <button type='button'
              @click='confirmQuizDetailDelete($el)'
              class='box-border w-[87px] shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FEF2F2] rounded-[8px] [outline:1px_solid_#FCA5A5] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#FEE2E2] transition-colors'
              title='Delete Quiz' aria-label='Delete Quiz'>
              <span class='text-[16px]/[normal] text-[#EF4444] font-inter font-semibold whitespace-nowrap'>Delete</span>
            </button>
          </form>
          <a href='/quiz/formEdit/{{quiz.id}}'
            class='box-border w-[114px] shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#003060] rounded-[8px] [outline:1px_solid_#003060] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#00254a] transition-colors'
            title='Edit Quiz' aria-label='Edit Quiz'>
            <span class='text-[16px]/[normal] text-[#FFFFFF] font-inter font-semibold whitespace-nowrap'>Edit Quiz</span>
          </a>
        </div>
      </div>

    </div>

    {{!-- Table Detail Quiz --}}
    <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[20px] justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px] overflow-hidden p-[12px_20px_20px_20px]' x-data="quizTabData()">

      {{!-- Tab Bar --}}
      <div x-data="{ tabs: [
        {name:'question',label:'Question',url:''},
        {name:'answer',label:'Answer',url:''}
      ] }">
        {{> components/ui/admin/form/underline-tabs activeTabVar="tab" fetchFn="noop"}}
      </div>

      {{!-- Question Tab --}}
      <div x-show="tab === 'question'" class='w-full'>
        {{#if questions.length}}
        <div class='flex flex-col gap-[10px] w-full mb-[10px]'>
          {{#each questions}}
          <div x-data="{ open: false }" class='box-border w-full shrink-0 min-h-[68px] h-fit flex flex-col gap-0 p-[8px_14px] justify-start items-start bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] hover:bg-[#fafafa] transition-colors'>

            {{!-- Question Header --}}
            <button @click="open = !open" class='w-full flex flex-row justify-between items-center py-[6px]'>
              <span class='text-[14px]/[normal] text-[#003060] font-montserrat font-semibold text-left flex-1 min-w-0'>{{this.questionText}}</span>
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#718096' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' :class="open ? 'rotate-180' : ''" class='w-[16px] h-[16px] shrink-0 transition-transform ml-[8px]'><polyline points='6 9 12 15 18 9'/></svg>
            </button>

            {{!-- Question Body (collapsed) --}}
            <div x-show="open" x-collapse class='w-full pt-[8px] pb-[4px] flex flex-col gap-[12px]'>

              {{#if this.image}}
              <div class='flex justify-center'>
                <img src="{{this.image}}" alt="Question image" class='max-h-64 rounded-lg shadow border object-contain' />
              </div>
              {{/if}}

              {{!-- Answers --}}
              <div class='flex flex-col gap-[6px] w-full'>
                {{#each this.answers}}
                <div class='box-border w-full shrink-0 flex flex-row gap-[8px] p-[8px_12px] justify-start items-center rounded-[8px]
                  {{#if this.isCorrect}}bg-[#F0FDF4] [outline:1px_solid_#BBF7D0]{{else}}bg-[#F5F5F5] [outline:1px_solid_#E5E5E5]{{/if}}'>
                  <span class='text-[14px]/[normal] font-inter font-normal flex-1 min-w-0
                    {{#if this.isCorrect}}text-[#15803D]{{else}}text-[#404040]{{/if}}'>{{this.answer}}</span>
                  {{#if this.isCorrect}}
                  <span class='box-border flex flex-row p-[2px_8px] justify-center items-center bg-[#DCFCE7] rounded-[16px]'>
                    <span class='text-[12px]/[normal] text-[#15803D] font-inter font-medium whitespace-nowrap'>Correct</span>
                  </span>
                  {{/if}}
                </div>
                {{/each}}
              </div>

              {{!-- Question Actions --}}
              <div class='flex flex-row gap-[8px] w-full pt-[4px]'>
                <a href='/question/FormEdit/{{this.id}}'
                  class='box-border shrink-0 h-[36px] flex flex-row gap-[6px] p-[6px_14px] justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] hover:bg-[#F5F5F5] transition-colors'>
                  <span class='text-[14px]/[normal] text-[#404040] font-inter font-medium whitespace-nowrap'>Edit</span>
                </a>
                <form action='/question/{{this.id}}/{{../quiz.id}}?_method=DELETE' method='POST'>
                  <button type='button' @click='confirmQuestionDelete($el)'
                    class='box-border h-[36px] flex flex-row gap-[6px] p-[6px_14px] justify-center items-center bg-[#FEF2F2] rounded-[8px] [outline:1px_solid_#FCA5A5] [outline-offset:-0.5px] hover:bg-[#FEE2E2] transition-colors'>
                    <span class='text-[14px]/[normal] text-[#EF4444] font-inter font-medium whitespace-nowrap'>Delete</span>
                  </button>
                </form>
              </div>
            </div>
          </div>
          {{/each}}
        </div>
        {{else}}
        <div class='w-full h-[72px] flex items-center justify-center mb-[10px]'>
          <span class='font-inter text-sm text-[#A3A3A3]'>No question yet. Click Add Question to create one.</span>
        </div>
        {{/if}}

        {{!-- Add Question --}}
        <a href='/question/formCreate/{{quiz.id}}'
          class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#3B82F6] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#F0F7FF] transition-colors'>
          <span class='text-[16px]/[normal] text-[#3B82F6] font-inter font-semibold whitespace-nowrap'>Add Question</span>
        </a>
      </div>

      {{!-- Answer Tab --}}
      <div x-show="tab === 'answer'" class='w-full'>
        {{#if scores.length}}
        <div class='flex flex-col gap-[10px] w-full'>
          {{#each scores}}
          <div class='box-border w-full shrink-0 h-[56px] flex flex-row gap-[12px] p-[12px_16px] justify-start items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px]'>
            <div class='flex-1 min-w-0'>
              <span class='text-[14px]/[normal] text-[#404040] font-inter font-medium'>{{this.user.username}}</span>
            </div>
            <div class='box-border flex flex-row p-[2px_10px] justify-center items-center rounded-[16px]
              {{#if (gte this.score ../quiz.minScore)}}bg-[#F0FDF4]{{else}}bg-[#FEF2F2]{{/if}}'>
              <span class='text-[14px]/[normal] font-inter font-semibold whitespace-nowrap
                {{#if (gte this.score ../quiz.minScore)}}text-[#15803D]{{else}}text-[#DC2626]{{/if}}'
                x-text='{{this.score}}'></span>
            </div>
          </div>
          {{/each}}
        </div>
        {{else}}
        <div class='w-full h-[72px] flex items-center justify-center'>
          <span class='font-inter text-sm text-[#A3A3A3]'>No scores yet. No user has completed this quiz.</span>
        </div>
        {{/if}}
      </div>

    </div>

  </div>
</div>

<script>
function confirmQuizDetailDelete(el) {
  Swal.fire({
    title: 'Delete Quiz',
    text: 'Are you sure you want to delete this quiz? Questions and scores will be removed too.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#C80606',
    cancelButtonColor: '#525252',
    confirmButtonText: 'Delete'
  }).then((result) => {
    if (result.isConfirmed) {
      el.closest('form').submit();
    }
  });
}

function confirmQuestionDelete(el) {
  Swal.fire({
    title: 'Delete Question',
    text: 'Are you sure you want to delete this question?',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#C80606',
    cancelButtonColor: '#525252',
    confirmButtonText: 'Delete'
  }).then((result) => {
    if (result.isConfirmed) {
      el.closest('form').submit();
    }
  });
}

function quizTabData() {
  return {
    tab: 'question',
    noop() {}
  }
}
</script>
