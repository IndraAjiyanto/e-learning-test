<div class="py-10">
  <div class="max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg">
    <h2 class="text-2xl font-bold mb-6 text-gray-900">Edit quiz</h2>

    <form method="POST" action="/quiz/{{quiz.id}}?_method=PATCH" class="space-y-6" x-data="{ loading: false }" @submit="loading = true;">

      <div>
        <label for="title" class="block text-sm font-semibold text-gray-700 mb-1">Quiz</label>
        <textarea id="title" name="title" rows="3"
          class="w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700">{{quiz.title}}</textarea>
      </div>

            <div>
        <label for="minimum_score" class="block text-sm font-medium text-gray-700 mb-1">
          Minimum Score
        </label>
        <input type="number" id="minimum_score" name="minimum_score" rows="4" value="{{quiz.minimum_score}}"
          class="w-full border bg-white rounded-lg p-3 focus:ring-2 focus:ring-gray-900 text-gray-700">
      </div>
      
            <div>
        <label for="duration" class="block text-sm font-medium text-gray-700 mb-1">
          Duration (minutes)
        </label>
        <input type="number" id="duration" name="duration" rows="4" value="{{quiz.duration}}"
          class="w-full border bg-white rounded-lg p-3 focus:ring-2 focus:ring-gray-900 text-gray-700">
      </div>

      <div class="flex gap-3">
        <button type="submit"
        :disabled='loading'
        :class="loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-600'"
          class="text-white px-6 py-2 rounded-lg shadow transition">
          <span x-show='loading' class='loading loading-spinner loading-sm'></span>
          <span x-show='!loading'>Update</span>
        </button>
        <a href="/quiz/{{quiz.id}}"
        :disabled='loading'
        :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300  transition'>
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>