<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-bold mb-6 text-gray-900'>Edit Attendance</h2>

    <form
      action='/absens/{{absen.id}}/{{absen.pertemuan.id}}?_method=PATCH'
      method='POST'
      class='space-y-6'
      x-data="{
      statuses: [
        { value: 'hadir', label: 'Present' },
        { value: 'izin', label: 'Permission' },
        { value: 'sakit', label: 'Sick' },
        { value: 'alfa', label: 'Absent' },
        { value: 'tidak ada keterangan', label: 'No Information' }
      ],
      searchStatus: '{{absen.status}}' === 'hadir' ? 'Present' : 
                    '{{absen.status}}' === 'izin' ? 'Permission' : 
                    '{{absen.status}}' === 'sakit' ? 'Sick' : 
                    '{{absen.status}}' === 'alfa' ? 'Absent' : 
                    '{{absen.status}}' === 'tidak ada keterangan' ? 'No Information' : '',
      showStatusDropdown: false,
      selectedStatus: { 
        value: '{{absen.status}}',
        label: '{{absen.status}}' === 'hadir' ? 'Present' : 
               '{{absen.status}}' === 'izin' ? 'Permission' : 
               '{{absen.status}}' === 'sakit' ? 'Sick' : 
               '{{absen.status}}' === 'alfa' ? 'Absent' : 
               '{{absen.status}}' === 'tidak ada keterangan' ? 'No Information' : ''
      },
      get filteredStatuses() {
        if (!this.searchStatus) return this.statuses;
        return this.statuses.filter(s => 
          s.label.toLowerCase().includes(this.searchStatus.toLowerCase())
        );
      },
      selectStatus(status) {
        this.selectedStatus = status;
        this.searchStatus = status.label;
        this.showStatusDropdown = false;
      }
    }"
    >

      <!-- Status -->
      <div class='relative'>
        <label
          for='status'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Status</label>
        <input
          type='hidden'
          name='status'
          :value='selectedStatus?.value'
          required
        />
        <input
          type='text'
          x-model='searchStatus'
          @focus='showStatusDropdown = true'
          @input='showStatusDropdown = true'
          placeholder='Search status...'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          autocomplete='off'
        />
        <div
          x-show='showStatusDropdown'
          @click.away='showStatusDropdown = false'
          class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'
        >
          <template x-for='status in filteredStatuses' :key='status.value'>
            <div
              @click='selectStatus(status)'
              class='px-4 py-2 hover:bg-gray-100 cursor-pointer text-gray-700'
              x-text='status.label'
            >
            </div>
          </template>
          <div
            x-show='filteredStatuses.length === 0'
            class='px-4 py-2 text-gray-500 text-sm'
          >
            No status found
          </div>
        </div>
      </div>

      <!-- Date -->
      <div>
        <label
          for='waktu_absen'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Attendance Date</label>
        <input
          type='date'
          id='waktu_absen'
          name='waktu_absen'
          value='{{formDate absen.waktu_absen}}'
          required
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700 cursor-pointer'
          style='color-scheme: light;'
        />
      </div>

      <!-- Note -->
      <div>
        <label
          for='keterangan'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Note</label>
        <textarea
          id='keterangan'
          name='keterangan'
          rows='3'
          placeholder='Enter additional note...'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        >{{absen.keterangan}}</textarea>
      </div>

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          class='bg-gray-900 text-white px-6 py-2 rounded-lg shadow hover:bg-gray-600 transition'
        >
          Update
        </button>
        <a
          href='/pertemuans/{{absen.pertemuan.id}}'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition'
        >
          Cancel
        </a>
      </div>

    </form>
  </div>
</div>