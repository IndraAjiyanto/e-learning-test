{{!--
  Page: Admin - Create Session
  Path: admin/session/create.hbs
  Design: slicing.pen "Container - Add Session" (1052, gap 28)
  Route: GET /session/formCreate/:weeksId -> POST /session/:weeksId (create)
  Composed from components/ui/admin atomics: text/page-header, form/form-field,
  form/text-input, form/textarea-input, form/toggle-switch, button/secondary-button.
  Backend contract kept: location, date, startTime, endTime, topic (pen "Description"),
  isFinalCheck ('true'/'false'). Pen "Start End*" label read as "Time Start*".
--}}
<div class='py-10 px-6'>
  <div class='max-w-[1052px] mx-auto'
    x-data='{ loading: false, isFinal: false }'>

    {{!-- Title: Create Session + subtitle --}}
    <div class='box-border w-full h-fit flex flex-col gap-[28px] justify-start items-start'>
      {{> components/ui/admin/text/page-header title="Create Session" subtitle="Fill in the information below to create a session."}}

      {{!-- Form --}}
      <form method='POST' action='/session/{{weeksId}}' class='box-border w-full h-fit flex flex-col gap-[16px] justify-start items-start'
        @submit='loading = true'>

        {{!-- Feature Card - Fields --}}
        {{#> components/ui/admin/form/form-card noNumber=true}}

          {{!-- Field Row: Location + Date --}}
          <div class='flex flex-row gap-[12px] w-full'>
            <div class='flex-1 min-w-0'>
              {{#> components/ui/admin/form/form-field label="Location*" for="location" errorId="location_error"}}
                {{> components/ui/admin/form/text-input
                  id="location" name="location"
                  placeholder="Enter location..."
                  required=true
                }}
              {{/components/ui/admin/form/form-field}}
            </div>
            <div class='flex-1 min-w-0'>
              {{#> components/ui/admin/form/form-field label="Date*" for="date" errorId="date_error"}}
                {{> components/ui/admin/form/text-input
                  type="date" id="date" name="date"
                  placeholder="Select date..."
                  required=true
                  icon="calendar"
                }}
              {{/components/ui/admin/form/form-field}}
            </div>
          </div>

          {{!-- Field Row: Time Start + Time End --}}
          <div class='flex flex-row gap-[12px] w-full'>
            <div class='flex-1 min-w-0'>
              {{#> components/ui/admin/form/form-field label="Time Start*" for="startTime" errorId="startTime_error"}}
                {{> components/ui/admin/form/text-input
                  type="time" id="startTime" name="startTime"
                  placeholder="Select start time..."
                  required=true
                  icon="timer"
                }}
              {{/components/ui/admin/form/form-field}}
            </div>
            <div class='flex-1 min-w-0'>
              {{#> components/ui/admin/form/form-field label="Time End*" for="endTime" errorId="endTime_error"}}
                {{> components/ui/admin/form/text-input
                  type="time" id="endTime" name="endTime"
                  placeholder="Select end time..."
                  required=true
                  icon="timer"
                }}
              {{/components/ui/admin/form/form-field}}
            </div>
          </div>

          {{!-- Field Description (posts to `topic`) --}}
          {{#> components/ui/admin/form/form-field label="Description*" for="topic" errorId="topic_error"}}
            {{> components/ui/admin/form/textarea-input
              id="topic" name="topic" rows="5"
              placeholder="Enter session description..."
            }}
           {{/components/ui/admin/form/form-field}}

        {{/components/ui/admin/form/form-card}}

        {{!-- Feature Card - Actions --}}
        <div class='box-border w-full h-fit shrink-0 flex flex-row gap-[24px] p-[20px] justify-between items-center bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px]'>
          {{!-- Toggle Row --}}
          <div class='flex flex-row gap-[10px] justify-start items-center'>
            {{> components/ui/admin/form/toggle-switch
              checkedBind="isFinal"
              onChange="isFinal = $event.target.checked"
            }}
            <span class='text-[14px]/[normal] text-[#171717] font-montserrat font-semibold whitespace-nowrap'>Jadikan session terakhir</span>
            <input type='hidden' name='isFinalCheck' :value="isFinal ? 'true' : 'false'" />
          </div>

          {{!-- Button Row --}}
          <div class='flex flex-row gap-[12px] justify-start items-center'>
            {{> components/ui/admin/button/secondary-button text="Cancel" href=(concat '/week/' weeksId)}}
            {{> components/ui/admin/button/primary-button text="Create Session" loading="loading" width="154"}}
          </div>
        </div>

      </form>
    </div>
  </div>
</div>
