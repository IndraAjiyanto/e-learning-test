{{!--
  Page: Admin - Edit Session
  Path: admin/session/edit.hbs
  Design: sama dengan admin/session/create.hbs (slicing.pen "Container - Add Session" 1052, gap 28)
  Route: GET /session/formEdit/:id -> PATCH /session/:sessionId (update)
  Data: { user, course, session, maxSession } — toggle "session terakhir" hanya
        tampil bila session yang diedit adalah session terakhir
        (session.sessionOrder == maxSession), mengikuti perilaku lama.
  Composed from components/ui/admin atomics: text/page-header, form/form-field,
  form/text-input, form/textarea-input, form/toggle-switch, button/secondary-button,
  button/primary-button.
  Backend contract kept: location, date, startTime, endTime, topic, isFinalCheck.
--}}
<div class='py-10 px-6'>
  <div class='max-w-[1052px] mx-auto'
    x-data='{ loading: false, isFinal: {{#if session.isFinal}}true{{else}}false{{/if}} }'>

    {{!-- Title: Edit Session + subtitle --}}
    <div class='box-border w-full h-fit flex flex-col gap-[28px] justify-start items-start'>
      {{> components/ui/admin/text/page-header title="Edit Session" subtitle="Update the information below to edit this session."}}

      {{!-- Form --}}
      <form method='POST' action='/session/{{session.id}}?_method=PATCH' class='box-border w-full h-fit flex flex-col gap-[16px] justify-start items-start'
        @submit='loading = true'>

        {{!-- Feature Card - Fields --}}
        {{#> components/ui/admin/form/form-card noNumber=true}}

          {{!-- Field Row: Location + Date --}}
          <div class='flex flex-col sm:flex-row gap-[12px] w-full'>
            <div class='flex-1 min-w-0'>
              {{#> components/ui/admin/form/form-field label="Location*" for="location" errorId="location_error"}}
                {{> components/ui/admin/form/text-input
                  id="location" name="location"
                  placeholder="Enter location..."
                  required=true
                  value=session.location
                }}
              {{/components/ui/admin/form/form-field}}
            </div>
            <div class='flex-1 min-w-0'>
              {{#> components/ui/admin/form/form-field label="Date*" for="date" errorId="date_error"}}
                {{> components/ui/admin/form/text-input
                  type="date" id="date" name="date"
                  placeholder="Select date..."
                  required=true
                  icon="calendar"
                  value=(formDate session.date)
                }}
              {{/components/ui/admin/form/form-field}}
            </div>
          </div>

          {{!-- Field Row: Time Start + Time End --}}
          <div class='flex flex-col sm:flex-row gap-[12px] w-full'>
            <div class='flex-1 min-w-0'>
              {{#> components/ui/admin/form/form-field label="Time Start*" for="startTime" errorId="startTime_error"}}
                {{> components/ui/admin/form/text-input
                  type="time" id="startTime" name="startTime"
                  placeholder="Select start time..."
                  required=true
                  icon="timer"
                  value=(formatTime session.startTime)
                }}
              {{/components/ui/admin/form/form-field}}
            </div>
            <div class='flex-1 min-w-0'>
              {{#> components/ui/admin/form/form-field label="Time End*" for="endTime" errorId="endTime_error"}}
                {{> components/ui/admin/form/text-input
                  type="time" id="endTime" name="endTime"
                  placeholder="Select end time..."
                  required=true
                  icon="timer"
                  value=(formatTime session.endTime)
                }}
              {{/components/ui/admin/form/form-field}}
            </div>
          </div>

          {{!-- Field Description (posts to `topic`) --}}
          {{#> components/ui/admin/form/form-field label="Description*" for="topic" errorId="topic_error"}}
            {{> components/ui/admin/form/textarea-input
              id="topic" name="topic" rows="5"
              placeholder="Enter session description..."
              value=session.topic
            }}
           {{/components/ui/admin/form/form-field}}

        {{/components/ui/admin/form/form-card}}

        {{!-- Feature Card - Actions --}}
        <div class='box-border w-full h-fit shrink-0 flex flex-col sm:flex-row gap-[16px] sm:gap-[24px] p-[20px] justify-between sm:items-center items-stretch bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px]'>
          {{!-- Toggle Row (hanya untuk session terakhir) --}}
          {{#if (eq session.sessionOrder maxSession)}}
            <div class='flex flex-row gap-[10px] justify-start items-center min-w-0'>
              {{> components/ui/admin/form/toggle-switch
                checkedBind="isFinal"
                onChange="isFinal = $event.target.checked"
              }}
              <span class='text-[14px]/[normal] text-[#171717] font-montserrat font-semibold sm:whitespace-nowrap'>Jadikan session terakhir</span>
              <input type='hidden' name='isFinalCheck' :value="isFinal ? 'true' : 'false'" />
            </div>
          {{else}}
            <div class='hidden sm:block'></div>
          {{/if}}

      <!-- Tombol di Kiri -->
      <div class='flex justify-start gap-3'>
        <button
          type='submit'
          :disabled='loading'
          :class="loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition'
        >
          <span x-show='loading' class='loading loading-spinner loading-sm'></span>
          <span x-show='!loading'>Update</span>
        </button>
        <a
          href='/session/{{session.id}}'
        :disabled='loading'
        :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300  transition'>
          Cancel
        </a>

      </div>

      </form>
    </div>
  </div>
</div>
