{{!--
  Page: Admin — Session Detail
  Path: admin/session/detail.hbs
  Route: GET /session/:sessionId -> admin/session/detail
  Data: { user, session } (Session + weeks + weeks.course)
  Komponen (reuse): form/underline-tabs, button/primary-button,
          program/user-avatar. Baru (prefix session-): session/session-hero,
          session/session-info-item, session/session-status-badge,
          session/session-attendance-table.
  BE: GET /session/attendance/:sessionId → User[] + absent[] (Attendance:
      permission|present|sick|absent|no_information); edit GET
      /attendance/formEdit/:id; delete POST /attendance/:id/:sessionId.
  Tab lain (materi/assignment/logbook) memakai partials/session/* lama — tidak diubah.
--}}
<div class='py-10 px-6'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[16px] w-full' x-data='tabData()'>

    {{!-- Feature Card 1: hero --}}
    {{> components/ui/admin/session/session-hero}}

    {{!-- Table Detail Session --}}
    <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[20px] p-[12px_20px_20px_20px] justify-start items-stretch bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px]'>

      {{!-- Underline tabs --}}
      {{> components/ui/admin/form/underline-tabs activeTabVar='tab' fetchFn='toggleFetch'}}

      {{!-- Attendance — lazy: partial baru di-mount saat tab pertama aktif --}}
      <div x-show="tab === 'attendance'" x-cloak class='flex flex-col gap-[12px] w-full'>
        <template x-if="loaded['attendance']">
          <div class='w-full' x-data='absenData()' x-init='fetchAbsens()'>
            {{> components/ui/admin/session/session-attendance-table}}
          </div>
        </template>
      </div>

      {{!-- Materi — lazy; sub-tab pdf/video/ppt tetap fetch saat diklik --}}
      <div x-show="tab === 'materi'" x-cloak class='w-full'>
        <template x-if="loaded['materi']">
          <div class='w-full' x-data='materiData()' x-init='init()'>
            {{> session/materi_tab}}
          </div>
        </template>
      </div>

      {{!-- Assignment — lazy --}}
      <div x-show="tab === 'assignment'" x-cloak class='w-full'>
        <template x-if="loaded['assignment']">
          <div class='w-full' x-data='tugasData()' x-init='fetchTugas()'>
            {{> session/tugas_tab}}
          </div>
        </template>
      </div>

      {{!-- Logbook User — lazy --}}
      <div x-show="tab === 'logbook'" x-cloak class='w-full'>
        <template x-if="loaded['logbook']">
          <div class='w-full' x-data='logbookData()' x-init='fetchLogBook()'>
            {{> session/logbook_tab}}
          </div>
        </template>
      </div>

      {{!-- Logbook Mentor — lazy --}}
      <div x-show="tab === 'logbook_mentor'" x-cloak class='w-full'>
        <template x-if="loaded['logbook_mentor']">
          <div class='w-full' x-data='logBookMentorData()' x-init='fetchLogBookMentor()'>
            {{> session/logbook_mentor_tab}}
          </div>
        </template>
      </div>


    </div>
  </div>
</div>

{{!-- Toast sukses untuk proses attendance (create, update, delete) yang
     redirect balik ke sini. Dipicu via flashToast() di attendances.controller. --}}
{{> components/ui/admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/export_excel }}

<script>
function tabData() {
  return {
    search: '',
    tab: localStorage.getItem('activeTabSession'),
    loaded: {},
    tabs: [
      { name: 'attendance', label: 'Attendance', url: '/session/attendance/{{session.id}}' },
      { name: 'materi', label: 'Materi', url: '' },
      { name: 'assignment', label: 'Assignment', url: '/session/task/{{session.id}}' },
      { name: 'logbook', label: 'Logbook User', url: '/session/logbooks/{{session.id}}' },
      { name: 'logbook_mentor', label: 'Logbook Mentor', url: '/session/logbooks-mentor/{{session.id}}' },
    ],

    async init() {
      if(!this.tab) {
          this.tab = 'attendance';
          localStorage.setItem('activeTabSession', 'attendance');
      }
      this.loaded[this.tab] = true;
      this.$watch('tab', (tabName) => {
        this.loaded[tabName] = true;
        localStorage.setItem('activeTabSession', tabName);
      });
    },

    toggleFetch(url, tabName) {
      this.tab = tabName;
      this.loaded[tabName] = true;
      localStorage.setItem('activeTabSession', tabName);
    }
  }
}

function absenData() {
  return {
    data: [],
    searchInput: '',
    search: '',
    pageNumber: 0,
    size: 5,
    amount: 0,

    async fetchAbsens() {
      const res = await fetch('/session/attendance/{{session.id}}');
      this.data = await res.json();
    },

    get filteredData() {
      let filtered = this.data.filter(u =>
            (`${u.username} ${u.email}`).toLowerCase()
          .includes(this.search.toLowerCase())
      );

      this.amount = filtered.length;

      const start = this.pageNumber * this.size;
      return filtered.slice(start, start + this.size);
    },

    pageCount() {
      return Math.ceil(this.amount / this.size);
    },

    pages() {
      return Array.from({ length: this.pageCount() });
    },

    nextPage() {
      if (this.pageNumber < this.pageCount() - 1) this.pageNumber++;
    },

    prevPage() {
      if (this.pageNumber > 0) this.pageNumber--;
    },

    viewPage(i) {
      this.pageNumber = i;
    }
  }
}
</script>

