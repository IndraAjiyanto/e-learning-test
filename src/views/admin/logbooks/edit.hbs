{{!--
  Page: Admin — Edit Logbook (Container - Logbook Form (Edit), slicing.pen Hwecx)
  Path: admin/logbooks/edit.hbs
  Route: GET /logbooks/formEdit/:logbookId -> PATCH /logbooks/:logbookId
  Data: { user, logbook (Logbook + user + session.weeks.course) }
  Design: redesign FROM create (Container - Logbook Form (Create), slicing.pen iapom) —
          struktur 1:1 dengan create (w1052 gap28, Title, Form Logbook card:
          Row1 User + Obstacle, Row2 Activity + Documentation Link, Activity Details
          textarea 128, Photo Documentation h200, footer Cancel 90 + Update).
          Perbedaan vs create (Hwecx): Title Edit Logbook / subtitle
          "Update the logbook details for this session", User read-only
          (hidden userId + foto lama via showOldPhoto), semua input prefilled,
          tombol Update Logbook, submit PATCH (kosong = pertahankan lama).
  Komponen (reuse, sama dengan create): text/page-header, form/form-card,
          form/form-field, form/form-label, form/text-input, form/textarea-input,
          button/primary-button, button/secondary-button,
          logbook/logbook-photo-upload (showOldPhoto=true).
  BE: PATCH /logbooks/:logbookId multipart { userId, activity, obstacles,
        activityDetails, otherDocumentation, documentation? }.
        FileInterceptor('documentation') + ValidateImage (JPG/PNG 5MB, folder logbook_user).
        Cancel → /session/:sessionId.
  Alpine validasi file dipertahankan verbatim (mode edit: oldPhoto + hasFile awal).
--}}
<div class='py-10 px-6'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px] w-full'>
    {{> components/ui/admin/text/page-header title="Edit Logbook" subtitle="Update the logbook details for this session"}}

    <form action='/logbooks/{{logbook.id}}?_method=PATCH' method='POST' enctype='multipart/form-data'
      class='flex flex-col gap-[16px] w-full'
      x-data="{
        ...adminFormGate(),
        loading: false,
        showFull: false,
        errorMessage: '',
        isValid: true,
        fileName: 'Existing Image',
        fileSize: 0,
        hasFile: {{#if logbook.documentation}}true{{else}}false{{/if}},
        previewUrl: null,
        oldPhoto: '{{logbook.documentation}}',
        maxSize: 5 * 1024 * 1024,
        allowedTypes: ['image/jpeg', 'image/jpg', 'image/png'],
        allowedExtensions: ['.jpg', '.jpeg', '.png'],
        validateFile(file) {
          if (!file) { this.previewUrl = null; this.hasFile = {{#if logbook.documentation}}true{{else}}false{{/if}}; return; }
          this.hasFile = true; this.fileName = file.name; this.fileSize = file.size; this.errorMessage = ''; this.isValid = true;
          if (file.size > this.maxSize) { this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum ${(this.maxSize / 1024 / 1024).toFixed(0)}MB`; this.isValid = false; this.previewUrl = null; return; }
          if (!this.allowedTypes.includes(file.type)) { this.errorMessage = `File type not allowed. Allowed: JPG, JPEG, PNG`; this.isValid = false; this.previewUrl = null; return; }
          const fn = file.name.toLowerCase(); const hasValidExtension = this.allowedExtensions.some(ext => fn.endsWith(ext));
          if (!hasValidExtension) { this.errorMessage = `File extension not allowed. Allowed: ${this.allowedExtensions.join(', ')}`; this.isValid = false; this.previewUrl = null; return; }
          this.previewUrl = URL.createObjectURL(file);
        },
        clearFile() { this.errorMessage=''; this.isValid=true; this.fileName='Existing Image'; this.fileSize=0; this.previewUrl=null; this.hasFile={{#if logbook.documentation}}true{{else}}false{{/if}}; $refs.fileInput.value=null; },
        canSubmit() { return this.formValid && this.hasFile && this.isValid; }
      }"
      x-init="initGate()"
      @input="recomputeFormValid()"
      @change="recomputeFormValid()"
      @submit.prevent="if(canSubmit()) { loading = true; $el.submit(); }"
    >

      {{#> components/ui/admin/form/form-card noNumber=true}}
        {{!-- Row 1: User (read-only, posisi sama dengan create) + Obstacle --}}
        <div class='flex flex-col md:flex-row gap-[12px] w-full'>
          <div class='flex-1 min-w-0'>
            <div class='flex flex-col gap-[6px] w-full'>
              {{> components/ui/admin/form/form-label text="User*"}}
              <div class='box-border w-full h-[44px] flex items-center px-[14px] bg-[#F5F5F5] [outline:1px_solid_#D4D4D4] rounded-[8px] text-[14px] font-inter text-[#525252]'>{{logbook.user.username}} ({{logbook.user.email}})</div>
              <input type='hidden' name='userId' value='{{logbook.user.id}}' />
            </div>
          </div>
          <div class='flex-1 min-w-0'>
            {{#> components/ui/admin/form/form-field label="Obstacle*" for="obstacles"}}
              {{> components/ui/admin/form/text-input id="obstacles" name="obstacles" required=true placeholder="Enter obstacle" value=logbook.obstacles}}
            {{/components/ui/admin/form/form-field}}
          </div>
        </div>

        {{!-- Row 2: Activity + Documentation Link (urutan sama dengan create) --}}
        <div class='flex flex-col md:flex-row gap-[12px] w-full'>
          <div class='flex-1 min-w-0'>
            {{#> components/ui/admin/form/form-field label="Activity*" for="activity"}}
              {{> components/ui/admin/form/text-input id="activity" name="activity" required=true placeholder="Enter activity" value=logbook.activity}}
            {{/components/ui/admin/form/form-field}}
          </div>
          <div class='flex-1 min-w-0'>
            {{#> components/ui/admin/form/form-field label="Documentation Link*" for="otherDocumentation"}}
              {{> components/ui/admin/form/text-input id="otherDocumentation" name="otherDocumentation" required=true placeholder="https://docs.example.com" value=logbook.otherDocumentation}}
            {{/components/ui/admin/form/form-field}}
          </div>
        </div>

        {{!-- Activity Details --}}
        <div class='flex flex-col gap-[8px] w-full'>
          {{#> components/ui/admin/form/form-field label="Activity Details*" for="activityDetails"}}
            {{> components/ui/admin/form/textarea-input id="activityDetails" name="activityDetails" required=true placeholder="Describe the activity in detail..." rows="4" value=logbook.activityDetails}}
          {{/components/ui/admin/form/form-field}}
        </div>

        {{!-- Photo Documentation --}}
        {{> components/ui/admin/logbook/logbook-photo-upload inputId="documentation" inputName="documentation" showOldPhoto=true currentFile=logbook.documentation}}
      {{/components/ui/admin/form/form-card}}

      {{#> components/ui/admin/form/form-card noNumber=true}}
        <div class='flex flex-col sm:flex-row justify-end items-stretch sm:items-center gap-[12px] w-full'>
          {{> components/ui/admin/button/secondary-button text='Cancel' href=(concat '/session/' logbook.session.id) width='90'}}
          {{> components/ui/admin/button/primary-button text='Update Logbook' type='submit' loading='loading' disabled='!canSubmit() || !isDirty' width='200'}}
        </div>
      {{/components/ui/admin/form/form-card}}

      <template x-if='hasFile && !isValid'>
        <div class='flex items-center gap-[8px] p-[12px] bg-[#FEF2F2] [outline:1px_solid_#DC2626] rounded-[8px]'>
          <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#DC2626' stroke-width='2'><path d='m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3'/><path d='M12 9v4'/><path d='M12 17h.01'/></svg>
          <p class='text-[14px] text-[#DC2626] font-inter'><span class='font-semibold'>Cannot submit:</span> Please fix the file validation errors above.</p>
        </div>
      </template>

    </form>
  </div>
</div>
