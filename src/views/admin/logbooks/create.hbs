{{!--
  Page: Admin — Create Logbook (Container - Logbook Form, slicing.pen VSDGM)
  Path: admin/logbooks/create.hbs
  Route: GET /logbooks/create/:sessionId -> POST /logbooks/:sessionId (create)
  Data: { user, sessionId, users[] }
  Design: Container w1052 gap28 → Title 34/brand (Add Logbook / Add a new logbook entry for the session)
          → Form Logbook card white r12 stroke #D9D9D9 p20 gap20 (User* + Obstacle*, Activity* + Documentation Link*,
            Activity Details* textarea 128, Photo Documentation* h200) → Footer card h86 justify end (Cancel 90 + Save Logbook 200)
  Komponen (reuse): text/page-header, form/form-card, form/form-field, form/text-input, form/textarea-input,
          form/searchable_select, button/primary-button, button/secondary-button
          Baru (prefix logbook-): logbook/logbook-photo-upload
  BE: POST /logbooks/:sessionId multipart { userId, activity, obstacles, activityDetails, otherDocumentation, documentation (file) }
      FileInterceptor('documentation') + ValidateImage (JPG/PNG 5MB, folder logbook_user)
      Cancel → /session/:sessionId
  Alpine validasi file dipertahankan verbatim.
--}}
<div class='py-10 px-6'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px] w-full'>
    {{> components/ui/admin/text/page-header title="Add Logbook" subtitle="Add a new logbook entry for the session"}}

    <form action='/logbooks/{{sessionId}}' method='POST' enctype='multipart/form-data'
      class='flex flex-col gap-[16px] w-full'
      x-data="{
        ...adminFormGate(),
        loading: false,
        showFull: false,
        errorMessage: '',
        isValid: true,
        fileName: '',
        fileSize: 0,
        hasFile: false,
        previewUrl: null,
        maxSize: 5 * 1024 * 1024,
        allowedTypes: ['image/jpeg', 'image/jpg', 'image/png'],
        allowedExtensions: ['.jpg', '.jpeg', '.png'],
        validateFile(file) {
          if (!file) { this.hasFile = false; this.previewUrl = null; return; }
          this.hasFile = true; this.fileName = file.name; this.fileSize = file.size; this.errorMessage = ''; this.isValid = true;
          if (file.size > this.maxSize) { this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum ${(this.maxSize / 1024 / 1024).toFixed(0)}MB`; this.isValid = false; this.previewUrl = null; return; }
          if (!this.allowedTypes.includes(file.type)) { this.errorMessage = `File type not allowed. Allowed: JPG, JPEG, PNG`; this.isValid = false; this.previewUrl = null; return; }
          const fn = file.name.toLowerCase(); const hasValidExtension = this.allowedExtensions.some(ext => fn.endsWith(ext));
          if (!hasValidExtension) { this.errorMessage = `File extension not allowed. Allowed: ${this.allowedExtensions.join(', ')}`; this.isValid = false; this.previewUrl = null; return; }
          this.previewUrl = URL.createObjectURL(file);
        },
        clearFile() { this.errorMessage=''; this.isValid=true; this.fileName=''; this.fileSize=0; this.hasFile=false; this.previewUrl=null; $refs.fileInput.value=null; },
        canSubmit() { return this.formValid && this.hasFile && this.isValid; }
      }"
      x-init="recomputeFormValid()"
      @input="recomputeFormValid()"
      @change="recomputeFormValid()"
      @submit.prevent="if(canSubmit()) { loading = true; $el.submit(); }"
    >

      {{#> components/ui/admin/form/form-card noNumber=true}}
        {{!-- Row 1: User + Obstacle --}}
        <div class='flex flex-col md:flex-row gap-[12px] w-full'>
          <div class='flex-1 min-w-0'>
            {{> components/ui/admin/form/searchable_select/index required=true label="User*" forId="userId" errorId="userId_error" name="userId" itemsJson=(json users) displayField="username" placeholder="Select user"}}
          </div>
          <div class='flex-1 min-w-0'>
            {{#> components/ui/admin/form/form-field label="Obstacle*" for="obstacles"}}
              {{> components/ui/admin/form/text-input id="obstacles" name="obstacles" required=true placeholder="Enter obstacle"}}
            {{/components/ui/admin/form/form-field}}
          </div>
        </div>

        {{!-- Row 2: Activity + Documentation Link --}}
        <div class='flex flex-col md:flex-row gap-[12px] w-full'>
          <div class='flex-1 min-w-0'>
            {{#> components/ui/admin/form/form-field label="Activity*" for="activity"}}
              {{> components/ui/admin/form/text-input id="activity" name="activity" required=true placeholder="Enter activity"}}
            {{/components/ui/admin/form/form-field}}
          </div>
          <div class='flex-1 min-w-0'>
            {{#> components/ui/admin/form/form-field label="Documentation Link*" for="otherDocumentation"}}
              {{> components/ui/admin/form/text-input id="otherDocumentation" name="otherDocumentation" required=true placeholder="https://docs.example.com"}}
            {{/components/ui/admin/form/form-field}}
          </div>
        </div>

        {{!-- Activity Details --}}
        <div class='flex flex-col gap-[8px] w-full'>
          {{#> components/ui/admin/form/form-field label="Activity Details*" for="activityDetails"}}
            {{> components/ui/admin/form/textarea-input id="activityDetails" name="activityDetails" placeholder="Describe the activity in detail..." rows="4"}}
          {{/components/ui/admin/form/form-field}}
        </div>

        {{!-- Photo Documentation --}}
        {{> components/ui/admin/logbook/logbook-photo-upload inputId="documentation" inputName="documentation" required=true}}
      {{/components/ui/admin/form/form-card}}

      {{#> components/ui/admin/form/form-card noNumber=true}}
        <div class='flex flex-col sm:flex-row justify-end items-stretch sm:items-center gap-[12px] w-full'>
          {{> components/ui/admin/button/secondary-button text='Cancel' href=(concat '/session/' sessionId) width='90'}}
          {{> components/ui/admin/button/primary-button text='Save Logbook' type='submit' loading='loading' disabled='!canSubmit()' width='200'}}
        </div>
      {{/components/ui/admin/form/form-card}}

      <template x-if='hasFile && !isValid'>
        <div class='flex items-center gap-[8px] p-[12px] bg-[#FEF2F2] [outline:1px_solid_#DC2626] rounded-[8px]'>
          <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#DC2626' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3'/><path d='M12 9v4'/><path d='M12 17h.01'/></svg>
          <p class='text-[14px] text-[#DC2626] font-inter'><span class='font-semibold'>Cannot submit:</span> Please fix the file validation errors above.</p>
        </div>
      </template>

    </form>
  </div>
</div>
