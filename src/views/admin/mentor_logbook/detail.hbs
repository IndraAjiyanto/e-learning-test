{{!--
  Page: Admin — Mentor Logbook Detail
  Path: admin/mentor_logbook/detail.hbs
  Route: GET /logbooks-mentor/:mentor_logbookId
  Data: { user, mentor_logbook (MentorLogbook + user + biodata + session.weeks.course) }
  Design: Slicing template terbaru Container - User Property (ZP8Hp), w1052 admin layout.
  Header Navy #003060 + 2-Column Layout (Left 560px cards, Right 348px cards).
--}}
<div class='py-10 px-6'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[24px] w-full'>

    {{!-- Top Navigation & Action Row --}}
    <div class='flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 w-full'>
      <a href='/session/{{mentor_logbook.session.id}}'
        class='inline-flex items-center gap-2 text-[#718096] hover:text-[#171717] font-montserrat font-medium text-[16px] transition-colors'>
        <svg xmlns='http://www.w3.org/2000/svg' class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7'/>
        </svg>
        <span>Back to Session</span>
      </a>

      <div class='flex flex-row items-center gap-3 self-end sm:self-auto'>
        <a href='/logbooks-mentor/formEdit/{{mentor_logbook.id}}'
          class='box-border h-[40px] px-5 flex items-center justify-center bg-[#003060] hover:bg-[#002040] text-white font-inter font-semibold text-[14px] rounded-[8px] shadow-sm transition-colors'>
          Edit Logbook
        </a>
        <form action='/logbooks-mentor/{{mentor_logbook.session.id}}/{{mentor_logbook.id}}?_method=DELETE' method='POST' class='inline'>
          <button type='button' onclick='confirmDelete(this)'
            class='box-border h-[40px] px-5 flex items-center justify-center bg-[#FEF2F2] hover:bg-[#FEE2E2] [outline:1px_solid_#FCA5A5] text-[#DC2626] font-inter font-semibold text-[14px] rounded-[8px] transition-colors cursor-pointer'>
            Delete
          </button>
        </form>
      </div>
    </div>

    {{!-- Main Card: Container - User Property (ZP8Hp 980px+ adaptif 1052px) --}}
    <div class='box-border w-full h-fit flex flex-col justify-start items-stretch rounded-[20px] overflow-hidden shadow-[0px_4px_20px_0px_rgba(0,0,0,0.06)]'>

      {{!-- Header Navy Banner --}}
      <div class='box-border w-full h-[98px] shrink-0 flex flex-row gap-[20px] p-[20px_28px] justify-between items-center bg-[#003060] rounded-t-[20px]'>
        <div class='flex-1 min-w-0 flex flex-col gap-[4px] justify-center items-start'>
          <h1 class='text-[28px]/[1.21] w-full overflow-hidden text-ellipsis whitespace-nowrap text-[#FFFFFF] font-montserrat font-bold tracking-[-1px] text-left'>
            Mentor Logbook Details
          </h1>
          <p class='text-[16px]/[1.25] w-full overflow-hidden text-ellipsis whitespace-nowrap text-[#F3F3F3] font-montserrat font-medium text-left'>
            {{default mentor_logbook.session.weeks.course.name 'Detailed progress overview'}}
          </p>
        </div>
      </div>

      {{!-- Body Container --}}
      <div class='box-border w-full h-fit flex flex-col gap-[14px] p-[24px_28px] justify-start items-stretch bg-[#FFFFFF] border border-[#D9D9D9] border-t-0 rounded-b-[20px]'>

        <div class='w-full h-fit flex flex-col lg:flex-row gap-[16px] justify-start items-start'>

          {{!-- Left Column (560px fill) --}}
          <div class='w-full lg:w-[580px] flex-1 flex flex-col gap-[12px] justify-start items-stretch'>

            {{!-- Activity --}}
            <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[10px] p-[20px_14px] justify-start items-stretch bg-[#F0F9FF] [outline:1px_solid_#BAE6FD] [outline-offset:-0.5px] rounded-[10px]'>
              <div class='w-full h-[24px] shrink-0 flex flex-row gap-[6px] justify-start items-center'>
                <svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#171717' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='shrink-0'><polygon points='13 2 3 14 12 14 11 22 21 10 12 10 13 2'/></svg>
                <div class='text-[16px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#171717] font-montserrat font-semibold text-left'>Activity</div>
              </div>
              <div class='text-[14px]/[1.4] w-full text-[#737373] font-montserrat font-medium text-left break-words'>{{default mentor_logbook.activity '-'}}</div>
            </div>

            {{!-- Key Activities --}}
            <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[10px] p-[20px_14px] justify-start items-stretch bg-[#F0F9FF] [outline:1px_solid_#BAE6FD] [outline-offset:-0.5px] rounded-[10px]'>
              <div class='w-full h-[24px] shrink-0 flex flex-row gap-[6px] justify-start items-center'>
                <svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#171717' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='shrink-0'><path d='m3 17 2 2 4-4'/><path d='m3 7 2 2 4-4'/><path d='M13 6h8'/><path d='M13 12h8'/><path d='M13 18h8'/></svg>
                <div class='text-[16px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#171717] font-montserrat font-semibold text-left'>Key Activities</div>
              </div>
              <div class='text-[14px]/[1.4] w-full text-[#737373] font-montserrat font-medium text-left break-words whitespace-pre-line'>{{default mentor_logbook.activityDetail '-'}}</div>
            </div>

            {{!-- Obstacle --}}
            <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[10px] p-[20px_14px] justify-start items-stretch bg-[#F0F9FF] [outline:1px_solid_#BAE6FD] [outline-offset:-0.5px] rounded-[10px]'>
              <div class='w-full h-[24px] shrink-0 flex flex-row gap-[6px] justify-start items-center'>
                <svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#171717' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='shrink-0'><path d='m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z'/><path d='M12 9v4'/><path d='M12 17h.01'/></svg>
                <div class='text-[16px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#171717] font-montserrat font-semibold text-left'>Obstacle</div>
              </div>
              <div class='text-[14px]/[1.4] w-full text-[#737373] font-montserrat font-medium text-left break-words'>{{default mentor_logbook.obstacle '-'}}</div>
            </div>

            {{!-- Program Name --}}
            <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[10px] p-[20px_14px] justify-start items-stretch bg-[#F0F9FF] [outline:1px_solid_#BAE6FD] [outline-offset:-0.5px] rounded-[10px]'>
              <div class='w-full h-[24px] shrink-0 flex flex-row gap-[6px] justify-start items-center'>
                <svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#171717' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='shrink-0'><path d='M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z'/><path d='M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z'/></svg>
                <div class='text-[16px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#171717] font-montserrat font-semibold text-left'>Program Name</div>
              </div>
              <div class='text-[14px]/[1.4] w-full text-[#737373] font-montserrat font-medium text-left break-words'>{{default mentor_logbook.session.weeks.course.name '-'}}</div>
            </div>

          </div>

          {{!-- Right Column (Sidebar 348px) --}}
          <div class='w-full lg:w-[348px] lg:shrink-0 flex flex-col gap-[12px] justify-start items-stretch'>

            {{!-- Mentor Information --}}
            <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[10px] p-[20px_14px] justify-start items-stretch bg-[#F0F9FF] [outline:1px_solid_#BAE6FD] [outline-offset:-0.5px] rounded-[10px]'>
              <div class='w-full h-[24px] shrink-0 flex flex-row gap-[4px] justify-start items-center'>
                <svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#000000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='shrink-0'><path d='M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/></svg>
                <div class='text-[16px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#171717] font-montserrat font-semibold text-left'>Mentor Information</div>
              </div>
              <div class='w-full flex flex-col gap-[8px] justify-start items-stretch'>
                <div class='w-full flex flex-col gap-[2px]'>
                  <span class='text-[14px]/[1.62] text-[#737373] font-montserrat font-medium'>Full Name:</span>
                  <span class='text-[14px]/[normal] text-[#171717] font-montserrat font-medium'>{{default mentor_logbook.user.username '-'}}</span>
                </div>
                <div class='w-full flex flex-col gap-[2px]'>
                  <span class='text-[14px]/[1.62] text-[#737373] font-montserrat font-medium'>Email:</span>
                  <span class='text-[14px]/[normal] text-[#171717] font-montserrat font-medium'>{{default mentor_logbook.user.email '-'}}</span>
                </div>
                <div class='w-full flex flex-col gap-[2px]'>
                  <span class='text-[14px]/[1.62] text-[#737373] font-montserrat font-medium'>LinkedIn:</span>
                  {{#if mentor_logbook.user.biodata.linkedin}}
                    <a href='{{mentor_logbook.user.biodata.linkedin}}' target='_blank' rel='noopener noreferrer'
                      class='text-[14px]/[normal] text-[#2563EB] font-montserrat font-medium hover:underline break-all'>
                      {{mentor_logbook.user.biodata.linkedin}}
                    </a>
                  {{else}}
                    <span class='text-[14px]/[normal] text-[#171717] font-montserrat font-medium'>-</span>
                  {{/if}}
                </div>
              </div>
            </div>

            {{!-- Date & Time --}}
            <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[10px] p-[20px_14px] justify-start items-stretch bg-[#F0F9FF] [outline:1px_solid_#BAE6FD] [outline-offset:-0.5px] rounded-[10px]'>
              <div class='w-full h-[24px] shrink-0 flex flex-row gap-[4px] justify-start items-center'>
                <svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#000000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='shrink-0'><path d='M8 2v4'/><path d='M16 2v4'/><rect width='18' height='18' x='3' y='4' rx='2'/><path d='M3 10h18'/></svg>
                <div class='text-[16px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#171717] font-montserrat font-semibold text-left'>Date &amp; Time</div>
              </div>
              <div class='w-full flex flex-col gap-[8px] justify-start items-stretch'>
                <div class='w-full flex flex-col gap-[2px]'>
                  <span class='text-[14px]/[1.62] text-[#737373] font-montserrat font-medium'>Created:</span>
                  <span class='text-[14px]/[normal] text-[#171717] font-montserrat font-medium'>{{formatDate mentor_logbook.createdAt}}</span>
                </div>
              </div>
            </div>

            {{!-- Photo Documentation — disamakan dengan logbook user: object-contain + fullscreen --}}
            <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[10px] p-[20px_14px] justify-start items-stretch bg-[#F0F9FF] [outline:1px_solid_#BAE6FD] [outline-offset:-0.5px] rounded-[10px]' x-data="{ full:false }">
              <div class='w-full h-[24px] shrink-0 flex flex-row gap-[4px] justify-start items-center'>
                <svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#000000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='shrink-0'><rect width='18' height='18' x='3' y='3' rx='2' ry='2'/><circle cx='9' cy='9' r='2'/><path d='m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21'/></svg>
                <div class='text-[16px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#171717] font-montserrat font-semibold text-left'>Photo Documentation</div>
              </div>
              {{#if mentor_logbook.documentation}}
                <div @click='full=true' class='box-border w-full h-auto max-h-[520px] min-h-[280px] shrink-0 flex flex-col justify-center items-center bg-white border border-[#D9D9D9] rounded-[8px] overflow-hidden p-2 cursor-zoom-in hover:border-[#93c5fd] transition-colors group'>
                  <img src='{{mentor_logbook.documentation}}' alt='Documentation' class='w-full h-auto max-h-[480px] object-contain' />
                  <span class='mt-2 text-[11px] font-medium text-[#64748b] group-hover:text-[#2563eb]'>Klik untuk fullscreen</span>
                </div>
                <a href='{{mentor_logbook.documentation}}' target='_blank' rel='noopener noreferrer' class='w-full h-[20px] flex flex-row gap-[4px] justify-start items-center hover:opacity-80 transition-opacity'>
                  <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='#737373' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='shrink-0'><path d='M15 3h6v6'/><path d='M10 14 21 3'/><path d='M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6'/></svg>
                  <span class='text-[14px]/[normal] text-[#737373] font-montserrat font-medium whitespace-nowrap'>View full image</span>
                </a>
                <div x-show='full' x-transition.opacity x-cloak @click.self='full=false' @keydown.escape.window='full=false' class='fixed inset-0 z-[70] flex items-center justify-center bg-black/85 p-4 sm:p-8'>
                  <button @click='full=false' class='absolute right-4 top-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-[#0f172a] hover:bg-white'>
                    <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg>
                  </button>
                  <img src='{{mentor_logbook.documentation}}' alt='Fullscreen' class='max-h-[88vh] max-w-[92vw] w-auto h-auto object-contain rounded-xl bg-white p-1 shadow-2xl' />
                </div>
              {{else}}
                <div class='box-border w-full h-[220px] shrink-0 flex flex-col gap-[8px] justify-center items-center bg-[#F8F9FA] border border-[#D9D9D9] rounded-[8px]'>
                  <svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 24 24' fill='none' stroke='#A3A3A3' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect width='18' height='18' x='3' y='3' rx='2' ry='2'/><circle cx='9' cy='9' r='2'/><path d='m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21'/></svg>
                  <span class='font-montserrat text-[12px] text-[#A3A3A3]'>No documentation uploaded</span>
                </div>
              {{/if}}
            </div>

          </div>

        </div>

      </div>

    </div>

  </div>
</div>
