{{!--
  Page: Admin — Edit Mentor Logbook (Container - Logbook Form (Edit), slicing.pen Hwecx)
  Path: admin/mentor_logbook/edit.hbs
  Route: GET /logbooks-mentor/formEdit/:mentor_logbookId -> PATCH /logbooks-mentor/:mentor_logbookId
  Data: { user, mentor_logbook (MentorLogbook + user + session) }
  Design: redesign FROM create (mentor_logbook/create.hbs, iapom) — struktur 1:1
          (w1052 gap28, Title, Form Logbook card: Row Activity* + Obstacle*,
          Activity Details* textarea 128, Photo Documentation* h200 dengan oldPhoto,
          footer Cancel 90 + Update).
          Perbedaan vs create (Hwecx): Title Edit Mentor Logbook / subtitle
          "Update the mentor logbook details for this session", semua input
          prefilled, tombol Update Logbook, submit PATCH (tanpa ganti foto =
          pertahankan lama).
  Komponen (reuse, sama dengan create): text/page-header, form/form-card,
          button/primary-button, button/secondary-button,
          logbook/logbook-mentor-form-fields (prefill + showOldPhoto, tanpa
          photoRequired agar submit tanpa ganti foto lolos validasi HTML).
  BE: PATCH /logbooks-mentor/:mentor_logbookId multipart { activity, activityDetail,
        obstacle, documentation? }.
        FileInterceptor('documentation') + ValidateImage (JPG/PNG 5MB, folder mentor_logbook).
        Cancel → /session/:sessionId.
  Alpine validasi file dipertahankan verbatim mode edit (oldPhoto + hasFile awal).
--}}
<div class='py-10 px-6'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px] w-full'>
    {{> components/ui/admin/text/page-header title="Edit Mentor Logbook" subtitle="Update the mentor logbook details for this session"}}

    <form action='/logbooks-mentor/{{mentor_logbook.id}}?_method=PATCH' method='POST' enctype='multipart/form-data'
      class='flex flex-col gap-[16px] w-full'
      x-data="{
        ...adminFormGate(),
        loading: false,
        showFull: false,
        errorMessage: '',
        isValid: true,
        fileName: 'Existing Image',
        fileSize: 0,
        hasFile: {{#if mentor_logbook.documentation}}true{{else}}false{{/if}},
        previewUrl: null,
        oldPhoto: '{{mentor_logbook.documentation}}',
        maxSize: 5 * 1024 * 1024,
        allowedTypes: ['image/jpeg', 'image/jpg', 'image/png'],
        allowedExtensions: ['.jpg', '.jpeg', '.png'],
        validateFile(file) {
          if (!file) { this.previewUrl = null; this.hasFile = {{#if mentor_logbook.documentation}}true{{else}}false{{/if}}; return; }
          this.hasFile = true; this.fileName = file.name; this.fileSize = file.size; this.errorMessage = ''; this.isValid = true;
          if (file.size > this.maxSize) { this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum ${(this.maxSize / 1024 / 1024).toFixed(0)}MB`; this.isValid = false; this.previewUrl = null; return; }
          if (!this.allowedTypes.includes(file.type)) { this.errorMessage = `File type not allowed. Allowed: JPG, JPEG, PNG`; this.isValid = false; this.previewUrl = null; return; }
          const fn = file.name.toLowerCase(); const hasValidExtension = this.allowedExtensions.some(ext => fn.endsWith(ext));
          if (!hasValidExtension) { this.errorMessage = `File extension not allowed. Allowed: ${this.allowedExtensions.join(', ')}`; this.isValid = false; this.previewUrl = null; return; }
          this.previewUrl = URL.createObjectURL(file);
        },
        clearFile() { this.errorMessage=''; this.isValid=true; this.fileName='Existing Image'; this.fileSize=0; this.previewUrl=null; this.hasFile={{#if mentor_logbook.documentation}}true{{else}}false{{/if}}; $refs.fileInput.value=null; },
        canSubmit() { return this.formValid && this.hasFile && this.isValid; }
      }"
      x-init="initGate()"
      @input="recomputeFormValid()"
      @change="recomputeFormValid()"
      @submit.prevent="if(canSubmit()) { loading = true; $el.submit(); }"
    >

      {{#> components/ui/admin/form/form-card noNumber=true}}
        {{> components/ui/admin/logbook/logbook-mentor-form-fields activityValue=mentor_logbook.activity activityDetailValue=mentor_logbook.activityDetail obstacleValue=mentor_logbook.obstacle showOldPhoto=true currentFile=mentor_logbook.documentation}}
      {{/components/ui/admin/form/form-card}}

      {{#> components/ui/admin/form/form-card noNumber=true}}
        <div class='flex flex-col sm:flex-row justify-end items-stretch sm:items-center gap-[12px] w-full'>
          {{> components/ui/admin/button/secondary-button text='Cancel' href=(concat '/session/' mentor_logbook.session.id) width='90'}}
          {{> components/ui/admin/button/primary-button text='Update Logbook' type='submit' loading='loading' disabled='!canSubmit() || !isDirty' width='200'}}
        </div>
      {{/components/ui/admin/form/form-card}}

      <template x-if='hasFile && !isValid'>
        <div class='flex items-center gap-[8px] p-[12px] bg-[#FEF2F2] [outline:1px_solid_#DC2626] rounded-[8px]'>
          <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#DC2626' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3'/><path d='M12 9v4'/><path d='M12 17h.01'/></svg>
          <p class='text-[14px] text-[#DC2626] font-inter'><span class='font-semibold'>Cannot submit:</span> Please fix the file validation errors above.</p>
        </div>
      </template>

    </form>
  </div>
</div>
