{{!--
  Page: Admin — Assignment Review / Logbook Review (Container - Logbook Detail 1022, slicing.pen iLK5a)
  Path: admin/answers-assignments/index.hbs
  Route: GET /answer-assigment/:assignmentId (admin)
  Data: { user, assignment (Assignment + session.weeks.course), assignment_answer[] }
  Design: Container w1052 gap28 → Frame 2147229618 (Back + Title 34/brand, subtitle 16/medium)
          → Frame 2147229619 (2 Kolom gap 16):
          - Kiri: Table Detail Session (w554, fill #FFF, r12, stroke #D9D9D9, p12 20 20 20, gap20):
            Tabs All/Under Review/Approved/Rejected + Button Wrapper cards (answer-review-card.hbs).
          - Kanan: View Logbook (w482, r12, stroke #D9D9D9, overflow hidden, header navy #003060 h93
            dengan Title "Assigment File" + assignment.title, body white p24 28 canvas #282828).
  Komponen:
    - components/ui/admin/assignment/answer-review-card (molekul card jawaban siswa)
    - components/ui/admin/assignment/assignment-file-preview (organism panel kanan View Logbook)
--}}
<div class='py-10 px-4 sm:px-6'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px] w-full'
    x-data='answerTabData()' x-init='init()'
    @review-select.window='selectedUserId = $event.detail.userId; selectedUsername = $event.detail.username; selectedFile = $event.detail.file; activePreviewMode = "student"'>

    {{!-- Frame 2147229618: Back + Title --}}
    <div class='flex flex-col gap-[12px] w-full'>
      {{!-- Frame 2147229598: Back (z4xUMn: SVG Hiwbb + Back pFeHu) --}}
      <div class='flex flex-row gap-[24px] justify-between items-center w-full'>
        <a href='/session/{{assignment.session.id}}'
          class='flex flex-row gap-[4px] justify-start items-center hover:opacity-70 transition-opacity'
          title='Back' aria-label='Back'>
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#718096' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px] shrink-0'>
            <path d='m15 18-6-6 6-6'/>
          </svg>
          <span class='text-[16px]/[normal] text-[#718096] font-montserrat font-medium'>Back</span>
        </a>
      </div>

      {{!-- Title (ZPyni: Heading B0EYt + Sub heading gwOFm) --}}
      <div class='flex flex-col gap-[4px] w-full'>
        <h1 class='text-[34px]/[1.06] w-full text-[#003060] font-montserrat font-bold tracking-[-1px] text-left'>
          {{#if assignment.session.sessionOrder}}Session {{assignment.session.sessionOrder}} - Logbook Review{{else}}{{default assignment.title 'Assignment Review'}}{{/if}}
        </h1>
        <p class='text-[16px]/[1.25] w-full text-[#718096] font-montserrat font-medium text-left'>
          Review submitted logbooks for this session
        </p>
      </div>
    </div>

    {{!-- Frame 2147229619: Main 2-Column Layout (gap 16px) --}}
    <div class='flex flex-col lg:flex-row gap-[16px] w-full items-start justify-between'>

      {{!-- Left Column: Table Detail Session (N7EC40: w554 fill, r12, stroke #D9D9D9, p12 20 20 20, gap20) --}}
      <div class='box-border w-full lg:w-[554px] flex-1 min-w-0 flex flex-col gap-[20px] p-[12px_20px_20px_20px] justify-start items-stretch bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.06)]'>

        {{!-- Tabs Row (oE90a: w512, h41, strokeBottom 1px #D9D9D9) --}}
        <div class='flex flex-row w-full [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#D9D9D9] overflow-x-auto'>
          {{!-- All Tab (As9Bq: w83, h40, p10 32, font 14/600 #003060) --}}
          <button type='button' @click="setTab('all')"
            :class="activeTab === 'all' ? 'border-b-[#003060] text-[#003060]' : 'border-transparent text-[#718096] hover:text-[#003060]'"
            class='shrink-0 h-[40px] flex flex-row gap-[4px] px-[28px] py-[10px] border-b-2 justify-center items-center text-[14px]/[normal] font-montserrat font-semibold whitespace-nowrap hover:bg-[#F5F5F5] transition-colors'>
            All
          </button>

          {{!-- Under Review Tab (vUAGT: w166, h40, p10 32, font 14/600 #003060) --}}
          <button type='button' @click="setTab('process')"
            :class="activeTab === 'process' ? 'border-b-[#003060] text-[#003060]' : 'border-transparent text-[#718096] hover:text-[#003060]'"
            class='shrink-0 h-[40px] flex flex-row gap-[4px] px-[24px] py-[10px] border-b-2 justify-center items-center text-[14px]/[normal] font-montserrat font-semibold whitespace-nowrap hover:bg-[#F5F5F5] transition-colors'>
            Under Review
          </button>

          {{!-- Approved Tab (f2Fi6: w135, h40, p10 32, font 14/600 #003060) --}}
          <button type='button' @click="setTab('approved')"
            :class="activeTab === 'approved' ? 'border-b-[#003060] text-[#003060]' : 'border-transparent text-[#718096] hover:text-[#003060]'"
            class='shrink-0 h-[40px] flex flex-row gap-[4px] px-[24px] py-[10px] border-b-2 justify-center items-center text-[14px]/[normal] font-montserrat font-semibold whitespace-nowrap hover:bg-[#F5F5F5] transition-colors'>
            Approved
          </button>

          {{!-- Rejected Tab (B6Oy0: w128, h40, p10 32, font 14/600 #003060) --}}
          <button type='button' @click="setTab('rejected')"
            :class="activeTab === 'rejected' ? 'border-b-[#003060] text-[#003060]' : 'border-transparent text-[#718096] hover:text-[#003060]'"
            class='shrink-0 h-[40px] flex flex-row gap-[4px] px-[24px] py-[10px] border-b-2 justify-center items-center text-[14px]/[normal] font-montserrat font-semibold whitespace-nowrap hover:bg-[#F5F5F5] transition-colors'>
            Rejected
          </button>
        </div>

        {{!-- Accordion Answer Review Cards List (klUCl) --}}
        {{#if assignment_answer.length}}
        <div class='flex flex-col gap-[12px] w-full'>
          {{#each assignment_answer}}
            {{> components/ui/admin/assignment/answer-review-card assignmentId=../assignment.id}}
          {{/each}}
        </div>
        {{else}}
        <div class='w-full py-16 flex flex-col items-center justify-center text-center'>
          <div class='w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-3'>
            <svg xmlns='http://www.w3.org/2000/svg' class='w-6 h-6' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
              <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'/>
            </svg>
          </div>
          <p class='text-[16px]/[normal] text-[#404040] font-inter font-semibold'>No Answers Yet</p>
          <p class='text-[14px]/[normal] text-[#A3A3A3] font-inter mt-1'>No user has submitted an answer for this assignment yet.</p>
        </div>
        {{/if}}

      </div>

      {{!-- Right Column: View Logbook (TkXtP: w482, h820, r12, stroke #D9D9D9, fill #FFF) --}}
      {{> components/ui/admin/assignment/assignment-file-preview assignment=assignment}}

    </div>

  </div>
</div>

<script>
function previewEmbedUrl(url) {
  if (!url) return '';
  var u = String(url).trim();
  var driveFile = u.match(/drive\.google\.com\/file\/d\/([^/?]+)/);
  if (driveFile) return 'https://drive.google.com/file/d/' + driveFile[1] + '/preview';
  if (/drive\.google\.com/.test(u)) {
    var driveId = u.match(/[?&]id=([^&]+)/);
    if (driveId) return 'https://drive.google.com/file/d/' + driveId[1] + '/preview';
  }
  if (/docs\.google\.com\/presentation\/.+\/embed/.test(u)) return u;
  if (/\.pdf$/i.test(u.split(/[?#]/)[0])) return u;
  return '';
}

function answerTabData() {
  return {
    activeTab: localStorage.getItem('answerTab') || 'all',
    selectedUserId: '{{#with (lookup assignment_answer 0)}}{{this.user.id}}{{/with}}',
    selectedUsername: '{{#with (lookup assignment_answer 0)}}{{this.user.username}}{{/with}}',
    selectedFile: '{{#with (lookup assignment_answer 0)}}{{this.file}}{{/with}}',
    activePreviewMode: 'assignment',
    masterFile: '{{assignment.file}}',

    init() {
      this.filterCards();
    },

    currentPreviewRawUrl() {
      if (this.activePreviewMode === 'student' && this.selectedFile) {
        return this.selectedFile;
      }
      return this.masterFile;
    },

    currentPreviewEmbedUrl() {
      return previewEmbedUrl(this.currentPreviewRawUrl());
    },

    setTab(status) {
      this.activeTab = status;
      localStorage.setItem('answerTab', status);
      this.filterCards();
    },

    filterCards() {
      const cards = document.querySelectorAll('[data-status]');
      cards.forEach(card => {
        if (this.activeTab === 'all' || card.dataset.status === this.activeTab) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }
  };
}

function cardData() {
  return {
    isOpen: false
  };
}
</script>
