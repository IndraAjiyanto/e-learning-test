{{!--
  Page: Admin - Create Week (Session Form)
  Path: admin/weeks/create.hbs
  Design: slicing.pen "Container - Session Form" (1052, gap 28)
  Route: GET /week/formAdd/:id -> POST /week/:courseId (create)
  Composed from components/ui/admin atomics: text/page-header, form/form-field,
  form/text-input, form/toggle-switch, button/secondary-button.
--}}
<div class='py-10 px-6'>
  <div class='max-w-[1052px] mx-auto'
    x-data='{ ...adminFormGate(), loading: false, isFinal: false }'
    x-init="recomputeFormValid()"
    @input="recomputeFormValid()"
    @change="recomputeFormValid()">

    {{!-- Title: Create Week + subtitle --}}
    <div class='box-border w-full h-fit flex flex-col gap-[28px] justify-start items-start'>
      {{> components/ui/admin/text/page-header title="Create Week" subtitle="Fill in the information below to create a week."}}

      {{!-- Form --}}
      <form method='POST' action='/week/{{id}}' class='box-border w-full h-fit flex flex-col gap-[16px] justify-start items-start'
        @submit='loading = true'>

        {{!-- Feature Card - Description --}}
        {{#> components/ui/admin/form/form-card noNumber=true}}
          {{#> components/ui/admin/form/form-field label="Description*" for="description" errorId="description_error"}}
            {{> components/ui/admin/form/text-input
              id="description" name="description" required=true
              placeholder="Enter description week"
            }}
          {{/components/ui/admin/form/form-field}}
        {{/components/ui/admin/form/form-card}}

        {{!-- Feature Card - Session Action --}}
        <div class='box-border w-full h-fit shrink-0 flex flex-row gap-[24px] p-[20px] justify-between items-center bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px]'>
          {{!-- Toggle Row --}}
          <div class='flex flex-row gap-[10px] justify-start items-center'>
            {{> components/ui/admin/form/toggle-switch
              checkedBind="isFinal"
              onChange="isFinal = $event.target.checked"
            }}
            <span class='text-[14px]/[normal] text-[#171717] font-montserrat font-semibold whitespace-nowrap'>Jadikan pertemuan terakhir</span>
            <input type='hidden' name='isFinalCheck' :value="isFinal ? 'true' : 'false'" />
          </div>

          {{!-- Button Row --}}
          <div class='flex flex-row gap-[12px] justify-start items-center'>
            {{> components/ui/admin/button/secondary-button text="Cancel" href=(concat '/program/detail/program/admin/' id)}}
            {{> components/ui/admin/button/primary-button text="Create Week" loading="loading" disabled='!formValid' width="136"}}
          </div>
        </div>

      </form>
    </div>
  </div>
</div>
