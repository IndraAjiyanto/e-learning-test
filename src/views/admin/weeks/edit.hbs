{{!--
  Page: Admin - Edit Week (Session Form)
  Path: admin/weeks/edit.hbs
  Design: sama dengan admin/weeks/create.hbs (slicing.pen "Container - Session Form" 1052, gap 28)
  Route: GET /week/formEdit/:weeksId -> PATCH /week/update/:weeksId (update)
  Data: { user, weeks, lastWeek, maxWeek } — toggle "pertemuan terakhir" hanya
        tampil bila week yang diedit adalah week terakhir (weeks.weekNumber == maxWeek),
        mengikuti perilaku lama. Service memaksa isFinal=false untuk week lain.
  Composed from components/ui/admin atomics: text/page-header, form/form-field,
  form/text-input, form/toggle-switch, button/secondary-button, button/primary-button.
--}}
<div class='py-10 px-6'>
  <div class='max-w-[1052px] mx-auto'
    x-data='{ loading: false, isFinal: {{#if weeks.isFinal}}true{{else}}false{{/if}} }'>

    {{!-- Title: Edit Week + subtitle --}}
    <div class='box-border w-full h-fit flex flex-col gap-[28px] justify-start items-start'>
      {{> components/ui/admin/text/page-header title="Edit Week" subtitle="Update the information below to edit this week."}}

      {{!-- Form --}}
      <form method='POST' action='/week/update/{{weeks.id}}?_method=PATCH' class='box-border w-full h-fit flex flex-col gap-[16px] justify-start items-start'
        @submit='loading = true'>

        {{!-- Feature Card - Description --}}
        {{#> components/ui/admin/form/form-card noNumber=true}}
          {{#> components/ui/admin/form/form-field label="Description*" for="description" errorId="description_error"}}
            {{> components/ui/admin/form/text-input
              id="description" name="description"
              placeholder="Enter description week"
              value=weeks.description
            }}
          {{/components/ui/admin/form/form-field}}
        {{/components/ui/admin/form/form-card}}

        {{!-- Feature Card - Session Action --}}
        <div class='box-border w-full h-fit shrink-0 flex flex-col sm:flex-row gap-[16px] sm:gap-[24px] p-[20px] justify-between sm:items-center items-stretch bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px]'>
          {{!-- Toggle Row (hanya untuk week terakhir) --}}
          {{#if (eq weeks.weekNumber maxWeek)}}
            <div class='flex flex-row gap-[10px] justify-start items-center min-w-0'>
              {{> components/ui/admin/form/toggle-switch
                checkedBind="isFinal"
                onChange="isFinal = $event.target.checked"
              }}
              <span class='text-[14px]/[normal] text-[#171717] font-montserrat font-semibold sm:whitespace-nowrap'>Jadikan pertemuan terakhir</span>
              <input type='hidden' name='isFinalCheck' :value="isFinal ? 'true' : 'false'" />
            </div>
          {{else}}
            <div class='hidden sm:block'></div>
          {{/if}}

          {{!-- Button Row --}}
          <div class='flex flex-col sm:flex-row gap-[12px] justify-start sm:justify-end items-start sm:items-center w-full sm:w-auto'>
            {{> components/ui/admin/button/secondary-button text="Cancel" href=(concat '/week/' weeks.id)}}
            {{> components/ui/admin/button/primary-button text="Update Week" loading="loading" width="136"}}
          </div>
        </div>

      </form>
    </div>
  </div>
</div>
