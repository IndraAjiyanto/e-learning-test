{{!--
  Page: Admin — Meeting Detail (Week)
  Path: admin/weeks/detail.hbs
  Design: slicing.pen "Container - Meeting Detail" (1052, gap 16)
  Route: GET /week/:weeksId (findOne) — data: { weeks (course), lastSession }
  Feature Card - Meeting: back link, "Pertemuan NN" 34 + description + badge, Delete (red text) + Edit Week (navy)
  Table Detail Week: underline tabs (Session + Quiz if lastSession), session rows + Add Session
  Quiz tab content frozen (partials/weeks/quiz_tab).
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='box-border w-full max-w-[1052px] mx-auto flex flex-col gap-[16px] justify-start items-start'>

    {{!-- Feature Card - Meeting --}}
    <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[14px] p-[20px] justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px]'>

      {{!-- Back Row --}}
      <div class='w-full flex flex-row justify-between items-center'>
        <a href='/program/detail/program/admin/{{weeks.course.id}}'
          class='flex flex-row gap-[4px] justify-start items-center hover:opacity-70 transition-opacity'
          title='Back' aria-label='Back'>
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#718096' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'><polyline points='15 18 9 12 15 6'/></svg>
          <span class='text-[16px]/[normal] text-[#718096] font-montserrat font-medium'>Back</span>
        </a>
      </div>

      {{!-- Title Row --}}
      <div class='w-full flex flex-row gap-[12px] justify-between items-start'>
        <div class='flex flex-col gap-[16px] flex-1 min-w-0 justify-start items-start'>
          <div class='flex flex-col gap-[4px] w-full'>
            <div class='text-[34px]/[normal] w-full text-[#003060] font-montserrat font-bold text-left'>Pertemuan {{weeks.week_number}}</div>
            <div class='text-[14px]/[normal] w-full text-[#718096] font-montserrat font-medium text-left break-words'>{{weeks.description}}</div>
          </div>
          <div class='box-border w-[173px] flex flex-row p-[2px_8px] justify-center items-center bg-[#F5F5F5] rounded-[16px]'>
            <span class='text-[12px]/[normal] text-[#404040] font-inter font-medium text-center whitespace-nowrap'><span class='capitalize'>{{weeks.course.method}}</span> · Session {{weeks.week_number}} · {{default weeks.course.quota '-'}} Seats</span>
          </div>
        </div>

        {{!-- Actions --}}
        <div class='flex flex-row gap-[12px] shrink-0 justify-start items-center'>
          <form action='/week/{{weeks.id}}/{{weeks.course.id}}?_method=DELETE' method='POST'>
            <button type='button'
              @click='confirmMeetingDelete($el)'
              class='box-border w-[87px] shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FEF2F2] rounded-[8px] [outline:1px_solid_#FCA5A5] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#FEE2E2] transition-colors'
              title='Delete Week' aria-label='Delete Week'>
              <span class='text-[16px]/[normal] text-[#EF4444] font-inter font-semibold whitespace-nowrap'>Delete</span>
            </button>
          </form>
          <a href='/week/formEdit/{{weeks.id}}'
            class='box-border w-[114px] shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#003060] rounded-[8px] [outline:1px_solid_#003060] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#00254a] transition-colors'
            title='Edit Week' aria-label='Edit Week'>
            <span class='text-[16px]/[normal] text-[#FFFFFF] font-inter font-semibold whitespace-nowrap'>Edit Week</span>
          </a>
        </div>
      </div>

    </div>

    {{!-- Table Detail Week --}}
    <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[20px] justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px] overflow-hidden p-[12px_20px_20px_20px]' x-data="tabData()">

      {{!-- Tab Bar: underline-tabs component --}}
      <div x-data="{ tabs: [
        {name:'session',label:'Session',url:'/week/session/{{weeks.id}}'},
        {name:'quiz',label:'Quiz',url:'/week/quiz/{{weeks.id}}'}
      ] }">
        {{> components/ui/admin/form/underline-tabs activeTabVar="tab" fetchFn="toggleFetch"}}
      </div>

      {{!-- Session Rows --}}
      <div x-show="tab === 'session'" class='w-full' x-data="sessionData()" x-init="fetchSessions()">{{> weeks/session_tab}}</div>

      {{!-- Quiz (frozen) --}}
      <div x-show="tab === 'quiz'" class='w-full' x-data="quizData()" x-init="fetchQuizzes()">{{> weeks/quiz_tab}}</div>

    </div>

  </div>
</div>

<script>
function confirmMeetingDelete(el) {
  Swal.fire({
    title: 'Delete Week',
    text: 'Are you sure you want to delete this week? Sessions inside it will be removed too.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#C80606',
    cancelButtonColor: '#525252',
    confirmButtonText: 'Delete'
  }).then((result) => {
    if (result.isConfirmed) {
      el.closest('form').submit();
    }
  });
}

function tabData() {
  return {
    search: '',
    tab: localStorage.getItem('activeTabWeek'),
    data: localStorage.getItem('activeData')
      ? JSON.parse(localStorage.getItem('activeData'))
      : [],


    async init() {
      if(!this.tab) {
          this.tab = 'session';
          localStorage.setItem('activeTabWeek', 'session');
      }
    },

    async toggleFetch(url, tabName) {
      this.tab = tabName;
      localStorage.setItem('activeTabWeek', tabName);

      try {
        if(url === '') {
          this.data = [];
          localStorage.removeItem('activeData');
          return;
        }else{
          const response = await fetch(url);
        if (!response.ok) throw new Error('Network error');

        this.data = await response.json();
        localStorage.setItem('activeData', JSON.stringify(this.data));
        }
      } catch (error) {
      }
    }
  }
}
</script>
