<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl text-gray-900 font-semibold mb-6'>Edit Log Book</h2>

    <form
      action='/logbook-mentor/{{logbook_mentor.id}}?_method=PATCH'
      method='POST'
      enctype='multipart/form-data'
      class='space-y-6'
    >

      <div>
        <label
          for='kegiatan'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Activity</label>
        <input
          type='text'
          id='kegiatan'
          name='kegiatan'
          required
          placeholder='Enter activity...'
          value='{{logbook_mentor.kegiatan}}'
          class='w-full border text-gray-700 bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900'
        />
      </div>

      <div>
        <label
          for='rincian_kegiatan'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Activity Details</label>
        <textarea
          name='rincian_kegiatan'
          id='rincian_kegiatan'
          placeholder='Enter activity details...'
          class='w-full text-gray-700 bg-white border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900'
        >{{logbook_mentor.rincian_kegiatan}}</textarea>
      </div>

      <div>
        <label
          for='kendala'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Obstacle</label>
        <input
          type='text'
          id='kendala'
          name='kendala'
          required
          placeholder='Enter obstacle...'
          value='{{logbook_mentor.kendala}}'
          class='w-full border text-gray-700 bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900'
        />
      </div>

      <div
        x-data="{
          previewUrl: '{{logbook_mentor.dokumentasi}}',
          errorMessage: '',
          isValid: true,
          fileName: '',
          fileSize: 0,
          hasFile: false,
          validateImage(file) {
            if (!file) {
              this.previewUrl = '{{logbook_mentor.dokumentasi}}';
              this.errorMessage = '';
              this.isValid = true;
              this.fileName = '';
              this.fileSize = 0;
              this.hasFile = false;
              return;
            }

            this.fileName = file.name;
            this.fileSize = file.size;
            this.hasFile = true;

            // Check file size (5MB)
            const maxSize = 5 * 1024 * 1024;
            if (file.size > maxSize) {
              this.errorMessage = 'File size must be less than 5MB';
              this.isValid = false;
              this.previewUrl = '{{logbook_mentor.dokumentasi}}';
              return;
            }

            // Check file type
            const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
            if (!allowedTypes.includes(file.type)) {
              this.errorMessage = 'File type must be JPEG, JPG, or PNG';
              this.isValid = false;
              this.previewUrl = '{{logbook_mentor.dokumentasi}}';
              return;
            }

            this.errorMessage = '';
            this.isValid = true;
            this.previewUrl = URL.createObjectURL(file);
          },
          clearFile() {
            this.previewUrl = '{{logbook_mentor.dokumentasi}}';
            this.errorMessage = '';
            this.isValid = true;
            this.fileName = '';
            this.fileSize = 0;
            this.hasFile = false;
            this.$refs.fileInput.value = null;
          }
        }"
        class='space-y-3'
      >
        <label
          for='dokumentasi'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Photo Documentation
          <span class='text-xs text-gray-500 font-normal'>(max 5MB)</span>
        </label>
        <input
          type='file'
          id='dokumentasi'
          name='dokumentasi'
          accept='image/jpeg,image/jpg,image/png'
          x-ref='fileInput'
          :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          @change='validateImage($event.target.files[0])'
        />

        <!-- Error Message -->
        <template x-if='!isValid && errorMessage'>
          <div
            class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
          >
            <svg
              class='w-5 h-5 text-red-500 mt-0.5 flex-shrink-0'
              fill='currentColor'
              viewBox='0 0 20 20'
            >
              <path
                fill-rule='evenodd'
                d='M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z'
                clip-rule='evenodd'
              />
            </svg>
            <div>
              <p
                class='text-sm font-medium text-red-800'
                x-text='errorMessage'
              ></p>
              <template x-if='fileName'>
                <p
                  class='text-xs text-red-600 mt-1'
                  x-text='`File: ${fileName}`'
                ></p>
              </template>
            </div>
          </div>
        </template>

        <!-- Preview with validation success -->
        <template x-if='previewUrl && isValid'>
          <div class='space-y-2'>
            <div class='relative w-32 h-32'>
              <img
                :src='previewUrl'
                alt='Photo Preview'
                class='w-32 h-32 object-cover rounded-lg border border-gray-300'
              />
              <button
                type='button'
                class='absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center shadow hover:bg-red-600'
                @click='clearFile()'
              >
                &times;
              </button>
            </div>
            <div class='text-xs text-gray-600'>
              <p
                x-text='hasFile ? `${fileName} (${(fileSize / 1024 / 1024).toFixed(2)} MB)` : "Existing image"'
              ></p>
            </div>
          </div>
        </template>
      </div>

      <div class='flex space-x-4'>
        <button
          type='submit'
          class='bg-gray-900 text-white px-6 py-2 rounded-lg shadow hover:bg-gray-600 transition'
        >
          Update Log Book
        </button>
        <a
          href='/pertemuans/{{logbook_mentor.pertemuan.id}}'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition'
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>