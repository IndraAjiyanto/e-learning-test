<div class="py-10">
  <div class="max-w-3xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg">
    <h2 class="text-2xl text-gray-900 font-semibold mb-6">Log Book Detail</h2>

    <div class="space-y-6">
      <!-- Activity -->
      <div class="flex justify-between items-start">
        <p class="text-sm font-semibold text-gray-700 w-1/3">Activity</p>
        <p class="text-gray-900 w-2/3">{{logbook_mentor.kegiatan}}</p>
      </div>

      <!-- Activity Details -->
      <div class="flex justify-between items-start">
        <p class="text-sm font-semibold text-gray-700 w-1/3">Activity Details</p>
        <p class="text-gray-900 w-2/3 whitespace-pre-line">{{logbook_mentor.rincian_kegiatan}}</p>
      </div>

      <!-- Obstacle -->
      <div class="flex justify-between items-start">
        <p class="text-sm font-semibold text-gray-700 w-1/3">Obstacle</p>
        <p class="text-gray-900 w-2/3">{{logbook_mentor.kendala}}</p>
      </div>

      <!-- Documentation -->
      <div class="flex justify-between items-start">
        <p class="text-sm font-semibold text-gray-700 w-1/3">Photo Documentation</p>
        <div class="w-2/3">
          {{#if logbook_mentor.dokumentasi}}
            <img src="{{logbook_mentor.dokumentasi}}" alt="Documentation" 
                 class="w-48 h-48 object-cover rounded-lg border border-gray-300 shadow">
          {{else}}
            <p class="text-gray-500 italic">No documentation uploaded.</p>
          {{/if}}
        </div>
      </div>

      <!-- User -->
      <div class="flex justify-between items-start">
        <p class="text-sm font-semibold text-gray-700 w-1/3">User</p>
        <p class="text-gray-900 w-2/3">{{user.username}}</p>
      </div>


    <!-- Buttons -->
    <div class="mt-8 flex justify-end space-x-4">
      <a href="/logbook-mentor/formEdit/{{logbook_mentor.id}}" 
         class="px-6 py-2 rounded-lg bg-gray-900 text-white hover:bg-gray-700 transition">
        Update
      </a>
      <a href="/pertemuans/{{logbook_mentor.pertemuan.id}}" 
         class="px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition">
        ← Back to Session
      </a>
    </div>
  </div>
</div>
