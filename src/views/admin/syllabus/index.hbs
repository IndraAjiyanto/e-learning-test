{{!--
  Halaman admin: kelola silabus program non-bootcamp.
  Rute: GET /program/syllabus/manage/:courseId  (syllabus.controller.ts)

  Sampai halaman ini ada, program non-bootcamp hanya bisa diisi lewat SQL.

  Tidak ada medan tanggal, jam, maupun lokasi - tabel `syllabus` memang tidak
  punya kolomnya. Itu bukan penyederhanaan tampilan, melainkan bentuk datanya:
  belajar mandiri tidak terjadi pada jam tertentu di tempat tertentu.

  Nomor urut tidak diminta ke admin. SyllabusService yang menghitungnya saat
  menambah, merapatkannya saat menghapus, dan menyusun ulang saat dipindah;
  `UNIQUE (courseId, order)` yang menjaganya di basis data.
--}}
{{#> user/shell_frame/index user=user active='learning' pageTitle='Syllabus' back=(concat '/program/detail/program/admin/' course.id)}}
<div class="min-h-full px-4 pb-10 pt-6 sm:px-8">
  <div class="flex w-full flex-col gap-4">

    <div class="rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-6">
      <h1 class="font-montserrat text-xl font-bold text-[#003060] sm:text-2xl">Syllabus</h1>
      <p class="mt-1 font-inter text-sm text-[#737373]">{{course.name}}</p>
      <p class="mt-2 font-inter text-xs text-[#737373]">
        Self-paced program. Students open each syllabus in order and mark it
        complete themselves — there is no attendance.
      </p>
      <a href="/program/syllabus/completion/{{course.id}}"
         class="mt-3 inline-flex h-9 items-center gap-2 rounded-[8px] border border-[#003060] bg-white px-3.5 font-inter text-sm font-semibold text-[#003060] no-underline transition-colors hover:bg-[#E4F1F7]">
        <i class="fa-solid fa-list-check text-xs"></i>See who completed what
      </a>
    </div>

    <!-- Tambah -->
    <form method="POST" action="/program/syllabus/manage/{{course.id}}"
          class="rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-6">
      <span class="block font-inter text-sm font-semibold text-[#171717]">Add a syllabus</span>
      <span class="mt-0.5 block font-inter text-xs text-[#737373]">It is added at the end of the list.</span>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <input type="text" name="title" required placeholder="Title"
          class="h-10 min-w-0 flex-1 rounded-lg border border-[#D4D4D4] bg-white px-3.5 font-inter text-sm text-[#171717] placeholder:text-[#a3a3a3] focus:border-[#003060] focus:outline-none focus:ring-2 focus:ring-[#003060]/20" />
        <input type="text" name="description" placeholder="Short description (optional)"
          class="h-10 min-w-0 flex-1 rounded-lg border border-[#D4D4D4] bg-white px-3.5 font-inter text-sm text-[#171717] placeholder:text-[#a3a3a3] focus:border-[#003060] focus:outline-none focus:ring-2 focus:ring-[#003060]/20" />
        <button type="submit"
          class="inline-flex h-10 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-4 font-inter text-sm font-semibold text-white transition-colors hover:bg-[#00254a]">
          <i class="fa-solid fa-plus text-xs"></i>Add
        </button>
      </div>
    </form>

    <!-- Daftar -->
    <div class="overflow-hidden rounded-xl border border-[#E5E5E5] bg-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]">
      {{#if silabus.length}}
        <ul class="divide-y divide-[#F0F0F0]">
          {{#each silabus}}
            <li class="px-5 py-4">
              <form method="POST" action="/program/syllabus/manage/{{../course.id}}/{{this.id}}/update"
                    class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-[#E4F1F7] font-inter text-sm font-bold text-[#003060]">{{this.order}}</span>
                <input type="text" name="title" value="{{this.title}}" required
                  class="h-10 min-w-0 flex-1 rounded-lg border border-[#E5E5E5] bg-white px-3.5 font-inter text-sm font-semibold text-[#171717] focus:border-[#003060] focus:outline-none" />
                <input type="text" name="description" value="{{this.description}}" placeholder="—"
                  class="h-10 min-w-0 flex-1 rounded-lg border border-[#E5E5E5] bg-white px-3.5 font-inter text-sm text-[#525252] focus:border-[#003060] focus:outline-none" />
                <span class="shrink-0 font-inter text-xs text-[#737373]">{{this.materialCount}} mat &middot; {{this.assignmentCount}} task</span>
                <button type="submit" title="Save"
                  class="inline-flex h-9 shrink-0 cursor-pointer items-center justify-center rounded-[8px] border border-[#003060] bg-white px-3 font-inter text-sm font-semibold text-[#003060] transition-colors hover:bg-[#E4F1F7]">
                  Save
                </button>
              </form>

              <div class="mt-2 flex flex-wrap items-center gap-2">
                <a href="/program/syllabus/manage/{{../course.id}}/{{this.id}}"
                   class="inline-flex h-8 items-center gap-1.5 rounded-[8px] border border-[#003060] bg-white px-2.5 font-inter text-xs font-semibold text-[#003060] no-underline hover:bg-[#E4F1F7]">
                  <i class="fa-regular fa-folder-open text-[0.65rem]"></i>Content
                </a>
                {{#unless @first}}
                  <form method="POST" action="/program/syllabus/manage/{{../course.id}}/{{this.id}}/move">
                    <input type="hidden" name="to" value="{{subtract this.order 1}}" />
                    <button type="submit" title="Move up"
                      class="inline-flex h-8 cursor-pointer items-center gap-1.5 rounded-[8px] border border-[#D4D4D4] bg-white px-2.5 font-inter text-xs font-semibold text-[#344054] hover:bg-[#F9FAFB]">
                      <i class="fa-solid fa-arrow-up text-[0.65rem]"></i>Up
                    </button>
                  </form>
                {{/unless}}
                {{#unless @last}}
                  <form method="POST" action="/program/syllabus/manage/{{../course.id}}/{{this.id}}/move">
                    <input type="hidden" name="to" value="{{addOne this.order}}" />
                    <button type="submit" title="Move down"
                      class="inline-flex h-8 cursor-pointer items-center gap-1.5 rounded-[8px] border border-[#D4D4D4] bg-white px-2.5 font-inter text-xs font-semibold text-[#344054] hover:bg-[#F9FAFB]">
                      <i class="fa-solid fa-arrow-down text-[0.65rem]"></i>Down
                    </button>
                  </form>
                {{/unless}}
                <form method="POST" action="/program/syllabus/manage/{{../course.id}}/{{this.id}}/delete"
                      onsubmit="return confirm('Delete this syllabus? Its materials, assignments, submissions and progress go with it.')">
                  <button type="submit"
                    class="inline-flex h-8 cursor-pointer items-center gap-1.5 rounded-[8px] border border-[#FECACA] bg-white px-2.5 font-inter text-xs font-semibold text-[#B42318] hover:bg-[#FEF2F2]">
                    <i class="fa-regular fa-trash-can text-[0.65rem]"></i>Delete
                  </button>
                </form>
              </div>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="px-5 py-10 text-center font-inter text-sm text-[#737373]">
          No syllabus yet. Add the first one above.
        </p>
      {{/if}}
    </div>

  </div>
</div>
{{/user/shell_frame/index}}
