{{!--
  Halaman mentor: logbook silabus seluruh student pada satu program.
  Rute: GET /program/syllabus/logbook/:courseId

  Ini BUKAN layar tambahan yang bagus dipunyai. Kalau program menyalakan
  logbook, `SyllabusService.isDone()` menuntut `logbookOk`, artinya student
  bisa menekan "Mark complete" dan silabus berikutnya TETAP TERKUNCI sampai
  logbooknya disetujui di sini. Sebelum layar ini ada, tidak ada satu pun cara
  menyetujuinya - program SPL berlogbook adalah jalan buntu.

  Menyetujui di sini sekaligus menandai `logbookOk` pada progres; keduanya satu
  tindakan supaya tidak bisa jadi tidak sinkron.
--}}
{{#> user/shell_frame/index user=user active='learning' pageTitle='Logbooks' back=(concat '/program/syllabus/manage/' courseId)}}
<div class="min-h-full px-4 pb-10 pt-6 sm:px-8">
  <div class="flex w-full flex-col gap-4">

    <div class="rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-6">
      <h1 class="font-montserrat text-xl font-bold text-[#003060] sm:text-2xl">Logbooks</h1>
      <p class="mt-1 font-inter text-sm text-[#737373]">{{course.name}}</p>
      {{#if caps.logbookEnabled}}
        <p class="mt-2 font-inter text-xs text-[#737373]">
          Approving a logbook is what unlocks the next syllabus for that student.
        </p>
      {{else}}
        <p class="mt-2 inline-flex items-center gap-1.5 font-inter text-xs text-[#B45309]">
          <i class="fa-solid fa-circle-info text-[0.7rem]"></i>
          Logbook is switched off for this program, so students are not asked for one.
        </p>
      {{/if}}
    </div>

    {{#if logbooks.length}}
      <div class="flex flex-col gap-3">
        {{#each logbooks}}
          <div class="rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]">
            <div class="flex flex-wrap items-start gap-x-4 gap-y-2">
              <span class="min-w-0 flex-1">
                <span class="block truncate font-inter text-sm font-semibold text-[#171717]">{{this.user.username}}</span>
                <span class="block truncate font-inter text-xs text-[#737373]">
                  {{this.user.email}} &middot; Syllabus {{this.syllabus.order}} &mdash; {{this.syllabus.title}}
                </span>
              </span>

              {{#if (eq this.process 'approved')}}
                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-[#BBF7D0] bg-[#F0FDF4] px-2.5 py-1 font-inter text-xs font-medium leading-none text-[#15803D]">
                  <span class="size-1.5 shrink-0 rounded-full bg-[#22C55E]"></span>Approved
                </span>
              {{else if (eq this.process 'rejected')}}
                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-[#FECACA] bg-[#FEF2F2] px-2.5 py-1 font-inter text-xs font-medium leading-none text-[#B42318]">
                  <span class="size-1.5 shrink-0 rounded-full bg-[#EF4444]"></span>Needs revision
                </span>
              {{else}}
                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-[#FDE68A] bg-[#FFFBEB] px-2.5 py-1 font-inter text-xs font-medium leading-none text-[#B45309]">
                  <span class="size-1.5 shrink-0 rounded-full bg-[#F59E0B]"></span>Under review
                </span>
              {{/if}}
            </div>

            <dl class="mt-3 space-y-2.5 border-l-2 border-[#E5E5E5] pl-3">
              <div>
                <dt class="font-inter text-xs font-semibold uppercase tracking-wide text-[#737373]">Activity</dt>
                <dd class="mt-0.5 font-inter text-sm text-[#171717]">{{this.activity}}</dd>
              </div>
              {{#if this.activityDetails}}
                <div>
                  <dt class="font-inter text-xs font-semibold uppercase tracking-wide text-[#737373]">Details</dt>
                  <dd class="mt-0.5 font-inter text-sm text-[#525252]">{{this.activityDetails}}</dd>
                </div>
              {{/if}}
              {{#if this.obstacles}}
                <div>
                  <dt class="font-inter text-xs font-semibold uppercase tracking-wide text-[#737373]">Obstacles</dt>
                  <dd class="mt-0.5 font-inter text-sm text-[#525252]">{{this.obstacles}}</dd>
                </div>
              {{/if}}
              {{#if this.otherDocumentation}}
                <div>
                  <dt class="font-inter text-xs font-semibold uppercase tracking-wide text-[#737373]">Documentation</dt>
                  <dd class="mt-0.5 break-all font-inter text-sm">
                    <a href="{{this.otherDocumentation}}" target="_blank" rel="noopener noreferrer"
                       class="font-medium text-[#003060] underline">{{this.otherDocumentation}}</a>
                  </dd>
                </div>
              {{/if}}
            </dl>

            <form method="POST" action="/program/syllabus/logbook/{{../courseId}}/{{this.id}}/review"
                  class="mt-3 flex flex-wrap items-center gap-2">
              <button type="submit" name="process" value="approved"
                class="inline-flex h-10 shrink-0 cursor-pointer items-center gap-2 rounded-[8px] bg-[#15803D] px-4 font-inter text-sm font-semibold text-white hover:bg-[#126334]">
                <i class="fa-solid fa-check text-xs"></i>Approve
              </button>
              <button type="submit" name="process" value="rejected"
                class="inline-flex h-10 shrink-0 cursor-pointer items-center gap-2 rounded-[8px] border border-[#FECACA] bg-white px-4 font-inter text-sm font-semibold text-[#B42318] hover:bg-[#FEF2F2]">
                <i class="fa-solid fa-rotate-left text-xs"></i>Ask for revision
              </button>
            </form>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="rounded-xl border border-[#E5E5E5] bg-white px-5 py-12 text-center">
        <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-[#F5F5F5] text-[#a3a3a3]">
          <i class="fa-solid fa-book text-base"></i>
        </span>
        <p class="font-inter text-sm font-semibold text-[#171717]">No logbooks yet</p>
        <p class="mt-1 font-inter text-xs text-[#737373]">They appear here as students write them.</p>
      </div>
    {{/if}}

  </div>
</div>
{{/user/shell_frame/index}}
