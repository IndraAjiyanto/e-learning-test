{{!--
  Halaman admin: menilai jawaban satu tugas silabus.
  Rute: GET /program/syllabus/manage/:courseId/:syllabusId/assignment/:assignmentId/answers

  Satu student = satu baris = satu jawaban. Itu bukan penyederhanaan tampilan,
  melainkan bentuk datanya: `UQ (task, user)` di `syllabus_answer_task` memang
  hanya mengizinkan satu. Student memperbarui jawaban yang sama sampai lolos.

  Komentar ditambahkan, bukan menimpa. Riwayat penilaian adalah percakapan, dan
  student perlu bisa membaca lagi apa yang diminta pada putaran sebelumnya.
--}}
{{#> user/shell_frame/index user=user active='learning' pageTitle='Submissions' back=(concat '/program/syllabus/manage/' courseId '/' syllabusId)}}
<div class="min-h-full px-4 pb-10 pt-6 sm:px-8">
  <div class="flex w-full flex-col gap-4">

    <div class="rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-6">
      <span class="inline-flex items-center gap-2 rounded-full bg-[#E4F1F7] px-2.5 py-1 font-inter text-xs font-semibold text-[#003060]">
        Syllabus {{syllabus.order}}
      </span>
      <h1 class="mt-2 font-montserrat text-xl font-bold text-[#003060] sm:text-2xl">{{task.title}}</h1>
      <p class="mt-1 font-inter text-sm text-[#737373]">{{course.name}} &middot; {{syllabus.title}}</p>
    </div>

    {{#if answers.length}}
      <div class="flex flex-col gap-3">
        {{#each answers}}
          <div class="rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]">
            <div class="flex flex-wrap items-start gap-x-4 gap-y-2">
              <span class="min-w-0 flex-1">
                <span class="block truncate font-inter text-sm font-semibold text-[#171717]">{{this.user.username}}</span>
                <span class="block truncate font-inter text-xs text-[#737373]">{{this.user.email}}</span>
              </span>

              {{#if (eq this.process 'approved')}}
                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-[#BBF7D0] bg-[#F0FDF4] px-2.5 py-1 font-inter text-xs font-medium leading-none text-[#15803D]">
                  <span class="size-1.5 shrink-0 rounded-full bg-[#22C55E]"></span>Approved
                </span>
              {{else if (eq this.process 'rejected')}}
                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-[#FECACA] bg-[#FEF2F2] px-2.5 py-1 font-inter text-xs font-medium leading-none text-[#B42318]">
                  <span class="size-1.5 shrink-0 rounded-full bg-[#EF4444]"></span>Needs revision
                </span>
              {{else}}
                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-[#FDE68A] bg-[#FFFBEB] px-2.5 py-1 font-inter text-xs font-medium leading-none text-[#B45309]">
                  <span class="size-1.5 shrink-0 rounded-full bg-[#F59E0B]"></span>Under review
                </span>
              {{/if}}
            </div>

            <p class="mt-2.5 font-inter text-xs text-[#737373]">
              Answer:
              <a href="{{this.file}}" target="_blank" rel="noopener noreferrer"
                 class="break-all font-medium text-[#003060] underline">{{this.file}}</a>
            </p>

            {{#if this.comments.length}}
              <ul class="mt-2.5 space-y-1.5 border-l-2 border-[#E5E5E5] pl-3">
                {{#each this.comments}}
                  <li class="font-inter text-xs text-[#525252]">{{this.comment}}</li>
                {{/each}}
              </ul>
            {{/if}}

            <form method="POST"
                  action="/program/syllabus/manage/{{../courseId}}/{{../syllabusId}}/assignment/{{../task.id}}/answers/{{this.id}}/review"
                  class="mt-3 flex flex-wrap items-center gap-2">
              <input type="text" name="comment" placeholder="Comment (optional)"
                class="h-10 min-w-0 flex-1 rounded-lg border border-[#D4D4D4] bg-white px-3.5 font-inter text-sm text-[#171717] placeholder:text-[#a3a3a3] focus:border-[#003060] focus:outline-none" />
              <button type="submit" name="process" value="approved"
                class="inline-flex h-10 shrink-0 cursor-pointer items-center gap-2 rounded-[8px] bg-[#15803D] px-4 font-inter text-sm font-semibold text-white hover:bg-[#126334]">
                <i class="fa-solid fa-check text-xs"></i>Approve
              </button>
              <button type="submit" name="process" value="rejected"
                class="inline-flex h-10 shrink-0 cursor-pointer items-center gap-2 rounded-[8px] border border-[#FECACA] bg-white px-4 font-inter text-sm font-semibold text-[#B42318] hover:bg-[#FEF2F2]">
                <i class="fa-solid fa-rotate-left text-xs"></i>Ask for revision
              </button>
            </form>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="rounded-xl border border-[#E5E5E5] bg-white px-5 py-12 text-center">
        <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-[#F5F5F5] text-[#a3a3a3]">
          <i class="fa-regular fa-paper-plane text-base"></i>
        </span>
        <p class="font-inter text-sm font-semibold text-[#171717]">No submissions yet</p>
        <p class="mt-1 font-inter text-xs text-[#737373]">Answers appear here as students send them.</p>
      </div>
    {{/if}}

  </div>
</div>
{{/user/shell_frame/index}}
