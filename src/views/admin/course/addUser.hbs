{{!--
  Page: Admin Add User V2
  Layout: main.hbs
--}}
<div class='min-h-screen bg-[#F3F3F3] px-4 py-8 sm:px-[34px] sm:py-[42px]'
     x-data='addUserTable()'>

  <div class='box-border w-full max-w-[1052px] h-fit flex flex-col gap-[28px] justify-start items-start'>

    {{!-- Title --}}
    {{> components/ui/admin/text/page-header
        title='Add User'
        subtitle=(concat "Manage the students enrolled in '" course.name "'.")}}

    {{!-- Content --}}
    <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[14px] justify-start items-start'>

      {{!-- Row 2: Search + Add User Toolbar --}}
      <div class='box-border w-full h-auto sm:h-[44px] shrink-0 flex flex-col sm:flex-row gap-[14px] justify-end items-stretch sm:items-center'>
        <form action='/program/addStudent/{{course.id}}' method='POST'
              x-data='{ loading: false }'
              @submit='loading = true'
              class='box-border flex flex-col sm:flex-row gap-[14px] justify-end items-stretch sm:items-center w-full sm:w-auto'>
          <div class='relative w-full sm:w-[400px] max-w-full'
               @click.away='open = false'>
            <input type='hidden' name='userId' x-model='selected' required>
            <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#003060] [outline-offset:-0.5px] rounded-[8px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05),0px_0px_0px_4px_#EBEFFF]'
                 :class="selected === '' ? 'cursor-text' : ''">
              <input type='text'
                     placeholder='Search student to add...'
                     x-model='searchUser'
                     x-bind:value='selectedName'
                     @focus='open = true'
                     @input='open = true; selectedName = ""'
                     autocomplete='off'
                     class='text-[16px]/[normal] flex-1 min-w-0 text-[#171717] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]' />
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#A3A3A3' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='box-border w-[20px] shrink-0 h-[20px]'>
                <circle cx='11' cy='11' r='8'/>
                <path d='m21 21-4.35-4.35'/>
              </svg>
            </div>

            {{!-- Dropdown hasil pencarian --}}
            <div x-show='open && filteredUsers.length > 0'
                 x-transition:enter='transition ease-out duration-100'
                 x-transition:enter-start='transform opacity-0 scale-95'
                 x-transition:enter-end='transform opacity-100 scale-100'
                 x-transition:leave='transition ease-in duration-75'
                 x-transition:leave-start='transform opacity-100 scale-100'
                 x-transition:leave-end='transform opacity-0 scale-95'
                 class='absolute z-20 w-full mt-1 bg-white [outline:1px_solid_#E5E5E5] rounded-[8px] shadow-lg max-h-60 overflow-y-auto'>
              <template x-for='user in filteredUsers' :key='user.id'>
                <button type='button'
                        @click='selectUser(user)'
                        class='w-full flex items-center gap-3 px-4 py-3 hover:bg-[#F5F5F5] transition text-left border-b border-[#F5F5F5] last:border-0'>
                  <div class='w-8 h-8 rounded-full overflow-hidden flex items-center justify-center shrink-0'
                       :class="user.profile && user.profile.trim() !== '' ? 'bg-transparent' : 'bg-[#F9F5FF]'">
                    <template x-if='user.profile && user.profile.trim() !== ""'>
                      <img :src='user.profile' :alt='user.username' class='w-full h-full object-cover'>
                    </template>
                    <template x-if='!user.profile || user.profile.trim() === ""'>
                      <span class='text-[#6941C6] font-inter font-semibold text-sm' x-text='user.username.substring(0,1)'></span>
                    </template>
                  </div>
                  <div class='min-w-0'>
                    <p class='text-[#171717] font-inter font-medium text-[14px]/[normal]' x-text='user.username'></p>
                    <p class='text-[#525252] font-inter text-[12px]/[normal]' x-text='user.email'></p>
                  </div>
                </button>
              </template>
            </div>

            <div x-show="open && searchUser !== '' && filteredUsers.length === 0"
                 class='absolute z-20 w-full mt-1 bg-white [outline:1px_solid_#E5E5E5] rounded-[8px] shadow-lg p-4 text-center'>
              <p class='text-sm text-[#A3A3A3] font-inter'>No student found</p>
            </div>
          </div>

          {{!-- Add User Button --}}
          <button type='submit'
                  :disabled='selected === "" || loading'
                  class='box-border w-full sm:w-[108px] shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#003060] [outline:1px_solid_#003060] [outline-offset:-0.5px] rounded-[8px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors'
                  :class="selected === '' || loading ? 'opacity-50 cursor-not-allowed' : 'hover:bg-[#00254a]'">
            <i x-show='loading' class='fas fa-spinner fa-spin text-white'></i>
            <span x-show='!loading' class='text-[16px]/[normal] text-[#FFFFFF] font-inter font-semibold whitespace-nowrap'>Add User</span>
          </button>
        </form>
      </div>

      {{!-- Table --}}
      <div class='box-border w-full h-fit shrink-0 flex flex-col gap-0 justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#E5E5E5] [outline-offset:-0.5px] rounded-[12px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.06)] overflow-x-auto'>

        {{!-- Header Row --}}
        <div class='w-full min-w-[620px] h-[43.5px] shrink-0 flex flex-row gap-0 justify-start items-start bg-[#FAFAFA] [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#E5E5E5]'>
          <div class='box-border w-[88px] min-w-[88px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'>
            <div class='text-[12px]/[normal] text-[#525252] font-inter font-medium text-left whitespace-nowrap'>User</div>
          </div>
          <div class='box-border flex-1 min-w-[180px] h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'>
            <div class='text-[12px]/[normal] text-[#525252] font-inter font-medium text-left whitespace-nowrap'>Name</div>
          </div>
          <div class='box-border w-[36%] min-w-[220px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'>
            <div class='text-[12px]/[normal] text-[#525252] font-inter font-medium text-left whitespace-nowrap'>Email</div>
          </div>
          <div class='box-border w-[85px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-center items-center'>
            <div class='text-[12px]/[normal] text-[#525252] font-inter font-medium text-center whitespace-nowrap'>Action</div>
          </div>
        </div>

        {{!-- Empty State --}}
        <div x-show='students.length === 0' class='w-full flex flex-col items-center justify-center text-center py-16'>
          <svg xmlns='http://www.w3.org/2000/svg' class='h-12 w-12 text-[#A3A3A3] mb-4' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
                  d='M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z'/>
          </svg>
          <p class='text-[#525252] font-inter font-medium'>No students yet</p>
          <p class='text-[#A3A3A3] font-inter text-sm mt-1'>Add a student using the search field above</p>
        </div>

        {{!-- Body Rows --}}
        <template x-for='(stu, index) in paginatedStudents' :key='stu.id'>
          <div class='w-full min-w-[620px] h-[71.5px] shrink-0 flex flex-row gap-0 justify-start items-start bg-[#FFFFFF] [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#E5E5E5] hover:bg-[#fafafa] transition-colors'>

            {{!-- Avatar --}}
            <div class='box-border w-[88px] min-w-[88px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
              <div class='w-[40px] h-[40px] rounded-[200px] overflow-hidden flex items-center justify-center shrink-0'
                   :class="stu.profile && stu.profile.trim() !== '' ? 'bg-transparent' : 'bg-[#F9F5FF]'">
                <template x-if='stu.profile && stu.profile.trim() !== ""'>
                  <img :src='stu.profile' :alt='stu.username' class='w-full h-full object-cover'>
                </template>
                <template x-if='!stu.profile || stu.profile.trim() === ""'>
                  <span class='text-[#6941C6] font-inter font-semibold text-sm' x-text='stu.username.substring(0,1)'></span>
                </template>
              </div>
            </div>

            {{!-- Name --}}
            <div class='box-border flex-1 min-w-[180px] h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
              <div class='text-[14px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-normal text-left' x-text='stu.username' :title='stu.username'></div>
            </div>

            {{!-- Email --}}
            <div class='box-border w-[36%] min-w-[220px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
              <div class='text-[14px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-normal text-left' x-text='stu.email' :title='stu.email'></div>
            </div>

            {{!-- Action --}}
            <div class='box-border w-[85px] shrink-0 h-full flex flex-row gap-[4px] p-[16px] justify-center items-center'>
              <form :action="'/program/' + stu.id + '/program/{{course.id}}?_method=DELETE'" method='POST' class='box-border w-[40px] shrink-0 h-[40px]'>
                <button type='button'
                        onclick='openDeleteModal(this)'
                        class='box-border w-[40px] h-[40px] flex flex-row gap-0 justify-center items-center bg-[#FFFFFF] rounded-[8px] hover:bg-[#FEF2F2] transition-colors'
                        title='Remove student' aria-label='Remove student'>
                  <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#DC2626' stroke-width='1.66667' stroke-linecap='round' stroke-linejoin='round' class='box-border w-[20px] shrink-0 h-[20px]'>
					<path d='M3 6h18'/>
					<path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/>
					<path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/>
					<line x1='10' x2='10' y1='11' y2='17'/>
					<line x1='14' x2='14' y1='11' y2='17'/>
				</svg>
                </button>
              </form>
            </div>
          </div>
        </template>

        {{!-- Pagination --}}
        <div x-show='totalPages > 1'
             class='w-full h-[64px] shrink-0 flex flex-row justify-between items-center p-[12px_24px_16px]'>
          <div class='text-[14px]/[20px] text-[#404040] font-inter font-medium' x-text='"Page " + currentPage + " of " + totalPages'></div>
          <div class='flex flex-row gap-[12px] items-center'>
            <button type='button' @click='changePage(currentPage - 1)'
                    :disabled='currentPage <= 1'
                    class='box-border h-[36px] px-[14px] flex flex-row justify-center items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors'
                    :class="currentPage <= 1 ? 'opacity-50 cursor-not-allowed' : 'hover:bg-[#f5f5f5]'">
              <span class='text-[14px]/[20px] text-[#404040] font-inter font-semibold whitespace-nowrap'>Previous</span>
            </button>
            <button type='button' @click='changePage(currentPage + 1)'
                    :disabled='currentPage >= totalPages'
                    class='box-border h-[36px] px-[14px] flex flex-row justify-center items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors'
                    :class="currentPage >= totalPages ? 'opacity-50 cursor-not-allowed' : 'hover:bg-[#f5f5f5]'">
              <span class='text-[14px]/[20px] text-[#404040] font-inter font-semibold whitespace-nowrap'>Next</span>
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
  function addUserTable() {
    return {
      students: {{{json student}}},
      users: {{{json users}}},
      searchUser: '',
      open: false,
      selected: '',
      selectedName: '',
      currentPage: 1,
      size: 10,

      get filteredUsers() {
        return this.users.filter(u =>
          u.username.toLowerCase().includes(this.searchUser.toLowerCase()) &&
          u.id != this.selected
        );
      },

      selectUser(user) {
        this.selected = user.id;
        this.selectedName = user.username;
        this.searchUser = user.username;
        this.open = false;
      },

      get totalPages() {
        return Math.max(1, Math.ceil(this.students.length / this.size));
      },

      get paginatedStudents() {
        const start = (this.currentPage - 1) * this.size;
        return this.students.slice(start, start + this.size);
      },

      changePage(page) {
        if (page < 1 || page > this.totalPages) return;
        this.currentPage = page;
      },
    }
  }
</script>

{{> components/ui/super_admin/modal/delete_confirm/index
    title='Remove Student?'
    description="Are you sure you want to remove this student from the program? This action cannot be undone."
    confirmLabel='Remove' }}

{{> components/ui/super_admin/toast/success/index toast=toast }}