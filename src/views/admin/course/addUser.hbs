{{!--
  Halaman: Add User ke Program — Admin
  Lokasi: src/views/admin/course/addUser.hbs
  Level: L4 Page

  - Pencarian student (nama atau email) + submit ke /program/addStudent/:courseId
  - Tabel student terdaftar dari table/card + clientTable() (pagination di client)
  - Hapus lewat modal delete_confirm

  courseId disimpan di state Alpine lewat `json`, bukan disisipkan ke ekspresi
  :action — nilai server di ekspresi Alpine mentah rawan kutip rusak.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index title='Add User' }}

      {{> components/ui/super_admin/description/index
        text=(concat "Manage the students enrolled in '" course.name "'.")
      }}
    </div>

    <div
      class='flex flex-col gap-3.5'
      x-data='clientTable({ items: {{json student}} })'
    >
      <form
        action='/program/addStudent/{{course.id}}'
        method='POST'
        x-data='userPicker({{json users}})'
        @submit='loading = true'
        class='flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-end'
      >
        <input type='hidden' name='userId' x-model='selected' required>

        <div class='relative w-full sm:w-[400px]' @click.outside='open = false'>
          <label class='relative block'>
            <span class='sr-only'>Search student by name or email</span>
            <input
              type='search'
              placeholder='Search student by name or email...'
              x-model='query'
              @focus='open = true'
              @input='open = true; selected = ""'
              @keydown.escape='open = false'
              autocomplete='off'
              class='h-11 w-full rounded-lg border border-[#d4d4d4] bg-white py-2.5 pl-3.5 pr-11 font-inter text-base leading-6 text-[#404040] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors placeholder:text-[#a3a3a3] hover:border-[#a3a3a3] focus:border-[#003060] focus:outline-none focus:ring-2 focus:ring-[#003060]/20'
            />
            <span class='pointer-events-none absolute right-3.5 top-1/2 flex h-5 w-5 -translate-y-1/2 items-center justify-center text-[#a3a3a3]'>
              {{!-- lucide: search --}}
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.67' stroke-linecap='round' stroke-linejoin='round' class='h-4 w-4'>
                <circle cx='11' cy='11' r='8' />
                <path d='m21 21-4.3-4.3' />
              </svg>
            </span>
          </label>

          <div
            x-show='open && query.trim() !== ""'
            x-transition.opacity.duration.100ms
            class='absolute z-20 mt-1 max-h-60 w-full overflow-y-auto rounded-lg border border-[#e5e5e5] bg-white shadow-lg'
          >
            <template x-for='user in results' :key='user.id'>
              <button
                type='button'
                @click='pick(user)'
                class='flex w-full items-center gap-3 border-b border-[#f5f5f5] px-4 py-3 text-left transition-colors last:border-0 hover:bg-[#f5f5f5]'
              >
                {{> components/ui/super_admin/table/avatar
                  src='user.profile && user.profile.trim()'
                  name='user.username'
                  avatarClass='h-8 w-8'
                }}
                <span class='min-w-0'>
                  <span class='block truncate font-inter text-sm font-medium leading-5 text-[#171717]' x-text='user.username'></span>
                  <span class='block truncate font-inter text-xs leading-[18px] text-[#525252]' x-text='user.email'></span>
                </span>
              </button>
            </template>

            <p x-show='results.length === 0' class='p-4 text-center font-inter text-sm leading-5 text-[#a3a3a3]'>
              No student found.
            </p>
          </div>
        </div>

        <button
          type='submit'
          :disabled='selected === "" || loading'
          class='inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-lg border border-[#003060] bg-[#003060] px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#00254a] hover:bg-[#00254a] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 focus-visible:ring-offset-2 active:bg-[#001c39] disabled:cursor-not-allowed disabled:opacity-50'
        >
          <i x-show='loading' class='fas fa-spinner fa-spin'></i>
          <span x-show='!loading'>Add User</span>
        </button>
      </form>

      <div x-data='{ courseId: {{json course.id}} }'>
        {{#> components/ui/super_admin/table/card tableClass='min-w-[620px]'}}
          <colgroup>
            <col class='w-[88px]' />
            <col />
            <col class='w-[36%]' />
            <col class='w-[88px]' />
          </colgroup>
          <thead>
            <tr>
              {{> components/ui/super_admin/table/header_cell label='User' }}
              {{> components/ui/super_admin/table/header_cell label='Name' }}
              {{> components/ui/super_admin/table/header_cell label='Email' }}
              {{> components/ui/super_admin/table/header_cell label='Action' align='center' }}
            </tr>
          </thead>
          <tbody>
            <template x-for='row in rows' :key='row.id'>
              <tr class='transition-colors hover:bg-[#fafafa]'>

                {{#> components/ui/super_admin/table/cell}}
                  {{> components/ui/super_admin/table/avatar
                    src='row.profile && row.profile.trim()'
                    name='row.username'
                  }}
                {{/components/ui/super_admin/table/cell}}

                {{> components/ui/super_admin/table/cell text='row.username' }}

                {{> components/ui/super_admin/table/cell text='row.email' }}

                {{#> components/ui/super_admin/table/cell variant='action'}}
                  <form :action='"/program/" + row.id + "/program/" + courseId + "?_method=DELETE"' method='post' class='flex justify-center'>
                    <button
                      type='button'
                      onclick='openDeleteModal(this)'
                      title='Remove student'
                      aria-label='Remove student'
                      class='flex h-10 w-10 items-center justify-center rounded-lg p-2.5 text-[#dc2626] transition-colors hover:bg-[#fef2f2] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#dc2626]/40 active:bg-[#fee2e2]'
                    >
                      {{!-- lucide: trash-2 --}}
                      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.67' stroke-linecap='round' stroke-linejoin='round' class='h-5 w-5'>
                        <path d='M3 6h18' />
                        <path d='M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6' />
                        <path d='M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2' />
                        <line x1='10' x2='10' y1='11' y2='17' />
                        <line x1='14' x2='14' y1='11' y2='17' />
                      </svg>
                    </button>
                  </form>
                {{/components/ui/super_admin/table/cell}}
              </tr>
            </template>

            {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='4'}}
              No students yet. Add a student using the search field above.
            {{/components/ui/super_admin/table/message_row}}
          </tbody>
        {{/components/ui/super_admin/table/card}}
      </div>
    </div>
  </div>
</div>

<script>
  function userPicker(users) {
    return {
      users: users || [],
      query: '',
      open: false,
      selected: '',
      loading: false,

      get results() {
        const needle = this.query.trim().toLowerCase();
        if (!needle) return [];
        return this.users.filter((u) =>
          u.id != this.selected &&
          [u.username, u.email].some((v) => String(v || '').toLowerCase().includes(needle)),
        );
      },

      pick(user) {
        this.selected = user.id;
        this.query = user.username;
        this.open = false;
      },
    };
  }
</script>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Remove Student?'
  description='Are you sure you want to remove this student from the program? This action cannot be undone.'
  confirmLabel='Remove'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}
