{{!--
  Page: Admin - Create Syllabus (Syllabus Form)
  Path: admin/course/create_syllabus.hbs
  Route: GET /program/create-syllabus/:courseId
--}}
<div class='min-h-screen bg-[#F3F3F3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px] items-start' x-data="createSyllabusForm()">

    {{!-- Title: Heading + Sub heading --}}
    {{> components/ui/admin/text/page-header
      title="Create Program Sylabus"
      subtitle="Fill in the information below to add new sylabus"
    }}

    <form action="/syllabus/{{courseId}}" method="POST" @submit.prevent="handleSubmit($event)" class='box-border w-full flex flex-col gap-[16px] items-start'>

      {{!-- Feature Card 1: Form Inputs Card --}}
      {{#> components/ui/admin/form/form-card noNumber=true}}

        {{!-- Title Input Container --}}
        {{#> components/ui/admin/form/form-field label="Title*" for="syllabus_title"}}
          {{> components/ui/admin/form/text-input
            id="syllabus_title"
            name="title"
            xModel="title"
            required=true
            placeholder="Enter title..."
          }}
        {{/components/ui/admin/form/form-field}}

        {{!-- Description Input Container --}}
        {{#> components/ui/admin/form/form-field label="Description*" for="syllabus_description"}}
          {{> components/ui/admin/form/textarea-input
            id="syllabus_description"
            name="description"
            xModel="description"
            required=true
            rows=4
            placeholder="Enter description..."
          }}
        {{/components/ui/admin/form/form-field}}

        {{!-- Content EditorJS Input Container --}}
        {{#> components/ui/admin/form/form-field label="Content*"}}
          <div class='box-border w-full min-h-[160px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] p-[10px_14px] focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
            {{!-- x-ignore prevents Alpine from re-scanning and breaking EditorJS event listeners --}}
            <div id='syllabus_editorjs' x-ignore class='w-full font-inter text-[16px] leading-[24px] text-[#171717] pl-8 sm:pl-10'></div>
          </div>
          <input type='hidden' name='content' id='syllabus_content_input' />
        {{/components/ui/admin/form/form-field}}

      {{/components/ui/admin/form/form-card}}

      {{!-- Feature Card 2: Actions Bar --}}
      {{#> components/ui/admin/form/form-card noNumber=true class="min-h-[86px] flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-[16px] sm:gap-[24px]"}}
        {{!-- Toggle Row: isFinal like week --}}
        <div class='flex flex-row gap-[10px] justify-start items-center min-w-0'>
          {{> components/ui/admin/form/toggle-switch
            checkedBind="isFinal"
            onChange="isFinal = $event.target.checked"
          }}
          <span class='text-[14px]/[normal] text-[#171717] font-inter font-semibold sm:whitespace-nowrap'>Jadikan pertemuan terakhir</span>
          <input type='hidden' name='isFinal' :value="isFinal ? 'true' : 'false'" />
        </div>

        {{!-- Button Row --}}
        <div class='flex flex-row items-center justify-end gap-[12px]'>
          {{!-- Cancel button --}}
          <button
            type='button'
            @click='handleCancel()'
            class='box-border w-[90px] h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#F5F5F5] transition-colors'>
            <span class='font-inter font-semibold text-[16px] leading-[24px] text-[#003060]'>
              Cancel
            </span>
          </button>

          {{!-- Create Sylabus submit button --}}
          <button
            type='submit'
            :disabled='loading'
            class='box-border min-w-[158px] h-[44px] bg-[#003060] border border-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#002244] disabled:opacity-70 transition-colors'>
            <span x-show='!loading' class='font-inter font-semibold text-[16px] leading-[24px] text-[#FFFFFF]'>
              Create Sylabus
            </span>
            <span x-show='loading' style='display: none;' class='font-inter font-semibold text-[16px] leading-[24px] text-[#FFFFFF] flex items-center gap-2'>
              <svg class='animate-spin h-4 w-4 text-white' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24'>
                <circle class='opacity-25' cx='12' cy='12' r='10' stroke='currentColor' stroke-width='4'></circle>
                <path class='opacity-75' fill='currentColor' d='M4 12a8 8 0 018-8v8H4z'></path>
              </svg>
              Creating...
            </span>
          </button>
        </div>
      {{/components/ui/admin/form/form-card}}

    </form>
  </div>
</div>

<script>
function createSyllabusForm() {
  return {
    title: '',
    description: '',
    loading: false,
    isFinal: false,
    editorInstance: null,

    init() {
      let isInitializing = false;
      const initEditor = () => {
        if (isInitializing) return;
        if (!window.EditorJS || !window.EditorTools) {
          setTimeout(initEditor, 100);
          return;
        }
        isInitializing = true;
        const holder = document.getElementById('syllabus_editorjs');
        if (holder) holder.innerHTML = '';

        if (this.editorInstance && typeof this.editorInstance.destroy === 'function') {
          try { this.editorInstance.destroy(); } catch (e) {}
        }

        try {
          this.editorInstance = new window.EditorJS({
            holder: 'syllabus_editorjs',
            placeholder: 'Type "/" for commands...',
            tools: {
              header: {
                class: window.EditorTools.Header,
                inlineToolbar: ['link']
              },
              paragraph: {
                class: window.EditorTools.Paragraph,
                inlineToolbar: true,
              },
              list: {
                class: window.EditorTools.List,
                inlineToolbar: true
              },
              marker: {
                class: window.EditorTools.Marker,
                shortcut: 'CMD+SHIFT+M'
              },
              image: {
                class: window.EditorTools.ImageTool,
                config: {
                  endpoints: {
                    byFile: '/program/upload-image',
                    byUrl: '/program/fetch-image'
                  }
                }
              },
              linkTool: {
                class: window.EditorTools.LinkTool,
                config: { endpoint: '/program/fetch-link' }
              }
            }
          });
        } catch (err) {
          console.error('[Syllabus] Failed to init EditorJS:', err);
        }
      };
      initEditor();
    },

    handleCancel() {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/program/detail/program/admin/{{courseId}}';
      }
    },

    async handleSubmit(e) {
      if (!this.title.trim()) {
        alert('Title is required');
        return;
      }
      let editorData = null;
      if (this.editorInstance && typeof this.editorInstance.save === 'function') {
        try {
          editorData = await this.editorInstance.save();
        } catch (err) {
          console.error('EditorJS save error:', err);
        }
      }
      const hiddenInput = document.getElementById('syllabus_content_input');
      if (hiddenInput && editorData) {
        hiddenInput.value = JSON.stringify(editorData);
      }
      this.loading = true;
      e.target.submit();
    }
  };
}
</script>

<style>
  #syllabus_editorjs .codex-editor__redactor {
    padding-bottom: 24px !important;
  }
  #syllabus_editorjs .ce-block__content {
    max-width: 100% !important;
  }
  #syllabus_editorjs .ce-toolbar__content {
    max-width: 100% !important;
  }
  #syllabus_editorjs .ce-paragraph {
    font-family: 'Inter', sans-serif !important;
    font-size: 16px !important;
    line-height: 24px !important;
    color: #171717 !important;
  }
  #syllabus_editorjs .ce-paragraph[data-placeholder]:empty::before {
    color: #737373 !important;
    font-weight: 400 !important;
  }
</style>
