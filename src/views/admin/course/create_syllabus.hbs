{{!--
  Page: Admin - Create Syllabus (Syllabus Form)
  Path: admin/course/create_syllabus.hbs
  Route: GET /program/create-syllabus/:courseId
--}}
<div class='min-h-screen bg-[#F3F3F3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px] items-start' x-data="createSyllabusForm()">

    {{!-- Title: Heading + Sub heading --}}
    {{> components/ui/admin/text/page-header
      title="Create Program Sylabus"
      subtitle="Fill in the information below to add new sylabus"
    }}

    <form action="/syllabus/{{courseId}}" method="POST" enctype="multipart/form-data" @submit.prevent="handleSubmit($event)" class='box-border w-full flex flex-col gap-[16px] items-start'>
      {{!-- Feature Card 1: Form Inputs Card --}}
      {{#> components/ui/admin/form/form-card noNumber=true}}

        {{!-- Title Input Container --}}
        {{#> components/ui/admin/form/form-field label="Title*" for="syllabus_title"}}
          {{> components/ui/admin/form/text-input
            id="syllabus_title"
            name="title"
            xModel="title"
            required=true
            placeholder="Enter title..."
          }}
        {{/components/ui/admin/form/form-field}}

        {{!-- Description Input Container --}}
        {{#> components/ui/admin/form/form-field label="Description*" for="syllabus_description"}}
          {{> components/ui/admin/form/textarea-input
            id="syllabus_description"
            name="description"
            xModel="description"
            required=true
            rows=4
            placeholder="Enter description..."
          }}
        {{/components/ui/admin/form/form-field}}

        {{!-- Content EditorJS Input Container --}}
        {{#> components/ui/admin/form/form-field label="Content*"}}
          {{> components/ui/admin/form/editor-input
            id="syllabus_editorjs"
            name="content"
            inputId="syllabus_content_input"
          }}
        {{/components/ui/admin/form/form-field}}


        {{!-- Divider --}}
        <div class="w-full border-t border-[#E5E7EB] pt-4 mt-2">
          <h3 class="text-[16px] font-bold text-[#003060] mb-1">Materi Pembelajaran & Video (Opsional)</h3>
          <p class="text-[13px] text-[#64748B] mb-4">Tambahkan video pembelajaran atau modul dokumen pendukung. Batas ukuran berkas maksimal 5 MB per file.</p>
        </div>

        {{!-- Video URL Input --}}
        {{#> components/ui/admin/form/form-field label="URL Video Pembelajaran (Opsional)" for="syllabus_video_url"}}
          <input
            type="url"
            id="syllabus_video_url"
            name="videoUrl"
            class="w-full h-11 px-3 py-2 text-sm text-[#1E293B] bg-white border border-[#CBD5E1] rounded-lg focus:outline-none focus:border-[#003060] focus:ring-1 focus:ring-[#003060]"
            placeholder="Contoh: https://www.youtube.com/watch?v=... atau link video MP4"
          />
        {{/components/ui/admin/form/form-field}}


        {{!-- PDF Upload Input --}}
        {{#> components/ui/admin/form/form-field label="Unggah Modul PDF (Opsional, Maks. 5 MB)" for="syllabus_pdf_file"}}
          <input
            type="file"
            id="syllabus_pdf_file"
            name="pdfFile"
            accept=".pdf"
            class="w-full px-3 py-2 text-sm text-[#1E293B] bg-white border border-[#CBD5E1] rounded-lg file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-[#003060] file:text-white hover:file:bg-[#002244]"
          />
        {{/components/ui/admin/form/form-field}}

        {{!-- PPT Upload Input --}}
        {{#> components/ui/admin/form/form-field label="Unggah Slide PPT / PPTX (Opsional, Maks. 5 MB)" for="syllabus_ppt_file"}}
          <input
            type="file"
            id="syllabus_ppt_file"
            name="pptFile"
            accept=".ppt,.pptx"
            class="w-full px-3 py-2 text-sm text-[#1E293B] bg-white border border-[#CBD5E1] rounded-lg file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-[#003060] file:text-white hover:file:bg-[#002244]"
          />
        {{/components/ui/admin/form/form-field}}

        {{!-- PPT Google Slides URL Input --}}
        {{#> components/ui/admin/form/form-field label="Link Google Slides Presentasi (Opsional)" for="syllabus_ppt_url"}}
          <input
            type="url"
            id="syllabus_ppt_url"
            name="pptUrl"
            class="w-full h-11 px-3 py-2 text-sm text-[#1E293B] bg-white border border-[#CBD5E1] rounded-lg focus:outline-none focus:border-[#003060] focus:ring-1 focus:ring-[#003060]"
            placeholder="Contoh: https://docs.google.com/presentation/d/e/.../pub?start=false..."
          />
          <p class="text-xs text-[#64748B] mt-1">Tempelkan link publikasi Google Slides (File → Bagikan / Share → Publikasikan ke web / Publish to web) agar slide dapat dipratinjau secara interaktif seperti di Bootcamp.</p>
        {{/components/ui/admin/form/form-field}}
      {{/components/ui/admin/form/form-card}}

      {{!-- Feature Card 2: Actions Bar --}}
      {{#> components/ui/admin/form/form-card noNumber=true class="min-h-[86px] flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-[16px] sm:gap-[24px]"}}
        {{!-- Toggle Row: isFinal like week --}}
        <div class='flex flex-row gap-[10px] justify-start items-center min-w-0'>
          {{> components/ui/admin/form/toggle-switch
            checkedBind="isFinal"
            onChange="isFinal = $event.target.checked"
          }}
          <span class='text-[14px]/[normal] text-[#171717] font-inter font-semibold sm:whitespace-nowrap'>Jadikan pertemuan terakhir</span>
          <input type='hidden' name='isFinal' :value="isFinal ? 'true' : 'false'" />
        </div>

        {{!-- Button Row --}}
        <div class='flex flex-row items-center justify-end gap-[12px]'>
          {{!-- Cancel button --}}
          <button
            type='button'
            @click='handleCancel()'
            class='box-border w-[90px] h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#F5F5F5] transition-colors'>
            <span class='font-inter font-semibold text-[16px] leading-[24px] text-[#003060]'>
              Cancel
            </span>
          </button>

          {{!-- Create Sylabus submit button --}}
          <button
            type='submit'
            :disabled='loading'
            class='box-border min-w-[158px] h-[44px] bg-[#003060] border border-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#002244] disabled:opacity-70 transition-colors'>
            <span x-show='!loading' class='font-inter font-semibold text-[16px] leading-[24px] text-[#FFFFFF]'>
              Create Sylabus
            </span>
            <span x-show='loading' style='display: none;' class='font-inter font-semibold text-[16px] leading-[24px] text-[#FFFFFF] flex items-center gap-2'>
              <svg class='animate-spin h-4 w-4 text-white' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24'>
                <circle class='opacity-25' cx='12' cy='12' r='10' stroke='currentColor' stroke-width='4'></circle>
                <path class='opacity-75' fill='currentColor' d='M4 12a8 8 0 018-8v8H4z'></path>
              </svg>
              Creating...
            </span>
          </button>
        </div>
      {{/components/ui/admin/form/form-card}}

    </form>
  </div>
</div>

<script>
function createSyllabusForm() {
  return {
    title: '',
    description: '',
    loading: false,
    isFinal: false,
    quillInstance: null,

    init() {
      const initEditor = () => {
        if (!window.QuillEditor) {
          setTimeout(initEditor, 100);
          return;
        }
        this.quillInstance = window.QuillEditor.create('syllabus_editorjs', {
          placeholder: 'Write syllabus content here...',
          uploadUrl: '/program/upload-image'
        });
      };
      initEditor();
    },

    handleCancel() {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/program/detail/program/admin/{{courseId}}';
      }
    },

    async handleSubmit(e) {
      if (!this.title.trim()) {
        alert('Title is required');
        return;
      }

      const pdfInput = document.getElementById('syllabus_pdf_file');
      if (pdfInput && pdfInput.files && pdfInput.files[0]) {
        if (pdfInput.files[0].size > 5 * 1024 * 1024) {
          alert('Ukuran file Modul PDF melebihi batas 5 MB. Silakan pilih berkas yang lebih kecil.');
          return;
        }
      }

      const pptInput = document.getElementById('syllabus_ppt_file');
      if (pptInput && pptInput.files && pptInput.files[0]) {
        if (pptInput.files[0].size > 5 * 1024 * 1024) {
          alert('Ukuran file Slide Presentasi melebihi batas 5 MB. Silakan pilih berkas yang lebih kecil.');
          return;
        }
      }
      let contentHtml = '';
      if (this.quillInstance) {
        contentHtml = this.quillInstance.getSemanticHTML
          ? this.quillInstance.getSemanticHTML()
          : this.quillInstance.root.innerHTML;
        if (contentHtml === '<p><br></p>') contentHtml = '';
      }
      const hiddenInput = document.getElementById('syllabus_content_input');
      if (hiddenInput) {
        hiddenInput.value = contentHtml;
      }
      this.loading = true;
      e.target.submit();
    }
  };
}
</script>

