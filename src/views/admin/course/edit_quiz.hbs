{{!--
  Page: Admin - Edit Quiz (Course Syllabus Context)
  Path: admin/course/edit_quiz.hbs
  Route: GET /program/edit-quiz-syllabus/:courseId
  Design: Figma node 1883-13019
--}}
<div class='min-h-screen bg-[#F3F3F3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px] items-start'
    x-data='{
      ...adminFormGate(),
      loading: false,
      title: "Final Test for UX Research & Design Thinking",
      minScore: 80,
      duration: 60,
      canSubmit() {
        return String(this.title).trim() !== "" && String(this.minScore).trim() !== "" && String(this.duration).trim() !== "" && !isNaN(Number(this.minScore)) && !isNaN(Number(this.duration));
      },
      handleCancel() {
        if (window.history.length > 1) {
          window.history.back();
        } else {
          window.location.href = "{{#if courseId}}/program/detail-quiz-syllabus/{{courseId}}{{else}}/program{{/if}}";
        }
      },
      handleSubmit(e) {
        if (!this.canSubmit()) {
          e.preventDefault();
          return;
        }
        e.preventDefault();
        this.loading = true;
        setTimeout(() => {
          window.location.href = "{{#if courseId}}/program/detail-quiz-syllabus/{{courseId}}{{else}}/program{{/if}}";
        }, 500);
      }
    }'>

    {{!-- Title: Heading + Sub heading --}}
    <div class='box-border w-full flex flex-col gap-[4px] items-start'>
      <h1 class='w-full font-["Inter"] font-bold text-[34px] leading-[36px] tracking-[-1px] text-[#003060]'>
        Edit Quiz
      </h1>
      <p class='w-full font-["Inter"] font-medium text-[16px] leading-[20px] text-[#718096]'>
        Fill in the information below to edit a quiz.
      </p>
    </div>

    {{!-- Edit quiz form --}}
    <form method='POST' action='#'
      class='box-border w-full flex flex-col gap-[16px] items-start'
      novalidate
      @input="recomputeFormValid()"
      @change="recomputeFormValid()"
      @focusout="markField($event.target)"
      @submit='handleSubmit($event)'>

      {{!-- Feature Card 1: Form Inputs Card --}}
      <div class='box-border w-full bg-[#FFFFFF] border border-[#D9D9D9] rounded-[12px] p-[20px] flex flex-col gap-[20px] items-start'>

        {{!-- Title* Input Container --}}
        <div class='box-border w-full flex flex-col gap-[8px] items-start'>
          <label for='quiz_title' class='w-full font-["Inter"] font-medium text-[14px] leading-[20px] text-[#404040]'>
            Title*
          </label>
          <div class='box-border w-full h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[14px] py-[10px] flex flex-row items-center gap-[8px] focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
            <input
              id='quiz_title'
              name='quizName'
              type='text'
              x-model='title'
              required
              placeholder='Enter title...'
              class='w-full h-[24px] font-["Inter"] font-normal text-[16px] leading-[24px] text-[#171717] placeholder-[#737373] bg-transparent border-none outline-none p-0 focus:ring-0 focus:outline-none'
            />
          </div>
          <p x-show="String(title).trim() === ''" x-cloak class="mt-1 text-xs text-[#dc2626] font-['Inter']">Title is required and cannot be empty.</p>
        </div>

        {{!-- Frame 2147229580: Minimum Score* & Duration (minute)* Row --}}
        <div class='box-border w-full flex flex-col sm:flex-row gap-[12px] items-start'>

          {{!-- Minimum Score* Container --}}
          <div class='box-border flex-1 w-full flex flex-col gap-[8px] items-start'>
            <label for='quiz_minScore' class='w-full font-["Inter"] font-medium text-[14px] leading-[20px] text-[#404040]'>
              Minimum Score*
            </label>
            <div class='box-border w-full h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[14px] py-[10px] flex flex-row items-center gap-[8px] focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
              <input
                id='quiz_minScore'
                name='minScore'
                type='number'
                x-model='minScore'
                required
                placeholder='Enter minimum score...'
                class='w-full h-[24px] font-["Inter"] font-normal text-[16px] leading-[24px] text-[#171717] placeholder-[#737373] bg-transparent border-none outline-none p-0 focus:ring-0 focus:outline-none'
              />
            </div>
            <p x-show="String(minScore).trim() === ''" x-cloak class="mt-1 text-xs text-[#dc2626] font-['Inter']">Minimum score is required.</p>
          </div>

          {{!-- Duration (minute)* Container --}}
          <div class='box-border flex-1 w-full flex flex-col gap-[8px] items-start'>
            <label for='quiz_duration' class='w-full font-["Inter"] font-medium text-[14px] leading-[20px] text-[#404040]'>
              Duration (minute)*
            </label>
            <div class='box-border w-full h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[14px] py-[10px] flex flex-row items-center gap-[8px] focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
              <input
                id='quiz_duration'
                name='duration'
                type='number'
                x-model='duration'
                required
                placeholder='Enter duration in minutes...'
                class='w-full h-[24px] font-["Inter"] font-normal text-[16px] leading-[24px] text-[#171717] placeholder-[#737373] bg-transparent border-none outline-none p-0 focus:ring-0 focus:outline-none'
              />
            </div>
            <p x-show="String(duration).trim() === ''" x-cloak class="mt-1 text-xs text-[#dc2626] font-['Inter']">Duration is required.</p>
          </div>

        </div>

      </div>

      {{!-- Feature Card 2: Actions Bar --}}
      <div class='box-border w-full h-[86px] bg-[#FFFFFF] border border-[#D9D9D9] rounded-[12px] p-[20px] flex flex-row justify-end items-center gap-[24px]'>
        <div class='flex flex-row items-center gap-[12px]'>
          {{!-- Cancel button --}}
          <button
            type='button'
            @click='handleCancel()'
            class='box-border w-[90px] h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#F5F5F5] transition-colors'>
            <span class='font-["Inter"] font-semibold text-[16px] leading-[24px] text-[#003060]'>
              Cancel
            </span>
          </button>

          {{!-- Update Quiz submit button --}}
          <button
            type='submit'
            :disabled='loading || !canSubmit()'
            class='box-border w-[147px] h-[44px] bg-[#003060] border border-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#002244] disabled:opacity-70 transition-colors'>
            <span x-show='!loading' class='font-["Inter"] font-semibold text-[16px] leading-[24px] text-[#FFFFFF] whitespace-nowrap'>
              Update Quiz
            </span>
            <span x-show='loading' style='display: none;' class='font-["Inter"] font-semibold text-[16px] leading-[24px] text-[#FFFFFF] flex items-center gap-2 whitespace-nowrap'>
              <svg class='animate-spin h-4 w-4 text-white' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24'>
                <circle class='opacity-25' cx='12' cy='12' r='10' stroke='currentColor' stroke-width='4'></circle>
                <path class='opacity-75' fill='currentColor' d='M4 12a8 8 0 018-8v8H4z'></path>
              </svg>
              Updating...
            </span>
          </button>
        </div>
      </div>

    </form>
  </div>
</div>

