{{!--
  Page: Admin Program List V2
  Layout: main.hbs (res.render layout default via express-handlebars)
  Komponen modular: partials/components/ui/admin/
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'
     x-data='kelasTable()'>

  <div class='box-border w-full h-fit flex flex-col gap-[28px] justify-start items-stretch'>

    {{!-- Title --}}
    {{> components/ui/admin/text/page-header title='Program List' subtitle='Manage programs, quotas, and students.'}}

    {{!-- Payment Settings (super admin only) --}}
    {{#if isSuperAdmin}}
      <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[14px] justify-start items-stretch'>
        {{> components/ui/admin/payment_settings/index
            manualEnabled=paymentSettings.manual_enabled
            gatewayEnabled=paymentSettings.gateway_enabled
            gatewayHidden=paymentSettings.gateway_hidden_because_key_missing }}
      </div>
    {{/if}}

    {{!-- Content --}}
    <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[14px] justify-start items-stretch'>

      {{!-- Toolbar --}}
      <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[12px] justify-between items-stretch sm:h-[44px] sm:flex-row sm:items-center'>
        <div class='flex flex-col sm:flex-row gap-[12px] items-stretch sm:items-center flex-1'>
          {{> components/ui/admin/form/search-input placeholder='Search program...' value='searchInput'}}

          {{!-- Status Filter Dropdown --}}
          <div class='relative w-full sm:w-[200px] shrink-0' x-data='{ openStatus: false }' @click.outside='openStatus = false'>
            <button
              type='button'
              @click='openStatus = !openStatus'
              class='box-border flex flex-row justify-between items-center px-[16px] py-[10px] w-full h-[42px] bg-[#FFFFFF] border border-[#D9D9D9] rounded-[8px] focus:outline-none transition-colors cursor-pointer text-left'
            >
              <span
                class='flex-1 truncate font-inter text-[14px] leading-[20px] font-normal'
                :class="selectedStatus ? 'text-[#1A202C]' : 'text-[#718096]'"
                x-text="statusOptions.find(o => o.value === selectedStatus)?.label || 'All Status'"
              ></span>
              <svg
                class='w-[10px] h-[5px] shrink-0 ml-2 transition-transform duration-200'
                :class="openStatus ? 'rotate-180' : ''"
                viewBox='0 0 10 5'
                fill='none'
                xmlns='http://www.w3.org/2000/svg'
              >
                <path d='M1 1L5 4L9 1' stroke='#718096' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/>
              </svg>
            </button>

            {{!-- Dropdown Menu Options --}}
            <div
              x-show='openStatus'
              x-transition:enter='transition ease-out duration-100'
              x-transition:enter-start='transform opacity-0 scale-95'
              x-transition:enter-end='transform opacity-100 scale-100'
              x-transition:leave='transition ease-in duration-75'
              x-transition:leave-start='transform opacity-100 scale-100'
              x-transition:leave-end='transform opacity-0 scale-95'
              class='absolute left-0 mt-1 w-full bg-white rounded-[8px] border border-[#D9D9D9] shadow-lg py-1 z-50 overflow-hidden'
              style='display: none;'
            >
              <button
                type='button'
                @click="filterStatus(''); openStatus = false"
                class='w-full px-[16px] py-[10px] text-left font-inter text-[14px] leading-[20px] hover:bg-[#F7FAFC] flex items-center justify-between transition-colors'
                :class="!selectedStatus ? 'bg-[#EDF2F7] text-[#1A202C] font-medium' : 'text-[#4A5568]'"
              >
                <span>All Status</span>
                <i x-show='!selectedStatus' class='fas fa-check text-xs text-[#2B6CB0]'></i>
              </button>

              <template x-for='option in statusOptions' :key='option.value'>
                <button
                  type='button'
                  @click="filterStatus(option.value); openStatus = false"
                  class='w-full px-[16px] py-[10px] text-left font-inter text-[14px] leading-[20px] hover:bg-[#F7FAFC] flex items-center justify-between transition-colors'
                  :class="selectedStatus === option.value ? 'bg-[#EDF2F7] text-[#1A202C] font-medium' : 'text-[#4A5568]'"
                >
                  <span x-text='option.label'></span>
                  <i x-show='selectedStatus === option.value' class='fas fa-check text-xs text-[#2B6CB0]'></i>
                </button>
              </template>
            </div>
          </div>

          {{!-- Mentor Filter Dropdown (Super Admin only) --}}
          {{#if isSuperAdmin}}
          {{> components/ui/admin/toolbar/searchable_filter_dropdown
            model='selectedMentor'
            options='mentorOptions'
            filterMethod='filterMentor'
            placeholder='All Mentor'
            searchPlaceholder='Search mentor...'
            emptyText='Mentor not found'
            wrapperClass='w-full sm:w-[200px] shrink-0'
          }}
          {{/if}}
        </div>

        <div class='w-[158px] shrink-0 self-end sm:self-auto'>
          {{> components/ui/admin/button/primary-button text='Create Program' href='/program/create'}}
        </div>
      </div>

      {{!-- Table (1 komponen) --}}
      {{> components/ui/admin/program/table isSuperAdmin=isSuperAdmin}}

    </div>
  </div>

  {{!-- Modal konfirmasi — dipakai toggle launch/status (confirmToggleLaunch(),
       confirmStatusChange() di kelasTable()) dan perpindahan kanal pembayaran
       (select() di paymentSettingsPanel()) --}}
  {{> components/ui/admin/modal/confirm_action/index}}
</div>

<script>
  function confirmDelete(el, name) {
    Swal.fire({
      title: 'Delete Program',
      text: 'Are you sure you want to delete "' + name + '"?',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#DC2626',
      cancelButtonColor: '#525252',
      confirmButtonText: 'Delete'
    }).then((result) => {
      if (result.isConfirmed) {
        el.closest('form').submit();
      }
    });
  }
</script>

<script>
function kelasTable() {
  return {
    kelasList: [],
    searchInput: '',
    selectedStatus: '',
    selectedMentor: '',
    mentorOptions: [
      { value: '', label: 'All Mentor' },
      ...({{#if mentorings}}{{{json mentorings}}}{{else}}[]{{/if}}).map(m => ({ value: m.id, label: m.username })),
    ],
    statusOptions: [
      { value: 'unlaunch', label: 'Unpublished' },
      { value: 'launch', label: 'Published' },
      { value: 'learning', label: 'Learning in progress' },
      { value: 'done', label: 'Completed' },
    ],
    currentPage: 1,
    totalPages: 1,
    totalItems: 0,
    size: 10,
    loading: false,
    searchTimeout: null,

    init() {
      this.$watch('selectedMentor', () => {
        this.currentPage = 1;
        this.fetchKelas();
      });
      this.fetchKelas();
    },

    async fetchKelas() {
      this.loading = true;
      try {
        const params = new URLSearchParams();
        if (this.searchInput.trim()) params.set('search', this.searchInput.trim());
        if (this.selectedStatus) params.set('status', this.selectedStatus);
        if (this.selectedMentor) params.set('mentor', this.selectedMentor);
        params.set('page', this.currentPage);
        params.set('limit', this.size);

        const res = await fetch(`/program/filter?${params.toString()}`);
        const json = await res.json();

        this.kelasList = json.data;
        this.totalItems = json.totalItems;
        this.totalPages = json.totalPages;
        this.currentPage = json.currentPage;
      } catch (err) {
        console.error('Fetch course error:', err);
      } finally {
        this.loading = false;
      }
    },

    handleSearch() {
      clearTimeout(this.searchTimeout);
      this.searchTimeout = setTimeout(() => {
        this.currentPage = 1;
        this.fetchKelas();
      }, 300);
    },

    filterStatus(status) {
      this.selectedStatus = status || '';
      this.currentPage = 1;
      this.fetchKelas();
    },

    filterMentor(mentorId) {
      const next = mentorId || '';
      if (this.selectedMentor === next) {
        this.currentPage = 1;
        this.fetchKelas();
      } else {
        this.selectedMentor = next;
      }
    },

    async changePage(page) {
      if (page < 1 || page > this.totalPages) return;
      this.currentPage = page;
      await this.fetchKelas();
    },

    // Program Status Lifecycle Helpers
    getStatus(status) {
      return status || 'unlaunch';
    },

    getStatusLabel(status) {
      const s = status || 'unlaunch';
      switch (s) {
        case 'launch': return 'Published';
        case 'learning': return 'Learning in progress';
        case 'done': return 'Completed';
        default: return 'Unpublished';
      }
    },

    getStatusBadgeClass(status) {
      const s = status || 'unlaunch';
      switch (s) {
        case 'launch': return 'bg-[#DCFCE7]';
        case 'learning': return 'bg-[#DBEAFE]';
        case 'done': return 'bg-[#F3E8FF]';
        default: return 'bg-[#F1F5F9]';
      }
    },

    getStatusDotClass(status) {
      const s = status || 'unlaunch';
      switch (s) {
        case 'launch': return 'bg-[#22C55E]';
        case 'learning': return 'bg-[#3B82F6]';
        case 'done': return 'bg-[#A855F7]';
        default: return 'bg-[#94A3B8]';
      }
    },

    getStatusTextClass(status) {
      const s = status || 'unlaunch';
      switch (s) {
        case 'launch': return 'text-[#15803D]';
        case 'learning': return 'text-[#1D4ED8]';
        case 'done': return 'text-[#7E22CE]';
        default: return 'text-[#475569]';
      }
    },

    getMentorName(course) {
      if (!course) return '-';
      if (course.mentorings && course.mentorings.length) {
        const names = course.mentorings
          .map(m => m.user?.username)
          .filter(Boolean);
        if (names.length) return names.join(', ');
      }
      if (course.mentors && course.mentors.length) {
        const names = course.mentors
          .map(m => m.name)
          .filter(Boolean);
        if (names.length) return names.join(', ');
      }
      return '-';
    },

    confirmStatusChange(courseId, index, targetStatus) {
      const course = this.kelasList[index];
      const configs = {
        launch: {
          title: 'Launch Program?',
          description: `Are you sure you want to launch "${course.name}"? Program will be visible on the landing page for user registration.`,
          confirmLabel: 'Launch',
        },
        unlaunch: {
          title: 'Rollback to Unlaunch?',
          description: `Are you sure you want to rollback "${course.name}" to Unlaunch? Program will be hidden from the landing page.`,
          confirmLabel: 'Rollback',
        },
        learning: {
          title: 'Start Learning Phase?',
          description: `Are you sure you want to start learning for "${course.name}"? Registration on the landing page will be closed and learning sessions will begin.`,
          confirmLabel: 'Start Learning',
        },
        done: {
          title: 'Mark Program as Done?',
          description: `Are you sure you want to mark "${course.name}" as Done? Participants will have finished learning and portfolios. This is the terminal state.`,
          confirmLabel: 'Mark Done',
        },
      };

      const config = configs[targetStatus] || {
        title: 'Change Program Status?',
        description: `Are you sure you want to change status to "${targetStatus}"?`,
        confirmLabel: 'Confirm',
      };

      openConfirmModal({
        title: config.title,
        description: config.description,
        confirmLabel: config.confirmLabel,
        cancelLabel: 'Cancel',
        onConfirm: () => this.updateStatus(courseId, index, targetStatus),
      });
    },

    async updateStatus(courseId, index, targetStatus) {
      const prevStatus = this.kelasList[index].status;
      const prevLaunch = this.kelasList[index].launch;
      try {
        const res = await fetch(`/program/${courseId}/status-json`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ status: targetStatus }),
        });
        const json = await res.json();

        if (json.success) {
          this.kelasList[index].status = json.status;
          this.kelasList[index].launch = json.launch;
        } else {
          console.error('Update status failed:', json.message);
          if (typeof Swal !== 'undefined') {
            Swal.fire({
              icon: 'error',
              title: 'Failed',
              text: json.message || 'Failed to update program status',
            });
          }
        }
      } catch (err) {
        console.error('Update status error:', err);
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Network or server error while updating status',
          });
        }
      }
    },

    // Dipanggil dari legacy toggle switch bila ada
    confirmToggleLaunch(courseId, index, event) {
      const course = this.kelasList[index];
      const willLaunch = !course.launch;
      if (event && event.target) {
        event.target.checked = course.launch;
      }

      openConfirmModal({
        title: willLaunch ? 'Launch Program?' : 'Unlaunch Program?',
        description: `Are you sure you want to ${willLaunch ? 'launch' : 'unlaunch'} "${course.name}"?`,
        confirmLabel: willLaunch ? 'Launch' : 'Unlaunch',
        cancelLabel: 'Cancel',
        onConfirm: () => this.toggleLaunch(courseId, index),
      });
    },

    async toggleLaunch(courseId, index) {
      const prev = this.kelasList[index].launch;
      try {
        const res = await fetch(`/program/${courseId}/toggle-launch-json`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
        });
        const json = await res.json();

        if (json.success) {
          this.kelasList[index].launch = json.launch;
          if (json.status) this.kelasList[index].status = json.status;
        } else {
          this.kelasList[index].launch = prev;
          console.error('Toggle launch failed:', json.message);
        }
      } catch (err) {
        this.kelasList[index].launch = prev;
        console.error('Toggle launch error:', err);
      }
    },
  }
}
</script>

{{!-- Toast sukses untuk proses program (create, switch launch/status, delete)
     yang redirect balik ke /program. Dipicu via flashToast() di courses.controller. --}}
{{> components/ui/admin/toast/success/index toast=toast }}
