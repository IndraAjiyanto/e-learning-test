{{!--
  Page: Admin - Detail Quiz (Syllabus / Program context)
  Path: admin/course/detail_quiz.hbs
  Route: GET /syllabus/quiz/detail/:id (or /program/detail-quiz-syllabus/:id)
--}}
<div class='min-h-screen bg-[#F3F3F3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[16px] items-start'
    x-data="detailQuizData()">

    {{!-- Feature Card 1: Header Card --}}
    {{#> components/ui/admin/form/form-card noNumber=true class="gap-[14px]"}}

      {{!-- Frame 2147229598: Top row (Back button) --}}
      <div class='box-border w-full h-[20px] flex flex-row justify-between items-start gap-[24px]'>
        {{!-- Container: Back button --}}
        <a
          href='{{#if syllabus}}/syllabus/{{syllabus.id}}{{else if courseId}}/program/detail/program/admin/{{courseId}}{{else}}/program{{/if}}'
          class='h-[20px] flex flex-row items-center gap-[4px] text-[#718096] hover:text-[#003060] transition-colors focus:outline-none'>
          {{!-- SVG chevron-left icon --}}
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'>
            <polyline points='15 18 9 12 15 6'></polyline>
          </svg>
          <span class='font-inter font-medium text-[16px] leading-[20px]'>
            Back
          </span>
        </a>
      </div>

      {{!-- Frame 2147229617: Header info & actions --}}
      <div class='box-border w-full flex flex-col gap-[20px] items-start'>
        
        {{!-- Frame 2147229601: Title + Action Buttons --}}
        <div class='box-border w-full flex flex-col sm:flex-row justify-between items-start gap-[12px]'>

          {{!-- Quiz Title --}}
          <h1 class='w-full sm:max-w-[650px] font-inter font-bold text-[34px] leading-[38px] tracking-[-0.85px] text-[#003060] break-words'>
            {{default quiz.quizName 'Quiz'}}
          </h1>

          {{!-- Frame 2147229614: Buttons (Delete + Edit) --}}
          <div class='shrink-0 flex flex-row items-center gap-[12px]'>
            {{#unless isAttempted}}
            {{!-- Delete button --}}
            <form action='/syllabus/quiz/{{quiz.id}}?_method=DELETE' method='POST' class='m-0 p-0 inline'>
              <button
                type='button'
                onclick="openDeleteModal(this, 'Delete Quiz?', 'Are you sure you want to delete this quiz? All associated questions and scores will be removed permanently.')"
                class='box-border w-[87px] h-[44px] bg-[#FEF2F2] border border-[#FCA5A5] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#FEE2E2] transition-colors cursor-pointer'>
                <span class='font-inter font-semibold text-[16px] leading-[24px] text-[#EF4444] whitespace-nowrap'>
                  Delete
                </span>
              </button>
            </form>
            {{/unless}}

            <a
              href='/quiz/formEdit/{{quiz.id}}'
              class='box-border min-w-[106px] h-[44px] bg-[#003060] border border-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#002244] transition-colors'>
              <span class='font-inter font-semibold text-[16px] leading-[24px] text-[#FFFFFF] whitespace-nowrap'>
                Edit
              </span>
            </a>
          </div>

        </div>

        {{!-- Frame 2147229574: Metadata grid rows (2 rows x 2 cols) --}}
        <div class='box-border w-full flex flex-col gap-[12px] items-start'>

          {{!-- Frame 2147229575: Row 1 (Minimum Score) --}}
          <div class='box-border w-full flex flex-col sm:flex-row gap-[14px] items-start'>

            {{#unless (eq user.role 'admin')}}
            {{!-- Col 1: Program --}}
            <div class='box-border flex-1 w-full flex flex-col gap-[4px] items-start'>
              <div class='w-full font-inter font-semibold text-[14px] leading-[20px] text-[#171717]'>
                Program
              </div>
              <div class='box-border w-full h-[22px] flex items-center'>
                <div class='h-[22px] bg-[#F5F5F5] rounded-[16px] px-[8px] py-[2px] flex items-center justify-center shrink-0'>
                  <span class='font-inter font-medium text-[12px] leading-[18px] text-[#404040] text-center whitespace-nowrap'>
                    {{#if syllabus.isFinal}}Final Session · {{course.name}}{{else if course.name}}{{course.name}}{{else}}Program{{/if}}
                  </span>
                </div>
              </div>
            </div>
            {{/unless}}

            {{!-- Col 2: Minimum Score --}}
            <div class='box-border flex-1 w-full flex flex-col gap-[4px] items-start'>
              <div class='w-full font-inter font-semibold text-[14px] leading-[20px] text-[#171717]'>
                Minimum Score
              </div>
              <div class='box-border w-full h-[23px] flex items-center'>
                <span class='font-inter font-medium text-[14px] leading-[23px] text-[#737373]'>
                  {{default quiz.minScore 0}}
                </span>
              </div>
            </div>

          </div>

          {{!-- Frame 2147229576: Row 2 (Syllabus + Duration) --}}
          <div class='box-border w-full flex flex-col sm:flex-row gap-[14px] items-start'>

            {{!-- Col 1: Syllabus --}}
            <div class='box-border flex-1 w-full flex flex-col gap-[4px] items-start'>
              <div class='w-full font-inter font-semibold text-[14px] leading-[20px] text-[#171717]'>
                Syllabus
              </div>
              <div class='box-border w-full h-[23px] flex items-center'>
                <span class='font-inter font-medium text-[14px] leading-[23px] text-[#737373] truncate'>
                  {{#if syllabus.title}}{{syllabus.title}}{{else if syllabus.syllabusNumber}}Session {{syllabus.syllabusNumber}}{{else}}-{{/if}}
                </span>
              </div>
            </div>

            {{!-- Col 2: Duration --}}
            <div class='box-border flex-1 w-full flex flex-col gap-[4px] items-start'>
              <div class='w-full font-inter font-semibold text-[14px] leading-[20px] text-[#171717]'>
                Duration
              </div>
              <div class='box-border w-full h-[23px] flex items-center'>
                <span class='font-inter font-medium text-[14px] leading-[23px] text-[#737373]'>
                  {{default quiz.duration 0}} minutes
                </span>
              </div>
            </div>

          </div>

        {{#if isAttempted}}
        {{> components/ui/admin/locked-notice/index
          title='Quiz is locked'
          message='This quiz can be edited, but it cannot be deleted because it has already been attempted by a participant. Questions and answers can also be edited.' }}
        {{/if}}

      </div>

    {{/components/ui/admin/form/form-card}}

    {{!-- Questions Section Card --}}
    {{#> components/ui/admin/form/form-card noNumber=true class="p-[12px_20px_20px] gap-[10px]"}}

      {{!-- Header Toolbar: Questions + Manage Delete --}}
      <div class='w-full flex flex-col gap-3'>
        <div class='w-full flex flex-row items-center justify-between'>
          <span class='font-inter font-semibold text-[14px] leading-[20px] text-[#171717]'>
            Questions ({{#if questions}}{{questions.length}}{{else}}0{{/if}}) :
          </span>
          <div class='flex items-center gap-3'>
            {{#if (and questions questions.length)}}
            {{#unless isAttempted}}
            <button
              type='button'
              @click='toggleSelectMode()'
              class='inline-flex h-9 shrink-0 items-center justify-center gap-1.5 rounded-lg border font-inter text-xs font-semibold transition-all shadow-sm cursor-pointer'
              :class="selectMode ? 'bg-[#F5F5F5] border-[#D4D4D4] hover:bg-[#E5E5E5] text-[#404040] w-9 px-0' : 'bg-white border-[#D4D4D4] hover:border-[#DC2626] hover:bg-[#FEF2F2] text-[#404040] hover:text-[#DC2626] px-3'"
              :title="selectMode ? 'Close' : 'Manage Delete'"
            >
              <template x-if='!selectMode'>
                <div class='flex items-center gap-1.5'>
                  <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-3.5 h-3.5 text-[#DC2626]'>
                    <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
                  </svg>
                  <span>Manage Delete</span>
                </div>
              </template>
              <template x-if='selectMode'>
                <div class='flex items-center justify-center'>
                  <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-3.5 h-3.5 text-[#525252]'>
                    <line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/>
                  </svg>
                </div>
              </template>
            </button>
            {{/unless}}
            {{/if}}

            {{#unless isAttempted}}
            <a
              href='/question/formCreate/{{quiz.id}}'
              class='inline-flex items-center gap-[6px] text-[#003060] hover:text-[#002244] font-inter font-semibold text-[14px] leading-[20px] transition-colors'>
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4'>
                <line x1='12' y1='5' x2='12' y2='19'></line>
                <line x1='5' y1='12' x2='19' y2='12'></line>
              </svg>
              Add Question
            </a>
            {{/unless}}
          </div>
        </div>

        {{#unless isAttempted}}
        {{!-- Bulk Action Bar --}}
        <div
          x-show='selectMode'
          x-cloak
          x-transition:enter='transition ease-out duration-150'
          x-transition:enter-start='opacity-0 -translate-y-2'
          x-transition:enter-end='opacity-100 translate-y-0'
          x-transition:leave='transition ease-in duration-100'
          x-transition:leave-start='opacity-100 translate-y-0'
          x-transition:leave-end='opacity-0 -translate-y-2'
          class='box-border w-full flex flex-col sm:flex-row justify-between items-center px-4 py-2.5 bg-[#FEF2F2] border border-[#FCA5A5] rounded-lg gap-2.5 shadow-sm'
          style='display: none;'
        >
          <div class='flex flex-wrap items-center gap-2 text-[14px] text-[#991B1B] font-inter font-medium'>
            <svg class='w-5 h-5 text-[#DC2626] shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
              <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'/>
            </svg>
            <span>
              <strong x-text='selectedIds ? selectedIds.length : 0'></strong> question(s) selected
            </span>

            <span class='text-[#FCA5A5] mx-1'>•</span>

            <button
              type='button'
              @click='toggleSelectAll()'
              :disabled='isAttempted'
              :class="isAttempted ? 'opacity-50 cursor-not-allowed hover:no-underline' : 'cursor-pointer hover:underline'"
              class='text-xs text-[#DC2626] font-semibold'
              x-text="isAllSelected() ? 'Deselect All' : 'Select All'"
            ></button>

            <template x-if='selectedIds && selectedIds.length > 0'>
              <button
                type='button'
                @click='clearSelection()'
                class='text-xs text-[#7F1D1D] hover:underline font-normal cursor-pointer ml-1'
              >
                (Clear Selection)
              </button>
            </template>
          </div>

          <div class='flex items-center gap-2 w-full sm:w-auto justify-end'>
            <button
              type='button'
              @click='confirmDeleteSelected()'
              :disabled='!selectedIds || selectedIds.length === 0'
              class='inline-flex h-9 items-center justify-center gap-1.5 rounded-lg border border-[#DC2626] bg-[#DC2626] px-3.5 py-1.5 font-inter text-xs font-semibold text-white shadow-sm transition-colors hover:border-[#B91C1C] hover:bg-[#B91C1C] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#DC2626]/40 active:bg-[#991B1B] disabled:cursor-not-allowed disabled:opacity-50'
            >
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-3.5 h-3.5'>
                <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
              </svg>
              <span>Delete Selected (<span x-text='selectedIds ? selectedIds.length : 0'></span>)</span>
            </button>

            <button
              type='button'
              @click='toggleSelectMode()'
              class='inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[#FCA5A5] bg-white text-[#991B1B] hover:bg-[#FEE2E2] transition-colors cursor-pointer'
              title='Close Manage Delete'
            >
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4'>
                <line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/>
              </svg>
            </button>
          </div>
        </div>
        {{/unless}}
      </div>

      {{!-- Frame 2147229624: List Questions --}}
      <div class='box-border w-full flex flex-col gap-[16px] items-start'>

        {{#if (and questions questions.length)}}
          {{#each questions}}
            <div
              class='box-border w-full border border-[#D9D9D9] rounded-[8px] overflow-hidden flex flex-col items-start transition-colors'
              :class="selectMode && selectedIds.includes('{{this.id}}') ? 'bg-[#FEF2F2]/60 border-[#FCA5A5]' : ''"
            >
              {{!-- Accordion Trigger Header --}}
              <div
                class='w-full min-h-[53px] px-[14px] py-[16px] flex flex-row items-center justify-between gap-[16px] text-left transition-colors'
                :class="openQuestionId === '{{this.id}}' ? 'bg-[#FAFAFA] border-b border-[#D9D9D9]' : 'bg-[#FFFFFF]'">
                
                {{#unless ../isAttempted}}
                {{!-- Checkbox in Select Mode --}}
                <div x-show='selectMode' x-cloak class='shrink-0' style='display: none;'>
                  <input
                    type='checkbox'
                    value='{{this.id}}'
                    x-model='selectedIds'
                    :disabled='isAttempted'
                    :title='isAttempted ? "Question cannot be deleted because participants have already attempted this quiz." : "Select question"'
                    @click.stop
                    class='h-4 w-4 rounded border-[#d4d4d4] text-[#003060] focus:ring-[#003060] cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed'
                  />
                </div>
                {{/unless}}

                <button
                  type='button'
                  @click="toggleQuestion('{{this.id}}')"
                  class='flex-1 min-w-0 flex flex-row items-center justify-between gap-[20px] text-left hover:text-[#003060] transition-colors focus:outline-none cursor-pointer'>
                  <span class='font-inter font-normal text-[16px] leading-[20px] text-[#171717] flex-1 truncate'>
                    {{add @index 1}}. {{this.questionText}}
                  </span>
                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='#525252'
                    stroke-width='2'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    class='w-[20px] h-[20px] shrink-0 transition-transform duration-200'
                    :class="openQuestionId === '{{this.id}}' ? 'rotate-180' : ''">
                    <polyline points='6 9 12 15 18 9'></polyline>
                  </svg>
                </button>
              </div>

              {{!-- Accordion Content (Option Answers & Action Buttons) --}}
              <div x-show="openQuestionId === '{{this.id}}'" x-cloak class='box-border w-full bg-[#FFFFFF] p-[14px] flex flex-col items-end gap-[16px]'>
                
                {{#if this.image}}
                  <div class='w-full flex justify-center py-2'>
                    <img src='{{this.image}}' alt='Question Image' class='max-h-60 rounded-lg border border-[#E5E5E5] object-contain shadow-sm' />
                  </div>
                {{/if}}

                {{!-- Options List --}}
                <div class='box-border w-full flex flex-col gap-[10px] items-start'>
                  {{#each this.answers}}
                    {{#if this.isCorrect}}
                      {{!-- Option (Correct Answer - Green / Badge) --}}
                      <div class='box-border w-full min-h-[44px] bg-[#F0FDF4] border border-[#22C55E] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[14px] py-[10px] flex flex-row items-center justify-between gap-[8px]'>
                        <span class='font-inter font-normal text-[16px] leading-[24px] text-[#15803D] flex-1 break-words'>
                          {{this.answer}}
                        </span>
                        <div class='box-border w-[60px] h-[22px] bg-[#15803D] rounded-[16px] px-[8px] py-[2px] flex items-center justify-center shrink-0'>
                          <span class='font-inter font-medium text-[12px] leading-[18px] text-[#FFFFFF] text-center whitespace-nowrap'>
                            Benar
                          </span>
                        </div>
                      </div>
                    {{else}}
                      {{!-- Standard Option --}}
                      <div class='box-border w-full min-h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[14px] py-[10px] flex flex-row items-center gap-[8px]'>
                        <span class='font-inter font-normal text-[16px] leading-[24px] text-[#737373] flex-1 break-words'>
                          {{this.answer}}
                        </span>
                      </div>
                    {{/if}}
                  {{/each}}
                </div>

                {{!-- Question Actions (Delete + Edit) --}}
                <div class='flex flex-row items-center gap-[12px]'>
                  {{#if ../isAttempted}}
                  <div
                    class='box-border w-[87px] h-[44px] bg-[#F5F5F5] border border-[#E5E5E5] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center opacity-50 cursor-not-allowed'
                    title='Question cannot be deleted because participants have already attempted this quiz.'>
                    <span class='font-inter font-semibold text-[16px] leading-[24px] text-[#A3A3A3] whitespace-nowrap'>
                      Delete
                    </span>
                  </div>
                  {{else}}
                  <form action='/question/{{this.id}}/{{../quiz.id}}?_method=DELETE' method='POST' class='m-0 p-0 inline'>
                    <button
                      type='button'
                      onclick="openDeleteModal(this, 'Delete Question?', 'Are you sure you want to delete this question? This action cannot be undone.')"
                      class='box-border w-[87px] h-[44px] bg-[#FEF2F2] border border-[#FCA5A5] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#FEE2E2] transition-colors cursor-pointer'>
                      <span class='font-inter font-semibold text-[16px] leading-[24px] text-[#EF4444] whitespace-nowrap'>
                        Delete
                      </span>
                    </button>
                  </form>
                  {{/if}}

                  {{!-- Edit question button --}}
                  <a
                    href='/question/FormEdit/{{this.id}}'
                    class='box-border min-w-[107px] h-[44px] bg-[#003060] border border-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#002244] transition-colors'>
                    <span class='font-inter font-semibold text-[16px] leading-[24px] text-[#FFFFFF] whitespace-nowrap'>
                      Edit
                    </span>
                  </a>
                </div>

              </div>
            </div>
          {{/each}}
        {{else}}
          {{!-- Empty State --}}
          <div class='w-full py-12 flex flex-col items-center justify-center gap-3 text-center'>
            <div class='w-12 h-12 rounded-full bg-[#F5F5F5] flex items-center justify-center text-[#737373]'>
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-6 h-6'>
                <circle cx='12' cy='12' r='10'></circle>
                <line x1='12' y1='8' x2='12' y2='12'></line>
                <line x1='12' y1='16' x2='12.01' y2='16'></line>
              </svg>
            </div>
            <p class='font-inter font-medium text-[16px] text-[#737373]'>
              No questions in this quiz yet.
            </p>
            {{#unless isAttempted}}
            <a
              href='/question/formCreate/{{quiz.id}}'
              class='inline-flex items-center gap-[6px] px-4 py-2 bg-[#003060] text-white rounded-[8px] font-inter font-semibold text-[14px] hover:bg-[#002244] transition-colors'>
              Add First Question
            </a>
            {{/unless}}
          </div>
        {{/if}}

      </div>

    {{/components/ui/admin/form/form-card}}

  </div>
</div>

{{!-- Modal confirm delete --}}
{{> components/ui/admin/modal/delete_confirm/index
    title='Delete Confirmation'
    description='Are you sure you want to proceed with this deletion?'
    confirmLabel='Delete' }}

{{!-- Toast sukses --}}
{{> components/ui/admin/toast/success/index toast=toast }}

<script>
function detailQuizData() {
  const isAttempted = {{#if isAttempted}}true{{else}}false{{/if}};
  const allQuestionIds = [
    {{#each questions}}
      '{{this.id}}',
    {{/each}}
  ];

  return {
    openQuestionId: {{#if questions.[0]}}'{{questions.[0].id}}'{{else}}null{{/if}},
    selectMode: false,
    selectedIds: [],
    isAttempted: isAttempted,
    allQuestionIds: allQuestionIds,

    toggleQuestion(id) {
      this.openQuestionId = this.openQuestionId === id ? null : id;
    },

    toggleSelectMode() {
      this.selectMode = !this.selectMode;
      if (!this.selectMode) {
        this.selectedIds = [];
      }
    },

    get deletableQuestionIds() {
      return this.isAttempted ? [] : this.allQuestionIds;
    },

    isAllSelected() {
      const deletable = this.deletableQuestionIds;
      if (!deletable || deletable.length === 0) return false;
      return deletable.every(id => this.selectedIds.includes(id));
    },

    toggleSelectAll() {
      const deletable = this.deletableQuestionIds;
      if (this.isAllSelected()) {
        const delSet = new Set(deletable);
        this.selectedIds = this.selectedIds.filter(id => !delSet.has(id));
      } else {
        this.selectedIds = Array.from(new Set([...this.selectedIds, ...deletable]));
      }
    },

    clearSelection() {
      this.selectedIds = [];
    },

    confirmDeleteSelected() {
      const count = this.selectedIds.length;
      if (count === 0) return;

      openDeleteModal({
        title: `Delete ${count} Selected Question(s)?`,
        description: `Are you sure you want to delete ${count} selected question(s)? Answers and media will also be permanently removed. This action cannot be undone.`,
        confirmLabel: `Delete (${count})`,
        cancelLabel: 'Cancel',
        onConfirm: async () => {
          await this.executeDeleteSelected();
        },
      });
    },

    executeDeleteSelected() {
      submitDeleteForm('/bulk-delete/selected', {
        entity: 'question',
        ids: this.selectedIds,
      });
    },
  };
}
</script>