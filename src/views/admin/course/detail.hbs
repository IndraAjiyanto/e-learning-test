{{!--
  Page: Admin — Detail Program (Pencil slicing.pen: sFECD)
  Path: admin/course/detail.hbs
  Route: GET /program/detail/program/admin/:courseId (detailKelas) — masih 1 endpoint lama
  Data kontrak: { course, categoryId?, user, lastWeek } — 100% dari Course entity (BE sebagai sumber kebenaran)
  Layout: slicing.pen 1052px + canvas Gap16 → card hero + card basic info + duo form/capacity + card learning + tab section lama
  Komponen (baru): hero / basic_info / form_info / capacity / learning di components/ui/admin/detail/* (reuse jika ada)
  Tab section (admin week/user/benefit/participants/flow/faq/installment/alumni/log_book) dibiarkan 100% (frozen)
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='box-border w-full max-w-[1052px] mx-auto flex flex-col gap-[16px] justify-start items-start'>

    {{!-- slicing.pen — 5 card baru --}}
    {{> components/ui/admin/detail/hero/index}}
    {{> components/ui/admin/detail/basic_info/index}}
    <div class='w-full flex flex-col lg:flex-row gap-[16px] justify-start items-stretch'>
      <div class='flex-1 min-w-0'>{{> components/ui/admin/detail/form_info/index}}</div>
      <div class='flex-1 min-w-0'>{{> components/ui/admin/detail/capacity/index}}</div>
    </div>
    {{> components/ui/admin/detail/learning/index}}

    {{!-- Tab section — x-data di wrapper agar tab + content satu scope (fix: tab is not defined) --}}
    <div class='box-border w-full h-fit shrink-0 flex flex-col gap-0 justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px] overflow-hidden p-[16px]' x-data="tabData()" x-init="init()">

    {{!-- Tab Navigation (role-based, seperti sebelumnya) --}}
    <div class='flex flex-wrap gap-2 mb-6'>
      {{#if (eq user.role "admin")}}
      <button @click="toggleFetch('/program/week/{{course.id}}', 'week')" :class="tab === 'week' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" class='px-4 py-2 rounded-lg shadow transition'>Week</button>
      <button @click="toggleFetch('/program/userProgram/{{course.id}}', 'user')" :class="tab === 'user' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" class='px-4 py-2 rounded-lg shadow transition'>User</button>
      {{else if (eq user.role "super_admin")}}
      <button @click="toggleFetch('/program/benefit/{{course.id}}', 'benefit')" :class="tab === 'benefit' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" class='px-4 py-2 rounded-lg shadow transition'>Benefit</button>
      <button @click="toggleFetch('/program/participants/{{course.id}}', 'participants')" :class="tab === 'participants' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" class='px-4 py-2 rounded-lg shadow transition'>Participants</button>
      <button @click="toggleFetch('/program/flow/{{course.id}}', 'flow')" :class="tab === 'flow' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" class='px-4 py-2 rounded-lg shadow transition'>Flow</button>
      <button @click="toggleFetch('/program/faq/{{course.id}}', 'faq')" :class="tab === 'faq' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" class='px-4 py-2 rounded-lg shadow transition'>FAQ</button>
      {{#if course.checkPaid}}
      <button @click="toggleFetch('/program/installment/{{course.id}}', 'installment')" :class="tab === 'installment' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" class='px-4 py-2 rounded-lg shadow transition'>Installment</button>
      {{/if}}
      <button @click="toggleFetch('', 'payment')" :class="tab === 'payment' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" class='px-4 py-2 rounded-lg shadow transition'>Payment</button>
      <button @click="toggleFetch('/program/alumni/{{course.id}}', 'alumni')" :class="tab === 'alumni' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" class='px-4 py-2 rounded-lg shadow transition'>Alumni</button>
      <button @click="toggleFetch('/program/userProgram/{{course.id}}', 'user')" :class="tab === 'user' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" class='px-4 py-2 rounded-lg shadow transition'>User</button>
      {{/if}}
      <button @click="toggleFetch('/program/logbookUser/{{course.id}}', 'log_book_user')" :class="tab === 'log_book_user' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" class='px-4 py-2 rounded-lg shadow transition'>Log Book User</button>
      <button @click="toggleFetch('/program/logbookMentor/{{course.id}}', 'log_book_mentor')" :class="tab === 'log_book_mentor' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" class='px-4 py-2 rounded-lg shadow transition'>Log Book Mentor</button>
      <button @click="toggleFetch('/program/mentorProgram/{{course.id}}', 'mentor')" :class="tab === 'mentor' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" class='px-4 py-2 rounded-lg shadow transition'>Mentor</button>
    </div>

    {{!-- Tab Content Areas (frozen) --}}
    <div x-show="tab === 'week'" x-data="weekData()" x-init="fetchWeeks()">{{> course/week_tab }}</div>
    <div x-show="tab === 'mentor'" x-data="mentorData()" x-init="fetchMentors()">{{> course/mentor_tab}}</div>
    <div x-show="tab === 'flow'" x-data="flowData()" x-init="fetchFlow()">{{> course/flow_tab}}</div>
    <div x-show="tab === 'benefit'" x-data="benefitData()" x-init="fetchBenefit()">{{> course/benefit_tab}}</div>
    <div x-show="tab === 'participants'" x-data="participantData()" x-init="fetchParticipants()">{{> course/participants_tab}}</div>
    <div x-show="tab === 'faq'" x-data="faqData()" x-init="fetchFaqs()">{{> course/faq_tab}}</div>
    <div x-show="tab === 'installment'" x-data="installmentData()" x-init="fetchInstallment()">{{> course/installment_tab}}</div>
    <div x-show="tab === 'alumni'" x-data="alumniData()" x-init="fetchAlumni()">{{> course/alumni_tab}}</div>
    <div x-show="tab === 'user'" x-data="userData()" x-init="fetchUsers()">{{> course/user_tab}}</div>
    <div x-show="tab === 'log_book_user'" x-data="logBookUserData()" x-init="fetchLogBookUsers()">{{> course/log_book_user_tab}}</div>
    <div x-show="tab === 'log_book_mentor'" x-data="logBookMentorData()" x-init="fetchLogBookMentors()">{{> course/log_book_mentor_tab}}</div>
    <div x-show="tab === 'payment'">{{> course/payment_tab}}</div>

    </div>

  </div>
</div>

<script>
function tabData() {
  return {
    search: '',
    tab: localStorage.getItem('activeTab'),
    data: [],
    async init() {
      if(!this.tab) {
        if("{{user.role}}" === "admin") {
          this.tab = 'week';
          localStorage.setItem('activeTab', 'week');
        } else if ("{{user.role}}" === "super_admin") {
          this.tab = 'benefit';
          localStorage.setItem('activeTab', 'benefit');
        }
      }
    },
    async toggleFetch(url, tabName) {
      this.tab = tabName;
      localStorage.setItem('activeTab', tabName);
      this.data = [];
    }
  }
}
</script>
