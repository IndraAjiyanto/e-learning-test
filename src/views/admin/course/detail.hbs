{{!--
  Page: Admin — Detail Program
  Path: admin/course/detail.hbs
  Route: GET /program/detail/program/admin/:courseId (detailKelas) — masih 1 endpoint lama
  Data kontrak: { course, categoryId?, user, lastWeek } — 100% dari Course entity (BE sebagai sumber kebenaran)
  Layout: card hero + card basic info + duo form/capacity + card learning + tab section lama
  Komponen (baru): hero / basic_info / form_info / capacity / learning di components/ui/admin/detail/* (reuse jika ada)
  Tab section (admin week/user/benefit/participants/flow/faq/installment/alumni/log_book) dibiarkan 100% (frozen)
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='box-border w-full max-w-[1052px] mx-auto flex flex-col gap-[16px] justify-start items-start'>

    {{!-- 5 card baru --}}
    {{> components/ui/admin/detail/hero/index}}
    {{> components/ui/admin/detail/basic_info/index}}
    <div class='w-full flex flex-col lg:flex-row gap-[16px] justify-start items-stretch'>
      <div class='flex-1 min-w-0'>{{> components/ui/admin/detail/form_info/index}}</div>
      <div class='flex-1 min-w-0'>{{> components/ui/admin/detail/capacity/index}}</div>
    </div>
    {{> components/ui/admin/detail/learning/index}}

    {{!-- Tab section — x-data di wrapper agar tab + content satu scope (fix: tab is not defined) --}}
    <div class='box-border w-full h-fit shrink-0 flex flex-col gap-0 justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px] overflow-hidden p-[12px_20px_20px_20px]' x-data="tabData()" x-init="init()">

    {{!-- Tab Navigation: underline-tabs component --}}
    <div x-data="{ tabs: [
      {name:'week',label:'Week',url:'/program/week/{{course.id}}'},
      {name:'user',label:'User',url:'/program/userProgram/{{course.id}}'},
      {name:'log_book_user',label:'Logbook User',url:'/program/logbookUser/{{course.id}}'},
      {name:'log_book_mentor',label:'Logbook Mentor',url:'/program/logbookMentor/{{course.id}}'},
      {name:'mentor',label:'Mentor',url:'/program/mentorProgram/{{course.id}}'}
    ] }">
      {{> components/ui/admin/form/underline-tabs activeTabVar="tab" fetchFn="toggleFetch"}}
    </div>

    {{!-- Tab Content Areas (frozen) --}}
    <div x-show="tab === 'week'" class='w-full' x-data="weekData()" x-init="fetchWeeks()">{{> course/week_tab }}</div>
    <div x-show="tab === 'mentor'" class='w-full' x-data="mentorData()" x-init="fetchMentors()">{{> course/mentor_tab}}</div>
    <div x-show="tab === 'flow'" class='w-full' x-data="flowData()" x-init="fetchFlow()">{{> course/flow_tab}}</div>
    <div x-show="tab === 'benefit'" class='w-full' x-data="benefitData()" x-init="fetchBenefit()">{{> course/benefit_tab}}</div>
    <div x-show="tab === 'participants'" class='w-full' x-data="participantData()" x-init="fetchParticipants()">{{> course/participants_tab}}</div>
    <div x-show="tab === 'faq'" class='w-full' x-data="faqData()" x-init="fetchFaqs()">{{> course/faq_tab}}</div>
    <div x-show="tab === 'installment'" class='w-full' x-data="installmentData()" x-init="fetchInstallment()">{{> course/installment_tab}}</div>
    <div x-show="tab === 'alumni'" class='w-full' x-data="alumniData()" x-init="fetchAlumni()">{{> course/alumni_tab}}</div>
    <div x-show="tab === 'user'" class='w-full' x-data="userData()" x-init="fetchUsers()">{{> course/user_tab}}</div>
    <div x-show="tab === 'log_book_user'" class='w-full' x-data="logBookUserData()" x-init="fetchLogBookUsers()">{{> course/log_book_user_tab}}</div>
    <div x-show="tab === 'log_book_mentor'" class='w-full' x-data="logBookMentorData()" x-init="fetchLogBookMentors()">{{> course/log_book_mentor_tab}}</div>
    <div x-show="tab === 'payment'" class='w-full'>{{> course/payment_tab}}</div>

    </div>

  </div>
</div>

<script>
function tabData() {
  return {
    search: '',
    tab: localStorage.getItem('activeTab'),
    data: [],
    async init() {
      if(!this.tab) {
        if("{{user.role}}" === "admin") {
          this.tab = 'week';
          localStorage.setItem('activeTab', 'week');
        } else if ("{{user.role}}" === "super_admin") {
          this.tab = 'benefit';
          localStorage.setItem('activeTab', 'benefit');
        }
      }
    },
    async toggleFetch(url, tabName) {
      this.tab = tabName;
      localStorage.setItem('activeTab', tabName);
      this.data = [];
    }
  }
}
</script>

{{!-- Toast sukses untuk aksi tab program (mentor, participants, benefit,
     flow, FAQ, installment, alumni) yang semuanya redirect balik ke sini. --}}
{{> components/ui/admin/toast/success/index toast=toast }}

{{!-- Dipakai oleh tombol delete week di course/week_tab (openDeleteModal) --}}
{{> components/ui/admin/modal/delete_confirm/index
    title='Delete Week'
    description='Are you sure you want to delete this week? Sessions inside it will be removed too.'
    confirmLabel='Delete' }}
