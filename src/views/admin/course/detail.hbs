<div class="py-10 w-full mx-auto px-6">
  <!-- ===================== CARD DETAIL KELAS ===================== -->
  <div class="mb-6 mx-auto px-6 py-10 bg-white rounded-2xl shadow-xl space-y-8 relative" x-data="{
      prev: '/program',
      init() {
        this.prev = localStorage.getItem('kelasPrevUrl') || '/program';
      },
      goBack() {
        const prevUrl = localStorage.getItem('kelasPrevUrl');
        if (prevUrl) {
          localStorage.removeItem('kelasPrevUrl');
          window.location.href = prevUrl;
        } else {
          window.location.href = '/program';
        }
      }
    }" x-init="init()">

    <!-- Tombol Back -->
    <div >
      <a 
        x-bind:href="prev"
        @click.prevent="goBack()"
        class="inline-flex items-center text-gray-600 text-base font-medium hover:underline cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" 
             class="h-5 w-5 mr-1" 
             fill="none" 
             viewBox="0 0 24 24" 
             stroke="currentColor">
          <path stroke-linecap="round" 
                stroke-linejoin="round" 
                stroke-width="2" 
                d="M15 19l-7-7 7-7" />
        </svg>
        Back
      </a>
    </div>

    <!-- Tombol Aksi (Top Right Corner) - Sejajar dengan Back Button -->
    <div class="absolute top-0 right-6 flex flex-col items-end gap-1 z-10">
      <!-- Tombol Launch/Toggle di Atas -->
      {{#if (roles course.process "acc")}}
      <form action="/program/{{course.id}}/toggle-status?_method=PATCH" method="POST">
        <button type="button" 
                onclick="confirmAction(this, '{{#if course.launch}}Are you sure cancel launch this program?{{else}}Are you sure launch this program?{{/if}}')"
                class="relative inline-flex h-5 w-9 items-center rounded-full transition-colors focus:outline-none
                  {{#if course.launch}} bg-green-500 {{else}} bg-gray-300 {{/if}}">
          <span 
            class="inline-block h-3 w-3 transform rounded-full bg-white transition-transform
              {{#if course.launch}} translate-x-5 {{else}} translate-x-1 {{/if}}">
          </span>
        </button>
      </form>
      {{/if}}
      
      <!-- Tombol Edit dan Delete di Bawah (Samping Kanan Kiri) -->
      <div class="flex items-center gap-2">
        <!-- Tombol Edit (Kiri) -->
        <a href="/program/edit/{{course.id}}"
           class="p-2 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 hover:text-blue-800 transition shadow-sm"
           title="Edit Class">
          <svg xmlns="http://www.w3.org/2000/svg"
               fill="none" viewBox="0 0 24 24"
               stroke-width="2" stroke="currentColor"
               class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M16.862 4.487l1.687-1.688a1.875 1.875
                     0 112.652 2.652L10.582 16.07a4.5
                     4.5 0 01-1.897 1.13l-2.685.805.805-2.685
                     a4.5 4.5 0 011.13-1.897l10.927-10.936z" />
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M19.5 7.125L16.875 4.5" />
          </svg>
        </a>

        <!-- Tombol Delete (Kanan) -->
        <form action="/program/{{course.id}}?_method=DELETE" method="post" class="inline" x-data>
          <input type="hidden" name="previous" :value="prev">
          <button
            type="button"
            onclick="confirmDelete(this)"
            class="p-2 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-800 transition shadow-sm"
            title="Delete Class">
            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none" viewBox="0 0 24 24"
                 stroke-width="2" stroke="currentColor"
                 class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
            </svg>
          </button>
        </form>
      </div>
    </div>

    <!-- Image and Description Row -->
    <div class="flex flex-col lg:flex-row gap-4 mb-4">

      <!-- Gambar Kelas -->
      <div class="flex-shrink-0">
        <img src="{{course.image}}"
             alt="Cover {{course.name}}"
             class="w-48 h-32 lg:w-56 lg:h-40 object-cover rounded-lg shadow-md">
      </div>

      <!-- Description Section -->
      <div class="flex-1 bg-white rounded-lg p-3 border border-gray-200">
        <h3 class="text-sm font-semibold text-gray-800 mb-2 flex items-center">
          <svg class="w-4 h-4 mr-2 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
          </svg>
          Description
        </h3>
        <p class="text-gray-700 leading-relaxed text-sm">{{course.description.id}}</p>
        <p class="text-gray-700 leading-relaxed text-sm">{{course.description.en}}</p>
        <p class="text-gray-700 leading-relaxed text-sm">{{course.description.ja}}</p>
      </div>
    </div>

    <!-- Info Cards Below -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <!-- Basic Information -->
        <div class="bg-gray-50 rounded-lg p-3">
          <h3 class="text-sm font-semibold text-gray-800 mb-2 flex items-center">
            <svg class="w-4 h-4 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Basic Information
          </h3>
          <div class="space-y-1 text-xs">
            <p><span class="font-medium text-gray-600">Program Name:</span> <span class="text-gray-800">{{course.name}}</span></p>
            <p><span class="font-medium text-gray-600">Category:</span> <span class="text-gray-800">{{course.category.name}}</span></p>
            <p><span class="font-medium text-gray-600">Type:</span> <span class="text-gray-800">{{ course.courseType.nameClassesType}}</span></p>
            <p><span class="font-medium text-gray-600">Method:</span> <span class="text-gray-800">{{#if (eq course.method 'online')}}Online{{else}}Offline{{/if}}</span></p>
            <p><span class="font-medium text-gray-600">Location:</span> <span class="text-gray-800">{{#each course.locations}}{{this}}{{/each}}</span></p>
            <p><span class="font-medium text-gray-600">Location:</span> <a href="{{course.locationLink}}" target="_blank" class="text-blue-500 underline truncate block">{{course.locationLink}}</a></p>
            {{#if (eq course.category.name "Short Class")}}
            <p><span class="font-medium text-gray-600">Duration:</span> <span class="text-gray-800">{{course.day}} day</span></p>
            {{else}}
            <p><span class="font-medium text-gray-600">Duration:</span> <span class="text-gray-800">{{course.month}} month</span></p>
            {{/if}}
            <p><span class="font-medium text-gray-600">Time Start:</span> <span class="text-gray-800">{{#if course.time_start}}{{formatTime course.time_start}}{{else}}Not set{{/if}}</span></p>
            <p><span class="font-medium text-gray-600">Time End:</span> <span class="text-gray-800">{{#if course.time_end}}{{formatTime course.time_end}}{{else}}Not set{{/if}}</span></p>
            <p><span class="font-medium text-gray-600">Registration Date:</span> <span class="text-gray-800">{{#if course.date_registration}}{{formatDate course.date_registration}}{{else}}Not set{{/if}}</span></p>
            <p><span class="font-medium text-gray-600">Start Date:</span> <span class="text-gray-800">{{#if course.startDate}}{{formatDate course.startDate}}{{else}}Not set{{/if}}</span></p>
            <p><span class="font-medium text-gray-600">End Date:</span> <span class="text-gray-800">{{#if course.startEnd}}{{formatDate course.startEnd}}{{else}}Not set{{/if}}</span></p>
          </div>
        </div>

        <!-- Capacity & Enrollment -->
        <div class="bg-green-50 rounded-lg p-3">
          <h3 class="text-sm font-semibold text-gray-800 mb-2 flex items-center">
            <svg class="w-4 h-4 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            Capacity & Enrollment
          </h3>
          <div class="space-y-1 text-xs">
            <p><span class="font-medium text-gray-600">Capacity:</span> <span class="text-gray-800">{{course.quota}} students</span></p>
            <p><span class="font-medium text-gray-600">Enrolled:</span> <span class="text-gray-800">{{course.userCourses.length}} students</span></p>
            <div class="mt-2">
              <div class="flex justify-between text-xs text-gray-600 mb-1">
                <span>Progress</span>
                <span>{{course.userCourses.length}}/{{course.quota}}</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <div class="bg-green-500 h-2 rounded-full transition-all duration-300"
                     style="width: {{#if course.quota}}{{multiply (divide course.userCourses.length course.quota) 100}}%{{else}}0%{{/if}}"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Pricing/Form Information -->
        <div class="bg-blue-50 rounded-lg p-3">
          <h3 class="text-sm font-semibold text-gray-800 mb-2 flex items-center">
            <svg class="w-4 h-4 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
            </svg>
            {{#if course.checkPaid}}Pricing Information{{else}}Form Information{{/if}}
          </h3>
          <div class="space-y-1 text-xs">
            {{#if course.checkPaid}}
            <p><span class="font-medium text-gray-600">Price:</span> <span class="text-gray-800 font-semibold">Rp {{formatRupiah course.price}}</span></p>
            <p><span class="font-medium text-gray-600">Promo:</span> <span class="text-green-600 font-semibold">Rp {{formatRupiah course.promo}}</span></p>
            <p><span class="font-medium text-gray-600">Type:</span> <span class="text-green-600">Paid</span></p>
            {{else}}
            <p><span class="font-medium text-gray-600">Form:</span> <a href="{{course.form}}" target="_blank" class="text-blue-500 underline truncate block">{{#if course.form}}{{course.form}}{{else}}No form required{{/if}}</a></p>
            <p><span class="font-medium text-gray-600">Type:</span> <span class="text-blue-600">Free</span></p>
            {{/if}}
          </div>
        </div>

        <!-- Learning Details -->
        <div class="bg-purple-50 rounded-lg p-3">
          <h3 class="text-sm font-semibold text-gray-800 mb-2 flex items-center">
            <svg class="w-4 h-4 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            Learning Details
          </h3>
          <div class="space-y-1 text-xs">
            <p><span class="font-medium text-gray-600">Account Mentor:</span> <span class="text-gray-800">{{#each course.mentorings}}{{this.user.username}}{{/each}}</span></p>
            <p><span class="font-medium text-gray-600">Target:</span> <span class="text-gray-800">{{truncate course.learningTargetsId 40}}</span></p>
            <p><span class="font-medium text-gray-600">Target:</span> <span class="text-gray-800">{{truncate course.learningTargetsEn 40}}</span></p>
            <p><span class="font-medium text-gray-600">Target:</span> <span class="text-gray-800">{{truncate course.learningTargetsJa 40}}</span></p>
            <div class="mt-2">
              <p class="font-medium text-gray-600 mb-1">Technologies:</p>
              <div class="flex flex-wrap gap-1">
                {{#each course.technologies}}
                <div class='flex items-center gap-2'>
                  {{#if this.svg}}
                  <div class='w-6 h-6 flex items-center justify-center'>
                    {{{ this.svg }}}
                  </div>
                  {{/if}}
                  {{#if this.imgUrl}}
                  <div class='w-6 h-6 flex items-center justify-center'>
                    <img src="{{this.imgUrl}}" alt="{{this.name}}" class="w-full h-full object-contain">
                  </div>
                  {{/if}}
                </div>
                {{/each}}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

<!-- ===================== TAB SECTION ===================== -->
<div class="mx-auto px-6 py-10 bg-white rounded-2xl shadow-xl" 
     x-data="tabData()" x-init="init()">

  <!-- Tab Navigation -->
  <div class="flex space-x-4 mb-6">
    {{#if (eq user.role "admin")}}
    <button @click="toggleFetch('/program/week/{{course.id}}', 'week')" 
            :class="tab === 'week' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" 
            class="px-4 py-2 rounded-lg shadow transition">
      Week
    </button>

    <button @click="toggleFetch('/program/userProgram/{{course.id}}', 'user')" 
            :class="tab === 'user' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" 
            class="px-4 py-2 rounded-lg shadow transition">
      User
    </button>

    {{else if (eq user.role "super_admin")}}

    <button @click="toggleFetch('/program/benefit/{{course.id}}', 'benefit')" 
            :class="tab === 'benefit' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" 
            class="px-4 py-2 rounded-lg shadow transition">
      Benefit
    </button>

    <button @click="toggleFetch('/program/participants/{{course.id}}', 'participants')" 
            :class="tab === 'participants' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" 
            class="px-4 py-2 rounded-lg shadow transition">
      Participants
    </button>

    <button @click="toggleFetch('/program/flow/{{course.id}}', 'flow')" 
            :class="tab === 'flow' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" 
            class="px-4 py-2 rounded-lg shadow transition">
      Flow
    </button>

    <button @click="toggleFetch('/program/faq/{{course.id}}', 'faq')" 
            :class="tab === 'faq' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" 
            class="px-4 py-2 rounded-lg shadow transition">
      FAQ
    </button>

    {{#if course.checkPaid}}
    <button @click="toggleFetch('/program/installment/{{course.id}}', 'installment')" 
            :class="tab === 'installment' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" 
            class="px-4 py-2 rounded-lg shadow transition">
      Installment
    </button>
    {{/if}}

    <button @click="toggleFetch('', 'payment')" 
            :class="tab === 'payment' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" 
            class="px-4 py-2 rounded-lg shadow transition">
      Payment
    </button>

    <button @click="toggleFetch('/program/alumni/{{course.id}}', 'alumni')" 
            :class="tab === 'alumni' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" 
            class="px-4 py-2 rounded-lg shadow transition">
      Alumni
    </button>

    <button @click="toggleFetch('/program/userProgram/{{course.id}}', 'user')" 
            :class="tab === 'user' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" 
            class="px-4 py-2 rounded-lg shadow transition">
      User
    </button>

    {{/if}}
        <button @click="toggleFetch('/program/logbookUser/{{course.id}}', 'log_book_user')" 
            :class="tab === 'log_book_user' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" 
            class="px-4 py-2 rounded-lg shadow transition">
      Log Book User
    </button>

    <button @click="toggleFetch('/program/logbookMentor/{{course.id}}', 'log_book_mentor')" 
            :class="tab === 'log_book_mentor' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" 
            class="px-4 py-2 rounded-lg shadow transition">
      Log Book Mentor
    </button>
    
    <button @click="toggleFetch('/program/mentorProgram/{{course.id}}', 'mentor')" 
            :class="tab === 'mentor' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'" 
            class="px-4 py-2 rounded-lg shadow transition">
      Mentor
    </button>
  </div>

  <!-- Tab Content Areas -->
  <div x-show="tab === 'week'" x-data="weekData()" x-init="fetchWeeks()">
    {{> course/week_tab }}
  </div>

  <div x-show="tab === 'mentor'" x-data="mentorData()" x-init="fetchMentors()">
    {{> course/mentor_tab}}
  </div>

  <div x-show="tab === 'flow'" x-data="flowData()" x-init="fetchFlow()">
    {{> course/flow_tab}}
  </div>

  <div x-show="tab === 'benefit'" x-data="benefitData()" x-init="fetchBenefit()">
    {{> course/benefit_tab}}
  </div>

  <div x-show="tab === 'participants'" x-data="participantData()" x-init="fetchParticipants()">
    {{> course/participants_tab}}
  </div>

  <div x-show="tab === 'faq'" x-data="faqData()" x-init="fetchFaqs()">
    {{> course/faq_tab}}
  </div>

  <div x-show="tab === 'installment'" x-data="installmentData()" x-init="fetchInstallment()">
    {{> course/installment_tab}}
  </div>

  <div x-show="tab === 'alumni'" x-data="alumniData()" x-init="fetchAlumni()">
    {{> course/alumni_tab}}
  </div>

  <div x-show="tab === 'user'" x-data="userData()" x-init="fetchUsers()">
    {{> course/user_tab}}
  </div>

  <div x-show="tab === 'log_book_user'" x-data="logBookUserData()" x-init="fetchLogBookUsers()">
    {{> course/log_book_user_tab}}
  </div>

  <div x-show="tab === 'log_book_mentor'" x-data="logBookMentorData()" x-init="fetchLogBookMentors()">
    {{> course/log_book_mentor_tab}}
  </div>

  <div x-show="tab === 'payment'">
    {{> course/payment_tab}}
  </div>
</div>
</div>

<script>
function tabData() {
  return {
    search: '',
    tab: localStorage.getItem('activeTab'),
    data: [],

    async init() {
      if(!this.tab) {
        if("{{user.role}}" === "admin") {
          this.tab = 'week';
          localStorage.setItem('activeTab', 'week');
        } else if ("{{user.role}}" === "super_admin") {
          this.tab = 'benefit';
          localStorage.setItem('activeTab', 'benefit');
        }
      }
    },
    
    async toggleFetch(url, tabName) {
      this.tab = tabName;
      localStorage.setItem('activeTab', tabName);
      this.data = [];
    }
  }
}
</script>