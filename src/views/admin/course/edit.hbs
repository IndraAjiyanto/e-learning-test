{{!--
  Page: Admin - Edit Program (course endpoint)
  Path: admin/course/edit.hbs
  Route: GET /program/edit/:courseId (formEdit) -> PATCH /program/:courseId (update)
  Layout kartu + sidebar + script shared dengan halaman create.
  Prefill: x-init (paidClass/methodOnline/formData) + {{#if course}} di kartu.
--}}
{{> admin/program/program_form_script}}

<div class='py-10 px-6'>
  <div class='max-w-[1100px] mx-auto'
    x-data='{ ...programData("edit"), ...formDirtyGate() }'
    x-init='paidClass = {{#if course.checkPaid}}true{{else}}false{{/if}}; programType = "{{default course.programType 'bootcamp'}}"; logbookEnabled = {{#if (eq course.logbookEnabled false)}}false{{else}}true{{/if}}; methodOnline = {{#if (eq course.method 'offline')}}false{{else}}true{{/if}}; formData.description = {{#if course.description}}{{json course.description}}{{else}}{ id: "", en: "", ja: "" }{{/if}}; formData.location = {{#if course.locations}}{{json course.locations}}{{else}}{ id: "", en: "", ja: "" }{{/if}}; formData.locationLink = {{#if course.locationLink}}"{{course.locationLink}}"{{else}}""{{/if}}; $nextTick(() => { scheduleUpdate(); initScrollObserver(); }); setTimeout(() => scheduleUpdate(), 400);; $nextTick(() => captureBaseline())'
    @input='recomputeDirty()'
    @change='recomputeDirty()'
  >

    {{!-- Page Header --}}
    <div class='flex flex-col gap-[4px] mb-[24px]'>
      {{> components/ui/admin/text/title text="Edit Program"}}
      {{> components/ui/admin/text/subtitle text="Update an existing program in the system"}}
    </div>

    {{!-- Main Layout: Content + Sidebar --}}
    <form
      method='POST'
      action='/program/{{course.id}}?_method=PATCH'
      enctype='multipart/form-data'
      @submit.prevent="if (canSubmit()) { loading = true; $el.submit(); } else { submitAttempted = true; updateCompleteness(); }"
      @input.capture="onInputCapture($event)"
      @change="updateCompleteness()"
      @click="scheduleUpdate(); activateSection($event.target)"
      @focusin.capture="activateSection($event.target)"
      @focusout.capture="onBlurCapture($event)"
    >
      <div class='flex flex-col lg:flex-row gap-[16px] justify-start items-stretch lg:items-start'>

        {{!-- Left Column - Cards (shared dengan create, prefill via {{#if course}}) --}}
        <div class='flex-1 min-w-0 flex flex-col gap-[16px]'>
          {{> admin/program/create/card_01_basic_info}}
          {{> admin/program/create/card_02_description}}
          {{> admin/program/create/card_03_schedule}}
          {{> admin/program/create/card_04_tools}}
          {{!-- Section 05 + 06: one row, two columns --}}
          <div class='flex flex-col sm:flex-row gap-[16px] w-full justify-start items-stretch sm:items-start'>
            <div class='flex-1 min-w-0'>
              {{> admin/program/create/card_05_learning}}
            </div>
            <div class='flex-1 min-w-0'>
              {{> admin/program/create/card_06_criteria}}
            </div>
          </div>

          {{!-- Action Bar (edit: Update + Cancel, tanpa ubah launch) --}}
          <div class='box-border w-full h-fit shrink-0 flex flex-col sm:flex-row gap-[12px] p-[16px_24px] justify-between items-stretch sm:items-center bg-[#FFFFFF] [outline:1px_solid_#E5E5E5] [outline-offset:-0.5px] rounded-[12px]'>
            <a href='/program/detail/program/admin/{{course.id}}'
              class='box-border shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FFFFFF] border border-[#D4D4D4] rounded-[8px] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] hover:bg-[#F5F5F5] transition-colors'>
              <span class='text-[16px]/[24px] text-[#003060] font-inter font-semibold whitespace-nowrap'>Cancel</span>
            </a>
            <button type='submit'
              :disabled='!formComplete || loading'
              :class="!formComplete || loading ? 'bg-[#003060] opacity-50 cursor-not-allowed' : 'bg-[#003060] hover:bg-[#00254a]'"
              class='box-border w-[158px] shrink-0 h-[44px] flex flex-row gap-0 p-[10px_18px] justify-center items-center [outline:1px_solid_#003060] [outline-offset:-0.5px] rounded-[8px] transition-colors'>
              <span x-show='loading' class='loading loading-spinner loading-sm'></span>
              <span x-show='!loading' class='text-[16px]/[24px] text-[#FFFFFF] font-inter font-semibold whitespace-nowrap'>Update</span>
            </button>
          </div>
        </div>

        {{!-- Right Column - Sidebar --}}
        {{> admin/program/create/sidebar}}

      </div>

      {{!-- Cover Warning --}}
      <template x-if='coverHasFile && !coverValid'>
        <div class='flex items-center gap-2 p-3 mt-[16px] bg-red-50 [outline:1px_solid_#DC2626] rounded-[8px]'>
          <i class='fas fa-exclamation-triangle text-[#DC2626]'></i>
          <p class='text-[14px] text-[#DC2626] font-inter'>
            <span class='font-semibold'>Cannot submit:</span> Please fix the cover image validation errors above.
          </p>
        </div>
      </template>

      {{!-- Submit Warning --}}
      <template x-if='hasVisibleErrors()'>
        <div class='flex items-center gap-2 p-3 mt-[8px] bg-red-50 [outline:1px_solid_#DC2626] rounded-[8px]'>
          <i class='fas fa-exclamation-triangle text-[#DC2626]'></i>
          <p class='text-[14px] text-[#DC2626] font-inter'>
            <span class='font-semibold'>Cannot submit:</span> Please fix all validation errors above.
          </p>
        </div>
      </template>

    </form>
  </div>
</div>
