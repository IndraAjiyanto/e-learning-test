<script>
function programData(mode) {
  return {
    mode: mode,
    loading: false,
    submitAttempted: false,
    touched: {},
    paidClass: false,
    coverHasFile: false,
    coverValid: true,
    categorySelected: null,
    formComplete: false,
    fieldStatus: {},
    _scheduleTimer: null,
    _lastHidden: {},

    formData: {
      description: { id: '', en: '', ja: '' },
      location: { id: '', en: '', ja: '' },
      locationLink: ''
    },
    formErrors: { locationLink: '' },
    formValid: { locationLink: true },

    /* ================= VALIDATION HELPERS ================= */

    val(elId) {
      const el = document.getElementById(elId);
      return el ? el.value.trim() : '';
    },

    hiddenValue(nameAttr) {
      const el = document.querySelector('input[name="' + nameAttr + '"]');
      return el ? String(el.value).trim() : '';
    },

    setFieldError(elId, message) {
      const errEl = document.getElementById(elId + '_error');
      if (!errEl) return;
      const show = message && (this.submitAttempted || this.touched[elId]);
      if (show) {
        errEl.textContent = message;
        errEl.classList.remove('hidden');
      } else {
        errEl.textContent = '';
        errEl.classList.add('hidden');
      }
    },

    nonEmpty(value, label) {
      const v = (value === null || value === undefined) ? '' : String(value).trim();
      return v !== '' ? '' : label + ' is required';
    },

    setFieldStatus(elId, ok) {
      const show = this.submitAttempted || this.touched[elId];
      this.fieldStatus[elId] = show ? (ok ? 'valid' : 'error') : '';
      this.showSuccess(elId, this.fieldStatus[elId] === 'valid');
    },

    successText(elId) {
      const messages = {
        name: 'Program Name looks good!',
        group: 'Group looks good!',
        deskripsi_id: 'Indonesian description looks good!',
        deskripsi_en: 'English description looks good!',
        deskripsi_ja: 'Japanese description looks good!',
        lokasi_id: 'Location (ID) looks good!',
        lokasi_en: 'Location (EN) looks good!',
        lokasi_ja: 'Location (JP) looks good!',
        month: 'Valid month (1-12)',
        day: 'Valid day (1-31)',
        time_start: 'Valid start time',
        time_end: 'Valid end time',
        date_registration: 'Valid registration date',
        startDate: 'Valid start date',
        endDate: 'Valid end date',
        harga1: 'Valid price amount',
        promo1: 'Valid promo amount',
        kuota1: 'Valid quota amount',
        form: 'Valid URL',
        categoryId: 'Category selected',
        jenis_kelasId: 'Program Type selected',
        mentoringId: 'Mentoring selected'
      };
      return messages[elId] || 'Valid';
    },

    showSuccess(elId, visible) {
      let el = document.getElementById(elId + '_success');
      if (!el) {
        const errEl = document.getElementById(elId + '_error');
        if (!errEl || !errEl.parentElement) return;
        el = document.createElement('div');
        el.id = elId + '_success';
        errEl.parentElement.insertBefore(el, errEl.nextSibling);
      }
      if (visible) {
        el.innerHTML =
          '<div class="flex items-start gap-2 p-2 bg-green-50 border border-green-300 rounded-lg mt-1">' +
          '<i class="fas fa-check-circle text-green-500 mt-0.5"></i>' +
          '<p class="text-xs text-green-700">' + this.successText(elId) + '</p>' +
          '</div>';
      } else {
        el.innerHTML = '';
      }
    },

    clearField(elId) {
      this.setFieldError(elId, '');
      this.fieldStatus[elId] = '';
      this.showSuccess(elId, false);
    },

    borderClass(elId) {
      const s = this.fieldStatus[elId];
      if (s === 'error') return 'border-red-500 focus:ring-red-500 focus:border-red-500';
      if (s === 'valid') return 'border-green-500 focus:ring-green-500 focus:border-green-500';
      return 'border-gray-300 focus:ring-gray-900';
    },

    validateTextField(elId, label) {
      const msg = this.nonEmpty(this.val(elId), label);
      this.setFieldError(elId, msg);
      this.setFieldStatus(elId, !msg);
      return !msg;
    },

    validateNumberField(elId, label, min, max) {
      const raw = this.val(elId);
      let msg = this.nonEmpty(raw, label);
      if (!msg && !/^\d+$/.test(raw)) {
        msg = label + ' must contain numbers only';
      }
      if (!msg) {
        const n = parseInt(raw, 10);
        if (n < min || n > max) {
          msg = label + ' must be between ' + min + ' and ' + max;
        }
      }
      this.setFieldError(elId, msg);
      this.setFieldStatus(elId, !msg);
      return !msg;
    },

    validateDateField(elId, label, compareId, compareLabel) {
      const raw = this.val(elId);
      let msg = this.nonEmpty(raw, label);
      if (!msg && isNaN(new Date(raw).getTime())) {
        msg = label + ' must be a valid date';
      }
      if (!msg && compareId) {
        const other = this.val(compareId);
        if (other && !isNaN(new Date(other).getTime())) {
          if (new Date(raw) < new Date(other)) {
            msg = label + ' must be on or after ' + compareLabel;
          }
        }
      }
      this.setFieldError(elId, msg);
      this.setFieldStatus(elId, !msg);
      return !msg;
    },

    validateTimeFields() {
      const startMsg = this.nonEmpty(this.val('time_start'), 'Time Start');
      this.setFieldError('time_start', startMsg);
      this.setFieldStatus('time_start', !startMsg);
      let endMsg = this.nonEmpty(this.val('time_end'), 'Time End');
      if (!endMsg && !startMsg && this.val('time_end') <= this.val('time_start')) {
        endMsg = 'Time End must be later than Time Start';
      }
      this.setFieldError('time_end', endMsg);
      this.setFieldStatus('time_end', !endMsg);
      return !startMsg && !endMsg;
    },

    clearTimeErrors() {
      this.setFieldError('time_start', '');
      this.setFieldError('time_end', '');
    },

    validateDropdown(hiddenName, elId, label) {
      const value = this.hiddenValue(hiddenName);
      let msg = this.nonEmpty(value, label);
      if (!msg && (!/^\d+$/.test(value) || parseInt(value, 10) <= 0)) {
        msg = label + ' must be selected from the list';
      }
      this.setFieldError(elId, msg);
      this.setFieldStatus(elId, !msg);
      return !msg;
    },

    validateList(nameAttr, elId, label, numericOnly) {
      const inputs = document.querySelectorAll('input[name="' + nameAttr + '"]');
      const values = Array.from(inputs)
        .map(function (i) { return i.value.trim(); })
        .filter(function (v) { return v !== ''; });
      let msg = '';
      if (values.length === 0) {
        msg = 'At least one ' + label + ' is required';
      } else if (numericOnly && values.some(function (v) { return !/^\d+$/.test(v); })) {
        msg = label + ' must be selected from the list';
      }
      this.setFieldError(elId, msg);
      this.setFieldStatus(elId, !msg);
      return !msg;
    },

    validateMethod() {
      const checked = document.querySelector('input[name="method"]:checked');
      const msg = checked ? '' : 'Method is required';
      this.setFieldError('method', msg);
      return !!checked;
    },

    validateMultiLang(objKey, prefix, labels) {
      const langs = ['id', 'en', 'ja'];
      const self = this;
      langs.forEach(function (lang) {
        const value = self.formData[objKey][lang] || '';
        const msg = self.nonEmpty(value, labels[lang]);
        self.setFieldError(prefix + '_' + lang, msg);
        self.setFieldStatus(prefix + '_' + lang, !msg);
      });
      return langs.every(function (lang) {
        return (self.formData[objKey][lang] || '').trim() !== '';
      });
    },

    validateLocationLink() {
      const value = this.formData.locationLink || '';
      let msg = this.nonEmpty(value, 'Link Location');
      if (!msg) {
        try {
          new URL(value.trim());
        } catch (e) {
          msg = 'Please enter a valid URL';
        }
      }
      const show = this.submitAttempted || this.touched.locationLink;
      this.formErrors.locationLink = show ? msg : '';
      this.formValid.locationLink = !msg;
      return !msg;
    },

    validateMoneyInput(nameAttr, elId, label, optional) {
      const raw = this.hiddenValue(nameAttr);
      let msg = '';
      if (!raw) {
        if (!optional) msg = label + ' is required';
      } else if (!/^\d+$/.test(raw)) {
        msg = label + ' must contain numbers only';
      }
      this.setFieldError(elId, msg);
      this.setFieldStatus(elId, !msg);
      return !msg;
    },

    validateOptionalUrl(elId, label) {
      const el = document.getElementById(elId);
      if (!el) return true;
      const raw = el.value.trim();
      if (!raw) return true;
      try {
        new URL(raw);
      } catch (e) {
        this.setFieldError(elId, label + ' must be a valid URL');
        this.setFieldStatus(elId, false);
        return false;
      }
      this.setFieldError(elId, '');
      this.setFieldStatus(elId, true);
      return true;
    },

    /* ================= FORM STATE ================= */

    updateCoverValidation(isValid, hasFile) {
      this.coverValid = isValid;
      this.coverHasFile = hasFile;
    },

    validateField(field, valueOrLang) {
      if (field === 'locationLink') {
        this.touched.locationLink = true;
      } else if (field === 'description' || field === 'location') {
        const prefix = field === 'description' ? 'deskripsi' : 'lokasi';
        this.touched[prefix + '_' + valueOrLang] = true;
      }
      this.updateCompleteness();
    },

    onBlurCapture(e) {
      const t = e.target || {};
      if (t.id) this.touched[t.id] = true;
      const gid = this.groupElId(t.name);
      if (gid) this.touched[gid] = true;
      this.updateCompleteness();
    },

    onInputCapture(e) {
      const t = e.target || {};
      if (t.id) this.touched[t.id] = true;
      const gid = this.groupElId(t.name);
      if (gid) this.touched[gid] = true;
      this.updateCompleteness();
    },

    groupElId(nameAttr) {
      const map = {
        'materialsId[]': 'materis_id',
        'materialsEn[]': 'materis_en',
        'materialsJa[]': 'materis_ja',
        'learningTargetsId[]': 'targets_id',
        'learningTargetsEn[]': 'targets_en',
        'learningTargetsJa[]': 'targets_ja',
        'criteriaId[]': 'criterias_id',
        'criteriaEn[]': 'criterias_en',
        'criteriaJa[]': 'criterias_ja'
      };
      return (nameAttr && map[nameAttr]) || null;
    },

    trackHiddenChanges() {
      const keys = [
        { name: 'categoryId', elId: 'categoryId' },
        { name: 'jenis_kelasId', elId: 'jenis_kelasId' },
        { name: 'mentoringsId', elId: 'mentoringId' }
      ];
      const self = this;
      keys.forEach(function (k) {
        const value = self.hiddenValue(k.name);
        const last = self._lastHidden[k.name];
        if (value !== last) {
          if (value) self.touched[k.elId] = true;
          self._lastHidden[k.name] = value;
        }
      });
    },

    scheduleUpdate() {
      clearTimeout(this._scheduleTimer);
      const self = this;
      this._scheduleTimer = setTimeout(function () {
        self.updateCompleteness();
      }, 50);
    },

    updateCompleteness() {
      this.trackHiddenChanges();
      this.formComplete = this.canSubmit();
    },

    hasVisibleErrors() {
      return Object.values(this.fieldStatus).some(function (s) { return s === 'error'; });
    },

    /* ================= SUBMIT GATE ================= */

    canSubmit() {
      const results = [];

      // Cover image: on edit the old photo stays when no new file is chosen
      results.push(!(this.coverHasFile && !this.coverValid));

      // Basic text fields
      results.push(this.validateTextField('name', 'Program Name'));
      results.push(this.validateTextField('group', 'Group'));
      results.push(this.validateMultiLang('description', 'deskripsi', {
        id: 'Indonesian description',
        en: 'English description',
        ja: 'Japanese description'
      }));
      results.push(this.validateMultiLang('location', 'lokasi', {
        id: 'Location (ID)',
        en: 'Location (EN)',
        ja: 'Location (JP)'
      }));
      results.push(this.validateMethod());

      // Dropdowns / chips
      results.push(this.validateDropdown('categoryId', 'categoryId', 'Category'));
      results.push(this.validateDropdown('jenis_kelasId', 'jenis_kelasId', 'Program Type'));
      results.push(this.validateList('technologiesIds[]', 'technologies', 'technology', true));

      // Mentoring only exists for super_admin
      if (document.querySelector('input[name="mentoringsId"]')) {
        results.push(this.validateDropdown('mentoringsId', 'mentoringId', 'Mentoring'));
      }

      // super_admin-only pricing fields
      if (document.getElementById('harga1')) {
        results.push(this.validateMoneyInput('price', 'harga1', 'Price', false));
      }
      if (document.getElementById('promo1')) {
        results.push(this.validateMoneyInput('promo', 'promo1', 'Promo', true));
      }
      if (document.getElementById('kuota1')) {
        results.push(this.validateMoneyInput('quota', 'kuota1', 'Program Quota', false));
      }

      // Conditional schedule: month (paid) OR day + time (free)
      if (this.paidClass) {
        results.push(this.validateNumberField('month', 'Month', 1, 12));
        this.clearField('day');
        this.clearField('time_start');
        this.clearField('time_end');
      } else {
        results.push(this.validateNumberField('day', 'Day', 1, 31));
        this.clearField('month');
        results.push(this.validateTimeFields());
      }

      // Dates
      results.push(this.validateDateField('date_registration', 'Date Registration'));
      results.push(this.validateDateField('startDate', 'Start Date'));
      results.push(this.validateDateField('endDate', 'End Date', 'startDate', 'Start Date'));

      // Optional registration form link (super_admin free program)
      if (document.getElementById('form')) {
        results.push(this.validateOptionalUrl('form', 'Registration Form Link'));
      }

      // Link location
      results.push(this.validateLocationLink());

      // Dynamic lists: at least one entry per language
      results.push(this.validateList('materialsId[]', 'materis_id', 'lesson (ID)'));
      results.push(this.validateList('materialsEn[]', 'materis_en', 'lesson (EN)'));
      results.push(this.validateList('materialsJa[]', 'materis_ja', 'lesson (JP)'));
      results.push(this.validateList('learningTargetsId[]', 'targets_id', 'learning target (ID)'));
      results.push(this.validateList('learningTargetsEn[]', 'targets_en', 'learning target (EN)'));
      results.push(this.validateList('learningTargetsJa[]', 'targets_ja', 'learning target (JP)'));
      results.push(this.validateList('criteriaId[]', 'criterias_id', 'criteria (ID)'));
      results.push(this.validateList('criteriaEn[]', 'criterias_en', 'criteria (EN)'));
      results.push(this.validateList('criteriaJa[]', 'criterias_ja', 'criteria (JP)'));

      return results.every(Boolean);
    },

    hasFormErrors() {
      return !this.formComplete;
    }
  };
}
</script>

<div class='py-10'>
  <div
    class='max-w-4xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data='programData("edit")'
    x-init="
      paidClass = {{#if course.checkPaid}}true{{else}}false{{/if}};
      formData.description = { id: '{{course.description.id}}', en: '{{course.description.en}}', ja: '{{course.description.ja}}' },
      formData.location = { id: '{{course.locations.[id]}}', en: '{{course.locations.[en]}}', ja: '{{course.locations.[ja]}}' },
      formData.locationLink = '{{course.locationLink}}',
      $nextTick(() => scheduleUpdate());
      setTimeout(() => scheduleUpdate(), 400);
    "
  >
    <h2 class='text-3xl font-bold mb-8 text-gray-900 text-center'>Edit Program</h2>

    <form
      method='POST'
      action='/program/{{course.id}}?_method=PATCH'
      enctype='multipart/form-data'
      class='grid grid-cols-1 lg:grid-cols-2 gap-8'
      @submit.prevent="if (canSubmit()) { loading = true; $el.submit(); } else { submitAttempted = true; updateCompleteness(); }"
      @input.capture="onInputCapture($event)"
      @change="updateCompleteness()"
      @click="scheduleUpdate()"
      @focusout.capture="onBlurCapture($event)"
    >

      <!-- LEFT COLUMN -->
      <div class='space-y-6'>
{{> admin/program/edit/left_column/cover_input}}

{{> admin/program/edit/left_column/name_program_input}}

{{> admin/program/edit/left_column/group_input}}

{{> admin/program/edit/left_column/description_input}}

{{> admin/program/edit/left_column/metode_input}}

{{> admin/program/edit/left_column/location_input}}

{{> admin/program/edit/left_column/link_location_input}}

{{> admin/program/edit/left_column/toggle_input}}
      </div>

      <!-- RIGHT COLUMN -->
      <div class='space-y-6'>
{{> admin/program/edit/right_column/category_input}}

{{> admin/program/edit/right_column/type_input}}

{{> admin/program/edit/right_column/month_input}}

{{> admin/program/edit/right_column/day_input}}

{{> admin/program/edit/right_column/time_start_input}}

{{> admin/program/edit/right_column/time_end_input}}

{{> admin/program/edit/right_column/date_registration_input}}

{{> admin/program/edit/right_column/start_date_input}}

{{> admin/program/edit/right_column/end_date_input}}

{{> admin/program/edit/right_column/mentor_input}}

{{> admin/program/edit/right_column/technology_input}}

{{> admin/program/edit/right_column/lessons_input}}

{{> admin/program/edit/right_column/learning_input}}

{{> admin/program/edit/right_column/criteria_input}}
      </div>

      <!-- BUTTONS - Full Width -->
      <div class='lg:col-span-2 space-y-4'>
        <!-- Cover Warning -->
        <template x-if='coverHasFile && !coverValid'>
          <div
            class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-triangle text-red-500'></i>
            <p class='text-sm text-red-800'>
              <span class='font-semibold'>Cannot submit:</span>
              Please fix the cover image validation errors above.
            </p>
          </div>
        </template>

        <!-- Submit Warning -->
        <template x-if='hasVisibleErrors()'>
          <div
            class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-triangle text-red-500'></i>
            <p class='text-sm text-red-800'>
              <span class='font-semibold'>Cannot submit:</span>
              Please fix all validation errors above.
            </p>
          </div>
        </template>
      </div>

      <div class='flex space-x-4'>
        <button
          type='submit'
          :disabled='!formComplete || loading'
          :class="!formComplete || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-600'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span x-show='loading' class='loading loading-spinner loading-sm'></span>
          <span x-show='!loading'>Update</span>
        </button>
        <a
          href='/program/detail/program/admin/{{course.id}}'
          :disabled='loading'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>
