{{!--
  Page: Admin — Portfolio Guide Detail
  Path: admin/course/detail_portfolio_guide.hbs
  Route: GET /program/portfolio-guide/detail/:courseId — data: { course, guide }
  Card header: back link, title + Delete (openDeleteModal) + Edit Guide
  Card content: content-preview (HTML/jsonb) dari portfolio guide
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='box-border w-full max-w-[1052px] mx-auto flex flex-col gap-[16px] justify-start items-start'>

    {{!-- Feature Card - Portfolio Guide Header --}}
    <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[14px] p-[20px] justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px]'>

      {{!-- Back Row --}}
      <div class='w-full flex flex-row justify-between items-center'>
        <a href='/program/detail/program/admin/{{course.id}}'
          class='flex flex-row gap-[4px] justify-start items-center hover:opacity-70 transition-opacity'
          title='Back' aria-label='Back'>
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#718096' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'><polyline points='15 18 9 12 15 6'/></svg>
          <span class='text-[16px]/[normal] text-[#718096] font-inter font-medium'>Back</span>
        </a>
      </div>

      {{!-- Title Row --}}
      <div class='w-full flex flex-col sm:flex-row gap-[12px] justify-between items-stretch sm:items-start'>
        <div class='flex flex-col gap-[4px] flex-1 min-w-0 justify-start items-start'>
          <div class='flex items-center gap-[10px]'>
            <span class='flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] bg-[#DCEAFF] text-[#245A9C]'>
              <i class='fa-solid fa-briefcase'></i>
            </span>
            <div class='text-[34px]/[normal] text-[#003060] font-inter font-bold text-left'>Portfolio Guide</div>
          </div>
          <div class='font-inter text-[14px] leading-[20px] text-[#737373]'>{{course.name}}</div>
        </div>

        {{!-- Actions --}}
        {{#unless portfolioGuideLocked}}
        <div class='flex flex-row flex-wrap gap-[12px] shrink-0 justify-start items-center'>
          <form action='/program/portfolio-guide/{{course.id}}?_method=DELETE' method='POST'>
            <button type='button'
              onclick='openDeleteModal(this)'
              class='box-border h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FEF2F2] rounded-[8px] [outline:1px_solid_#FCA5A5] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#FEE2E2] transition-colors'
              title='Delete Portfolio Guide' aria-label='Delete Portfolio Guide'>
              <span class='text-[16px]/[normal] text-[#EF4444] font-inter font-semibold whitespace-nowrap'>Delete</span>
            </button>
          </form>
          <a href='/program/portfolio-guide/{{course.id}}'
            class='box-border h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#003060] rounded-[8px] [outline:1px_solid_#003060] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#00254a] transition-colors'
            title='Edit Portfolio Guide' aria-label='Edit Portfolio Guide'>
            <span class='text-[16px]/[normal] text-[#FFFFFF] font-inter font-semibold whitespace-nowrap'>Edit Guide</span>
          </a>
        </div>
        {{/unless}}
      </div>

      {{#if portfolioGuideLocked}}
        {{> components/ui/admin/locked-notice/index
          title='Portfolio guide is locked'
          message='This portfolio guide cannot be edited or deleted because participants have already uploaded their portfolios.' }}
      {{/if}}

    </div>

    {{!-- Content Card --}}
    <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[16px] justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px] p-[20px]'>
      {{> components/ui/content-preview/index content=guide.content emptyMessage="No portfolio guide content yet."}}
    </div>

  </div>
</div>

{{!-- Toast sukses untuk proses create/update portfolio guide yang redirect ke sini. --}}
{{> components/ui/admin/toast/success/index toast=toast }}

{{> components/ui/admin/modal/delete_confirm/index
    title='Delete Portfolio Guide'
    description='Are you sure you want to delete this portfolio guide? Participants will no longer see the guide.'
    confirmLabel='Delete' }}
