{{!--
  Page: Admin — Detail Program (Non Bootcamp / Syllabus)
  Path: admin/course/detail_syllabus.hbs
  Route: GET /program/detail/program/admin/:courseId (detailKelas)
  Data kontrak: { course, categoryId?, user, lastWeek, caps, containerWeek }
  Layout: card hero + card basic info + duo form/capacity + card learning + tab section (Sylabus & User)
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='box-border w-full max-w-[1052px] mx-auto flex flex-col gap-[16px] justify-start items-start'>

    {{!-- 5 card baru --}}
    {{> components/ui/admin/detail/hero/index showDelete=true isSyllabus=true}}
    {{> components/ui/admin/detail/basic_info/index}}
    <div class='w-full flex flex-col lg:flex-row gap-[16px] justify-start items-stretch'>
      <div class='flex-1 min-w-0'>{{> components/ui/admin/detail/form_info/index}}</div>
      <div class='flex-1 min-w-0'>{{> components/ui/admin/detail/capacity/index}}</div>
    </div>
    {{> components/ui/admin/detail/learning/index}}

    {{!-- Table Detail Program: 1052px bg-white border border-[#D9D9D9] rounded-12 p-[12px_20px_20px] gap-20 --}}
    <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[20px] justify-start items-start bg-[#FFFFFF] border border-[#D9D9D9] rounded-[12px] p-[12px_20px_20px_20px]' x-data="tabData()" x-init="init()">

      {{!-- Frame 2147229577: Tab Navigation bar (w-full h-[41px] border-b border-[#D9D9D9]) --}}
      <div class='box-border w-full h-[41px] flex flex-row items-start p-0 border-b border-[#D9D9D9] overflow-x-auto'>
        {{!-- Container: Tab Sylabus (116x40 p-[10px_28px] gap-4, active border-b-2 #003060) --}}
        <button type='button'
          @click="toggleFetch('/syllabus/course/{{course.id}}', 'sylabus')"
          :class="tab === 'sylabus' ? 'border-b-2 border-[#003060]' : 'border-b-2 border-transparent'"
          class='shrink-0 h-[40px] flex flex-row justify-center items-start px-[28px] py-[10px] gap-[4px] font-inter font-semibold text-[14px] leading-[20px] text-[#003060] whitespace-nowrap hover:bg-[#F5F5F5] transition-colors'>
          Sylabus
        </button>

        {{!-- Container: Tab User (89x40 p-[10px_28px] gap-4) --}}
        <button type='button'
          @click="toggleFetch('/program/userProgram/{{course.id}}', 'user')"
          :class="tab === 'user' ? 'border-b-2 border-[#003060]' : 'border-b-2 border-transparent'"
          class='shrink-0 h-[40px] flex flex-row justify-center items-start px-[28px] py-[10px] gap-[4px] font-inter font-semibold text-[14px] leading-[20px] text-[#003060] whitespace-nowrap hover:bg-[#F5F5F5] transition-colors'>
          User
        </button>

        {{!-- Container: Tab Final Assignment (183x40 p-[10px_28px] gap-4, active border-b-2 #003060) --}}
        <button type='button'
          @click="toggleFetch('/syllabus/course/{{course.id}}', 'final_assignment')"
          :class="tab === 'final_assignment' ? 'border-b-2 border-[#003060]' : 'border-b-2 border-transparent'"
          class='shrink-0 h-[40px] flex flex-row justify-center items-start px-[28px] py-[10px] gap-[4px] font-inter font-semibold text-[14px] leading-[20px] text-[#003060] whitespace-nowrap hover:bg-[#F5F5F5] transition-colors'>
          Final Assignment
        </button>
      </div>

      {{!-- Tab Content Areas --}}
      <div x-show="tab === 'sylabus'" class='w-full' x-data="sylabusData()" x-init="fetchSylabus()">{{> course/sylabus_tab }}</div>
      <div x-show="tab === 'user'" class='w-full' x-data="userData()" x-init="fetchUsers()">{{> course/user_tab}}</div>
      <div x-show="tab === 'final_assignment'" class='w-full' x-data="finalAssignmentData()" x-init="fetchFinalAssignment()">{{> course/final_assignment_tab}}</div>

    </div>

  </div>
</div>

<script>
function tabData() {
  return {
    search: '',
    tab: localStorage.getItem('activeTabNonBootcamp') || 'sylabus',
    data: [],
    async init() {
      if(!this.tab || (this.tab !== 'sylabus' && this.tab !== 'user' && this.tab !== 'final_assignment')) {
        this.tab = 'sylabus';
        localStorage.setItem('activeTabNonBootcamp', 'sylabus');
      }
    },
    async toggleFetch(url, tabName) {
      this.tab = tabName;
      localStorage.setItem('activeTabNonBootcamp', tabName);
      this.data = [];
    }
  }
}
</script>

{{!-- Toast sukses --}}
{{> components/ui/admin/toast/success/index toast=toast }}

{{!-- Modal confirm delete --}}
{{> components/ui/admin/modal/delete_confirm/index
    title='Delete Sylabus'
    description='Are you sure you want to delete this sylabus item? Contents inside it will be removed too.'
    confirmLabel='Delete' }}
