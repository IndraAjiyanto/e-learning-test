<div class='py-10'>
  <div
    class='max-w-4xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data='{ 
            coverValid: true,
            coverHasFile: false,
            categorySelected: null,
            paidClass: false,
            formData: { description: { id: "", en: "", ja: "" },
                        lokasi: { id: "", en: "", ja: "" },
                        link_lokasi: "" },
            formErrors: { link_lokasi: "" },
            formValid: { link_lokasi: false },
            updateCoverValidation(isValid, hasFile) {
                this.coverValid = isValid;
                this.coverHasFile = hasFile;
            },
            validateField(field, value) {
                if (field === "link_lokasi") {
                    if (!value.trim()) {
                        this.formErrors.link_lokasi = "Link Location is required";
                        this.formValid.link_lokasi = false;
                    } else {
                        try {
                            new URL(value);
                            this.formErrors.link_lokasi = "";
                            this.formValid.link_lokasi = true;
                        } catch {
                            this.formErrors.link_lokasi = "Please enter a valid URL";
                            this.formValid.link_lokasi = false;
                        }
                    }
                    return;
                }
                const fieldName = `${field}_${value}`;
                const errorElement = document.getElementById(`${fieldName}_error`);
                if (errorElement) {
                    const val = this.formData[field] && this.formData[field][value];
                    if (!val || val.trim() === "") {
                        errorElement.classList.remove("hidden");
                    } else {
                        errorElement.classList.add("hidden");
                    }
                }
            }
        }'
  >
    <h2 class='text-3xl font-bold mb-8 text-gray-900 text-center'>Create Program</h2>

    <form
      method='POST'
      action='/program'
      class='grid grid-cols-1 lg:grid-cols-2 gap-8'
      enctype='multipart/form-data'
      x-data="{loading:false}"
      @submit="loading = true"
    >

      <!-- LEFT COLUMN -->
      <div class='space-y-6'>
{{> admin/program/create/left_column/cover_input}}

{{> admin/program/create/left_column/name_program_input}}

{{> admin/program/create/left_column/group_input}}

{{> admin/program/create/left_column/description_input}}

{{> admin/program/create/left_column/metode_input}}

{{> admin/program/create/left_column/location_input}}

{{> admin/program/create/left_column/link_location_input}}

{{> admin/program/create/left_column/toggle_input}}
      </div>

      <!-- RIGHT COLUMN -->
      <div class='space-y-6'>
{{> admin/program/create/right_column/category_input}}

{{> admin/program/create/right_column/type_input}}

{{> admin/program/create/right_column/month_input}}

{{> admin/program/create/right_column/day_input}}

{{> admin/program/create/right_column/start_date_input}}

{{> admin/program/create/right_column/end_date_input}}

{{> admin/program/create/right_column/mentor_input}}

{{> admin/program/create/right_column/technology_input}}

{{> admin/program/create/right_column/lessons_input}}

{{> admin/program/create/right_column/learning_input}}

{{> admin/program/create/right_column/criteria_input}}
      </div>
      <!-- BUTTONS - Full Width -->
      <div class='lg:col-span-2 space-y-4'>
        <!-- Submit Warning -->
        <template x-if='coverHasFile && !coverValid'>
          <div
            class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-triangle text-red-500'></i>
            <p class='text-sm text-red-800'>
              <span class='font-semibold'>Cannot submit:</span>
              Please fix the cover image validation errors above.
            </p>
          </div>
        </template>

      </div>
      <div class='flex space-x-4'>
        <button
          type='submit'
          :disabled='coverHasFile && !coverValid || loading'
          :class="coverHasFile && !coverValid || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-600'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span x-show="loading" class="loading loading-spinner loading-sm"></span>
          <span x-show="!loading">Create</span>
        </button>
        <a
          href='/program'
          :disabled='loading'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>