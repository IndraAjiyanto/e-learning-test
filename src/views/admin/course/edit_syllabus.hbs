{{!--
  Page: Admin - Edit Syllabus (Syllabus Form)
  Path: admin/course/edit_syllabus.hbs
  Route: GET /syllabus/formEdit/:id (or /program/edit-syllabus/:id)
  Design: Figma node 1867-10965 (EditorJS integrated, robust Alpine isolation)
--}}
{{!-- Bootstrap Data Script for robust escaping --}}
<script id="syllabus_bootstrap_data" type="application/json">
{
  "title": {{{json (default syllabus.title '')}}},
  "description": {{{json (default syllabus.description '')}}},
  "isFinal": {{#if syllabus.isFinal}}true{{else}}false{{/if}},
  "content": {{{json syllabus.content}}}
}
</script>

<div class='min-h-screen bg-[#F3F3F3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px] items-start' x-data="editSyllabusForm()">

    {{!-- Title: Heading + Sub heading --}}
    <div class='box-border w-full flex flex-col gap-[4px] items-start'>
      <h1 class='w-full font-inter font-bold text-[34px] leading-[36px] tracking-[-1px] text-[#003060]'>
        Edit Program Sylabus
      </h1>
      <p class='w-full font-inter font-medium text-[16px] leading-[20px] text-[#718096]'>
        Fill in the information below to edit sylabus
      </p>
    </div>

    <form action="/syllabus/update/{{syllabus.id}}?_method=PATCH" method="POST" @submit.prevent="handleSubmit($event)" class='box-border w-full flex flex-col gap-[16px] items-start'>
      <input type='hidden' name='_method' value='PATCH' />

      {{!-- Feature Card 1: Form Inputs Card --}}
      <div class='box-border w-full bg-[#FFFFFF] border border-[#D9D9D9] rounded-[12px] p-[20px] flex flex-col gap-[20px] items-start'>

        {{!-- Title Input Container --}}
        <div class='box-border w-full flex flex-col gap-[8px] items-start'>
          <label for='syllabus_title' class='w-full font-inter font-medium text-[14px] leading-[20px] text-[#404040]'>
            Title*
          </label>
          <div class='box-border w-full h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[14px] py-[10px] flex flex-row items-center gap-[8px] focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
            <input
              id='syllabus_title'
              name='title'
              type='text'
              x-model='title'
              required
              placeholder='Enter title...'
              class='w-full h-[24px] font-inter font-normal text-[16px] leading-[24px] text-[#171717] placeholder-[#737373] bg-transparent border-none outline-none p-0 focus:ring-0 focus:outline-none'
            />
          </div>
        </div>

        {{!-- Description Input Container --}}
        <div class='box-border w-full flex flex-col gap-[8px] items-start'>
          <label for='syllabus_description' class='w-full font-inter font-medium text-[14px] leading-[20px] text-[#404040]'>
            Description*
          </label>
          <div class='box-border w-full h-[128px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[14px] py-[10px] flex flex-row items-start gap-[8px] focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
            <textarea
              id='syllabus_description'
              name='description'
              x-model='description'
              required
              rows='4'
              placeholder='Enter description...'
              class='w-full h-[108px] font-inter font-normal text-[16px] leading-[24px] text-[#171717] placeholder-[#737373] bg-transparent border-none outline-none p-0 resize-none focus:ring-0 focus:outline-none'
            ></textarea>
          </div>
        </div>

        {{!-- Content EditorJS Input Container (Figma node 1868-11653) --}}
        <div class='box-border w-full flex flex-col gap-[8px] items-start'>
          <label class='w-full font-inter font-medium text-[14px] leading-[20px] text-[#404040]'>
            Content*
          </label>
          <div class='box-border w-full min-h-[160px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] p-[10px_14px] focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
            {{!-- x-ignore prevents Alpine from re-scanning and breaking EditorJS event listeners --}}
            <div id='syllabus_editorjs' x-ignore class='w-full font-inter text-[16px] leading-[24px] text-[#171717] pl-8 sm:pl-10'></div>
          </div>
          <input type='hidden' name='content' id='syllabus_content_input' />
        </div>

      </div>

      {{!-- Feature Card 2: Actions Bar --}}
      <div class='box-border w-full min-h-[86px] bg-[#FFFFFF] border border-[#D9D9D9] rounded-[12px] p-[20px] flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-[16px] sm:gap-[24px]'>
        {{!-- Toggle Row: isFinal like week (only for the last syllabus or single syllabus) --}}
        {{#if (or (eq syllabus.syllabusNumber maxSyllabus) (eq maxSyllabus 0) (not maxSyllabus))}}
        <div class='flex flex-row gap-[10px] justify-start items-center min-w-0'>
          {{> components/ui/admin/form/toggle-switch
            checkedBind="isFinal"
            onChange="isFinal = $event.target.checked"
          }}
          <span class='text-[14px]/[normal] text-[#171717] font-inter font-semibold sm:whitespace-nowrap'>Jadikan pertemuan terakhir</span>
          <input type='hidden' name='isFinal' :value="isFinal ? 'true' : 'false'" />
        </div>
        {{else}}
        <div class='flex flex-row gap-[10px] justify-start items-center min-w-0'>
          <input type='hidden' name='isFinal' value='false' />
        </div>
        {{/if}}

        {{!-- Button Row --}}
        <div class='flex flex-row items-center justify-end gap-[12px]'>
          {{!-- Cancel button --}}
          <button
            type='button'
            @click='handleCancel()'
            class='box-border w-[90px] h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#F5F5F5] transition-colors'>
            <span class='font-inter font-semibold text-[16px] leading-[24px] text-[#003060]'>
              Cancel
            </span>
          </button>

          {{!-- Edit Sylabus submit button --}}
          <button
            type='submit'
            :disabled='loading'
            class='box-border min-w-[147px] h-[44px] bg-[#003060] border border-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#002244] disabled:opacity-70 transition-colors'>
            <span x-show='!loading' class='font-inter font-semibold text-[16px] leading-[24px] text-[#FFFFFF]'>
              Edit Sylabus
            </span>
            <span x-show='loading' style='display: none;' class='font-inter font-semibold text-[16px] leading-[24px] text-[#FFFFFF] flex items-center gap-2'>
              <svg class='animate-spin h-4 w-4 text-white' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24'>
                <circle class='opacity-25' cx='12' cy='12' r='10' stroke='currentColor' stroke-width='4'></circle>
                <path class='opacity-75' fill='currentColor' d='M4 12a8 8 0 018-8v8H4z'></path>
              </svg>
              Updating...
            </span>
          </button>
        </div>
      </div>

    </form>
  </div>
</div>

<script>
function editSyllabusForm() {
  let bootstrapData = { title: '', description: '', isFinal: false, content: null };
  try {
    const rawBootstrap = document.getElementById('syllabus_bootstrap_data')?.textContent;
    if (rawBootstrap) {
      bootstrapData = JSON.parse(rawBootstrap);
    }
  } catch (e) {
    console.error('[Syllabus] Failed to parse bootstrap data:', e);
  }

  return {
    title: bootstrapData.title || '',
    description: bootstrapData.description || '',
    loading: false,
    isFinal: !!bootstrapData.isFinal,
    editorInstance: null,
    initialContent: bootstrapData.content,

    init() {
      let isInitializing = false;
      const initEditor = () => {
        if (isInitializing) return;
        if (!window.EditorJS || !window.EditorTools) {
          setTimeout(initEditor, 100);
          return;
        }
        isInitializing = true;
        const holder = document.getElementById('syllabus_editorjs');
        if (holder) holder.innerHTML = '';

        if (this.editorInstance && typeof this.editorInstance.destroy === 'function') {
          try { this.editorInstance.destroy(); } catch (e) {}
        }

        try {
          this.editorInstance = new window.EditorJS({
            holder: 'syllabus_editorjs',
            placeholder: 'Type "/" for commands...',
            data: this.editorInitialData(),
            tools: {
              header: {
                class: window.EditorTools.Header,
                inlineToolbar: ['link']
              },
              paragraph: {
                class: window.EditorTools.Paragraph,
                inlineToolbar: true,
              },
              list: {
                class: window.EditorTools.List,
                inlineToolbar: true
              },
              marker: {
                class: window.EditorTools.Marker,
                shortcut: 'CMD+SHIFT+M'
              },
              image: {
                class: window.EditorTools.ImageTool,
                config: {
                  endpoints: {
                    byFile: '/course/upload-image',
                    byUrl: '/course/fetch-image'
                  }
                }
              },
              linkTool: {
                class: window.EditorTools.LinkTool,
                config: { endpoint: '/course/fetch-link' }
              }
            }
          });
        } catch (err) {
          console.error('[Syllabus] Failed to init EditorJS in edit:', err);
        }
      };
      initEditor();
    },

    editorInitialData() {
      const raw = bootstrapData.content;
      if (!raw) return undefined;
      try {
        let parsed = typeof raw === 'string' ? JSON.parse(raw) : JSON.parse(JSON.stringify(raw));
        if (typeof parsed === 'string') {
          try { parsed = JSON.parse(parsed); } catch (e) {}
        }
        if (!parsed || !Array.isArray(parsed.blocks)) return undefined;

        parsed.blocks = parsed.blocks.map(function(block) {
          if (!block) return block;
          const b = { ...block };
          if (b.type === 'List') {
            b.type = 'list';
          } else if (b.type === 'checklist') {
            b.type = 'list';
            b.data = b.data || {};
            b.data.style = 'checklist';
          }
          return b;
        });

        return parsed;
      } catch (e) {
        return undefined;
      }
    },

    handleCancel() {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/syllabus/{{syllabus.id}}';
      }
    },

    async handleSubmit(e) {
      if (!this.title.trim()) {
        alert('Title is required');
        return;
      }
      let editorData = null;
      if (this.editorInstance && typeof this.editorInstance.save === 'function') {
        try {
          editorData = await this.editorInstance.save();
        } catch (err) {
          console.error('EditorJS save error:', err);
        }
      }
      const hiddenInput = document.getElementById('syllabus_content_input');
      if (hiddenInput && editorData) {
        hiddenInput.value = JSON.stringify(editorData);
      }
      this.loading = true;
      e.target.submit();
    }
  };
}
</script>

<style>
  #syllabus_editorjs .codex-editor__redactor {
    padding-bottom: 24px !important;
  }
  #syllabus_editorjs .ce-block__content {
    max-width: 100% !important;
  }
  #syllabus_editorjs .ce-toolbar__content {
    max-width: 100% !important;
  }
  #syllabus_editorjs .ce-paragraph {
    font-family: 'Inter', sans-serif !important;
    font-size: 16px !important;
    line-height: 24px !important;
    color: #171717 !important;
  }
  #syllabus_editorjs .ce-paragraph[data-placeholder]:empty::before {
    color: #737373 !important;
    font-weight: 400 !important;
  }
</style>
