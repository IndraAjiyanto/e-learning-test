<div class='min-h-screen bg-[#F3F3F3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='max-w-[1052px] mx-auto flex flex-col gap-[28px] items-start' x-data="createFinalAssignmentForm()">

    <div class='box-border w-full flex flex-col gap-[4px] items-start'>
      <h1 class='w-full font-inter font-bold text-[34px] leading-[36px] tracking-[-1px] text-[#003060]'>
        Create Final Assignment
      </h1>
      <p class='w-full font-inter font-medium text-[16px] leading-[20px] text-[#718096]'>
        Fill in the information below to add new final assignment
      </p>
    </div>

    <form action="/program/create-final-assignment/{{courseId}}" method="POST" @submit.prevent="handleSubmit($event)" class='box-border w-full flex flex-col gap-[16px] items-start'>

      <div class='box-border w-full bg-[#FFFFFF] border border-[#D9D9D9] rounded-[12px] p-[20px] flex flex-col gap-[20px] items-start'>

        <div class='box-border w-full flex flex-col gap-[8px] items-start'>
          <label for='final_assignment_title' class='w-full font-inter font-medium text-[14px] leading-[20px] text-[#404040]'>
            Title*
          </label>
          <div class='box-border w-full h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[14px] py-[10px] flex flex-row items-center gap-[8px] focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
            <input
              id='final_assignment_title'
              name='title'
              type='text'
              x-model='title'
              required
              placeholder='Enter title...'
              class='w-full h-[24px] font-inter font-normal text-[16px] leading-[24px] text-[#171717] placeholder-[#737373] bg-transparent border-none outline-none p-0 focus:ring-0 focus:outline-none'
            />
          </div>
        </div>

        <div class='box-border w-full flex flex-col gap-[8px] items-start'>
          <label for='final_assignment_description' class='w-full font-inter font-medium text-[14px] leading-[20px] text-[#404040]'>
            Description*
          </label>
          <div class='box-border w-full h-[128px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[14px] py-[10px] flex flex-row items-start gap-[8px] focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
            <textarea
              id='final_assignment_description'
              name='description'
              x-model='description'
              required
              rows='4'
              placeholder='Enter description...'
              class='w-full h-[108px] font-inter font-normal text-[16px] leading-[24px] text-[#171717] placeholder-[#737373] bg-transparent border-none outline-none p-0 resize-none focus:ring-0 focus:outline-none'
            ></textarea>
          </div>
        </div>

        <div class='box-border w-full flex flex-col gap-[8px] items-start'>
          <label class='w-full font-inter font-medium text-[14px] leading-[20px] text-[#404040]'>
            Content*
          </label>
          <div class='box-border w-full min-h-[160px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] p-[10px_14px] focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors'>
            <div id='final_assignment_editorjs' x-ignore class='w-full font-inter text-[16px] leading-[24px] text-[#171717] pl-8 sm:pl-10'></div>
          </div>
          <input type='hidden' name='content' id='final_assignment_content_input' />
        </div>

      </div>

      <div class='box-border w-full min-h-[86px] bg-[#FFFFFF] border border-[#D9D9D9] rounded-[12px] p-[20px] flex flex-row justify-end items-center gap-[24px]'>
        <div class='flex flex-row items-center justify-end gap-[12px]'>
          <button
            type='button'
            @click='handleCancel()'
            class='box-border w-[90px] h-[44px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#F5F5F5] transition-colors'>
            <span class='font-inter font-semibold text-[16px] leading-[24px] text-[#003060]'>
              Cancel
            </span>
          </button>

          <button
            type='submit'
            :disabled='loading'
            class='box-border min-w-[226px] h-[44px] bg-[#003060] border border-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] px-[18px] py-[10px] flex items-center justify-center hover:bg-[#002244] disabled:opacity-70 transition-colors'>
            <span x-show='!loading' class='font-inter font-semibold text-[16px] leading-[24px] text-[#FFFFFF]'>
              Create Final Assignment
            </span>
            <span x-show='loading' style='display: none;' class='font-inter font-semibold text-[16px] leading-[24px] text-[#FFFFFF] flex items-center gap-2'>
              <svg class='animate-spin h-4 w-4 text-white' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24'>
                <circle class='opacity-25' cx='12' cy='12' r='10' stroke='currentColor' stroke-width='4'></circle>
                <path class='opacity-75' fill='currentColor' d='M4 12a8 8 0 018-8v8H4z'></path>
              </svg>
              Creating...
            </span>
          </button>
        </div>
      </div>

    </form>
  </div>
</div>

<script>
function createFinalAssignmentForm() {
  return {
    title: '',
    description: '',
    loading: false,
    editorInstance: null,

    init() {
      let isInitializing = false;
      const initEditor = () => {
        if (isInitializing) return;
        if (!window.EditorJS || !window.EditorTools) {
          setTimeout(initEditor, 100);
          return;
        }
        isInitializing = true;
        const holder = document.getElementById('final_assignment_editorjs');
        if (holder) holder.innerHTML = '';

        if (this.editorInstance && typeof this.editorInstance.destroy === 'function') {
          try { this.editorInstance.destroy(); } catch (e) {}
        }

        try {
          this.editorInstance = new window.EditorJS({
            holder: 'final_assignment_editorjs',
            placeholder: 'Type "/" for commands...',
            tools: {
              header: {
                class: window.EditorTools.Header,
                inlineToolbar: ['link']
              },
              paragraph: {
                class: window.EditorTools.Paragraph,
                inlineToolbar: true,
              },
              list: {
                class: window.EditorTools.List,
                inlineToolbar: true
              },
              marker: {
                class: window.EditorTools.Marker,
                shortcut: 'CMD+SHIFT+M'
              },
              image: {
                class: window.EditorTools.ImageTool,
                config: {
                  endpoints: {
                    byFile: '/course/upload-image',
                    byUrl: '/course/fetch-image'
                  }
                }
              },
              linkTool: {
                class: window.EditorTools.LinkTool,
                config: { endpoint: '/course/fetch-link' }
              }
            }
          });
        } catch (err) {
          console.error('[Final Assignment] Failed to init EditorJS:', err);
        }
      };
      initEditor();
    },

    handleCancel() {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/program/detail/program/admin/{{courseId}}';
      }
    },

    async handleSubmit(e) {
      if (!this.title.trim()) {
        alert('Title is required');
        return;
      }
      let editorData = null;
      if (this.editorInstance && typeof this.editorInstance.save === 'function') {
        try {
          editorData = await this.editorInstance.save();
        } catch (err) {
          console.error('EditorJS save error:', err);
        }
      }
      const hiddenInput = document.getElementById('final_assignment_content_input');
      if (hiddenInput && editorData) {
        hiddenInput.value = JSON.stringify(editorData);
      }
      this.loading = true;
      e.target.submit();
    }
  };
}
</script>

<style>
  #final_assignment_editorjs .codex-editor__redactor {
    padding-bottom: 24px !important;
  }
  #final_assignment_editorjs .ce-block__content {
    max-width: 100% !important;
  }
  #final_assignment_editorjs .ce-toolbar__content {
    max-width: 100% !important;
  }
  #final_assignment_editorjs .ce-paragraph {
    font-family: 'Inter', sans-serif !important;
    font-size: 16px !important;
    line-height: 24px !important;
    color: #171717 !important;
  }
  #final_assignment_editorjs .ce-paragraph[data-placeholder]:empty::before {
    color: #737373 !important;
    font-weight: 400 !important;
  }
</style>

