<div class='py-20'>
  <div
    class='max-w-6xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data='{ 
            coverValid: true,
            coverHasFile: false,
            updateCoverValidation(isValid, hasFile) {
                this.coverValid = isValid;
                this.coverHasFile = hasFile;
            },
            canSubmit() {
                if (this.coverHasFile) {
                    return this.coverValid;
                }
                return true;
            }
        }'
  >
    <h2 class='text-3xl font-bold mb-8 text-gray-900 text-center'>Create Class</h2>

    <form
      method='POST'
      action='/kelass'
      class='grid grid-cols-1 lg:grid-cols-2 gap-8'
      enctype='multipart/form-data'
      @submit.prevent="if(canSubmit()) { $el.submit(); } else { alert('Please fix the cover image validation errors before submitting.'); }"
    >

      <!-- LEFT COLUMN -->
      <div class='space-y-6'>
        <!-- Cover -->
        <div
          x-data="{ 
                        previewUrl: null,
                        errorMessage: '',
                        isValid: true,
                        fileName: '',
                        fileSize: 0,
                        imageWidth: 0,
                        imageHeight: 0,
                        hasFile: false,
                        validateImage(file) {
                            if (!file) {
                                this.hasFile = false;
                                $dispatch('cover-validation', { isValid: true, hasFile: false });
                                return;
                            }
                            
                            this.hasFile = true;
                            this.fileName = file.name;
                            this.fileSize = file.size;
                            this.errorMessage = '';
                            this.isValid = true;

                            // Validasi tipe file
                            const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
                            if (!allowedTypes.includes(file.type)) {
                                this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
                                this.isValid = false;
                                this.previewUrl = null;
                                $dispatch('cover-validation', { isValid: false, hasFile: true });
                                return;
                            }

                            // Validasi ukuran file (5MB max berdasarkan multer config umum)
                            const maxSize = 5 * 1024 * 1024; // 5MB
                            if (file.size > maxSize) {
                                this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
                                this.isValid = false;
                                this.previewUrl = null;
                                $dispatch('cover-validation', { isValid: false, hasFile: true });
                                return;
                            }

                            // Validasi dimensi gambar
                            const img = new Image();
                            const objectUrl = URL.createObjectURL(file);
                            
                            img.onload = () => {
                                this.imageWidth = img.width;
                                this.imageHeight = img.height;
                                
                                if (img.width < 1900 || img.width > 1920 || img.height < 1000 || img.height > 1080) {
                                    this.errorMessage = `Image dimensions ${img.width}x${img.height}px. Required: 1900x1000 to 1920x1080 pixels`;
                                    this.isValid = false;
                                    this.previewUrl = null;
                                    URL.revokeObjectURL(objectUrl);
                                    $dispatch('cover-validation', { isValid: false, hasFile: true });
                                } else {
                                    this.previewUrl = objectUrl;
                                    this.isValid = true;
                                    this.errorMessage = '';
                                    $dispatch('cover-validation', { isValid: true, hasFile: true });
                                }
                            };
                            
                            img.onerror = () => {
                                this.errorMessage = 'Failed to load image';
                                this.isValid = false;
                                this.previewUrl = null;
                                URL.revokeObjectURL(objectUrl);
                                $dispatch('cover-validation', { isValid: false, hasFile: true });
                            };
                            
                            img.src = objectUrl;
                        },
                        clearFile() {
                            this.previewUrl = null;
                            this.errorMessage = '';
                            this.isValid = true;
                            this.fileName = '';
                            this.fileSize = 0;
                            this.imageWidth = 0;
                            this.imageHeight = 0;
                            this.hasFile = false;
                            $refs.fileInput.value = null;
                            $dispatch('cover-validation', { isValid: true, hasFile: false });
                        }
                    }"
          @cover-validation.window='updateCoverValidation($event.detail.isValid, $event.detail.hasFile)'
          class='space-y-3'
        >
          <label
            for='gambar'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >
            Cover Class
            <span class='text-xs text-gray-500 font-normal'>(1900x1000 -
              1920x1080px, max 5MB, JPG/PNG)</span>
          </label>
          <input
            type='file'
            id='gambar'
            name='gambar'
            accept='image/jpeg,image/jpg,image/png'
            x-ref='fileInput'
            :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
            @change='validateImage($event.target.files[0])'
          />

          <!-- Error Message -->
          <template x-if='!isValid && errorMessage'>
            <div
              class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <div>
                <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
                <p class='text-xs text-red-700' x-text='errorMessage'></p>
              </div>
            </div>
          </template>

          <!-- Preview with validation success -->
          <template x-if='previewUrl && isValid'>
            <div class='space-y-2'>
              <!-- Success Message -->
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <div class='text-xs text-green-700'>
                  <span class='font-semibold'>Valid image:</span>
                  <span
                    x-text='`${imageWidth}x${imageHeight}px, ${(fileSize / 1024 / 1024).toFixed(2)}MB`'
                  ></span>
                </div>
              </div>

              <!-- Image Preview -->
              <div class='relative w-full max-w-md'>
                <img
                  :src='previewUrl'
                  alt='Preview'
                  class='w-full h-auto object-cover rounded-lg border-2 border-green-500 shadow-sm'
                />

                <button
                  type='button'
                  class='absolute top-2 right-2 bg-red-500 text-white w-8 h-8 rounded-full flex items-center justify-center shadow-lg hover:bg-red-600 transition-colors'
                  @click='clearFile()'
                >
                  <i class='fas fa-times'></i>
                </button>
              </div>
            </div>
          </template>
        </div>

        <!-- Method -->
        <div>
          <span
            class='block text-sm font-semibold text-gray-700 mb-2'
          >Metode</span>
          <div class='grid grid-cols-2 gap-4'>
            <label class='cursor-pointer'>
              <input
                type='radio'
                name='metode'
                value='online'
                class='hidden peer'
              />
              <div
                class='flex items-center justify-center px-4 py-3 border rounded-lg transition peer-checked:border-gray-900 peer-checked:bg-gray-900 peer-checked:text-white'
              >
                <span class='font-semibold'>Online</span>
              </div>
            </label>
            <label class='cursor-pointer'>
              <input
                type='radio'
                name='metode'
                value='offline'
                class='hidden peer'
              />
              <div
                class='flex items-center justify-center px-4 py-3 border rounded-lg transition peer-checked:border-gray-900 peer-checked:bg-gray-900 peer-checked:text-white'
              >
                <span class='font-semibold'>Offline</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Location -->
        <div>
          <label
            for='lokasi'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Location</label>
          <input
            type='text'
            id='lokasi'
            name='lokasi'
            placeholder='Enter location'
            required
            class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          />
        </div>

        <!-- Category -->
        <div>
          <label
            for='kategoriId'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Category</label>
          <select
            name='kategoriId'
            id='kategoriId'
            class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          >
            <option value='' selected disabled>-- Select Category --</option>
            {{#each kategori}}
              <option value='{{id}}'>{{nama_kategori}}</option>
            {{/each}}
          </select>
        </div>

        <!-- Jenis Kelas -->
        <div>
          <label
            for='jenis_kelasId'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Jenis Kelas</label>
          <select
            name='jenis_kelasId'
            id='jenis_kelasId'
            class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          >
            <option value='' selected disabled>-- Select Jenis Kelas --</option>
            {{#each jenis_kelas}}
              <option value='{{id}}'>{{nama_jenis_kelas}}</option>
            {{/each}}
          </select>
        </div>

        <!-- Bulan -->
        <div>
          <label
            for='bulanId'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Bulan</label>
          <select
            name='bulanId'
            id='bulanId'
            class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          >
            <option value='' selected disabled>-- Select Bulan --</option>
            {{#each bulan}}
              <option value='{{id}}'>{{bulan}}</option>
            {{/each}}
          </select>
        </div>

        <!-- Class Name -->
        <div>
          <label
            for='nama_kelas'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Class Name</label>
          <input
            type='text'
            id='nama_kelas'
            name='nama_kelas'
            placeholder='Enter class name'
            required
            class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          />
        </div>

        <!-- Description -->
        <div>
          <label
            for='deskripsi'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Description</label>
          <textarea
            id='deskripsi'
            name='deskripsi'
            rows='4'
            placeholder='Write a brief description...'
            class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          ></textarea>
        </div>

        <!-- Kuota -->
        {{#if (roles user.role 'super_admin')}}
          <div
            x-data="{
                      display: '',
                      value: '',
                      formatKuota(event) {
                          let angka = event.target.value.replace(/\D/g, ''); 
                          this.value = angka;
                          this.display = new Intl.NumberFormat('id-ID').format(angka);
                      }
                  }"
          >
            <label
              for='kuota1'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Kuota Class</label>
            <input
              type='text'
              id='kuota1'
              x-model='display'
              @input='formatKuota($event)'
              placeholder='Enter quota'
              class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
            />
            <input type='hidden' name='kuota' x-model='value' />
          </div>

          <!-- Mentoring -->
          <div>
            <label
              for='mentoringId'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Mentoring</label>
            <select
              name='mentoringId'
              id='mentoringId'
              class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
            >
              <option value='' selected disabled>-- Select Mentoring --</option>
              {{#each mentoring}}
                <option value='{{id}}'>{{username}}</option>
              {{/each}}
            </select>
          </div>
        {{/if}}

        <!-- Paid Class Toggle -->
        <div x-data='{ paidClass: false }' class='space-y-6'>
          <div class='flex items-center gap-3'>
            <label class='relative inline-flex items-center cursor-pointer'>
              <input type='checkbox' x-model='paidClass' class='sr-only' />

              <div
                :class="paidClass ? 'bg-green-500' : 'bg-gray-300'"
                class='w-11 h-6 rounded-full transition-colors'
              ></div>

              <div
                :class="paidClass ? 'translate-x-5' : 'translate-x-0'"
                class='absolute left-1 top-1 w-4 h-4 bg-white rounded-full transition-transform'
              ></div>
            </label>

            <span class='text-sm text-gray-700 font-semibold'>Paid Class</span>

            <input type='hidden' name='paid_check' :value='paidClass' />
          </div>

          {{#if (roles user.role 'super_admin')}}
            <!-- Fields that appear when paid_check is true -->
            <div x-show='paidClass' x-transition class='space-y-6'>
              <!-- Price -->
              <div
                x-data="{
                          display: '',
                          value: '',
                          formatHarga(event) {
                              let angka = event.target.value.replace(/\D/g, ''); 
                              this.value = angka;
                              this.display = new Intl.NumberFormat('id-ID').format(angka);
                          }
                      }"
              >
                <label
                  for='harga1'
                  class='block text-sm font-semibold text-gray-700 mb-1'
                >Price</label>
                <input
                  type='text'
                  id='harga1'
                  x-model='display'
                  @input='formatHarga($event)'
                  placeholder='Enter price'
                  class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
                />
                <input type='hidden' name='harga' x-model='value' />
              </div>

              <!-- Promo -->
              <div
                x-data="{
                          display: '',
                          value: '',
                          formatPromo(event) {
                              let angka = event.target.value.replace(/\D/g, ''); 
                              this.value = angka;
                              this.display = new Intl.NumberFormat('id-ID').format(angka);
                          }
                      }"
              >
                <label
                  for='promo1'
                  class='block text-sm font-semibold text-gray-700 mb-1'
                >Promo</label>
                <input
                  type='text'
                  id='promo1'
                  x-model='display'
                  @input='formatPromo($event)'
                  placeholder='Enter promo price'
                  class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
                />
                <input type='hidden' name='promo' x-model='value' />
              </div>
            </div>

            <!-- Fields that appear when paid_check is false (not active) -->
            <div x-show='!paidClass' x-transition class='space-y-6'>
              <!-- Form -->
              <div
                x-data="{
                          display: '',
                          value: '',
                          formatForm(event) {
                              let angka = event.target.value.replace(/\D/g, ''); 
                              this.value = angka;
                              this.display = new Intl.NumberFormat('id-ID').format(angka);
                          }
                      }"
              >
                <label
                  for='form1'
                  class='block text-sm font-semibold text-gray-700 mb-1'
                >Form</label>
                <input
                  type='text'
                  id='form1'
                  x-model='display'
                  @input='formatForm($event)'
                  placeholder='Enter form value'
                  class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
                />
                <input type='hidden' name='form' x-model='value' />
              </div>
            </div>
          {{/if}}
        </div>
      </div>

      <!-- RIGHT COLUMN -->
      <div class='space-y-6'>
        <!-- Technologies -->
        <div
          x-data="{
          search: '',
          selectedTechs: [],
          showDropdown: false,
          availableTechs: {{json teknologi}},
          get filteredTechs() {
            return this.availableTechs.filter(t => 
              t.nama.toLowerCase().includes(this.search.toLowerCase()) &&
              !this.selectedTechs.find(s => s.id === t.id)
            );
          },
          selectTech(tech) {
            this.selectedTechs.push(tech);
            this.search = '';
            this.showDropdown = false;
          },
          removeTech(techId) {
            this.selectedTechs = this.selectedTechs.filter(t => t.id !== techId);
          }
        }"
          @click.away='showDropdown = false'
        >
          <label
            class='block text-sm font-semibold text-gray-700 mb-2'
          >Technologies</label>

          <!-- Selected Technologies -->
          <div
            class='flex flex-wrap gap-2 mb-3'
            x-show='selectedTechs.length > 0'
          >
            <template x-for='tech in selectedTechs' :key='tech.id'>
              <div
                class='flex items-center gap-2 bg-gray-100 border border-gray-300 rounded-lg px-3 py-2'
              >
                <div
                  class='w-6 h-6 flex items-center justify-center'
                  x-html='tech.svg'
                ></div>
                <span
                  class='text-sm font-medium text-gray-700'
                  x-text='tech.nama'
                ></span>
                <button
                  type='button'
                  @click='removeTech(tech.id)'
                  class='text-red-500 hover:text-red-700 ml-2'
                >
                  <i class='fas fa-times'></i>
                </button>
                <input type='hidden' name='teknologiIds[]' :value='tech.id' />
              </div>
            </template>
          </div>

          <!-- Search Input -->
          <div class='relative'>
            <input
              type='text'
              x-model='search'
              @focus='showDropdown = true'
              @input='showDropdown = true'
              placeholder='Search and select technologies...'
              class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
            />
            <i
              class='fas fa-search absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400'
            ></i>

            <!-- Dropdown -->
            <div
              x-show='showDropdown && filteredTechs.length > 0'
              class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'
            >
              <template x-for='tech in filteredTechs' :key='tech.id'>
                <button
                  type='button'
                  @click='selectTech(tech)'
                  class='w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition text-left border-b border-gray-100 last:border-0'
                >
                  <div
                    class='w-8 h-8 flex items-center justify-center flex-shrink-0'
                    x-html='tech.svg'
                  ></div>
                  <span
                    class='text-sm font-medium text-gray-700'
                    x-text='tech.nama'
                  ></span>
                </button>
              </template>
            </div>
          </div>

          <p class='text-xs text-gray-500 mt-2'>Click to select technologies
            from the list</p>
        </div>

        <!-- Lessons -->
        <div x-data="{ materis: [''] }">
          <label
            class='block text-sm font-semibold text-gray-700 mb-2'
          >Lessons</label>
          <template x-for='(materi, index) in materis' :key='index'>
            <div class='flex items-center gap-3 mb-3'>
              <input
                type='text'
                x-model='materis[index]'
                name='materi[]'
                placeholder='Enter a lesson'
                class='flex-1 border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
              />
              <button
                type='button'
                @click='materis.splice(index,1)'
                x-show='materis.length > 1'
                class='text-red-500 hover:text-red-700 font-bold text-lg w-8 h-8 flex items-center justify-center'
              >
                ✕
              </button>
            </div>
          </template>
          <button
            type='button'
            @click="materis.push('')"
            class='w-full border-2 border-dashed border-gray-300 rounded-lg px-4 py-2 text-gray-500 hover:border-gray-500 hover:text-gray-700 flex items-center justify-center transition'
          >
            + Add Lesson
          </button>
        </div>

        <!-- Learning Targets -->
        <div x-data="{ targets: [''] }">
          <label class='block text-sm font-semibold text-gray-700 mb-2'>Learning
            Targets</label>
          <template x-for='(target, index) in targets' :key='index'>
            <div class='flex items-center gap-3 mb-3'>
              <input
                type='text'
                x-model='targets[index]'
                name='target_pembelajaran[]'
                placeholder='Enter a learning target'
                class='flex-1 border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
              />
              <button
                type='button'
                @click='targets.splice(index,1)'
                x-show='targets.length > 1'
                class='text-red-500 hover:text-red-700 font-bold text-lg w-8 h-8 flex items-center justify-center'
              >
                ✕
              </button>
            </div>
          </template>
          <button
            type='button'
            @click="targets.push('')"
            class='w-full border-2 border-dashed border-gray-300 rounded-lg px-4 py-2 text-gray-500 hover:border-gray-500 hover:text-gray-700 flex items-center justify-center transition'
          >
            + Add Target
          </button>
        </div>

        <!-- Kriteria -->
        <div x-data="{ kriterias: [''] }">
          <label
            class='block text-sm font-semibold text-gray-700 mb-2'
          >Kriteria</label>
          <template x-for='(kriteria, index) in kriterias' :key='index'>
            <div class='flex items-center gap-3 mb-3'>
              <input
                type='text'
                x-model='kriterias[index]'
                name='kriteria[]'
                placeholder='Enter criteria'
                class='flex-1 border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
              />
              <button
                type='button'
                @click='kriterias.splice(index,1)'
                x-show='kriterias.length > 1'
                class='text-red-500 hover:text-red-700 font-bold text-lg w-8 h-8 flex items-center justify-center'
              >
                ✕
              </button>
            </div>
          </template>
          <button
            type='button'
            @click="kriterias.push('')"
            class='w-full border-2 border-dashed border-gray-300 rounded-lg px-4 py-2 text-gray-500 hover:border-gray-500 hover:text-gray-700 flex items-center justify-center transition'
          >
            + Add Criteria
          </button>
        </div>
      </div>

      <!-- BUTTONS - Full Width -->
      <div class='lg:col-span-2 space-y-4'>
        <!-- Submit Warning -->
        <template x-if='coverHasFile && !coverValid'>
          <div
            class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-triangle text-red-500'></i>
            <p class='text-sm text-red-800'>
              <span class='font-semibold'>Cannot submit:</span>
              Please fix the cover image validation errors above.
            </p>
          </div>
        </template>

        <div class='flex space-x-4'>
          <button
            type='submit'
            :disabled='coverHasFile && !coverValid'
            :class="coverHasFile && !coverValid ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-600'"
            class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
          >
            <i class='fas fa-plus-circle'></i>
            Create
          </button>
          <a
            href='/kelass'
            class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
