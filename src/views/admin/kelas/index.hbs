<div class="w-full mx-auto px-6 py-10"
     x-data="kelasTable()"
     x-init="fetchKelas()">

  <div class="mb-6">
    <div class="flex justify-between items-center mb-4">
      <div class="flex items-center gap-2">
        <h2 class="text-3xl font-bold text-gray-900 text-center md:text-left">Program</h2>

        <select
          x-model="alphabetFilter"
          @change="currentPage = 1; fetchKelas()"
          class="border border-gray-300 bg-white text-gray-900 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900"
        >
          <option value="">All</option>
          <template x-for="letter in 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')" :key="letter">
            <option :value="letter" x-text="letter"></option>
          </template>
        </select>
      </div>

      <div class="flex items-center gap-3">
        <div class="relative w-full md:w-64">
          <input
            type="text"
            placeholder="Search program..."
            x-model="searchInput"
            @input="handleSearch()"
            class="border border-gray-300 bg-white text-gray-900 rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-gray-900 w-full"
          />
          <button
            @click="handleSearch()"
            class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-900"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1110.5 3a7.5 7.5 0 016.15 13.65z"/>
            </svg>
          </button>
        </div>

        <a href="/program/create"
           class="bg-gray-900 text-white px-4 py-2 rounded-lg shadow hover:bg-gray-600 transition">
          Create Program
        </a>
      </div>
    </div>
  </div>

  <!-- Table -->
  <div class="overflow-x-auto bg-white shadow-lg rounded-xl">

    <!-- Loading -->
    <div x-show="loading" class="py-12 text-center text-gray-500">
      <i class="fas fa-spinner fa-spin text-2xl"></i>
    </div>

    <table x-show="!loading" class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-100">
        <tr>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">No</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Cover</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Name Program</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Group</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Category Program</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Proses</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Kuota</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Student</th>
          {{#if (roles user.role "super_admin")}}
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Mentor</th>
          {{/if}}
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Launch</th>
          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <template x-for="(kelas, index) in kelasList" :key="kelas.id">
          <tr class="hover:bg-gray-50 transition">
            <td class="px-6 py-4 text-sm text-gray-800" x-text="(currentPage - 1) * size + index + 1"></td>
            <td class="px-6 py-4 text-sm text-gray-800">
              <img :src="kelas.gambar" :alt="kelas.nama_kelas" class="w-full h-full rounded-btn object-cover border" />
            </td>
            <td class="px-6 py-4 text-sm text-gray-800" x-text="kelas.nama_kelas"></td>
            <td class="px-6 py-4 text-sm text-gray-800" x-text="kelas.grup"></td>
            <td class="px-6 py-4 text-sm text-gray-800" x-text="kelas.kategori?.nama_kategori"></td>
            <td class="px-6 py-4 text-sm text-gray-800" x-text="kelas.proses"></td>
            <td class="px-6 py-4 text-sm text-gray-800" x-text="kelas.kuota"></td>
            <td class="px-6 py-4 text-sm text-gray-800" x-text="kelas.user_kelas?.length ?? 0"></td>
            {{#if (roles user.role "super_admin")}}
            <td class="px-6 py-4 text-sm text-gray-800">
              <template x-for="mentor in kelas.mentoring" :key="mentor.id">
                <span x-text="mentor.user?.username + ' '"></span>
              </template>
            </td>
            {{/if}}

            <!-- Toggle Launch -->
<td class="px-6 py-4 text-sm text-gray-800">
  <form :action="'/program/' + kelas.id + '/toggle-launch?_method=PATCH'" method="POST">
    <button type="button"
      @click="confirmAction($el, kelas.launch ? 'Are you sure cancel launch this program?' : 'Are you sure launch this program?')"
      :class="kelas.launch ? 'bg-green-500' : 'bg-gray-300'"
      class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none">
      <span
        :class="kelas.launch ? 'translate-x-6' : 'translate-x-1'"
        class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform">
      </span>
    </button>
  </form>
</td>

            <!-- Action -->
            <td class="px-6 py-4 text-sm text-gray-800 flex items-center gap-3">
              <a :href="'/program/detail/program/admin/' + kelas.id"
                 @click.prevent="localStorage.setItem('kelasPrevUrl', window.location.href); window.location.href = '/program/detail/program/admin/' + kelas.id"
                 class="p-2 rounded-full bg-indigo-50 text-indigo-600 hover:bg-indigo-100 hover:text-indigo-800 transition" title="View Kelas">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
  <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
</svg>
              </a>

              <a :href="'/program/addUser/' + kelas.id"
                 class="p-2 rounded-full bg-green-50 text-green-600 hover:bg-green-100 hover:text-green-800 transition" title="View Murid">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.388 9.388 0 01-6 0M4.5 9a4.5 4.5 0 109 0 4.5 4.5 0 00-9 0zm15 0a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z" />
                </svg>
              </a>
            </td>
          </tr>
        </template>

        <!-- Empty -->
        <tr x-show="!loading && kelasList.length === 0">
          <td colspan="11" class="px-6 py-12 text-center text-gray-400">No program found.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <div class="w-full md:w-1/2 mx-auto py-6 flex justify-center gap-2 items-center" x-show="totalPages > 1">
    <button @click="changePage(currentPage - 1)" :disabled="currentPage === 1"
      class="px-3 py-1 rounded border border-gray-900 text-gray-900"
      :class="{ 'opacity-50 cursor-not-allowed': currentPage === 1 }">Prev</button>

    <template x-for="page in totalPages" :key="page">
      <button @click="changePage(page)"
        class="px-3 py-1 rounded"
        :class="{ 'bg-gray-900 text-white font-bold': page === currentPage }"
        x-text="page">
      </button>
    </template>

    <button @click="changePage(currentPage + 1)" :disabled="currentPage === totalPages"
      class="px-3 py-1 rounded border border-gray-900 text-gray-900"
      :class="{ 'opacity-50 cursor-not-allowed': currentPage === totalPages }">Next</button>
  </div>
</div>

<script>
function kelasTable() {
  return {
    kelasList: [],
    searchInput: '',
    alphabetFilter: '',
    currentPage: 1,
    totalPages: 1,
    totalItems: 0,
    size: 5,
    loading: false,
    searchTimeout: null,

    async fetchKelas() {
      this.loading = true;
      try {
        const params = new URLSearchParams();
        if (this.searchInput.trim()) params.set('search', this.searchInput.trim());
        if (this.alphabetFilter) params.set('alphabet', this.alphabetFilter);
        params.set('page', this.currentPage);
        params.set('limit', this.size);

        const res = await fetch(`/program/filter?${params.toString()}`);
        const json = await res.json();

        this.kelasList = json.data;
        this.totalItems = json.totalItems;
        this.totalPages = json.totalPages;
        this.currentPage = json.currentPage;
      } catch (err) {
        console.error('Fetch kelas error:', err);
      } finally {
        this.loading = false;
      }
    },

    handleSearch() {
      clearTimeout(this.searchTimeout);
      this.searchTimeout = setTimeout(() => {
        this.currentPage = 1;
        this.fetchKelas();
      }, 300);
    },

    async changePage(page) {
      if (page < 1 || page > this.totalPages) return;
      this.currentPage = page;
      await this.fetchKelas();
    },
  }
}
</script>