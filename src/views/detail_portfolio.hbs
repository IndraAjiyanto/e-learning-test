<div class=" pb-20 min-h-screen bg-[#F9FAFB] font-inter">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Back to Portfolio List -->
    <div class="mb-6 pt-5">
      <a
        href="/dashboard/portofolios"
        class="inline-flex items-center gap-2 font-inter font-medium text-sm sm:text-base text-[#003060] hover:text-[#001f3f] transition-colors cursor-pointer"
      >
        <i class="fa-solid fa-arrow-left text-sm"></i>
        <span>{{t "test.detailPortfolio.backToList"}}</span>
      </a>
    </div>

    <!-- Top Header: Eyebrow Badge & Title -->
    {{> portfolio/detail/header}}

    <!-- Showcase Image Gallery -->
    {{> portfolio/detail/gallery}}

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left Column: Description & Overview -->
      <div class="lg:col-span-2">
        {{> portfolio/detail/content}}
      </div>

      <!-- Right Column: Sidebar Meta Info & CTA -->
      <div class="lg:col-span-1">
        {{> portfolio/detail/sidebar}}
      </div>

    </div>

  </div>
</div>