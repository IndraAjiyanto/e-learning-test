                    class='w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center flex-shrink-0 group-hover/item:bg-slate-200 transition-colors'
                    :class="selectedMethod === method.value ? 'bg-slate-700 text-white' : 'text-slate-700'"
