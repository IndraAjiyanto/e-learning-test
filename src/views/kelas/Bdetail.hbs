<script>
  function kelasPagination() { return { currentPage: 1, itemsPerPage: 6, // Data
  kelas dari server (dikonversi dari Handlebars) allKelas: [
  {{#each kelass}}
    { id:
    {{id}}, nama_kelas: "{{nama_kelas}}", deskripsi: "{{deskripsi}}", gambar: "{{gambar}}",
    harga:
    {{harga}}, promo:
    {{promo}}, kategori: { nama_kategori: "{{kategori.nama_kategori}}" },
    jenis_kelas: { nama_jenis_kelas: "{{jenis_kelas.nama_jenis_kelas}}" } }{{#unless
      @last
    }},{{/unless}}
  {{/each}}
  ], get displayedKelas() { return this.allKelas; }, get totalPages() { return
  Math.ceil(this.allKelas.length / this.itemsPerPage); }, isVisible(index) {
  const startIndex = (this.currentPage - 1) * this.itemsPerPage; const endIndex
  = startIndex + this.itemsPerPage; return index >= startIndex && index <
  endIndex; }, nextPage() { if (this.currentPage < this.totalPages) {
  this.currentPage++; this.scrollToTop(); } }, previousPage() { if
  (this.currentPage > 1) { this.currentPage--; this.scrollToTop(); } },
  scrollToTop() { const element = document.querySelector('[x-ref="kelasList"]');
  if (element) { element.scrollIntoView({ behavior: 'smooth', block: 'start' });
  } }, // Fungsi formatRupiah untuk Alpine.js formatRupiah(angka) { if (!angka)
  return 'Rp 0'; const number_string = angka.toString(); const sisa =
  number_string.length % 3; let rupiah = number_string.substr(0, sisa); const
  ribuan = number_string.substr(sisa).match(/\d{3}/g); if (ribuan) { const
  separator = sisa ? '.' : ''; rupiah += separator + ribuan.join('.'); } return
  'Rp ' + rupiah; } }; }
</script>