                    ></span>
                  </button>
                </form>
              {{/if}}
            {{else}}
              {{#if (check daftar kelas.kuota)}}
                <!-- Free Class Registration Form -->
                <form
                  action="/pendaftaran/{{user.id}}/{{kelas.id}}"
                  enctype='multipart/form-data'
                  method='post'
                  class='space-y-4'
                >
                  <!-- Free Registration Badge -->
                  <div
                    class='bg-gradient-to-r from-emerald-100 to-green-100 border-2 border-emerald-300 rounded-xl p-4'
                  >
                    <div class='flex items-center justify-center gap-3'>
                      <i class='fas fa-gift text-emerald-600 text-2xl'></i>
                      <div>
                        <p
                          class='text-xs font-semibold text-emerald-600 uppercase'
                        >Registration Type</p>
                        <p class='text-sm font-bold text-emerald-800'>Free Class
                          - No Payment Required</p>
                      </div>
                    </div>
                  </div>

                  <div>
