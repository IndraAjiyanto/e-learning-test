<div class='min-h-screen text-slate-900 px-6 py-10 pt-28' style="background: linear-gradient(180deg, #FAFAFA 0%, #CEE5F6 15%, #FAFAFA 100%);">
  <div class='max-w-7xl mx-auto px-2 py-2'>

    <!-- Tombol Kembali -->
    <button onclick="history.back()" class="flex items-center justify-center w-10 h-10 rounded-full border border-[#0B1F3B]/30 hover:bg-[#0B1F3B]/10 transition mb-8 text-[#0B1F3B]">
      <i class="fas fa-arrow-left"></i>
    </button>

    <div x-data="{
        participants: null, what_you_learn: null, benefits: null, learning_flow: null,
        schedule_fees: null, gallery: null, faq: null, lang: '{{lang}}',
        loading: { participants: false, what_you_learn: false, benefits: false, learning_flow: false, schedule_fees: false, gallery: false, faq: false },
        fetched: { participants: false, what_you_learn: false, benefits: false, learning_flow: false, schedule_fees: false, gallery: false, faq: false },
        async init() {
            // Fetch all async tabs on load
            await Promise.all([
                this.fetchTab('benefits'),
                this.fetchTab('faq'),
                this.fetchTab('learning_flow')
            ]);
        },
        get snakeFlow() {
            const items = this.learning_flow?.alur_kelas || [];
            const rows = [];
            for (let i = 0; i < items.length; i += 6) {
                let row = items.slice(i, i + 6);
                if ((i / 6) % 2 !== 0) {
                    row = row.slice().reverse();
                }
                rows.push(row);
            }
            return rows;
        },
        async fetchTab(tab) {
          if (this.fetched[tab]) return;
          this.loading[tab] = true;
          try {
            const map = { benefits: '/program/api/detail/{{kelas.id}}/benefit', faq: '/program/api/detail/{{kelas.id}}/faq', learning_flow: '/program/api/detail/{{kelas.id}}/flow' };
            if(map[tab]) {
                const res = await fetch(map[tab]);
                const json = await res.json();
                this[tab] = json;
                this.fetched[tab] = true;
            }
          } catch(e) { console.error(e); } finally { this.loading[tab] = false; }
        },
        getByLang(obj, lang) { if (!obj || typeof obj !== 'object') return ''; return obj[lang] || obj.id || obj.en || ''; }
    }">

        <!-- Main Content Area -->
        <div class='grid grid-cols-1 lg:grid-cols-3 gap-10 mb-10'>
            <div class='lg:col-span-2'>
                {{> program_Bdetail/left_content/program_priview}}
            </div>

            <aside class='space-y-6'>
                <div class='p-8 border border-slate-300 rounded-lg bg-white/60 space-y-6 sticky top-6'>
                    {{> program_Bdetail/right_content/price}}
                    {{#if user}}
                        {{> program_Bdetail/right_content/card_no_rekening}}
                        {{#if check_user}}
                            <a href='/program/{{kelas.id}}' class='btn text-base w-full text-center transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1 bg-[#0B1F3B] hover:bg-[#0B1F3B]/90 text-white rounded-xl font-semibold border-none'><i class='fas fa-play-circle mr-2'></i>{{t "test.detailProgram.continueLearning"}}</a>
                        {{else}}
                            {{#if kelas.check_paid}}
                                {{#if (check daftar kelas.kuota)}}
                                    {{> program_Bdetail/right_content/upload_proof_of_payment/full_payment}}
                                    {{> program_Bdetail/right_content/upload_proof_of_payment/installment}}
                                {{/if}}
                            {{else}}
                                {{#if (check daftar kelas.kuota)}}
                                    {{> program_Bdetail/right_content/upload_proof_of_payment/free_payment}}
                                {{/if}}
                            {{/if}}
                        {{/if}}
                    {{else}}
                        <a href='/login' class='btn text-base w-full bg-secondary hover:bg-[#0B1F3B]/90 text-white rounded-xl font-semibold transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1 text-center border-none'>Registration Now</a>
                    {{/if}}
                </div>
            </aside>
        </div>

        <!-- Consolidated Content Area -->
        <div class="mt-8 space-y-12">
            {{> program_Bdetail/left_content/tab_content/participants}}
            {{> program_Bdetail/left_content/tab_content/information}}
            {{> program_Bdetail/left_content/tab_content/benefit}}
            {{> program_Bdetail/left_content/tab_content/flow}}
            {{> program_Bdetail/left_content/tab_content/schedule_fees}}
            {{> program_Bdetail/left_content/tab_content/gallery}}
            {{> program_Bdetail/left_content/tab_content/faq}}
        </div>
    </div>
  </div>
</div>