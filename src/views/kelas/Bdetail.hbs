<div
  class='bg-gradient-to-br from-slate-50 to-white text-slate-900 px-6 py-10 pt-28'
  x-data="{ activeTab: 'info' }"
>
  <div
    class='max-w-7xl mx-auto px-6 py-12 grid grid-cols-1 lg:grid-cols-3 gap-10'
  >

    <!-- Left Content -->
    <div class='lg:col-span-2 space-y-8'>
      <!-- Course Preview -->
      <div
        class='group w-full rounded-2xl overflow-hidden shadow-xl ring-1 ring-slate-200 bg-gradient-to-br from-gray-50 to-gray-100 aspect-video cursor-pointer hover:shadow-2xl transition-shadow duration-300'
      >
        <img
          src='{{kelas.gambar}}'
          alt='{{kelas.nama_kelas}}'
          class='w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-in-out'
        />
      </div>

      <!-- Tabs -->
      <div
        class='border-b border-slate-200 flex gap-6 text-sm font-medium overflow-x-auto'
      >
        <button
          @click="activeTab = 'info'"
          :class="activeTab === 'info' ? 'border-b-2 border-slate-600 text-slate-900 font-semibold' : 'text-slate-500 hover:text-slate-700'"
          class='pb-3 transition-colors whitespace-nowrap'
        >
          {{t "test.detailProgram.tabDetailProgram.programInfo"}}
        </button>
                <button
          @click="activeTab = 'bootcamp'"
          :class="activeTab === 'bootcamp' ? 'border-b-2 border-slate-600 text-slate-900 font-semibold' : 'text-slate-500 hover:text-slate-700'"
          class='pb-3 transition-colors whitespace-nowrap'
        >
          {{t "test.detailProgram.tabDetailProgram.flowProgram"}}
        </button>
        <button
          @click="activeTab = 'benefit'"
          :class="activeTab === 'benefit' ? 'border-b-2 border-slate-600 text-slate-900 font-semibold' : 'text-slate-500 hover:text-slate-700'"
          class='pb-3 transition-colors whitespace-nowrap'
        >
          {{t "test.detailProgram.tabDetailProgram.benefitProgram"}}
        </button>

                <button
          @click="activeTab = 'mentor'"
          :class="activeTab === 'mentor' ? 'border-b-2 border-slate-600 text-slate-900 font-semibold' : 'text-slate-500 hover:text-slate-700'"
          class='pb-3 transition-colors whitespace-nowrap'
        >
          {{t "test.detailProgram.tabDetailProgram.mentor"}}
        </button>
        <button
          @click="activeTab = 'faq'"
          :class="activeTab === 'faq' ? 'border-b-2 border-slate-600 text-slate-900 font-semibold' : 'text-slate-500 hover:text-slate-700'"
          class='pb-3 transition-colors whitespace-nowrap'
        >
          {{t "test.detailProgram.tabDetailProgram.faq"}}
        </button>


      </div>

      <!-- Tab Content -->
      <div>
        <!-- Course Info Tab -->
        <div x-show="activeTab === 'info'" x-transition>
          <div class='space-y-6'>

            <!-- Description -->
            <div
              class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-slate-200'
            >
              <h3
                class='font-montserrat text-3xl font-bold mb-4 bg-gradient-to-r from-gray-800 to-gray-900 bg-clip-text text-transparent'
              >
                {{kelas.nama_kelas}}
              </h3>
              <p
                class='font-inter text-justify text-gray-700 leading-relaxed text-lg'
              >
                {{getByLang kelas.deskripsi lang}}
              </p>
            </div>

            <!-- Method, Location & Capacity Grid -->
            <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>

              <!-- Learning Method Card -->
              {{#if (eq kelas.metode 'online')}}
                <div
                  class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200 hover:shadow-xl transition-all duration-300 group'
                >
                  <div class='flex items-start gap-4'>
                    <div
                      class='w-12 h-12 rounded-xl bg-gradient-to-br from-gray-600 to-gray-700 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg'
                    >
                      <i class='fas fa-laptop text-white text-xl'></i>
                    </div>
                    <div class='flex-1'>
                      <p
                        class='font-inter text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1'
                      >{{t "test.detailProgram.infoProgram.method"}}</p>
                      <h4
                        class='font-montserrat text-sm font-bold text-gray-900 mb-1'
                      >{{t "test.detailProgram.infoProgram.online"}}</h4>
                    </div>
                  </div>
                </div>
              {{else}}
                <div
                  class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200 hover:shadow-xl transition-all duration-300 group'
                >
                  <div class='flex items-start gap-4'>
                    <div
                      class='w-12 h-12 rounded-xl bg-gradient-to-br from-gray-600 to-gray-700 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg'
                    >
                      <i
                        class='fas fa-chalkboard-teacher text-white text-xl'
                      ></i>
                    </div>
                    <div class='flex-1'>
                      <p
                        class='font-inter text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1'
                      >{{t "test.detailProgram.infoProgram.method"}}</p>
                      <h4
                        class='font-montserrat text-sm font-bold text-gray-900 mb-1'
                      >{{t "test.detailProgram.infoProgram.offline"}}</h4>
                    </div>
                  </div>
                </div>
              {{/if}}

              <!-- Location Card -->
              <div
                class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200 hover:shadow-xl transition-all duration-300 group'
              >
                <div class='flex items-start gap-4'>
                  <div
                    class='w-12 h-12 rounded-xl bg-gradient-to-br from-gray-600 to-gray-700 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg'
                  >
                    {{#if (eq kelas.metode 'online')}}
                      <i class='fas fa-globe text-white text-xl'></i>
                    {{else}}
                      <i class='fas fa-map-marker-alt text-white text-xl'></i>
                    {{/if}}
                  </div>
                  <div class='flex-1'>
                    <p
                      class='font-inter text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1'
                    >{{t "test.detailProgram.infoProgram.location"}}</p>
                    {{#if (eq kelas.metode 'online')}}
                      <h4
                        class='font-montserrat text-sm font-bold text-gray-900 mb-1'
                      ><a href="{{kelas.link_lokasi}}" target="_blank" rel="noopener noreferrer">{{getByLang kelas.lokasi lang}}</a></h4>
                    {{else}}
                      <h4
                        class='font-montserrat text-sm font-bold text-gray-900 mb-1'
                        title='{{kelas.lokasi}}'
                      ><a href="{{kelas.link_lokasi}}" target="_blank" rel="noopener noreferrer">{{getByLang kelas.lokasi lang}}</a></h4>
                    {{/if}}
                  </div>
                </div>

              </div>

              <!-- Capacity Card -->
              {{#if kelas.kuota}}
                <div
                  class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200 hover:shadow-xl transition-all duration-300 group'
                >
                  <div class='flex items-start gap-4'>
                    <div
                      class='w-12 h-12 rounded-xl bg-gradient-to-br from-gray-600 to-gray-700 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg'
                    >
                      <i class='fas fa-users text-white text-xl'></i>
                    </div>
                    <div class='flex-1'>
                      <p
                        class='font-inter text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1'
                      >{{t "test.detailProgram.infoProgram.capacity"}}</p>
                      <h4
                        class='font-montserrat text-sm font-bold text-gray-900 mb-1'
                      >{{kelas.kuota}} {{t "test.detailProgram.infoProgram.students"}}</h4>
                    </div>
                  </div>
                </div>
              {{/if}}

            </div>

            <!-- Schedule Information -->
            <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>

              <!-- Month Card -->
              {{#unless (eq kelas.kategori.nama_kategori 'Short Class')}}
                <div
                  class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200 hover:shadow-xl transition-all duration-300 group'
                >
                  <div class='flex items-start gap-4'>
                    <div
                      class='w-12 h-12 rounded-xl bg-gradient-to-br from-gray-600 to-gray-700 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg'
                    >
                      <i class='fas fa-calendar-alt text-white text-xl'></i>
                    </div>
                    <div class='flex-1'>
                      <p
                        class='font-inter text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1'
                      >{{t "test.detailProgram.infoProgram.month"}}</p>
                      <h4
                        class='font-montserrat text-sm font-bold text-gray-900 mb-1'
                      >{{kelas.bulan}} {{t "test.detailProgram.infoProgram.months"}}</h4>
                    </div>
                  </div>
                </div>
              {{/unless}}

              <!-- Day Card -->
              {{#if (eq kelas.kategori.nama_kategori 'Short Class')}}
                <div
                  class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200 hover:shadow-xl transition-all duration-300 group'
                >
                  <div class='flex items-start gap-4'>
                    <div
                      class='w-12 h-12 rounded-xl bg-gradient-to-br from-gray-600 to-gray-700 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg'
                    >
                      <i class='fas fa-clock text-white text-xl'></i>
                    </div>
                    <div class='flex-1'>
                      <p
                        class='font-inter text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1'
                      >{{t "test.detailProgram.infoProgram.day"}}</p>
                      <h4
                        class='font-montserrat text-sm font-bold text-gray-900 mb-1'
                      >{{kelas.hari}} {{t "test.detailProgram.infoProgram.days"}}</h4>
                    </div>
                  </div>
                </div>
              {{/if}}

              <!-- Start Date Card -->
              <div
                class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200 hover:shadow-xl transition-all duration-300 group'
              >
                <div class='flex items-start gap-4'>
                  <div
                    class='w-12 h-12 rounded-xl bg-gradient-to-br from-green-600 to-green-700 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg'
                  >
                    <i class='fas fa-play-circle text-white text-xl'></i>
                  </div>
                  <div class='flex-1'>
                    <p
                      class='font-inter text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1'
                    >{{t "test.detailProgram.infoProgram.startDate"}}</p>
                    <h4
                      class='font-montserrat text-sm font-bold text-gray-900 mb-1'
                    >{{#if kelas.tanggal_mulai}}{{formatTanggal kelas.tanggal_mulai}}{{else}}{{t "test.detailProgram.infoProgram.noSet"}}{{/if}}</h4>
                  </div>
                </div>
              </div>

              <!-- End Date Card -->
              <div
                class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200 hover:shadow-xl transition-all duration-300 group'
              >
                <div class='flex items-start gap-4'>
                  <div
                    class='w-12 h-12 rounded-xl bg-gradient-to-br from-red-600 to-red-700 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg'
                  >
                    <i class='fas fa-stop-circle text-white text-xl'></i>
                  </div>
                  <div class='flex-1'>
                    <p
                      class='font-inter text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1'
                    >{{t "test.detailProgram.infoProgram.endDate"}}</p>
                    <h4
                      class='font-montserrat text-sm font-bold text-gray-900 mb-1'
                    >{{#if kelas.tanggal_selesai}}{{formatTanggal kelas.tanggal_selesai}}{{else}}{{t "test.detailProgram.infoProgram.noSet"}}{{/if}}</h4>
                  </div>
                </div>
              </div>

            </div>

            <!-- Material Includes -->
            <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
              <h4
                class='font-montserrat text-xl font-bold mb-4 text-gray-900 flex items-center gap-2'
              >
                <i class='fas fa-box-open text-gray-500'></i>
                {{t "test.detailProgram.infoProgram.lessonsIncludes"}}
              </h4>
              <ul class='ml-8 space-y-3'>
                {{#if (eq lang 'id')}}
                {{#each kelas.materi_id}}
                  <li class='flex items-start gap-3 font-inter text-gray-700'>
                    <i
                      class='fa-solid fa-circle fa-2xs  text-gray-500 mt-1 flex-shrink-0'
                    ></i>
                    <span>{{this}}</span>
                  </li>
                  {{/each}}
                {{else if (eq lang 'en')}}
                {{#each kelas.materi_en}}
                  <li class='flex items-start gap-3 font-inter text-gray-700'>
                    <i
                      class='fa-solid fa-circle fa-2xs text-gray-500 mt-1 flex-shrink-0'
                    ></i>
                    <span>{{this}}</span>
                  </li>
                {{/each}}
                {{else if (eq lang 'ja')}}
                {{#each kelas.materi_ja}}
                  <li class='flex items-start gap-3 font-inter text-gray-700'>
                    <i
                      class='fa-solid fa-circle fa-2xs text-gray-500 mt-1 flex-shrink-0'
                    ></i>
                    <span>{{this}}</span>
                  </li>
                {{/each}}
                {{/if}}
              </ul>
            </div>

            <!-- What You'll Learn -->
            <div
              class='bg-gradient-to-br from-gray-50 to-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'
            >
              <h4
                class='font-montserrat text-xl font-bold mb-4 text-gray-900 flex items-center gap-2'
              >
                <i class='fas fa-lightbulb text-gray-500'></i>
                {{t "test.detailProgram.infoProgram.whatYouLearn"}}
              </h4>
              <ul class='ml-8 space-y-3'>
                {{#if (eq lang 'id')}}
                {{#each kelas.target_pembelajaran_id}}
                  <li class='flex items-start gap-3 font-inter text-gray-700'>
                    <i class='fa-solid fa-circle fa-2xs text-gray-500 mt-1 flex-shrink-0'></i>
                    <span>{{this}}</span>
                  </li>
                  {{/each}}
                {{else if (eq lang 'en')}}
                {{#each kelas.target_pembelajaran_en}}
                  <li class='flex items-start gap-3 font-inter text-gray-700'>
                    <i class='fa-solid fa-circle fa-2xs text-gray-500 mt-1 flex-shrink-0'></i>
                    <span>{{this}}</span>
                  </li>
                {{/each}}
                {{else if (eq lang 'ja')}}
                {{#each kelas.target_pembelajaran_ja}}
                  <li class='flex items-start gap-3 font-inter text-gray-700'>
                    <i class='fa-solid fa-circle fa-2xs text-gray-500 mt-1 flex-shrink-0'></i>
                    <span>{{this}}</span>
                  </li>
                {{/each}}
                {{/if}}
              </ul>
            </div>

            <!-- Kriteria -->
            <div
              class='bg-gradient-to-br from-gray-50 to-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'
            >
              <h4
                class='font-montserrat text-xl font-bold mb-4 text-gray-900 flex items-center gap-2'
              >
                <i class='fas fa-user-check text-gray-500'></i>
                {{t "test.detailProgram.infoProgram.requirement"}}
              </h4>
              <ul class='ml-8 space-y-3'>
                {{#if (eq lang 'id')}}
                {{#each kelas.kriteria_id}}
                  <li class='flex items-start gap-3 font-inter text-gray-700'>
                    <i
                      class='fa-solid fa-circle fa-2xs text-gray-500 mt-1 flex-shrink-0'
                    ></i>
                    <span>{{this}}</span>
                  </li>
                {{/each}}
                {{else if (eq lang 'en')}}
                {{#each kelas.kriteria_en}}
                  <li class='flex items-start gap-3 font-inter text-gray-700'>
                    <i
                      class='fa-solid fa-circle fa-2xs text-gray-500 mt-1 flex-shrink-0'
                    ></i>
                    <span>{{this}}</span>
                  </li>
                {{/each}}
                {{else if (eq lang 'ja')}}
                {{#each kelas.kriteria_ja}}
                  <li class='flex items-start gap-3 font-inter text-gray-700'>
                    <i
                      class='fa-solid fa-circle fa-2xs text-gray-500 mt-1 flex-shrink-0'
                    ></i>
                    <span>{{this}}</span>
                  </li>
                {{/each}}
                {{/if}}
              </ul>
            </div>

            <!-- Technologies -->
            <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
              <h4
                class='font-montserrat text-xl font-bold mb-4 text-gray-900 flex items-center gap-2'
              >
                <i class='fas fa-code text-gray-500'></i>
                {{t "test.detailProgram.infoProgram.technology"}}
              </h4>
              <div class='ml-8 flex gap-2 flex-wrap'>
                {{#each teknologi}}
                  <div class='w-6 h-6 flex items-center justify-center'>
                    {{{this.svg}}}
                  </div>
                {{/each}}
              </div>
            </div>

          </div>
        </div>

        <!-- Benefits Tab -->
        <div x-show="activeTab === 'benefit'" x-transition>
          <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
            <h3
              class='font-montserrat text-3xl font-bold mb-6 bg-gradient-to-r from-gray-800 to-gray-900 bg-clip-text text-transparent'
            >
              {{t "test.detailProgram.benefitProgram.tittle"}}
            </h3>

            <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>

              <!-- Benefit 1 -->
              {{#each benefit_kelas}}
                <div
                  class='bg-gradient-to-br from-gray-50 to-white rounded-xl p-5 border border-gray-200 hover:shadow-md hover:border-gray-300 transition-all'
                >
                  <div class='flex items-start gap-4'>
                    <div
                      class='bg-gray-100 p-3 rounded-full ring-1 ring-gray-200 w-12 h-12 flex items-center justify-center'
                    >
                      <i class='{{computeIcon this.icon}}'></i>
                    </div>
                    <div>
                      <h4
                        class='font-semibold text-gray-900 text-lg mb-2'
                      >{{getByLang this.benefit ../lang}}</h4>
                      <p class='text-gray-700 leading-relaxed'>
                        {{getByLang this.isi ../lang}}
                      </p>
                    </div>
                  </div>
                </div>
              {{/each}}

            </div>
          </div>
        </div>

        <!-- FAQ Tab -->
        <div x-show="activeTab === 'faq'" x-transition>
          <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
            <h3
              class='font-montserrat text-3xl font-bold mb-6 bg-gradient-to-r from-gray-800 to-gray-900 bg-clip-text text-transparent'
            >
              {{t "test.detailProgram.faq.tittle"}}
            </h3>
<div class='space-y-4' x-data='{ openFaq: null }'>
  {{#each pertanyaan_kelas}}
    <div class='border border-gray-200 rounded-xl overflow-hidden'>
      <button
        class='w-full text-left p-5 bg-white hover:bg-gray-50 transition-colors flex justify-between items-center'
        @click='openFaq = openFaq === {{this.id}} ? null : {{this.id}}'
      >
        <span class='font-montserrat font-semibold text-gray-800'>
          {{getByLang this.pertanyaan ../lang}}
        </span>

        <i
          class='fas fa-chevron-down text-gray-500 transition-transform duration-300'
          :class="{ 'rotate-180': openFaq === {{this.id}} }"
        ></i>
      </button>

      <div
        class='font-inter px-5 pb-5 text-gray-700'
        x-show='openFaq === {{this.id}}'
        x-transition
      >
        {{getByLang this.jawaban ../lang}}
      </div>
    </div>
  {{/each}}
</div>


          </div>
        </div>

        <!-- Bootcamp Flow Tab -->
        <div x-show="activeTab === 'bootcamp'" x-transition>
          <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
            <h3
              class='font-montserrat text-3xl font-bold mb-6 bg-gradient-to-r from-gray-700 to-gray-900 bg-clip-text text-transparent'
            >
              {{t "test.detailProgram.flowProgram.tittle"}}
            </h3>

            <div class='relative'>
              <!-- Timeline -->
              <div class='space-y-10'>
                <!-- Phase 1 -->
                {{#each alur_kelas}}
                  <div class='flex gap-6'>
                    <div class='flex flex-col items-center'>
                      <div
                        class='w-12 h-12 bg-gradient-to-r from-gray-600 to-gray-800 rounded-full flex items-center justify-center text-white font-bold shadow-lg'
                      >
                        {{this.alur_ke}}
                      </div>
                      <div
                        class='flex-1 w-0.5 bg-gradient-to-b from-gray-600 to-gray-800 mt-2'
                      ></div>
                    </div>
                    <div class='flex-1 pb-10'>
                      <h4
                        class='font-montserrat text-xl font-bold text-gray-900 mb-2'
                      >{{getByLang this.judul ../lang}}</h4>
                      <p class='font-inter text-gray-700 mb-3'>
                        {{getByLang this.isi ../lang}}
                      </p>
                    </div>
                  </div>
                {{/each}}
              </div>
            </div>
          </div>
        </div>

        <!-- Mentors Tab -->
        <div x-show="activeTab === 'mentor'" x-transition>
          <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
            <h3
              class='font-montserrat text-3xl font-bold mb-6 bg-gradient-to-r from-gray-700 to-gray-900 bg-clip-text text-transparent'
            >
              {{t "test.detailProgram.mentor.tittle"}}
            </h3>

            <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
              <!-- Hardcoded Mentor Cards -->

              {{#each mentor}}
                <div
                  class='bg-gradient-to-br from-gray-50 to-white rounded-xl p-6 border border-gray-200 shadow-sm hover:shadow-md transition-shadow'
                >
                  <div
                    class='flex flex-col sm:flex-row gap-4 items-center sm:items-start'
                  >
                    <img
                      src='{{profile}}'
                      alt='{{nama}}'
                      class='w-20 h-20 rounded-full object-cover border-4 border-white shadow'
                    />
                    <div class='text-center sm:text-left flex-1'>
                      <h4
                        class='font-montserrat font-bold text-gray-800 text-lg'
                      >{{nama}}</h4>
                      <p class='font-inter text-gray-600 mb-2'>{{getByLang posisi ../lang}}</p>
                      <div
                        class='flex justify-center sm:justify-start gap-2 mb-3 flex-wrap'
                      >
                        {{#each teknologi}}
                          <span
                            class='w-6 h-6'
                          >{{{this.svg}}}</span>
                        {{/each}}

                      </div>
                      <p class='text-gray-700 text-sm'>
                        {{getByLang deskripsi ../lang}}
                      </p>
                    </div>
                  </div>
                  <div
                    class='mt-4 flex items-center justify-center sm:justify-start gap-4 text-gray-500'
                  >
                    <a
                      href='{{linkedin}}' target='_blank'
                      class='hover:text-gray-800 transition-colors'
                    ><i class='fab fa-linkedin'></i></a>
                  </div>
                </div>
              {{/each}}

            </div>
          </div>
        </div>
      </div>
    </div>


    <aside
      class='space-y-6'
      x-data="{ 
        previewUrl: null, 
        copied: false, 
        paymentType: 'full',
        installmentMonths: 0,
        fileError: '',
        waError: '',
        isValidFile: false,
        isValidWa: false,
        fileInputTouched: false,
        waInputTouched: false,
        cicilanData: [
          {{#each cicilan}}
            {
              id: {{this.id}},
              bulan: {{this.bulan}},
              dp: {{this.dp}},
              harga: {{json this.harga}}
            }{{#unless @last}},{{/unless}}
          {{/each}}
        ],
        hasCicilan: {{#if cicilan.length}}true{{else}}false{{/if}},
        copyToClipboard() { 
          navigator.clipboard.writeText('2847 9237 4298 1234'); 
          this.copied = true; 
          setTimeout(() => this.copied = false, 2000); 
        },
        setPaymentType(type) {
          this.paymentType = type;
          if (type === 'installment' && this.installmentMonths === 0 && this.availableMonths.length > 0) {
            this.installmentMonths = this.availableMonths[0];
          }
        },
        getCicilanByMonth(months) {
          const cicilan = this.cicilanData.find(c => c.bulan === months);
          return cicilan ? cicilan : null;
        },
        get installmentAmount() {
          if (!this.installmentMonths || this.installmentMonths === 0) return 0;
          const cicilan = this.getCicilanByMonth(this.installmentMonths);
          if (cicilan && cicilan.dp) {
            // Return DP as first payment
            return cicilan.dp;
          }
          // Fallback to equal division if no cicilan data
          return Math.ceil({{kelas.harga}} / this.installmentMonths);
        },
        get totalCicilanAmount() {
          if (!this.installmentMonths || this.installmentMonths === 0) return {{kelas.harga}};
          const cicilan = this.getCicilanByMonth(this.installmentMonths);
          if (cicilan && cicilan.harga && cicilan.harga.length > 0) {
            return cicilan.harga.reduce((sum, h) => sum + h, 0);
          }
          return {{kelas.harga}};
        },
        get availableMonths() {
          return this.cicilanData.map(c => c.bulan);
        },
        validateFile(event) {
          const file = event.target.files[0];
          this.fileError = '';
          this.isValidFile = false;
          this.previewUrl = null;
          this.fileInputTouched = true;

          if (!file) return;

          // Validate file type
          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!allowedTypes.includes(file.type)) {
            this.fileError = 'File type not allowed. Please upload JPG, JPEG, or PNG only.';
            event.target.value = '';
            return;
          }

          // Validate file size (max 5MB)
          const maxSize = 5 * 1024 * 1024; // 5MB in bytes
          if (file.size > maxSize) {
            this.fileError = `File size exceeds 5MB. Your file is ${(file.size / (1024 * 1024)).toFixed(2)}MB.`;
            event.target.value = '';
            return;
          }

          // File is valid
          this.isValidFile = true;
          this.previewUrl = URL.createObjectURL(file);
        },
        validateWa(event) {
          const value = event.target.value;
          this.waError = '';
          this.isValidWa = false;
          this.waInputTouched = true;

          if (!value) return;

          // Remove spaces and special characters for validation
          const cleanValue = value.replace(/[\s\-\(\)]/g, '');

          // Check if only contains numbers
          if (!/^\d+$/.test(cleanValue)) {
            this.waError = 'WhatsApp number must contain only numbers.';
            return;
          }

          // Check length (10-13 digits)
          if (cleanValue.length < 10 || cleanValue.length > 13) {
            this.waError = `WhatsApp number must be 10-13 digits. Current: ${cleanValue.length} digits.`;
            return;
          }

          // Check if starts with 0 or 62 (Indonesian format)
          if (!cleanValue.startsWith('0') && !cleanValue.startsWith('62')) {
            this.waError = 'WhatsApp number must start with 0 or 62 (e.g., 08123456789 or 628123456789).';
            return;
          }

          // Valid
          this.isValidWa = true;
        }
      }"
