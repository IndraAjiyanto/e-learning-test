                      class='w-full bg-white border-2 border-emerald-300 rounded-xl p-3 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 transition-all'
                      @change='previewUrl = $event.target.files[0] ? URL.createObjectURL($event.target.files[0]) : null'
                    />
