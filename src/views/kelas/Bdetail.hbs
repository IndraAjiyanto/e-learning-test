<div
  class='bg-gradient-to-br from-slate-50 to-white text-slate-900 px-6 py-10 pt-28'
  x-data="{ activeTab: 'info' }"
>
  <div
    class='max-w-7xl mx-auto px-6 py-12 grid grid-cols-1 lg:grid-cols-3 gap-10'
  >

    <!-- Left Content -->
    <div class='lg:col-span-2 space-y-8'>
      <!-- Course Preview -->
      <div
        class='group w-full rounded-2xl overflow-hidden shadow-xl ring-1 ring-slate-200 bg-gradient-to-br from-gray-50 to-gray-100 aspect-video cursor-pointer hover:shadow-2xl transition-shadow duration-300'
      >
        <img
          src='{{kelas.gambar}}'
          alt='{{kelas.nama_kelas}}'
          class='w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-in-out'
        />
      </div>

      <!-- Tabs -->
      <div
        class='border-b border-slate-200 flex gap-6 text-sm font-medium overflow-x-auto'
      >
        <button
          @click="activeTab = 'info'"
          :class="activeTab === 'info' ? 'border-b-2 border-slate-600 text-slate-900 font-semibold' : 'text-slate-500 hover:text-slate-700'"
          class='pb-3 transition-colors whitespace-nowrap'
        >
          Course Info
        </button>
        <button
          @click="activeTab = 'benefit'"
          :class="activeTab === 'benefit' ? 'border-b-2 border-slate-600 text-slate-900 font-semibold' : 'text-slate-500 hover:text-slate-700'"
          class='pb-3 transition-colors whitespace-nowrap'
        >
          Benefits
        </button>
        <button
          @click="activeTab = 'faq'"
          :class="activeTab === 'faq' ? 'border-b-2 border-slate-600 text-slate-900 font-semibold' : 'text-slate-500 hover:text-slate-700'"
          class='pb-3 transition-colors whitespace-nowrap'
        >
          FAQ
        </button>
        <button
          @click="activeTab = 'bootcamp'"
          :class="activeTab === 'bootcamp' ? 'border-b-2 border-slate-600 text-slate-900 font-semibold' : 'text-slate-500 hover:text-slate-700'"
          class='pb-3 transition-colors whitespace-nowrap'
        >
          Bootcamp Flow
        </button>
        <button
          @click="activeTab = 'mentor'"
          :class="activeTab === 'mentor' ? 'border-b-2 border-slate-600 text-slate-900 font-semibold' : 'text-slate-500 hover:text-slate-700'"
          class='pb-3 transition-colors whitespace-nowrap'
        >
          Mentors
        </button>
      </div>

      <!-- Tab Content -->
      <div>
        <!-- Course Info Tab -->
        <div x-show="activeTab === 'info'" x-transition>
          <div class='space-y-6'>

            <!-- Description -->
            <div
              class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-slate-200'
            >
              <h3
                class='font-montserrat text-3xl font-bold mb-4 bg-gradient-to-r from-gray-800 to-gray-900 bg-clip-text text-transparent'
              >
                {{kelas.nama_kelas}}
              </h3>
              <p
                class='font-inter text-justify text-gray-700 leading-relaxed text-lg'
              >
                {{kelas.deskripsi}}
              </p>
            </div>

            <!-- Method, Location & Capacity Grid -->
            <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>

              <!-- Learning Method Card -->
              {{#if (roles kelas.metode 'online')}}
                <div
                  class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200 hover:shadow-xl transition-all duration-300 group'
                >
                  <div class='flex items-start gap-4'>
                    <div
                      class='w-12 h-12 rounded-xl bg-gradient-to-br from-gray-600 to-gray-700 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg'
                    >
                      <i class='fas fa-laptop text-white text-xl'></i>
                    </div>
                    <div class='flex-1'>
                      <p
                        class='font-inter text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1'
                      >Method</p>
                      <h4
                        class='font-montserrat text-sm font-bold text-gray-900 mb-1'
                      >Online Class</h4>
                    </div>
                  </div>
                </div>
              {{else}}
                <div
                  class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200 hover:shadow-xl transition-all duration-300 group'
                >
                  <div class='flex items-start gap-4'>
                    <div
                      class='w-12 h-12 rounded-xl bg-gradient-to-br from-gray-600 to-gray-700 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg'
                    >
                      <i
                        class='fas fa-chalkboard-teacher text-white text-xl'
                      ></i>
                    </div>
                    <div class='flex-1'>
                      <p
                        class='font-inter text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1'
                      >Method</p>
                      <h4
                        class='font-montserrat text-sm font-bold text-gray-900 mb-1'
                      >Offline Class</h4>
                    </div>
                  </div>
                </div>
              {{/if}}

              <!-- Location Card -->
              <div
                class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200 hover:shadow-xl transition-all duration-300 group'
              >
                <div class='flex items-start gap-4'>
                  <div
                    class='w-12 h-12 rounded-xl bg-gradient-to-br from-gray-600 to-gray-700 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg'
                  >
                    {{#if (roles kelas.metode 'online')}}
                      <i class='fas fa-globe text-white text-xl'></i>
                    {{else}}
                      <i class='fas fa-map-marker-alt text-white text-xl'></i>
                    {{/if}}
                  </div>
                  <div class='flex-1'>
                    <p
                      class='font-inter text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1'
                    >Location</p>
                    {{#if (roles kelas.metode 'online')}}
                      <h4
                        class='font-montserrat text-sm font-bold text-gray-900 mb-1'
                      >{{kelas.lokasi}}</h4>
                    {{else}}
                      <h4
                        class='font-montserrat text-sm font-bold text-gray-900 mb-1 truncate'
                        title='{{kelas.lokasi}}'
                      >{{kelas.lokasi}}</h4>
                    {{/if}}
                  </div>
                </div>

              </div>

              <!-- Capacity Card -->
              {{#if kelas.kuota}}
                <div
                  class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200 hover:shadow-xl transition-all duration-300 group'
                >
                  <div class='flex items-start gap-4'>
                    <div
                      class='w-12 h-12 rounded-xl bg-gradient-to-br from-gray-600 to-gray-700 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg'
                    >
                      <i class='fas fa-users text-white text-xl'></i>
                    </div>
                    <div class='flex-1'>
                      <p
                        class='font-inter text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1'
                      >Capacity</p>
                      <h4
                        class='font-montserrat text-sm font-bold text-gray-900 mb-1'
                      >{{kelas.kuota}} Students</h4>
                    </div>
                  </div>
                </div>
              {{/if}}

            </div>

            <!-- Material Includes -->
            <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
              <h4
                class='font-montserrat text-xl font-bold mb-4 text-gray-900 flex items-center gap-2'
              >
                <i class='fas fa-box-open text-gray-500'></i>
                Material Includes
              </h4>
              <ul class='space-y-3'>
                {{#each kelas.materi}}
                  <li class='flex items-start gap-3 font-inter text-gray-700'>
                    <i
                      class='fas fa-check-circle text-gray-500 mt-1 flex-shrink-0'
                    ></i>
                    <span>{{this}}</span>
                  </li>
                {{/each}}
              </ul>
            </div>

            <!-- What You'll Learn -->
            <div
              class='bg-gradient-to-br from-gray-50 to-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'
            >
              <h4
                class='font-montserrat text-xl font-bold mb-4 text-gray-900 flex items-center gap-2'
              >
                <i class='fas fa-lightbulb text-gray-500'></i>
                What You'll Learn
              </h4>
              <ul class='space-y-3'>
                {{#each kelas.target_pembelajaran}}
                  <li class='flex items-start gap-3 font-inter text-gray-700'>
                    <i class='fas fa-star text-gray-400 mt-1 flex-shrink-0'></i>
                    <span>{{this}}</span>
                  </li>
                {{/each}}
              </ul>
            </div>

            <!-- Kriteria -->
            <div
              class='bg-gradient-to-br from-gray-50 to-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'
            >
              <h4
                class='font-montserrat text-xl font-bold mb-4 text-gray-900 flex items-center gap-2'
              >
                <i class='fas fa-user-check text-gray-500'></i>
                Requirements
              </h4>
              <ul class='space-y-3'>
                {{#each kelas.kriteria}}
                  <li class='flex items-start gap-3 font-inter text-gray-700'>
                    <i
                      class='fas fa-check-square text-gray-400 mt-1 flex-shrink-0'
                    ></i>
                    <span>{{this}}</span>
                  </li>
                {{/each}}
              </ul>
            </div>

            <!-- Technologies -->
            <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
              <h4
                class='font-montserrat text-xl font-bold mb-4 text-gray-900 flex items-center gap-2'
              >
                <i class='fas fa-code text-gray-500'></i>
                Technologies
              </h4>
              <div class='flex gap-2 flex-wrap'>
                {{#each kelas.teknologi}}
                  <div class='w-6 h-6 flex items-center justify-center'>
                    {{{this.svg}}}
                  </div>
                {{/each}}
              </div>
            </div>

          </div>
        </div>

        <!-- Benefits Tab -->
        <div x-show="activeTab === 'benefit'" x-transition>
          <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
            <h3
              class='font-montserrat text-3xl font-bold mb-6 bg-gradient-to-r from-gray-800 to-gray-900 bg-clip-text text-transparent'
            >
              Course Benefits
            </h3>

            <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>

              <!-- Benefit 1 -->
              {{#each kelas.benefit_kelas}}
                <div
                  class='bg-gradient-to-br from-gray-50 to-white rounded-xl p-5 border border-gray-200 hover:shadow-md hover:border-gray-300 transition-all'
                >
                  <div class='flex items-start gap-4'>
                    <div
                      class='bg-gray-100 p-3 rounded-full ring-1 ring-gray-200'
                    >
                      <i class='{{computeIcon this.icon}}'></i>
                    </div>
                    <div>
                      <h4
                        class='font-semibold text-gray-900 text-lg mb-2'
                      >{{this.benefit}}</h4>
                      <p class='text-gray-700 leading-relaxed'>
                        {{this.isi}}
                      </p>
                    </div>
                  </div>
                </div>
              {{/each}}

            </div>
          </div>
        </div>

        <!-- FAQ Tab -->
        <div x-show="activeTab === 'faq'" x-transition>
          <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
            <h3
              class='font-montserrat text-3xl font-bold mb-6 bg-gradient-to-r from-gray-800 to-gray-900 bg-clip-text text-transparent'
            >
              Frequently Asked Questions
            </h3>

            <div class='space-y-4' x-data='{ openFaq: null }'>
              <!-- FAQ Item 1 -->
              {{#each kelas.pertanyaan_kelas}}
                <div class='border border-gray-200 rounded-xl overflow-hidden'>
                  <button
                    class='w-full text-left p-5 bg-white hover:bg-gray-50 transition-colors flex justify-between items-center'
                    @click='openFaq = openFaq === 1 ? null : 1'
                  >
                    <span class='font-montserrat font-semibold text-gray-800'>Do
                      I
                      {{this.pertanyaan}}</span>
                    <i
                      class='fas fa-chevron-down text-gray-500 transition-transform duration-300'
                      :class="{'rotate-180': openFaq === 1}"
                    ></i>
                  </button>
                  <div
                    class='font-inter px-5 pb-5 text-gray-700'
                    x-show='openFaq === 1'
                    x-transition
                  >
                    {{this.jawaban}}
                  </div>
                </div>
              {{/each}}

            </div>
          </div>
        </div>

        <!-- Bootcamp Flow Tab -->
        <div x-show="activeTab === 'bootcamp'" x-transition>
          <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
            <h3
              class='font-montserrat text-3xl font-bold mb-6 bg-gradient-to-r from-gray-700 to-gray-900 bg-clip-text text-transparent'
            >
              Bootcamp Learning Flow
            </h3>

            <div class='relative'>
              <!-- Timeline -->
              <div class='space-y-10'>
                <!-- Phase 1 -->
                {{#each kelas.alur_kelas}}
                  <div class='flex gap-6'>
                    <div class='flex flex-col items-center'>
                      <div
                        class='w-12 h-12 bg-gradient-to-r from-gray-600 to-gray-800 rounded-full flex items-center justify-center text-white font-bold shadow-lg'
                      >
                        {{this.alur_ke}}
                      </div>
                      <div
                        class='flex-1 w-0.5 bg-gradient-to-b from-gray-600 to-gray-800 mt-2'
                      ></div>
                    </div>
                    <div class='flex-1 pb-10'>
                      <h4
                        class='font-montserrat text-xl font-bold text-gray-900 mb-2'
                      >{{this.judul}}</h4>
                      <p class='font-inter text-gray-700 mb-3'>
                        {{this.isi}}
                      </p>
                    </div>
                  </div>
                {{/each}}
              </div>
            </div>
          </div>
        </div>

        <!-- Mentors Tab -->
        <div x-show="activeTab === 'mentor'" x-transition>
          <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
            <h3
              class='font-montserrat text-3xl font-bold mb-6 bg-gradient-to-r from-gray-700 to-gray-900 bg-clip-text text-transparent'
            >
              Meet Your Mentors
            </h3>

            <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
              <!-- Hardcoded Mentor Cards -->

              {{#each kelas.mentor}}
                <div
                  class='bg-gradient-to-br from-gray-50 to-white rounded-xl p-6 border border-gray-200 shadow-sm hover:shadow-md transition-shadow'
                >
                  <div
                    class='flex flex-col sm:flex-row gap-4 items-center sm:items-start'
                  >
                    <img
                      src='{{profile}}'
                      alt='{{nama}}'
                      class='w-20 h-20 rounded-full object-cover border-4 border-white shadow'
                    />
                    <div class='text-center sm:text-left flex-1'>
                      <h4
                        class='font-montserrat font-bold text-gray-800 text-lg'
                      >{{nama}}</h4>
                      <p class='font-inter text-gray-600 mb-2'>{{posisi}}</p>
                      <div
                        class='flex justify-center sm:justify-start gap-2 mb-3 flex-wrap'
                      >
                        {{#each teknologi}}
                          <span
                            class='font-inter px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium border border-gray-300'
                          >{{this}}</span>
                        {{/each}}

                      </div>
                      <p class='text-gray-700 text-sm'>
                        {{deskripsi}}
                      </p>
                    </div>
                  </div>
                  <div
                    class='mt-4 flex items-center justify-center sm:justify-start gap-4 text-gray-500'
                  >
                    <a
                      href='{{linkedin}}'
                      class='hover:text-gray-800 transition-colors'
                    ><i class='fab fa-linkedin'></i></a>
                    <a
                      href='{{github}}'
                      class='hover:text-gray-800 transition-colors'
                    ><i class='fab fa-github'></i></a>
                  </div>
                </div>
              {{/each}}

            </div>
          </div>
        </div>

        <!-- Reviews Tab -->
        {{! <div x-show="activeTab === 'reviews'" x-transition>
          <div class="bg-white rounded-xl p-6 shadow-lg ring-1 ring-slate-200">
            <h3 class="text-3xl font-bold mb-6 text-slate-900 bg-gradient-to-r from-slate-700 to-slate-900 bg-clip-text text-transparent">Student Reviews</h3>
            <p class="text-slate-700">Reviews content will be displayed here.</p>
          </div>
        </div> }}
      </div>
    </div>

    <!-- Right Sidebar -->

    <aside
      class='space-y-6'
      x-data="{ 
        previewUrl: null, 
        copied: false, 
        paymentType: 'full',
        installmentMonths: {{#each kelas.cicilan}}{{#if @first}}{{this.bulan}}{{/if}}{{else}}3{{/each}},
        cicilanData: [
          {{#each kelas.cicilan}}
            {
              bulan: {{this.bulan}},
              harga: {{json this.harga}}
            }{{#unless @last}},{{/unless}}
          {{/each}}
        ],
        copyToClipboard() { 
          navigator.clipboard.writeText('2847 9237 4298 1234'); 
          this.copied = true; 
          setTimeout(() => this.copied = false, 2000); 
        },
        getCicilanByMonth(months) {
          const cicilan = this.cicilanData.find(c => c.bulan === months);
          return cicilan ? cicilan.harga : [];
        },
        get installmentAmount() {
          const hargaArray = this.getCicilanByMonth(this.installmentMonths);
          if (hargaArray.length > 0) {
            // Return first month payment from cicilan data
            return hargaArray[0];
          }
          // Fallback to equal division if no cicilan data
          return Math.ceil({{kelas.harga}} / this.installmentMonths);
        },
        get totalCicilanAmount() {
          const hargaArray = this.getCicilanByMonth(this.installmentMonths);
          if (hargaArray.length > 0) {
            return hargaArray.reduce((sum, h) => sum + h, 0);
          }
          return {{kelas.harga}};
        },
        get availableMonths() {
          return this.cicilanData.map(c => c.bulan);
        }
      }"
    >
      <div
        class='p-8 border border-slate-200 rounded-2xl shadow-xl bg-gradient-to-br from-white to-slate-50 space-y-6 sticky top-6'
      >
        <!-- Harga -->
        {{#if check_user}}{{else}}
          {{#if kelas.check_paid}}
            <div class='space-y-4'>
              <!-- Payment Type Toggle -->
              <div class='flex gap-2 p-1 bg-gray-100 rounded-xl'>
                <button
                  @click="paymentType = 'full'"
                  :class="paymentType === 'full' ? 'bg-white shadow-md' : 'bg-transparent'"
                  class='flex-1 py-2.5 px-4 rounded-lg font-semibold text-sm transition-all duration-300'
                >
                  <i class='fas fa-money-bill-wave mr-2'></i>
                  Full Payment
                </button>
                <button
                  @click="paymentType = 'installment'"
                  :class="paymentType === 'installment' ? 'bg-white shadow-md' : 'bg-transparent'"
                  class='flex-1 py-2.5 px-4 rounded-lg font-semibold text-sm transition-all duration-300'
                >
                  <i class='fas fa-calendar-alt mr-2'></i>
                  Installment
                </button>
              </div>

              <!-- Full Payment Display -->
              <div
                x-show="paymentType === 'full'"
                x-transition
                class='text-center space-y-2'
              >
                <!-- Harga coret -->
                <p class='text-lg text-gray-400 line-through'>
                  {{formatRupiah kelas.promo}}
                </p>

                <!-- Harga promo -->
                <p
                  class='text-4xl font-bold bg-gradient-to-r animate-pulse from-slate-700 to-slate-900 bg-clip-text text-transparent'
                >
                  {{formatRupiah kelas.harga}}
                </p>
                <p class='text-sm text-gray-600'>One-time payment</p>
              </div>

              <!-- Installment Payment Display -->
              <div
                x-show="paymentType === 'installment'"
                x-transition
                class='space-y-4'
              >
                <!-- Installment Options -->
                <div class='bg-white rounded-xl p-4 border-2 border-slate-200'>
                  <label
                    class='block text-sm font-semibold text-slate-700 mb-3'
                  >
                    <i class='fas fa-clock mr-2'></i>
                    Choose Installment Period
                  </label>
                  <div class='grid grid-cols-3 gap-2'>
                    {{#each kelas.cicilan}}
                      <button
                        @click='installmentMonths = {{this.bulan}}'
                        :class="installmentMonths === {{this.bulan}} ? 'bg-slate-700 text-white border-slate-700' : 'bg-white text-gray-700 border-gray-300'"
                        class='py-2 px-3 rounded-lg border-2 font-semibold text-sm transition-all duration-300 hover:border-slate-500'
                      >
                        {{this.bulan}} Months
                      </button>
                    {{/each}}
                  </div>
                </div>

                <!-- Installment Price Display -->
                <div
                  class='bg-gradient-to-br from-slate-700 to-slate-900 rounded-xl p-6 text-white'
                >
                  <p class='text-sm text-slate-300 mb-2'>First Month Payment</p>
                  <div class='flex items-baseline gap-2 mb-3'>
                    <span
                      class='text-4xl font-bold'
                      x-text='`Rp ${installmentAmount.toLocaleString("id-ID")}`'
                    ></span>
                    <span class='text-lg text-slate-300'>/month</span>
                  </div>
                  <div
                    class='flex items-center justify-between pt-3 border-t border-slate-600'
                  >
                    <div>
                      <p class='text-xs text-slate-300'>Total to Pay</p>
                      <p 
                        class='text-lg font-semibold'
                        x-text='`Rp ${totalCicilanAmount.toLocaleString("id-ID")}`'
                      ></p>
                    </div>
                    <div>
                      <p class='text-xs text-slate-300'>Duration</p>
                      <p
                        class='text-lg font-semibold'
                        x-text='installmentMonths + " Months"'
                      ></p>
                    </div>
                  </div>
                </div>

                <!-- Installment Info -->
                <div class='bg-amber-50 border border-amber-200 rounded-xl p-4'>
                  <div class='flex items-start gap-3'>
                    <i class='fas fa-info-circle text-amber-600 mt-1'></i>
                    <div class='text-sm text-amber-800'>
                      <p class='font-semibold mb-1'>Installment Information:</p>
                      <ul class='list-disc pl-4 space-y-1'>
                        <li>No additional fees or interest</li>
                        <li>Pay monthly as per schedule below</li>
                        <li>Full access after first payment</li>
                      </ul>
                    </div>
                  </div>
                </div>

                <!-- Monthly Payment Breakdown -->
                <div class='bg-white rounded-xl p-4 border-2 border-slate-200'>
                  <h4 class='font-semibold text-slate-700 mb-3 flex items-center gap-2'>
                    <i class='fas fa-list-ul'></i>
                    Payment Schedule
                  </h4>
                  <div class='space-y-2'>
                    <template x-for='(amount, index) in getCicilanByMonth(installmentMonths)' :key='index'>
                      <div class='flex justify-between items-center py-2 px-3 bg-slate-50 rounded-lg'>
                        <span class='text-sm font-medium text-slate-600' x-text='`Month ${index + 1}`'></span>
                        <span class='text-sm font-bold text-slate-900' x-text='`Rp ${amount.toLocaleString("id-ID")}`'></span>
                      </div>
                    </template>
                  </div>
                  <div class='mt-3 pt-3 border-t border-slate-200 flex justify-between items-center'>
                    <span class='text-sm font-bold text-slate-700'>Total Amount:</span>
                    <span class='text-lg font-bold text-slate-900' x-text='`Rp ${totalCicilanAmount.toLocaleString("id-ID")}`'></span>
                  </div>
                </div>
              </div>
            </div>
          {{else}}
            <!-- Free Class Display -->
