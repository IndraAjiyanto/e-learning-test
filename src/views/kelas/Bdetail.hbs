                    </div>
                    <input
                      type='file'
                      name='file'
                      required
                      accept='image/jpeg,image/jpg,image/png'
                      @change='validateFile($event)'
                      :class="fileError ? 'border-red-500 focus:border-red-500 focus:ring-red-200' : isValidFile ? 'border-green-500 focus:border-green-500 focus:ring-green-200' : 'border-slate-300'"
                      class='w-full bg-white p-3 focus:ring-2 transition-all border border-slate-300 rounded-xl px-5 py-4 bg-white/70 hover:bg-white focus:outline-none focus:ring-slate-500 focus:border-slate-400 duration-300 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200'
                    />
                    
                    <!-- Error Message -->
                    <div x-show='fileError' x-transition class='mt-2'>
                      <p class='text-xs text-red-600 flex items-start gap-1'>
                        <i class='fas fa-exclamation-circle mt-0.5'></i>
                        <span x-text='fileError'></span>
                      </p>
                    </div>

                    <!-- Success Message -->
                    <div x-show='isValidFile && !fileError' x-transition class='mt-2'>
                      <p class='text-xs text-green-600 flex items-center gap-1'>
                        <i class='fas fa-check-circle'></i>
                        <span>{{t "test.detailProgram.fullPayment.successValidationUpload"}}</span>
                      </p>
                    </div>
                  </div>

                  <!-- Preview -->
                  <template x-if='previewUrl && isValidFile'>
                    <div class='mt-3'>
                      <p class='text-xs text-slate-500 mb-2'>{{t "test.detailProgram.fullPayment.priview"}}</p>
                      <img
                        :src='previewUrl'
                        alt='Preview'
                        class='rounded-xl border-2 border-green-200 max-h-48 w-full object-contain'
                      />
                    </div>
                  </template>

                  <button
                    type='submit'
                    :disabled='(fileError || waError) || (!isValidFile && fileInputTouched) || (!isValidWa && waInputTouched)'
                    :class="((fileError || waError) || (!isValidFile && fileInputTouched) || (!isValidWa && waInputTouched)) ? 'opacity-50 cursor-not-allowed' : 'hover:from-slate-800 hover:to-slate-950 transform hover:-translate-y-1'"
                    class='w-full bg-gradient-to-r from-slate-700 to-slate-900 text-white py-4 px-6 rounded-xl font-semibold transition-all duration-300 shadow-lg hover:shadow-xl'
                  >
                    <i class='fas fa-credit-card mr-2'></i>
                    <span>{{t "test.detailProgram.fullPayment.buttonSubmitProof"}}</span>
                  </button>
                </form>

                <!-- Installment Payment Form -->
                <template x-for="cicilan in cicilanData" :key="cicilan.bulan">
                  <form
                    x-show="paymentType === 'installment' && installmentMonths === cicilan.bulan"
                    :action="`/pembayarans/{{user.id}}/{{kelas.id}}/${cicilan.id}`"
                    enctype='multipart/form-data'
                    method='post'
                    class='space-y-4'
                  >
                    <!-- Installment Payment Summary Badge -->
                    <div
                      class='bg-slate-100 border border-slate-300 rounded-xl p-4'
                    >
                      <div class='flex items-center justify-between'>
                        <div>
                          <p
                            class='text-xs font-semibold text-slate-600 uppercase'
                          >{{t "test.detailProgram.installment.paymentType"}}</p>
                          <p
                            class='text-sm font-bold text-slate-900'
                            x-text="`Installment (${cicilan.bulan} months)`"
                          ></p>
                        </div>
                        <div class='text-right'>
                          <p
                            class='text-xs font-semibold text-slate-600 uppercase'
                          >{{t "test.detailProgram.installment.firstPaymentProgram"}}</p>
                          <p
                            class='text-sm font-bold text-slate-900'
                            x-text="`Rp ${cicilan.harga[0]?.toLocaleString('id-ID') || 0}`"
                          ></p>
                        </div>
                      </div>
                    </div>

                    <!-- WhatsApp Number Input -->
                    <div>
                      <label
                        class='block text-sm font-semibold text-slate-700 mb-2'
                      >
                        <i class='fab fa-whatsapp mr-2 text-green-500'></i>
                        {{t "test.detailProgram.installment.whatsAppNumber"}}
                        <span class='text-red-500'>*</span>
                      </label>
                      <div
                        class='bg-blue-50 border border-blue-200 rounded-lg p-2 mb-2'
                      >
                        <p class='text-xs text-blue-700'>
                          <i class='fas fa-info-circle mr-1'></i>
                          {{t "test.detailProgram.installment.spanWhatsApp"}}
                        </p>
                      </div>
                      <input
                        type='text'
                        name='no'
                        required
                        placeholder='e.g. 08123456789 or 628123456789'
                        @input='validateWa($event)'
                        :class="waError ? 'border-red-500 focus:border-red-500 focus:ring-red-200' : isValidWa ? 'border-green-500 focus:border-green-500 focus:ring-green-200' : 'border-slate-300'"
                        class='w-full bg-white border-2 rounded-xl px-4 py-3 focus:ring-2 transition-all'
                      />
                      
                      <!-- Error Message -->
                      <div x-show='waError' x-transition class='mt-2'>
                        <p class='text-xs text-red-600 flex items-start gap-1'>
                          <i class='fas fa-exclamation-circle mt-0.5'></i>
                          <span x-text='waError'></span>
                        </p>
                      </div>

                      <!-- Success Message -->
                      <div x-show='isValidWa && !waError' x-transition class='mt-2'>
                        <p class='text-xs text-green-600 flex items-center gap-1'>
                          <i class='fas fa-check-circle'></i>
                          <span>{{t "test.detailProgram.installment.validWhatsApp"}}</span>
                        </p>
                      </div>

                      <!-- Helper Text -->
                      <p class='text-xs text-slate-500 mt-1' x-show='!waError && !isValidWa'>
                        <i class='fas fa-info-circle mr-1'></i>
                        {{t "test.detailProgram.installment.spanValidWhatsApp"}}
                      </p>
                    </div>

                    <div>
                      <label
                        class='block text-sm font-semibold text-slate-700 mb-2'
                      >
                        <i class='fas fa-receipt mr-2'></i>
                        {{t "test.detailProgram.installment.uploadPaymentProof"}}
                        <span class='text-blue-600'>{{t "test.detailProgram.installment.firstInstallment"}}</span>
                        <span class='text-red-500'>*</span>
                      </label>
                      <div
                        class='bg-blue-50 border border-blue-200 rounded-lg p-2 mb-2'
                      >
                        <p class='text-xs text-blue-700'>
                          <i class='fas fa-info-circle mr-1'></i>
                          {{t "test.detailProgram.installment.spanUploadFilePayment"}}
                        </p>
                      </div>
                      <input
                        type='file'
                        name='file'
                        required
                        accept='image/jpeg,image/jpg,image/png'
                        @change='validateFile($event)'
                        :class="fileError ? 'border-red-500 focus:border-red-500 focus:ring-red-200' : isValidFile ? 'border-green-500 focus:border-green-500 focus:ring-green-200' : 'border-slate-300'"
                        class='w-full bg-white p-3 focus:ring-2 transition-all border border-slate-300 rounded-xl px-5 py-4 bg-white/70 hover:bg-white focus:outline-none focus:ring-slate-500 focus:border-slate-400 duration-300 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200'
                      />
                      
                      <!-- Error Message -->
                      <div x-show='fileError' x-transition class='mt-2'>
                        <p class='text-xs text-red-600 flex items-start gap-1'>
                          <i class='fas fa-exclamation-circle mt-0.5'></i>
                          <span x-text='fileError'></span>
                        </p>
                      </div>

                      <!-- Success Message -->
                      <div x-show='isValidFile && !fileError' x-transition class='mt-2'>
                        <p class='text-xs text-green-600 flex items-center gap-1'>
                          <i class='fas fa-check-circle'></i>
                          <span>{{t "test.detailProgram.installment.successValidationUpload"}}</span>
                        </p>
                      </div>
                    </div>

                    <!-- Preview -->
                    <template x-if='previewUrl && isValidFile'>
                      <div class='mt-3'>
                        <p class='text-xs text-slate-500 mb-2'>{{t "test.detailProgram.installment.preview"}}</p>
                        <img
                          :src='previewUrl'
                          alt='Preview'
                          class='rounded-xl border-2 border-green-200 max-h-48 w-full object-contain'
                        />
                      </div>
                    </template>

                    <button
                      type='submit'
                      :disabled='(fileError || waError) || (!isValidFile && fileInputTouched) || (!isValidWa && waInputTouched)'
                      :class="((fileError || waError) || (!isValidFile && fileInputTouched) || (!isValidWa && waInputTouched)) ? 'opacity-50 cursor-not-allowed' : 'hover:from-slate-800 hover:to-slate-950 transform hover:-translate-y-1'"
                      class='w-full bg-gradient-to-r from-slate-700 to-slate-900 text-white py-4 px-6 rounded-xl font-semibold transition-all duration-300 shadow-lg hover:shadow-xl'
                    >
                      <i class='fas fa-calendar-check mr-2'></i>
                      <span x-text="`{{t "test.detailProgram.installment.buttonSubmitProof"}} (${cicilan.bulan} {{t "test.detailProgram.installment.months"}})`"></span>
                    </button>
                  </form>
                </template>
              {{/if}}
            {{else}}
              {{#if (check daftar kelas.kuota)}}
                <!-- Free Class Registration Form -->
                <form
                  action="/pendaftaran/{{user.id}}/{{kelas.id}}"
                  enctype='multipart/form-data'
                  method='post'
                  class='space-y-4'
                >
                  <!-- Free Registration Badge -->
                  <div
                    class='bg-gradient-to-r from-emerald-100 to-green-100 border-2 border-emerald-300 rounded-xl p-4'
                  >
                    <div class='flex items-center justify-center gap-3'>
                      <i class='fas fa-gift text-emerald-600 text-2xl'></i>
                      <div>
                        <p
                          class='text-xs font-semibold text-emerald-600 uppercase'
                        >{{t "test.detailProgram.free.registrationType"}}</p>
                        <p class='text-sm font-bold text-emerald-800'>{{t "test.detailProgram.free.freeProgram"}}</p>
                      </div>
                    </div>
                  </div>

                  <div>
                    <label
                      class='block text-sm font-semibold text-slate-700 mb-2'
                    >
                      <i class='fas fa-file-image mr-2'></i>
                      {{t "test.detailProgram.free.uploadRegistrationScreenshot"}}
                      <span class='text-red-500'>*</span>
                    </label>
                    <div
                      class='bg-emerald-50 border border-emerald-200 rounded-lg p-3 mb-2'
                    >
                      <p class='text-xs text-emerald-700'>
                        <i class='fas fa-info-circle mr-1'></i>
                        {{t "test.detailProgram.free.validationUploadFile"}}
                      </p>
                    </div>
                    <input
                      type='file'
                      name='file'
                      required
                      accept='image/jpeg,image/jpg,image/png'
                      @change='validateFile($event)'
                      :class="fileError ? 'border-red-500 focus:border-red-500 focus:ring-red-200' : isValidFile ? 'border-emerald-500 focus:border-emerald-500 focus:ring-emerald-200' : 'border-emerald-300'"
                      class='w-full bg-white p-3 focus:ring-2 transition-all border border-slate-300 rounded-xl px-5 py-4 bg-white/70 hover:bg-white focus:outline-none focus:ring-slate-500 focus:border-slate-400 duration-300 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200'
                    />
                    
                    <!-- Error Message -->
                    <div x-show='fileError' x-transition class='mt-2'>
                      <p class='text-xs text-red-600 flex items-start gap-1'>
                        <i class='fas fa-exclamation-circle mt-0.5'></i>
                        <span x-text='fileError'></span>
                      </p>
                    </div>

                    <!-- Success Message -->
                    <div x-show='isValidFile && !fileError' x-transition class='mt-2'>
                      <p class='text-xs text-emerald-600 flex items-center gap-1'>
                        <i class='fas fa-check-circle'></i>
                        <span>{{t "test.detailProgram.free.validationFileSuccess"}}</span>
                      </p>
                    </div>
                  </div>

                  <!-- Preview -->
                  <template x-if='previewUrl && isValidFile'>
                    <div class='mt-3'>
                      <p class='text-xs text-slate-500 mb-2'>{{t "test.detailProgram.free.preview"}}</p>
                      <img
                        :src='previewUrl'
                        alt='Preview'
                        class='rounded-xl border-2 border-emerald-200 max-h-48 w-full object-contain'
                      />
                    </div>
                  </template>

                  <button
                    type='submit'
                    :disabled='(fileError) || (!isValidFile && fileInputTouched)'
                    :class="((fileError) || (!isValidFile && fileInputTouched)) ? 'opacity-50 cursor-not-allowed' : 'hover:from-emerald-600 hover:to-green-700 transform hover:-translate-y-1'"
                    class='w-full bg-gradient-to-r from-emerald-500 to-green-600 text-white py-4 px-6 rounded-xl font-semibold transition-all duration-300 shadow-lg hover:shadow-xl'
                  >
                    <i class='fas fa-user-plus mr-2'></i>
                    {{t "test.detailProgram.free.buttonSubmitRegistration"}}
                  </button>
                </form>
              {{/if}}
            {{/if}}

          {{/if}}
        {{else}}
          <a
            href='/login'
            class='block w-full bg-gradient-to-r from-slate-700 to-slate-900 text-white py-4 px-6 rounded-xl font-semibold hover:from-slate-800 hover:to-slate-950 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1 text-center'
          >
            <i class='fas fa-sign-in-alt mr-2'></i>
            {{t "test.detailProgram.loginToEnroll"}}
          </a>
        {{/if}}
      </div>
    </aside>
  </div>

  <!-- Related Courses -->
  <div class='max-w-7xl mx-auto px-6 mt-16'>
    <h2
      class='font-montserrat text-3xl font-bold mb-8 text-slate-900 bg-gradient-to-r from-slate-700 to-slate-900 bg-clip-text text-transparent'
    >{{t "test.detailProgram.otherProgram"}}</h2>

    <div
      class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto'
      x-data="{ getQuotaPercentage(enrolled, total) { return total > 0 ? Math.min((enrolled / total) * 100, 100) : 0; } }"
    >
      {{#each kelass}}
        <div
          class='group card bg-white shadow-2xl border-0 rounded-2xl overflow-hidden transition-all duration-300 transform hover:-translate-y-2 hover:shadow-3xl'
          data-kategori='{{kategori.nama_kategori}}'
          data-category='{{ jenis_kelas.nama_jenis_kelas }}'
          data-nama='{{nama_kelas}}'
          data-deskripsi='{{getByLang deskripsi ../lang}}'
          data-location='{{metode}}'
        >
          <!-- Gambar lebih besar -->
          <img
            src='{{gambar}}'
            alt='{{nama_kelas}}'
            class='h-full w-auto object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-lg'
          />

          <div class='card-body p-6'>
            <div class='flex gap-2 mb-3'>
              <span
                class='badge bg-slate-100 text-slate-700 px-3 py-1 text-xs font-semibold rounded-full'
              >
                {{kategori.nama_kategori}}
              </span>
              <span
                class='badge bg-gradient-to-r from-slate-500 to-slate-600 text-white px-3 py-1 text-xs font-semibold rounded-full'
              >
                {{ jenis_kelas.nama_jenis_kelas }}
              </span>

            </div>

            <div class='flex flex-wrap gap-2 mb-4 text-sm text-gray-700'>
              <div
                class='flex items-center gap-2 bg-gray-100 px-3 py-1 rounded-full'
              >
                <i class='fas fa-laptop text-slate-500'></i>
                <span>{{metode}}</span>
              </div>
              <div
                class='flex items-center gap-2 bg-gray-100 px-3 py-1 rounded-full'
              >
                <i class='fas fa-user-tie text-slate-500'></i>
                <span>{{getByLang lokasi ../lang}}</span>
              </div>
            </div>

            <h2
              class='card-title text-gray-900 text-xl font-bold mb-3'
            >{{nama_kelas}}</h2>

            <p class='text-sm text-gray-600 line-clamp-1 mb-4 leading-relaxed'>
              {{getByLang deskripsi ../lang}}
            </p>

            <div
              class='bg-gradient-to-br from-slate-50 to-slate-100 rounded-lg p-4 mb-4 border border-slate-200'
            >
              <div class='flex items-center justify-between mb-3'>
                <div class='flex items-center gap-2'>
                  <i class='fas fa-users text-slate-600 animate-pulse'></i>
                  <span class='text-sm font-medium text-slate-600'>{{t "test.detailProgram.kuota"}}</span>
                </div>
                <span
                  class='text-sm font-bold text-slate-800 bg-white px-3 py-1 rounded-full shadow-sm'
                >
                  {{user_kelas.length}}
                  /
                  {{kuota}}
                  {{t "test.detailProgram.student"}}
                </span>
              </div>

              <div
                class='w-full bg-slate-200 rounded-full h-2 overflow-hidden mb-2'
              >
                <div
                  class='h-2 rounded-full bg-gradient-to-r from-green-400 to-green-600 transition-all duration-500 ease-out'
                  :style='`width: ${getQuotaPercentage({{user_kelas.length}}, {{kuota}})}%`'
                >
                </div>
              </div>

            </div>

  <div class='card-actions'>
    <a
      href='/kelass/{{id}}'
      class='btn bg-gradient-to-r from-slate-600 to-slate-800 hover:from-slate-500 hover:to-slate-700 text-white text-lg px-8 py-3 w-full border-0 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex justify-center items-center text-center'
    >
      {{t "test.detailProgram.buttonViewProgram"}}
    </a>
  </div>
          </div>
        </div>
      {{/each}}

    </div>
  </div>
</div>
