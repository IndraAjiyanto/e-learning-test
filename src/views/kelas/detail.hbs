<div class='max-w-7xl mx-auto px-6 py-10 pt-28'>
  <div class='grid grid-cols-1 lg:grid-cols-12 gap-6'>
    <!-- Left Sidebar - Class Info (Sticky) -->
    <div class='lg:col-span-4'>
{{> program_detail/left_content/program_info}}
    </div>

    <!-- Right Content - Weeks List -->
    <div class='lg:col-span-8'>
      <div class='mb-6'>
        <h2 class='text-2xl font-bold text-slate-900 mb-2 font-montserrat'>
          {{t 'test.startLearning.startLearning'}}
        </h2>
        <p class='text-slate-600 text-sm'>
          {{t 'test.startLearning.spanStartLearning'}}
        </p>
      </div>

      <div class='space-y-4'>
        {{#each minggu}}
          {{#if progres_minggu.[0].proses}}
            <!-- Week Design (Completed or In Progress) -->
            <div
              x-data="{
                openMinggu: localStorage.getItem(`open-minggu-{{this.id}}`) === 'true',
                pertemuanData: localStorage.getItem(`pertemuan-data-{{this.id}}`) ? JSON.parse(localStorage.getItem(`pertemuan-data-{{this.id}}`)) : [],
                quizData: localStorage.getItem(`quiz-data-{{this.id}}`) ? JSON.parse(localStorage.getItem(`quiz-data-{{this.id}}`)) : [],
                loading: false,
                error: null,
                dataLoaded: false,

                  async init() {
          const pertemuanResponse = await fetch('/kelass/pertemuan/{{this.id}}');
          const quizResponse = await fetch('/kelass/quiz/{{this.id}}');

          this.pertemuanData = await pertemuanResponse.json();
      localStorage.setItem(`pertemuan-data-{{this.id}}`, JSON.stringify(this.pertemuanData));

          this.quizData = await quizResponse.json();
      localStorage.setItem(`quiz-data-{{this.id}}`, JSON.stringify(this.quizData));
          this.dataLoaded = true;
    },
                
                async toggleAndFetch() {
                  this.openMinggu = !this.openMinggu;
                  localStorage.setItem(`open-minggu-{{this.id}}`, this.openMinggu);
                  
                  // Fetch data hanya jika dibuka dan belum pernah di-load
                  if (this.openMinggu && !this.dataLoaded) {
                    await this.fetchData();
                  }
                },
                
                async fetchData() {
                  this.loading = true;
                  this.error = null;
                  
                  try {
                    // Fetch pertemuan dan quiz secara parallel
                    const [pertemuanResponse, quizResponse] = await Promise.all([
                      fetch('/kelass/pertemuan/{{this.id}}'),
                      fetch('/kelass/quiz/{{this.id}}')
                    ]);
                    
                    if (!pertemuanResponse.ok || !quizResponse.ok) {
                      throw new Error('Failed to fetch data');
                    }
                    
                    this.pertemuanData = await pertemuanResponse.json();
                    this.quizData = await quizResponse.json();
                    localStorage.setItem(`pertemuan-data-{{this.id}}`, JSON.stringify(this.pertemuanData));
                    localStorage.setItem(`quiz-data-{{this.id}}`, JSON.stringify(this.quizData));
                    this.dataLoaded = true;
                  } catch (err) {
                    this.error = err.message;
                    console.error('Error fetching data:', err);
                  } finally {
                    this.loading = false;
                  }
                }
              }"
              class='border border-gray-200 rounded-xl shadow-md bg-white overflow-hidden hover:shadow-lg transition-all duration-300'
              x-init='init()'
            >
{{> program_detail/right_content/week/button_week}}

              <div
                x-show='openMinggu'
                x-collapse
                class='px-5 pb-5 bg-gray-50/50'
              >
                <!-- Loading State -->
                <div
                  x-show='loading'
                  class='flex items-center justify-center py-8'
                >
                  <div class='flex items-center space-x-2'>
                    <svg
                      class='animate-spin h-5 w-5 text-slate-600'
                      xmlns='http://www.w3.org/2000/svg'
                      fill='none'
                      viewBox='0 0 24 24'
                    >
                      <circle
                        class='opacity-25'
                        cx='12'
                        cy='12'
                        r='10'
                        stroke='currentColor'
                        stroke-width='4'
                      ></circle>
                      <path
                        class='opacity-75'
                        fill='currentColor'
                        d='M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z'
                      ></path>
                    </svg>
                    <span class='text-slate-600 text-sm font-medium'>Loading
                      data...</span>
                  </div>
                </div>

                <!-- Error State -->
                <div
                  x-show='error'
                  class='mt-4 p-4 bg-red-50 border border-red-200 rounded-lg'
                >
                  <div class='flex items-center'>
                    <svg
                      class='w-5 h-5 text-red-600 mr-2'
                      fill='none'
                      stroke='currentColor'
                      viewBox='0 0 24 24'
                    >
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='2'
                        d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                      />
                    </svg>
                    <p class='text-sm text-red-800' x-text='error'></p>
                  </div>
                </div>

                <!-- Content State -->
                <div
                  x-show='!loading && !error && dataLoaded'
                  class='space-y-3 mt-4'
                >
                  <!-- Sessions List -->
                  <template
                    x-for='pertemuan in pertemuanData'
                    :key='pertemuan.id'
                  >
                    <div>

                      <template
                        x-if='pertemuan.progres_pertemuan.length > 0 && pertemuan.progres_pertemuan[0].absen === true'
                      >
                        <div
                          x-data="{
    open: localStorage.getItem(`open-pertemuan-${pertemuan.id}`) === 'true'
  }"
                          @click.away='open = false; localStorage.setItem(`open-pertemuan-${pertemuan.id}`, false)'
                          class='border border-gray-200 rounded-lg shadow-md bg-white overflow-hidden'
                        >

{{> program_detail/right_content/week/session/button_session}}

                          <div
                            x-show='open'
                            x-collapse
                            class='px-4 pb-4 bg-gradient-to-b from-white to-gray-50/50'
                          >
                            <!-- Attendance Check -->
                            <template x-if='pertemuan.attendance.length > 0'>
                              <div>

{{> program_detail/right_content/week/session/attendance_status}}

{{> program_detail/right_content/week/session/materi_section}}

{{> program_detail/right_content/week/session/assigment_section}}

{{> program_detail/right_content/week/session/logbook_section}}
                              </div>
                            </template>

{{> program_detail/right_content/week/session/attendance_noYet}}
                          </div>
                        </div>
                      </template>

                      
{{> program_detail/right_content/week/session/locked_session}}
                    </div>
                  </template>

{{> program_detail/right_content/week/quiz}}
                </div>
              </div>
            </div>

          {{else}}
{{> program_detail/right_content/week/locked_week}}
          {{/if}}
        {{/each}}
      </div>
      {{#if user_kelas.progres}}
{{> program_detail/right_content/portfolio}}
      {{/if}}
    </div>
  </div>
</div>