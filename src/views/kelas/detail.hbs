<div class="max-w-7xl mx-auto px-6 py-10 pt-28">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Left Sidebar - Class Info (Sticky) -->
    <div class="lg:col-span-4">
      <div class="bg-white rounded-xl shadow-md border border-slate-200 overflow-hidden sticky top-24">
        <div class="p-5">
          <!-- Gambar Kelas -->
          <div class="mb-4">
            <div class="relative rounded-lg overflow-hidden">
              <img 
                src="{{kelas.gambar}}" 
                alt="{{kelas.nama_kelas}}" 
                class="w-full h-40 object-cover hover:scale-110 transition-transform duration-500"
              />
            </div>
          </div>
          
          <!-- Badges -->
          <div class="flex flex-wrap gap-2 mb-3">
            <span class="badge bg-slate-100 text-slate-700 px-3 py-1 text-xs font-semibold rounded-md border border-slate-200">
              {{kelas.kategori.nama_kategori}}
            </span>
            <span class="badge bg-gradient-to-r from-slate-500 to-slate-600 text-white px-3 py-1 text-xs font-semibold rounded-md">
              {{kelas.jenis_kelas.nama_jenis_kelas}}
            </span>
          </div>
          
          <!-- Content -->
          <div class="mb-3">
            <h1 class="text-xl font-bold text-slate-900 mb-2 leading-tight font-montserrat">
              {{kelas.nama_kelas}}
            </h1>
            <p class="text-sm text-justify text-slate-600 leading-relaxed">
              {{getByLang kelas.deskripsi lang}}
            </p>
          </div>

          <!-- Actions -->
          <div class="card-actions">
            <a
              href="{{kelas.grup}}"
              target="_blank"
              rel="noopener noreferrer"
              class="btn bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-500 hover:to-blue-700 text-white text-lg px-8 py-3 w-full border-0 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 mb-3"
            >
              <i class="fa-solid fa-users"></i>
              {{t "test.startLearning.joinGroup"}}
            </a>
            <a
              href="/logbook/user/{{kelas.id}}"
              class="btn bg-gradient-to-r from-green-600 to-green-800 hover:from-green-500 hover:to-green-700 text-white text-lg px-8 py-3 w-full border-0 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 mb-3"
            >
              <i class="fa-solid fa-book"></i>
              {{t "test.startLearning.myLogbook"}}
            </a>
            <a
              href="/kelass/detail/{{kelas.id}}"
              class="btn bg-gradient-to-r from-slate-600 to-slate-800 hover:from-slate-500 hover:to-slate-700 text-white text-lg px-8 py-3 w-full border-0 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1"
            >
              <i class="fa-solid fa-circle-info"></i>
              {{t "test.startLearning.detailProgram"}}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Content - Weeks List -->
    <div class="lg:col-span-8">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-900 mb-2 font-montserrat">
          {{t "test.startLearning.startLearning"}}
        </h2>
        <p class="text-slate-600 text-sm font-inter">
          {{t "test.startLearning.spanStartLearning"}}
        </p>
      </div>

      <div class="space-y-4">
        {{#each minggu}}
          {{#if progres_minggu.[0].proses}}
            <!-- Week Design (Completed or In Progress) -->
            <div 
              x-data="{
                openMinggu: localStorage.getItem(`open-minggu-{{this.id}}`) === 'true',
                pertemuanData: localStorage.getItem(`pertemuan-data-{{this.id}}`) ? JSON.parse(localStorage.getItem(`pertemuan-data-{{this.id}}`)) : [],
                quizData: localStorage.getItem(`quiz-data-{{this.id}}`) ? JSON.parse(localStorage.getItem(`quiz-data-{{this.id}}`)) : [],
                loading: false,
                error: null,
                dataLoaded: false,

                  async init() {

          const pertemuanResponse = await fetch('/kelass/pertemuan/{{this.id}}');
          const quizResponse = await fetch('/kelass/quiz/{{this.id}}');

          this.pertemuanData = await pertemuanResponse.json();
      localStorage.setItem(`pertemuan-data-{{this.id}}`, JSON.stringify(this.pertemuanData));

          this.quizData = await quizResponse.json();
      localStorage.setItem(`quiz-data-{{this.id}}`, JSON.stringify(this.quizData));
          this.dataLoaded = true;
    },
                
                async toggleAndFetch() {
                  this.openMinggu = !this.openMinggu;
                  localStorage.setItem(`open-minggu-{{this.id}}`, this.openMinggu);
                  
                  // Fetch data hanya jika dibuka dan belum pernah di-load
                  if (this.openMinggu && !this.dataLoaded) {
                    await this.fetchData();
                  }
                },
                
                async fetchData() {
                  this.loading = true;
                  this.error = null;
                  
                  try {
                    // Fetch pertemuan dan quiz secara parallel
                    const [pertemuanResponse, quizResponse] = await Promise.all([
                      fetch('/kelass/pertemuan/{{this.id}}'),
                      fetch('/kelass/quiz/{{this.id}}')
                    ]);
                    
                    if (!pertemuanResponse.ok || !quizResponse.ok) {
                      throw new Error('Failed to fetch data');
                    }
                    
                    this.pertemuanData = await pertemuanResponse.json();
                    this.quizData = await quizResponse.json();
                    localStorage.setItem(`pertemuan-data-{{this.id}}`, JSON.stringify(this.pertemuanData));
                    localStorage.setItem(`quiz-data-{{this.id}}`, JSON.stringify(this.quizData));
                    this.dataLoaded = true;
                  } catch (err) {
                    this.error = err.message;
                    console.error('Error fetching data:', err);
                  } finally {
                    this.loading = false;
                  }
                }
              }"
              class="border border-gray-200 rounded-xl shadow-md bg-white overflow-hidden hover:shadow-lg transition-all duration-300" x-init="init()"
            >
              <button 
                @click="toggleAndFetch()" 
                class="w-full flex justify-between items-center px-5 py-3 bg-gradient-to-r from-white to-slate-50 hover:from-slate-50 hover:to-slate-100 transition-all duration-300 text-left group"
              >
                <div class="flex items-center space-x-3">
                  <div>
                    <div class="flex items-center gap-2">
                      <h2 class="font-bold text-base text-gray-900 group-hover:text-slate-700 transition-colors font-montserrat">
                        {{t "test.startLearning.week"}} {{this.minggu_ke}} : {{this.keterangan}}
                      </h2>
                      {{#if progres_minggu.[0].quiz}}
                        <span class="bg-gradient-to-r from-green-100 to-green-200 text-green-800 shadow-sm text-xs px-2 py-0.5 rounded-full font-semibold font-inter">
                          {{t "test.startLearning.completed"}}
                        </span>
                      {{/if}}
                    </div>
                    <p class="text-xs text-gray-500 mt-0.5 font-inter">
                      {{#if progres_minggu.[0].quiz}}
                        {{t "test.startLearning.clickToReview"}}
                      {{else}}
                        {{t "test.startLearning.clickToExpandWeek"}}
                      {{/if}}
                    </p>
                  </div>
                </div>
                <svg 
                  :class="{'rotate-180': openMinggu, 'text-slate-600': openMinggu}" 
                  class="w-5 h-5 text-gray-400 transition-all duration-300 group-hover:text-slate-600" 
                  fill="none" 
                  stroke="currentColor" 
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>

              <div x-show="openMinggu" x-collapse class="px-5 pb-5 bg-gray-50/50">
                <!-- Loading State -->
                <div x-show="loading" class="flex items-center justify-center py-8">
                  <div class="flex items-center space-x-2">
                    <svg class="animate-spin h-5 w-5 text-slate-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span class="text-slate-600 text-sm font-medium">Loading data...</span>
                  </div>
                </div>

                <!-- Error State -->
                <div x-show="error" class="mt-4 p-4 bg-red-50 border border-red-200 rounded-lg">
                  <div class="flex items-center">
                    <svg class="w-5 h-5 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <p class="text-sm text-red-800" x-text="error"></p>
                  </div>
                </div>

                <!-- Content State -->
                <div x-show="!loading && !error && dataLoaded" class="space-y-3 mt-4">
                  <!-- Sessions List -->
                  <template x-for="pertemuan in pertemuanData" :key="pertemuan.id">
<div
  x-data="{
    open: localStorage.getItem(`open-pertemuan-${pertemuan.id}`) === 'true'
  }"
  @click.away="open = false; localStorage.setItem(`open-pertemuan-${pertemuan.id}`, false)"
  class="border border-gray-200 rounded-lg shadow-md bg-white overflow-hidden"
>

                      <button
  @click="
    open = !open;
    localStorage.setItem(`open-pertemuan-${pertemuan.id}`, open);
  "
  class="w-full flex justify-between items-center px-4 py-3 text-left"
>

                        <div class="flex items-center space-x-3">
                          <div>
                            <div class="flex items-center gap-2">
                              <h3 class="font-semibold text-sm text-gray-800 group-hover:text-slate-700 transition-colors" x-text="`{{t 'test.startLearning.session'}} ${pertemuan.pertemuan_ke} - ${pertemuan.topik}`"></h3>
                              <span x-show="pertemuan.progres_pertemuan?.[0]?.logbook" class="bg-gradient-to-r from-green-100 to-green-200 text-green-800 shadow-sm text-xs px-1.5 py-0.5 rounded-full font-semibold">
                                {{t "test.startLearning.completed"}}
                              </span>
                            </div>
                            <div class="flex items-center space-x-3 mt-0.5">
                              <p class="text-xs text-gray-500 flex items-center">
                                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                                <span x-text="new Date(pertemuan.tanggal).toLocaleDateString()"></span>
                              </p>
                              <p class="text-xs text-gray-500 flex items-center">
                                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                <span x-text="`${pertemuan.waktu_awal} - ${pertemuan.waktu_akhir}`"></span>
                              </p>
                            </div>
                          </div>
                        </div>
                        <svg 
                          :class="{'rotate-180': open, 'text-slate-600': open}" 
                          class="w-4 h-4 text-gray-400 transition-all duration-300 group-hover:text-slate-600" 
                          fill="none" 
                          stroke="currentColor" 
                          viewBox="0 0 24 24"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                      </button>

                      <div x-show="open" x-collapse class="px-4 pb-4 bg-gradient-to-b from-white to-gray-50/50">
                        <!-- Attendance Check -->
                        <template x-if="pertemuan.absen.length > 0">
                          <div>
                            <div class="flex items-center mb-4 mt-3">
                              <div class="flex items-center px-3 py-1.5 bg-gradient-to-r from-green-100 to-green-200 text-green-800 rounded-full text-xs font-semibold shadow-sm">
                                <svg class="w-3 h-3 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                {{t "test.startLearning.attendaceRecorded"}}
                              </div>
                            </div>

                            <!-- Materials Section -->
                            <div class="mb-4">
                              <h4 class="font-semibold text-gray-800 mb-3 flex items-center text-sm">
                                <svg class="w-4 h-4 mr-1.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                </svg>
                                {{t "test.startLearning.materials"}}
                              </h4>
                              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                <a :href="`/materis/pdf/${pertemuan.id}`" 
                                   class="group block bg-white border-2 border-slate-300 text-slate-700 rounded-lg shadow-md p-4 text-center hover:shadow-lg hover:-translate-y-1 hover:border-slate-400 hover:bg-slate-50 transform transition-all duration-300">
                                  <svg class="w-6 h-6 mx-auto mb-1.5 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                                  </svg>
                                  <span class="font-semibold text-xs">{{t "test.startLearning.pdfMaterial"}}</span>
                                </a>
                                <a :href="`/materis/video/${pertemuan.id}`" 
                                   class="group block bg-white border-2 border-slate-300 text-slate-700 rounded-lg shadow-md p-4 text-center hover:shadow-lg hover:-translate-y-1 hover:border-slate-400 hover:bg-slate-50 transform transition-all duration-300">
                                  <svg class="w-6 h-6 mx-auto mb-1.5 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293H15M9 10V9a2 2 0 012-2h2a2 2 0 012 2v1M9 10v5a2 2 0 002 2h2a2 2 0 002-2v-5"/>
                                  </svg>
                                  <span class="font-semibold text-xs">{{t "test.startLearning.videoLeassons"}}</span>
                                </a>
                                <a :href="`/materis/ppt/${pertemuan.id}`" 
                                   class="group block bg-white border-2 border-slate-300 text-slate-700 rounded-lg shadow-md p-4 text-center hover:shadow-lg hover:-translate-y-1 hover:border-slate-400 hover:bg-slate-50 transform transition-all duration-300">
                                  <svg class="w-6 h-6 mx-auto mb-1.5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2"/>
                                  </svg>
                                  <span class="font-semibold text-xs">{{t "test.startLearning.presentation"}}</span>
                                </a>
                              </div>
                            </div>

                            <!-- Assignment Section -->
                            <div class="mb-4">
                              <template x-for="tugas in pertemuan.tugas" :key="tugas.id">
                                <div>
                                  <template x-if="tugas.jawaban_tugas">
                                    <a 
                                      :href="`/jawaban-tugass/${pertemuan.id}/${tugas.id}`"
                                      class="group flex items-center justify-center px-5 py-2.5 text-center bg-gradient-to-r from-emerald-600 to-emerald-700 text-white rounded-lg shadow-md hover:shadow-lg hover:-translate-y-1 hover:from-emerald-500 hover:to-emerald-600 w-full transform transition-all duration-300 text-sm"
                                    >
                                      <svg class="w-4 h-4 mr-1.5 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                      </svg>
                                      <span class="font-semibold">{{t "test.startLearning.assignmentCompleted"}}</span>
                                    </a>
                                  </template>
                                  <template x-if="!tugas.jawaban_tugas">
                                    <a 
                                      :href="`/jawaban-tugass/${pertemuan.id}/${tugas.id}`"
                                      class="group flex items-center justify-center px-5 py-2.5 text-center bg-gradient-to-r from-slate-700 to-slate-800 text-white rounded-lg shadow-md hover:shadow-lg hover:-translate-y-1 hover:from-slate-600 hover:to-slate-700 w-full transform transition-all duration-300 text-sm"
                                    >
                                      <svg class="w-4 h-4 mr-1.5 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                                      </svg>
                                      <span class="font-semibold">{{t "test.startLearning.startAssignment"}}</span>
                                    </a>
                                  </template>
                                </div>
                              </template>
                            </div>

                            <!-- Logbook Section -->
                            <template x-if="pertemuan.logbook?.[0]?.proses === 'acc'">
                              <div class="mt-3">
                                <a :href="`/logbook/${pertemuan.logbook[0].id}`"
                                  class="group flex items-center justify-center w-full px-4 py-2.5 bg-gradient-to-r from-green-500 to-green-600 text-white text-center rounded-lg shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300 text-sm">
                                  <svg class="w-4 h-4 mr-1.5 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                  </svg>
                                  <span class="font-semibold">{{t "test.startLearning.viewApprovedLogBook"}}</span>
                                </a>
                              </div>
                            </template>
                            <template x-if="pertemuan.logbook?.[0]?.proses === 'rejected'">
                              <div class="mt-3">
                                <a :href="`/logbook/formEdit/${pertemuan.logbook[0].id}`"
                                  class="group flex items-center justify-center w-full px-4 py-2.5 bg-gradient-to-r from-red-500 to-red-600 text-white text-center rounded-lg shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300 text-sm">
                                  <svg class="w-4 h-4 mr-1.5 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                                  </svg>
                                  <span class="font-semibold">{{t "test.startLearning.updateRejectedLogBook"}}</span>
                                </a>
                              </div>
                            </template>
                            <template x-if="pertemuan.logbook?.[0]?.proses === 'proces'">
                              <div class="mt-3">
                                <a :href="`/logbook/${pertemuan.logbook[0].id}`"
                                  class="group flex items-center justify-center w-full px-4 py-2.5 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white text-center rounded-lg shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300 text-sm">
                                  <svg class="w-4 h-4 mr-1.5 group-hover:-translate-y-1 transition-transform animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                  </svg>
                                  <span class="font-semibold">{{t "test.startLearning.logBookUnderReview"}}</span>
                                </a>
                              </div>
                            </template>
                            <template x-if="!pertemuan.logbook?.[0] || (pertemuan.logbook?.[0]?.proses !== 'acc' && pertemuan.logbook?.[0]?.proses !== 'rejected' && pertemuan.logbook?.[0]?.proses !== 'proces')">
                              <div class="mt-3">
                                <a :href="`/logbook/formCreate/${pertemuan.id}/{{kelas.id}}`"
                                  class="group flex items-center justify-center w-full px-4 py-2.5 bg-gradient-to-r from-slate-700 to-slate-800 text-white text-center rounded-lg shadow-md hover:shadow-lg hover:-translate-y-1 hover:from-slate-600 hover:to-slate-700 transition-all duration-300 text-sm">
                                  <svg class="w-4 h-4 mr-1.5 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                                  </svg>
                                  <span class="font-semibold">{{t "test.startLearning.createLogBook"}}</span>
                                </a>
                              </div>
                            </template>
                          </div>
                        </template>

                        <!-- Attendance Required (Not yet attended) -->
                        <template x-if="pertemuan.absen.length === 0">
                          <div>
                            <div class="flex items-center mb-4 mt-3">
                              <div class="flex items-center px-3 py-1.5 bg-gradient-to-r from-red-100 to-red-200 text-red-800 rounded-full text-xs font-semibold shadow-sm">
                                <svg class="w-3 h-3 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                {{t "test.startLearning.attendanceRequired"}}
                              </div>
                            </div>

                            <a :href="`/absens/form/${pertemuan.id}`" 
                              class="group flex items-center justify-center w-full mb-4 px-4 py-2.5 bg-gradient-to-r from-slate-700 to-slate-800 text-white text-center rounded-lg shadow-md hover:shadow-lg hover:-translate-y-1 hover:from-slate-600 hover:to-slate-700 transition-all duration-300 text-sm">
                              <svg class="w-4 h-4 mr-1.5 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                              </svg>
                              <span class="font-semibold">{{t "test.startLearning.markAttendance"}}</span>
                            </a>

                            <!-- Locked Materials -->
                            <div class="opacity-50 pointer-events-none">
                              <h4 class="font-semibold text-gray-700 mb-3 flex items-center text-sm">
                                <svg class="w-4 h-4 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                                {{t "test.startLearning.materialsLocked"}}
                              </h4>
                              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                <div class="block bg-gray-200 text-gray-500 rounded-lg shadow p-4 text-center cursor-not-allowed">
                                  <svg class="w-6 h-6 mx-auto mb-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                                  </svg>
                                  <span class="font-semibold text-xs">{{t "test.startLearning.pdf"}}</span>
                                </div>
                                <div class="block bg-gray-200 text-gray-500 rounded-lg shadow p-4 text-center cursor-not-allowed">
                                  <svg class="w-6 h-6 mx-auto mb-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.586a1 1 0 01.707.293l2.414 2.414a1 1 0 00.707.293H15M9 10V9a2 2 0 012-2h2a2 2 0 012 2v1M9 10v5a2 2 0 002 2h2a2 2 0 002-2v-5"/>
                                  </svg>
                                  <span class="font-semibold text-xs">{{t "test.startLearning.video"}}</span>
                                </div>
                                <div class="block bg-gray-200 text-gray-500 rounded-lg shadow p-4 text-center cursor-not-allowed">
                                  <svg class="w-6 h-6 mx-auto mb-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2"/>
                                  </svg>
                                  <span class="font-semibold text-xs">{{t "test.startLearning.ppt"}}</span>
                                </div>
                              </div>
                            </div>
                          </div>
                        </template>
                      </div>
                    </div>
                  </template>

                  <!-- Week Quiz Section -->
                  <div class="mt-6 p-4 bg-gradient-to-r from-slate-50 to-slate-100 rounded-lg border border-slate-200">
                    <h4 class="font-semibold text-gray-800 mb-3 flex items-center text-sm">
                      <svg class="w-4 h-4 mr-1.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                      </svg>
                      {{t "test.startLearning.weekQuiz"}}
                    </h4>
                    
                    <template x-for="quiz in quizData" :key="quiz.id">
                      <div>
                        <template x-if="quiz.progres_quiz?.[0]?.proses">
                          <div>
                            <template x-if="quiz.pertanyaan?.length > 0">
                              <a :href="`/quiz/form/${quiz.id}`" 
                                 class="group flex items-center justify-center w-full text-center px-5 py-2.5 bg-gradient-to-r from-slate-700 to-slate-800 text-white rounded-lg shadow-md hover:shadow-lg hover:-translate-y-1 hover:from-slate-600 hover:to-slate-700 transform transition-all duration-300 text-sm">
                                <svg class="w-4 h-4 mr-1.5 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                </svg>
                                <span class="font-semibold">{{t "test.startLearning.takeQuiz"}}</span>
                              </a>
                            </template>
                            <template x-if="!quiz.pertanyaan?.length">
                              <div class="flex items-center justify-center p-3 bg-gray-100 rounded-lg">
                                <svg class="w-4 h-4 text-gray-400 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                <p class="text-gray-500 text-center text-xs font-medium">{{t "test.startLearning.quizNotAvailable"}}</p>
                              </div>
                            </template>
                          </div>
                        </template>
                        <template x-if="!quiz.progres_quiz?.[0]?.proses">
                          <div class="flex items-center p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                            <svg class="w-4 h-4 text-yellow-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                            <p class="text-xs text-yellow-800 font-medium">
                              {{t "test.startLearning.completeAllSessionsToAccessQuiz"}}
                            </p>
                          </div>
                        </template>
                      </div>
                    </template>
                  </div>
                </div>
              </div>
            </div>

          {{else}}
            <!-- Locked Week Design (unchanged) -->
            <div class="border border-gray-300 rounded-xl shadow-md bg-gradient-to-r from-gray-100 to-gray-200 overflow-hidden opacity-75">
              <div class="w-full flex justify-between items-center px-5 py-3 bg-gradient-to-r from-gray-200 to-gray-300">
                <div class="flex items-center space-x-3">
                  <div class="w-9 h-9 bg-gray-400 rounded-lg flex items-center justify-center text-white font-bold text-base">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                  </div>
                  <div>
                    <h2 class="font-bold text-base text-gray-600">
                      {{t "test.startLearning.week"}} {{this.minggu_ke}} : {{this.keterangan}}
                    </h2>
                    <p class="text-xs text-gray-500 mt-0.5">
                      {{t "test.startLearning.completePreviousRequirements"}}
                    </p>
                  </div>
                </div>
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
              </div>
              <div class="px-5 py-4 bg-gradient-to-r from-yellow-50 to-yellow-100 border-t border-yellow-200">
                <div class="flex items-center justify-center">
                  <svg class="w-4 h-4 text-yellow-600 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                  </svg>
                  <p class="text-yellow-800 text-center text-xs font-medium">
                    {{t "test.startLearning.previousWeekQuizRequirement"}}
                  </p>
                </div>
              </div>
            </div>
          {{/if}}
        {{/each}}
      </div>
    </div>
  </div>
</div>