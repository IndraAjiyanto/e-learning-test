<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<div class='pt-20 min-h-screen bg-white' x-data="{ activeSection: 'story' }">
  <div class='max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-12'>

    <div class='lg:hidden mb-6 -mx-4 sm:mx-0'>
      <div class='overflow-x-auto scrollbar-hide px-4 sm:px-0'>
        <nav class='flex space-x-2 min-w-max sm:min-w-0'>
          <button
            @click="activeSection = 'story'"
            :class="activeSection === 'story' ? 'bg-slate-700 text-white' : 'bg-slate-100 text-slate-600'"
            class='px-4 py-2.5 rounded-lg transition-all duration-200 flex items-center space-x-2 whitespace-nowrap text-sm font-medium'
          >
            <i class='fas fa-book-open text-xs'></i>
            <span>Story</span>
          </button>
          <button
            @click="activeSection = 'mission'"
            :class="activeSection === 'mission' ? 'bg-slate-700 text-white' : 'bg-slate-100 text-slate-600'"
            class='px-4 py-2.5 rounded-lg transition-all duration-200 flex items-center space-x-2 whitespace-nowrap text-sm font-medium'
          >
            <i class='fas fa-bullseye text-xs'></i>
            <span>Mission</span>
          </button>
          <button
            @click="activeSection = 'team'"
            :class="activeSection === 'team' ? 'bg-slate-700 text-white' : 'bg-slate-100 text-slate-600'"
            class='px-4 py-2.5 rounded-lg transition-all duration-200 flex items-center space-x-2 whitespace-nowrap text-sm font-medium'
          >
            <i class='fas fa-users text-xs'></i>
            <span>Team</span>
          </button>
          <button
            @click="activeSection = 'values'"
            :class="activeSection === 'values' ? 'bg-slate-700 text-white' : 'bg-slate-100 text-slate-600'"
            class='px-4 py-2.5 rounded-lg transition-all duration-200 flex items-center space-x-2 whitespace-nowrap text-sm font-medium'
          >
            <i class='fas fa-heart text-xs'></i>
            <span>Values</span>
          </button>
          <button
            @click="activeSection = 'contact'"
            :class="activeSection === 'contact' ? 'bg-slate-700 text-white' : 'bg-slate-100 text-slate-600'"
            class='px-4 py-2.5 rounded-lg transition-all duration-200 flex items-center space-x-2 whitespace-nowrap text-sm font-medium'
          >
            <i class='fas fa-envelope text-xs'></i>
            <span>Contact</span>
          </button>
        </nav>
      </div>
    </div>

    <div class='grid grid-cols-1 lg:grid-cols-4 gap-8'>
      <!-- Desktop Sidebar Navigation -->
      <div class='hidden lg:block lg:col-span-1'>
        <div class='sticky top-32 space-y-2'>
          <nav class='space-y-1'>
            <button
              @click="activeSection = 'story'"
              :class="activeSection === 'story' ? 'bg-slate-100 text-slate-700 border-l-4 border-slate-600' : 'text-slate-600 hover:text-slate-700 hover:bg-slate-50'"
              class='w-full text-left px-4 py-3 rounded-r-lg transition-all duration-200 flex items-center space-x-3'
            >
              <i class='fas fa-book-open text-sm'></i>
              <span>Our Story</span>
            </button>
            <button
              @click="activeSection = 'mission'"
              :class="activeSection === 'mission' ? 'bg-slate-100 text-slate-700 border-l-4 border-slate-600' : 'text-slate-600 hover:text-slate-700 hover:bg-slate-50'"
              class='w-full text-left px-4 py-3 rounded-r-lg transition-all duration-200 flex items-center space-x-3'
            >
              <i class='fas fa-bullseye text-sm'></i>
              <span>Mission & Vision</span>
            </button>
            <button
              @click="activeSection = 'team'"
              :class="activeSection === 'team' ? 'bg-slate-100 text-slate-700 border-l-4 border-slate-600' : 'text-slate-600 hover:text-slate-700 hover:bg-slate-50'"
              class='w-full text-left px-4 py-3 rounded-r-lg transition-all duration-200 flex items-center space-x-3'
            >
              <i class='fas fa-users text-sm'></i>
              <span>Our Team</span>
            </button>
            <button
              @click="activeSection = 'values'"
              :class="activeSection === 'values' ? 'bg-slate-100 text-slate-700 border-l-4 border-slate-600' : 'text-slate-600 hover:text-slate-700 hover:bg-slate-50'"
              class='w-full text-left px-4 py-3 rounded-r-lg transition-all duration-200 flex items-center space-x-3'
            >
              <i class='fas fa-heart text-sm'></i>
              <span>Our Values</span>
            </button>
            <button
              @click="activeSection = 'contact'"
              :class="activeSection === 'contact' ? 'bg-slate-100 text-slate-700 border-l-4 border-slate-600' : 'text-slate-600 hover:text-slate-700 hover:bg-slate-50'"
              class='w-full text-left px-4 py-3 rounded-r-lg transition-all duration-200 flex items-center space-x-3'
            >
              <i class='fas fa-envelope text-sm'></i>
              <span>Contact</span>
            </button>
          </nav>
        </div>
      </div>

      <div class='lg:col-span-3'>
        {{> tentang/story_tab}}

        {{> tentang/mission_tab}}

        {{> tentang/team_tab}}

        {{> tentang/values_tab}}

        {{> tentang/contact_tab}}
      </div>
    </div>
  </div>
