                      class='w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center hover:bg-slate-200 transition-colors'
                    >
                      <i class='fab fa-linkedin text-slate-600 text-sm'></i>
                    </a>
                    <a
                      href='#'
                      class='w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center hover:bg-slate-200 transition-colors'
                    >
                      <i class='fab fa-dribbble text-slate-600 text-sm'></i>
                    </a>
                  </div>
                </div>
              </div>
            {{/each}}

            <div
              class='bg-white border border-slate-200 rounded-xl sm:rounded-2xl p-4 sm:p-5 lg:p-6 transition-all duration-300 hover:shadow-lg hover:-translate-y-1'
            >
              <div
                class='w-16 h-16 sm:w-18 sm:h-18 lg:w-20 lg:h-20 bg-gradient-to-br from-slate-600 to-slate-800 rounded-full flex items-center justify-center mb-3 sm:mb-4 mx-auto'
              >
                <i
                  class='fas fa-user text-white text-lg sm:text-xl lg:text-2xl'
                ></i>
              </div>
            </div>
          </div>

          <div
            class='mt-8 sm:mt-10 lg:mt-12 bg-gradient-to-br from-slate-50 to-slate-100 p-5 sm:p-6 lg:p-8 rounded-xl sm:rounded-2xl border border-slate-200'
          >
            <h3
              class='text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 mb-3 sm:mb-4 text-center'
            >Join Our Team</h3>
            <p
              class='text-sm sm:text-base text-slate-600 text-center mb-4 sm:mb-6'
            >
              We're always looking for the best talents to join our mission of
              educating the nation through technology
            </p>
            <div class='text-center'>
              <a
                href='#'
                class='inline-flex items-center space-x-2 bg-gradient-to-r from-slate-600 to-slate-800 text-white px-5 py-2.5 sm:px-6 sm:py-3 rounded-lg hover:from-slate-700 hover:to-slate-900 transition-all duration-200 text-sm sm:text-base'
              >
                <i class='fas fa-briefcase text-sm'></i>
                <span>View Job Openings</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Values Section -->
        <div
          x-show="activeSection === 'values'"
          x-transition:enter='transition ease-out duration-300'
          x-transition:enter-start='opacity-0 transform translate-y-4'
          x-transition:enter-end='opacity-100 transform translate-y-0'
        >
          <div class='mb-6 sm:mb-8'>
            <h1
              class='text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-800 mb-3 sm:mb-4 font-montserrat'
            >Our Values</h1>
            <p
              class='text-base sm:text-lg lg:text-xl text-slate-600 font-inter'
            >Principles that guide every step of our journey</p>
          </div>

          <div class='grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 lg:gap-8'>
            {{#each value}}
            <div
              class='bg-white border border-slate-200 rounded-xl sm:rounded-2xl p-5 sm:p-6 lg:p-8 transition-all duration-300 hover:shadow-lg hover:-translate-y-1'
            >
              <div
                class='w-12 h-12 sm:w-14 sm:h-14 lg:w-16 lg:h-16 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg sm:rounded-xl flex items-center justify-center mb-4 sm:mb-6'
              >
                <i
                  class='{{computeIcon icon}} text-white text-lg sm:text-xl lg:text-2xl'
                ></i>
              </div>
              <h3
                class='text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 mb-3 sm:mb-4 font-montserrat'
              >{{tittle}}</h3>
              <p
                class='text-sm sm:text-base text-slate-700 leading-relaxed font-inter'
              >
              {{description}}
              </p>
            </div>
            {{/each}}
          </div>
        </div>

        <!-- Contact Section -->
        <div
          x-show="activeSection === 'contact'"
          x-transition:enter='transition ease-out duration-300'
          x-transition:enter-start='opacity-0 transform translate-y-4'
          x-transition:enter-end='opacity-100 transform translate-y-0'
        >
          <div class='mb-6 sm:mb-8'>
            <h1
              class='text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-800 mb-3 sm:mb-4 font-montserrat'
            >Contact Us</h1>
            <p
              class='text-base sm:text-lg lg:text-xl text-slate-600 font-inter'
            >We're ready to help your technology learning journey</p>
          </div>

          <div class='grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8'>
            <div>
              <h3
                class='text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 mb-4 sm:mb-6 font-montserrat'
              >Contact Information</h3>
              <div class='space-y-4 sm:space-y-6'>
                <div class='flex items-start space-x-3 sm:space-x-4'>
                  <div
                    class='w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg flex items-center justify-center flex-shrink-0'
                  >
                    <i
                      class='fas fa-envelope text-white text-sm sm:text-base'
                    ></i>
                  </div>
                  <div>
                    <h4
                      class='font-semibold text-sm sm:text-base text-slate-800 mb-1 font-montserrat'
                    >Email</h4>
                    <p
                      class='text-xs sm:text-sm text-slate-600 font-inter'
                    >info@kesatriaacademy.com</p>
                    <p
                      class='text-xs sm:text-sm text-slate-600 font-inter'
                    >support@kesatriaacademy.com</p>
                  </div>
                </div>

                <div class='flex items-start space-x-3 sm:space-x-4'>
                  <div
                    class='w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg flex items-center justify-center flex-shrink-0'
                  >
                    <i class='fas fa-phone text-white text-sm sm:text-base'></i>
                  </div>
                  <div>
                    <h4
                      class='font-semibold text-sm sm:text-base text-slate-800 mb-1 font-montserrat'
                    >Phone</h4>
                    <p class='text-xs sm:text-sm text-slate-600 font-inter'>+62
                      21 1234 5678</p>
                    <p class='text-xs sm:text-sm text-slate-600 font-inter'>+62
                      812 3456 7890</p>
                  </div>
                </div>

                <div class='flex items-start space-x-3 sm:space-x-4'>
                  <div
                    class='w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg flex items-center justify-center flex-shrink-0'
                  >
                    <i
                      class='fas fa-map-marker-alt text-white text-sm sm:text-base'
                    ></i>
                  </div>
                  <div>
                    <h4
                      class='font-semibold text-sm sm:text-base text-slate-800 mb-1 font-montserrat'
                    >Address</h4>
                    <p class='text-xs sm:text-sm text-slate-600 font-inter'>Jl.
                      Teknologi No. 123<br />South Jakarta 12345<br
                      />Indonesia</p>
                  </div>
                </div>
              </div>

              <div class='mt-6 sm:mt-8'>
                <h4
                  class='font-semibold text-sm sm:text-base text-slate-800 mb-3 sm:mb-4 font-montserrat'
                >Social Media</h4>
                <div class='flex space-x-3 sm:space-x-4'>
                  <a
                    href='#'
                    class='w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center hover:bg-slate-200 transition-colors'
                  >
                    <i class='fab fa-instagram text-slate-600 text-xl'></i>
                  </a>
                  <a
                    href='#'
                    class='w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center hover:bg-slate-200 transition-colors'
                  >
                    <i class='fab fa-twitter text-slate-600 text-xl'></i>
                  </a>
                  <a
                    href='#'
                    class='w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center hover:bg-slate-200 transition-colors'
                  >
                    <i class='fab fa-linkedin text-slate-600 text-xl'></i>
                  </a>
                  <a
                    href='#'
                    class='w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center hover:bg-slate-200 transition-colors'
                  >
                    <i class='fab fa-youtube text-slate-600 text-xl'></i>
                  </a>
                </div>
              </div>
            </div>

            <div
              class='bg-gradient-to-br from-slate-50 to-slate-100 p-5 sm:p-6 lg:p-8 rounded-xl sm:rounded-2xl border border-slate-200'
              x-data="{
                formData: { nama: '', email: '', subject: '', message: '' },
                isSubmitting: false,
                message: '',
                messageType: '',
                async submitForm() {
                  this.isSubmitting = true;
                  this.message = '';
                  try {
                    const response = await fetch('/contact', {
                      method: 'POST',
                      headers: {
                        'Content-Type': 'application/json',
                      },
                      body: JSON.stringify(this.formData)
                    });
                    const result = await response.json();
                    if (result.success) {
                      this.message = result.message;
                      this.messageType = 'success';
                      this.formData = { nama: '', email: '', subject: '', message: '' };
                    } else {
                      this.message = result.message;
                      this.messageType = 'error';
                    }
                  } catch (error) {
                    this.message = 'Network error. Please try again.';
                    this.messageType = 'error';
                  }
                  this.isSubmitting = false;
                }
              }"
            >
              <h3
                class='text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 mb-4 sm:mb-6 font-montserrat'
              >Send Message</h3>

              <!-- Message Display -->
              <div
                x-show='message'
                :class="messageType === 'success' ? 'bg-green-50 border-green-200 text-green-800' : 'bg-red-50 border-red-200 text-red-800'"
                class='p-4 rounded-lg border mb-6'
              >
                <div class='flex items-center'>
                  <i
                    :class="messageType === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle'"
                    class='mr-2'
                  ></i>
                  <span x-text='message'></span>
                </div>
              </div>

              <form
                @submit.prevent='submitForm()'
                class='space-y-4 sm:space-y-6'
              >
                <div>
                  <label
                    class='block text-xs sm:text-sm font-medium text-slate-700 mb-1.5 sm:mb-2'
                  >Full Name</label>
                  <input
                    type='text'
                    x-model='formData.nama'
                    required
                    class='w-full bg-white px-3 py-2 sm:px-4 sm:py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-all duration-200 text-sm sm:text-base'
                  />
                </div>
                <div>
                  <label
                    class='block text-xs sm:text-sm font-medium text-slate-700 mb-1.5 sm:mb-2'
                  >Email</label>
                  <input
                    type='email'
                    x-model='formData.email'
                    required
                    class='w-full bg-white px-3 py-2 sm:px-4 sm:py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-all duration-200 text-sm sm:text-base'
                  />
                </div>
                <div>
                  <label
                    class='block text-xs sm:text-sm font-medium text-slate-700 mb-1.5 sm:mb-2'
                  >Subject</label>
                  <input
                    type='text'
                    x-model='formData.subject'
                    required
                    class='w-full bg-white px-3 py-2 sm:px-4 sm:py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-all duration-200 text-sm sm:text-base'
                  />
                </div>
                <div>
                  <label
                    class='block text-xs sm:text-sm font-medium text-slate-700 mb-1.5 sm:mb-2'
                  >Message</label>
                  <textarea
                    rows='4'
                    x-model='formData.message'
                    required
                    class='w-full bg-white px-3 py-2 sm:px-4 sm:py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-all duration-200 text-sm sm:text-base'
                  ></textarea>
                </div>
                <button
                  type='submit'
                  :disabled='isSubmitting'
                  class='w-full bg-gradient-to-r from-slate-600 to-slate-800 text-white py-2.5 px-5 sm:py-3 sm:px-6 rounded-lg hover:from-slate-700 hover:to-slate-900 transition-all duration-200 flex items-center justify-center space-x-2 text-sm sm:text-base disabled:opacity-50 disabled:cursor-not-allowed'
                >
                  <i
                    :class="isSubmitting ? 'fas fa-spinner fa-spin' : 'fas fa-paper-plane'"
                    class='text-xs sm:text-sm'
                  ></i>
                  <span
                    x-text="isSubmitting ? 'Sending...' : 'Send Message'"
                  ></span>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>