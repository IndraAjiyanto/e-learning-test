                    {{#each background}}
                    <li class='flex items-start space-x-2'>
                      <i class='fas fa-check text-slate-600 mt-1'></i>
                      <span><strong>{{content}}</strong>
                        - {{isi}}</span>
                    </li>
                    {{else}}
                    <li class='flex items-start space-x-2'>
                      <i class='fas fa-check text-slate-600 mt-1'></i>
                      <span><strong>Bachelor's Degree (S.Kom)</strong>
                        - Information Technology at Universitas Islam Indonesia</span>
                    </li>
                    <li class='flex items-start space-x-2'>
                      <i class='fas fa-check text-slate-600 mt-1'></i>
                      <span><strong>Master's Degree (M.Sc)</strong>
                        - Advanced Computer Science with Artificial Intelligence Pathway at Manchester University</span>
                    </li>
                    {{/each}}
                  </ul>
                </div>
              </div>

              <!-- Achievements & Awards -->
