            class='bg-gradient-to-br from-slate-50 to-slate-100 p-5 sm:p-6 lg:p-8 rounded-xl sm:rounded-2xl border border-slate-200 transition-all duration-300 hover:shadow-lg mb-6 sm:mb-8'
