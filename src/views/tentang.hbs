            x-data='{ educationOpen: false, achievementOpen: false, portfolioOpen: false }'
          >
            <div class='flex flex-col md:flex-row gap-4 sm:gap-6 mb-4 sm:mb-6'>
              <div class='flex-shrink-0 mx-auto md:mx-0'>
                <div
                  class='w-24 h-24 sm:w-28 sm:h-28 lg:w-32 lg:h-32 bg-gradient-to-br from-slate-700 to-slate-900 rounded-full flex items-center justify-center ring-4 ring-slate-300'
                >
                  <i
                    class='fas fa-user text-white text-2xl sm:text-3xl lg:text-4xl'
                  ></i>
                </div>
              </div>
              <div class='flex-1 text-center md:text-left'>
                <div
                  class='flex items-center justify-center md:justify-start gap-2 mb-2'
                >
                  <h3
                    class='text-xl sm:text-2xl lg:text-3xl font-bold text-slate-800 font-montserrat'
                  >
                    {{#if teamLead.[0]}}
                      {{teamLead.[0].nama}}
                    {{else}}
                      Faisal Wirakusuma, S.Kom., M.Sc
                    {{/if}}
                  </h3>

                </div>
                <p
                  class='text-slate-600 font-semibold mb-2 sm:mb-3 text-base sm:text-lg font-inter'
                >
                  {{#if teamLead.[0]}}
                    {{teamLead.[0].posisi}}
                  {{else}}
                    Founder & Chief Executive Officer
                  {{/if}}
                </p>

                  {{#if teamLead.[0]}}
                                  <p
                  class='text-slate-700 text-sm sm:text-base leading-relaxed mb-3 sm:mb-4 font-inter text-justify'
                >
                    {{teamLead.[0].deskripsi}}
                </p>

                  {{else}}
                  <p class='text-slate-700 text-sm sm:text-base leading-relaxed mb-3 sm:mb-4 font-inter text-justify'>
                    Faisal is the Founder and CEO of Wiratek Solusi Asia, bringing over 11 years of experience in web application development, API creation, data science, and analytics. He is experienced in handling projects for State-Owned Enterprises (BUMN), government agencies, and private companies, including notable names such as Pertamina, Biofarma, Angkasa Pura II, and Bank DBS Indonesia. 
                    </p>
                    <p class='text-slate-700 text-sm sm:text-base leading-relaxed mb-3 sm:mb-4 font-inter text-justify'>
                    His deep expertise in technology and data analytics, combined with his experience serving major clients, serves as the core foundation for his vision to build an Edutech company. His goal is to bridge the gap and democratize technical up-skilling, leveraging technology to create flexible, scalable, and high-quality learning solutions that can significantly enhance the competitiveness of digital talent across Asia. His passion for continuous learning and commitment to achieving client business objectives now extends to a mission of elevating the competence of the wider community.
                    </p>
                  {{/if}}
                <div class='flex justify-center md:justify-start space-x-3'>
                  <a
                    href='{{#if teamLead.[0]}}{{teamLead.[0].linkedin}}{{else}}https://linkedin.com{{/if}}'
                    class='w-9 h-9 sm:w-10 sm:h-10 bg-white rounded-full flex items-center justify-center hover:bg-slate-200 transition-colors shadow-sm'
                  >
                    <i class='fab fa-linkedin text-slate-700 text-base'></i>
                  </a>
                  <a
                    href='{{#if teamLead.[0]}}{{teamLead.[0].instagram}}{{else}}https://instagram.com{{/if}}'
                    class='w-9 h-9 sm:w-10 sm:h-10 bg-white rounded-full flex items-center justify-center hover:bg-slate-200 transition-colors shadow-sm'
                  >
                    <i class='fab fa-instagram text-slate-700 text-base'></i>
                  </a>
                </div>
              </div>
            </div>

            <!-- Dropdown Sections -->
