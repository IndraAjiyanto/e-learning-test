<div
  class='min-h-screen bg-gradient-to-br from-white via-slate-50 to-slate-100 pt-20'
  x-data='profilePreview()'
>
  <div class='max-w-5xl mx-auto px-6 py-10'>
    <!-- Header Section -->
    <div class='text-center mb-12'>
      <h1
        class='text-4xl md:text-5xl font-bold text-slate-800 mb-4 font-montserrat'
      >{{t 'test.profile.tittle'}}</h1>
      <p class='text-lg text-slate-600 max-w-2xl mx-auto font-inter'>
        {{t 'test.profile.description'}}
      </p>
    </div>

    <!-- Profile Card -->
    <div
      class='bg-white rounded-2xl shadow-2xl border border-slate-200 p-8 mb-10 transition-all duration-300 hover:shadow-3xl'
    >
      <!-- Profile Header with Image, Info, and Action Buttons -->
      <div class='flex flex-col lg:flex-row items-center gap-8'>
        <!-- Profile Image Section -->
        <div class='flex-shrink-0'>
          <div class='relative'>
            {{#if user.profile}}
              <img
                :src="previewUrl || '{{user.profile}}'"
                alt='Profile Photo'
                class='w-32 h-32 rounded-full border-4 border-slate-200 shadow-2xl object-cover transition-all duration-300 hover:scale-105'
              />

            {{else}}
              <div
                class='w-32 h-32 rounded-full border-4 bg-gray-600 border-slate-200 shadow-2xl flex items-center justify-center text-4xl font-bold uppercase text-white transition-all duration-300 hover:scale-105'
              >
                {{substring user.username 0 1}}
              </div>
            {{/if}}

            <label
              for='profile-upload'
              class='absolute bottom-2 right-2 bg-white rounded-full p-2 shadow-lg cursor-pointer hover:bg-slate-100 transition-all duration-300 hover:scale-110'
            >
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5 text-slate-600'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M15.232 5.232l3.536 3.536M9 11l6.586-6.586
                                         a2 2 0 012.828 0l1.172 1.172a2 2 0 010 2.828L13 15
                                         m-4 0h4m-4 0v4m0-4H5m4 0v-4'
                />
              </svg>
            </label>

            <form
              x-ref='profileForm'
              action='/users/update/profile/{{user.id}}?_method=PATCH'
              method='post'
              enctype='multipart/form-data'
            >
              <input
                id='profile-upload'
                type='file'
                name='profile'
                accept='image/jpeg,image/jpg,image/png'
                class='hidden'
                x-ref='fileInput'
                @change='handleFileUpload($event)'
              />
            </form>
          </div>
        </div>

        <!-- User Info Section - Center Aligned -->
        <div class='flex-1'>
          <div class='flex flex-col items-center lg:items-start'>
            <h1
              class='text-3xl font-bold text-slate-800 mb-2 font-montserrat'
            >{{user.username}}</h1>
            <p class='text-slate-600 text-lg font-inter'>{{user.email}}</p>
          </div>
        </div>

        <!-- Action Buttons Section -->
        <div class='flex flex-col gap-3 w-full lg:w-auto'>
          <a
            href='/users/profile/info_akun'
            class='bg-gradient-to-r from-slate-600 to-slate-800 text-white px-6 py-3 rounded-xl shadow-lg hover:shadow-xl hover:from-slate-500 hover:to-slate-700 transition-all duration-300 transform hover:-translate-y-1 font-semibold text-center whitespace-nowrap'
          >
            <i class='fas fa-edit mr-2'></i>{{t 'test.profile.editProfile'}}
          </a>
          <a
            href='/users/profile/password'
            class='bg-white text-slate-800 border-0 px-6 py-3 rounded-xl shadow-lg hover:shadow-xl hover:bg-slate-50 hover:border-slate-400 transition-all duration-300 transform hover:-translate-y-1 font-semibold text-center whitespace-nowrap'
          >
            <i class='fas fa-key mr-2'></i>{{t 'test.profile.changePassword'}}
          </a>
        </div>
      </div>
    </div>

    <!-- Account Information Section -->
    <div class='mb-10'>
      <div class='mb-6'>
        <h2 class='text-2xl font-bold text-slate-800 font-montserrat'>{{t
            'test.profile.accountlInfo'
          }}</h2>
        <p class='text-slate-600 mt-2 font-inter'>{{t
            'test.profile.personalDetails'
          }}</p>
      </div>

      <div class='bg-white rounded-2xl shadow-xl border border-slate-200 p-8'>
        <!-- Basic Information Grid -->
        <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
          <!-- Username -->
          <div
            class='flex items-center gap-4 p-4 bg-gradient-to-br from-slate-50 to-slate-100 rounded-xl border border-slate-200'
          >
            <div
              class='w-12 h-12 flex items-center justify-center flex-shrink-0'
            >
              <i class='fas fa-user text-gray-700 text-lg'></i>
            </div>
            <div class='flex-1'>
              <p class='text-sm text-slate-500 font-medium'>{{t
                  'test.profile.username'
                }}</p>
              <p
                class='text-lg text-slate-800 font-semibold'
              >{{user.username}}</p>
            </div>
          </div>

          <!-- Email -->
          <div
            class='flex items-center gap-4 p-4 bg-gradient-to-br from-slate-50 to-slate-100 rounded-xl border border-slate-200'
          >
            <div
              class='w-12 h-12 flex items-center justify-center flex-shrink-0'
            >
              <i class='fas fa-envelope text-gray-700 text-lg'></i>
            </div>
            <div class='flex-1'>
              <p class='text-sm text-slate-500 font-medium'>{{t
                  'test.profile.email'
                }}</p>
              <p class='text-lg text-slate-800 font-semibold'>{{user.email}}</p>
            </div>
          </div>
        </div>

        <!-- Biodata Section for Users -->
        {{#if (roles user.role 'user')}}
          {{#if user.biodata}}
            <!-- Personal Information -->
            <div class='mt-8 pt-8 border-t border-slate-200'>
              <div
                class='flex flex-col md:flex-row md:items-center md:justify-between mb-6'
              >
                <h3 class='text-xl font-bold text-slate-800 font-montserrat'>{{t
                    'test.profile.personalInfo'
                  }}</h3>
                <!-- Edit Information Button -->
                <a
                  href='/biodatas/formEdit/{{user.biodata.id}}'
                  class='inline-flex items-center gap-2 bg-gradient-to-r from-slate-600 to-slate-800 text-white px-6 py-3 rounded-xl shadow-lg hover:shadow-xl hover:from-slate-500 hover:to-slate-700 transition-all duration-300 transform hover:-translate-y-1 font-semibold mt-4 md:mt-0'
                >
                  <i class='fas fa-edit mr-2'></i>
                  {{t 'test.profile.editInfo'}}
                </a>
              </div>

              <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
                <!-- Full Name -->
                <div
                  class='flex items-center gap-4 p-4 bg-gradient-to-br from-slate-50 to-slate-100 rounded-xl border border-slate-200'
                >
                  <div
                    class='w-12 h-12 flex items-center justify-center flex-shrink-0'
                  >
                    <i class='fas fa-id-card text-gray-700 text-lg'></i>
                  </div>
                  <div class='flex-1'>
                    <p class='text-sm text-slate-500 font-medium'>{{t
                        'test.profile.fullName'
                      }}</p>
                    <p
                      class='text-lg text-slate-800 font-semibold'
                    >{{user.biodata.nama_lengkap}}</p>
                  </div>
                </div>

                <!-- Gender -->
                <div
                  class='flex items-center gap-4 p-4 bg-gradient-to-br from-slate-50 to-slate-100 rounded-xl border border-slate-200'
                >
                  <div
                    class='w-12 h-12 flex items-center justify-center flex-shrink-0'
                  >
                    <i class='fas fa-venus-mars text-gray-700 text-lg'></i>
                  </div>
                  <div class='flex-1'>
                    <p class='text-sm text-slate-500 font-medium'>{{t
                        'test.profile.gender'
                      }}</p>
                    <p
                      class='text-lg text-slate-800 font-semibold'
                    >{{user.biodata.jenis_kelamin}}</p>
                  </div>
                </div>
              </div>

              <!-- Additional Details -->
              <div
                class='mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4'
              >
                <!-- Phone Number -->
                <div
                  class='p-4 bg-gradient-to-br from-slate-50 to-slate-100 rounded-xl border border-slate-200 text-center'
                >
                  <div
                    class='w-10 h-10 rounded-lg flex items-center justify-center mx-auto mb-3'
                  >
                    <i class='fas fa-phone text-gray-700 text-lg'></i>
                  </div>
                  <p class='text-sm text-slate-500 font-medium'>{{t
                      'test.profile.phoneNumber'
                    }}</p>
                  <p
                    class='text-base text-slate-800 font-semibold'
                  >{{user.biodata.no}}</p>
                </div>
                <!-- Location -->
                <div
                  class='p-4 bg-gradient-to-br from-slate-50 to-slate-100 rounded-xl border border-slate-200 text-center'
                >
                  <div
                    class='w-10 h-10 rounded-lg flex items-center justify-center mx-auto mb-3'
                  >
                    <i class='fas fa-map-marker-alt text-gray-700 text-lg'></i>
                  </div>
                  <p class='text-sm text-slate-500 font-medium'>{{t
                      'test.profile.location'
                    }}</p>
                  <p
                    class='text-base text-slate-800 font-semibold'
                  >{{user.biodata.kota}}</p>
                </div>

                <!-- Education -->
                <div
                  class='p-4 bg-gradient-to-br from-slate-50 to-slate-100 rounded-xl border border-slate-200 text-center'
                >
                  <div
                    class='w-10 h-10 rounded-lg flex items-center justify-center mx-auto mb-3'
                  >
                    <i class='fas fa-graduation-cap text-gray-700 text-lg'></i>
                  </div>
                  <p class='text-sm text-slate-500 font-medium'>{{t
                      'test.profile.education'
                    }}</p>
                  <p
                    class='text-base text-slate-800 font-semibold'
                  >{{user.biodata.pendidikan}}</p>
                </div>

                <!-- Study Program -->
                <div
                  class='p-4 bg-gradient-to-br from-slate-50 to-slate-100 rounded-xl border border-slate-200 text-center'
                >
                  <div
                    class='w-10 h-10 rounded-lg flex items-center justify-center mx-auto mb-3'
                  >
                    <i class='fas fa-book text-gray-700 text-lg'></i>
                  </div>
                  <p class='text-sm text-slate-500 font-medium'>{{t
                      'test.profile.studyProgram'
                    }}</p>
                  <p
                    class='text-base text-slate-800 font-semibold'
                  >{{user.biodata.program_studi}}</p>
                </div>
              </div>
            </div>
          {{else}}
            <!-- No Biodata Warning -->
            <div
              class='mt-8 p-6 rounded-xl bg-gradient-to-br from-yellow-50 to-yellow-100 border border-yellow-200'
            >
              <div
                class='flex flex-col md:flex-row items-center justify-between gap-4'
              >
                <div class='flex items-center gap-4'>
                  <div
                    class='w-12 h-12 bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-lg flex items-center justify-center'
                  >
                    <i
                      class='fas fa-exclamation-triangle text-white text-lg'
                    ></i>
                  </div>
                  <div>
                    <p class='font-semibold text-yellow-800 text-lg'>{{t
                        'test.profile.tittleCompleteYourProfile'
                      }}</p>
                    <p class='text-yellow-700 text-sm'>{{t
                        'test.profile.spanCompleteYourProfile'
                      }}</p>
                  </div>
                </div>
                <a
                  href='/biodatas/formCreate'
                  class='bg-gradient-to-r from-slate-600 to-slate-800 text-white px-6 py-3 rounded-lg shadow-lg hover:shadow-xl hover:from-slate-500 hover:to-slate-700 transition-all duration-300 transform hover:-translate-y-1 font-semibold whitespace-nowrap'
                >
                  {{t 'test.profile.completeBiodata'}}
                </a>
              </div>
            </div>
          {{/if}}
        {{/if}}
      </div>
    </div>

  </div>

  <!-- Profile Picture Preview Modal -->
  <div
    x-show='open'
    class='fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50 p-4'
    x-transition
    @click.self='closeModal()'
  >
    <div class='bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 relative'>
      <button
        @click='closeModal()'
        class='absolute top-4 right-4 text-slate-600 hover:text-slate-900 text-2xl w-8 h-8 rounded-full hover:bg-slate-100 flex items-center justify-center transition-all duration-300'
      >
        &times;
      </button>

      <h3 class='text-xl font-bold text-slate-800 mb-4 font-montserrat'>{{t
          'test.profile.profilePicturePreview'
        }}</h3>

      <!-- Validation Error Alert -->
      <div
        x-show='validationError'
        x-transition
        class='mb-4 p-4 rounded-xl bg-gradient-to-br from-red-50 to-red-100 border-2 border-red-300'
      >
        <div class='flex items-start gap-3'>
          <div
            class='w-10 h-10 bg-gradient-to-br from-red-500 to-red-600 rounded-lg flex items-center justify-center flex-shrink-0'
          >
            <i class='fas fa-exclamation-triangle text-white text-lg'></i>
          </div>
          <div class='flex-1'>
            <p class='font-bold text-red-800 text-base mb-1'>{{t
                'test.profile.invalidImage'
              }}</p>
            <p class='text-red-700 text-sm' x-text='validationError'></p>
          </div>
        </div>
      </div>

      <!-- Image Preview -->
      <img
        :src='previewUrl'
        alt='Preview Profile'
        class='rounded-xl w-full object-contain max-h-[60vh] border border-slate-200'
      />

      <!-- Image Info -->
      <div
        x-show='imageInfo'
        class='mt-3 p-3 bg-slate-50 rounded-lg border border-slate-200'
      >
        <div class='flex items-center justify-between text-sm'>
          <div>
            <i class='fas fa-image text-slate-600 mr-2'></i>
            <span class='text-slate-700 font-medium' x-text='imageInfo'></span>
          </div>
        </div>
      </div>

      <div class='flex justify-end gap-3 mt-6'  x-data ='{ loading: false }' >
        <button
          @click='closeModal()'
          :disabled="loading"
          class='px-6 py-3 rounded-xl border-2 border-slate-300 text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-all duration-300 font-semibold'
        >
          {{t 'test.profile.cancel'}}
        </button>

        <button
          @click='$refs.profileForm.submit(); loading = true;'
          :disabled='validationError !== "" || loading'
          :class="validationError !== '' || loading ? 'opacity-50 cursor-not-allowed' : 'hover:shadow-xl hover:from-slate-500 hover:to-slate-700 transform hover:-translate-y-1'"
          class='px-6 py-3 rounded-xl bg-gradient-to-r from-slate-600 to-slate-800 text-white shadow-lg transition-all duration-300 font-semibold'
        >
                  <span x-show="loading" class="loading loading-spinner loading-sm"></span>
          <span x-show="!loading">{{t 'test.profile.saveChanges'}}</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function profilePreview() {
    return {
      // =========================
      // State
      // =========================
      previewUrl: "",
      open: false,
      validationError: "",
      imageInfo: "",

      // =========================
      // Handle File Upload
      // =========================
      handleFileUpload(event) {
        const file = event.target.files[0];
        if (!file) return;

        // Reset state
        this.previewUrl = "";
        this.validationError = "";
        this.imageInfo = "";

        // Allowed file types
        const allowedTypes = ["image/jpeg", "image/jpg", "image/png"];
        if (!allowedTypes.includes(file.type)) {
          this.validationError =
            "File type not allowed! Please upload JPG, JPEG, or PNG image only.";
          this.open = true;
          return;
        }

        // File size validation (max 5MB)
        const maxSize = 5 * 1024 * 1024;
        const fileSizeMB = (file.size / (1024 * 1024)).toFixed(2);

        if (file.size > maxSize) {
          this.validationError = `File size too large! Maximum 5MB allowed. Your file: ${fileSizeMB}MB`;
          this.open = true;
          return;
        }

        // Validate image dimensions
        const img = new Image();
        const objectUrl = URL.createObjectURL(file);

        img.onload = () => {
          const { width, height } = img;

          this.previewUrl = objectUrl;
          this.open = true;

          if (width < 300 || width > 2000 || height < 300 || height > 2000) {
            this.validationError = `Image dimensions must be between 300x300 and 2000x2000 pixels. Your image: ${width}x${height}px`;
            this.imageInfo = `${width}x${height}px • ${fileSizeMB}MB`;
          } else {
            this.validationError = "";
            this.imageInfo = `${width}x${height}px • ${fileSizeMB}MB • Ready to upload ✓`;
          }
        };

        img.onerror = () => {
          this.previewUrl = "";
          this.validationError =
            "Failed to load image. Please try another file or ensure the file is not corrupted.";
          this.open = true;

          URL.revokeObjectURL(objectUrl);
        };

        img.src = objectUrl;
      },

      // =========================
      // Close Modal
      // =========================
      closeModal() {
        this.open = false;

        if (this.previewUrl) {
          URL.revokeObjectURL(this.previewUrl);
        }

        this.previewUrl = "";
        this.validationError = "";
        this.imageInfo = "";

        if (this.$refs.fileInput) {
          this.$refs.fileInput.value = null;
        }
      },
    };
  }
</script>
