<div
  class='min-h-screen bg-gradient-to-br from-white via-slate-50 to-slate-100 pt-20'
  x-data='profilePreview()'
>
  <div class='max-w-5xl mx-auto px-6 py-10'>
{{> user/profile/index/header}}

{{> user/profile/index/profile_card}}

{{> user/profile/index/account_information}}

  </div>

{{> user/profile/index/priview_modal}}

{{> user/profile/index/crop_modal}}

</div>

<script>
function profilePreview() {
  return {
    // State lama
    previewUrl: "",
    open: false,
    validationError: "",
    imageInfo: "",

    // State baru untuk crop
    cropper: null,
    showCropModal: false,
    tempImageUrl: null,
    croppedBlob: null,
    fileName: "",

    handleFileUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      // Reset state
      this.previewUrl = "";
      this.validationError = "";
      this.imageInfo = "";
      this.croppedBlob = null;
      this.fileName = file.name;

      // Validasi tipe file
      const allowedTypes = ["image/jpeg", "image/jpg", "image/png"];
      if (!allowedTypes.includes(file.type)) {
        this.validationError = "File type not allowed! Please upload JPG, JPEG, or PNG image only.";
        this.open = true;
        return;
      }

      // Validasi ukuran file (max 5MB)
      const maxSize = 5 * 1024 * 1024;
      const fileSizeMB = (file.size / (1024 * 1024)).toFixed(2);
      if (file.size > maxSize) {
        this.validationError = `File size too large! Maximum 5MB allowed. Your file: ${fileSizeMB}MB`;
        this.open = true;
        return;
      }

      // Buka crop modal
      this.tempImageUrl = URL.createObjectURL(file);
      this.showCropModal = true;

      this.$nextTick(() => {
        this.initCropper();
      });
    },

    initCropper() {
      const image = document.getElementById("cropImageProfile");
      if (this.cropper) {
        this.cropper.destroy();
      }

      this.cropper = new Cropper(image, {
        aspectRatio: 1,
        viewMode: 1,
        dragMode: "move",
        autoCropArea: 0.8,
        restore: false,
        guides: false,
        center: true,
        highlight: false,
        cropBoxMovable: true,
        cropBoxResizable: true,
        toggleDragModeOnDblclick: false,
        ready() {
          const cropBox = this.cropper.cropBox;
          cropBox.querySelector(".cropper-view-box").style.borderRadius = "50%";
          cropBox.querySelector(".cropper-face").style.borderRadius = "50%";
        },
      });
    },

    applyCrop() {
      if (!this.cropper) return;

      this.cropper.getCroppedCanvas({
        width: 400,
        height: 400,
        imageSmoothingEnabled: true,
        imageSmoothingQuality: "high",
      }).toBlob((blob) => {
        this.croppedBlob = blob;

        // Tampilkan preview hasil crop
        const fileSizeMB = (blob.size / (1024 * 1024)).toFixed(2);
        const img = new Image();
        const objectUrl = URL.createObjectURL(blob);

        img.onload = () => {
          this.previewUrl = objectUrl;
          this.imageInfo = `${img.width}x${img.height}px • ${fileSizeMB}MB • Ready to upload ✓`;
          this.validationError = "";

          // Langsung buka modal preview
          this.open = true;
        };

        img.src = objectUrl;
        this.closeCropModal();
      }, "image/jpeg", 0.9);
    },

    closeCropModal() {
      this.showCropModal = false;
      if (this.cropper) {
        this.cropper.destroy();
        this.cropper = null;
      }
      if (this.tempImageUrl) {
        URL.revokeObjectURL(this.tempImageUrl);
        this.tempImageUrl = null;
      }
      if (this.$refs.fileInput) {
        this.$refs.fileInput.value = null;
      }
    },

    closeModal() {
      this.open = false;

      if (this.previewUrl) {
        URL.revokeObjectURL(this.previewUrl);
      }

      this.previewUrl = "";
      this.validationError = "";
      this.imageInfo = "";
      this.croppedBlob = null;

      if (this.$refs.fileInput) {
        this.$refs.fileInput.value = null;
      }
    },
  };
}
</script>

<style>
  [x-cloak] { display: none !important; }
  .cropper-view-box,
  .cropper-face {
    border-radius: 50% !important;
    border: 3px solid #10b981 !important;
  }
  .cropper-point {
    width: 10px !important;
    height: 10px !important;
    background-color: #10b981 !important;
    border-radius: 50% !important;
    opacity: 1 !important;
  }
</style>