<div
  class='bg-gradient-to-br from-slate-50 via-white to-slate-100 min-h-screen py-20'
>
  <div class='max-w-2xl mx-auto px-6'>
    <div class='bg-white rounded-2xl shadow-2xl p-10 border border-slate-200'>
      <h2
        class='text-4xl font-bold text-gray-900 mb-10 text-center font-montserrat'
      >{{t 'test.profile.editInfoProfile.title'}}</h2>

      <form
        action='/users/{{user.id}}?_method=PATCH'
        method='POST'
        class='space-y-6'
        x-data='{ loading: false }'
        @submit='loading = true'
      >

        <div>
          <label
            for='username'
            class='block text-lg font-semibold text-gray-700 mb-3'
          >{{t 'test.profile.editInfoProfile.username'}}</label>
          <input
            type='text'
            id='username'
            name='username'
            value='{{user.username}}'
            required
            class='w-full border text-gray-700 border-slate-300 rounded-xl px-5 py-4 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-400 transition-all duration-300 bg-white/70 hover:bg-white'
          />
        </div>

        <div>
          <label
            for='email'
            class='block text-lg font-semibold text-gray-700 mb-3'
          >{{t 'test.profile.editInfoProfile.email'}}</label>
          <input
            type='email'
            id='email'
            name='email'
            value='{{user.email}}'
            required
            class='w-full border text-gray-700 border-slate-300 rounded-xl px-5 py-4 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-400 transition-all duration-300 bg-white/70 hover:bg-white'
          />
        </div>

        <div
          class='flex items-center gap-4 pt-10 mt-8 border-t border-slate-200'
        >
          <button
            type='submit'
            :disabled='loading'
            class='btn bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 font-semibold text-lg flex-1 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2'
          >
            <span
              x-show='loading'
              class='loading loading-spinner loading-sm'
            ></span>
            <span x-show='!loading'>{{t
                'test.profile.editInfoProfile.saveChanges'
              }}</span>
          </button>
          <a
            :disabled='loading'
            href='/users/profile'
            :class="loading ? 'bg-slate-100 cursor-not-allowed' : 'hover:bg-slate-50 text-slate-700'"
            class='btn bg-white rounded-xl border border-slate-300 shadow-lg hover:shadow-xl hover:border-slate-400 transition-all duration-300 font-semibold text-lg flex-1 text-center transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2'
          >
            {{t 'test.profile.editInfoProfile.cancel'}}
          </a>
        </div>
      </form>
    </div>
  </div>
</div>