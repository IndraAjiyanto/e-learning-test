{{!--
  Halaman: Register / Sign Up
  Lokasi: src/views/regis.hbs
  Menggunakan komponen global form auth (src/views/partials/components/ui/auth/index.hbs)
--}}

{{> components/ui/auth/index
  variant="register"
  action="/register"
  method="post"
  success=success
  error=error
  title=(t 'test.signUp.title')
  description=(t 'test.signUp.description')
  nameLabel=(t 'test.signUp.username')
  namePlaceholder=(t 'test.signUp.placeholderUsername')
  emailLabel=(t 'test.signUp.email')
  emailPlaceholder=(t 'test.signUp.placeholderEmail')
  passwordLabel=(t 'test.signUp.password')
  passwordPlaceholder=(t 'test.signUp.placeholderPassword')
  confirmPasswordLabel=(t 'test.signUp.confirmPassword')
  confirmPasswordPlaceholder=(t 'test.signUp.placeholderConfirmPassword')
  lengthText=(t 'test.passwordChecklist.length')
  uppercaseText=(t 'test.passwordChecklist.uppercase')
  lowercaseText=(t 'test.passwordChecklist.lowercase')
  numberText=(t 'test.passwordChecklist.number')
  specialText=(t 'test.passwordChecklist.special')
  matchText=(t 'test.passwordChecklist.match')
  noMatchText=(t 'test.passwordChecklist.noMatch')
  submitText=(t 'test.signUp.signUpButton')
  bottomTitle=(t 'test.signUp.haveAccount')
  bottomLinkText=(t 'test.signUp.login')
  bottomLinkUrl="/login"
}}