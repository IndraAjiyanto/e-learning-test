<div
  class='min-h-screen flex items-center justify-center bg-gradient-to-br from-primary via-secondary to-gray-800 px-4 pt-28 py-20'
>

  <div class='w-full max-w-5xl flex items-center justify-center'>
    <div
      class='w-full max-w-lg mx-auto bg-white/5 backdrop-blur-xl border border-white/20 shadow-2xl rounded-3xl p-8'
    >

      <!-- Title -->
      <div class='text-center mb-6'>
        <h1 class='text-4xl font-bold text-white mt-2 font-montserrat'>{{t
            'test.signUp.tittle'
          }}</h1>
        <p class='text-gray-400 text-lg mt-2'>
          {{t 'test.signUp.description'}}
        </p>
      </div>

      {{#if error}}
        <div
          role='alert'
          class='mb-6 p-4 rounded-xl bg-red-900/30 border border-red-500/40 backdrop-blur-sm'
        >
          <div class='flex items-start gap-3'>
            <div class='flex-shrink-0 mt-0.5'>
              <i class='fa-solid fa-circle-exclamation text-red-400'></i>
            </div>
            <div class='flex-1'>
              <p class='text-sm font-medium text-red-200'>{{error}}</p>
            </div>
            <button
              type='button'
              onclick="this.parentElement.parentElement.style.display='none'"
              class='flex-shrink-0 text-red-400 hover:text-red-300 transition-colors'
            >
              <i class='fa-solid fa-xmark'></i>
            </button>
          </div>
        </div>
      {{/if}}

      <!-- Register Form -->
      <form
        action='/register'
        method='post'
        class='space-y-6'
        x-data="{
          loading: false,
          password: '',
          confirm: '',
          touched: false,
          get rules() {
            return {
              minLength: this.password.length >= 8,
              uppercase: /[A-Z]/.test(this.password),
              lowercase: /[a-z]/.test(this.password),
              number: /[0-9]/.test(this.password),
              special: /[^A-Za-z0-9]/.test(this.password),
            }
          },
          get passwordValid() {
            return Object.values(this.rules).every(Boolean)
          },
          get matched() {
            return this.confirm.length > 0 && this.password === this.confirm
          },
          get formValid() {
            return this.passwordValid && this.matched
          }
        }"
        @submit="if (!formValid) { $event.preventDefault(); touched = true; return } loading = true"
      >

        <!-- Name -->
        <div>
          <label class='block text-gray-200 mb-2'>{{t
              'test.signUp.username'
            }}</label>
          <input
            type='text'
            name='username'
            placeholder='{{t "test.signUp.placeholderUsername"}}'
            required
            class='w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white'
          />
        </div>

        <!-- Email -->
        <div>
          <label class='block text-gray-200 mb-2'>{{t
              'test.signUp.email'
            }}</label>
          <input
            type='email'
            name='email'
            placeholder='{{t "test.signUp.placeholderEmail"}}'
            required
            class='w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white'
          />
        </div>

        <!-- Password -->
        <div x-data='{ show: false }'>
          <label class='block text-gray-200 mb-2'>{{t
              'test.signUp.password'
            }}</label>
          <div class='relative'>
            <input
              :type="show ? 'text' : 'password'"
              name='password'
              x-model='password'
              @blur='touched = true'
              placeholder='{{t "test.signUp.placeholderPassword"}}'
              required
              class='w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white pr-10'
            />
            <button
              type='button'
              @click='show = !show'
              class='absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-gray-800'
            >
              <!-- Eye icons -->
              <i x-show='!show' class='fa-solid fa-eye'></i>
              <i x-show='show' class='fa-solid fa-eye-slash'></i>
            </button>
          </div>
        </div>

        <!-- Password Requirements -->
        <div class='-mt-2'>
          <p class='text-sm text-gray-300 mb-2'>{{t
              'test.signUp.passwordRules'
            }}</p>
          <ul class='space-y-1 text-sm'>
            <li
              class='flex items-center gap-2'
              :class="rules.minLength ? 'text-green-400' : (touched ? 'text-red-400' : 'text-gray-400')"
            >
              <i
                class='fa-fw w-4 text-center'
                :class="rules.minLength ? 'fa-solid fa-circle-check' : 'fa-regular fa-circle'"
              ></i>
              <span>{{t 'test.signUp.ruleMinLength'}}</span>
            </li>
            <li
              class='flex items-center gap-2'
              :class="rules.uppercase ? 'text-green-400' : (touched ? 'text-red-400' : 'text-gray-400')"
            >
              <i
                class='fa-fw w-4 text-center'
                :class="rules.uppercase ? 'fa-solid fa-circle-check' : 'fa-regular fa-circle'"
              ></i>
              <span>{{t 'test.signUp.ruleUppercase'}}</span>
            </li>
            <li
              class='flex items-center gap-2'
              :class="rules.lowercase ? 'text-green-400' : (touched ? 'text-red-400' : 'text-gray-400')"
            >
              <i
                class='fa-fw w-4 text-center'
                :class="rules.lowercase ? 'fa-solid fa-circle-check' : 'fa-regular fa-circle'"
              ></i>
              <span>{{t 'test.signUp.ruleLowercase'}}</span>
            </li>
            <li
              class='flex items-center gap-2'
              :class="rules.number ? 'text-green-400' : (touched ? 'text-red-400' : 'text-gray-400')"
            >
              <i
                class='fa-fw w-4 text-center'
                :class="rules.number ? 'fa-solid fa-circle-check' : 'fa-regular fa-circle'"
              ></i>
              <span>{{t 'test.signUp.ruleNumber'}}</span>
            </li>
            <li
              class='flex items-center gap-2'
              :class="rules.special ? 'text-green-400' : (touched ? 'text-red-400' : 'text-gray-400')"
            >
              <i
                class='fa-fw w-4 text-center'
                :class="rules.special ? 'fa-solid fa-circle-check' : 'fa-regular fa-circle'"
              ></i>
              <span>{{t 'test.signUp.ruleSpecial'}}</span>
            </li>
          </ul>
        </div>

        <!-- Confirm Password -->
        <div x-data='{ show: false }'>
          <label class='block text-gray-200 mb-2'>{{t
              'test.signUp.confirmPassword'
            }}</label>
          <div class='relative'>
            <input
              :type="show ? 'text' : 'password'"
              name='confirm_password'
              x-model='confirm'
              placeholder='{{t "test.signUp.placeholderConfirmPassword"}}'
              required
              class='w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white pr-10'
            />
            <button
              type='button'
              @click='show = !show'
              class='absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-gray-800'
            >
              <!-- Eye icons -->
              <i x-show='!show' class='fa-solid fa-eye'></i>
              <i x-show='show' class='fa-solid fa-eye-slash'></i>
            </button>
          </div>
        </div>

        <p
          x-show='confirm.length > 0 && !matched'
          x-cloak
          class='-mt-4 text-sm text-red-400'
        >{{t 'test.signUp.passwordNotMatch'}}</p>

        <!-- Submit Button -->
        <button
          :disabled='loading || !formValid'
          :class="(loading || !formValid) ? 'opacity-60 cursor-not-allowed' : ''"
          type='submit'
          class='btn border-0 w-full py-3 rounded-lg bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white font-semibold transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-xl text-base'
        >
          <span
            x-show='loading'
            class='loading loading-spinner loading-sm'
          ></span>
          <span x-show='!loading'>{{t 'test.signUp.signUpButton'}}</span>
        </button>

        <!-- Link to Login -->
        <div class='text-center mt-4'>
          <p class='text-sm text-gray-400'>
            {{t 'test.signUp.haveAccount'}}
            <a
              href='/login'
              class='text-indigo-400 hover:text-indigo-300 font-medium'
            >{{t 'test.signUp.login'}}</a>
          </p>
        </div>

      </form>
    </div>
  </div>
</div>