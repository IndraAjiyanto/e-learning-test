<!-- MOBILE REGISTER SECTION (< 640px) -->
<div class="block sm:hidden min-h-screen flex items-center justify-center bg-[linear-gradient(180deg,_#FAFAFA_-33%,_#CEE5F6_33%,_#FAFAFA_93.51%)] px-5 py-12 pt-24 font-montserrat">
  <div class="w-full max-w-sm mx-auto bg-white rounded-[20px] p-6 border border-[#D9D9D9] shadow-[0px_4px_12px_0px_#00000010]">
    
    <!-- Logo -->
    <div class="flex items-center justify-center mb-4">
      <img src="/public/image/logo_baru.png" alt="Logo" class="h-9 w-auto object-contain" />
    </div>

    <!-- Title -->
    <div class="text-center mb-5">
      <h1 class="text-xl font-bold text-[#0B1F3B] font-montserrat">
        {{t 'test.signUp.title'}}
      </h1>
      <p class="text-xs text-[#2D2D2D] mt-1 font-sans">
        {{t 'test.signUp.description'}}
      </p>
    </div>

    {{#if error}}
      <div role="alert" class="mb-4 p-3 rounded-xl bg-red-900/20 border border-red-500/40 text-xs">
        <p class="font-medium text-red-700">{{error}}</p>
      </div>
    {{/if}}

    <!-- Register Form Mobile -->
    <form action="/register" method="post" x-data="{ loading: false }" @submit="loading = true" class="space-y-4">
      <!-- Username -->
      <div>
        <label class="block text-xs font-medium text-[#0B1F3B] mb-1 font-montserrat">
          {{t 'test.signUp.username'}}
        </label>
        <input
          type="text"
          name="username"
          placeholder='{{t "test.signUp.placeholderUsername"}}'
          required
          class="w-full px-3.5 py-2.5 text-xs rounded-[12px] bg-white border border-[#D9D9D9] text-[#2D2D2D] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#003060]"
        />
      </div>

      <!-- Email -->
      <div>
        <label class="block text-xs font-medium text-[#0B1F3B] mb-1 font-montserrat">
          {{t 'test.signUp.email'}}
        </label>
        <input
          type="email"
          name="email"
          placeholder='{{t "test.signUp.placeholderEmail"}}'
          required
          class="w-full px-3.5 py-2.5 text-xs rounded-[12px] bg-white border border-[#D9D9D9] text-[#2D2D2D] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#003060]"
        />
      </div>

      <!-- Password -->
      <div x-data="{ show: false }">
        <label class="block text-xs font-medium text-[#0B1F3B] mb-1 font-montserrat">
          {{t 'test.signUp.password'}}
        </label>
        <div class="relative">
          <input
            :type="show ? 'text' : 'password'"
            name="password"
            placeholder='{{t "test.signUp.placeholderPassword"}}'
            required
            class="w-full px-3.5 py-2.5 text-xs rounded-[12px] bg-white border border-[#D9D9D9] text-[#2D2D2D] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#003060] pr-10"
          />
          <button
            type="button"
            @click="show = !show"
            class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400"
          >
            <i class="fas" :class="show ? 'fa-eye-slash' : 'fa-eye'"></i>
          </button>
        </div>
      </div>

      <!-- Confirm Password -->
      <div x-data="{ show: false }">
        <label class="block text-xs font-medium text-[#0B1F3B] mb-1 font-montserrat">
          {{t 'test.signUp.confirmPassword'}}
        </label>
        <div class="relative">
          <input
            :type="show ? 'text' : 'password'"
            name="confirm_password"
            placeholder='{{t "test.signUp.placeholderConfirmPassword"}}'
            required
            class="w-full px-3.5 py-2.5 text-xs rounded-[12px] bg-white border border-[#D9D9D9] text-[#2D2D2D] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#003060] pr-10"
          />
          <button
            type="button"
            @click="show = !show"
            class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400"
          >
            <i class="fas" :class="show ? 'fa-eye-slash' : 'fa-eye'"></i>
          </button>
        </div>
      </div>

      <!-- Submit Button -->
      <button
        :disabled="loading"
        type="submit"
        class="w-full h-[48px] bg-[#003060] hover:bg-[#001f3f] text-white font-montserrat font-bold text-sm rounded-[12px] transition-all duration-300 shadow-md active:scale-95 flex items-center justify-center mt-2"
      >
        <span x-show="loading" class="loading loading-spinner loading-xs"></span>
        <span x-show="!loading">{{t 'test.signUp.signUpButton'}}</span>
      </button>

      <!-- Link to Login -->
      <div class="text-center mt-4">
        <p class="text-xs text-[#2D2D2D] font-sans">
          {{t 'test.signUp.haveAccount'}}
          <a href="/login" class="text-[#6EB6E5] font-semibold hover:underline ml-1">
            {{t 'test.signUp.login'}}
          </a>
        </p>
      </div>
    </form>

  </div>
</div>

<!-- DESKTOP REGISTER SECTION (>= 640px) -->
<div
  class='hidden sm:flex min-h-screen items-center justify-center bg-[linear-gradient(180deg,_#FAFAFA_-33%,_#CEE5F6_33%,_#FAFAFA_93.51%)] px-6 pt-28 py-20 font-montserrat'
>
  <div class='w-full max-w-5xl flex items-center justify-center'>
    <div
      class='w-full max-w-lg mx-auto bg-white backdrop-blur-xl border border-white/20 shadow-2xl rounded-3xl p-8'
    >

      <!-- Logo -->
      <div class='flex items-center justify-center mb-4'>
        <img src='/public/image/logo_baru.png' alt='Logo' class='h-16 w-auto object-contain' />
      </div>

      <!-- Title -->
      <div class='text-center mb-6'>
        <h1 class='text-2xl font-bold text-gray-900 font-montserrat'>{{t
            'test.signUp.title'
          }}</h1>
        <p class='text-sm text-gray-900 mt-2 font-sans'>
          {{t 'test.signUp.description'}}
        </p>
      </div>

      {{#if error}}
        <div
          role='alert'
          class='mb-6 p-4 rounded-xl bg-red-900/30 border border-red-500/40 backdrop-blur-sm'
        >
          <div class='flex items-start gap-3'>
            <div class='flex-shrink-0 mt-0.5'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5 text-red-400'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                />
              </svg>
            </div>
            <div class='flex-1'>
              <p class='text-sm font-medium text-red-200'>{{error}}</p>
            </div>
            <button
              type='button'
              onclick="this.parentElement.parentElement.style.display='none'"
              class='flex-shrink-0 text-red-400 hover:text-red-300 transition-colors'
            >
              <svg
                class='h-4 w-4'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M6 18L18 6M6 6l12 12'
                />
              </svg>
            </button>
          </div>
        </div>
      {{/if}}

      <!-- Register Form -->
      <form
        action='/register'
        method='post'
        class='space-y-6'
        x-data='{ loading: false }'
        @submit='loading = true'
      >

        <!-- Name -->
        <div>
          <label class='block text-gray-900 mb-2 font-montserrat font-medium'>{{t
              'test.signUp.username'
            }}</label>
          <input
            type='text'
            name='username'
            placeholder='{{t "test.signUp.placeholderUsername"}}'
            required
            class='w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white'
          />
        </div>

        <!-- Email -->
        <div>
          <label class='block text-gray-900 mb-2 font-montserrat font-medium'>{{t
              'test.signUp.email'
            }}</label>
          <input
            type='email'
            name='email'
            placeholder='{{t "test.signUp.placeholderEmail"}}'
            required
            class='w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white'
          />
        </div>

        <!-- Password -->
        <div x-data='{ show: false }'>
          <label class='block text-gray-900 mb-2 font-montserrat font-medium'>{{t
              'test.signUp.password'
            }}</label>
          <div class='relative'>
            <input
              :type="show ? 'text' : 'password'"
              name='password'
              placeholder='{{t "test.signUp.placeholderPassword"}}'
              required
              class='w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white pr-10'
            />
            <button
              type='button'
              @click='show = !show'
              class='absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-gray-800'
            >
              <svg
                x-show='!show'
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M15 12a3 3 0 11-6 0 3 3 0 016 0z'
                />
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M2.458 12C3.732 7.943 7.523 5 12 5c4.478 
                     0 8.268 2.943 9.542 7-1.274 4.057-5.064 
                     7-9.542 7-4.477 0-8.268-2.943-9.542-7z'
                />
              </svg>
              <svg
                x-show='show'
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M13.875 18.825A10.05 10.05 0 0112 19c-4.478 
                     0-8.268-2.943-9.542-7a9.973 
                     9.973 0 012.042-3.362M6.223 
                     6.223A9.956 9.956 0 0112 5c4.478 
                     0 8.268 2.943 9.542 7a9.978 
                     9.978 0 01-4.121 4.592M15 
                     12a3 3 0 11-6 0 3 3 0 016 
                     0z'
                />
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M3 3l18 18'
                />
              </svg>
            </button>
          </div>
        </div>

        <!-- Confirm Password -->
        <div x-data='{ show: false }'>
          <label class='block text-gray-900 mb-2 font-montserrat font-medium'>{{t
              'test.signUp.confirmPassword'
            }}</label>
          <div class='relative'>
            <input
              :type="show ? 'text' : 'password'"
              name='confirm_password'
              placeholder='{{t "test.signUp.placeholderConfirmPassword"}}'
              required
              class='w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white pr-10'
            />
            <button
              type='button'
              @click='show = !show'
              class='absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-gray-800'
            >
              <svg
                x-show='!show'
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M15 12a3 3 0 11-6 0 3 3 0 016 0z'
                />
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M2.458 12C3.732 7.943 7.523 5 12 5c4.478 
                     0 8.268 2.943 9.542 7-1.274 4.057-5.064 
                     7-9.542 7-4.477 0-8.268-2.943-9.542-7z'
                />
              </svg>
              <svg
                x-show='show'
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M13.875 18.825A10.05 10.05 0 0112 19c-4.478 
                     0-8.268-2.943-9.542-7a9.973 
                     9.973 0 012.042-3.362M6.223 
                     6.223A9.956 9.956 0 0112 5c4.478 
                     0 8.268 2.943 9.542 7a9.978 
                     9.978 0 01-4.121 4.592M15 
                     12a3 3 0 11-6 0 3 3 0 016 
                     0z'
                />
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M3 3l18 18'
                />
              </svg>
            </button>
          </div>
        </div>

        <!-- Submit Button -->
        <button
          :disabled='loading'
          type='submit'
          class='btn border-0 w-full py-3 rounded-lg bg-secondary hover:bg-secondary text-white font-semibold transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-xl text-base'
        >
          <span
            x-show='loading'
            class='loading loading-spinner loading-sm'
          ></span>
          <span x-show='!loading'>{{t 'test.signUp.signUpButton'}}</span>
        </button>

        <!-- Link to Login -->
        <div class='text-center mt-4'>
          <p class='text-sm text-gray-900 font-sans'>
            {{t 'test.signUp.haveAccount'}}
            <a
              href='/login'
              class='text-[#6EB6E5] hover:text-indigo-300 font-medium'
            >{{t 'test.signUp.login'}}</a>
          </p>
        </div>

      </form>
    </div>
  </div>
</div>