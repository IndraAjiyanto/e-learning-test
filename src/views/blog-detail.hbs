<article class='pt-24 pb-16 bg-white'>
  <div class='max-w-7xl mx-auto px-6'>
    <!-- Back Button -->
    <a
      href='/dashboard/blog'
      class='btn bg-white inline-flex items-center gap-3 px-6 py-3 mb-6 rounded-xl border border-slate-300 shadow-lg hover:shadow-xl text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-all duration-300 font-semibold text-base transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2'
    >
      <svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7' />
      </svg>
      <p class='pr-2'>{{t 'test.detailBlog.backToBlog'}}</p>
    </a>

    <div class='flex flex-col lg:flex-row gap-8 lg:gap-12'>
      <!-- Main Content -->
      <div class='lg:w-2/3'>
        <!-- Image Slider -->
        <div x-data='{ currentSlide: 0, totalSlides: {{blog.gambar.length}} }' class='relative mb-12'>
          <div class='relative rounded-2xl overflow-hidden shadow-2xl'>
            {{#each blog.gambar}}
              <div
                x-show='currentSlide === {{@index}}'
                x-transition:enter='transition ease-out duration-300'
                x-transition:enter-start='opacity-0 transform translate-x-full'
                x-transition:enter-end='opacity-100 transform translate-x-0'
                x-transition:leave='transition ease-in duration-300'
                x-transition:leave-start='opacity-100 transform translate-x-0'
                x-transition:leave-end='opacity-0 transform -translate-x-full'
                class='w-full'
              >
                <img src='{{this}}' alt='Blog image {{@index}}' class='w-full h-auto object-contain' />
              </div>
            {{/each}}

            <!-- Navigation Buttons -->
            <button
              @click='currentSlide = currentSlide > 0 ? currentSlide - 1 : totalSlides - 1'
              class='absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-900 p-3 rounded-full shadow-lg transition'
            >
              <svg class='w-6 h-6' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7' />
              </svg>
            </button>
            <button
              @click='currentSlide = currentSlide < totalSlides - 1 ? currentSlide + 1 : 0'
              class='absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-900 p-3 rounded-full shadow-lg transition'
            >
              <svg class='w-6 h-6' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7' />
              </svg>
            </button>
          </div>

          <!-- Thumbnails -->
          <div class='flex gap-2 mt-4 overflow-x-auto pb-2'>
            {{#each blog.gambar}}
              <button
                @click='currentSlide = {{@index}}'
                :class='currentSlide === {{@index}} ? "ring-4 ring-gray-900" : "ring-2 ring-gray-300"'
                class='flex-shrink-0 w-24 h-20 rounded-lg overflow-hidden transition-all hover:ring-gray-600'
              >
                <img src='{{this}}' alt='Thumbnail {{@index}}' class='w-full h-full object-cover' />
              </button>
            {{/each}}
          </div>

          <!-- Dots Indicator -->
          <div class='flex justify-center gap-2 mt-4'>
            {{#each blog.gambar}}
              <button
                @click='currentSlide = {{@index}}'
                :class='currentSlide === {{@index}} ? "bg-gray-900 w-8" : "bg-gray-300 w-2"'
                class='h-2 rounded-full transition-all'
              ></button>
            {{/each}}
          </div>
        </div>

        <!-- Blog Content -->
        <div class='max-w-none bg-white p-10 rounded-lg shadow-xl'>
          {{{blog.isi}}}
        </div>

        <!-- Comment Section - Tambahkan setelah bagian Blog Content dan sebelum Sidebar, atau di dalam Main Content setelah blog content -->
<div class="max-w-none bg-white p-10 rounded-lg shadow-xl mt-8">
  <div class="border-t border-gray-200 pt-8">
    <h3 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
      <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      Coment ({{blog.coment.length}})
    </h3>

    <!-- Comment Form - Hanya ditampilkan jika user login -->
    {{#if user}}
    <div class="mb-8 bg-gray-50 rounded-xl p-6">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-white font-semibold">
            {{#if user.profile}}
              <img src="{{user.profile}}" alt="{{user.username}}" class="w-full h-full rounded-full object-cover">
            {{else}}
                {{user.username}}
            {{/if}}
          </div>
        </div>
        <div class="flex-1">
          <form x-data="{
            commentText: '',
            isSubmitting: false,

            submitComment() {
              if (!this.commentText.trim()) return;
              this.isSubmitting = true;
              
              fetch('/blog/comment/{{blog.id}}', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({ content: this.commentText })
              })
              .then(res => {
                if (res.status === 401) {
                  window.location.href = '/login';
                  return;
                }
                return res.json();
              })
              .then(data => {
                if (data && data.success) {
                  window.location.reload();
                }
                this.isSubmitting = false;
              })
              .catch(err => {
                console.error('Error:', err);
                this.isSubmitting = false;
                alert('Failed to post comment. Please try again.');
              });
            }
          }" @submit.prevent="submitComment">
            <textarea
              x-model="commentText"
              rows="3"
              class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-primary focus:border-transparent resize-none transition-all bg-white"
              placeholder="write Comment"
              :disabled="isSubmitting"
            ></textarea>
            <div class="flex justify-end mt-3">
              <button
                type="submit"
                :disabled="!commentText.trim() || isSubmitting"
                class="px-6 py-2 bg-gradient-to-br from-primary to-secondary text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed transform hover:-translate-y-0.5"
              >
                <span x-show="!isSubmitting">Comment</span>
                <span x-show="isSubmitting" class="flex items-center gap-2">
                  <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  posting
                </span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
    {{else}}
    <div class="mb-8 bg-gray-50 rounded-xl p-6 text-center">
      <p class="text-gray-600">
        login To Comment
        <a href="/login" class="text-primary hover:underline font-semibold">login</a>
      </p>
    </div>
    {{/if}}

    <!-- Comments List -->
    <div class="space-y-6">
      {{#if blog.coment.length}}
        {{#each blog.coment}}
        <div class="flex gap-4 p-4 rounded-xl hover:bg-gray-50 transition-all duration-200" id="comment-{{this.id}}" x-data="{
  isEditing: false,
  editText: '{{this.content}}',

  deleteComment(commentId) {
    if (confirm('Apakah Anda yakin ingin menghapus komentar ini?')) {
      fetch(`/blog/comment/${commentId}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
      })
      .then(res => {
        if (res.status === 401) { window.location.href = '/login'; return; }
        return res.json();
      })
      .then(data => {
        if (data && data.success) window.location.reload();
      })
      .catch(err => {
        console.error('Error:', err);
        alert('Failed to delete comment');
      });
    }
  },

  editComment(commentId) {
    fetch(`/blog/coment/${commentId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ content: this.editText })
    })
    .then(res => {
      if (res.status === 401) { window.location.href = '/login'; return; }
      return res.json();
    })
    .then(data => {
      if (data && data.success) {
        this.isEditing = false;
        window.location.reload();
      }
    })
    .catch(err => {
      console.error('Error:', err);
      alert('Failed to edit comment');
    });
  }
}">
          <!-- Avatar -->
          <div class="flex-shrink-0">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-white font-semibold">
              {{#if this.user.profile}}
                <img src="{{this.user.profile}}" alt="{{this.user.username}}" class="w-full h-full rounded-full object-cover">
              {{else}}
                {{#if this.user.name}}
                  {{this.user.name}}
                {{else}}
                  {{this.user.username}}
                {{/if}}
              {{/if}}
            </div>
          </div>
          
          <!-- Comment Content -->
          <div class="flex-1">
            <div class="flex items-center gap-2 flex-wrap mb-1">
              <span class="font-semibold text-gray-900">
                {{#if this.user.name}}
                  {{this.user.name}}
                {{else}}
                  {{this.user.username}}
                {{/if}}
              </span>
              <span class="text-xs text-gray-500">
                {{formatDate this.createdAt}}
              </span>
            </div>
            <!-- Mode normal: tampilkan teks -->
<p x-show="!isEditing" class="text-gray-700">{{this.content}}</p>

<!-- Mode edit: tampilkan textarea + tombol -->
<div x-show="isEditing" class="mt-2">
  <textarea
    x-model="editText"
    class="w-full border rounded p-2 text-sm"
    rows="3"
  ></textarea>
  <div class="flex gap-2 mt-1">
    <button 
      @click="editComment({{this.id}})"
      class="text-sm px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600"
    >Simpan</button>
    <button 
      @click="isEditing = false; editText = '{{this.content}}'"
      class="text-sm px-3 py-1 bg-gray-200 rounded hover:bg-gray-300"
    >Batal</button>
  </div>
</div>
            
          </div>
          
          <!-- Delete Button (Only for comment owner) -->
          {{#if ../user}}
            {{#if (eq this.user.id ../user.id)}}
            <div class="flex-shrink-0">
              <button 
                @click="deleteComment({{this.id}})"
                class="text-gray-400 hover:text-red-500 transition-colors"
                title="{{t 'test.detailBlog.deleteComment'}}"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
<button 
  @click="isEditing = true"
  class="text-gray-400 hover:text-blue-500 transition-colors"
  title="Edit Comment"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
  </svg>
</button>
            </div>
            {{/if}}
          {{/if}}
        </div>
        {{/each}}
      {{else}}
        <div class="text-center py-12">
          <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <p class="text-gray-500">{{t 'test.detailBlog.noCommentsYet'}}</p>
          <p class="text-sm text-gray-400 mt-2">{{t 'test.detailBlog.beFirstToComment'}}</p>
        </div>
      {{/if}}
    </div>
  </div>
</div>

<!-- Tambahkan Alpine.js x-data untuk fungsi komentar di elemen yang sudah ada -->
