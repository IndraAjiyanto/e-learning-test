<article class='pt-24 pb-16 bg-white'>
  <div class='max-w-7xl mx-auto px-6'>
    <!-- Back Button -->
    <a
      href='/dashboard/blog'
      class='btn bg-white inline-flex items-center gap-3 px-6 py-3 mb-6 rounded-xl border border-slate-300 shadow-lg hover:shadow-xl text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-all duration-300 font-semibold text-base transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2'
    >
      <svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7' />
      </svg>
      <p class='pr-2'>{{t 'test.detailBlog.backToBlog'}}</p>
    </a>

    <div class='flex flex-col lg:flex-row gap-8 lg:gap-12'>
      <!-- Main Content -->
      <div class='lg:w-2/3'>
        <!-- Image Slider -->
        <div x-data='{ currentSlide: 0, totalSlides: {{blog.gambar.length}} }' class='relative mb-12'>
          <div class='relative rounded-2xl overflow-hidden shadow-2xl'>
            {{#each blog.gambar}}
              <div
                x-show='currentSlide === {{@index}}'
                x-transition:enter='transition ease-out duration-300'
                x-transition:enter-start='opacity-0 transform translate-x-full'
                x-transition:enter-end='opacity-100 transform translate-x-0'
                x-transition:leave='transition ease-in duration-300'
                x-transition:leave-start='opacity-100 transform translate-x-0'
                x-transition:leave-end='opacity-0 transform -translate-x-full'
                class='w-full'
              >
                <img src='{{this}}' alt='Blog image {{@index}}' class='w-full h-auto object-contain' />
              </div>
            {{/each}}

            <!-- Navigation Buttons -->
            <button
              @click='currentSlide = currentSlide > 0 ? currentSlide - 1 : totalSlides - 1'
              class='absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-900 p-3 rounded-full shadow-lg transition'
            >
              <svg class='w-6 h-6' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7' />
              </svg>
            </button>
            <button
              @click='currentSlide = currentSlide < totalSlides - 1 ? currentSlide + 1 : 0'
              class='absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-900 p-3 rounded-full shadow-lg transition'
            >
              <svg class='w-6 h-6' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7' />
              </svg>
            </button>
          </div>

          <!-- Thumbnails -->
          <div class='flex gap-2 mt-4 overflow-x-auto pb-2'>
            {{#each blog.gambar}}
              <button
                @click='currentSlide = {{@index}}'
                :class='currentSlide === {{@index}} ? "ring-4 ring-gray-900" : "ring-2 ring-gray-300"'
                class='flex-shrink-0 w-24 h-20 rounded-lg overflow-hidden transition-all hover:ring-gray-600'
              >
                <img src='{{this}}' alt='Thumbnail {{@index}}' class='w-full h-full object-cover' />
              </button>
            {{/each}}
          </div>

          <!-- Dots Indicator -->
          <div class='flex justify-center gap-2 mt-4'>
            {{#each blog.gambar}}
              <button
                @click='currentSlide = {{@index}}'
                :class='currentSlide === {{@index}} ? "bg-gray-900 w-8" : "bg-gray-300 w-2"'
                class='h-2 rounded-full transition-all'
              ></button>
            {{/each}}
          </div>
        </div>

        <!-- Blog Content -->
        <div class='max-w-none bg-white p-10 rounded-lg shadow-xl'>
          {{{blog.isi}}}
        </div>

        <!-- Comment Section - Tambahkan setelah bagian Blog Content dan sebelum Sidebar, atau di dalam Main Content setelah blog content -->
<div class="max-w-none bg-white p-10 rounded-lg shadow-xl mt-8">
  <div class="border-t border-gray-200 pt-8">
    <h3 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
      <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      {{t "test.detailBlog.commentSection.tittle"}} ({{blog.coment.length}})
    </h3>

    <!-- Comment Form - Hanya ditampilkan jika user login -->
    {{#if user}}
    <div class="mb-8 bg-gray-50 rounded-xl p-6">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-white font-semibold">
            {{#if user.profile}}
              <img src="{{user.profile}}" alt="{{user.username}}" class="w-full h-full rounded-full object-cover">
            {{else}}
                {{user.username}}
            {{/if}}
          </div>
        </div>
        <div class="flex-1">
          <form x-data="{
            commentText: '',
            isSubmitting: false,

            submitComment() {
              if (!this.commentText.trim()) return;
              this.isSubmitting = true;
              
              fetch('/blog/comment/{{blog.id}}', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({ content: this.commentText })
              })
              .then(res => {
                if (res.status === 401) {
                  window.location.href = '/login';
                  return;
                }
                return res.json();
              })
              .then(data => {
                if (data && data.success) {
                  window.location.reload();
                }
                this.isSubmitting = false;
              })
              .catch(err => {
                console.error('Error:', err);
                this.isSubmitting = false;
                alert('Failed to post comment. Please try again.');
              });
            }
          }" @submit.prevent="submitComment">
            <textarea
              x-model="commentText"
              rows="3"
              class="w-full px-4 py-3 rounded-xl border text-black border-gray-300 focus:ring-2 focus:ring-primary focus:border-transparent resize-none transition-all bg-white"
              placeholder="{{t "test.detailBlog.commentSection.placeholderComment"}}"
              :disabled="isSubmitting"
            ></textarea>
            <div class="flex justify-end mt-3">
              <button
                type="submit"
                :disabled="!commentText.trim() || isSubmitting"
                class="px-6 py-2 bg-gradient-to-br from-primary to-secondary text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed transform hover:-translate-y-0.5"
              >
                <span x-show="!isSubmitting">{{t "test.detailBlog.commentSection.submitButton"}}</span>
                <span x-show="isSubmitting" class="flex items-center gap-2">
                  <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
    {{else}}
    <div class="mb-8 bg-gray-50 rounded-xl p-6 text-center">
      <p class="text-gray-600">
        {{t "test.detailBlog.commentSection.login"}}
        <a href="/login" class="text-primary hover:underline font-semibold">{{t "test.detailBlog.commentSection.loginLink"}}</a>
      </p>
    </div>
    {{/if}}

    <!-- Comments List -->
    <div class="space-y-6">
      {{#if blog.coment.length}}
{{#each blog.coment}}
<div class="flex gap-4 p-4 rounded-xl hover:bg-gray-50 transition-all duration-200" id="comment-{{this.id}}"
  x-data="{
    isEditing: false,
    editText: '{{this.content}}',
    showReplyForm: false,
    showReplies: false,
    replyText: '',
    isSubmittingReply: false,
    replies: [],
    repliesLoaded: false,
    editingReplyId: null,
    editReplyText: '',

    toggleReplies() {
      if (!this.repliesLoaded) {
        fetch(`/blog/reply/{{this.id}}`)
          .then(res => res.json())
          .then(data => {
            this.replies = data.reply || [];
            this.repliesLoaded = true;
            this.showReplies = true;
          })
          .catch(err => console.error(err));
      } else {
        this.showReplies = !this.showReplies;
      }
    },

    loadReplies() {
      fetch(`/blog/reply/{{this.id}}`)
        .then(res => res.json())
        .then(data => { this.replies = data.reply || []; })
        .catch(err => console.error(err));
    },

deleteComment(commentId) {
  Swal.fire({
    title: `Are you sure?`,
    text: `This data will be deleted!`,
    icon: `warning`,
    showCancelButton: true,
    buttonsStyling: false,
    confirmButtonText: `Yes, delete!`,
    cancelButtonText: `Cancel`,
    customClass: {
      confirmButton: `px-4 py-2 rounded-lg bg-red-600 text-white font-semibold hover:bg-red-700 transition`,
      cancelButton: `px-4 py-2 rounded-lg bg-gray-200 text-gray-700 font-medium hover:bg-gray-300 transition`,
      actions: `flex gap-4 justify-center`
    }
  }).then((result) => {
    if (result.isConfirmed) {
      fetch(`/blog/comment/${commentId}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          Swal.fire({
            icon: `success`,
            title: `Deleted!`,
            text: `Comment has been deleted.`,
            toast: true,
            position: `bottom-start`,
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
          });
          window.location.reload();
        }
      })
      .catch(err => {
        Swal.fire({
          icon: `error`,
          title: `Fail!`,
          text: `Failed to delete comment`,
          toast: true,
          position: `bottom-start`,
          showConfirmButton: false,
          timer: 3000,
          timerProgressBar: true
        });
      });
    }
  });
},

    editComment(commentId) {
      fetch(`/blog/coment/${commentId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: this.editText })
      })
      .then(res => res.json())
      .then(data => { if (data.success) { this.isEditing = false; window.location.reload(); } })
      .catch(err => alert('Failed to edit'));
    },

    submitReply(commentId) {
      if (!this.replyText.trim()) return;
      this.isSubmittingReply = true;
      fetch(`/blog/reply/create/${commentId}/{{../blog.id}}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: this.replyText })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          this.replyText = '';
          this.showReplyForm = false;
          this.repliesLoaded = false;
          this.loadReplies();
          this.showReplies = true;
          this.repliesLoaded = true;
        }
        this.isSubmittingReply = false;
      })
      .catch(err => {
        this.isSubmittingReply = false;
          Swal.fire({
    icon: `error`,
    title: `Fail!`,
    text: `Network error, please try again`,
    toast: true,
    position: `bottom-start`,
    showConfirmButton: false,
    timer: 3000,
    timerProgressBar: true
  });
      });
    },

    startEditReply(replyId, content) {
      this.editingReplyId = replyId;
      this.editReplyText = content;
    },

    editReply(replyId) {
      fetch(`/blog/coment/${replyId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: this.editReplyText })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          this.editingReplyId = null;
          this.editReplyText = '';
          this.loadReplies();
        }
      })
      .catch(err => alert('Failed to edit'));
    },

deleteReply(replyId) {
  Swal.fire({
    title: `Are you sure?`,
    text: `This data will be deleted!`,
    icon: `warning`,
    showCancelButton: true,
    buttonsStyling: false,
    confirmButtonText: `Yes, delete!`,
    cancelButtonText: `Cancel`,
    customClass: {
      confirmButton: `px-4 py-2 rounded-lg bg-red-600 text-white font-semibold hover:bg-red-700 transition`,
      cancelButton: `px-4 py-2 rounded-lg bg-gray-200 text-gray-700 font-medium hover:bg-gray-300 transition`,
      actions: `flex gap-4 justify-center`
    }
  }).then((result) => {
    if (result.isConfirmed) {
      fetch(`/blog/comment/${replyId}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          Swal.fire({
            icon: `success`,
            title: `Deleted!`,
            text: `Reply has been deleted.`,
            toast: true,
            position: `bottom-start`,
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
          });
          this.loadReplies();
        }
      })
      .catch(err => {
        Swal.fire({
          icon: `error`,
          title: `Fail!`,
          text: `Failed to delete reply`,
          toast: true,
          position: `bottom-start`,
          showConfirmButton: false,
          timer: 3000,
          timerProgressBar: true
        });
      });
    }
  });
},

    replyToReply(username) {
      this.showReplyForm = true;
      this.replyText = '@' + username + ' ';
    },

    handleReply(username) {
      this.replyText = '@' + username + ' ';
      this.showReplyForm = true;
    }
  }">

  <!-- Avatar -->
  <div class="flex-shrink-0">
    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-white font-semibold overflow-hidden">
      {{#if this.user.profile}}
        <img src="{{this.user.profile}}" alt="{{this.user.username}}" class="w-full h-full object-cover">
      {{else}}
        {{#if this.user.name}}{{this.user.name}}{{else}}{{this.user.username}}{{/if}}
      {{/if}}
    </div>
  </div>

  <!-- Konten komentar -->
  <div class="flex-1 min-w-0">

    <!-- Header -->
    <div class="flex items-start justify-between gap-2 mb-1">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="font-semibold text-gray-900">
          {{#if this.user.name}}{{this.user.name}}{{else}}{{this.user.username}}{{/if}}
        </span>
        <span class="text-xs text-gray-500">{{formatDate this.createdAt}}</span>
      </div>
      {{#if (eq this.user.id ../user.id)}}
      <div class="flex items-center gap-1 flex-shrink-0">
        <button @click="isEditing = true" class="p-1 text-gray-400 hover:text-blue-500 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
        </button>
        <button @click="deleteComment({{this.id}})" class="p-1 text-gray-400 hover:text-red-500 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
        </button>
      </div>
      {{/if}}
    </div>

    <!-- Teks / form edit komentar -->
    <p x-show="!isEditing" class="text-gray-700 text-sm">{{this.content}}</p>
    <div x-show="isEditing" class="mt-1">
      <textarea x-model="editText" rows="3" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-sm resize-none text-black"></textarea>
      <div class="flex gap-2 mt-2">
        <button @click="editComment({{this.id}})" class="text-sm px-3 py-1 bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white rounded-lg">{{t "test.detailBlog.commentSection.saveButton"}}</button>
        <button @click="isEditing = false" class="text-sm px-3 py-1 bg-white text-black  rounded-lg hover:bg-slate-100">{{t "test.detailBlog.commentSection.cancelButton"}}</button>
      </div>
    </div>

    <!-- Tombol Reply & lihat reply -->
    <div class="flex items-center gap-3 mt-2">
      {{#if ../user}}
      <button @click="handleReply('{{this.user.username}}')"
        class="text-xs text-black hover:text-blue-500 transition-colors flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
        </svg>
        {{t "test.detailBlog.commentSection.replyButton"}}
      </button>
      {{/if}}

      <!-- ✅ Tombol lihat/sembunyikan replies — hanya muncul kalau ada reply -->
      {{#if this.children.length}}
      <button @click="toggleReplies()"
        class="text-xs text-black hover:text-blue-500 transition-colors flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01"/>
        </svg>
        <span x-text="showReplies ? '{{t "test.detailBlog.commentSection.hideReplies"}}' : '{{this.children.length}} {{t "test.detailBlog.commentSection.replies"}}'"></span>
      </button>
      {{/if}}
    </div>

    <!-- Form reply -->
    {{#if ../user}}
    <div x-show="showReplyForm" x-transition class="mt-3">
      <textarea x-model="replyText" rows="2"
        class="w-full px-3 py-2 text-sm border text-black bg-white border-gray-300 rounded-lg resize-none"
        placeholder="{{t "test.detailBlog.commentSection.placeholderReply"}}"
        :disabled="isSubmittingReply">
      </textarea>
      <div class="flex gap-2 mt-2">
        <button @click="submitReply({{this.id}})"
          :disabled="!replyText.trim() || isSubmittingReply"
          class="text-sm px-4 py-1.5 bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white rounded-lg disabled:opacity-50">
          <span x-show="!isSubmittingReply">{{t "test.detailBlog.commentSection.submitReply"}}</span>
          <span x-show="isSubmittingReply">...</span>
        </button>
        <button @click="showReplyForm = false; replyText = ''" class="text-sm px-4 py-1.5 bg-white text-black border border-gray-300 rounded-lg hover:bg-slate-100">{{t "test.detailBlog.commentSection.cancelButton"}}</button>
      </div>
    </div>
    {{/if}}

    <!-- Daftar replies — hanya tampil setelah diklik -->
    <div x-show="showReplies" x-transition class="mt-3 space-y-3 border-l-2 border-gray-100 pl-4">
      <template x-for="reply in replies" :key="reply.id">
        <div class="flex gap-3 p-3 rounded-lg bg-gray-50">

          <!-- Avatar reply -->
          <div class="flex-shrink-0">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-white text-xs font-semibold overflow-hidden">
              <template x-if="reply.user.profile">
                <img :src="reply.user.profile" :alt="reply.user.username" class="w-full h-full object-cover">
              </template>
              <template x-if="!reply.user.profile">
                <span x-text="reply.user.name || reply.user.username"></span>
              </template>
            </div>
          </div>

          <!-- Isi reply -->
          <div class="flex-1">
            <div class="flex items-start justify-between gap-2 mb-1">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-gray-900 text-sm" x-text="reply.user.name || reply.user.username"></span>
                <span class="text-xs text-gray-400" x-text="new Date(reply.createdAt).toLocaleDateString()"></span>
              </div>

              <!-- Tombol edit/delete reply -->
              {{#if ../user}}
              <template x-if="reply.user.id === {{../user.id}}">
                <div class="flex items-center gap-1">
                  <button @click="startEditReply(reply.id, reply.content)" class="p-1 text-gray-400 hover:text-blue-500">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                  </button>
                  <button @click="deleteReply(reply.id)" class="p-1 text-gray-400 hover:text-red-500">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                  </button>
                </div>
              </template>
              {{/if}}
            </div>

            <!-- Teks reply -->
            <p x-show="editingReplyId !== reply.id" class="text-gray-700 text-sm" x-text="reply.content"></p>

            <!-- Form edit reply -->
            <div x-show="editingReplyId === reply.id" class="mt-1">
              <textarea x-model="editReplyText" rows="2" class="w-full border bg-white border-gray-300 rounded-lg px-3 py-2 text-sm resize-none text-black"></textarea>
              <div class="flex gap-2 mt-1">
                <button @click="editReply(reply.id)" class="text-xs px-3 py-1 bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white rounded-lg">{{t "test.detailBlog.commentSection.submitReply"}}</button>
                <button @click="editingReplyId = null" class="text-xs px-3 py-1 bg-white text-black border border-gray-300 rounded-lg hover:bg-slate-100">{{t "test.detailBlog.commentSection.cancelButton"}}</button>
              </div>
            </div>

            <!-- Tombol reply dari reply -->
            {{#if ../user}}
            <button @click="replyToReply(reply.user.username)"
              class="mt-1 text-xs text-black hover:text-blue-500 flex items-center gap-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
