<div class="border-t border-gray-200 pt-6 mt-6">
  <div 
    x-data="{
      userLike: {{#if userLike}}{{userLike.length}}{{else}}0{{/if}},
      countLike: {{blog.likes.length}},
      copySuccess: false,
      
      likeBlog(id) {
        fetch('/blog/like/' + id, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        })
        .then(res => {
          if (res.status === 401) {
            window.location.href = '/login';
            return;
          }
          return res.json();
        })
        .then(data => {
          if (data) {
            this.userLike = data.userLike;
            this.countLike = data.countLike;
          }
        })
        .catch(err => console.error('Error:', err));
      },
      
      shareOnPlatform(platform) {
        const url = window.location.href;
        const title = '{{blog.judul}}';
        const description = '{{blog.description}}';
        
        const shareUrls = {
          facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
          twitter: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`,
          whatsapp: `https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' ' + url)}`,
          linkedin: `https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}&summary=${encodeURIComponent(description)}`,
        };
        
        if (shareUrls[platform]) {
          window.open(shareUrls[platform], '_blank', 'width=600,height=400');
        }
      },
      
      copyLink() {
        const url = window.location.href;
        navigator.clipboard.writeText(url)
          .then(() => {
            this.copySuccess = true;
            setTimeout(() => { this.copySuccess = false; }, 2000);
          })
          .catch(() => alert('Failed to copy link'));
      }
    }"
    class="flex items-center gap-4 justify-around py-4"
  >
    <button
      @click="likeBlog({{blog.id}})"
      :class="userLike > 0 ? 'text-red-500' : 'text-gray-600'"
