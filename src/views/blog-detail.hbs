<article class='pt-24 pb-16'>
  <div class='max-w-7xl mx-auto px-6'>

    <a
  href="/dashboard/blog"
  class="gap-2 bg-white shadow-lg rounded-full items-center text-gray-900 p-3 hover:bg-gray-100 transition mb-5 inline-flex"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M15 19l-7-7 7-7" />
  </svg>
  <p class="pr-2">
  {{t "test.detailBlog.backToBlog"}}
  </p>
</a>


<div class="flex flex-col md:flex-row md:items-center md:gap-4 mb-6">
  <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight md:mb-0 mb-2">
    {{blog.judul}}
  </h1>

<div
  class="inline-flex w-fit max-w-full items-center gap-2
         bg-gradient-to-br from-primary via-secondary to-gray-900
         text-white px-4 py-2 rounded-full text-sm"
>
  <i class="{{computeIcon blog.kategori_blog.icon}}"></i>
  <span class="font-semibold whitespace-nowrap md:whitespace-normal">
    {{blog.kategori_blog.nama}}
  </span>
</div>

</div>


    <div class='flex flex-wrap items-center gap-6 text-gray-600 mb-8 pb-8 border-b border-gray-200'>
            <div class='flex items-center gap-2'>
<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
  <path
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    d="M12 12a4 4 0 100-8 4 4 0 000 8zm6 8H6a6 6 0 0112 0z"
  />
</svg>

        <span>{{blog.author}}</span>
      </div>
      <div class='flex items-center gap-2'>
        <svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' />
        </svg>
        <time>{{formatDate blog.createdAt}}</time>
      </div>

    </div>

    {{#if blog.gambar}}
      {{#if (isArray blog.gambar)}}
        <div x-data='{ currentSlide: 0, totalSlides: {{blog.gambar.length}} }' class='relative mb-12'>
<div class="relative rounded-2xl overflow-hidden shadow-2xl max-w-full md:max-w-4xl mx-auto">
  {{#each blog.gambar}}
    <div
      x-show="currentSlide === {{@index}}"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 transform translate-x-full"
      x-transition:enter-end="opacity-100 transform translate-x-0"
      x-transition:leave="transition ease-in duration-300"
      x-transition:leave-start="opacity-100 transform translate-x-0"
      x-transition:leave-end="opacity-0 transform -translate-x-full"
      class="w-full"
    >
      <img
        src="{{this}}"
        alt="Blog image {{addOne @index}}"
        class="w-full h-auto object-contain"
      />
    </div>
  {{/each}}

  {{#if (gt blog.gambar.length 1)}}
    <button
      @click="currentSlide = currentSlide > 0 ? currentSlide - 1 : totalSlides - 1"
      class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-900 p-3 rounded-full shadow-lg transition"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      @click="currentSlide = currentSlide < totalSlides - 1 ? currentSlide + 1 : 0"
      class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-900 p-3 rounded-full shadow-lg transition"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  {{/if}}
</div>


          {{#if (gt blog.gambar.length 1)}}
            <div class='flex gap-2 mt-4 overflow-x-auto pb-2'>
              {{#each blog.gambar}}
                <button
                  @click='currentSlide = {{@index}}'
                  :class='currentSlide === {{@index}} ? "ring-4 ring-gray-900" : "ring-2 ring-gray-300"'
                  class='flex-shrink-0 w-24 h-20 rounded-lg overflow-hidden transition-all hover:ring-gray-600'
                >
                  <img
                    src='{{this}}'
                    alt='Thumbnail {{addOne @index}}'
                    class='w-full h-full object-cover'
                  />
                </button>
              {{/each}}
            </div>

            <div class='flex justify-center gap-2 mt-4'>
              {{#each blog.gambar}}
                <button
                  @click='currentSlide = {{@index}}'
                  :class='currentSlide === {{@index}} ? "bg-gray-900 w-8" : "bg-gray-300 w-2"'
                  class='h-2 rounded-full transition-all'
                ></button>
              {{/each}}
            </div>
          {{/if}}
        </div>
      {{else}}
        <div class='relative rounded-2xl overflow-hidden shadow-2xl mb-12'>
          <img
            src='{{blog.gambar}}'
            alt='{{blog.judul}}'
            class='w-full h-auto'
          />
        </div>
      {{/if}}
    {{/if}}

    <div class='prose prose-lg max-w-none'>
      <div class='text-gray-700 leading-relaxed whitespace-pre-line'>
        {{{blog.isi}}}
      </div>
    </div>


    <div class='mt-12 pt-8 border-t border-gray-200'>
      <h3 class='text-lg font-semibold text-gray-900 mb-4'>{{t "test.detailBlog.share"}}</h3>
      <div class='flex flex-wrap gap-3'>
        <button onclick="shareData('facebook', {{json blog}})"
          class='flex items-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors'
        >
          <svg class='w-5 h-5' fill='currentColor' viewBox='0 0 24 24'>
            <path d='M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' />
          </svg>
          Facebook
        </button>
        <button onclick="shareData('twitter', {{json blog}})"
          class='flex items-center gap-2 px-6 py-3 bg-blue-400 text-white rounded-lg hover:bg-blue-500 transition-colors'
        >
          <svg class='w-5 h-5' fill='currentColor' viewBox='0 0 24 24'>
            <path d='M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z' />
          </svg>
          Twitter
        </button>
        <button onclick="shareData('whatsapp', {{json blog}})"
          class='flex items-center gap-2 px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors'
        >
          <svg class='w-5 h-5' fill='currentColor' viewBox='0 0 24 24'>
            <path d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z' />
          </svg>
          WhatsApp
        </button>
        <button onclick="shareData('copy', {{json blog}})"
          class='flex items-center gap-2 px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors'
        >
          <svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z' />
          </svg>
          Copy Link
        </button>
      </div>
    </div>
  </div>
</article>

{{#if recentBlogs}}
  <section class='py-16 bg-gray-50'>
    <div class='max-w-7xl mx-auto px-6'>
      <h2 class='text-3xl font-bold text-gray-900 mb-8'>{{t "test.detailBlog.relatedBlog"}}</h2>
      <div class='grid md:grid-cols-2 lg:grid-cols-3 gap-8'>
        {{#each recentBlogs}}
         <div
    x-data='{ 
      currentSlide: 0, 
      autoSlide: null,
      images: {{#if this.gambar}}[{{#each this.gambar}}"{{this}}"{{#unless @last}},{{/unless}}{{/each}}]{{else}}[]{{/if}}
    }'
    x-init="
      if (images.length > 1) {
        autoSlide = setInterval(() => { 
          currentSlide = (currentSlide + 1) % images.length;
        }, 3000);
      }
    "
            @mouseenter='if (autoSlide) clearInterval(autoSlide)'
            @mouseleave='if (Array.isArray({{this.gambar}}) && {{this.gambar}}.length > 1) autoSlide = setInterval(() => { currentSlide = (currentSlide + 1) % (Array.isArray({{this.gambar}}) ? {{this.gambar}}.length : 1) }, 3000)'
          >

            <div
              class='bg-white border border-gray-200 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1'
            >
              <div class='relative overflow-hidden rounded-t-xl'>
                <div class='relative h-44 w-full'>
                  <div
                  >
                  {{#each this.gambar}}
                    <img
                      :src='{{this}}'
                      :alt="{{../judul}} + ' - Image ' + (index + 1)"
                      class='absolute inset-0 w-full h-44 object-cover transition-opacity duration-500'
                      :class="{ 'opacity-100': currentSlide === index, 'opacity-0': currentSlide !== index }"
                    />
                    {{/each}}
                  </div>
                </div>

        
                {{#if this.gambar}}
                  <div>
                    <button
                      @click='currentSlide = currentSlide === 0 ? (Array.isArray({{this.gambar}}) ? {{this.gambar}}.length : 1) - 1 : currentSlide - 1'
                      class='absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-800 rounded-full p-2 shadow-md transition-all duration-200 hover:scale-110 z-10'
                    >
                      <svg
                        class='w-4 h-4'
                        fill='none'
                        stroke='currentColor'
                        viewBox='0 0 24 24'
                      >
                        <path
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          stroke-width='2'
                          d='M15 19l-7-7 7-7'
                        ></path>
                      </svg>
                    </button>
                    <button
                      @click='currentSlide = (currentSlide + 1) % (Array.isArray({{this.gambar}}) ? {{this.gambar}}.length : 1)'
                      class='absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-800 rounded-full p-2 shadow-md transition-all duration-200 hover:scale-110 z-10'
                    >
                      <svg
                        class='w-4 h-4'
                        fill='none'
                        stroke='currentColor'
                        viewBox='0 0 24 24'
                      >
                        <path
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          stroke-width='2'
                          d='M9 5l7 7-7 7'
                        ></path>
                      </svg>
                    </button>
                  </div>
                {{/if}}

                <div
                  class='absolute top-3 left-3 bg-white/95 backdrop-blur-sm text-gray-800 text-xs px-3 py-1 rounded-md shadow-md'
                >
                  <span x-text="{{this.author}}"></span>
                </div>

                {{#if this.gambar}}
                  <div
                    class='absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2'
                  >
                    {{#each this.gambar}}
                      <button
                        @click='currentSlide = index'
                        class='w-2 h-2 rounded-full transition-all duration-200'
                        :class="{ 'bg-white': currentSlide === index, 'bg-white/50': currentSlide !== index }"
                      ></button>
                      {{/each}}
                  </div>
                  {{/if}}
              </div>

              <div class='p-6 space-y-4'>
                <div class='flex flex-wrap gap-1'>
                  <span
                    class='badge bg-gradient-to-br from-primary via-secondary to-gray-900  text-white px-3 py-1 text-xs font-semibold rounded-full'
                    x-text="{{this.kategori_blog.nama}}"
                  >
                  </span>
                </div>

                <h3
                  class='text-lg font-semibold text-gray-900 leading-tight'
                  x-text="{{this.judul}}"
                ></h3>


                <div class='mt-6'>
                  <a
                    :href="'/blog/detail/' + {{this.id}}"
                    class='btn bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white text-lg px-8 py-3 w-full border-0 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1'
                  >
                    {{t "test.blog.detailButton"}}
                  </a>
                </div>
              </div>
            </div>
          </div>
        {{/each}}
      </div>

      <div class='text-center mt-12'>
        <a href='/dashboard/blog' class='inline-flex items-center gap-2  font-semibold btn bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white text-base px-8 py-3 border-0 shadow-lg hover:shadow-xl transition-xall duration-300 transform hover:-translate-y-1'>
          {{t "test.detailBlog.buttonViewAllBlog"}}
        </a>
      </div>
    </div>
  </section>
{{/if}}

<style>
  .prose {
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .prose p {
    margin-bottom: 1.5rem;
  }

  .prose h2 {
    font-size: 1.875rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: #111827;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #111827;
  }

  .prose ul, .prose ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose blockquote {
    border-left: 4px solid #111827;
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: #4B5563;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>


<script>
  const shareData = (platform, blog) => {
  const url = window.location.href;
  const title = blog.judul;
  const description = blog.isi || "";
  const image = blog.gambar?.[0] || "";

  switch(platform) {
    case 'facebook':
      window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, '_blank');
      break;

    case 'twitter':
      window.open(
        `https://twitter.com/intent/tweet?text=${encodeURIComponent(title + " - " + description)}&url=${encodeURIComponent(url)}`,
        '_blank'
      );
      break;

    case 'whatsapp':
      window.open(
        `https://api.whatsapp.com/send?text=${encodeURIComponent(title + " " + url)}`,
        '_blank'
      );
      break;

    case 'copy':
      const textToCopy = `${url}`;
      navigator.clipboard.writeText(textToCopy).then(() => alert('Link copied with title!'));x
      break;
  }
};

</script>
