<article class='pt-24 pb-16 bg-white'>
  <div class='max-w-7xl mx-auto px-6'>
    {{#if (eq user.role "super_admin")}}
    {{else}}
    <!-- Back Button -->
    <a
      href='/dashboard/blog'
      class='btn bg-white inline-flex items-center gap-3 px-6 py-3 mb-6 rounded-xl border border-slate-300 shadow-lg hover:shadow-xl text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-all duration-300 font-semibold text-base transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2'
    >
      <svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7' />
      </svg>
      <p class='pr-2'>{{t 'test.detailBlog.backToBlog'}}</p>
    </a>
    {{/if}}

    <div class='flex flex-col lg:flex-row gap-8 lg:gap-12'>
      <!-- Main Content -->
      <div class='lg:w-2/3'>
      {{> blog_detail/image_slider}}

      {{> blog_detail/content}}

{{> blog_detail/coment}}
      </div>

{{> blog_detail/sidebar}}

    </div>
  </div>
</article>

{{#if recentBlogs}}
  <section class='py-16 bg-gray-50'>
    <div class='max-w-7xl mx-auto px-6'>
      <h2 class='text-3xl font-bold text-gray-900 mt-0 mb-8'>{{t 'test.detailBlog.relatedBlog'}}</h2>
<div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'>
  {{#each recentBlogs}}
  <div class='bg-white border border-gray-200 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1'>
    
    <!-- Image Container -->
    <div class='relative overflow-hidden rounded-t-xl'>
      <div class='relative h-44 w-full'>
        {{#if (isArray gambar)}}
          {{#each gambar}}
            <img
              src='{{this}}'
              class='absolute inset-0 w-full h-44 object-cover {{#unless @first}}hidden{{/unless}}'
            />
          {{/each}}
        {{else}}
          <img
            src='{{gambar}}'
            class='absolute inset-0 w-full h-44 object-cover'
          />
        {{/if}}
      </div>

      <!-- Author Badge -->
      <div class='absolute top-3 left-3 bg-white/95 backdrop-blur-sm text-gray-800 text-xs px-3 py-1 rounded-md shadow-md flex items-center'>
        <span>{{author}}</span>
      </div>
    </div>

    <!-- Content -->
    <div class='p-4'>
      <!-- Category and Date -->
      <div class='flex items-center justify-between mb-2'>
        <span class='badge bg-gradient-to-br from-primary via-secondary to-gray-900 text-white px-2 py-0.5 text-xs font-semibold rounded-full'>
          {{#if category}}{{category.name}}{{else}}No Type{{/if}}
        </span>
      </div>

      <!-- Title -->
      <h3 class='text-base font-semibold text-gray-900 leading-tight hover:text-gray-700 transition-colors line-clamp-2 mb-2'>
        {{#if judul}}{{judul}}{{else}}No Title{{/if}}
      </h3>

      <!-- Excerpt -->
      <p class="text-xs text-gray-600 line-clamp-2 mb-3 text-justify">{{description}}</p>

      <!-- Stats -->
      <div class="flex items-center justify-between text-xs text-gray-500 mb-3">
        <div class="flex items-center space-x-3">
          <span class="flex items-center">
<i class="far fa-heart mr-1 {{#each likes}}{{#if (eq this.user.id ../../user.id)}}fas text-red-500{{/if}}{{/each}}"></i>
            <span>{{likes.length}}</span>
          </span>
        </div>
        <span class="flex items-center">
          <i class="far fa-eye mr-1"></i>
          <span>{{views}}</span>
        </span>
      </div>

      <!-- Tags -->
      <div class="flex flex-wrap gap-1 mb-3">
        {{#each tags}}
          <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full">{{this}}</span>
        {{/each}}
      </div>
      
      <a   href='/blog/detail/{{id}}'
        class='btn bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white text-sm px-4 py-2 w-full border-0 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 rounded-lg flex items-center justify-center'
      >
        <span>{{t 'test.blog.readMore'}}</span>
      </a>
    </div>

  </div>
  {{/each}}
</div>  
  </section>
{{/if}}

<script>
  const shareData = (platform, blog) => {
    const url = window.location.href;
    const title = blog.judul;
    const description = blog.description || "";
    const image = blog.gambar?.[0] || "";

    switch (platform) {
      case "facebook":
        window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, "_blank");
        break;
      case "twitter":
        window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(title + " - " + description)}&url=${encodeURIComponent(url)}`, "_blank");
        break;
      case "whatsapp":
        window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(title + " " + url)}`, "_blank");
        break;
      case "linkedin":
        window.open(`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}&summary=${encodeURIComponent(description)}`, "_blank");
        break;
      case "copy":
        navigator.clipboard.writeText(url)
          .then(() => alert("Link copied!"))
          .catch(() => alert("Failed to copy link"));
        break;
    }
  };
</script>