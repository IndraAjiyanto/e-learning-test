{{!-- Dibungkus chrome backoffice. Halaman ini ditautkan dari dalam area
     belajar tetapi punya rute sendiri; sebelumnya memakai navbar publik
     dan footer. Controller-nya merender dengan bareShell: true.
     Lihat docs/user-area-learning-consolidation-plan.md tahap 2. --}}
{{#> user/shell_frame/index user=user active='learning'}}
<div
  class='max-w-7xl mx-auto px-4 py-8'
  x-data='{
    slideTitle: "",
    pptFile: "",

    async selectMaterial(title, file) {
      this.slideTitle = title;
       this.pptFile = file.replace(`/pub?`, `/pubembed?`);
    },
  downloadMaterial(file) {
    const match = file.match(/\/d\/e\/([\w-]+)\//);
    const downloadUrl = match 
      ? `https://docs.google.com/presentation/d/e/${match[1]}/export/pptx`
      : file;
    window.open(downloadUrl, "_blank");
  },


    
  }'
>

  <div class='mb-8'>
    <a
      href='/program/{{session.weeks.course.id}}'
      class='inline-flex h-[44px] items-center justify-center gap-2 rounded-[8px] border border-[#D4D4D4] bg-white px-[18px] font-inter text-base font-semibold text-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#F5F5F5]'
    >
      <svg
        class='w-5 h-5'
        fill='none'
        stroke='currentColor'
        viewBox='0 0 24 24'
      >
        <path
          stroke-linecap='round'
          stroke-linejoin='round'
          stroke-width='2'
          d='M15 19l-7-7 7-7'
        ></path>
      </svg>
      {{t 'test.material.ppt.backToProgram'}}
    </a>
  </div>

  <div class='grid grid-cols-1 lg:grid-cols-3 gap-8'>

    <!-- PPT Viewer -->
    <div class='col-span-2'>
      <div
        class='bg-white border border-[#E5E5E5] rounded-xl shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] overflow-hidden'
      >

        <!-- PPT Display Container -->
        <template x-if='pptFile'>
          <div class='relative h-[600px] bg-white'>
            <!-- Iframe untuk tampilkan PPT langsung -->
<iframe :src="pptFile" class="w-full h-full border-none"   allowfullscreen="true"
  mozallowfullscreen="true"
  webkitallowfullscreen="true"></iframe>
          </div>
        </template>

        <!-- Empty State -->
        <template x-if='!pptFile'>
          <div
            class='h-[600px] flex items-center justify-center bg-[#FAFAFA]'
          >
            <div class='text-center px-6'>
              <div
                class='p-6 bg-white/50 rounded-full w-24 h-24 mx-auto mb-6 flex items-center justify-center shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]'
              >
                <svg
                  xmlns='http://www.w3.org/2000/svg'
                  class='h-12 w-12 text-[#A3A3A3]'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
                  />
                </svg>
              </div>
              <p class='text-[#525252] text-lg font-semibold mb-2'>{{t
                  'test.material.ppt.noPresentationSelected'
                }}</p>
              <p class='text-[#A3A3A3] text-sm'>{{t
                  'test.material.ppt.selectPPTInstruction'
                }}</p>
            </div>
          </div>
        </template>
      </div>

      <div class='mt-6'>
        <h1
          class='text-2xl font-bold text-[#003060] font-montserrat'
          x-text="slideTitle || '{{t
            "test.material.ppt.selectPPTInstruction"
          }}'"
        ></h1>
      </div>
    </div>

    <!-- Materials Sidebar -->
    <div
      class='bg-white border border-[#E5E5E5] rounded-xl shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] overflow-hidden'
    >
      <div class='bg-[#003060] px-6 py-4'>
        <h2
          class='text-xl font-semibold text-white flex items-center font-montserrat'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            class='h-6 w-6 mr-2'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10'
            />
          </svg>
          {{t 'test.material.ppt.materiProgram'}}
        </h2>
      </div>

      <div class='p-6'>
        {{#if materi.length}}
          <div class='space-y-3'>
            {{#each materi}}
<div
  class='w-full text-left px-4 py-4 rounded-lg border border-[#E5E5E5] hover:border-[#D4D4D4] bg-white hover:bg-[#FAFAFA] transition-all duration-200 shadow-sm group cursor-pointer'
  @click='selectMaterial("{{title}}", "{{file}}")'
>
  <div class='flex items-center justify-between'>
    <div class='flex items-center flex-1'>
      <span
        class='font-medium text-[#171717] group-hover:text-[#404040] transition-colors duration-200'
      >{{title}}</span>
    </div>
    <div class='flex items-center gap-2'>
      <button
        type="button"
        @click.stop='downloadMaterial("{{file}}")'
        class='p-1.5 rounded-lg bg-slate-100 hover:bg-green-600 text-[#525252] hover:text-white transition-all duration-200'
        title='Download PPT'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='h-4 w-4'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='2'
            d='M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
          />
        </svg>
      </button>
    </div>
  </div>
</div>
            {{/each}}
          </div>
        {{else}}
          <div class='text-center py-8'>
            <svg
              xmlns='http://www.w3.org/2000/svg'
              class='h-12 w-12 text-[#A3A3A3] mx-auto mb-3'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
              />
            </svg>
            <p class='text-[#737373] text-sm font-medium'>{{t
                'test.material.ppt.noMateriAvailable'
              }}</p>
            <p class='text-[#A3A3A3] text-xs mt-1'>{{t
                'test.material.ppt.spanNoMateriAvailable'
              }}</p>
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>

<!-- JSZip untuk extract PPTX (jika diperlukan di masa depan) -->
<script
  src='https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js'
></script>
{{/user/shell_frame/index}}
