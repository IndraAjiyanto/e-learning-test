<div
  class='max-w-7xl mx-auto px-4 py-10 pt-28'
  x-data='{
    slideTitle: "",
    pptFile: "",

    async selectMaterial(title, file) {
      this.slideTitle = title;
       this.pptFile = file.replace(`/pub?`, `/pubembed?`);
    },
  downloadMaterial(file) {
    const match = file.match(/\/d\/e\/([\w-]+)\//);
    const downloadUrl = match 
      ? `https://docs.google.com/presentation/d/e/${match[1]}/export/pptx`
      : file;
    window.open(downloadUrl, "_blank");
  },


    
  }'
>

  <div class='mb-8'>
    <a
      href='/program/{{pertemuan.minggu.kelas.id}}'
      class='btn bg-white inline-flex items-center gap-3 px-6 py-3 rounded-xl border border-slate-300 shadow-lg hover:shadow-xl text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-all duration-300 font-semibold text-base transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2'
    >
      <svg
        class='w-5 h-5'
        fill='none'
        stroke='currentColor'
        viewBox='0 0 24 24'
      >
        <path
          stroke-linecap='round'
          stroke-linejoin='round'
          stroke-width='2'
          d='M15 19l-7-7 7-7'
        ></path>
      </svg>
      {{t 'test.material.ppt.backToProgram'}}
    </a>
  </div>

  <div class='grid grid-cols-1 lg:grid-cols-3 gap-8'>

    <!-- PPT Viewer -->
    <div class='col-span-2'>
      <div
        class='bg-gradient-to-br from-slate-50 to-white border border-slate-200 rounded-2xl shadow-lg overflow-hidden'
      >

        <!-- PPT Display Container -->
        <template x-if='pptFile'>
          <div class='relative h-[600px] bg-white'>
            <!-- Iframe untuk tampilkan PPT langsung -->
<iframe :src="pptFile" class="w-full h-full border-none"   allowfullscreen="true"
  mozallowfullscreen="true"
  webkitallowfullscreen="true"></iframe>
          </div>
        </template>

        <!-- Empty State -->
        <template x-if='!pptFile'>
          <div
            class='h-[600px] flex items-center justify-center bg-gradient-to-br from-slate-100 to-slate-50'
          >
            <div class='text-center px-6'>
              <div
                class='p-6 bg-white/50 rounded-full w-24 h-24 mx-auto mb-6 flex items-center justify-center shadow-lg'
              >
                <svg
                  xmlns='http://www.w3.org/2000/svg'
                  class='h-12 w-12 text-slate-400'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
                  />
                </svg>
              </div>
              <p class='text-slate-600 text-lg font-semibold mb-2'>{{t
                  'test.material.ppt.noPresentationSelected'
                }}</p>
              <p class='text-slate-400 text-sm'>{{t
                  'test.material.ppt.selectPPTInstruction'
                }}</p>
            </div>
          </div>
        </template>
      </div>

      <div class='mt-6'>
        <h1
          class='text-3xl font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent font-montserrat'
          x-text="slideTitle || '{{t
            "test.material.ppt.selectPPTInstruction"
          }}'"
        ></h1>
      </div>
    </div>

    <!-- Materials Sidebar -->
    <div
      class='bg-gradient-to-br from-white to-slate-50 border border-slate-200 rounded-2xl shadow-lg overflow-hidden'
    >
      <div class='bg-gradient-to-r from-slate-900 to-slate-800 px-6 py-4'>
        <h2
          class='text-xl font-semibold text-white flex items-center font-montserrat'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            class='h-6 w-6 mr-2'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10'
            />
          </svg>
          {{t 'test.material.ppt.materiProgram'}}
        </h2>
      </div>

      <div class='p-6'>
        {{#if materi.length}}
          <div class='space-y-3'>
            {{#each materi}}
<div
  class='w-full text-left px-4 py-4 rounded-lg border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 transition-all duration-200 shadow-sm hover:shadow-md group cursor-pointer'
  @click='selectMaterial("{{judul}}", "{{file}}")'
>
  <div class='flex items-center justify-between'>
    <div class='flex items-center flex-1'>
      <span
        class='font-medium text-slate-900 group-hover:text-slate-700 transition-colors duration-200'
      >{{judul}}</span>
    </div>
    <div class='flex items-center gap-2'>
      <button
        type="button"
        @click.stop='downloadMaterial("{{file}}")'
        class='p-1.5 rounded-lg bg-slate-100 hover:bg-green-600 text-slate-600 hover:text-white transition-all duration-200'
        title='Download PPT'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='h-4 w-4'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='2'
            d='M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
          />
        </svg>
      </button>
    </div>
  </div>
</div>
            {{/each}}
          </div>
        {{else}}
          <div class='text-center py-8'>
            <svg
              xmlns='http://www.w3.org/2000/svg'
              class='h-12 w-12 text-slate-400 mx-auto mb-3'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
              />
            </svg>
            <p class='text-slate-500 text-sm font-medium'>{{t
                'test.material.ppt.noMateriAvailable'
              }}</p>
            <p class='text-slate-400 text-xs mt-1'>{{t
                'test.material.ppt.spanNoMateriAvailable'
              }}</p>
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>

<!-- JSZip untuk extract PPTX (jika diperlukan di masa depan) -->
<script
  src='https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js'
></script>