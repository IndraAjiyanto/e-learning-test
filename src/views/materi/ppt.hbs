<div
  class='max-w-7xl mx-auto px-4 py-10 pt-28'
  x-data='{
    slides: [],
    currentSlide: 0,
    slideTitle: "",
    pptFile: "",
    selectMaterial(slideUrls, title, file) {
      this.slides = slideUrls;
      this.slideTitle = title;
      this.pptFile = file;
      this.currentSlide = 0;
    },
    nextSlide() {
      if (this.currentSlide < this.slides.length - 1) {
        this.currentSlide++;
      }
    },
    prevSlide() {
      if (this.currentSlide > 0) {
        this.currentSlide--;
      }
    },
    goToSlide(index) {
      this.currentSlide = index;
    }
  }'
>

  <div class='mb-8'>
    <a
      href='/kelass/{{pertemuan.minggu.kelas.id}}'
      class='inline-flex items-center gap-3 px-6 py-3 rounded-xl border border-slate-300 shadow-lg hover:shadow-xl text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-all duration-300 font-semibold text-base transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2'
    >
      <svg
        class='w-5 h-5'
        fill='none'
        stroke='currentColor'
        viewBox='0 0 24 24'
      >
        <path
          stroke-linecap='round'
          stroke-linejoin='round'
          stroke-width='2'
          d='M15 19l-7-7 7-7'
        ></path>
      </svg>
      {{t "test.material.ppt.backToProgram"}}
    </a>
  </div>

  <div class='grid grid-cols-1 lg:grid-cols-3 gap-8'>

    <!-- Slide Viewer -->
    <div class='col-span-2'>
      <div
        class='bg-gradient-to-br from-slate-50 to-white border border-slate-200 rounded-2xl shadow-lg overflow-hidden'
      >
        <!-- Slides Container -->
        <template x-if='slides.length > 0'>
          <div class='relative'>
            <!-- Main Slide -->
            <div class='relative h-[600px] bg-gradient-to-br from-slate-50 to-white'>
            <template x-for='(slide, index) in slides' :key='index'>
              <div
                x-show='currentSlide === index'
                x-transition:enter='transition ease-out duration-300'
                x-transition:enter-start='opacity-0 transform translate-x-full'
                x-transition:enter-end='opacity-100 transform translate-x-0'
                x-transition:leave='transition ease-in duration-300'
                x-transition:leave-start='opacity-100 transform translate-x-0'
                x-transition:leave-end='opacity-0 transform -translate-x-full'
                class='absolute inset-0 flex items-center justify-center p-4'
              >
                <img
                  :src='slide'
                  :alt='`Slide ${index + 1}`'
                  class='max-w-full max-h-full object-contain rounded-lg shadow-lg'
                />
              </div>
            </template>

            <!-- Navigation Buttons -->
            <button
              @click='prevSlide()'
              x-show='currentSlide > 0'
              class='absolute left-4 top-1/2 -translate-y-1/2 bg-slate-900/80 hover:bg-slate-900 text-white p-3 rounded-full shadow-lg transition-all duration-200 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-slate-500'
            >
              <svg class='w-6 h-6' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7'></path>
              </svg>
            </button>

            <button
              @click='nextSlide()'
              x-show='currentSlide < slides.length - 1'
              class='absolute right-4 top-1/2 -translate-y-1/2 bg-slate-900/80 hover:bg-slate-900 text-white p-3 rounded-full shadow-lg transition-all duration-200 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-slate-500'
            >
              <svg class='w-6 h-6' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7'></path>
              </svg>
            </button>

            <!-- Slide Counter -->
            <div class='absolute bottom-4 left-1/2 -translate-x-1/2 bg-slate-900/80 text-white px-4 py-2 rounded-full shadow-lg'>
              <span class='font-semibold' x-text='currentSlide + 1'></span>
              <span class='mx-1'>/</span>
              <span x-text='slides.length'></span>
            </div>
          </div>

          <!-- Thumbnail Navigation -->
          <div class='bg-slate-100 p-4 border-t border-slate-200'>
            <div class='flex gap-2 overflow-x-auto pb-2 scrollbar-thin scrollbar-thumb-slate-400 scrollbar-track-slate-200'>
              <template x-for='(slide, index) in slides' :key='index'>
                <button
                  @click='goToSlide(index)'
                  :class='currentSlide === index ? "ring-2 ring-slate-900 ring-offset-2" : "opacity-60 hover:opacity-100"'
                  class='flex-shrink-0 w-24 h-16 rounded-lg overflow-hidden transition-all duration-200 focus:outline-none'
                >
                  <img
                    :src='slide'
                    :alt='`Thumbnail ${index + 1}`'
                    class='w-full h-full object-cover'
                  />
                </button>
              </template>
            </div>
          </div>
        </template>

        <!-- Empty State -->
        <template x-if='slides.length === 0'>
          <div
            class='h-[600px] flex items-center justify-center bg-gradient-to-br from-slate-100 to-slate-50'
          >
            <div class='text-center px-6'>
              <div
                class='p-6 bg-white/50 rounded-full w-24 h-24 mx-auto mb-6 flex items-center justify-center shadow-lg'
              >
                <svg
                  xmlns='http://www.w3.org/2000/svg'
                  class='h-12 w-12 text-slate-400'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
                  />
                </svg>
              </div>
              <p class='text-slate-600 text-lg font-semibold mb-2'>{{t "test.material.ppt.noPresentationSelected"}}</p>
              <p class='text-slate-400 text-sm'>{{t "test.material.ppt.selectPPTInstruction"}}</p>
            </div>
          </div>
        </template>
      </div>

      <div class='mt-6'>
        <h1
          class='text-3xl font-bold bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent font-montserrat'
          x-text="slideTitle || '{{t "test.material.ppt.selectPPTInstruction"}}'"
        ></h1>
      </div>
    </div>    <!-- Materials Sidebar -->
    <div
      class='bg-gradient-to-br from-white to-slate-50 border border-slate-200 rounded-2xl shadow-lg overflow-hidden'
    >
      <div class='bg-gradient-to-r from-slate-900 to-slate-800 px-6 py-4'>
        <h2
          class='text-xl font-semibold text-white flex items-center font-montserrat'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            class='h-6 w-6 mr-2'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10'
            />
          </svg>
          {{t "test.material.ppt.materiProgram"}}
        </h2>
      </div>

      <div class='p-6'>
        {{#if materi.length}}
          <div class='space-y-3'>
            {{#each materi}}
              <button
                class='w-full text-left px-4 py-4 rounded-lg border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 transition-all duration-200 shadow-sm hover:shadow-md group'
                @click='selectMaterial({{{json this.slides}}}, "{{judul}}", "{{file}}")'
              >
                <div class='flex items-center justify-between'>
                  <div class='flex items-center flex-1'>
                    <span
                      class='font-medium text-slate-900 group-hover:text-slate-700 transition-colors duration-200'
                    >{{judul}}</span>
                  </div>
                  <div class='flex items-center gap-2'>
                    <!-- Download Icon -->
                    <a href='{{file}}' 
                       download 
                       target='_blank'
                       @click.stop
                       class='p-1.5 rounded-lg bg-slate-100 hover:bg-green-600 text-slate-600 hover:text-white transition-all duration-200'
                       title='{{t "test.material.ppt.downloadPPT"}}'>
                      <svg xmlns='http://www.w3.org/2000/svg' class='h-4 w-4' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
                        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' />
                      </svg>
                    </a>
                  </div>
                </div>
              </button>
            {{/each}}
          </div>
        {{else}}
          <div class='text-center py-8'>
            <svg
              xmlns='http://www.w3.org/2000/svg'
              class='h-12 w-12 text-slate-400 mx-auto mb-3'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
              />
            </svg>
            <p class='text-slate-500 text-sm font-medium'>{{t "test.material.ppt.noMateriAvailable"}}</p>
            <p class='text-slate-400 text-xs mt-1'>{{t "test.material.ppt.spanNoMateriAvailable"}}</p>
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>