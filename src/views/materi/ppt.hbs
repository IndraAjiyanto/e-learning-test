<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>PPT Viewer - Nutrient</title>

  <!-- Nutrient Web SDK CDN -->
  <script src="https://cdn.nutrient.io/nutrient-web-sdk.js"></script>

  <style>
    #viewer {
      width: 100%;
      height: 100vh;
    }
  </style>
</head>
<body>
  <div id="viewer"></div>
</body>
</html>

<script>
  NutrientWebSDK.load({
    container: "#viewer",
    document: "{{materi.[0].file}}", // URL ke file PPT
    licenseKey: "YOUR_LICENSE_KEY"
  }).then(instance => {
    console.log("PPT loaded successfully", instance);
  }).catch(error => {
    console.error(error);
  });
</script>
