{{!-- Dibungkus chrome backoffice. Halaman ini ditautkan dari dalam area
     belajar tetapi punya rute sendiri; sebelumnya memakai navbar publik
     dan footer. Controller-nya merender dengan bareShell: true.
     Lihat docs/user-area-learning-consolidation-plan.md tahap 2. --}}
{{#> user/shell_frame/index user=user active='learning' pageTitle=(t 'test.startLearning.pdfMaterial') back=(concat '/program/' session.weeks.course.id)}}
<div
  class='max-w-7xl mx-auto px-4 py-8'
  {{!-- Berkas yang langsung terbuka: yang ditautkan dari halaman sesi lewat
       ?materialId=, kalau tidak ada ya yang pertama. Sebelumnya penampil ini
       selalu mulai kosong, bahkan ketika hanya ada satu berkas. --}}
  x-data="{ pdfSrc: {{json selected.file}}, materiJudul: {{json selected.title}}, missing: {{#if selectedMissing}}true{{else}}false{{/if}} }"
>

  <div class='mb-8'>
  </div>

  <div class='grid grid-cols-1 lg:grid-cols-3 gap-8'>

    <div class='col-span-2'>
      <div
        class='bg-white border border-[#E5E5E5] rounded-xl shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] overflow-hidden'
      >
        <!-- PDF Viewer ketika sudah dipilih dan berkasnya memang ada -->
        {{!-- template x-if, bukan x-show: dengan x-show elemennya tetap ada di
             DOM dan tetap memuat berkasnya (atau halaman 404-nya) di latar. --}}
        <template x-if='pdfSrc && !missing'>
          <div>
            <iframe
              class='h-[600px] w-full'
              x-bind:src='pdfSrc'
              type='application/pdf'
            ></iframe>
          </div>
        </template>

        {{!--
          Berkas yang diunggah bisa hilang dari disk sementara barisnya masih
          ada di basis data. Tanpa penjagaan ini, permintaannya dijawab halaman
          404 aplikasi dan <iframe> menampilkan halaman 404 itu di dalam kotak
          materi - lengkap dengan navbar dan tombol WhatsApp-nya. Sekarang
          keadaannya disebut apa adanya.
        --}}
        <div
          x-show='pdfSrc && missing'
          style='display:none'
          class='flex h-[600px] items-center justify-center bg-[#FAFAFA] px-6'
        >
          <div class='max-w-md text-center'>
            <span class='mx-auto mb-4 grid size-14 place-items-center rounded-full bg-[#FEF2F2] text-[#B42318]'>
              <i class='fa-solid fa-file-circle-exclamation text-xl'></i>
            </span>
            <h3 class='font-montserrat text-lg font-bold text-[#171717]'>
              {{t 'test.material.unavailableTitle'}}
            </h3>
            <p class='mt-1.5 font-inter text-sm text-[#737373]'>
              {{t 'test.material.unavailableBody'}}
            </p>
          </div>
        </div>

        <!-- Tampilan default ketika belum ada PDF yang dipilih -->
        <div
          x-show='!pdfSrc'
          class='h-[600px] flex items-center justify-center bg-[#FAFAFA]'
        >
          <div class='text-center px-6'>
            <div
              class='p-6 bg-white/50 rounded-full w-24 h-24 mx-auto mb-6 flex items-center justify-center shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]'
            >
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='h-12 w-12 text-[#A3A3A3]'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
                />
              </svg>
            </div>
            <p class='text-[#525252] text-lg font-semibold mb-2'>{{t
                'test.material.pdf.noPDFSelected'
              }}</p>
            <p class='text-[#A3A3A3] text-sm'>{{t
                'test.material.pdf.selectPDFInstruction'
              }}</p>
          </div>
        </div>
      </div>

      <div class='mt-6'>
        <h1
          class='text-2xl font-bold text-[#003060] font-montserrat'
          x-text="materiJudul || '{{t
            "test.material.pdf.selectPDFInstruction"
          }}'"
        ></h1>

      </div>
    </div>

    <div
      class='bg-white border border-[#E5E5E5] rounded-xl shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] overflow-hidden'
    >
      <div class='p-6 bg-[#003060]'>
        <h2
          class='text-xl font-semibold text-white flex items-center font-montserrat'
        >
          <div class='p-2 bg-white/10 rounded-lg mr-3'>
            <svg
              xmlns='http://www.w3.org/2000/svg'
              class='h-5 w-5'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
              />
            </svg>
          </div>
          {{t 'test.material.pdf.materiProgram'}}
        </h2>
      </div>

      <div class='p-6'>
        {{#if materi.length}}
          <div class='space-y-3'>
            {{#each materi}}
              <div
                class='w-full text-left px-4 py-4 rounded-lg border border-[#E5E5E5] hover:border-[#D4D4D4] bg-white hover:bg-[#FAFAFA] transition-all duration-200 shadow-sm group cursor-pointer'
                @click="pdfSrc = {{json file}}; materiJudul = {{json title}}; missing = {{#if missing}}true{{else}}false{{/if}}"
              >
                <div class='flex items-center justify-between'>
                  <div class='flex items-center flex-1'>
                    <span
                      class='font-medium text-[#171717] group-hover:text-[#404040] transition-colors duration-200'
                    >{{title}}</span>
                  </div>
                  <!-- Download Icon -->
                  <button
                    @click.stop="downloadPDF('{{file}}', '{{title}}.pdf')"
                    class='p-1.5 rounded-lg bg-slate-100 hover:bg-green-600 text-[#525252] hover:text-white transition-all duration-200'
                    title='{{t "test.material.pdf.downloadPDF"}}'
                  >
                    <svg
                      xmlns='http://www.w3.org/2000/svg'
                      class='h-4 w-4'
                      fill='none'
                      viewBox='0 0 24 24'
                      stroke='currentColor'
                    >
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='2'
                        d='M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
                      />
                    </svg>
                  </button>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <div class='text-center py-8'>
            <div
              class='p-4 bg-slate-100 rounded-full w-16 h-16 mx-auto mb-4 flex items-center justify-center'
            >
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='h-8 w-8 text-[#A3A3A3]'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
                />
              </svg>
            </div>
            <p class='text-[#737373] text-sm font-medium'>{{t
                'test.material.pdf.noMateriAvailable'
              }}</p>
            <p class='text-[#A3A3A3] text-xs mt-1'>{{t
                'test.material.pdf.spanNoMateriAvailable'
              }}</p>
          </div>
        {{/if}}
      </div>
    </div>

  </div>
</div>

<script>
  function downloadPDF(url, filename) {
    fetch(url)
      .then((response) => response.blob())
      .then((blob) => {
        const objectUrl = URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = objectUrl;
        link.download = filename || "download.pdf";

        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        URL.revokeObjectURL(objectUrl);
      })
      .catch((error) => {
        console.error("Download failed:", error);

        // fallback: open file in new tab
        window.open(url, "_blank");
      });
  }
</script>
{{/user/shell_frame/index}}
