{{!-- Dibungkus chrome backoffice. Halaman ini ditautkan dari dalam area
     belajar tetapi punya rute sendiri; sebelumnya memakai navbar publik
     dan footer. Controller-nya merender dengan bareShell: true.
     Lihat docs/user-area-learning-consolidation-plan.md tahap 2. --}}
{{#> user/shell_frame/index user=user active='learning' pageTitle=(t 'test.startLearning.videoLeassons') back=false
    trail=(array
      (obj 'label' (t 'test.common.home') 'href' '/users/profile?tab=dashboard')
      (obj 'label' (t 'test.userSidebar.myLearning') 'href' '/users/profile?tab=learning')
      (obj 'label' (t 'test.startLearning.startLearning') 'href' (concat '/program/' session.weeks.course.id))
      (obj 'label' (t 'test.startLearning.videoLeassons')))
}}
<div
  class="w-full max-w-[1540px] mx-auto flex flex-col items-start px-4 sm:px-8 lg:px-[50px] pt-6 sm:pt-8 lg:pt-[50px] pb-12 lg:pb-[80px] gap-6 lg:gap-[38px] font-inter"
  x-data="{
    videoSrc: {{json selected.file}},
    videoTitle: {{json selected.title}},
    missing: {{#if selectedMissing}}true{{else}}false{{/if}},
    selectedId: {{#if selected.id}}{{json selected.id}}{{else}}null{{/if}}
  }"
>

  <!-- Page Header: Only material title -->
  <div class="w-full flex flex-col items-start">
    <h1
      class="font-inter font-bold text-2xl sm:text-[34px] leading-tight sm:leading-[42px] text-[#003060]"
      x-text="videoTitle || '{{t "test.startLearning.videoLeassons"}}'"
    >
      {{#if selected.title}}{{selected.title}}{{else}}{{t 'test.startLearning.videoLeassons'}}{{/if}}
    </h1>
  </div>

  <!-- My Learning page / Learning workspace card -->
  <div class="w-full bg-white rounded-[22px] p-4 sm:p-6 lg:p-[20px_24px_28px] flex flex-col items-start gap-[18px] shadow-[0px_12px_32px_rgba(15,23,42,0.04)] border border-[#E2E8F0]">
    
    <!-- workspace: 2 columns (video on left, materials sidebar on right) -->
    <div class="w-full flex flex-col lg:flex-row items-start gap-6">

      <!-- Left Column: Video Player -->
      <div class="flex-1 w-full min-w-0 flex flex-col items-start gap-6">

        <!-- Video Player Container (video-player in figma) -->
        <div class="w-full min-h-[460px] sm:min-h-[540px] lg:min-h-[640px] bg-[#0F172A] rounded-[24px] overflow-hidden flex flex-col justify-center items-center relative shadow-inner">
          
          <!-- Active Video Player -->
          <template x-if="videoSrc && !missing">
            <div class="w-full h-[520px] sm:h-[600px] lg:h-[680px] bg-[#0F172A] rounded-[24px] overflow-hidden">
              <template x-if="videoSrc.includes('youtube.com') || videoSrc.includes('youtu.be')">
                <iframe
                  x-bind:src="videoSrc.includes('youtube.com/watch?v=') 
                    ? videoSrc.replace('watch?v=', 'embed/') 
                    : videoSrc.includes('youtu.be/') 
                      ? videoSrc.replace('youtu.be/', 'youtube.com/embed/') 
                      : videoSrc"
                  class="w-full h-full rounded-[24px] border-none"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </template>
              <template x-if="!videoSrc.includes('youtube.com') && !videoSrc.includes('youtu.be')">
                <video
                  controls
                  class="w-full h-full rounded-[24px] bg-[#0F172A] object-contain"
                  x-bind:src="videoSrc"
                ></video>
              </template>
            </div>
          </template>

          <!-- Video Unavailable State -->
          <div
            x-show="missing"
            style="display:none"
            class="w-full h-[450px] lg:h-[550px] flex items-center justify-center bg-[#0F172A] rounded-[24px] px-6 text-center"
          >
            <div class="max-w-md text-center">
              <span class="mx-auto mb-4 grid size-14 place-items-center rounded-full bg-red-500/10 text-red-400">
                <i class="fa-solid fa-file-circle-exclamation text-2xl"></i>
              </span>
              <h3 class="font-inter text-lg font-bold text-white">
                {{t 'test.material.unavailableTitle'}}
              </h3>
              <p class="mt-1.5 font-inter text-sm text-slate-400">
                {{t 'test.material.unavailableBody'}}
              </p>
            </div>
          </div>

          <!-- Empty state when no video selected (Figma play button) -->
          <div
            x-show="!videoSrc"
            class="w-full h-[450px] lg:h-[550px] flex flex-col items-center justify-center bg-[#0F172A] rounded-[24px] p-6 text-center"
          >
            <div class="flex items-center justify-center w-[88px] h-[88px] rounded-full bg-white/[0.082] border-[1.5px] border-white/[0.188] backdrop-blur-md mb-6">
              <div class="flex items-center justify-center w-12 h-12 rounded-full bg-[#4F46E5] shadow-[0px_4px_12px_rgba(79,70,229,0.102)] text-white">
                <!-- Play triangle vector -->
                <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>
            <p class="font-inter text-white text-lg font-semibold mb-2">
              {{t 'test.material.video.noVideoSelected'}}
            </p>
            <p class="font-inter text-slate-400 text-sm max-w-sm">
              {{t 'test.material.video.selectVideoInstruction'}}
            </p>
          </div>

        </div>

      </div>

      <!-- Right Column: Materials Sidebar -->
      <div class="w-full lg:w-[380px] lg:shrink-0 bg-white border border-[#E2E8F0] shadow-[0px_12px_32px_rgba(15,23,42,0.031)] rounded-[24px] overflow-hidden flex flex-col">
        
        <!-- Sidebar Header -->
        <div class="w-full h-16 bg-[#003060] px-6 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-[10px] bg-white/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h3 class="font-inter font-bold text-[18px] leading-[23px] text-white truncate">
              {{t 'test.material.video.materiProgram'}}
            </h3>
          </div>
          {{#if materi.length}}
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-white/20 text-white">
              {{materi.length}}
            </span>
          {{/if}}
        </div>

        <!-- Sidebar Body -->
        <div class="p-5 sm:p-6 flex flex-col flex-1 gap-6">
          
          <!-- Materials List -->
          <div class="w-full flex flex-col gap-3">
            {{#if materi.length}}
              {{#each materi}}
                <div
                  class="w-full min-h-[60px] p-3.5 rounded-[14px] border transition-all duration-200 flex items-center gap-3 cursor-pointer group"
                  :class="selectedId === '{{id}}' ? 'bg-[#F0FDF4] border-[#86EFAC] shadow-sm ring-1 ring-[#86EFAC]/50' : 'bg-white border-[#E2E8F0] hover:bg-[#F8FAFC] hover:border-[#CBD5E1]'"
                  @click="videoSrc = '{{file}}'; videoTitle = '{{title}}'; missing = {{#if missing}}true{{else}}false{{/if}}; selectedId = '{{id}}'"
                >
                  <!-- Video Icon Box based on index -->
                  {{#if (eq (mod @index 3) 0)}}
                    <div class="w-9 h-9 rounded-[10px] bg-[#EFF6FF] flex items-center justify-center shrink-0">
                      <svg class="w-[18px] h-[18px] text-[#2563EB]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                    </div>
                  {{else if (eq (mod @index 3) 1)}}
                    <div class="w-9 h-9 rounded-[10px] bg-[#FFF1F2] flex items-center justify-center shrink-0">
                      <svg class="w-[18px] h-[18px] text-[#E11D48]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </div>
                  {{else}}
                    <div class="w-9 h-9 rounded-[10px] bg-[#F0FDF4] flex items-center justify-center shrink-0">
                      <svg class="w-[18px] h-[18px] text-[#16A34A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                    </div>
                  {{/if}}

                  <!-- Title Meta -->
                  <div class="flex-1 min-w-0">
                    <span class="block font-inter font-semibold text-[13px] leading-snug text-[#0F172A] truncate group-hover:text-[#003060] transition-colors">
                      {{title}}
                    </span>
                  </div>
                </div>
              {{/each}}
            {{else}}
              <div class="text-center py-8">
                <div class="p-4 bg-slate-100 rounded-full w-16 h-16 mx-auto mb-4 flex items-center justify-center">
                  <svg class="h-8 w-8 text-[#A3A3A3]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                </div>
                <p class="text-[#737373] text-sm font-medium font-inter">
                  {{t 'test.material.video.noMateriAvailable'}}
                </p>
                <p class="text-[#A3A3A3] text-xs mt-1 font-inter">
                  {{t 'test.material.video.spanNoMateriAvailable'}}
                </p>
              </div>
            {{/if}}
          </div>

        </div>

      </div>

    </div>

  </div>

</div>
{{/user/shell_frame/index}}
