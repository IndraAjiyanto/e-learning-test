{{!-- Dibungkus chrome backoffice. Halaman ini ditautkan dari dalam area
     belajar tetapi punya rute sendiri; sebelumnya memakai navbar publik
     dan footer. Controller-nya merender dengan bareShell: true.
     Lihat docs/user-area-learning-consolidation-plan.md tahap 2. --}}
{{#> user/shell_frame/index user=user active='learning' pageTitle=(t 'test.startLearning.videoLeassons') back=false
    trail=(array
          (obj 'label' (t 'test.common.home') 'href' '/users/profile?tab=dashboard')
          (obj 'label' (t 'test.userSidebar.myLearning') 'href' '/users/profile?tab=learning')
          (obj 'label' (t 'test.startLearning.startLearning') 'href' (concat '/program/' session.weeks.course.id))
          (obj 'label' (t 'test.startLearning.videoLeassons')))}}
<div
  class='max-w-7xl mx-auto px-4 py-8'
  {{!-- Berkas yang langsung terbuka: yang ditautkan dari halaman sesi lewat
       ?materialId=, kalau tidak ada ya yang pertama. Sebelumnya penampil ini
       selalu mulai kosong, bahkan ketika hanya ada satu berkas. --}}
  x-data="{ videoSrc: {{json selected.file}}, videoTitle: {{json selected.title}}, missing: {{#if selectedMissing}}true{{else}}false{{/if}} }"
>

  <div class='mb-8'>
  </div>

  <div class='grid grid-cols-1 lg:grid-cols-3 gap-10'>

    <div class='col-span-2'>
      <div
        class='bg-white border border-[#E5E5E5] rounded-xl shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] overflow-hidden'
      >
        <!-- Video Player ketika sudah dipilih -->
        <template x-if='videoSrc && !missing'>
          <div>
          <template
            x-if="videoSrc.includes('youtube.com') || videoSrc.includes('youtu.be')"
          >
            <iframe
              x-bind:src="videoSrc.includes('youtube.com/watch?v=') 
                ? videoSrc.replace('watch?v=', 'embed/') 
                : videoSrc.includes('youtu.be/') 
                  ? videoSrc.replace('youtu.be/', 'youtube.com/embed/') 
                  : videoSrc"
              class='w-full h-[450px]'
              frameborder='0'
              allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
              allowfullscreen
            ></iframe>
          </template>
          <template
            x-if="!videoSrc.includes('youtube.com') && !videoSrc.includes('youtu.be')"
          >
            <video
              controls
              class='w-full h-[450px] bg-[#FAFAFA]'
              x-bind:src='videoSrc'
            ></video>
          </template>
          </div>
        </template>

        {{!-- Berkas unggahan bisa hilang dari disk; tanpa penjagaan ini penampil
             menampilkan halaman 404 aplikasi di dalam kotak materi. --}}
        <div
          x-show='missing'
          style='display:none'
          class='flex h-[600px] items-center justify-center bg-[#FAFAFA] px-6'
        >
          <div class='max-w-md text-center'>
            <span class='mx-auto mb-4 grid size-14 place-items-center rounded-full bg-[#FEF2F2] text-[#B42318]'>
              <i class='fa-solid fa-file-circle-exclamation text-xl'></i>
            </span>
            <h3 class='font-inter text-lg font-bold text-[#171717]'>{{t 'test.material.unavailableTitle'}}</h3>
            <p class='mt-1.5 font-inter text-sm text-[#737373]'>{{t 'test.material.unavailableBody'}}</p>
          </div>
        </div>

        <!-- Tampilan default ketika belum ada video yang dipilih -->
        <div
          x-show='!videoSrc'
          class='h-[450px] flex items-center justify-center bg-[#FAFAFA]'
        >
          <div class='text-center px-6'>
            <div
              class='p-6 bg-white/50 rounded-full w-24 h-24 mx-auto mb-6 flex items-center justify-center shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]'
            >
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='h-12 w-12 text-[#A3A3A3]'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z'
                />
              </svg>
            </div>
            <p class='text-[#525252] text-lg font-semibold mb-2'>{{t
                'test.material.video.noVideoSelected'
              }}</p>
            <p class='text-[#A3A3A3] text-sm'>{{t
                'test.material.video.selectVideoInstruction'
              }}</p>
          </div>
        </div>
      </div>

      <div class='flex justify-between items-center mt-6'>
        <h1
          class='text-2xl font-bold text-[#003060] font-inter'
          x-text="videoTitle || '{{t
            "test.material.video.selectVideoInstruction"
          }}'"
        ></h1>
      </div>
    </div>

    <div
      class='bg-white border border-[#E5E5E5] rounded-xl shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] overflow-hidden'
    >
      <div class='bg-[#003060] px-6 py-4'>
        <h2
          class='text-xl font-semibold text-white flex items-center font-inter'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            class='h-6 w-6 mr-2'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z'
            />
          </svg>
          {{t 'test.material.video.materiProgram'}}
        </h2>
      </div>

      <div class='p-6'>
        {{#if materi.length}}
          <div class='space-y-3'>
            {{#each materi}}
              <button
                class='w-full text-left px-4 py-3 rounded-xl border border-[#E5E5E5] bg-white hover:bg-[#FAFAFA] hover:border-[#D4D4D4] transition-all duration-200 group'
                @click="videoSrc = '{{file}}'; videoTitle = '{{title}}'"
              >
                <div class='flex items-center'>
                  <span
                    class='font-medium text-slate-800 group-hover:text-[#171717]'
                  >{{title}}</span>
                </div>
              </button>
            {{/each}}
          </div>
        {{else}}
          <div class='text-center py-8'>
            <svg
              xmlns='http://www.w3.org/2000/svg'
              class='h-12 w-12 text-[#A3A3A3] mx-auto mb-3'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z'
              />
            </svg>
            <p class='text-[#737373] text-sm font-medium'>{{t
                'test.material.video.noMateriAvailable'
              }}</p>
            <p class='text-[#A3A3A3] text-xs mt-1'>{{t
                'test.material.video.spanNoMateriAvailable'
              }}</p>
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>
{{/user/shell_frame/index}}
