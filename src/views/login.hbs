{{!--
  Halaman: Login
  Lokasi: src/views/login.hbs
  Menggunakan komponen global form auth (src/views/partials/components/ui/auth/index.hbs)
--}}

{{> components/ui/auth/index
  variant="login"
  action="/login"
  method="post"
  success=success
  error=error
  title=(t 'test.login.title')
  description=(t 'test.login.description')
  emailLabel=(t 'test.login.email')
  emailPlaceholder=(t 'test.login.placeholderEmail')
  passwordLabel=(t 'test.login.password')
  showForgotPassword=true
  forgotPasswordText=(t 'test.login.forgotPassword')
  forgotPasswordUrl="/users/forgot-password"
  submitText=(t 'test.login.loginButton')
  bottomTitle=(t 'test.login.noAccount')
  bottomLinkText=(t 'test.login.signUp')
  bottomLinkUrl="/register"
}}
