{{!--
  Halaman: Forgot Password
  Lokasi: src/views/forgot-password.hbs
  Menggunakan komponen global auth (src/views/partials/components/ui/auth/index.hbs)
--}}

{{#if remainingMs}}
  {{!-- Tampilan dengan Countdown --}}
  {{> components/ui/auth/index
    variant="forgot-password"
    title=(t 'test.forgotPassword.title')
    description=(t 'test.forgotPassword.description')
    success=success
    error=error
    showCountdown=true
    remainingMs=remainingMs
    countdownDayText=(t 'test.forgotPassword.day')
    countdownHourText=(t 'test.forgotPassword.hour')
    countdownMinuteText=(t 'test.forgotPassword.minute')
    countdownSecondText=(t 'test.forgotPassword.second')
    bottomTitle=(t 'test.forgotPassword.rememberPassword')
    bottomLinkText=(t 'test.forgotPassword.backToLogin')
    bottomLinkUrl="/login"
    showHelpSection=true
    helpTitle=(t 'test.forgotPassword.tittleHelp')
    helpDescription=(t 'test.forgotPassword.Help')
  }}
{{else}}
  {{!-- Tampilan dengan Form --}}
  {{> components/ui/auth/index
    variant="forgot-password"
    action="/users/forgot-password"
    method="post"
    title=(t 'test.forgotPassword.title')
    description=(t 'test.forgotPassword.description')
    success=success
    error=error
    emailLabel=(t 'test.forgotPassword.email')
    emailPlaceholder=(t 'test.forgotPassword.placeholderEmail')
    emailHelp=(t 'test.forgotPassword.emailHelp')
    submitText=(t 'test.forgotPassword.sendButton')
    bottomTitle=(t 'test.forgotPassword.rememberPassword')
    bottomLinkText=(t 'test.forgotPassword.backToLogin')
    bottomLinkUrl="/login"
    showHelpSection=true
    helpTitle=(t 'test.forgotPassword.tittleHelp')
    helpDescription=(t 'test.forgotPassword.Help')
  }}
{{/if}}