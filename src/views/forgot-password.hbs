<div
  class='min-h-screen flex items-center justify-center bg-gradient-to-br from-primary via-secondary to-gray-800 px-4 pt-28 py-20'
>
  <div class='w-full max-w-4xl flex items-center justify-center'>
    <div
      class="w-full max-w-lg mx-auto 
            bg-white/5 backdrop-blur-xl border border-white/20 shadow-2xl rounded-3xl
            p-8 "
    >

      <!-- Logo -->
      <div class='flex items-center justify-center mb-6'>
        <img src='/public/image/logo.png' alt='Logo' class='h-16 w-auto' />
      </div>

      <!-- Title -->
      <div class='text-center mb-6'>
        <h1
          class='text-2xl whitespace-nowrap font-bold text-white mt-2 font-montserrat'
        >{{t 'test.forgotPassword.tittle'}}</h1>
        <p class='text-gray-400 text-sm mt-2 font-inter'>
          {{t 'test.forgotPassword.description'}}
        </p>
      </div>

      <!-- Success Alert -->
      {{#if success}}
        <div
          role='alert'
          class='mb-6 p-4 rounded-xl bg-green-900/30 border border-green-500/40 backdrop-blur-sm'
        >
          <div class='flex items-start gap-3'>
            <div class='flex-shrink-0 mt-0.5'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5 text-green-400'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
                />
              </svg>
            </div>
            <div class='flex-1'>
              <p class='text-sm font-medium text-green-200'>{{success}}</p>
            </div>
            <button
              type='button'
              onclick="this.parentElement.parentElement.style.display='none'"
              class='flex-shrink-0 text-green-400 hover:text-green-300 transition-colors'
            >
              <svg
                class='h-4 w-4'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M6 18L18 6M6 6l12 12'
                />
              </svg>
            </button>
          </div>
        </div>
      {{/if}}

      <!-- Error Alert -->
      {{#if error}}
        <div
          role='alert'
          class='mb-6 p-4 rounded-xl bg-red-900/30 border border-red-500/40 backdrop-blur-sm'
        >
          <div class='flex items-start gap-3'>
            <div class='flex-shrink-0 mt-0.5'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5 text-red-400'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                />
              </svg>
            </div>
            <div class='flex-1'>
              <p class='text-sm font-medium text-red-200'>{{error}}</p>
            </div>
            <button
              type='button'
              onclick="this.parentElement.parentElement.style.display='none'"
              class='flex-shrink-0 text-red-400 hover:text-red-300 transition-colors'
            >
              <svg
                class='h-4 w-4'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M6 18L18 6M6 6l12 12'
                />
              </svg>
            </button>
          </div>
        </div>
      {{/if}}

      {{#if remainingMs}}

            <div id="countdown"></div>
       <script src="https://cdn.jsdelivr.net/npm/simplycountdown.js"></script>

<script>
  let remainingTime = {{remainingMs}};
  const el = document.getElementById("countdown");

  setInterval(() => {
    if (remainingTime <= 0) location.reload();

    let m = Math.floor(remainingTime / 60000);
    let s = Math.floor((remainingTime % 60000) / 1000);

    el.innerHTML = m + " menit " + s + " detik";

    remainingTime -= 1000;
  }, 1000);
</script>

      {{else}}

 

      <!-- Forgot Password Form -->
      <form action='/users/forgot-password' method='post' class='space-y-6'>

        <!-- Email -->
        <div>
          <label class='block text-gray-200 mb-2 font-medium'>
            <i class='fas fa-envelope mr-2'></i>{{t 'test.forgotPassword.email'}}
          </label>
          <input
            type='email'
            name='email'
            placeholder='{{t "test.forgotPassword.placeholderEmail"}}'
            required
            class='w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white transition-all duration-300'
          />
          <p class='text-xs text-gray-400 mt-2'>
            {{t 'test.forgotPassword.emailHelp'}}
          </p>
        </div>

        <!-- Submit Button -->
        <button
          type='submit'
          class='w-full py-3 rounded-lg bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white font-semibold transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-xl'
        >
          {{t 'test.forgotPassword.sendButton'}}
        </button>
      </form>

           {{/if}}

      <!-- Back to Login Link -->
      <div class='text-center mt-6'>
        <p class='text-sm text-gray-400'>
          {{t 'test.forgotPassword.rememberPassword'}}
          <a
            href='/login'
            class='text-indigo-400 hover:text-indigo-300 font-medium transition-colors'
          >
            {{t 'test.forgotPassword.backToLogin'}}
          </a>
        </p>
      </div>

      <!-- Help Section -->
      <div class='mt-8 p-4 rounded-xl bg-blue-900/20 border border-blue-500/30'>
        <div class='flex items-start gap-3'>
          <i class='fas fa-info-circle text-blue-400 text-lg mt-0.5'></i>
          <div>
            <p class='text-sm text-blue-200 font-medium mb-1'>{{t 'test.forgotPassword.tittleHelp'}}</p>
            <p class='text-xs text-blue-300/80 leading-relaxed'>
              {{t 'test.forgotPassword.Help'}}
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>