<div
  class='min-h-screen flex items-center justify-center bg-[linear-gradient(180deg,_#FAFAFA_-33%,_#CEE5F6_33%,_#FAFAFA_93.51%)] px-4 pt-28 py-20'
>
  <div class='w-full max-w-4xl flex items-center justify-center'>
    <div
      class='w-full max-w-2xl mx-auto bg-white backdrop-blur-xl border border-white/20 shadow-2xl rounded-3xl p-8'
    >

      <!-- Logo -->
      <div class='flex justify-center -mt-32'>
        <img src='/public/image/logo_baru.png' alt='Logo' class='max-h-96 w-auto object-contain  ' />
      </div>

      <!-- Title -->
      <div class='text-center -mt-32 mb-6'>
        <h1
          class='text-[36px] whitespace-nowrap font-semibold text-gray-900 mt-2 font-montserrat'
        >{{t 'test.forgotPassword.title'}}</h1>
        <p class='text-gray-900 text-[20px] mt-2'>
          {{t 'test.forgotPassword.description'}}
        </p>
      </div>

      <!-- Success Alert -->
      {{#if success}}
        <div
          role='alert'
          class='mb-6 p-4 rounded-xl bg-green-900/30 border border-green-500/40 backdrop-blur-sm'
        >
          <div class='flex items-start gap-3'>
            <div class='flex-shrink-0 mt-0.5'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5 text-green-400'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
                />
              </svg>
            </div>
            <div class='flex-1'>
              <p class='text-sm font-medium text-green-200'>{{success}}</p>
            </div>
            <button
              type='button'
              onclick="this.parentElement.parentElement.style.display='none'"
              class='flex-shrink-0 text-green-400 hover:text-green-300 transition-colors'
            >
              <svg
                class='h-4 w-4'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M6 18L18 6M6 6l12 12'
                />
              </svg>
            </button>
          </div>
        </div>
      {{/if}}

      <!-- Error Alert -->
      {{#if error}}
        <div
          role='alert'
          class='mb-6 p-4 rounded-xl bg-red-900/30 border border-red-500/40 backdrop-blur-sm'
        >
          <div class='flex items-start gap-3'>
            <div class='flex-shrink-0 mt-0.5'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5 text-red-400'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                />
              </svg>
            </div>
            <div class='flex-1'>
              <p class='text-sm font-medium text-red-200'>{{error}}</p>
            </div>
            <button
              type='button'
              onclick="this.parentElement.parentElement.style.display='none'"
              class='flex-shrink-0 text-red-400 hover:text-red-300 transition-colors'
            >
              <svg
                class='h-4 w-4'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M6 18L18 6M6 6l12 12'
                />
              </svg>
            </button>
          </div>
        </div>
      {{/if}}

      {{#if remainingMs}}

        <div class='my-countdown simply-countdown'></div>

        <script>
          const remainingMs =
          {{remainingMs}}; const target = new Date(Date.now() + remainingMs);
          simplyCountdown('.my-countdown', { year: target.getFullYear(), month:
          target.getMonth() + 1, day: target.getDate(), hours:
          target.getHours(), minutes: target.getMinutes(), seconds:
          target.getSeconds(), words: { days: { root: `{{t
            'test.forgotPassword.day'
          }}`, lambda: (root, n) => root }, hours: { root: `{{t
            'test.forgotPassword.hour'
          }}`, lambda: (root, n) => root }, minutes: { root: `{{t
            'test.forgotPassword.minute'
          }}`, lambda: (root, n) => root }, seconds: { root: `{{t
            'test.forgotPassword.second'
          }}`, lambda: (root, n) => root } }, onEnd: () => location.reload() });
        </script>

      {{else}}

        <!-- Forgot Password Form -->
        <form
          action='/users/forgot-password'
          method='post'
          class='space-y-6'
          x-data='{ loading: false }'
          @submit='loading = true'
        >

          <!-- Email -->
          <div>
            <label class='block text-gray-900 mb-2 text-[20px]'>
             {{t 'test.forgotPassword.email'}}
            </label>
            <input
              type='email'
              name='email'
              placeholder='{{t "test.forgotPassword.placeholderEmail"}}'
              required
              class='w-full px-4 py-3 rounded-lg bg-white border border-gray-300 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white transition-all duration-300'
            />
            <p class='text-[15px] text-gray-900 mt-2'>
              {{t 'test.forgotPassword.emailHelp'}}
            </p>
          </div>

          <!-- Submit Button -->
          <button
            :disabled='loading'
            type='submit'
            class='w-full py-3 rounded-lg bg-[#003060] text-[20px] text-white font-semibold transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-xl'
          >
            <span
              x-show='loading'
              class='loading loading-spinner loading-sm'
            ></span>
            <span x-show='!loading'>{{t
                'test.forgotPassword.sendButton'
              }}</span>
          </button>
        </form>

      {{/if}}

      <!-- Back to Login Link -->
      <div class='text-center mt-6'>
        <p class='text-[20px] text-gray-900'>
          {{t 'test.forgotPassword.rememberPassword'}}
          <a
            href='/login'
            class='text-[#012FA6] hover:text-indigo-300 font-medium transition-colors underline'
          >
            {{t 'test.forgotPassword.backToLogin'}}
          </a>
        </p>
      </div>

      <!-- Help Section -->
      <div class='mt-8 p-4 rounded-xl bg-[#6EB6E580]/50 '>
        <div class='flex items-start gap-3'>
          <div class="flex-shrink-0">
            <svg width="30" height="30" viewBox="0 0 154 154" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Tas -->
  <path
    d="M27 78V105C27 123 33 136 51 137H103C121 136 127 123 127 105V78"
    stroke="#0B2442"
    stroke-width="7"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- Bagian atas tas -->
  <path
    d="M24 85V63C24 52 29 48 40 48H114C125 48 130 52 130 63V83C130 87 128 89 124 90L81 105C78 106 76 106 73 105L30 90C26 89 24 87 24 85Z"
    stroke="#0B2442"
    stroke-width="7"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- Pegangan -->
  <path
    d="M55 47L59 37C60 34 63 31 67 31H87C91 31 94 34 95 37L99 47"
    stroke="#0B2442"
    stroke-width="7"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- Pengunci depan -->
  <path
    d="M63 87H91V99C91 103 87 106 77 107C67 106 63 103 63 99V87Z"
    fill="#0B2442"
    stroke="#0B2442"
    stroke-width="7"
    stroke-linejoin="round"
  />

  <!-- Bagian tengah pengunci -->
  <path
    d="M64 87H90V97C90 100 87 102 77 103C67 102 64 100 64 97V87Z"
    fill="#A8D0E8"
  />
</svg>
          </div>
          <div>
            <p class='text-[20px] text-gray-900 font-medium mb-1'>{{t
                'test.forgotPassword.tittleHelp'
              }}</p>
            <p class='text-[15px] text-gray-900 leading-relaxed'>
              {{t 'test.forgotPassword.Help'}}
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>


</div>