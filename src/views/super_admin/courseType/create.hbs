<div
  class='py-10'
  x-data="{
  // Form validation states
  formData: {
    name_clasess_type: '',
    description: { id: '', en: '', ja: '' },
    icon: ''
  },
  formErrors: {
    name_clasess_type: '',
    description: { id: '', en: '', ja: '' },
    icon: ''
  },
  formValid: {
    name_clasess_type: false,
    description: { id: false, en: false, ja: false },
    icon: true
  },
  formTouched: {
    name_clasess_type: false,
    description: { id: false, en: false, ja: false },
    icon: false
  },

  get computedClass() {
    const raw = (this.formData.icon || '').toString().trim();
    if (!raw) return 'fa-solid fa-circle-question';
    const v = raw;
    const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(v) || v.split(/\s+/).some(s => /^fa-/i.test(s));
    if (hasFaPrefix) {
      if (/^fa-\w+/i.test(v) && !/\s+/.test(v)) return 'fa-solid ' + v;
      return v;
    }
    if (!v.includes(' ')) return 'fa-solid fa-' + v;
    return v;
  },

  validateField(field, value, lang = null) {
    if (lang) {
      this.formData[field][lang] = value;
      this.formTouched[field][lang] = true;
    } else {
      this.formData[field] = value;
      this.formTouched[field] = true;
    }
    
    switch(field) {
      case 'name_clasess_type':
        if (!value.trim()) {
          this.formErrors.name_clasess_type = 'Class type name is required';
          this.formValid.name_clasess_type = false;
        } else if (value.trim().length < 2) {
          this.formErrors.name_clasess_type = 'Class type name must be at least 2 characters';
          this.formValid.name_clasess_type = false;
        } else {
          this.formErrors.name_clasess_type = '';
          this.formValid.name_clasess_type = true;
        }
        break;
        
      case 'description':
        if (!value.trim()) {
          this.formErrors.description[lang] = 'Description is required';
          this.formValid.description[lang] = false;
        } else if (value.trim().length < 10) {
          this.formErrors.description[lang] = 'Description must be at least 10 characters';
          this.formValid.description[lang] = false;
        } else {
          this.formErrors.description[lang] = '';
          this.formValid.description[lang] = true;
        }
        break;
        
      case 'icon':
        // Icon is optional, no validation required
        this.formErrors.icon = '';
        this.formValid.icon = true;
        break;
    }
  },

  canSubmit() {
    const deskripsiValid = Object.values(this.formValid.description).every(v => v);
    return this.formValid.name_clasess_type && deskripsiValid && this.formValid.icon;
  },

  hasFormErrors() {
    return this.formErrors.name_clasess_type !== '' ||
           Object.values(this.formErrors.description).some(e => e !== '') ||
           this.formErrors.icon !== '';
  }
}"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create New Program
      Type</h2>

    <form
      action='/type-program'
      method='post'
      class='space-y-6'
      x-data='{ loading: false }'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; } loading = true;'
    >

    {{> super_admin/type_program/create/name_input }}
    {{> super_admin/type_program/create/icon_input }}
    {{> super_admin/type_program/create/description_input }}

      <!-- Action Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span
            x-show='loading'
            class='loading loading-spinner loading-sm'
          ></span>
          <span x-show='!loading'>Create</span>
        </button>
        <a
          href='/type-program'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>

<!-- (Using inline x-data above for icon preview) -->

<!-- Include Alpine.js (deferred). If the project already includes Alpine, this is harmless. -->
<script src='https://unpkg.com/alpinejs@3.12.0/dist/cdn.min.js' defer></script>

