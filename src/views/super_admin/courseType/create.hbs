{{!--
  Halaman: Create Program Type — Super Admin
  Lokasi: src/views/super_admin/courseType/create.hbs
  Level: L4 Page

  Route: GET /type-program/formCreate -> POST /type-program (urlencoded).

  Field dikirim sebagai nameClassesType, icon, description[id|en|ja] — express
  urlencoded extended merakitnya jadi objek sesuai kolom jsonb entity.

  Toast sukses tidak dirender di sini: submit redirect ke /type-program, jadi
  notifikasinya muncul di index.hbs lewat flash `toast`.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Program Type'
      }}

      {{> components/ui/super_admin/description/index
        text='Define a new program type used to classify programs across Kesatria Academy.'
      }}
    </div>

    <form
      action='/type-program'
      method='post'
      novalidate
      x-data='programTypeForm()'
      @submit.prevent='submitForm($event)'
      class='flex flex-col gap-3.5'
    >
      {{> components/ui/super_admin/form/program_type/fields }}

      <div class='flex flex-col-reverse gap-3 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:flex-row sm:justify-end sm:p-5'>
        {{> components/ui/super_admin/form/button
          as='link'
          variant='secondary'
          href='/type-program'
          label='Cancel'
          loading=true
        }}

        {{> components/ui/super_admin/form/button
          type='submit'
          variant='primary'
          label='Create Program Type'
          loading=true
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/program_type/form }}
