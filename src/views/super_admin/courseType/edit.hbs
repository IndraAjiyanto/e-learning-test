{{!--
  Halaman: Edit Program Type — Super Admin
  Lokasi: src/views/super_admin/courseType/edit.hbs
  Level: L4 Page

  Route: GET /type-program/formEdit/:courseTypeId -> PATCH /type-program/:courseTypeId
  (urlencoded + _method override). Data: { courseType }.

  Beda dari create.hbs: field terisi nilai existing.

  TIDAK ADA TOMBOL HAPUS DI SINI — sesuai Figma, halaman edit hanya menyimpan
  perubahan. Menghapus dilakukan lewat aksi baris di halaman daftar.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Program Type'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the program type information used across Kesatria Academy.'
      }}
    </div>

    <div class='flex flex-col gap-4'>
      {{!-- Nilai awal lewat helper json, bukan template literal: backtick atau
           ${ di data tidak lagi memecah skrip. --}}
      <form
        action='/type-program/{{courseType.id}}?_method=PATCH'
        method='post'
        novalidate
        x-data='{ ...programTypeForm({ icon: {{json courseType.icon}}, nameClassesType: {{json courseType.nameClassesType}}, description: {{json courseType.description}} }), ...formDirtyGate() }'
        x-init='$nextTick(() => captureBaseline())'
        @input='recomputeDirty()'
        @change='recomputeDirty()'
        @submit.prevent='submitForm($event)'
      >
        {{#> components/ui/super_admin/form/program_type/fields }}
          <div class='flex flex-col-reverse gap-3 sm:flex-row sm:justify-end'>
            {{> components/ui/super_admin/form/button
              as='link'
              variant='secondary'
              href='/type-program'
              label='Cancel'
              loading=true
            }}

            {{> components/ui/super_admin/form/button
              type='submit'
              variant='primary'
              label='Save Changes'
              loading=true
              disabled='!canSubmit() || !isDirty || loading'
            }}
          </div>
        {{/components/ui/super_admin/form/program_type/fields}}
      </form>

      {{!-- Danger Zone — bentuk dan jaraknya mengikuti super_admin/user/edit.hbs. --}}
      {{> components/ui/super_admin/danger_zone/index
        title='Delete Program Type'
        description='Permanently remove this program type. Programs already using it will lose their type. This action cannot be undone.'
        action=(concat '/type-program/' courseType.id '?_method=DELETE')
      }}

    </div>
  </div>
</div>

{{!-- Konfirmasi delete — komponen yang sama dengan halaman daftar. Tombol Danger
     Zone memakai onclick='openDeleteModal(this)'; fungsi itu didefinisikan oleh
     komponen modal ini. --}}
{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Program Type?'
  description='Are you sure you want to delete this program type? Programs already using it will lose their type. This action cannot be undone.'
}}

{{> components/ui/super_admin/form/program_type/form }}
