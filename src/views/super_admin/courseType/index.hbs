{{!--
  Halaman: Program Type — Super Admin
  Lokasi: src/views/super_admin/courseType/index.hbs
  Level: L4 Page

  - Sidebar sudah disediakan oleh layouts/main.hbs (offset lg:ml-[319px])

  Data: GET /type-program/filter → { data, totalItems, totalPages, currentPage }
  Memakai pola server-side seperti /users (bukan clientTable), karena jumlah
  program type ikut tumbuh bersama katalog program.

  Field entity CourseType: `nameClassesType` (string biasa), `icon` (nama kelas
  FontAwesome), `description` (jsonb { id, en, ja }).

  `lang` hidup di scope Alpine bersarang, mengikuti halaman Benefit/FAQ.
--}}
<div
  class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'
  x-data='programTypeTable()'
  x-init='fetchProgramTypes()'
>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Program Type'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage the program types that classify every program in Kesatria Academy.'
      }}
    </div>

    <div class='flex flex-col gap-3.5'>
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search program type..'
        searchLabel='Search program type'
        createHref='/type-program/formCreate'
        createLabel='Create Program Type'
      }}

      <div
        class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
        x-data="{ lang: 'id' }"
      >
        <div class='flex flex-col gap-5'>

          {{> components/ui/super_admin/tabs/language/index ariaLabel='Program type language' }}

          {{#> components/ui/super_admin/table/card tableClass='min-w-[1000px]'}}
            <colgroup>
              <col class='w-[66px]' />
              <col class='w-[297px]' />
              <col class='w-[90px]' />
              <col class='w-[431px]' />
              <col class='w-[116px]' />
            </colgroup>
            <thead>
              <tr>
                {{> components/ui/super_admin/table/header_cell label='No' }}
                {{> components/ui/super_admin/table/header_cell label='Program Type' }}
                {{> components/ui/super_admin/table/header_cell label='Icon' }}
                {{> components/ui/super_admin/table/header_cell label='Description' }}
                {{> components/ui/super_admin/table/header_cell label='Action' }}
              </tr>
            </thead>
            <tbody>
              {{#> components/ui/super_admin/table/message_row show='loading' colspan='5'}}
                <i class='fas fa-spinner fa-spin text-xl'></i>
              {{/components/ui/super_admin/table/message_row}}

              <template x-for='(row, index) in (loading ? [] : items)' :key='row.id'>
                <tr class='transition-colors hover:bg-[#fafafa]'>

                  {{> components/ui/super_admin/table/cell
                    text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
                  }}

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='block truncate font-inter text-sm leading-5 text-[#525252]'
                      x-text="row.nameClassesType || '—'"
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{!-- Ikon dirender dari nama kelas FontAwesome yang disimpan di kolom
                       `icon`; nama mentahnya ikut jadi tooltip supaya super admin tetap
                       bisa memverifikasi nilai yang tersimpan tanpa kolom terpisah. --}}
                  {{#> components/ui/super_admin/table/cell}}
                    <i
                      class='flex h-5 w-5 items-center justify-center text-base text-[#525252]'
                      :class='programTypeIcon(row.icon)'
                      :title='row.icon'
                      aria-hidden='true'
                    ></i>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='block truncate font-inter text-sm leading-5 text-[#525252]'
                      x-text="(row.description && row.description[lang]) || '—'"
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell variant='action'}}
                    {{> components/ui/super_admin/table/row_actions
                      entity='program type'
                      editHref="'/type-program/formEdit/' + row.id"
                      deleteAction="'/type-program/' + row.id + '?_method=DELETE'"
                    }}
                  {{/components/ui/super_admin/table/cell}}
                </tr>
              </template>

              {{#> components/ui/super_admin/table/message_row show='!loading && items.length === 0' colspan='5'}}
                No program types found.
              {{/components/ui/super_admin/table/message_row}}
            </tbody>
          {{/components/ui/super_admin/table/card}}
        </div>
      </div>
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Program Type?'
  description='Are you sure you want to delete this program type? Programs already using it will lose their type. This action cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

<script>
  // Sejajar dengan benefitIcon() di halaman Benefit: helper `computeIcon` berjalan
  // di server dan tidak bisa dipanggil dari dalam x-for.
  function programTypeIcon(value) {
    const icon = String(value || '').trim();
    if (!icon) return 'fa-solid fa-circle-question';
    const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(icon)
      || icon.split(/\s+/).some((part) => /^fa-/i.test(part));
    if (hasFaPrefix) return /^fa-\w+/i.test(icon) && !/\s/.test(icon) ? 'fa-solid ' + icon : icon;
    return icon.includes(' ') ? icon : 'fa-solid fa-' + icon;
  }

  function programTypeTable() {
    return {
      items: [],
      searchInput: '',
      currentPage: 1,
      totalPages: 1,
      totalItems: 0,
      size: 10,
      loading: false,
      searchTimeout: null,

      async fetchProgramTypes() {
        this.loading = true;
        try {
          const params = new URLSearchParams();
          if (this.searchInput.trim()) params.set('search', this.searchInput.trim());
          params.set('page', this.currentPage);
          params.set('limit', this.size);

          const res = await fetch(`/type-program/filter?${params.toString()}`);
          const json = await res.json();

          this.items = json.data;
          this.totalItems = json.totalItems;
          this.totalPages = json.totalPages;
          this.currentPage = json.currentPage;
        } catch (err) {
          console.error('Fetch program types error:', err);
        } finally {
          this.loading = false;
        }
      },

      handleSearch() {
        clearTimeout(this.searchTimeout);
        this.searchTimeout = setTimeout(() => {
          this.currentPage = 1;
          this.fetchProgramTypes();
        }, 300);
      },

      async changePage(page) {
        if (page < 1 || page > this.totalPages) return;
        this.currentPage = page;
        await this.fetchProgramTypes();
      },
    }
  }
</script>
