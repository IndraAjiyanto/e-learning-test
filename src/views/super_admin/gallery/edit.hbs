<div class='max-w-2xl mx-auto px-6 py-10'>

  <h2 class='text-3xl font-bold text-gray-900 mb-8'>{{gallery.title}}</h2>

  <form
    id='gallery-form'
    action='/gallery/{{gallery.id}}?_method=PATCH'
    method='POST'
    enctype='multipart/form-data'
    class='space-y-6'
  >

    <div>
      <label class='block text-sm text-gray-900 font-medium mb-2'>Image</label>
      <label
        for='gambar-input'
        class='relative flex items-center justify-center border-2 border-dashed border-gray-300 rounded-xl aspect-[16/9] cursor-pointer overflow-hidden hover:border-gray-500 transition bg-white'
      >
        <img
          id='preview-img'
          src='{{gallery.file_path}}'
          class='absolute inset-0 w-full h-full object-cover'
          alt='Preview'
        />
        <div
          class='absolute inset-0 bg-black/0 hover:bg-black/40 transition flex items-center justify-center opacity-0 hover:opacity-100'
        >
          <span
            class='text-white text-sm font-medium bg-black/70 px-4 py-2 rounded-full'
          >Change image</span>
        </div>
        <input
          id='gambar-input'
          type='file'
          name='gambar'
          accept='image/jpeg,image/jpg,image/png'
          class='hidden'
        />
      </label>
      <p id='file-name' class='text-xs text-gray-500 mt-2 hidden'></p>
      <p class='text-xs text-gray-400 mt-2'>Leave empty to keep current image.
        If replacing: JPG/PNG, 1900–1920 × 1000–1080px, max 10MB.</p>

      <!-- Pesan error validasi gambar -->
      <div
        id='image-error'
        class='hidden mt-2 flex items-start gap-2 bg-red-50 border border-red-200 text-red-600 text-sm px-3 py-2 rounded-lg'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='w-4 h-4 mt-0.5 shrink-0'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z'
          />
        </svg>
        <span id='image-error-text'></span>
      </div>

      <!-- Konfirmasi valid -->
      <div
        id='image-valid'
        class='hidden mt-2 flex items-center gap-2 bg-green-50 border border-green-200 text-green-700 text-sm px-3 py-2 rounded-lg'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='w-4 h-4 shrink-0'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
          />
        </svg>
        <span id='image-valid-text'>New image looks good</span>
      </div>
    </div>

    <div>
      <label
        for='title'
        class='block text-sm text-gray-900 font-medium mb-2'
      >Title</label>
      <input
        type='text'
        id='title'
        name='title'
        required
        value='{{gallery.title}}'
        class='w-full border border-gray-300 text-gray-900 rounded-lg px-4 py-2.5 bg-white text-sm'
      />
    </div>

    <div>
      <label
        for='description'
        class='block text-sm text-gray-900 font-medium mb-2'
      >Description</label>
      <textarea
        id='description'
        name='description'
        rows='4'
        required
        class='w-full border border-gray-300 text-gray-900 bg-white rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 resize-none'
      >{{gallery.description}}</textarea>
    </div>

    <div>
      <label
        for='kategori_id'
        class='block text-sm text-gray-900 font-medium mb-2'
      >
        Category
      </label>

      <input
        type='text'
        value='{{kategori.nama_kategori}}'
        class='w-full border border-gray-300 rounded-lg px-4 py-2.5 bg-gray-100'
        disabled
      />
      <input type='hidden' name='kategori_id' value='{{kategori.id}}' />
    </div>

    <div class='flex items-center gap-3 pt-2'>
      <!-- Tidak disabled di awal karena gambar lama tetap valid (opsional untuk diganti) -->
      <button
        id='submit-btn'
        type='submit'
        class='bg-gray-900 text-white px-6 py-2.5 rounded-lg text-sm font-medium transition disabled:opacity-40 disabled:cursor-not-allowed hover:enabled:bg-gray-700'
      >
        Save Changes
      </button>
      <a
        href='/category/{{kategori.id}}'
        class='text-sm text-gray-500 hover:text-gray-900'
      >Cancel</a>
    </div>
  </form>
</div>

{{!-- prettier-ignore --}}
<script>
function () {
    const RULES = {
      minWidth: 1900,
      maxWidth: 1920,
      minHeight: 1000,
      maxHeight: 1080,
      maxSize: 10 * 1024 * 1024, // 10MB
      allowedTypes: ['image/jpeg', 'image/jpg', 'image/png'],
    };

    const input = document.getElementById('gambar-input');
    const previewImg = document.getElementById('preview-img');
    const fileName = document.getElementById('file-name');
    const errorBox = document.getElementById('image-error');
    const errorText = document.getElementById('image-error-text');
    const validBox = document.getElementById('image-valid');
    const validText = document.getElementById('image-valid-text');
    const submitBtn = document.getElementById('submit-btn');
    const originalSrc = previewImg.src;

    function showError(message) {
      errorText.textContent = message;
      errorBox.classList.remove('hidden');
      validBox.classList.add('hidden');
      submitBtn.disabled = true;
    }

    function showValid(width, height) {
      errorBox.classList.add('hidden');
      validText.textContent = `New image looks good (${width}×${height}px)`;
      validBox.classList.remove('hidden');
      submitBtn.disabled = false;
    }

    function resetToOriginal() {
      errorBox.classList.add('hidden');
      validBox.classList.add('hidden');
      submitBtn.disabled = false; // gambar lama tetap valid, jadi tombol boleh aktif lagi
      previewImg.src = originalSrc;
      fileName.classList.add('hidden');
    }

    input.addEventListener('change', () => {
      const file = input.files[0];

      if (!file) {
        resetToOriginal();
        return;
      }

      fileName.textContent = file.name + ' · ' + (file.size / 1024 / 1024).toFixed(2) + ' MB';
      fileName.classList.remove('hidden');

      // 1. Cek tipe file
      if (!RULES.allowedTypes.includes(file.type)) {
        showError('File type not allowed. Please upload a JPG or PNG image.');
        input.value = '';
        previewImg.src = originalSrc;
        return;
      }

      // 2. Cek ukuran file
      if (file.size > RULES.maxSize) {
        const sizeMB = (file.size / 1024 / 1024).toFixed(2);
        showError(`File is too large (${sizeMB}MB). Maximum allowed size is 10MB.`);
        input.value = '';
        previewImg.src = originalSrc;
        return;
      }

      // 3. Cek resolusi gambar
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const { width, height } = img;
          previewImg.src = e.target.result;

          const widthOk = width >= RULES.minWidth && width <= RULES.maxWidth;
          const heightOk = height >= RULES.minHeight && height <= RULES.maxHeight;

          if (!widthOk || !heightOk) {
            showError(
              `Image resolution is ${width}×${height}px. Required: width ${RULES.minWidth}–${RULES.maxWidth}px and height ${RULES.minHeight}–${RULES.maxHeight}px.`
            );
            return;
          }

          showValid(width, height);
        };
        img.onerror = () => {
          showError('Could not read this image file. Please try a different file.');
          input.value = '';
          previewImg.src = originalSrc;
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    });

    document.getElementById('gallery-form').addEventListener('submit', (e) => {
      if (submitBtn.disabled) {
        e.preventDefault();
      }
    });
  })();