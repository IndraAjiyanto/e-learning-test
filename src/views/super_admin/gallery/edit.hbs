{{!--
  Halaman: Edit Gallery — Super Admin
  Lokasi: src/views/super_admin/gallery/edit.hbs
  Level: L4 Page

  Route: GET /gallery/formEdit/:galleryId -> PATCH /gallery/:id
  (multipart: image opsional + no + title + description + categoryId).
  Data: { gallery, category }.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>
    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Gallery'
      }}

      {{> components/ui/super_admin/description/index
        text=(concat 'Adjust the information below to edit this image in ' category.name '.')
      }}
    </div>

    <form
      action='/gallery/{{gallery.id}}?_method=PATCH'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='{ ...galleryForm({ gallery: {{json gallery}} }), ...formDirtyGate() }'
      x-init='$nextTick(() => captureBaseline())'
      @input='recomputeDirty()'
      @change='recomputeDirty()'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white p-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-5'
    >
      <input type='hidden' name='categoryId' value='{{category.id}}' />

      <div class='flex flex-col gap-6'>
        {{> components/ui/super_admin/form/gallery/fields edit=true }}

        {{> components/ui/super_admin/form/button
          row=true
          cancelHref=(concat '/category/' category.id)
          submitLabel='Save Changes'
          disabled='!canSubmit() || !isDirty || loading'
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/gallery/form }}
