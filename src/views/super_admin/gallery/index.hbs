<div
  class='w-full mx-auto px-6 py-10'
  x-data='galleryTable({ gallery: {{json gallery}} })'
>

  <!-- Header & Search -->
  <div
    class='mb-6 flex flex-col md:flex-row md:justify-between md:items-center gap-4'
  >
    <h2
      class='text-3xl font-bold text-gray-900 text-center md:text-left'
    >Gallery</h2>
    <div class='flex items-center gap-3'>
      <div class='relative w-full md:w-64'>
        <input
          type='text'
          placeholder='Search gallery...'
          x-model='searchInput'
          @input='search = searchInput; pageNumber = 0'
          class='border border-gray-300 bg-white text-gray-900 rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-gray-900 w-full'
        />
        <button
          @click='search = searchInput; pageNumber = 0'
          class='absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-900'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            class='h-5 w-5'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M21 21l-4.35-4.35m0 0A7.5 7.5 0 1110.5 3a7.5 7.5 0 016.15 13.65z'
            />
          </svg>
        </button>
      </div>

      <a
        href='/gallery/formCreate'
        class='bg-gray-900 text-white px-4 py-2 rounded-lg shadow hover:bg-gray-600 transition'
      >
        Create Gallery
      </a>
    </div>
  </div>

  <!-- Grid Cards -->
  <div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6'>
    {{#each gallery}}
      <div
        class='bg-white shadow-lg rounded-xl overflow-hidden'
        x-show="filteredGallery.includes('{{id}}')"
      >
        <div class='aspect-[16/9] bg-gray-100 overflow-hidden'>
          <img
            src='{{file_path}}'
            alt='{{title}}'
            class='w-full h-full object-cover'
          />
        </div>
        <div class='p-4'>
          {{#if category.name}}
            <span
              class='inline-block text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded-full mb-2'
            >{{category.name}}</span>
          {{/if}}
          <h3 class='font-semibold text-gray-900 mb-1'>{{title}}</h3>
          <p class='text-sm text-gray-600 line-clamp-2 mb-4'>{{description}}</p>
          <div class='flex items-center gap-2 pt-3 border-t border-gray-100'>
            <a
              href='/gallery/formEdit/{{id}}'
              class='flex-1 text-center text-sm font-medium border border-gray-200 rounded-lg py-2 hover:bg-gray-900 hover:text-white transition'
            >
              Edit
            </a>
            <form
              action='/gallery/{{id}}?_method=DELETE'
              method='POST'
              onsubmit="return confirm('Delete this gallery item?');"
              class='flex-1'
            >
              <button
                type='submit'
                class='w-full text-sm font-medium border border-red-200 text-red-600 rounded-lg py-2 hover:bg-red-600 hover:text-white transition'
              >
                Delete
              </button>
            </form>
          </div>
        </div>
      </div>
    {{/each}}
  </div>

  <div
    class='w-full md:w-1/2 mx-auto py-6 flex justify-center gap-2 items-center'
    x-show='pageCount() > 1'
  >
    <button
      @click='prevPage'
      :disabled='pageNumber==0'
      class='px-3 py-1 rounded border border-gray-900 text-gray-900'
      :class="{ 'opacity-50 cursor-not-allowed': pageNumber==0 }"
    >Prev</button>
    <template x-for='(page,index) in pages()' :key='index'>
      <button
        @click='viewPage(index)'
        class='px-3 py-1 rounded'
        :class="{ 'bg-gray-900 text-white font-bold': index===pageNumber }"
        x-text='index+1'
      ></button>
    </template>
    <button
      @click='nextPage'
      :disabled='pageNumber >= pageCount()-1'
      class='px-3 py-1 rounded border border-gray-900 text-gray-900'
      :class="{ 'opacity-50 cursor-not-allowed': pageNumber >= pageCount()-1 }"
    >Next</button>
  </div>
</div>

<script>
  function galleryTable({ gallery }) { return { search: "", pageNumber: 0, size:
  6, gallery, amount: 0, get filteredGallery() { let filtered =
  this.gallery.filter(item =>
  item.title.toLowerCase().includes(this.search.toLowerCase()) ); this.amount =
  filtered.length; const start = this.pageNumber * this.size; const end = start
  + this.size; return filtered.slice(start, end).map(item =>
  item.id.toString()); }, pages() { return Array.from({ length: this.pageCount()
  }); }, pageCount() { return Math.ceil(this.amount / this.size); }, nextPage()
  { if (this.pageNumber < this.pageCount() - 1) this.pageNumber++; }, prevPage()
  { if (this.pageNumber > 0) this.pageNumber--; }, viewPage(index) {
  this.pageNumber = index; } }; }

</script>