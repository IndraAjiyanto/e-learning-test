<div class='max-w-2xl mx-auto px-6 py-10'>
  <a
    href='/gallery'
    class='inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-900 mb-6'
  >
    ← Back to Gallery
  </a>

  <h2 class='text-3xl font-bold text-gray-900 mb-8'>Create Gallery</h2>

  <form
    id='gallery-form'
    action='/gallery'
    method='POST'
    enctype='multipart/form-data'
    class='space-y-6'
  >

    <div>
      <label class='block text-sm font-medium mb-2'>Image</label>
      <label
        for='gambar-input'
        class='relative flex flex-col items-center justify-center border-2 border-dashed border-gray-300 rounded-xl aspect-[16/9] cursor-pointer overflow-hidden hover:border-gray-500 transition bg-white'
      >
        <img
          id='preview-img'
          class='hidden absolute inset-0 w-full h-full object-cover'
          alt='Preview'
        />
        <div
          id='drop-placeholder'
          class='flex flex-col items-center text-center px-6'
        >
          <p class='text-sm font-medium'>Click to select image</p>
          <p class='text-xs text-gray-400 mt-1'>JPG / PNG, 1900–1920 ×
            1000–1080px, max 10MB</p>
        </div>
        <input
          id='gambar-input'
          type='file'
          name='gambar'
          accept='image/jpeg,image/jpg,image/png'
          required
          class='hidden'
        />
      </label>
      <p id='file-name' class='text-xs text-gray-500 mt-2 hidden'></p>

      <!-- Pesan error validasi gambar -->
      <div
        id='image-error'
        class='hidden mt-2 flex items-start gap-2 bg-red-50 border border-red-200 text-red-600 text-sm px-3 py-2 rounded-lg'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='w-4 h-4 mt-0.5 shrink-0'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z'
          />
        </svg>
        <span id='image-error-text'></span>
      </div>

      <!-- Konfirmasi valid -->
      <div
        id='image-valid'
        class='hidden mt-2 flex items-center gap-2 bg-green-50 border border-green-200 text-green-700 text-sm px-3 py-2 rounded-lg'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='w-4 h-4 shrink-0'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
          />
        </svg>
        <span id='image-valid-text'>Image looks good</span>
      </div>
    </div>

    <div>
      <label for='title' class='block text-sm font-medium mb-2'>Title</label>
      <input
        type='text'
        id='title'
        name='title'
        required
        class='w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900'
      />
    </div>

    <div>
      <label
        for='description'
        class='block text-sm font-medium mb-2'
      >Description</label>
      <textarea
        id='description'
        name='description'
        rows='4'
        required
        class='w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 resize-none'
      ></textarea>
    </div>

    <div>
      <label
        for='kategori_id'
        class='block text-sm font-medium mb-2'
      >Category</label>
      <select
        id='kategori_id'
        name='kategori_id'
        class='w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900'
      >
        <option value=''>No category</option>
        {{#each kategori}}
          <option value='{{id}}'>{{nama_kategori}}</option>
        {{/each}}
      </select>
    </div>

    <div class='flex items-center gap-3 pt-2'>
      <button
        id='submit-btn'
        type='submit'
        disabled
        class='bg-gray-900 text-white px-6 py-2.5 rounded-lg text-sm font-medium transition disabled:opacity-40 disabled:cursor-not-allowed hover:enabled:bg-gray-700'
      >
        Save Gallery
      </button>
      <a
        href='/gallery'
        class='text-sm text-gray-500 hover:text-gray-900'
      >Cancel</a>
    </div>
  </form>
</div>
{{!-- prettier-ignore --}}
<script>
  (function () {
    const RULES = {
      minWidth: 1900,
      maxWidth: 1920,
      minHeight: 1000,
      maxHeight: 1080,
      maxSize: 10 * 1024 * 1024, // 10MB
      allowedTypes: ['image/jpeg', 'image/jpg', 'image/png'],
    };

    const input = document.getElementById('gambar-input');
    const previewImg = document.getElementById('preview-img');
    const placeholder = document.getElementById('drop-placeholder');
    const fileName = document.getElementById('file-name');
    const errorBox = document.getElementById('image-error');
    const errorText = document.getElementById('image-error-text');
    const validBox = document.getElementById('image-valid');
    const validText = document.getElementById('image-valid-text');
    const submitBtn = document.getElementById('submit-btn');

    function showError(message) {
      errorText.textContent = message;
      errorBox.classList.remove('hidden');
      validBox.classList.add('hidden');
      submitBtn.disabled = true;
    }

    function showValid(width, height) {
      errorBox.classList.add('hidden');
      validText.textContent = `Image looks good (${width}×${height}px)`;
      validBox.classList.remove('hidden');
      submitBtn.disabled = false;
    }

    function resetState() {
      errorBox.classList.add('hidden');
      validBox.classList.add('hidden');
      submitBtn.disabled = true;
    }

    input.addEventListener('change', () => {
      const file = input.files[0];
      resetState();

      if (!file) {
        previewImg.classList.add('hidden');
        placeholder.classList.remove('hidden');
        fileName.classList.add('hidden');
        return;
      }

      fileName.textContent = file.name + ' · ' + (file.size / 1024 / 1024).toFixed(2) + ' MB';
      fileName.classList.remove('hidden');

      // 1. Cek tipe file
      if (!RULES.allowedTypes.includes(file.type)) {
        showError('File type not allowed. Please upload a JPG or PNG image.');
        previewImg.classList.add('hidden');
        placeholder.classList.remove('hidden');
        input.value = '';
        return;
      }

      // 2. Cek ukuran file
      if (file.size > RULES.maxSize) {
        const sizeMB = (file.size / 1024 / 1024).toFixed(2);
        showError(`File is too large (${sizeMB}MB). Maximum allowed size is 10MB.`);
        previewImg.classList.add('hidden');
        placeholder.classList.remove('hidden');
        input.value = '';
        return;
      }

      // 3. Cek resolusi gambar
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const { width, height } = img;

          previewImg.src = e.target.result;
          previewImg.classList.remove('hidden');
          placeholder.classList.add('hidden');

          const widthOk = width >= RULES.minWidth && width <= RULES.maxWidth;
          const heightOk = height >= RULES.minHeight && height <= RULES.maxHeight;

          if (!widthOk || !heightOk) {
            showError(
              `Image resolution is ${width}×${height}px. Required: width ${RULES.minWidth}–${RULES.maxWidth}px and height ${RULES.minHeight}–${RULES.maxHeight}px.`
            );
            return;
          }

          showValid(width, height);
        };
        img.onerror = () => {
          showError('Could not read this image file. Please try a different file.');
          previewImg.classList.add('hidden');
          placeholder.classList.remove('hidden');
          input.value = '';
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    });

    // Jaga-jaga: cegah submit kalau tombol somehow masih enabled tapi belum ada file valid
    document.getElementById('gallery-form').addEventListener('submit', (e) => {
      if (submitBtn.disabled) {
        e.preventDefault();
      }
    });
  })();
</script>