{{!--
  Halaman: Create Gallery — Super Admin
  Lokasi: src/views/super_admin/gallery/create.hbs
  Level: L4 Page

  Route: GET /gallery/formCreate/:categoryId -> POST /gallery
  (multipart: image + no + title + description + categoryId).
  Data: { category }.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>
    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Gallery'
      }}

      {{> components/ui/super_admin/description/index
        text=(concat 'Add an image to the gallery of ' category.name '.')
      }}
    </div>

    <form
      action='/gallery'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='galleryForm()'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white p-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-5'
    >
      <input type='hidden' name='categoryId' value='{{category.id}}' />

      <div class='flex flex-col gap-6'>
        {{> components/ui/super_admin/form/gallery/fields }}

        {{> components/ui/super_admin/form/button
          row=true
          cancelHref=(concat '/category/' category.id)
          submitLabel='Create Gallery'
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/gallery/form }}
