<div class="pt-28 py-20">
  <div class="max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg">
    <h2 class="text-2xl font-semibold mb-6 text-gray-900">Edit Visi & Misi</h2>

    <form action="/visi-misi/{{visi_misi.id}}?_method=PUT" method="post" enctype="multipart/form-data" class="space-y-6">

      <div>
        <label for="visi" class="block text-sm font-semibold text-gray-700 mb-1">Visi</label>
        <input 
          type="text" 
          id="visi" 
          name="visi" 
          value="{{visi_misi.visi}}" 
          class="w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700">
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Misi</label>

        <!-- Quill Editor -->
        <div id="editor-misi" class="w-full border bg-white border-gray-300 rounded-lg min-h-[150px]"></div>

        <!-- Hidden input untuk submit -->
        <input type="hidden" id="misi" name="misi" value="{{visi_misi.misi}}">
      </div>

      <div class="flex gap-3">
        <button type="submit" class="bg-gray-900 text-white px-6 py-2 rounded-lg shadow hover:bg-gray-600 transition">
          Update
        </button>
        <a href="/visi-misi"
          class="px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>


<script>
  const quillMisi = new Quill('#editor-misi', {
    theme: 'snow',
    placeholder: 'Tulis misi di sini...',
    modules: {
      toolbar: [
        ['bold', 'italic', 'underline'],
        [{ list: 'ordered' }, { list: 'bullet' }],
        ['clean']
      ]
    }
  });

  // ✅ Set isi quill dari database (value hidden input)
  const misiValue = document.getElementById('misi').value;
  quillMisi.root.innerHTML = misiValue;

  // ✅ Saat submit, isi kembali hidden input dengan content terbaru quill
  document.querySelector('form').addEventListener('submit', function () {
    document.getElementById('misi').value = quillMisi.root.innerHTML;
  });
</script>