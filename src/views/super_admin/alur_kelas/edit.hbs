<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        // Form validation states
        formData: {
          judul: { id: `{{alur_kelas.judul.id}}`, en: `{{alur_kelas.judul.en}}`, ja: `{{alur_kelas.judul.ja}}` },
          isi: { id: `{{alur_kelas.isi.id}}`, en: `{{alur_kelas.isi.en}}`, ja: `{{alur_kelas.isi.ja}}` }
        },
        formErrors: {
          judul: { id: '', en: '', ja: '' },
          isi: { id: '', en: '', ja: '' }
        },
        formValid: {
          judul: { id: true, en: true, ja: true },
          isi: { id: true, en: true, ja: true }
        },

        validateField(field, lang, value) {
          this.formData[field][lang] = value;
          
          switch(field) {
            case 'judul':
              if (!value.trim()) {
                this.formErrors.judul[lang] = 'Title is required';
                this.formValid.judul[lang] = false;
              } else if (value.trim().length < 3) {
                this.formErrors.judul[lang] = 'Title must be at least 3 characters';
                this.formValid.judul[lang] = false;
              } else {
                this.formErrors.judul[lang] = '';
                this.formValid.judul[lang] = true;
              }
              break;
              
            case 'isi':
              if (!value.trim()) {
                this.formErrors.isi[lang] = 'Description is required';
                this.formValid.isi[lang] = false;
              } else if (value.trim().length < 10) {
                this.formErrors.isi[lang] = 'Description must be at least 10 characters';
                this.formValid.isi[lang] = false;
              } else {
                this.formErrors.isi[lang] = '';
                this.formValid.isi[lang] = true;
              }
              break;
          }
        },

        canSubmit() {
          return Object.values(this.formValid.judul).every(v => v) && Object.values(this.formValid.isi).every(v => v);
        },

        hasFormErrors() {
          return Object.values(this.formErrors.judul).some(e => e !== '') || Object.values(this.formErrors.isi).some(e => e !== '');
        }
      }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Flow</h2>

    <form
      action='/alur-kelas/{{alur_kelas.id}}/{{alur_kelas.kelas.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      x-data="{ loading: false }"
      @submit.prevent="if (canSubmit()) { loading = true; $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

      <!-- Form Fields -->
      <div class='space-y-6'>

        <!-- Judul per Bahasa -->
        <div class='space-y-4'>
          <label
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Title</label>
          <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
            <!-- ID -->
            <div class='space-y-2'>
              <label class='block text-xs font-medium text-gray-600'>ID</label>
              <input
                type='text'
                name='judul[id]'
                required
                placeholder='Judul (ID)'
                :class="formErrors.judul.id ? 'border-red-500 focus:ring-red-500' : formValid.judul.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                x-model='formData.judul.id'
                @input='validateField("judul", "id", $event.target.value)'
                x-init='$el.value = formData.judul.id'
              />

              <!-- Error Message -->
              <template x-if='formErrors.judul.id'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.judul.id'
                  ></p>
                </div>
              </template>

              <!-- Success Message -->
              <template x-if='formValid.judul.id && !formErrors.judul.id'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid title</p>
                </div>
              </template>
            </div>

            <!-- EN -->
            <div class='space-y-2'>
              <label class='block text-xs font-medium text-gray-600'>EN</label>
              <input
                type='text'
                name='judul[en]'
                required
                placeholder='Title (EN)'
                :class="formErrors.judul.en ? 'border-red-500 focus:ring-red-500' : formValid.judul.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                x-model='formData.judul.en'
                @input='validateField("judul", "en", $event.target.value)'
                x-init='$el.value = formData.judul.en'
              />

              <!-- Error Message -->
              <template x-if='formErrors.judul.en'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.judul.en'
                  ></p>
                </div>
              </template>

              <!-- Success Message -->
              <template x-if='formValid.judul.en && !formErrors.judul.en'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid title</p>
                </div>
              </template>
            </div>

            <!-- JP -->
            <div class='space-y-2'>
              <label class='block text-xs font-medium text-gray-600'>JP</label>
              <input
                type='text'
                name='judul[ja]'
                required
                placeholder='タイトル (JA)'
                :class="formErrors.judul.ja ? 'border-red-500 focus:ring-red-500' : formValid.judul.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                x-model='formData.judul.ja'
                @input='validateField("judul", "ja", $event.target.value)'
                x-init='$el.value = formData.judul.ja'
              />

              <!-- Error Message -->
              <template x-if='formErrors.judul.ja'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.judul.ja'
                  ></p>
                </div>
              </template>

              <!-- Success Message -->
              <template x-if='formValid.judul.ja && !formErrors.judul.ja'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid title</p>
                </div>
              </template>
            </div>
          </div>
        </div>

        <!-- Isi per Bahasa -->
        <div class='space-y-4'>
          <label
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Description</label>
          <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
            <!-- ID -->
            <div class='space-y-2'>
              <label class='block text-xs font-medium text-gray-600'>ID</label>
              <textarea
                name='isi[id]'
                rows='4'
                required
                placeholder='Deskripsi (ID)...'
                :class="formErrors.isi.id ? 'border-red-500 focus:ring-red-500' : formValid.isi.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                x-model='formData.isi.id'
                @input='validateField("isi", "id", $event.target.value)'
                x-init='$el.value = formData.isi.id'
              ></textarea>

              <!-- Error Message -->
              <template x-if='formErrors.isi.id'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.isi.id'
                  ></p>
                </div>
              </template>

              <!-- Success Message -->
              <template x-if='formValid.isi.id && !formErrors.isi.id'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid description</p>
                </div>
              </template>
            </div>

            <!-- EN -->
            <div class='space-y-2'>
              <label class='block text-xs font-medium text-gray-600'>EN</label>
              <textarea
                name='isi[en]'
                rows='4'
                required
                placeholder='Description (EN)...'
                :class="formErrors.isi.en ? 'border-red-500 focus:ring-red-500' : formValid.isi.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                x-model='formData.isi.en'
                @input='validateField("isi", "en", $event.target.value)'
                x-init='$el.value = formData.isi.en'
              ></textarea>

              <!-- Error Message -->
              <template x-if='formErrors.isi.en'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.isi.en'
                  ></p>
                </div>
              </template>

              <!-- Success Message -->
              <template x-if='formValid.isi.en && !formErrors.isi.en'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid description</p>
                </div>
              </template>
            </div>

            <!-- JP -->
            <div class='space-y-2'>
              <label class='block text-xs font-medium text-gray-600'>JP</label>
              <textarea
                name='isi[ja]'
                rows='4'
                required
                placeholder='説明 (JA)...'
                :class="formErrors.isi.ja ? 'border-red-500 focus:ring-red-500' : formValid.isi.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                x-model='formData.isi.ja'
                @input='validateField("isi", "ja", $event.target.value)'
                x-init='$el.value = formData.isi.ja'
              ></textarea>

              <!-- Error Message -->
              <template x-if='formErrors.isi.ja'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.isi.ja'
                  ></p>
                </div>
              </template>

              <!-- Success Message -->
              <template x-if='formValid.isi.ja && !formErrors.isi.ja'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid description</p>
                </div>
              </template>
            </div>
          </div>
        </div>
      </div>

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span x-show="loading" class="loading loading-spinner loading-sm"></span>
          <span x-show="!loading">Update</span>
        </button>
        <a
          href='/kelass/detail/kelas/admin/{{alur_kelas.kelas.id}}'
        :disabled='loading'
        :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300  transition'>
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>