<div class='pt-28 px-6 py-10'>
  <div
    class='max-w-4xl mx-auto px-6 py-10 bg-white rounded-2xl shadow-xl space-y-8'
  >

    <!-- Tombol Back -->
    <div>
      <a
        href='/alur-kelas'
        class='inline-flex items-center text-gray-600 text-base font-medium hover:underline'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='h-5 w-5 mr-1'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='2'
            d='M15 19l-7-7 7-7'
          />
        </svg>
        Back
      </a>
    </div>

    <!-- Header Info -->
    <div class='flex items-start justify-between'>
      <div>
        <h1 class='text-3xl text-gray-900 font-bold mb-4'>
          Alur Kelas #{{alur_kelas.alur_ke}}
        </h1>

        <div class='space-y-3'>
          <div class='flex items-start gap-2'>
            <span
              class='text-gray-600 font-semibold min-w-[120px]'
            >Kelas:</span>
            <span class='text-gray-800'>{{alur_kelas.kelas.nama_kelas}}</span>
          </div>

          <div class='flex items-start gap-2'>
            <span
              class='text-gray-600 font-semibold min-w-[120px]'
            >Keterangan:</span>
            <span class='text-gray-800'>{{alur_kelas.keterangan}}</span>
          </div>
        </div>
      </div>

      <!-- Tombol Aksi -->
      <div class='flex items-center gap-4'>
        <!-- Tombol Edit -->
        <a
          href='/alur-kelas/formEdit/{{alur_kelas.id}}'
          class='p-3 rounded-xl bg-blue-50 text-blue-600 hover:bg-blue-100 hover:text-blue-800 transition shadow-sm'
          title='Edit Alur Kelas'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            fill='none'
            viewBox='0 0 24 24'
            stroke-width='2'
            stroke='currentColor'
            class='w-7 h-7'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M16.862 4.487l1.687-1.688a1.875 1.875 
                     0 112.652 2.652L10.582 16.07a4.5 
                     4.5 0 01-1.897 1.13l-2.685.805.805-2.685
                     a4.5 4.5 0 011.13-1.897l10.927-10.936z'
            />
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M19.5 7.125L16.875 4.5'
            />
          </svg>
        </a>

        <!-- Tombol Delete -->
        <form
          action='/alur-kelas/{{alur_kelas.id}}/{{alur_kelas.kelas.id}}?_method=DELETE'
          method='post'
        >
          <button
            type='button'
            onclick='confirmDelete(this)'
            class='p-3 rounded-xl bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-800 transition shadow-sm'
            title='Delete Alur Kelas'
          >
            <svg
              xmlns='http://www.w3.org/2000/svg'
              fill='none'
              viewBox='0 0 24 24'
              stroke-width='2'
              stroke='currentColor'
              class='w-7 h-7'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                d='M6 18L18 6M6 6l12 12'
              />
            </svg>
          </button>
        </form>
      </div>
    </div>

    <!-- Additional Info Card -->
    <div class='bg-gray-50 rounded-xl p-6 border border-gray-200'>
      <h3 class='text-lg font-semibold text-gray-900 mb-4'>Detail Informasi</h3>
      <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>
        <div>
          <p class='text-sm text-gray-600'>Nomor Urut</p>
          <p
            class='text-base font-medium text-gray-900'
          >{{alur_kelas.alur_ke}}</p>
        </div>
        <div>
          <p class='text-sm text-gray-600'>Kelas</p>
          <p
            class='text-base font-medium text-gray-900'
          >{{alur_kelas.kelas.nama_kelas}}</p>
        </div>
        <div class='md:col-span-2'>
          <p class='text-sm text-gray-600'>Keterangan</p>
          <p
            class='text-base font-medium text-gray-900'
          >{{alur_kelas.keterangan}}</p>
        </div>
      </div>
    </div>

  </div>
</div>