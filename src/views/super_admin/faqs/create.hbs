{{!--
  Halaman: Create FAQ per Kategori — Super Admin
  Lokasi: src/views/super_admin/faqs/create.hbs
  Level: L4 Page

  Route: GET /question-general/formCreate/:categoryId
         -> POST /question-general/:categoryId (urlencoded, CreateFaqsDto).

  Field, validasi, dan payload sama dengan super_admin/faq/create.hbs, jadi
  memakai ulang form/faq; bedanya hanya action dan tujuan Cancel per kategori.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create FAQ'
      }}

      {{> components/ui/super_admin/description/index
        text='Create a new frequently asked question and answer for this category.'
      }}
    </div>

    <form
      action='/question-general/{{categoryId}}'
      method='post'
      novalidate
      x-data='faqForm()'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
    >
      <div class='flex flex-col gap-5'>
        {{> components/ui/super_admin/tabs/language/index ariaLabel='FAQ language' }}

        {{> components/ui/super_admin/form/faq/fields }}

        <div class='flex flex-col-reverse gap-3 pt-6 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href=(concat '/category/' categoryId)
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Create FAQ'
            loading=true
            disabled='!canSubmit() || loading'
          }}
        </div>
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/faq/form }}
