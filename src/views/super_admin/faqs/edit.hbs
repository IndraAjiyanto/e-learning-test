{{!--
  Halaman: Edit FAQ per Kategori — Super Admin
  Lokasi: src/views/super_admin/faqs/edit.hbs
  Level: L4 Page

  Route: GET /question-general/formEdit/:faqsId
         -> PATCH /question-general/:faqsId/:categoryId
         (urlencoded + _method override, sesuai UpdateFaqsDto).

  Beda dari create.hbs: field terisi nilai existing dan tombol submit
  "Save Changes".
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit FAQ'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the question and answer for this FAQ entry.'
      }}
    </div>

    <form
      action='/question-general/{{faqs.id}}/{{faqs.category.id}}?_method=PATCH'
      method='post'
      novalidate
      x-data='faqForm({ question: {{json faqs.question}}, answer: {{json faqs.answer}} })'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
    >
      <div class='flex flex-col gap-5'>
        {{> components/ui/super_admin/tabs/language/index ariaLabel='FAQ language' }}

        {{> components/ui/super_admin/form/faq/fields }}

        <div class='flex flex-col-reverse gap-3 pt-6 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href=(concat '/category/' faqs.category.id)
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Save Changes'
            loading=true
            disabled='!canSubmit() || loading'
          }}
        </div>
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/faq/form }}
