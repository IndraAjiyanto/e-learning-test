<div
  class='py-10'
  x-data="{
  // Form validation states
  formData: {
    visi: { id: '', en: '', ja: '' }
  },
  formErrors: {
    visi: { id: '', en: '', ja: '' }
  },
  formValid: {
    visi: { id: false, en: false, ja: false }
  },

  validateField(field, lang, value) {
    this.formData[field][lang] = value;
    
    switch(field) {
      case 'visi':
        if (!value.trim()) {
          this.formErrors.visi[lang] = 'Visi is required';
          this.formValid.visi[lang] = false;
        } else if (value.trim().length < 10) {
          this.formErrors.visi[lang] = 'Visi must be at least 10 characters';
          this.formValid.visi[lang] = false;
        } else {
          this.formErrors.visi[lang] = '';
          this.formValid.visi[lang] = true;
        }
        break;
    }
  },

  canSubmit() {
    return Object.values(this.formValid.visi).every(v => v);
  },

  hasFormErrors() {
    return Object.values(this.formErrors.visi).some(e => e !== '');
  }
}"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create Visi</h2>

    <form
      action='/visi'
      method='POST'
      class='space-y-6'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; }'
    >

      <!-- Visi per Bahasa -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Visi</label>
        <div class='grid grid-cols-1 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.visi.id'
              @input='validateField("visi", "id", $event.target.value)'
              id='visi_id'
              name='visi[id]'
              rows='5'
              required
              :class="formErrors.visi.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.visi.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Tulis visi dalam bahasa Indonesia...'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.visi.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.visi.id'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.visi.id && !formErrors.visi.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Visi valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label
              class='block text-xs font-medium text-gray-600'
            >EN</label>
            <textarea
              x-model='formData.visi.en'
              @input='validateField("visi", "en", $event.target.value)'
              id='visi_en'
              name='visi[en]'
              rows='5'
              required
              :class="formErrors.visi.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.visi.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Write vision in English...'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.visi.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.visi.en'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.visi.en && !formErrors.visi.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Vision looks good</p>
              </div>
            </template>
          </div>

          <!-- JA -->
          <div class='space-y-2'>
            <label
              class='block text-xs font-medium text-gray-600'
            >JA</label>
            <textarea
              x-model='formData.visi.ja'
              @input='validateField("visi", "ja", $event.target.value)'
              id='visi_ja'
              name='visi[ja]'
              rows='5'
              required
              :class="formErrors.visi.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.visi.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='ビジョンを日本語で書いてください...'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.visi.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.visi.ja'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.visi.ja && !formErrors.visi.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>ビジョンが有効です</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Create
        </button>
        <a
          href='/visi'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>

    </form>
  </div>
</div>