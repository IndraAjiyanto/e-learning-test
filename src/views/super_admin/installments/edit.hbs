{{!--
  Halaman: Edit Installment — Super Admin
  Lokasi: src/views/super_admin/installments/edit.hbs
  Level: L4 Page

  Route: GET /installment/formEdit/:id -> PATCH /installment/:id
  (urlencoded + _method override). Data: { installments, availableMonths }.

  Beda dari create.hbs: field terisi nilai existing, periode dikunci (lockMonth),
  dan tombol aksi berada di dalam kartu field.

  `installments.dueDates` sudah dinormalkan service lewat toDateOnlyArray, jadi
  bentuknya langsung cocok untuk <input type='date'>. Nilai awal dikirim lewat
  helper json, bukan template literal, agar aman untuk nilai apa pun.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Installment'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the down payment, the monthly amounts, and when each payment is due.'
      }}
    </div>

    <form
      action='/installment/{{installments.id}}?_method=PATCH'
      method='post'
      novalidate
      x-data='installmentForm({
        month: {{json installments.month}},
        availableMonths: {{json availableMonths}},
        downPayment: {{json installments.downPayment}},
        price: {{json installments.price}},
        dueDates: {{json installments.dueDates}},
        lockMonth: true
      })'
      @submit.prevent='submitForm($event)'
    >
      {{#> components/ui/super_admin/form/installment/fields lockMonth=true }}
        <div class='flex flex-col-reverse gap-3 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href=(concat '/program/detail/program/admin/' installments.course.id)
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Save Changes'
            loading=true
            disabled='!canSubmit() || loading'
          }}
        </div>
      {{/components/ui/super_admin/form/installment/fields}}
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/installment/form }}
