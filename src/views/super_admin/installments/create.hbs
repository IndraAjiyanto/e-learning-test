{{!--
  Halaman: Create Installment — Super Admin
  Lokasi: src/views/super_admin/installments/create.hbs
  Level: L4 Page

  Route: GET /installment/formCreate/:courseId -> POST /installment/:courseId
  (urlencoded). Data: { courseId, availableMonths }.

  Field dikirim sebagai month, downPayment, lalu price[] dan dueDates[] berulang
  satu per bulan. `courseId` ikut di URL, bukan di body.

  availableMonths adalah durasi yang BELUM punya skema cicilan. Route ini tetap
  bisa dibuka saat daftarnya kosong, jadi halaman merender empty state alih-alih
  form tanpa periode yang bisa dipilih.

  Toast sukses tidak dirender di sini: submit redirect ke detail program, jadi
  notifikasinya muncul di halaman tujuan lewat flash `toast`.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Installment'
      }}

      {{> components/ui/super_admin/description/index
        text='Add an installment plan so participants can pay this program in stages.'
      }}
    </div>

    {{#if availableMonths.length}}
      <form
        action='/installment/{{courseId}}'
        method='post'
        novalidate
        x-data='installmentForm({ availableMonths: {{json availableMonths}} })'
        @submit.prevent='submitForm($event)'
        class='flex flex-col gap-3.5'
      >
        {{> components/ui/super_admin/form/installment/fields }}

        <div class='flex flex-col-reverse gap-3 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:flex-row sm:justify-end sm:p-5'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href=(concat '/program/detail/program/admin/' courseId)
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Create Installment'
            loading=true
            disabled='!canSubmit() || loading'
          }}
        </div>
      </form>
    {{else}}
      <div class='flex flex-col items-start gap-4 rounded-xl border border-[#d9d9d9] bg-white p-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-5'>
        {{> components/ui/super_admin/description/index
          text='Every available duration already has an installment plan. Edit the existing plan instead of adding a new one.'
        }}

        {{> components/ui/super_admin/form/button
          as='link'
          variant='secondary'
          href=(concat '/program/detail/program/admin/' courseId)
          label='Back to Program'
        }}
      </div>
    {{/if}}
  </div>
</div>

{{> components/ui/super_admin/form/installment/form }}
