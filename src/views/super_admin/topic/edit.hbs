<div
  class='py-10'
  x-data="{
    get computedClass() {
      const raw = (this.formData.icon || '').toString().trim();
      if (!raw) return 'fa-solid fa-circle-question';
      const v = raw;
      const hasFa = v.includes('fa-') || v.includes('fas ') || v.includes('far ') || v.includes('fat ') || v.includes('fal ');
      if (hasFa) {
        if (v.includes(' ')) return v;
        return 'fa-solid ' + v;
      }
      if (!v.includes(' ')) return 'fa-solid fa-' + v;
      return v;
    },
    formData: {
      icon: '{{topic.icon}}',
      nama: { id: '{{topic.nama.id}}', en: '{{topic.nama.en}}', ja: '{{topic.nama.ja}}' },
      description: { id: '{{topic.deskripsi.id}}', en: '{{topic.deskripsi.en}}', ja: '{{topic.deskripsi.ja}}' }
    },
    formErrors: {
      icon: '',
      nama: { id: '', en: '', ja: '' },
      description: { id: '', en: '', ja: '' }
    },
    formValid: {
      icon: false,
      nama: { id: false, en: false, ja: false },
      description: { id: false, en: false, ja: false }
    },
    validateField(field, langOrValue, valueIfLang) {
      if (field === 'icon') {
        const value = langOrValue;
        this.formData.icon = value;
        if (!value.trim()) {
          this.formErrors.icon = 'Icon wajib diisi';
          this.formValid.icon = false;
        } else if (value.trim().length < 2) {
          this.formErrors.icon = 'Minimal 2 karakter';
          this.formValid.icon = false;
        } else {
          this.formErrors.icon = '';
          this.formValid.icon = true;
        }
      } else if (field === 'nama') {
        const lang = langOrValue;
        const value = valueIfLang;
        this.formData.nama[lang] = value;
        if (!value.trim()) {
          this.formErrors.nama[lang] = 'Nama wajib diisi';
          this.formValid.nama[lang] = false;
        } else if (value.trim().length < 3) {
          this.formErrors.nama[lang] = 'Minimal 3 karakter';
          this.formValid.nama[lang] = false;
        } else {
          this.formErrors.nama[lang] = '';
          this.formValid.nama[lang] = true;
        }
      } else if (field === 'description') {
        const lang = langOrValue;
        const value = valueIfLang;
        this.formData.description[lang] = value;
        if (!value.trim()) {
          this.formErrors.description[lang] = 'Deskripsi wajib diisi';
          this.formValid.description[lang] = false;
        } else if (value.trim().length < 10) {
          this.formErrors.description[lang] = 'Minimal 10 karakter';
          this.formValid.description[lang] = false;
        } else {
          this.formErrors.description[lang] = '';
          this.formValid.description[lang] = true;
        }
      }
    },
    canSubmit() {
      const descValid = Object.values(this.formValid.description).every(v => v);
      return this.formValid.icon && Object.values(this.formValid.nama).every(v => v) && descValid;
    },
    hasFormErrors() {
      return this.formErrors.icon !== '' ||
        Object.values(this.formErrors.nama).some(e => e !== '') ||
        Object.values(this.formErrors.description).some(e => e !== '');
    },
    init() {
      this.validateField('icon', this.formData.icon);
      this.validateField('nama', 'id', this.formData.nama.id);
      this.validateField('nama', 'en', this.formData.nama.en);
      this.validateField('nama', 'ja', this.formData.nama.ja);
      this.validateField('description', 'id', this.formData.description.id);
      this.validateField('description', 'en', this.formData.description.en);
      this.validateField('description', 'ja', this.formData.description.ja);
    }
  }"
>
  <div class='max-w-4xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900 text-center'>Edit Topic</h2>
    <form
      action='/topic/{{topic.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      x-data='{ loading: false }'
      x-init='init()'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; } loading = true;'
    >

    {{> super_admin/topic/edit/name_input }}
{{> super_admin/topic/edit/icon_input }}
{{> super_admin/topic/edit/description_input }}

      <!-- Submit Buttons -->
      <div class='flex gap-2 mt-6'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="(!canSubmit() || loading) ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='py-2 px-4 text-white font-semibold rounded-lg shadow transition'
        >
          <span
            x-show='loading'
            class='loading loading-spinner loading-sm'
          ></span>
          <span x-show='!loading'>Update</span>
        </button>
        <a
          href='/topic'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300  transition'>
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg mt-4'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Tidak bisa submit:</span>
            Mohon perbaiki semua error validasi di atas.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>