{{!-- Wrapper Utama --}}
<div class="flex flex-col items-start p-[42px_34px] gap-[10px] w-full max-w-[1408px] min-h-[1024px] bg-[#F3F3F3] font-['Montserrat']">
  
  {{!-- Container --}}
  <div class="flex flex-col items-start p-0 gap-[28px] w-full">
    
    {{!-- Title Header --}}
    <div class="flex flex-col items-start p-0 gap-1 w-full">
      <h1 class="font-bold text-[34px] leading-[36px] tracking-[-1px] text-[#003060]">
        Dashboard Utama
      </h1>
      <p class="font-medium text-[16px] leading-[20px] text-[#718096]">
        Pantau aktivitas dan ringkasan pengguna
      </p>
    </div>

    {{!-- Grid Layout 2 Kolom (Kiri: Chart & Summary, Kanan: Active Users) --}}
    <div class="flex flex-row items-start gap-[26px] w-full">
      
      {{!-- KOLOM KIRI --}}
      <div class="flex flex-col items-start p-0 gap-[30px] w-[822px]">
        
        {{!-- 1. CARD: Participant Activity --}}
        <div class="card bg-white shadow-[0_8px_30px_rgba(35,57,93,0.07)] rounded-[20px] p-6 w-full flex-col gap-[22px]">
          
          {{!-- Section Title & Legend --}}
          <div class="border border-[#D9D9D9] rounded-[16px] p-[33px] flex flex-col gap-6 w-full">
            <h2 class="font-semibold text-[16px] text-[#003060]">Participant activity</h2>
            
            {{!-- Legend --}}
            <div class="flex flex-row items-start gap-[18px] font-['Inter']">
              <div class="flex flex-row items-center gap-[7px]">
                <div class="w-2 h-2 bg-[#396FE8]"></div>
                <span class="text-[12px] text-[#667085]">Login</span>
              </div>
              <div class="flex flex-row items-center gap-[7px]">
                <div class="w-2 h-2 bg-[#7B61D9]"></div>
                <span class="text-[12px] text-[#667085]">Active</span>
              </div>
            </div>
          </div>

          {{!-- Plot Chart --}}
          <div class="flex flex-row items-end pt-[12px] gap-[20px] w-full h-[292px] border-b border-[#E4EAF2]">
            
{{!-- Looping Chart Bars — tinggi dinamis dari data user_activity --}}
          {{#each weekly}}
            <div class="flex flex-col justify-between items-center w-[93.43px] h-[280px]">
              <div class="flex flex-row items-end gap-[6px] h-[265px]">
                <div class="w-[22px] bg-[#396FE8] rounded-t-[6px]" style="height: {{loginH}}px"></div>
                <div class="w-[22px] bg-[#7B61D9] rounded-t-[6px]" style="height: {{activeH}}px"></div>
              </div>
              <span class="font-['Inter'] text-[12px] text-[#667085]">{{label}}</span>
            </div>
          {{/each}}

          </div>
        </div>

        {{!-- 2. CARD: Ringkasan Hari Ini --}}
        <div class="card bg-white shadow-[0_8px_30px_rgba(35,57,93,0.07)] rounded-[20px] p-6 pb-0 w-full min-h-[650px] flex-col gap-[20px]">
          
          <div class="border border-[#D9D9D9] rounded-[16px] p-[33px] w-full">
            <h2 class="font-semibold text-[16px] text-[#003060]">Ringkasan hari ini</h2>
          </div>

          {{!-- Completion Box --}}
          <div class="flex flex-row justify-between items-center p-[18px] w-full h-[98px] bg-[#EAF1FF] rounded-[14px] font-['Inter']">
            <div class="flex flex-col gap-1">
              <span class="text-[13px] text-[#667085]">Peserta Aktif Hari Ini</span>
              <span class="font-bold text-[28px] text-[#073565]">{{summary.activeToday}}</span>
            </div>
            
            {{!-- Custom CSS Progress Ring (sesuai Figma) --}}
            <div class="flex flex-col justify-center items-center w-[62px] h-[62px] bg-white border-[7px] border-[#396FE8] rounded-full">
               <span class="font-bold text-[13px] text-[#396FE8]">{{summary.onlineNow}}</span>
            </div>
          </div>

          {{!-- Summary Lists --}}
          <div class="flex flex-col gap-4 w-full font-['Inter'] mt-2">
            
            {{!-- Item 1 --}}
            <div class="flex flex-row items-center gap-3 w-full">
              <div class="flex justify-center items-center w-[44px] h-[44px] bg-[#EAF1FF] rounded-[14px]">
                <div class="w-5 h-5 border border-[#396FE8]"></div> {{!-- Ganti dengan icon panah SVG --}}
              </div>
              <div class="flex flex-col gap-1 flex-grow">
                <span class="text-[13px] text-[#667085]">Modul Diselesaikan</span>
                <span class="font-bold text-[20px] text-[#073565]">142</span>
              </div>
              <span class="font-semibold text-[12px] text-[#1D9A6C]">+12%</span>
            </div>
            <hr class="border-[#E4EAF2]"/>

            {{!-- Item 2 --}}
            <div class="flex flex-row items-center gap-3 w-full">
              <div class="flex justify-center items-center w-[44px] h-[44px] bg-[#F0ECFF] rounded-[14px]">
                <div class="w-5 h-5 border border-[#7B61D9]"></div> {{!-- Ganti dengan icon buku SVG --}}
              </div>
              <div class="flex flex-col gap-1 flex-grow">
                <span class="text-[13px] text-[#667085]">Total Waktu Belajar</span>
                <span class="font-bold text-[20px] text-[#073565]">3,420 Jam</span>
              </div>
              <span class="font-semibold text-[12px] text-[#1D9A6C]">+8%</span>
            </div>
            <hr class="border-[#E4EAF2]"/>
            
            {{!-- Update Status --}}
            <div class="flex flex-row items-center gap-2 mt-4 font-['Inter']">
               <div class="w-[7px] h-[7px] bg-[#1D9A6C] rounded-full"></div>
               <span class="text-[12px] text-[#667085]">Diperbarui 5 menit yang lalu</span>
            </div>

          </div>
        </div>

      </div>

      {{!-- KOLOM KANAN: Active Users Panel --}}
      <div class="card bg-white shadow-[0_8px_30px_rgba(35,57,93,0.07)] rounded-[20px] p-6 w-[496px] h-[836px] flex-col gap-[20px]">
        
        <div class="border border-[#D9D9D9] rounded-[16px] p-[33px] w-full">
          <h2 class="font-semibold text-[16px] text-[#003060]">Active Users Panel</h2>
        </div>

        {{!-- User List menggunakan Handlebars Looping --}}
        {{!-- Note: Di router JS-mu, kamu bisa mengirimkan array objek `users` ke view ini --}}
        <div class="flex flex-col gap-3 w-full overflow-y-auto">
          
          {{!-- Looping peserta aktif (dari user_activity) --}}
          {{#each activeUsers}}
            <div class="flex flex-row items-center p-4 gap-3 w-full h-[72px] bg-[#F8FAFC] border border-[#D9D9D9] rounded-[12px]">
              <div class="avatar placeholder">
                {{#if profile}}
                  <img src="{{profile}}" alt="{{username}}" class="w-[40px] h-[40px] rounded-full object-cover" />
                {{else}}
                  <div class="bg-[#EAF1FF] text-[#396FE8] rounded-full w-[40px] h-[40px]">
                    <span class="font-semibold text-[14px]">{{initials}}</span>
                  </div>
                {{/if}}
              </div>
              <div class="flex flex-col gap-[2px] flex-grow">
                <span class="font-semibold text-[14px] text-[#003060] truncate">{{username}}</span>
                <span class="text-[12px] text-[#667085] truncate">{{default program 'Program'}}</span>
              </div>
              <div class="flex flex-row items-center gap-[6px]">
                <div class="w-2 h-2 bg-[#20A779] rounded-full"></div>
                <span class="font-semibold text-[12px] text-[#20A779]">Online</span>
              </div>
            </div>
          {{else}}
            <div class="flex items-center justify-center p-6 w-full h-[72px] bg-[#F8FAFC] border border-[#D9D9D9] rounded-[12px]">
              <span class="text-[12px] text-[#667085]">Belum ada peserta aktif</span>
            </div>
          {{/each}}

        </div>
      </div>

    </div>
  </div>
</div>