<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Technology</h2>

    <form
      action='/teknologi/{{teknologi.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      x-data="{
        loading: false,
        nama: `{{teknologi.nama}}`,
        svg: `{{teknologi.svg}}`,
        svgPreview: '',
        svgError: '',
        errors: { nama: null, svg: null },
        success: { nama: false, svg: false },
        validateNama() {
          if (!this.nama.trim()) {
            this.errors.nama = 'Technology name is required';
            this.success.nama = false;
          } else if (this.nama.trim().length < 2) {
            this.errors.nama = 'Technology name must be at least 2 characters';
            this.success.nama = false;
          } else {
            this.errors.nama = null;
            this.success.nama = true;
          }
        },
        validateSVG(text) {
          this.svgError = '';
          this.errors.svg = null;
          this.success.svg = false;
          
          if (!text) {
            this.svgPreview = '';
            this.errors.svg = 'SVG code is required';
            return;
          }
          
          if (!text.trim().startsWith('<svg') || !text.trim().endsWith('</svg>')) {
            this.svgError = 'Invalid SVG format. Must start with <svg and end with </svg>';
            this.errors.svg = this.svgError;
            this.svgPreview = '';
            return;
          }
          
          this.svgPreview = text;
          this.success.svg = true;
        },
        init() {
          const textarea = this.$refs.svgInput;
          if (textarea && textarea.value) {
            this.validateSVG(textarea.value);
          }
        },
        get canSubmit() {
          return this.success.nama && this.success.svg;
        }
      }"
      @submit.prevent="if (canSubmit) { loading = true; $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

      <!-- Nama Teknologi -->
      <div class='space-y-2'>
        <label for='nama' class='block text-sm font-semibold text-gray-700 mb-1'>Technology Name</label>
        <input
          x-model='nama'
          @input='validateNama()'
          type='text'
          id='nama'
          name='nama'
          value='{{teknologi.nama}}'
          required
          :class="errors.nama ? 'border-red-500 focus:ring-red-500' : success.nama ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
        />
        
        <template x-if='errors.nama'>
          <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'>
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='errors.nama'></p>
          </div>
        </template>

        <template x-if='success.nama && !errors.nama'>
          <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'>
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid technology name</p>
          </div>
        </template>
      </div>

      <!-- SVG Code -->
      <div class='space-y-2'>
        <label for='svg' class='block text-sm font-semibold text-gray-700 mb-1'>SVG Code</label>
        <textarea
          x-model='svg'
          @input='validateSVG($event.target.value)'
          id='svg'
          name='svg'
          rows='8'
          required
          placeholder='Paste your SVG code here...'
          :class="errors.svg ? 'border-red-500 focus:ring-red-500' : success.svg ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 font-mono text-sm'
          x-ref='svgInput'
        >{{{teknologi.svg}}}</textarea>

        <template x-if='svgError'>
          <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'>
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='svgError'></p>
          </div>
        </template>

        <template x-if='svgPreview && !svgError'>
          <div class='mt-4'>
            <p class='text-sm font-semibold text-gray-700 mb-2'>Preview:</p>
            <div class='p-4 bg-gray-50 border border-gray-200 rounded-lg flex items-center justify-center'>
              <div class='w-24 h-24 flex items-center justify-center' x-html='svgPreview'></div>
            </div>
          </div>
        </template>

        <template x-if='success.svg && !svgError'>
          <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'>
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid SVG code</p>
          </div>
        </template>
      </div>

      <!-- Action Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit || loading'
          :class="!canSubmit || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition focus:outline-none focus:ring-2 focus:ring-gray-900 flex items-center gap-2'
        >
          <span x-show='loading' class='loading loading-spinner loading-sm'></span>
          <span x-show='!loading'>Update</span>
        </button>
        <a
          href='/teknologi'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'>
          Cancel
        </a>
      </div>
    </form>

    <template x-if='errors.nama || errors.svg || svgError'>
      <div class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'>
        <i class='fas fa-exclamation-triangle text-red-500'></i>
        <p class='text-sm text-red-800'>
          <span class='font-semibold'>Cannot submit:</span>
          Please fix all validation errors above.
        </p>
      </div>
    </template>
  </div>
</div>