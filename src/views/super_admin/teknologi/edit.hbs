<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Teknologi</h2>

    <form
      action='/teknologi/{{teknologi.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      x-data="{
        svgPreview: `{{{teknologi.svg}}}`,
        svgError: '',
        validateSVG(text) {
          this.svgError = '';
          if (!text) {
            this.svgPreview = '';
            return;
          }
          
          // Basic SVG validation
          if (!text.trim().startsWith('<svg') || !text.trim().endsWith('</svg>')) {
            this.svgError = 'Invalid SVG format. Must start with <svg and end with </svg>';
            this.svgPreview = '';
            return;
          }
          
          this.svgPreview = text;
        }
      }"
    >

      <!-- Nama Teknologi -->
      <div>
        <label
          for='nama'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Nama Teknologi</label>
        <input
          type='text'
          id='nama'
          name='nama'
          value='{{teknologi.nama}}'
          required
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        />
      </div>

      <!-- SVG Code -->
      <div>
        <label
          for='svg'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >SVG Code</label>
        <textarea
          id='svg'
          name='svg'
          rows='8'
          required
          placeholder='Paste your SVG code here...'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700 font-mono text-sm'
          @input='validateSVG($event.target.value)'
          x-ref='svgInput'
        >{{{teknologi.svg}}}</textarea>

        <!-- Error Message -->
        <template x-if='svgError'>
          <p class='mt-2 text-sm text-red-600' x-text='svgError'></p>
        </template>

        <!-- SVG Preview -->
        <template x-if='svgPreview && !svgError'>
          <div class='mt-4'>
            <p class='text-sm font-semibold text-gray-700 mb-2'>Preview:</p>
            <div
              class='p-4 bg-gray-50 border border-gray-200 rounded-lg flex items-center justify-center'
            >
              <div
                class='w-24 h-24 flex items-center justify-center'
                x-html='svgPreview'
              ></div>
            </div>
          </div>
        </template>
      </div>

      <!-- Action Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          class='bg-gray-900 text-white px-6 py-2 rounded-lg shadow hover:bg-gray-600 transition focus:outline-none focus:ring-2 focus:ring-gray-900 flex items-center gap-2'
        >
          <i class='fas fa-save'></i>
          Update
        </button>
        <a
          href='/teknologi'
          class='bg-white border border-gray-300 text-gray-900 px-6 py-2 rounded-lg shadow hover:bg-gray-100 transition focus:outline-none focus:ring-2 focus:ring-gray-900 flex items-center gap-2'
        >
          <i class='fas fa-times'></i>
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>