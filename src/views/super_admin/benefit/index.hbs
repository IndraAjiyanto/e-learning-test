<div class='max-w-5xl mx-auto px-6 py-10 pt-28'>
  <div
    class='mb-6 flex flex-col md:flex-row md:justify-between md:items-center gap-4'
  >
    <h2
      class='text-3xl font-bold text-gray-900 text-center md:text-left'
    >Benefit Management</h2>

    <div class='flex items-center gap-3'>
      <a
        href='/benefit/formCreate'
        class='bg-gray-900 text-white px-4 py-2 rounded-lg shadow hover:bg-gray-600 transition'
      >
        Create Benefit
      </a>
    </div>
  </div>

  <!-- Flash Messages -->
  {{#if messages.success}}
    <div
      class='mb-6 flex items-center gap-3 p-4 bg-green-50 border border-green-300 rounded-lg text-green-800'
    >
      <i class='fas fa-check-circle text-green-500 text-xl'></i>
      <p class='font-medium'>{{messages.success}}</p>
    </div>
  {{/if}}

  {{#if messages.error}}
    <div
      class='mb-6 flex items-center gap-3 p-4 bg-red-50 border border-red-300 rounded-lg text-red-800'
    >
      <i class='fas fa-exclamation-circle text-red-500 text-xl'></i>
      <p class='font-medium'>{{messages.error}}</p>
    </div>
  {{/if}}

  <div class='overflow-x-auto bg-white shadow-lg rounded-xl'>
    <table class='min-w-full divide-y divide-gray-200'>
      <thead class='bg-gray-100'>
        <tr>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Index</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Number</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Title</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Description</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Action</th>
        </tr>
      </thead>
      <tbody class='divide-y divide-gray-200'>
        {{#each benefit}}
          <tr class='hover:bg-gray-50 transition'>
            <td class='px-6 py-4 text-sm text-gray-800'>{{addOne @index}}</td>
            <td class='px-6 py-4 text-sm text-gray-800'>
              <span
                class='inline-flex items-center justify-center w-8 h-8 rounded-full bg-gray-900 text-white font-bold'
              >{{no}}</span>
            </td>
            <td
              class='px-6 py-4 text-sm font-semibold text-gray-800'
            >{{judul}}</td>
            <td class='px-6 py-4 text-sm text-gray-600'>
              <div class='line-clamp-2'>{{text}}</div>
            </td>
            <td class='px-6 py-4 text-sm text-gray-800 flex items-center gap-3'>
              <!-- Edit Button -->
              <form action='/benefit/formEdit/{{id}}' method='get'>
                <button
                  type='submit'
                  class='p-2 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 hover:text-blue-800 transition'
                  title='Edit'
                >
                  <!-- Pencil Icon -->
                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke-width='1.5'
                    stroke='currentColor'
                    class='w-5 h-5'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 
                 2.652L10.582 16.07a4.5 4.5 0 01-1.897 
                 1.13l-2.685.805.805-2.685a4.5 4.5 
                 0 011.13-1.897l10.927-10.936z'
                    />
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M19.5 7.125L16.875 4.5'
                    />
                  </svg>
                </button>
              </form>

              <!-- Delete Button -->
              <form action='/benefit/{{id}}?_method=DELETE' method='post'>
                <button
                  type='button'
                  onclick='confirmDelete(this)'
                  class='p-2 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-800 transition'
                  title='Delete'
                >
                  <!-- Trash Icon -->
                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke-width='1.5'
                    stroke='currentColor'
                    class='w-5 h-5'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M6 18L18 6M6 6l12 12'
                    />
                  </svg>
                </button>
              </form>
            </td>

          </tr>
        {{else}}
          <tr>
            <td colspan='5' class='px-6 py-12 text-center'>
              <div class='flex flex-col items-center gap-3'>
                <i class='fas fa-inbox text-gray-300 text-5xl'></i>
                <p class='text-gray-500 font-medium'>No benefits found</p>
                <a
                  href='/benefit/formCreate'
                  class='inline-flex items-center gap-2 text-gray-900 hover:text-gray-700 font-semibold'
                >
                  <i class='fas fa-plus'></i>
                  <span>Add your first benefit</span>
                </a>
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>