{{!--
  Halaman: Benefit — Super Admin
  Lokasi: src/views/super_admin/benefit/index.hbs
  Level: L4 Page

  Data: GET /benefit → { benefit }, title & description berbentuk jsonb { id, en, ja }.
  Search & pagination dijalankan di client lewat clientTable().

  `lang` hidup di scope Alpine bersarang (sama seperti halaman FAQ): getter
  `rows` dan `totalPages` milik clientTable() akan hilang bila state digabung.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Benefit'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage the key benefits and value propositions displayed across Kesatria Academy.'
      }}
    </div>

    <div
      class='flex flex-col gap-3.5'
      x-data='clientTable({ items: {{json benefit}}, searchKeys: ["title.id", "title.en", "title.ja", "description.id", "description.en", "description.ja"] })'
    >
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search benefit..'
        searchLabel='Search benefit'
        createHref='/benefit/formCreate'
        createLabel='Create Benefit'
      }}

      <div
        class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
        x-data="{ lang: 'id' }"
      >
        <div class='flex flex-col gap-5'>

          {{> components/ui/super_admin/tabs/language/index ariaLabel='Benefit language' }}

          {{#> components/ui/super_admin/table/card tableClass='min-w-[1010px]'}}
            <colgroup>
              <col class='w-[66px]' />
              <col class='w-[94px]' />
              <col class='w-[73px]' />
              <col class='w-[331px]' />
              <col class='w-[331px]' />
              <col class='w-[116px]' />
            </colgroup>
            <thead>
              <tr>
                {{> components/ui/super_admin/table/header_cell label='No' }}
                {{> components/ui/super_admin/table/header_cell label='Number' }}
                {{> components/ui/super_admin/table/header_cell label='Icon' }}
                {{> components/ui/super_admin/table/header_cell label='Title' }}
                {{> components/ui/super_admin/table/header_cell label='Description' }}
                {{> components/ui/super_admin/table/header_cell label='Action' }}
              </tr>
            </thead>
            <tbody>
              <template x-for='(row, index) in rows' :key='row.id'>
                <tr class='transition-colors hover:bg-[#fafafa]'>

                  {{> components/ui/super_admin/table/cell
                    text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
                  }}

                  {{#> components/ui/super_admin/table/cell}}
                    {{> components/ui/super_admin/badge/index
                      size='md'
                      text='row.no'
                      class='bg-[#f9f5ff] text-[#6941c6]'
                    }}
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    <i
                      class='flex h-5 w-5 items-center justify-center text-base text-[#525252]'
                      :class='faIconClass(row.icon)'
                      aria-hidden='true'
                    ></i>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='block truncate font-inter text-sm leading-5 text-[#525252]'
                      x-text="(row.title && row.title[lang]) || '—'"
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='block truncate font-inter text-sm leading-5 text-[#525252]'
                      x-text="(row.description && row.description[lang]) || '—'"
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell variant='action'}}
                    {{> components/ui/super_admin/table/row_actions
                      entity='benefit'
                      deleteAction="'/benefit/' + row.id + '?_method=DELETE'"
                      editHref="'/benefit/formEdit/' + row.id"
                    }}
                  {{/components/ui/super_admin/table/cell}}
                </tr>
              </template>

              {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='6'}}
                No benefits found.
              {{/components/ui/super_admin/table/message_row}}
            </tbody>
          {{/components/ui/super_admin/table/card}}
        </div>
      </div>
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Benefit?'
  description='Are you sure you want to delete this benefit? This action will permanently remove its title and description in all languages and cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}

{{> components/ui/super_admin/table/fa_icon }}
