<div class='py-10' x-data="{
  icon: '{{benefit.icon}}',
  get computedClass() {
    const raw = (this.formData.icon || '').toString().trim();
    if (!raw) return 'fa-solid fa-circle-question';
    const v = raw;
    const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(v) || v.split(/\s+/).some(s => /^fa-/i.test(s));
    if (hasFaPrefix) {
      if (/^fa-\w+/i.test(v) && !/\s+/.test(v)) return 'fa-solid ' + v;
      return v;
    }
    if (!v.includes(' ')) return 'fa-solid fa-' + v;
    return v;
  },

  // Form validation states
  formData: {
    icon: '{{benefit.icon}}',
    judul: {
      id: '{{benefit.judul.id}}',
      en: '{{benefit.judul.en}}',
      ja: '{{benefit.judul.ja}}'
    },
    text: {
      id: '{{benefit.text.id}}',
      en: '{{benefit.text.en}}',
      ja: '{{benefit.text.ja}}'
    },
    no: '{{benefit.no}}' || ''
  },
  formErrors: {
    icon: '',
    judul: { id: '', en: '', ja: '' },
    text: { id: '', en: '', ja: '' },
    no: '{{benefit.no}}' ? '' : 'Number selection is required'
  },
  formValid: {
    icon: true,
    judul: { id: true, en: true, ja: true },
    text: { id: true, en: true, ja: true },
    no: !!'{{benefit.no}}'
  },

  validateField(field, lang, value) {
    if (lang) {
      this.formData[field][lang] = value;
    } else {
      this.formData[field] = value;
    }
    
    switch(field) {
      case 'icon':
        if (!value.trim()) {
          this.formErrors.icon = 'Icon is required';
          this.formValid.icon = false;
        } else if (value.trim().length < 2) {
          this.formErrors.icon = 'Icon must be at least 2 characters';
          this.formValid.icon = false;
        } else {
          this.formErrors.icon = '';
          this.formValid.icon = true;
        }
        break;
        
      case 'judul':
        if (!value.trim()) {
          this.formErrors.judul[lang] = 'Title is required';
          this.formValid.judul[lang] = false;
        } else if (value.trim().length < 3) {
          this.formErrors.judul[lang] = 'Title must be at least 3 characters';
          this.formValid.judul[lang] = false;
        } else {
          this.formErrors.judul[lang] = '';
          this.formValid.judul[lang] = true;
        }
        break;
        
      case 'text':
        if (!value.trim()) {
          this.formErrors.text[lang] = 'Description is required';
          this.formValid.text[lang] = false;
        } else if (value.trim().length < 10) {
          this.formErrors.text[lang] = 'Description must be at least 10 characters';
          this.formValid.text[lang] = false;
        } else {
          this.formErrors.text[lang] = '';
          this.formValid.text[lang] = true;
        }
        break;
        
      case 'no':
        if (!value) {
          this.formErrors.no = 'Number selection is required';
          this.formValid.no = false;
        } else {
          this.formErrors.no = '';
          this.formValid.no = true;
        }
        break;
    }
  },

  canSubmit() {
    return this.formValid.icon && this.formValid.judul.id && this.formValid.judul.en && this.formValid.judul.ja &&
           this.formValid.text.id && this.formValid.text.en && this.formValid.text.ja && this.formValid.no;
  },

  hasFormErrors() {
    return (this.formErrors.icon || this.formErrors.judul.id || this.formErrors.judul.en || this.formErrors.judul.ja ||
            this.formErrors.text.id || this.formErrors.text.en || this.formErrors.text.ja || this.formErrors.no) !== '';
  }
}">
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Benefit</h2>

    <form
      action='/benefit/{{benefit.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; }'
    >

          <div class='space-y-2'>
        <label
          for='icon'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Icon</label>
        <div class='flex items-center gap-4'>
          <input
            x-model='formData.icon'
            type='text'
            id='icon'
            name='icon'
            placeholder='code or fa-code or fa-solid fa-code'
            :class="formErrors.icon ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.icon ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                                    @input='validateField("icon", null, $event.target.value)'
          />

          <div class='flex items-center gap-3'>
            <i :class='computedClass' class='text-2xl text-gray-700'></i>
            <span class='text-sm text-gray-500' x-text='computedClass'></span>
          </div>
        </div>

        <!-- Error Message -->
        <template x-if='formErrors.icon'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.icon'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.icon && !formErrors.icon'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid icon</p>
          </div>
        </template>

        <p class='text-sm text-gray-500 mt-2'>Type an icon name like
          <code>code</code>
          or
          <code>fa-code</code>. It will preview using Font Awesome 6 (e.g.
          <code>fa-solid fa-code</code>).</p>
      </div>

      <!-- Judul -->
      <div class='space-y-2'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Title
        </label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- Indonesian -->
          <div class='space-y-1'>
            <label for='judul_id' class='block text-xs font-medium text-gray-600 uppercase tracking-wide'>ID</label>
            <input
              x-model='formData.judul.id'
              @input='validateField("judul", "id", $event.target.value)'
              type='text'
              id='judul_id'
              name='judul[id]'
              placeholder='Judul benefit dalam bahasa Indonesia'
              :class="formErrors.judul.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.judul.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              x-init='$el.value = formData.judul.id'
            />
            <template x-if='formErrors.judul.id'>
              <div class='flex items-start gap-1 p-1 bg-red-50 border border-red-300 rounded'>
                <i class='fas fa-exclamation-circle text-red-500 text-xs mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.judul.id'></p>
              </div>
            </template>
            <template x-if='formValid.judul.id && !formErrors.judul.id'>
              <div class='flex items-center gap-1 p-1 bg-green-50 border border-green-300 rounded'>
                <i class='fas fa-check-circle text-green-500 text-xs'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- English -->
          <div class='space-y-1'>
            <label for='judul_en' class='block text-xs font-medium text-gray-600 uppercase tracking-wide'>EN</label>
            <input
              x-model='formData.judul.en'
              @input='validateField("judul", "en", $event.target.value)'
              type='text'
              id='judul_en'
              name='judul[en]'
              placeholder='Benefit title in English'
              :class="formErrors.judul.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.judul.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              x-init='$el.value = formData.judul.en'
            />
            <template x-if='formErrors.judul.en'>
              <div class='flex items-start gap-1 p-1 bg-red-50 border border-red-300 rounded'>
                <i class='fas fa-exclamation-circle text-red-500 text-xs mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.judul.en'></p>
              </div>
            </template>
            <template x-if='formValid.judul.en && !formErrors.judul.en'>
              <div class='flex items-center gap-1 p-1 bg-green-50 border border-green-300 rounded'>
                <i class='fas fa-check-circle text-green-500 text-xs'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- Japanese -->
          <div class='space-y-1'>
            <label for='judul_ja' class='block text-xs font-medium text-gray-600 uppercase tracking-wide'>JP</label>
            <input
              x-model='formData.judul.ja'
              @input='validateField("judul", "ja", $event.target.value)'
              type='text'
              id='judul_ja'
              name='judul[ja]'
              placeholder='ベネフィットのタイトル（日本語）'
              :class="formErrors.judul.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.judul.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              x-init='$el.value = formData.judul.ja'
            />
            <template x-if='formErrors.judul.ja'>
              <div class='flex items-start gap-1 p-1 bg-red-50 border border-red-300 rounded'>
                <i class='fas fa-exclamation-circle text-red-500 text-xs mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.judul.ja'></p>
              </div>
            </template>
            <template x-if='formValid.judul.ja && !formErrors.judul.ja'>
              <div class='flex items-center gap-1 p-1 bg-green-50 border border-green-300 rounded'>
                <i class='fas fa-check-circle text-green-500 text-xs'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Text -->
      <div class='space-y-2'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Description
        </label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- Indonesian -->
          <div class='space-y-1'>
            <label for='text_id' class='block text-xs font-medium text-gray-600 uppercase tracking-wide'>ID</label>
            <textarea
              x-model='formData.text.id'
              @input='validateField("text", "id", $event.target.value)'
              id='text_id'
              name='text[id]'
              rows='4'
              placeholder='Deskripsi benefit dalam bahasa Indonesia'
              :class="formErrors.text.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.text.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              x-init='$el.value = formData.text.id'
            ></textarea>
            <template x-if='formErrors.text.id'>
              <div class='flex items-start gap-1 p-1 bg-red-50 border border-red-300 rounded'>
                <i class='fas fa-exclamation-circle text-red-500 text-xs mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.text.id'></p>
              </div>
            </template>
            <template x-if='formValid.text.id && !formErrors.text.id'>
              <div class='flex items-center gap-1 p-1 bg-green-50 border border-green-300 rounded'>
                <i class='fas fa-check-circle text-green-500 text-xs'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- English -->
          <div class='space-y-1'>
            <label for='text_en' class='block text-xs font-medium text-gray-600 uppercase tracking-wide'>EN</label>
            <textarea
              x-model='formData.text.en'
              @input='validateField("text", "en", $event.target.value)'
              id='text_en'
              name='text[en]'
              rows='4'
              placeholder='Benefit description in English'
              :class="formErrors.text.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.text.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              x-init='$el.value = formData.text.en'
            ></textarea>
            <template x-if='formErrors.text.en'>
              <div class='flex items-start gap-1 p-1 bg-red-50 border border-red-300 rounded'>
                <i class='fas fa-exclamation-circle text-red-500 text-xs mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.text.en'></p>
              </div>
            </template>
            <template x-if='formValid.text.en && !formErrors.text.en'>
              <div class='flex items-center gap-1 p-1 bg-green-50 border border-green-300 rounded'>
                <i class='fas fa-check-circle text-green-500 text-xs'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- Japanese -->
          <div class='space-y-1'>
            <label for='text_ja' class='block text-xs font-medium text-gray-600 uppercase tracking-wide'>JP</label>
            <textarea
              x-model='formData.text.ja'
              @input='validateField("text", "ja", $event.target.value)'
              id='text_ja'
              name='text[ja]'
              rows='4'
              placeholder='ベネフィットの説明（日本語）'
              :class="formErrors.text.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.text.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              x-init='$el.value = formData.text.ja'
            ></textarea>
            <template x-if='formErrors.text.ja'>
              <div class='flex items-start gap-1 p-1 bg-red-50 border border-red-300 rounded'>
                <i class='fas fa-exclamation-circle text-red-500 text-xs mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.text.ja'></p>
              </div>
            </template>
            <template x-if='formValid.text.ja && !formErrors.text.ja'>
              <div class='flex items-center gap-1 p-1 bg-green-50 border border-green-300 rounded'>
                <i class='fas fa-check-circle text-green-500 text-xs'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Number -->
      <div class='space-y-2'>
        <label
          for='no'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Number
          
        </label>
        <select
          id='no'
          name='no'
          required
          :class="formErrors.no ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.no ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          x-model='formData.no'
          @change='validateField("no", null, $event.target.value)'
          x-init='$el.value = formData.no'
        >
          <option value=''>-- Select Number --</option>
          <option value='1' {{#if (eq benefit.no 1)}}selected{{/if}}>1</option>
          <option value='2' {{#if (eq benefit.no 2)}}selected{{/if}}>2</option>
          <option value='3' {{#if (eq benefit.no 3)}}selected{{/if}}>3</option>
        </select>

        <!-- Error Message -->
        <template x-if='formErrors.no'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.no'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.no && !formErrors.no'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid number selection</p>
          </div>
        </template>
      </div>

      <!-- Action Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Update
        </button>
        <a
          href='/benefit'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>