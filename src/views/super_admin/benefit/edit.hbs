<div class='py-10' x-data="{
  icon: '{{benefit.icon}}',
  get computedClass() {
    const raw = (this.icon || '').toString().trim();
    if (!raw) return 'fa-solid fa-circle-question';
    const v = raw;
    const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(v) || v.split(/\s+/).some(s => /^fa-/i.test(s));
    if (hasFaPrefix) {
      if (/^fa-\w+/i.test(v) && !/\s+/.test(v)) return 'fa-solid ' + v;
      return v;
    }
    if (!v.includes(' ')) return 'fa-solid fa-' + v;
    return v;
  }
}">
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Benefit</h2>

    <form
      action='/benefit/{{benefit.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
    >

          <div>
        <label
          for='icon'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Icon</label>
        <div class='flex items-center gap-4'>
          <input
            x-model='icon'
            type='text'
            id='icon'
            name='icon'
            placeholder='code or fa-code or fa-solid fa-code'
            class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          />

          <div class='flex items-center gap-3'>
            <i :class='computedClass' class='text-2xl text-gray-700'></i>
            <span class='text-sm text-gray-500' x-text='computedClass'></span>
          </div>
        </div>
        <p class='text-sm text-gray-500 mt-2'>Type an icon name like
          <code>code</code>
          or
          <code>fa-code</code>. It will preview using Font Awesome 6 (e.g.
          <code>fa-solid fa-code</code>).</p>
      </div>

      <!-- Judul -->
      <div>
        <label
          for='judul'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Title
          
        </label>
        <input
          type='text'
          id='judul'
          name='judul'
          required
          value='{{benefit.judul}}'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          placeholder='Enter benefit title'
        />
      </div>

      <!-- Text -->
      <div>
        <label
          for='text'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Description
          
        </label>
        <textarea
          id='text'
          name='text'
          rows='5'
          required
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700 resize-none'
          placeholder='Enter benefit description'
        >{{benefit.text}}</textarea>
      </div>

      <!-- Number -->
      <div>
        <label
          for='no'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Number
          
        </label>
        <select
          id='no'
          name='no'
          required
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        >
          <option value=''>-- Select Number --</option>
          <option value='1' {{#if (eq benefit.no 1)}}selected{{/if}}>1</option>
          <option value='2' {{#if (eq benefit.no 2)}}selected{{/if}}>2</option>
          <option value='3' {{#if (eq benefit.no 3)}}selected{{/if}}>3</option>
        </select>
      </div>

      <!-- Action Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          class='bg-gray-900 text-white px-6 py-2 rounded-lg shadow hover:bg-gray-600 transition flex items-center gap-2'
        >
          <i class='fas fa-save'></i>
          Update
        </button>
        <a
          href='/benefit'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          <i class='fas fa-times'></i>
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>