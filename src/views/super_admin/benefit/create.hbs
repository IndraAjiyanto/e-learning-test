{{!--
  Halaman: Create Benefit — Super Admin
  Lokasi: src/views/super_admin/benefit/create.hbs
  Level: L4 Page

  Route: GET /benefit/formCreate -> POST /benefit (urlencoded).
  Data: { availableNumbers } — nomor urut yang belum dipakai benefit lain.

  Field dikirim sebagai icon, title[id|en|ja], description[id|en|ja], no —
  express urlencoded extended merakitnya jadi objek sesuai kolom jsonb entity.

  Toast sukses tidak dirender di sini: submit redirect ke /benefit, jadi
  notifikasinya muncul di index.hbs lewat flash `toast`.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Benefit'
      }}

      {{> components/ui/super_admin/description/index
        text='Define a new benefit and value proposition to highlight across Kesatria Academy'
      }}
    </div>

    <form
      action='/benefit'
      method='post'
      novalidate
      x-data='benefitForm({ numbers: {{json availableNumbers}} })'
      @submit.prevent='submitForm($event)'
      class='flex flex-col gap-3.5'
    >
      {{> components/ui/super_admin/form/benefit/fields }}

      <div class='flex flex-col-reverse gap-3 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:flex-row sm:justify-end sm:p-5'>
        {{> components/ui/super_admin/form/button
          as='link'
          variant='secondary'
          href='/benefit'
          label='Cancel'
          loading=true
        }}

        {{> components/ui/super_admin/form/button
          type='submit'
          variant='primary'
          label='Create Benefit'
          loading=true
          disabled='!canSubmit() || loading'
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/benefit/form }}
