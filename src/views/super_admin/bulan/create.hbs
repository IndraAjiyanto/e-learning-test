<div
  class='py-10'
  x-data="{
  // Form validation states
  formData: {
    bulan: ''
  },
  formErrors: {
    bulan: ''
  },
  formValid: {
    bulan: false
  },

  validateField(field, value) {
    this.formData[field] = value;
    
    switch(field) {
      case 'bulan':
        const numValue = parseInt(value);
        if (!value || isNaN(numValue)) {
          this.formErrors.bulan = 'Month number is required';
          this.formValid.bulan = false;
        } else if (numValue < 1 || numValue > 12) {
          this.formErrors.bulan = 'Month must be between 1 and 12';
          this.formValid.bulan = false;
        } else {
          this.formErrors.bulan = '';
          this.formValid.bulan = true;
        }
        break;
    }
  },

  canSubmit() {
    return this.formValid.bulan;
  },

  hasFormErrors() {
    return Object.values(this.formErrors).some(error => error !== '');
  }
}"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create Month</h2>

    {{#if flash.message}}
      <div class='mb-4 text-sm text-red-600'>{{flash.message}}</div>
    {{/if}}

    <form
      action='/bulan'
      method='post'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; }'
      class='space-y-6'
    >

      <div class='space-y-2'>
        <label
          for='bulan'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Month (number)</label>
        <input
          x-model='formData.bulan'
          @input='validateField("bulan", $event.target.value)'
          id='bulan'
          name='bulan'
          type='number'
          min='1'
          max='12'
          required
          :class="formErrors.bulan ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.bulan ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
        />
        <!-- Error Message -->
        <template x-if='formErrors.bulan'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.bulan'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.bulan && !formErrors.bulan'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid month number</p>
          </div>
        </template>
      </div>

      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >Create</button>
        <a
          href='/bulan'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >Cancel</a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>