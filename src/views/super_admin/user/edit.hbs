{{!--
  Halaman: Edit User — Super Admin
  Lokasi: src/views/super_admin/user/edit.hbs
  Level: L4 Page

  Sidebar disediakan layouts/main.hbs (offset lg:ml-[319px])

  Route: GET /users/formEdit/:userId
         → POST /users/super_admin/:userId?_method=PATCH (multipart)
         → POST /users/:userId?_method=DELETE (Danger Zone)

--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[33px] sm:py-[43px]'>
  <div class='flex flex-col gap-4'>
    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit User'
      }}

      {{> components/ui/super_admin/description/index
        text="Update the user's profile, role, and account status."
      }}
    </div>

    {{!-- Section - MAIN FORM CARD
         Beda dengan Create User: tanpa field password, ada field Status,
         submit 'Save Changes'.

         Kontrak backend (tidak diubah):
         POST /users/super_admin/:userId?_method=PATCH, multipart/form-data,
         field username, email, role, isVerified, profile. --}}
    <form
      action='/users/super_admin/{{users.id}}?_method=PATCH'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='editUserForm()'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white p-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-8'
    >
      <div class='flex flex-col gap-6'>
        {{> components/ui/super_admin/form/photo_upload }}

        <div class='grid grid-cols-1 gap-x-3 gap-y-2.5 md:grid-cols-2'>
          {{> components/ui/super_admin/form/text_field
            id='username'
            name='username'
            field='username'
            label='Username'
            type='text'
            placeholder='Username'
            autocomplete='off'
            required=true
          }}

          {{> components/ui/super_admin/form/text_field
            id='email'
            name='email'
            field='email'
            label='Email Address'
            type='email'
            placeholder='email@untitledui.com'
            autocomplete='off'
            required=true
          }}

          {{> components/ui/super_admin/form/select_field
            id='role'
            name='role'
            field='role'
            label='Role'
            placeholder='Select a role'
            options='roleOptions'
            required=true
          }}

          {{!-- Status memakai select_field varian 'dropdown'; titik status
               datang dari `dot` di statusOptions. --}}
          {{> components/ui/super_admin/form/select_field
            id='isVerified'
            name='isVerified'
            field='isVerified'
            label='Status'
            variant='dropdown'
            placeholder='Select a status'
            options='statusOptions'
            required=true
          }}
        </div>

        {{> components/ui/super_admin/form/button
          row=true
          cancelHref='/users'
          submitLabel='Save Changes'
        }}
      </div>
    </form>

    {{!-- 4. DANGER ZONE CARD (Account Deletion)
         Kontrak backend (tidak diubah): DELETE /users/:id (lewat method-override). --}}
    <div
      class='flex flex-col gap-6 rounded-2xl border border-[#d9d9d9] bg-white px-4 py-[19px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:flex-row sm:items-center sm:justify-between sm:gap-11 sm:px-[31px]'
    >
      <div class='flex items-start gap-4'>
        <span
          class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-8 border-[#fef2f2] bg-[#fee2e2] text-[#dc2626]'
        >
          {{!-- lucide: alert-circle --}}
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.67' stroke-linecap='round' stroke-linejoin='round' class='h-6 w-6'>
            <circle cx='12' cy='12' r='10' />
            <path d='M12 8v4' />
            <path d='M12 16h.01' />
          </svg>
        </span>

        {{!-- Judul & deskripsi memakai ui/super_admin/description dengan override
             `class`, karena gaya default komponen berbeda dari yang dibutuhkan di sini. --}}
        <div class='flex flex-col gap-1'>
          {{> components/ui/super_admin/description/index
            text='Delete User Account'
            class='font-montserrat text-base font-semibold leading-5 text-[#003060]'
          }}

          {{> components/ui/super_admin/description/index
            text='Permanently remove this user and revoke access to Kesatria Academy. This action cannot be undone.'
            class='font-montserrat font-medium text-sm leading-5 text-[#718096]'
          }}
        </div>
      </div>

      <form action='/users/{{users.id}}?_method=DELETE' method='post' class='shrink-0'>
        {{> components/ui/super_admin/form/button
          label='Delete User'
          variant='danger'
          onclick='openDeleteModal(this)'
          class='w-full sm:w-auto'
        }}
      </form>
    </div>
  </div>
</div>

{{!-- Konfirmasi delete — komponen yang sama dengan halaman User List. Tombol Danger
     Zone di atas memakai onclick='openDeleteModal(this)'; fungsi itu didefinisikan
     oleh komponen modal. --}}
{{> components/ui/super_admin/modal/delete_confirm/index }}

<script>
  function editUserForm() {
    // Foto lama dari server; dipakai sebagai preview awal & saat user membatalkan
    // pilihan file baru. String kosong bila user belum punya foto.
    const originalPhoto = {{{json users.profile}}} || '';

    return {
      loading: false,

      // Role — urutan & label: Admin, Mentor, User
      roleOptions: [
        { value: 'super_admin', label: 'Admin' },
        { value: 'admin', label: 'Mentor' },
        { value: 'user', label: 'User' },
      ],

      // Status — sumber data tunggal: field `isVerified`
      statusOptions: [
        { value: 'true', label: 'Verified', dot: 'bg-[#22c55e]' },
        { value: 'false', label: 'Unverified', dot: 'bg-[#718096]' },
      ],

      // Profile photo — di halaman Edit preview terisi foto user yang ada
      previewUrl: originalPhoto || null,
      errorMessage: '',
      isValid: true,
      fileName: '',
      hasFile: false,

      // Nilai awal form = data user dari controller (populated state)
      formData: {
        username: {{{json users.username}}} || '',
        email: {{{json users.email}}} || '',
        role: {{{json users.role}}} || '',
        isVerified: {{#if users.isVerified}}'true'{{else}}'false'{{/if}},
      },
      formErrors: { username: '', email: '', role: '', isVerified: '' },
      // Error hanya ditampilkan setelah field disentuh atau setelah submit ditekan
      touched: { username: false, email: false, role: false, isVerified: false },

      validateImage(file) {
        this.clearPreview();

        if (!file) return;

        this.hasFile = true;
        this.fileName = file.name;

        const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
        if (!allowedTypes.includes(file.type)) {
          this.setImageError('Only JPG and PNG formats are allowed');
          return;
        }

        const maxSize = 5 * 1024 * 1024;
        if (file.size > maxSize) {
          this.setImageError(
            `File size too large (${(file.size / 1024 / 1024).toFixed(2)} MB). Maximum 5 MB`,
          );
          return;
        }

        const img = new Image();
        const objectUrl = URL.createObjectURL(file);

        img.onload = () => {
          if (img.width < 300 || img.width > 2000 || img.height < 300 || img.height > 2000) {
            URL.revokeObjectURL(objectUrl);
            this.setImageError(
              `Image is ${img.width}x${img.height}px. Required: 300x300 to 2000x2000 pixels`,
            );
            return;
          }

          this.objectUrl = objectUrl;
          this.previewUrl = objectUrl;
          this.isValid = true;
          this.errorMessage = '';
        };

        img.onerror = () => {
          URL.revokeObjectURL(objectUrl);
          this.setImageError('Failed to load image');
        };

        img.src = objectUrl;
      },

      objectUrl: null,

      setImageError(message) {
        this.errorMessage = message;
        this.isValid = false;
        // Tetap tampilkan foto lama agar kartu tidak terlihat kosong saat error
        this.previewUrl = originalPhoto || null;
      },

      // Reset ke kondisi awal halaman Edit: foto lama, bukan kosong.
      clearPreview() {
        if (this.objectUrl) {
          URL.revokeObjectURL(this.objectUrl);
          this.objectUrl = null;
        }
        this.previewUrl = originalPhoto || null;
        this.errorMessage = '';
        this.isValid = true;
        this.fileName = '';
        this.hasFile = false;
      },

      clearFile() {
        this.clearPreview();
        this.$refs.fileInput.value = null;
      },

      validateField(field, value) {
        const val = (value ?? '').toString();
        this.formData[field] = val;
        this.formErrors[field] = this.touched[field] ? this.errorFor(field, val) : '';
      },

      errorFor(field, val) {
        switch (field) {
          case 'username':
            if (!val.trim()) return 'Username is required.';
            if (val.trim().length < 3) return 'Username must be at least 3 characters.';
            return '';

          case 'email': {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return emailRegex.test(val.trim()) ? '' : 'Please enter a valid work email.';
          }

          case 'role':
            return val ? '' : 'Please select a role.';

          case 'isVerified':
            return val ? '' : 'Please select a status.';

          default:
            return '';
        }
      },

      touch(field) {
        this.touched[field] = true;
        this.validateField(field, this.formData[field]);
      },

      validateAll() {
        Object.keys(this.formData).forEach((field) => {
          this.touched[field] = true;
          this.formErrors[field] = this.errorFor(field, this.formData[field]);
        });
      },

      hasFormErrors() {
        return Object.values(this.formErrors).some((error) => error !== '');
      },

      canSubmit() {
        const imageValid = !this.hasFile || this.isValid;
        return imageValid && !this.hasFormErrors();
      },

      // Arahkan user ke masalah pertama: foto profil dulu (pesannya di luar grid field),
      // baru field form sesuai urutan.
      focusFirstInvalid() {
        if (this.hasFile && !this.isValid) {
          this.$refs.fileInput.parentElement.querySelector('button')?.focus();
          return;
        }

        const firstInvalid = Object.keys(this.formErrors).find((f) => this.formErrors[f]);
        if (!firstInvalid) return;

        const target =
          document.getElementById(`${firstInvalid}-trigger`) ||
          document.getElementById(firstInvalid);
        target?.focus();
      },

      // Tombol Save Changes selalu aktif; validasi dijalankan di sini.
      // Bila ada field kosong/tidak valid, form tidak dikirim dan pesan merah muncul.
      submitForm(event) {
        this.validateAll();
        if (!this.canSubmit()) {
          this.focusFirstInvalid();
          return;
        }

        this.loading = true;
        event.target.submit();
      },
    };
  }
</script>
