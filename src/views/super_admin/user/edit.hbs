<div class="py-10">
  <div class="max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg" x-data="{
    username: '{{users.username}}',
    email: '{{users.email}}',
    role: '{{users.role}}',
    previewUrl: null,
    oldPhoto: '{{#if users.profile}}{{users.profile}}{{else}}/images/default-avatar.png{{/if}}',
    errors: { username: null, email: null, role: null },
    success: { username: false, email: false, role: false },
    validateUsername() {
      if (!this.username.trim()) {
        this.errors.username = 'Username is required';
        this.success.username = false;
      } else if (this.username.trim().length < 3) {
        this.errors.username = 'Username must be at least 3 characters';
        this.success.username = false;
      } else {
        this.errors.username = null;
        this.success.username = true;
      }
    },
    validateEmail() {
      if (!this.email.trim()) {
        this.errors.email = 'Email is required';
        this.success.email = false;
      } else {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(this.email)) {
          this.errors.email = 'Please enter a valid email address';
          this.success.email = false;
        } else {
          this.errors.email = null;
          this.success.email = true;
        }
      }
    },
    validateRole() {
      if (!this.role) {
        this.errors.role = 'Please select a role';
        this.success.role = false;
      } else {
        this.errors.role = null;
        this.success.role = true;
      }
    },
    get canSubmit() {
      return this.success.username && this.success.email && this.success.role;
    }
  }">
    <h2 class="text-2xl font-semibold mb-6 text-gray-900">Edit User</h2>

    <form action="/users/super_admin/{{users.id}}?_method=PATCH" method="post" class="space-y-6" enctype="multipart/form-data" @submit.prevent="if(!canSubmit) return false">

<div 
  x-data="{ 
    previewUrl: null, 
    oldPhoto: '{{#if users.profile}}{{users.profile}}{{else}}/images/default-avatar.png{{/if}}' 
  }" 
  class="space-y-3"
>
  <label for="profile" class="block text-sm font-semibold text-gray-700 mb-1">
    Photos Profile
  </label>

  <!-- Input file -->
  <input 
    type="file" 
    id="profile" 
    name="profile" 
    accept="image/*" 
    x-ref="fileInput"
    class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700"
    @change="previewUrl = $event.target.files[0] ? URL.createObjectURL($event.target.files[0]) : null"
  >

  <!-- Tampilkan foto lama atau preview baru -->
  <div class="relative w-32 h-32">
    <img 
      :src="previewUrl ? previewUrl : oldPhoto" 
      alt="Preview Photo" 
      class="w-32 h-32 object-cover rounded-lg border border-gray-300"
    >

    <!-- Tombol hapus foto baru -->
    <template x-if="previewUrl">
      <button 
        type="button" 
        class="absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center shadow hover:bg-red-600"
        @click="previewUrl = null; $refs.fileInput.value = null;">
        &times;
      </button>
    </template>
  </div>
</div>

      <div>
        <label for="username" class="block text-sm font-semibold text-gray-700 mb-1">Username</label>
        <input 
          x-model="username"
          @input="validateUsername()"
          type="text" 
          id="username" 
          name="username" 
          value="{{users.username}}"
          :class="errors.username ? 'border-red-500 focus:ring-red-500' : success.username ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class="w-full border bg-white text-gray-900 rounded-lg px-4 py-2 focus:outline-none focus:ring-2">
        <p x-show="errors.username" x-text="errors.username" class="mt-1 text-sm text-red-600"></p>
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
        <input 
          x-model="email"
          @input="validateEmail()"
          type="email" 
          id="email" 
          name="email" 
          value="{{users.email}}"
          :class="errors.email ? 'border-red-500 focus:ring-red-500' : success.email ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class="w-full border bg-white text-gray-900 rounded-lg px-4 py-2 focus:outline-none focus:ring-2">
        <p x-show="errors.email" x-text="errors.email" class="mt-1 text-sm text-red-600"></p>
      </div>

      <div>
        <label for="role" class="block text-sm font-semibold text-gray-700 mb-1">Role</label>
        <select 
          x-model="role"
          @change="validateRole()"
          id="role" 
          name="role"
          :class="errors.role ? 'border-red-500 focus:ring-red-500' : success.role ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class="w-full border bg-white text-gray-900 rounded-lg px-4 py-2 focus:outline-none focus:ring-2">
          <option value="" disabled>-- Select Role --</option>
          <option value="admin">Admin</option>
          <option value="user">User</option>
          <option value="super_admin">Super Admin</option>
        </select>
        <p x-show="errors.role" x-text="errors.role" class="mt-1 text-sm text-red-600"></p>
      </div>

      <div class="flex space-x-4">
        <button 
          type="submit"
          :disabled="!canSubmit"
          :class="canSubmit ? 'bg-gray-900 hover:bg-gray-600' : 'bg-gray-400 cursor-not-allowed'"
          class="text-white px-6 py-2 rounded-lg shadow transition focus:outline-none focus:ring-2 focus:ring-gray-900">
          Update
        </button>
        <a href="/users"
          class="bg-white border border-gray-300 text-gray-900 px-6 py-2 rounded-lg shadow hover:bg-gray-100 transition focus:outline-none focus:ring-2 focus:ring-gray-900">
          Cancel
        </a>
      </div>

    </form>
  </div>
</div>
