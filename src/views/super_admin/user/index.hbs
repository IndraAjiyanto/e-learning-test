{{!--
  Halaman: Pengelolaan User — Super Admin
  Lokasi: src/views/super_admin/user/index.hbs
  Level: L4 Page

  - Sidebar sudah disediakan oleh layouts/main.hbs (offset lg:ml-[319px])

  Data: GET /users/filter → { data, totalItems, totalPages, currentPage }
  Status memakai field `isVerified`; kolom avatar memakai field `profile`.
--}}
<div
  class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'
  x-data='userTable()'
  x-init='fetchUsers()'
>
  <div class='flex flex-col gap-7'>
    
    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Users'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage program and their access to Kesatria Academy.'
      }}
    </div>

    <div class='flex flex-col gap-3.5'>
      {{> components/ui/super_admin/table/toolbar }}
      {{#> components/ui/super_admin/table/card tableClass='min-w-[1052px]'}}
        <colgroup>
          <col class='w-[88px]' />
          <col class='w-[297px]' />
          <col class='w-[297px]' />
          <col class='w-[120px]' />
          <col class='w-[135px]' />
          <col class='w-[116px]' />
        </colgroup>
        <thead>
          <tr>
            {{> components/ui/super_admin/table/header_cell label='Profile' }}
            {{> components/ui/super_admin/table/header_cell label='Username' }}
            {{> components/ui/super_admin/table/header_cell label='Email address' }}
            {{> components/ui/super_admin/table/header_cell label='Role' }}
            {{> components/ui/super_admin/table/header_cell label='Status' }}
            {{> components/ui/super_admin/table/header_cell label='Action' }}
          </tr>
        </thead>
        <tbody>
          {{#> components/ui/super_admin/table/message_row show='loading' colspan='6'}}
            <i class='fas fa-spinner fa-spin text-xl'></i>
          {{/components/ui/super_admin/table/message_row}}

          <template x-for='(user, index) in (loading ? [] : users)' :key='user.id'>
            <tr class='transition-colors hover:bg-[#fafafa]'>
              {{#> components/ui/super_admin/table/cell}}
                {{> components/ui/super_admin/table/avatar
                  src='user.profile'
                  name='user.username'
                }}
              {{/components/ui/super_admin/table/cell}}

              {{> components/ui/super_admin/table/cell text='user.username' }}

              {{> components/ui/super_admin/table/cell text='user.email' }}

              {{#> components/ui/super_admin/table/cell}}
                {{> components/ui/super_admin/badge/index
                  text='roleLabel(user.role)'
                  class='bg-[#f9f5ff] text-[#6941c6]'
                }}
              {{/components/ui/super_admin/table/cell}}

              {{!-- Status — sumber data: `user.isVerified`, satu-satunya field penentu status. --}}
              {{#> components/ui/super_admin/table/cell}}
                {{> components/ui/super_admin/badge/index
                  dot=true
                  text='user.isVerified ? "Verified" : "Unverified"'
                  classExpr="user.isVerified ? 'bg-[#f0fdf4] text-[#15803d]' : 'bg-[#f1f1f1] text-[#718096]'"
                  dotClassExpr="user.isVerified ? 'bg-[#22c55e]' : 'bg-[#718096]'"
                }}
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell variant='action'}}
                {{> components/ui/super_admin/table/row_actions }}
              {{/components/ui/super_admin/table/cell}}
            </tr>
          </template>

          {{#> components/ui/super_admin/table/message_row show='!loading && users.length === 0' colspan='6'}}
            No users found.
          {{/components/ui/super_admin/table/message_row}}
        </tbody>
      {{/components/ui/super_admin/table/card}}
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index }}

{{> components/ui/super_admin/toast/success/index toast=toast }}

<script>
  function roleLabel(role) {
    switch (role) {
      case 'super_admin':
        return 'Admin';
      case 'admin':
        return 'Mentor';
      case 'user':
        return 'User';
      default:
        return role;
    }
  }

  function userTable() {
    return {
      users: [],
      searchInput: '',
      currentPage: 1,
      totalPages: 1,
      totalItems: 0,
      size: 10,
      loading: false,
      searchTimeout: null,

      async fetchUsers() {
        this.loading = true;
        try {
          const params = new URLSearchParams();
          if (this.searchInput.trim()) params.set('search', this.searchInput.trim());
          params.set('page', this.currentPage);
          params.set('limit', this.size);

          const res = await fetch(`/users/filter?${params.toString()}`);
          const json = await res.json();

          this.users = json.data;
          this.totalItems = json.totalItems;
          this.totalPages = json.totalPages;
          this.currentPage = json.currentPage;
        } catch (err) {
          console.error('Fetch users error:', err);
        } finally {
          this.loading = false;
        }
      },

      handleSearch() {
        clearTimeout(this.searchTimeout);
        this.searchTimeout = setTimeout(() => {
          this.currentPage = 1;
          this.fetchUsers();
        }, 300);
      },

      async changePage(page) {
        if (page < 1 || page > this.totalPages) return;
        this.currentPage = page;
        await this.fetchUsers();
      },
    }
  }
</script>
