<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        previewUrl: null,
        errorMessage: '',
        isValid: true,
        fileName: '',
        fileSize: 0,
        imageWidth: 0,
        imageHeight: 0,
        hasFile: false,

        // Form validation states
        formData: {
          username: '',
          email: '',
          password: '',
          role: ''
        },
        formErrors: {
          username: '',
          email: '',
          password: '',
          role: ''
        },
        formValid: {
          username: false,
          email: false,
          password: false,
          role: false
        },

        validateImage(file) {
          if (!file) {
            this.hasFile = false;
            return;
          }

          this.hasFile = true;
          this.fileName = file.name;
          this.fileSize = file.size;
          this.errorMessage = '';
          this.isValid = true;

          // Validasi tipe file
          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!allowedTypes.includes(file.type)) {
            this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
            this.isValid = false;
            this.previewUrl = null;
            return;
          }

          // Validasi ukuran file (5MB = 5242880 bytes)
          const maxSize = 5 * 1024 * 1024; // 5MB
          if (file.size > maxSize) {
            this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
            this.isValid = false;
            this.previewUrl = null;
            return;
          }

          // Validasi dimensi gambar
          const img = new Image();
          const objectUrl = URL.createObjectURL(file);

          img.onload = () => {
            this.imageWidth = img.width;
            this.imageHeight = img.height;

            if (img.width < 300 || img.width > 2000 || img.height < 300 || img.height > 2000) {
              this.errorMessage = `Image dimensions ${img.width}x${img.height}px. Required: 300x300 to 2000x2000 pixels`;
              this.isValid = false;
              this.previewUrl = null;
              URL.revokeObjectURL(objectUrl);
            } else {
              this.previewUrl = objectUrl;
              this.isValid = true;
              this.errorMessage = '';
            }
          };

          img.onerror = () => {
            this.errorMessage = 'Failed to load image';
            this.isValid = false;
            this.previewUrl = null;
            URL.revokeObjectURL(objectUrl);
          };

          img.src = objectUrl;
        },

        validateField(field, value) {
          this.formData[field] = value;

          switch(field) {
            case 'username':
              if (!value.trim()) {
                this.formErrors.username = 'Username is required';
                this.formValid.username = false;
              } else if (value.trim().length < 3) {
                this.formErrors.username = 'Username must be at least 3 characters';
                this.formValid.username = false;
              } else {
                this.formErrors.username = '';
                this.formValid.username = true;
              }
              break;

            case 'email':
              if (!value.trim()) {
                this.formErrors.email = 'Email is required';
                this.formValid.email = false;
              } else {
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(value)) {
                  this.formErrors.email = 'Please enter a valid email address';
                  this.formValid.email = false;
                } else {
                  this.formErrors.email = '';
                  this.formValid.email = true;
                }
              }
              break;

            case 'password':
              if (!value) {
                this.formErrors.password = 'Password is required';
                this.formValid.password = false;
              } else if (value.length < 6) {
                this.formErrors.password = 'Password must be at least 6 characters';
                this.formValid.password = false;
              } else {
                this.formErrors.password = '';
                this.formValid.password = true;
              }
              break;

            case 'role':
              if (!value) {
                this.formErrors.role = 'Please select a role';
                this.formValid.role = false;
              } else {
                this.formErrors.role = '';
                this.formValid.role = true;
              }
              break;
          }
        },

        clearFile() {
          this.previewUrl = null;
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '';
          this.fileSize = 0;
          this.imageWidth = 0;
          this.imageHeight = 0;
          this.hasFile = false;
          this.$refs.fileInput.value = null;
        },

        canSubmit() {
          const imageValid = !this.hasFile || this.isValid;
          const formValid = this.formValid.username && this.formValid.email && this.formValid.password && this.formValid.role;
          return imageValid && formValid;
        },

        hasFormErrors() {
          return Object.values(this.formErrors).some(error => error !== '');
        }
      }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create new users</h2>

    <form
      action='/users'
      method='post'
      class='space-y-6'
      x-data='{
        loading: false
      }'
      enctype='multipart/form-data'
      @submit.prevent="if (canSubmit()) { loading = true; $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

{{> super_admin/user/create/profile_input }}

      <!-- Form Fields Grid -->
      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>

        {{> super_admin/user/create/username_input }}
        {{> super_admin/user/create/email_input }}
        {{> super_admin/user/create/password_input }}
        {{> super_admin/user/create/role_input }}

      </div>

      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span
            x-show='loading'
            class='loading loading-spinner loading-sm'
          ></span>
          <span x-show='!loading'>Create</span>
        </button>
        <a
          href='/users'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors() || (hasFile && !isValid)'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>