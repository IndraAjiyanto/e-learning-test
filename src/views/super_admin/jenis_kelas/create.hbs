<div
  class='py-10'
  x-data="{
  // Form validation states
  formData: {
    nama_jenis_kelas: '',
    deskripsi: { id: '', en: '', ja: '' },
    icon: ''
  },
  formErrors: {
    nama_jenis_kelas: '',
    deskripsi: { id: '', en: '', ja: '' },
    icon: ''
  },
  formValid: {
    nama_jenis_kelas: false,
    deskripsi: { id: false, en: false, ja: false },
    icon: true
  },
  formTouched: {
    nama_jenis_kelas: false,
    deskripsi: { id: false, en: false, ja: false },
    icon: false
  },

  get computedClass() {
    const raw = (this.formData.icon || '').toString().trim();
    if (!raw) return 'fa-solid fa-circle-question';
    const v = raw;
    const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(v) || v.split(/\s+/).some(s => /^fa-/i.test(s));
    if (hasFaPrefix) {
      if (/^fa-\w+/i.test(v) && !/\s+/.test(v)) return 'fa-solid ' + v;
      return v;
    }
    if (!v.includes(' ')) return 'fa-solid fa-' + v;
    return v;
  },

  validateField(field, value, lang = null) {
    if (lang) {
      this.formData[field][lang] = value;
      this.formTouched[field][lang] = true;
    } else {
      this.formData[field] = value;
      this.formTouched[field] = true;
    }
    
    switch(field) {
      case 'nama_jenis_kelas':
        if (!value.trim()) {
          this.formErrors.nama_jenis_kelas = 'Class type name is required';
          this.formValid.nama_jenis_kelas = false;
        } else if (value.trim().length < 2) {
          this.formErrors.nama_jenis_kelas = 'Class type name must be at least 2 characters';
          this.formValid.nama_jenis_kelas = false;
        } else {
          this.formErrors.nama_jenis_kelas = '';
          this.formValid.nama_jenis_kelas = true;
        }
        break;
        
      case 'deskripsi':
        if (!value.trim()) {
          this.formErrors.deskripsi[lang] = 'Description is required';
          this.formValid.deskripsi[lang] = false;
        } else if (value.trim().length < 10) {
          this.formErrors.deskripsi[lang] = 'Description must be at least 10 characters';
          this.formValid.deskripsi[lang] = false;
        } else {
          this.formErrors.deskripsi[lang] = '';
          this.formValid.deskripsi[lang] = true;
        }
        break;
        
      case 'icon':
        // Icon is optional, no validation required
        this.formErrors.icon = '';
        this.formValid.icon = true;
        break;
    }
  },

  canSubmit() {
    const deskripsiValid = Object.values(this.formValid.deskripsi).every(v => v);
    return this.formValid.nama_jenis_kelas && deskripsiValid && this.formValid.icon;
  },

  hasFormErrors() {
    return this.formErrors.nama_jenis_kelas !== '' ||
           Object.values(this.formErrors.deskripsi).some(e => e !== '') ||
           this.formErrors.icon !== '';
  }
}"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mt-0 mb-6 text-center text-gray-900'>Create New Program
      Type</h2>

    <form
      action='/jenis-kelas'
      method='post'
      class='space-y-6'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; }'
    >

      <!-- Class Type Name -->
      <div class='space-y-2'>
        <label
          for='nama_jenis_kelas'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Class Type Name
        </label>
        <input
          x-model='formData.nama_jenis_kelas'
          @input='validateField("nama_jenis_kelas", $event.target.value)'
          type='text'
          id='nama_jenis_kelas'
          name='nama_jenis_kelas'
          required
          maxlength='255'
          :class="formErrors.nama_jenis_kelas ? 'border-red-500 focus:ring-red-500' : (formValid.nama_jenis_kelas ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          placeholder='Enter class type name'
        />

        <!-- Error Message -->
        <template x-if='formErrors.nama_jenis_kelas'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p
              class='text-xs text-red-700'
              x-text='formErrors.nama_jenis_kelas'
            ></p>
          </div>
        </template>

        <!-- Success Message -->
        <template
          x-if='formTouched.nama_jenis_kelas && formValid.nama_jenis_kelas && !formErrors.nama_jenis_kelas'
        >
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid</p>
          </div>
        </template>
      </div>

      <!-- Icon -->
      <div class='space-y-2'>
        <label
          for='icon'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Icon</label>
        <div class='flex items-center gap-4'>
          <input
            x-model='formData.icon'
            type='text'
            id='icon'
            name='icon'
            placeholder='code or fa-code or fa-solid fa-code'
            :class="formErrors.icon ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.icon ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
            @input='validateField("icon", $event.target.value)'
          />

          <div class='flex items-center gap-3'>
            <i :class='computedClass' class='text-2xl text-gray-700'></i>
            <span class='text-sm text-gray-500' x-text='computedClass'></span>
          </div>
        </div>

        <!-- Error Message -->
        <template x-if='formErrors.icon'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.icon'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.icon && !formErrors.icon'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid icon</p>
          </div>
        </template>

        <p class='text-sm text-gray-500 mt-2'>Type an icon name like
          <code>code</code>
          or
          <code>fa-code</code>. It will preview using Font Awesome 6 (e.g.
          <code>fa-solid fa-code</code>).</p>
      </div>

      <!-- Description per Bahasa -->
      <div class='space-y-4'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Description
        </label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.deskripsi.id'
              @input='validateField("deskripsi", $event.target.value, "id")'
              name='deskripsi[id]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.deskripsi.id ? 'border-red-500 focus:ring-red-500' : (formValid.deskripsi.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Deskripsi (ID)'
            ></textarea>
            <template x-if='formErrors.deskripsi.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.deskripsi.id'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.deskripsi.id && formValid.deskripsi.id && !formErrors.deskripsi.id'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.deskripsi.en'
              @input='validateField("deskripsi", $event.target.value, "en")'
              name='deskripsi[en]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.deskripsi.en ? 'border-red-500 focus:ring-red-500' : (formValid.deskripsi.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Description (EN)'
            ></textarea>
            <template x-if='formErrors.deskripsi.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.deskripsi.en'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.deskripsi.en && formValid.deskripsi.en && !formErrors.deskripsi.en'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.deskripsi.ja'
              @input='validateField("deskripsi", $event.target.value, "ja")'
              name='deskripsi[ja]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.deskripsi.ja ? 'border-red-500 focus:ring-red-500' : (formValid.deskripsi.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='説明 (JA)'
            ></textarea>
            <template x-if='formErrors.deskripsi.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.deskripsi.ja'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.deskripsi.ja && formValid.deskripsi.ja && !formErrors.deskripsi.ja'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Create
        </button>
        <a
          href='/jenis-kelas'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>

<!-- (Using inline x-data above for icon preview) -->

