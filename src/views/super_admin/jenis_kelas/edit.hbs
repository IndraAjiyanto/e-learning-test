<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
    nama_jenis_kelas: '{{jenis_kelas.nama_jenis_kelas}}',
    deskripsi: '{{jenis_kelas.deskripsi}}',
    icon: '{{jenis_kelas.icon}}',
    errors: {},
    success: {},
    get computedClass() {
      const raw = (this.icon || '').toString().trim();
      if (!raw) return 'fa-solid fa-circle-question';
      const v = raw;
      const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(v) || v.split(/\s+/).some(s => /^fa-/i.test(s));
      if (hasFaPrefix) {
        if (/^fa-\w+/i.test(v) && !/\s+/.test(v)) return 'fa-solid ' + v;
        return v;
      }
      if (!v.includes(' ')) return 'fa-solid fa-' + v;
      return v;
    },
    validateNamaJenisKelas() {
      if (!this.nama_jenis_kelas.trim()) {
        this.errors.nama_jenis_kelas = 'Class type name is required';
        this.success.nama_jenis_kelas = false;
      } else {
        delete this.errors.nama_jenis_kelas;
        this.success.nama_jenis_kelas = true;
      }
    },
    validateDeskripsi() {
      if (!this.deskripsi.trim()) {
        this.errors.deskripsi = 'Description is required';
        this.success.deskripsi = false;
      } else {
        delete this.errors.deskripsi;
        this.success.deskripsi = true;
      }
    },
    canSubmit() {
      return this.nama_jenis_kelas.trim() && this.deskripsi.trim() && Object.keys(this.errors).length === 0;
    }
  }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Update Class Type</h2>

    <form
      action='/jenis-kelas/{{jenis_kelas.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      @submit.prevent='if (!canSubmit()) return false'
    >

      <div>
        <label
          for='nama_jenis_kelas'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Class Type Name
        </label>
        <input
          x-model='nama_jenis_kelas'
          @input='validateNamaJenisKelas()'
          type='text'
          id='nama_jenis_kelas'
          name='nama_jenis_kelas'
          placeholder='e.g. Regular, Premium, Online'
          value='{{jenis_kelas.nama_jenis_kelas}}'
          :class="errors.nama_jenis_kelas ? 'border-red-500 focus:ring-red-500' : success.nama_jenis_kelas ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
        />
        <p
          x-show='errors.nama_jenis_kelas'
          x-text='errors.nama_jenis_kelas'
          class='mt-1 text-sm text-red-600'
        ></p>
      </div>

      <div>
        <label
          for='icon'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Icon</label>
        <div class='flex items-center gap-4'>
          <input
            x-model='icon'
            type='text'
            id='icon'
            name='icon'
            placeholder='code or fa-code or fa-solid fa-code'
            class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          />

          <div class='flex items-center gap-3'>
            <i :class='computedClass' class='text-2xl text-gray-700'></i>
            <span class='text-sm text-gray-500' x-text='computedClass'></span>
          </div>
        </div>
        <p class='text-sm text-gray-500 mt-2'>Type an icon name like
          <code>code</code>
          or
          <code>fa-code</code>. It will preview using Font Awesome 6 (e.g.
          <code>fa-solid fa-code</code>).</p>
      </div>

      <div>
        <label
          for='deskripsi'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Description</label>
        <textarea
          x-model='deskripsi'
          @input='validateDeskripsi()'
          id='deskripsi'
          name='deskripsi'
          rows='4'
          placeholder='Write a brief description...'
          :class="errors.deskripsi ? 'border-red-500 focus:ring-red-500' : success.deskripsi ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
        >{{jenis_kelas.deskripsi}}</textarea>
        <p
          x-show='errors.deskripsi'
          x-text='errors.deskripsi'
          class='mt-1 text-sm text-red-600'
        ></p>
      </div>

      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="canSubmit() ? 'bg-gray-900 hover:bg-gray-600' : 'bg-gray-400 cursor-not-allowed'"
          class='text-white px-6 py-2 rounded-lg shadow transition'
        >
          Update
        </button>
        <a
          href='/jenis-kelas'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition'
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>