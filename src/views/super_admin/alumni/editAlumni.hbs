<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        previewUrl: null,
        errorMessage: '',
        isValid: true,
        fileName: '',
        fileSize: 0,
        imageWidth: 0,
        imageHeight: 0,
        hasFile: false,
        existingImage: `{{alumni.profile}}`,

        searchKelas: `{{alumni.kelas.nama_kelas}}`,
        selectedKelas: `{{json alumni.kelas}}`,
        showKelasDropdown: false,
        availableKelas: `{{json kelas}}`,
        get filteredKelas() {
          return this.availableKelas.filter(k => 
            k.nama_kelas.toLowerCase().includes(this.searchKelas.toLowerCase())
          );
        },
        selectKelas(kelas) {
          this.selectedKelas = kelas;
          this.searchKelas = kelas.nama_kelas;
          this.showKelasDropdown = false;
        },
        clearKelas() {
          this.selectedKelas = null;
          this.searchKelas = '';
        },

        // Form validation states - diisi dengan data yang ada
        formData: {
          nama: { 
            id: `{{alumni.nama.id}}`, 
            en: `{{alumni.nama.en}}`, 
            ja: `{{alumni.nama.ja}}` 
          },
          pesan: { 
            id: `{{alumni.pesan.id}}`, 
            en: `{{alumni.pesan.en}}`, 
            ja: `{{alumni.pesan.ja}}` 
          },
          alumni: { 
            id: `{{alumni.alumni.id}}`, 
            en: `{{alumni.alumni.en}}`, 
            ja: `{{alumni.alumni.ja}}` 
          },
          posisi_sekarang: { 
            id: `{{alumni.posisi_sekarang.id}}`, 
            en: `{{alumni.posisi_sekarang.en}}`, 
            ja: `{{alumni.posisi_sekarang.ja}}` 
          }
        },
        formErrors: {
          nama: { id: '', en: '', ja: '' },
          pesan: { id: '', en: '', ja: '' },
          alumni: { id: '', en: '', ja: '' },
          posisi_sekarang: { id: '', en: '', ja: '' }
        },
        formValid: {
          nama: { id: false, en: false, ja: false },
          pesan: { id: false, en: false, ja: false },
          alumni: { id: false, en: false, ja: false },
          posisi_sekarang: { id: false, en: false, ja: false }
        },

        init() {
          // Validasi awal untuk field yang sudah ada
          Object.keys(this.formData).forEach(field => {
            Object.keys(this.formData[field]).forEach(lang => {
              if (this.formData[field][lang]) {
                this.validateField(field, lang, this.formData[field][lang]);
              }
            });
          });
          
          // Set preview URL untuk gambar yang sudah ada
          if (this.existingImage) {
            this.previewUrl = this.existingImage;
            this.hasFile = true;
          }
        },

        validateImage(file) {
          if (!file) {
            this.hasFile = !!this.existingImage;
            return;
          }

          this.hasFile = true;
          this.fileName = file.name;
          this.fileSize = file.size;
          this.errorMessage = '';
          this.isValid = true;

          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!allowedTypes.includes(file.type)) {
            this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
            this.isValid = false;
            this.previewUrl = this.existingImage; // Kembalikan ke gambar lama
            return;
          }

          const maxSize = 5 * 1024 * 1024;
          if (file.size > maxSize) {
            this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
            this.isValid = false;
            this.previewUrl = this.existingImage; // Kembalikan ke gambar lama
            return;
          }

          const img = new Image();
          const objectUrl = URL.createObjectURL(file);

          img.onload = () => {
            this.imageWidth = img.width;
            this.imageHeight = img.height;

            const minWidth = 300, maxWidth = 2000, minHeight = 300, maxHeight = 2000;
            if (this.imageWidth < minWidth || this.imageWidth > maxWidth ||
                this.imageHeight < minHeight || this.imageHeight > maxHeight) {
              this.errorMessage = `Image dimensions must be between ${minWidth}x${minHeight} and ${maxWidth}x${maxHeight} pixels. Current: ${this.imageWidth}x${this.imageHeight}`;
              this.isValid = false;
              this.previewUrl = this.existingImage; // Kembalikan ke gambar lama
              URL.revokeObjectURL(objectUrl);
              return;
            }

            this.previewUrl = objectUrl;
            this.isValid = true;
            this.errorMessage = '';
          };

          img.onerror = () => {
            this.errorMessage = 'Failed to load image';
            this.isValid = false;
            this.previewUrl = this.existingImage; // Kembalikan ke gambar lama
            URL.revokeObjectURL(objectUrl);
          };

          img.src = objectUrl;
        },

        validateField(field, lang, value) {
          this.formData[field][lang] = value;
          
          switch(field) {
            case 'nama':
              if (!value.trim()) {
                this.formErrors.nama[lang] = 'Name is required';
                this.formValid.nama[lang] = false;
              } else if (value.trim().length < 2) {
                this.formErrors.nama[lang] = 'Name must be at least 2 characters';
                this.formValid.nama[lang] = false;
              } else {
                this.formErrors.nama[lang] = '';
                this.formValid.nama[lang] = true;
              }
              break;
              
            case 'pesan':
              if (!value.trim()) {
                this.formErrors.pesan[lang] = 'Message is required';
                this.formValid.pesan[lang] = false;
              } else if (value.trim().length < 10) {
                this.formErrors.pesan[lang] = 'Message must be at least 10 characters';
                this.formValid.pesan[lang] = false;
              } else {
                this.formErrors.pesan[lang] = '';
                this.formValid.pesan[lang] = true;
              }
              break;
              
            case 'alumni':
              if (!value.trim()) {
                this.formErrors.alumni[lang] = 'Alumni status is required';
                this.formValid.alumni[lang] = false;
              } else if (value.trim().length < 2) {
                this.formErrors.alumni[lang] = 'Alumni status must be at least 2 characters';
                this.formValid.alumni[lang] = false;
              } else {
                this.formErrors.alumni[lang] = '';
                this.formValid.alumni[lang] = true;
              }
              break;
              
            case 'posisi_sekarang':
              if (!value.trim()) {
                this.formErrors.posisi_sekarang[lang] = 'Current position is required';
                this.formValid.posisi_sekarang[lang] = false;
              } else if (value.trim().length < 2) {
                this.formErrors.posisi_sekarang[lang] = 'Current position must be at least 2 characters';
                this.formValid.posisi_sekarang[lang] = false;
              } else {
                this.formErrors.posisi_sekarang[lang] = '';
                this.formValid.posisi_sekarang[lang] = true;
              }
              break;
          }
        },

        clearFile() {
          this.previewUrl = this.existingImage; // Kembalikan ke gambar lama
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '';
          this.fileSize = 0;
          this.imageWidth = 0;
          this.imageHeight = 0;
          this.hasFile = !!this.existingImage;
          if (this.$refs.fileInput) {
            this.$refs.fileInput.value = null;
          }
        },

        canSubmit() {
          const imageValid = !this.hasFile || this.isValid;
          const kelasValid = this.selectedKelas !== null;
          const namaValid = Object.values(this.formValid.nama).every(v => v);
          const pesanValid = Object.values(this.formValid.pesan).every(v => v);
          const alumniValid = Object.values(this.formValid.alumni).every(v => v);
          const posisiValid = Object.values(this.formValid.posisi_sekarang).every(v => v);
          return imageValid && kelasValid && namaValid && pesanValid && alumniValid && posisiValid;
        },

        hasFormErrors() {
          return Object.values(this.formErrors.nama).some(e => e !== '') || 
                 Object.values(this.formErrors.pesan).some(e => e !== '') ||
                 Object.values(this.formErrors.alumni).some(e => e !== '') ||
                 Object.values(this.formErrors.posisi_sekarang).some(e => e !== '');
        }
      }"
    @click.away='showKelasDropdown = false'
  >
    <h2 class='text-2xl font-semibold mt-0 mb-6 text-gray-900 text-center'>Edit Alumni</h2>

    <form
      action='/alumni/kategori/{{alumni.id}}/{{alumni.kelas.kategori.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      enctype='multipart/form-data'
      @submit.prevent="if (canSubmit()) { $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

      <!-- Hidden input untuk method PUT -->

      <!-- Kelas Dropdown -->
      <div class='space-y-3'>
        <label
          for='kelasId'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Program <span class='text-red-500'>*</span>
        </label>

        <div class='relative'>
          <input
            type='text'
            x-model='searchKelas'
            @focus='showKelasDropdown = true'
            @input='showKelasDropdown = true'
            placeholder='Search and select class...'
            :class="!selectedKelas ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 text-gray-700'
          />
          <i
            class='fas fa-search absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400'
          ></i>

          <!-- Dropdown -->
          <div
            x-show='showKelasDropdown && filteredKelas.length > 0'
            class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'
          >
            <template x-for='kelas in filteredKelas' :key='kelas.id'>
              <button
                type='button'
                @click='selectKelas(kelas)'
                class='w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition text-left border-b border-gray-100 last:border-0'
              >
                <span
                  class='text-sm font-medium text-gray-700'
                  x-text='kelas.nama_kelas'
                ></span>
              </button>
            </template>
          </div>

          <!-- Selected Kelas Badge -->
          <template x-if='selectedKelas'>
            <div class='mt-2 flex items-center gap-2 p-3 bg-green-50 border border-green-300 rounded-lg'>
              <i class='fas fa-check-circle text-green-500'></i>
              <span class='text-sm text-green-700 flex-1' x-text='selectedKelas.nama_kelas'></span>
              <button
                type='button'
                @click='clearKelas()'
                class='text-red-500 hover:text-red-700 transition'
              >
                <i class='fas fa-times-circle'></i>
              </button>
            </div>
          </template>

          <!-- Error when not selected -->
          <template x-if='!selectedKelas'>
            <div class='mt-2 flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'>
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700'>Please select a class</p>
            </div>
          </template>

          <input
            type='hidden'
            name='kelasId'
            x-model='selectedKelas ? selectedKelas.id : ""'
            required
          />
        </div>
      </div>

      <!-- Upload Image -->
      <div class='space-y-3'>
        <label
          for='profile'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Profile Photo
          <span class='text-xs text-gray-500 font-normal'>(max 5MB, JPEG/PNG only, 300x300 to 2000x2000px)</span>
          <br>
          <span class='text-xs text-gray-400'>Leave empty to keep current image</span>
        </label>

        <!-- Tampilkan gambar saat ini -->
        <template x-if='existingImage && !previewUrl'>
          <div class='mb-3'>
            <p class='text-sm text-gray-600 mb-2'>Current Image:</p>
            <div class='relative w-32 h-32'>
              <img
                :src='existingImage'
                alt='Current Profile'
                class='w-32 h-32 object-cover rounded-lg border border-gray-300'
              />
            </div>
          </div>
        </template>

        <input
          type='file'
          id='profile'
          name='profile'
          accept='image/*'
          x-ref='fileInput'
          :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-900 file:text-white hover:file:bg-gray-700 file:cursor-pointer'
          @change='validateImage($event.target.files[0])'
        />

        <!-- Error Message -->
        <template x-if='!isValid && errorMessage'>
          <div class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'>
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <div>
              <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
              <p class='text-xs text-red-700' x-text='errorMessage'></p>
            </div>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='hasFile && isValid && previewUrl !== existingImage'>
          <div class='space-y-2'>
            <div class='flex items-center justify-between p-3 bg-green-50 border border-green-300 rounded-lg'>
              <div class='flex items-center gap-2'>
                <i class='fas fa-check-circle text-green-500'></i>
                <div class='text-xs text-green-700'>
                  <span class='font-semibold'>Valid new image:</span>
                  <span x-text='`${fileName} (${(fileSize / 1024 / 1024).toFixed(2)}MB)`'></span>
                </div>
              </div>
              <button
                type='button'
                class='text-red-500 hover:text-red-700 transition-colors'
                @click='clearFile()'
                title='Remove new image'
              >
                <i class='fas fa-times-circle'></i>
              </button>
            </div>
          </div>
        </template>

        <!-- Preview Gambar Baru -->
        <template x-if='previewUrl && previewUrl !== existingImage'>
          <div class='space-y-2'>
            <p class='text-sm text-gray-600'>New Image Preview:</p>
            <div class='relative w-32 h-32'>
              <img
                :src='previewUrl'
                alt='New Profile Preview'
                class='w-32 h-32 object-cover rounded-lg border border-gray-300'
              />
              <button
                type='button'
                class='absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center shadow hover:bg-red-600'
                @click='clearFile()'
              >
                &times;
              </button>
            </div>
          </div>
        </template>
      </div>

      <!-- Name per Bahasa -->
      <div class='space-y-4'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>Name <span class='text-red-500'>*</span></label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <input
              x-model='formData.nama.id'
              @input='validateField("nama", "id", $event.target.value)'
              type='text'
              name='nama[id]'
              required
              maxlength='255'
              :class="formErrors.nama.id ? 'border-red-500 focus:ring-red-500' : (formValid.nama.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              placeholder='Nama (ID)'
            />
            <template x-if='formErrors.nama.id'>
              <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'>
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.nama.id'></p>
              </div>
            </template>
            <template x-if='formValid.nama.id && !formErrors.nama.id'>
              <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'>
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <input
              x-model='formData.nama.en'
              @input='validateField("nama", "en", $event.target.value)'
              type='text'
              name='nama[en]'
              required
              maxlength='255'
              :class="formErrors.nama.en ? 'border-red-500 focus:ring-red-500' : (formValid.nama.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              placeholder='Name (EN)'
            />
            <template x-if='formErrors.nama.en'>
              <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'>
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.nama.en'></p>
              </div>
            </template>
            <template x-if='formValid.nama.en && !formErrors.nama.en'>
              <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'>
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <input
              x-model='formData.nama.ja'
              @input='validateField("nama", "ja", $event.target.value)'
              type='text'
              name='nama[ja]'
              required
              maxlength='255'
              :class="formErrors.nama.ja ? 'border-red-500 focus:ring-red-500' : (formValid.nama.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              placeholder='名前 (JA)'
            />
            <template x-if='formErrors.nama.ja'>
              <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'>
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.nama.ja'></p>
              </div>
            </template>
            <template x-if='formValid.nama.ja && !formErrors.nama.ja'>
              <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'>
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Message -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Message</label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.pesan.id'
              @input='validateField("pesan", "id", $event.target.value)'
              name='pesan[id]'
              required
              rows='8'
              :class="formErrors.pesan.id ? 'border-red-500 focus:ring-red-500' : (formValid.pesan.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Pesan (ID)...'
            ></textarea>
            <template x-if='formErrors.pesan.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.pesan.id'
                ></p>
              </div>
            </template>
            <template x-if='formValid.pesan.id && !formErrors.pesan.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.pesan.en'
              @input='validateField("pesan", "en", $event.target.value)'
              name='pesan[en]'
              required
              rows='8'
              :class="formErrors.pesan.en ? 'border-red-500 focus:ring-red-500' : (formValid.pesan.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Message (EN)...'
            ></textarea>
            <template x-if='formErrors.pesan.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.pesan.en'
                ></p>
              </div>
            </template>
            <template x-if='formValid.pesan.en && !formErrors.pesan.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.pesan.ja'
              @input='validateField("pesan", "ja", $event.target.value)'
              name='pesan[ja]'
              required
              rows='8'
              :class="formErrors.pesan.ja ? 'border-red-500 focus:ring-red-500' : (formValid.pesan.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='メッセージ (JA)...'
            ></textarea>
            <template x-if='formErrors.pesan.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.pesan.ja'
                ></p>
              </div>
            </template>
            <template x-if='formValid.pesan.ja && !formErrors.pesan.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Alumni Status -->
