<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        previewUrl: null,
        errorMessage: '',
        isValid: true,
        fileName: '',
        fileSize: 0,
        imageWidth: 0,
        imageHeight: 0,
        hasFile: false,
        existingImage: `{{alumni.profile}}`,

        searchKelas: `{{alumni.course.name}}`,
        selectedKelas: {{json alumni.course}},
        showKelasDropdown: false,
        availableKelas: {{json course}},
        get filteredKelas() {
          return (Array.isArray(this.availableKelas) ? this.availableKelas : []).filter(k => 
            k.name.toLowerCase().includes(this.searchKelas.toLowerCase())
          );
        },
        selectKelas(course) {
          this.selectedKelas = course;
          this.searchKelas = course.name;
          this.showKelasDropdown = false;
        },
        clearKelas() {
          this.selectedKelas = null;
          this.searchKelas = '';
        },

        // Form validation states - diisi dengan data yang ada
        formData: {
          name: { 
            id: `{{alumni.name.id}}`, 
            en: `{{alumni.name.en}}`, 
            ja: `{{alumni.name.ja}}` 
          },
          message: { 
            id: `{{alumni.message.id}}`, 
            en: `{{alumni.message.en}}`, 
            ja: `{{alumni.message.ja}}` 
          },
          currentPosition: { 
            id: `{{alumni.currentPosition.id}}`, 
            en: `{{alumni.currentPosition.en}}`, 
            ja: `{{alumni.currentPosition.ja}}` 
          }
        },
        formErrors: {
          name: { id: '', en: '', ja: '' },
          message: { id: '', en: '', ja: '' },
          currentPosition: { id: '', en: '', ja: '' }
        },
        formValid: {
          name: { id: false, en: false, ja: false },
          message: { id: false, en: false, ja: false },
          currentPosition: { id: false, en: false, ja: false }
        },

        init() {
          // Validasi awal untuk field yang sudah ada
          Object.keys(this.formData).forEach(field => {
            Object.keys(this.formData[field]).forEach(lang => {
              if (this.formData[field][lang]) {
                this.validateField(field, lang, this.formData[field][lang]);
              }
            });
          });
          
          // Set preview URL untuk gambar yang sudah ada
          if (this.existingImage) {
            this.previewUrl = this.existingImage;
            this.hasFile = true;
          }
        },

        validateImage(file) {
          if (!file) {
            this.hasFile = !!this.existingImage;
            return;
          }

          this.hasFile = true;
          this.fileName = file.name;
          this.fileSize = file.size;
          this.errorMessage = '';
          this.isValid = true;

          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!allowedTypes.includes(file.type)) {
            this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
            this.isValid = false;
            this.previewUrl = this.existingImage; // Kembalikan ke gambar lama
            return;
          }

          const maxSize = 5 * 1024 * 1024;
          if (file.size > maxSize) {
            this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
            this.isValid = false;
            this.previewUrl = this.existingImage; // Kembalikan ke gambar lama
            return;
          }

          const img = new Image();
          const objectUrl = URL.createObjectURL(file);

          img.onload = () => {
            this.imageWidth = img.width;
            this.imageHeight = img.height;

            const minWidth = 300, maxWidth = 2000, minHeight = 300, maxHeight = 2000;
            if (this.imageWidth < minWidth || this.imageWidth > maxWidth ||
                this.imageHeight < minHeight || this.imageHeight > maxHeight) {
              this.errorMessage = `Image dimensions must be between ${minWidth}x${minHeight} and ${maxWidth}x${maxHeight} pixels. Current: ${this.imageWidth}x${this.imageHeight}`;
              this.isValid = false;
              this.previewUrl = this.existingImage; // Kembalikan ke gambar lama
              URL.revokeObjectURL(objectUrl);
              return;
            }

            this.previewUrl = objectUrl;
            this.isValid = true;
            this.errorMessage = '';
          };

          img.onerror = () => {
            this.errorMessage = 'Failed to load image';
            this.isValid = false;
            this.previewUrl = this.existingImage; // Kembalikan ke gambar lama
            URL.revokeObjectURL(objectUrl);
          };

          img.src = objectUrl;
        },

        validateField(field, lang, value) {
          this.formData[field][lang] = value;
          
          switch(field) {
            case 'name':
              if (!value.trim()) {
                this.formErrors.name[lang] = 'Name is required';
                this.formValid.name[lang] = false;
              } else if (value.trim().length < 2) {
                this.formErrors.name[lang] = 'Name must be at least 2 characters';
                this.formValid.name[lang] = false;
              } else {
                this.formErrors.name[lang] = '';
                this.formValid.name[lang] = true;
              }
              break;
              
            case 'message':
              if (!value.trim()) {
                this.formErrors.message[lang] = 'Message is required';
                this.formValid.message[lang] = false;
              } else if (value.trim().length < 10) {
                this.formErrors.message[lang] = 'Message must be at least 10 characters';
                this.formValid.message[lang] = false;
              } else {
                this.formErrors.message[lang] = '';
                this.formValid.message[lang] = true;
              }
              break;
              
            case 'currentPosition':
              if (!value.trim()) {
                this.formErrors.currentPosition[lang] = 'Current position is required';
                this.formValid.currentPosition[lang] = false;
              } else if (value.trim().length < 2) {
                this.formErrors.currentPosition[lang] = 'Current position must be at least 2 characters';
                this.formValid.currentPosition[lang] = false;
              } else {
                this.formErrors.currentPosition[lang] = '';
                this.formValid.currentPosition[lang] = true;
              }
              break;
          }
        },

        clearFile() {
          this.previewUrl = this.existingImage; // Kembalikan ke gambar lama
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '';
          this.fileSize = 0;
          this.imageWidth = 0;
          this.imageHeight = 0;
          this.hasFile = !!this.existingImage;
          if (this.$refs.fileInput) {
            this.$refs.fileInput.value = null;
          }
        },

        canSubmit() {
          const imageValid = !this.hasFile || this.isValid;
          const kelasValid = this.selectedKelas !== null;
          const namaValid = Object.values(this.formValid.name).every(v => v);
          const pesanValid = Object.values(this.formValid.message).every(v => v);
          const posisiValid = Object.values(this.formValid.currentPosition).every(v => v);
          return imageValid && kelasValid && namaValid && pesanValid && posisiValid;
        },

        hasFormErrors() {
          return Object.values(this.formErrors.name).some(e => e !== '') || 
                 Object.values(this.formErrors.message).some(e => e !== '') ||
                 Object.values(this.formErrors.currentPosition).some(e => e !== '');
        }
      }"
    @click.away='showKelasDropdown = false'
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Alumni</h2>

    <form
      action='/alumni/category/{{alumni.id}}/{{alumni.course.category.id}}?_method=PATCH'
      method='post'
      x-data="{loading: false}"
      class='space-y-6'
      enctype='multipart/form-data'
      @submit.prevent="if (canSubmit()) { loading = true; $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

    {{> super_admin/alumni/editAlumni/program_input }}

    {{> super_admin/alumni/editAlumni/image_input }}

{{> super_admin/alumni/editAlumni/name_input }}

{{> super_admin/alumni/editAlumni/message_input }}

{{> super_admin/alumni/editAlumni/current_position_input }}












      <!-- Tombol aksi -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
                    :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700 '"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
        <span x-show="loading" class="loading loading-spinner loading-sm"></span>
        <span x-show="!loading">Update</span>
        </button>
        <a
          href='/category/{{alumni.course.category.id}}'
        :disabled='loading'
        :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300  transition'>
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='!canSubmit()'>
        <div class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'>
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>