{{!--
  Halaman: Edit Alumni — Super Admin
  Lokasi: src/views/super_admin/alumni/editAlumni.hbs
  Level: L4 Page

  Route: GET /alumni/category/formEdit/:alumniId -> PATCH /alumni/category/:alumniId/:categoryId
  (multipart: profile opsional + courseId + name/message/currentPosition per bahasa).
  Data: { alumni, course }.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>
    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Alumni'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the alumni information displayed across Kesatria Academy.'
      }}
    </div>

    <form
      action='/alumni/category/{{alumni.id}}/{{alumni.course.category.id}}?_method=PATCH'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='alumniForm({ courses: {{json course}}, alumni: {{json alumni}} })'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white p-4 sm:p-5'
    >
      <div class='flex flex-col gap-5'>
        {{> components/ui/super_admin/form/alumni/fields }}

        <div class='flex flex-col-reverse gap-3 pt-6 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href=(concat '/category/' alumni.course.category.id)
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Save Changes'
            loading=true
            disabled='!canSubmit() || loading'
          }}
        </div>
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/alumni/form }}
