<div class='py-10'>
  <div
    class='max-w-4xl mx-auto px-8 py-10 bg-white rounded-xl shadow-lg'
    x-data="{ 
    previewUrl: null,
    errorMessage: '',
    isValid: true,
    fileName: '',
    fileSize: 0,
    imageWidth: 0,
    imageHeight: 0,
    hasFile: false,
    validateImage(file) {
      if (!file) {
        this.hasFile = false;
        return;
      }
      
      this.hasFile = true;
      this.fileName = file.name;
      this.fileSize = file.size;
      this.errorMessage = '';
      this.isValid = true;

      // Validasi tipe file
      const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
      if (!allowedTypes.includes(file.type)) {
        this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
        this.isValid = false;
        this.previewUrl = null;
        return;
      }

      // Validasi ukuran file (1MB = 1048576 bytes)
      const maxSize = 1 * 1024 * 1024; // 1MB
      if (file.size > maxSize) {
        this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 1MB`;
        this.isValid = false;
        this.previewUrl = null;
        return;
      }

      // Validasi dimensi gambar
      const img = new Image();
      const objectUrl = URL.createObjectURL(file);
      
      img.onload = () => {
        this.imageWidth = img.width;
        this.imageHeight = img.height;
        
        if (img.width < 300 || img.width > 500 || img.height < 300 || img.height > 500) {
          this.errorMessage = `Image dimensions ${img.width}x${img.height}px. Required: 300x300 to 500x500 pixels`;
          this.isValid = false;
          this.previewUrl = null;
          URL.revokeObjectURL(objectUrl);
        } else {
          this.previewUrl = objectUrl;
          this.isValid = true;
          this.errorMessage = '';
        }
      };
      
      img.onerror = () => {
        this.errorMessage = 'Failed to load image';
        this.isValid = false;
        this.previewUrl = null;
        URL.revokeObjectURL(objectUrl);
      };
      
      img.src = objectUrl;
    },
    clearFile() {
      this.previewUrl = null;
      this.errorMessage = '';
      this.isValid = true;
      this.fileName = '';
      this.fileSize = 0;
      this.imageWidth = 0;
      this.imageHeight = 0;
      this.hasFile = false;
      $refs.fileInput.value = null;
    },
    canSubmit() {
      // Jika ada file yang diupload, harus valid
      if (this.hasFile) {
        return this.isValid;
      }
      // Jika tidak ada file, tetap bisa submit (opsional)
      return true;
    }
  }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create Alumni</h2>

    <form
      action='/alumni'
      method='post'
      class='space-y-6'
      enctype='multipart/form-data'
      @submit.prevent="if(canSubmit()) { $el.submit(); } else { alert('Please fix image validation errors before submitting.'); }"
    >

      <!-- Grid for Left & Right -->
      <div class='grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10'>

        <!-- LEFT COLUMN -->
        <div class='space-y-6'>

          <!-- Profile Photo -->
          <div class='space-y-3'>
            <label
              for='profile'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >
              Profile Photo
              <span class='text-xs text-gray-500 font-normal'>(300x300 -
                500x500px, max 1MB, JPG/PNG)</span>
            </label>

            <input
              type='file'
              id='profile'
              name='profile'
              accept='image/jpeg,image/jpg,image/png'
              x-ref='fileInput'
              :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              @change='validateImage($event.target.files[0])'
            />

            <!-- Error Message -->
            <template x-if='!isValid && errorMessage'>
              <div
                class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <div>
                  <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
                  <p class='text-xs text-red-700' x-text='errorMessage'></p>
                </div>
              </div>
            </template>

            <!-- Preview with validation success -->
            <template x-if='previewUrl && isValid'>
              <div class='space-y-2'>
                <!-- Success Message -->
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <div class='text-xs text-green-700'>
                    <span class='font-semibold'>Valid image:</span>
                    <span
                      x-text='`${imageWidth}x${imageHeight}px, ${(fileSize / 1024).toFixed(1)}KB`'
                    ></span>
                  </div>
                </div>

                <!-- Image Preview -->
                <div class='relative w-32 h-32'>
                  <img
                    :src='previewUrl'
                    alt='Preview Photo'
                    class='w-32 h-32 object-cover rounded-lg border-2 border-green-500 shadow-sm'
                  />

                  <button
                    type='button'
                    class='absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center shadow hover:bg-red-600 transition-colors'
                    @click='clearFile()'
                  >
                    &times;
                  </button>
                </div>
              </div>
            </template>
          </div>

          <!-- Name -->
          <div>
            <label
              for='nama'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Name</label>
            <input
              type='text'
              id='nama'
              name='nama'
              class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
            />
          </div>

          <!-- Message -->
          <div>
            <label
              for='pesan'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Message</label>
            <textarea
              id='pesan'
              name='pesan'
              rows='4'
              class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
            ></textarea>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class='space-y-6'>

          <!-- Alumni Status -->
          <div>
            <label
              for='alumni'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Alumni Status</label>
            <input
              type='text'
              id='alumni'
              name='alumni'
              class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
            />
          </div>

          <!-- Current Position -->
          <div>
            <label
              for='posisi_sekarang'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Current Position</label>
            <input
              type='text'
              id='posisi_sekarang'
              name='posisi_sekarang'
              class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
            />
          </div>

          <!-- Class (relation) -->
          <div>
            <label
              for='kelasId'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Class</label>
            <select
              id='kelasId'
              name='kelasId'
              class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
            >
              <option value='' disabled selected>-- Select Class --</option>
              {{#each kelas}}
                <option value='{{id}}'>{{nama_kelas}}</option>
              {{/each}}
            </select>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class='flex gap-3 justify-end'>
        <button
          type='submit'
          :disabled='hasFile && !isValid'
          :class="hasFile && !isValid ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-600'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <i class='fas fa-plus'></i>
          Create
        </button>
        <a
          href='/alumni'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          <i class='fas fa-times'></i>
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFile && !isValid'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix the image validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>