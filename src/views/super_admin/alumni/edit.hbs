                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JA -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JA</label>
            <input
              x-model='formData.nama.ja'
              @input='validateField("nama", "ja", $event.target.value)'
