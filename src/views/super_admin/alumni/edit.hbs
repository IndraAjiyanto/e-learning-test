<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Alumni</h2>

    <form action='/alumni/{{alumni.id}}?_method=PATCH' method='post' 
          class='space-y-6' enctype='multipart/form-data'>

      <!-- Grid for Left & Right -->
      <div class='grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10'>
        
        <!-- LEFT COLUMN -->
        <div class='space-y-6'>

          <!-- Profile Photo -->
          <div
            x-data="{
              previewUrl: null,
              oldPhoto: '{{#if alumni.profile}}{{alumni.profile}}{{else}}/images/default-avatar.png{{/if}}',
              errorMessage: '',
              isValid: true,
              fileName: '',
              fileSize: 0,
              imageWidth: 0,
              imageHeight: 0,
              hasFile: false,
              validateImage(file) {
                if (!file) {
                  this.hasFile = false;
                  return;
                }

                this.hasFile = true;
                this.fileName = file.name;
                this.fileSize = file.size;
                this.errorMessage = '';
                this.isValid = true;

                const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
                if (!allowedTypes.includes(file.type)) {
                  this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
                  this.isValid = false;
                  this.previewUrl = null;
                  return;
                }

                const maxSize = 5 * 1024 * 1024; // 5MB
                if (file.size > maxSize) {
                  this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
                  this.isValid = false;
                  this.previewUrl = null;
                  return;
                }

                const img = new Image();
                const objectUrl = URL.createObjectURL(file);
                img.onload = () => {
                  this.imageWidth = img.width;
                  this.imageHeight = img.height;
                  if (img.width < 300 || img.width > 2000 || img.height < 300 || img.height > 2000) {
                    this.errorMessage = `Image dimensions ${img.width}x${img.height}px. Required: 300x300 to 2000x2000 pixels`;
                    this.isValid = false;
                    this.previewUrl = null;
                    URL.revokeObjectURL(objectUrl);
                  } else {
                    this.previewUrl = objectUrl;
                    this.isValid = true;
                    this.errorMessage = '';
                  }
                };
                img.onerror = () => {
                  this.errorMessage = 'Failed to load image';
                  this.isValid = false;
                  this.previewUrl = null;
                  URL.revokeObjectURL(objectUrl);
                };
                img.src = objectUrl;
              },
              clearFile() {
                this.previewUrl = null;
                this.errorMessage = '';
                this.isValid = true;
                this.fileName = '';
                this.fileSize = 0;
                this.imageWidth = 0;
                this.imageHeight = 0;
                this.hasFile = false;
                $refs.fileInput.value = null;
              }
            }"
            class='space-y-3'
          >
            <label for='profile' class='block text-sm font-semibold text-gray-700 mb-1'>
              Profile Photo
              <span class='text-xs text-gray-500 font-normal'>(300x300 - 2000x2000px, max 5MB, JPG/PNG)</span>
            </label>

            <!-- File input -->
            <input
              type='file'
              id='profile'
              name='profile'
              accept='image/jpeg,image/jpg,image/png'
              x-ref='fileInput'
              class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
              @change='validateImage($event.target.files[0])'
            />

            <!-- Error Message -->
            <template x-if='!isValid && errorMessage'>
              <div class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'>
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <div>
                  <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
                  <p class='text-xs text-red-700' x-text='errorMessage'></p>
                </div>
              </div>
            </template>

            <!-- Preview with validation success -->
            <template x-if='previewUrl && isValid'>
              <div class='space-y-2'>
                <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'>
                  <i class='fas fa-check-circle text-green-500'></i>
                  <div class='text-xs text-green-700'>
                    <span class='font-semibold'>Valid image:</span>
                    <span x-text='`${imageWidth}x${imageHeight}px, ${(fileSize / 1024 / 1024).toFixed(2)}MB`'></span>
                  </div>
                </div>

                <div class='relative w-32 h-32'>
                  <img :src='previewUrl' alt='Preview Photo' class='w-32 h-32 object-cover rounded-lg border-2 border-green-500 shadow-sm' />
                  <button type='button' class='absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center shadow hover:bg-red-600' @click='clearFile()'>&times;</button>
                </div>
              </div>
            </template>

            <!-- Tampilkan foto lama atau preview baru when not previewing -->
            <div class='relative w-32 h-32 mt-2' x-show='!previewUrl'>
              <img :src="oldPhoto" alt='Preview Photo' class='w-32 h-32 object-cover rounded-lg border border-gray-300' />
            </div>
          </div>

          <!-- Name -->
          <div>
            <label for='nama' class='block text-sm font-semibold text-gray-700 mb-1'>Name</label>
            <input type='text' id='nama' name='nama' 
                   value='{{alumni.nama}}'
                   class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 
                          focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'>
          </div>

          <!-- Message -->
          <div>
            <label for='pesan' class='block text-sm font-semibold text-gray-700 mb-1'>Message</label>
            <textarea id='pesan' name='pesan' rows='4' 
              class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 
                     focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'>{{alumni.pesan}}</textarea>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class='space-y-6'>

          <!-- Alumni Status -->
          <div>
            <label for='alumni' class='block text-sm font-semibold text-gray-700 mb-1'>Alumni Status</label>
            <input type='text' id='alumni' name='alumni' 
                   value='{{alumni.alumni}}'
                   class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 
                          focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'>
          </div>

          <!-- Current Position -->
          <div>
            <label for='posisi_sekarang' class='block text-sm font-semibold text-gray-700 mb-1'>Current Position</label>
            <input type='text' id='posisi_sekarang' name='posisi_sekarang' 
                   value='{{alumni.posisi_sekarang}}'
                   class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 
                          focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'>
          </div>

          <!-- Class (relation) -->
          <div>
            <label for='kelasId' class='block text-sm font-semibold text-gray-700 mb-1'>Class</label>
            <select id='kelasId' name='kelasId' 
              class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 
                     focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'>
              <option value='' disabled>-- Select Class --</option>
              {{#each kelas}}
              <option value='{{id}}' {{#if (eq ../alumni.kelasId id)}}selected{{/if}}>
                {{nama_kelas}}
              </option>
              {{/each}}
            </select>
          </div>
        </div>
      </div>

      <!-- Action buttons -->
      <div class='flex gap-3'>
        <button type='submit' 
          class='bg-gray-900 text-white px-6 py-2 rounded-lg shadow hover:bg-gray-600 transition flex items-center gap-2'>
          Update
        </button>
        <a href='/alumni'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition'>
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>
