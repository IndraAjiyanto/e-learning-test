              type='text'
              name='alumni[ja]'
              required
              maxlength='255'
              :class="formErrors.alumni.ja ? 'border-red-500 focus:ring-red-500' : (formValid.alumni.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              x-init='$el.value = formData.alumni.ja'
            />
            <template x-if='formErrors.alumni.ja'>
              <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'>
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.alumni.ja'></p>
              </div>
            </template>
            <template x-if='formValid.alumni.ja && !formErrors.alumni.ja'>
              <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'>
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Current Position per Bahasa -->
      <div class='space-y-4'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>Current Position</label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <input
              x-model='formData.posisi_sekarang.id'
              @input='validateField("posisi_sekarang", "id", $event.target.value)'
              type='text'
              name='posisi_sekarang[id]'
              required
              maxlength='255'
              :class="formErrors.posisi_sekarang.id ? 'border-red-500 focus:ring-red-500' : (formValid.posisi_sekarang.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
