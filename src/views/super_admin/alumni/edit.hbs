<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        previewUrl: null,
        oldPhoto: '{{#if alumni.profile}}{{alumni.profile}}{{else}}/images/default-avatar.png{{/if}}',
        errorMessage: '',
        isValid: true,
        fileName: '',
        fileSize: 0,
        imageWidth: 0,
        imageHeight: 0,
        hasFile: false,

        // Form validation states
        formData: {
          nama: { id: '{{alumni.nama.id}}', en: '{{alumni.nama.en}}', ja: '{{alumni.nama.ja}}' },
          pesan: { id: '{{alumni.pesan.id}}', en: '{{alumni.pesan.en}}', ja: '{{alumni.pesan.ja}}' },
          alumni: { id: '{{alumni.alumni.id}}', en: '{{alumni.alumni.en}}', ja: '{{alumni.alumni.ja}}' },
          posisi_sekarang: { id: '{{alumni.posisi_sekarang.id}}', en: '{{alumni.posisi_sekarang.en}}', ja: '{{alumni.posisi_sekarang.ja}}' }
        },
        formErrors: {
          nama: { id: '', en: '', ja: '' },
          pesan: { id: '', en: '', ja: '' },
          alumni: { id: '', en: '', ja: '' },
          posisi_sekarang: { id: '', en: '', ja: '' }
        },
        formValid: {
          nama: { id: true, en: true, ja: true },
          pesan: { id: true, en: true, ja: true },
          alumni: { id: true, en: true, ja: true },
          posisi_sekarang: { id: true, en: true, ja: true }
        },

        validateImage(file) {
          if (!file) {
            this.hasFile = false;
            return;
          }

          this.hasFile = true;
          this.fileName = file.name;
          this.fileSize = file.size;
          this.errorMessage = '';
          this.isValid = true;

          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!allowedTypes.includes(file.type)) {
            this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
            this.isValid = false;
            this.previewUrl = null;
            return;
          }

          const maxSize = 5 * 1024 * 1024; // 5MB
          if (file.size > maxSize) {
            this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
            this.isValid = false;
            this.previewUrl = null;
            return;
          }

          // Create preview with dimension validation (backend enforces 300-2000px width/height)
          const img = new Image();
          const objectUrl = URL.createObjectURL(file);

          img.onload = () => {
            this.imageWidth = img.width;
            this.imageHeight = img.height;

            // Check dimensions
            const minWidth = 300, maxWidth = 2000, minHeight = 300, maxHeight = 2000;
            if (this.imageWidth < minWidth || this.imageWidth > maxWidth ||
                this.imageHeight < minHeight || this.imageHeight > maxHeight) {
              this.errorMessage = `Image dimensions must be between ${minWidth}x${minHeight} and ${maxWidth}x${maxHeight} pixels. Current: ${this.imageWidth}x${this.imageHeight}`;
              this.isValid = false;
              this.previewUrl = null;
              URL.revokeObjectURL(objectUrl);
              return;
            }

            this.previewUrl = objectUrl;
            this.isValid = true;
            this.errorMessage = '';
          };

          img.onerror = () => {
            this.errorMessage = 'Failed to load image';
            this.isValid = false;
            this.previewUrl = null;
            URL.revokeObjectURL(objectUrl);
          };

          img.src = objectUrl;
        },

        validateField(field, lang, value) {
          this.formData[field][lang] = value;
          
          switch(field) {
            case 'nama':
              if (!value.trim()) {
                this.formErrors.nama[lang] = 'Name is required';
                this.formValid.nama[lang] = false;
              } else if (value.trim().length < 2) {
                this.formErrors.nama[lang] = 'Name must be at least 2 characters';
                this.formValid.nama[lang] = false;
              } else {
                this.formErrors.nama[lang] = '';
                this.formValid.nama[lang] = true;
              }
              break;
              
            case 'pesan':
              if (!value.trim()) {
                this.formErrors.pesan[lang] = 'Message is required';
                this.formValid.pesan[lang] = false;
              } else if (value.trim().length < 10) {
                this.formErrors.pesan[lang] = 'Message must be at least 10 characters';
                this.formValid.pesan[lang] = false;
              } else {
                this.formErrors.pesan[lang] = '';
                this.formValid.pesan[lang] = true;
              }
              break;
              
            case 'alumni':
              if (!value.trim()) {
                this.formErrors.alumni[lang] = 'Alumni status is required';
                this.formValid.alumni[lang] = false;
              } else if (value.trim().length < 2) {
                this.formErrors.alumni[lang] = 'Alumni status must be at least 2 characters';
                this.formValid.alumni[lang] = false;
              } else {
                this.formErrors.alumni[lang] = '';
                this.formValid.alumni[lang] = true;
              }
              break;
              
            case 'posisi_sekarang':
              if (!value.trim()) {
                this.formErrors.posisi_sekarang[lang] = 'Current position is required';
                this.formValid.posisi_sekarang[lang] = false;
              } else if (value.trim().length < 2) {
                this.formErrors.posisi_sekarang[lang] = 'Current position must be at least 2 characters';
                this.formValid.posisi_sekarang[lang] = false;
              } else {
                this.formErrors.posisi_sekarang[lang] = '';
                this.formValid.posisi_sekarang[lang] = true;
              }
              break;
          }
        },

        clearFile() {
          this.previewUrl = null;
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '';
          this.fileSize = 0;
          this.imageWidth = 0;
          this.imageHeight = 0;
          this.hasFile = false;
          this.$refs.fileInput.value = null;
        },

        canSubmit() {
          const imageValid = !this.hasFile || this.isValid;
          const namaValid = Object.values(this.formValid.nama).every(v => v);
          const pesanValid = Object.values(this.formValid.pesan).every(v => v);
          const alumniValid = Object.values(this.formValid.alumni).every(v => v);
          const posisiValid = Object.values(this.formValid.posisi_sekarang).every(v => v);
          return imageValid && namaValid && pesanValid && alumniValid && posisiValid;
        },

        hasFormErrors() {
          return Object.values(this.formErrors.nama).some(e => e !== '') || 
                 Object.values(this.formErrors.pesan).some(e => e !== '') ||
                 Object.values(this.formErrors.alumni).some(e => e !== '') ||
                 Object.values(this.formErrors.posisi_sekarang).some(e => e !== '');
        }
      }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Alumni</h2>

    <form action='/alumni/{{alumni.id}}/{{alumni.kelas.id}}?_method=PATCH' method='post' 
          class='space-y-6' enctype='multipart/form-data'
          @submit.prevent="if (canSubmit()) { $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }">

      <!-- Upload Image -->
      <div class='space-y-3'>
        <label for='profile' class='block text-sm font-semibold text-gray-700 mb-1'>
          Profile Photo
          <span class='text-xs text-gray-500 font-normal'>(max 5MB, JPEG/PNG only, 300x300 to 2000x2000px)</span>
        </label>

        <!-- File input -->
        <input
          type='file'
          id='profile'
          name='profile'
          accept='image/*'
          x-ref='fileInput'
          :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : isValid && hasFile ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-900 file:text-white hover:file:bg-gray-700 file:cursor-pointer'
          @change='validateImage($event.target.files[0])'
        />

        <!-- Error Message -->
        <template x-if='!isValid && errorMessage'>
          <div class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'>
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <div>
              <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
              <p class='text-xs text-red-700' x-text='errorMessage'></p>
            </div>
          </div>
        </template>

        <!-- Preview with validation success -->
        <template x-if='previewUrl && isValid'>
          <div class='space-y-2'>
            <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'>
              <i class='fas fa-check-circle text-green-500'></i>
              <div class='text-xs text-green-700'>
                <span class='font-semibold'>Valid image:</span>
                <span x-text='`${imageWidth}x${imageHeight}px, ${(fileSize / 1024 / 1024).toFixed(2)}MB`'></span>
              </div>
            </div>

            <div class='relative w-32 h-32'>
              <img :src='previewUrl' alt='Preview Photo' class='w-32 h-32 object-cover rounded-lg border-2 border-green-500 shadow-sm' />
              <button type='button' class='absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center shadow hover:bg-red-600' @click='clearFile()'>&times;</button>
            </div>
          </div>
        </template>

        <!-- Tampilkan foto lama atau preview baru when not previewing -->
        <div class='relative w-32 h-32 mt-2' x-show='!previewUrl'>
          <img :src="oldPhoto" alt='Preview Photo' class='w-32 h-32 object-cover rounded-lg border border-gray-300' />
        </div>
      </div>

