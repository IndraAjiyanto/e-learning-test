{{!--
  Halaman: Edit Alumni (per Program) — Super Admin
  Lokasi: src/views/super_admin/alumni/edit.hbs
  Level: L4 Page

  Route: GET /alumni/formEdit/:alumniId -> PATCH /alumni/:alumniId/:courseId
  (multipart: profile opsional + name/message/currentPosition per bahasa).
  Data: { alumni }.

  courseId diambil dari alumni yang diedit, jadi field Program disembunyikan.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>
    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Alumni'
      }}

      {{> components/ui/super_admin/description/index
        text='Adjust the information below to edit this alumni testimonial.'
      }}
    </div>

    <form
      action='/alumni/{{alumni.id}}/{{alumni.course.id}}?_method=PATCH'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='{ ...alumniForm({ alumni: {{json alumni}} }), ...formDirtyGate() }'
      x-init='$nextTick(() => captureBaseline())'
      @input='recomputeDirty()'
      @change='recomputeDirty()'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white p-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-5'
    >
      <div class='flex flex-col gap-6'>
        {{> components/ui/super_admin/form/alumni/fields hideProgram=true }}

        {{> components/ui/super_admin/form/button
          row=true
          disabled='!canSubmit() || !isDirty || loading'
          cancelHref=(concat '/program/detail/program/admin/' alumni.course.id)
          submitLabel='Save Changes'
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/alumni/form }}
