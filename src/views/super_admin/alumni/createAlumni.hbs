{{!--
  Halaman: Create Alumni — Super Admin
  Lokasi: src/views/super_admin/alumni/createAlumni.hbs
  Level: L4 Page

  Route: GET /alumni/category/formCreate/:categoryId -> POST /alumni/create/:categoryId
  (multipart: profile + courseId + name/message/currentPosition per bahasa).
  Data: { categoryId, course }.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>
    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Alumni'
      }}

      {{> components/ui/super_admin/description/index
        text='Add an alumni testimonial to a program in this category.'
      }}
    </div>

    <form
      action='/alumni/create/{{categoryId}}'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='alumniForm({ courses: {{json course}} })'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white p-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-5'
    >
      <div class='flex flex-col gap-6'>
        {{> components/ui/super_admin/form/alumni/fields }}

        {{> components/ui/super_admin/form/button
          row=true
          cancelHref=(concat '/category/' categoryId)
          submitLabel='Create Alumni'
          disabled='!canSubmit() || loading'
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/alumni/form }}
