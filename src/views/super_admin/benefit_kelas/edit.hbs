<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        // Form validation states
        formData: {
          benefit: {
            id: `{{benefit_kelas.benefit.id}}`,
            en: `{{benefit_kelas.benefit.en}}`,
            ja: `{{benefit_kelas.benefit.ja}}`
          },
          isi: {
            id: `{{benefit_kelas.isi.id}}`,
            en: `{{benefit_kelas.isi.en}}`,
            ja: `{{benefit_kelas.isi.ja}}`
          },
          icon: `{{benefit_kelas.icon}}`
        },
        formErrors: {
          benefit: { id: '', en: '', ja: '' },
          isi: { id: '', en: '', ja: '' },
          icon: ''
        },
        formValid: {
          benefit: { id: true, en: true, ja: true },
          isi: { id: true, en: true, ja: true },
          icon: true
        },

        get computedClass() {
          const raw = (this.formData.icon || '').toString().trim();
          if (!raw) return 'fa-solid fa-circle-question';
          const v = raw;
          const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(v) || v.split(/\s+/).some(s => /^fa-/i.test(s));
          if (hasFaPrefix) {
            if (/^fa-\w+/i.test(v) && !/\s+/.test(v)) return 'fa-solid ' + v;
            return v;
          }
          if (!v.includes(' ')) return 'fa-solid fa-' + v;
          return v;
        },

        validateField(field, lang, value) {
          if (lang) {
            this.formData[field][lang] = value;
          } else {
            this.formData[field] = value;
          }
          
          switch(field) {
            case 'benefit':
              if (!value.trim()) {
                this.formErrors.benefit[lang] = 'Benefit title is required';
                this.formValid.benefit[lang] = false;
              } else if (value.trim().length < 3) {
                this.formErrors.benefit[lang] = 'Benefit title must be at least 3 characters';
                this.formValid.benefit[lang] = false;
              } else {
                this.formErrors.benefit[lang] = '';
                this.formValid.benefit[lang] = true;
              }
              break;
              
            case 'isi':
              if (!value.trim()) {
                this.formErrors.isi[lang] = 'Description is required';
                this.formValid.isi[lang] = false;
              } else if (value.trim().length < 10) {
                this.formErrors.isi[lang] = 'Description must be at least 10 characters';
                this.formValid.isi[lang] = false;
              } else {
                this.formErrors.isi[lang] = '';
                this.formValid.isi[lang] = true;
              }
              break;
              
            case 'icon':
              if (!value.trim()) {
                this.formErrors.icon = 'Icon is required';
                this.formValid.icon = false;
              } else if (value.trim().length < 2) {
                this.formErrors.icon = 'Icon must be at least 2 characters';
                this.formValid.icon = false;
              } else {
                this.formErrors.icon = '';
                this.formValid.icon = true;
              }
              break;
          }
        },

        canSubmit() {
          return this.formValid.benefit.id && this.formValid.benefit.en && this.formValid.benefit.ja &&
                 this.formValid.isi.id && this.formValid.isi.en && this.formValid.isi.ja &&
                 this.formValid.icon;
        },

        hasFormErrors() {
          return (this.formErrors.benefit.id || this.formErrors.benefit.en || this.formErrors.benefit.ja ||
                  this.formErrors.isi.id || this.formErrors.isi.en || this.formErrors.isi.ja ||
                  this.formErrors.icon) !== '';
        }
      }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Benefit Class</h2>

    <form
      action='/benefit-program/{{benefit_kelas.id}}/{{benefit_kelas.kelas.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      x-data="{ loading: false }"
      @submit.prevent="if (canSubmit()) { loading = true; $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

    {{> super_admin/benefit_program/edit/icon_input }}
    {{> super_admin/benefit_program/edit/tittle_input }}
{{> super_admin/benefit_program/edit/description_input }}

      <!-- Action Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span x-show="loading" class="loading loading-spinner loading-sm"></span>
          <span x-show="!loading">Update</span>
        </button>
        <a
          href='/kelass/detail/kelas/admin/{{benefit_kelas.kelas.id}}'
            :disabled='loading'
        :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300  transition'>
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>