<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        // Form validation states
        formData: {
          benefit: { id: '', en: '', ja: '' },
          isi: { id: '', en: '', ja: '' },
          icon: ''
        },
        formErrors: {
          benefit: { id: '', en: '', ja: '' },
          isi: { id: '', en: '', ja: '' },
          icon: ''
        },
        formValid: {
          benefit: { id: false, en: false, ja: false },
          isi: { id: false, en: false, ja: false },
          icon: false
        },

        get computedClass() {
          const raw = (this.formData.icon || '').toString().trim();
          if (!raw) return 'fa-solid fa-circle-question';
          const v = raw;
          const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(v) || v.split(/\s+/).some(s => /^fa-/i.test(s));
          if (hasFaPrefix) {
            if (/^fa-\w+/i.test(v) && !/\s+/.test(v)) return 'fa-solid ' + v;
            return v;
          }
          if (!v.includes(' ')) return 'fa-solid fa-' + v;
          return v;
        },

        validateField(field, lang, value) {
          if (field === 'icon') {
            this.formData.icon = value;
            if (!value.trim()) {
              this.formErrors.icon = 'Icon is required';
              this.formValid.icon = false;
            } else if (value.trim().length < 2) {
              this.formErrors.icon = 'Icon must be at least 2 characters';
              this.formValid.icon = false;
            } else {
              this.formErrors.icon = '';
              this.formValid.icon = true;
            }
          } else {
            this.formData[field][lang] = value;
            
            switch(field) {
              case 'benefit':
                if (!value.trim()) {
                  this.formErrors.benefit[lang] = 'Benefit title is required';
                  this.formValid.benefit[lang] = false;
                } else if (value.trim().length < 3) {
                  this.formErrors.benefit[lang] = 'Benefit title must be at least 3 characters';
                  this.formValid.benefit[lang] = false;
                } else {
                  this.formErrors.benefit[lang] = '';
                  this.formValid.benefit[lang] = true;
                }
                break;
                
              case 'isi':
                if (!value.trim()) {
                  this.formErrors.isi[lang] = 'Description is required';
                  this.formValid.isi[lang] = false;
                } else if (value.trim().length < 10) {
                  this.formErrors.isi[lang] = 'Description must be at least 10 characters';
                  this.formValid.isi[lang] = false;
                } else {
                  this.formErrors.isi[lang] = '';
                  this.formValid.isi[lang] = true;
                }
                break;
            }
          }
        },

        canSubmit() {
          return this.formValid.icon && 
                 Object.values(this.formValid.benefit).every(v => v) && 
                 Object.values(this.formValid.isi).every(v => v);
        },

        hasFormErrors() {
          return this.formErrors.icon !== '' || 
                 Object.values(this.formErrors.benefit).some(e => e !== '') || 
                 Object.values(this.formErrors.isi).some(e => e !== '');
        }
      }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create New Benefit
      Class</h2>

    <form
      action='/benefit-kelas/{{kelasId}}'
      method='POST'
      class='space-y-6'
      @submit.prevent="if (canSubmit()) { $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

      <!-- Icon -->
      <div class='space-y-2'>
        <label
          for='icon'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Icon
        </label>
        <div class='flex items-center gap-4'>
          <input
            x-model='formData.icon'
            @input='validateField("icon", null, $event.target.value)'
            type='text'
            id='icon'
            name='icon'
            placeholder='fa-code, fa-layer-group, etc.'
            :class="formErrors.icon ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.icon ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          />

          <!-- Live preview: binds computed class to the <i> element -->
          <div class='flex items-center gap-3'>
            <i :class='computedClass' class='text-2xl text-gray-700'></i>
            <span class='text-sm text-gray-500' x-text='computedClass'></span>
          </div>
        </div>

        <!-- Error Message -->
        <template x-if='formErrors.icon'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.icon'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.icon && !formErrors.icon'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid icon</p>
          </div>
        </template>

        <p class='text-sm text-gray-500 mt-2'>Type a Font Awesome class like
          <code>fa-code</code>
          or include full classes like
          <code>fas fa-code</code>.</p>
      </div>

      <!-- Benefit Title per Bahasa -->
      <div class='space-y-4'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Benefit Title
        </label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <input
              x-model='formData.benefit.id'
              @input='validateField("benefit", "id", $event.target.value)'
              type='text'
              name='benefit[id]'
              required
              :class="formErrors.benefit.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.benefit.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              placeholder='Judul benefit (ID)'
            />

            <!-- Error Message -->
            <template x-if='formErrors.benefit.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.benefit.id'
                ></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.benefit.id && !formErrors.benefit.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid title</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <input
              x-model='formData.benefit.en'
              @input='validateField("benefit", "en", $event.target.value)'
              type='text'
              name='benefit[en]'
              required
              :class="formErrors.benefit.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.benefit.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              placeholder='Benefit title (EN)'
            />

            <!-- Error Message -->
            <template x-if='formErrors.benefit.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.benefit.en'
                ></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.benefit.en && !formErrors.benefit.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid title</p>
              </div>
            </template>
          </div>

          <!-- JA -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JA</label>
            <input
              x-model='formData.benefit.ja'
              @input='validateField("benefit", "ja", $event.target.value)'
              type='text'
              name='benefit[ja]'
              required
              :class="formErrors.benefit.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.benefit.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              placeholder='ベネフィットタイトル (JA)'
            />

            <!-- Error Message -->
            <template x-if='formErrors.benefit.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.benefit.ja'
                ></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.benefit.ja && !formErrors.benefit.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>タイトルが有効です</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Description per Bahasa -->
      <div class='space-y-4'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Description
        </label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.isi.id'
              @input='validateField("isi", "id", $event.target.value)'
              name='isi[id]'
              rows='5'
              required
              :class="formErrors.isi.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.isi.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Deskripsi benefit (ID)'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.isi.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.isi.id'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.isi.id && !formErrors.isi.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid description</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.isi.en'
              @input='validateField("isi", "en", $event.target.value)'
              name='isi[en]'
              rows='5'
              required
              :class="formErrors.isi.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.isi.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Benefit description (EN)'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.isi.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.isi.en'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.isi.en && !formErrors.isi.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid description</p>
              </div>
            </template>
          </div>

          <!-- JA -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JA</label>
            <textarea
              x-model='formData.isi.ja'
              @input='validateField("isi", "ja", $event.target.value)'
              name='isi[ja]'
              rows='5'
              required
              :class="formErrors.isi.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.isi.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='ベネフィット説明 (JA)'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.isi.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.isi.ja'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.isi.ja && !formErrors.isi.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>説明が有効です</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Create
        </button>
        <a
          href='/kelass/detail/kelas/admin/{{kelasId}}'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>