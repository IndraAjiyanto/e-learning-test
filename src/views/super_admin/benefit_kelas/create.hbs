<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        // Form validation states
        formData: {
          benefit: '',
          isi: '',
          icon: ''
        },
        formErrors: {
          benefit: '',
          isi: '',
          icon: ''
        },
        formValid: {
          benefit: false,
          isi: false,
          icon: false
        },

        get computedClass() {
          const raw = (this.formData.icon || '').toString().trim();
          if (!raw) return 'fa-solid fa-circle-question';
          const v = raw;
          const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(v) || v.split(/\s+/).some(s => /^fa-/i.test(s));
          if (hasFaPrefix) {
            if (/^fa-\w+/i.test(v) && !/\s+/.test(v)) return 'fa-solid ' + v;
            return v;
          }
          if (!v.includes(' ')) return 'fa-solid fa-' + v;
          return v;
        },

        validateField(field, value) {
          this.formData[field] = value;
          
          switch(field) {
            case 'benefit':
              if (!value.trim()) {
                this.formErrors.benefit = 'Benefit title is required';
                this.formValid.benefit = false;
              } else if (value.trim().length < 3) {
                this.formErrors.benefit = 'Benefit title must be at least 3 characters';
                this.formValid.benefit = false;
              } else {
                this.formErrors.benefit = '';
                this.formValid.benefit = true;
              }
              break;
              
            case 'isi':
              if (!value.trim()) {
                this.formErrors.isi = 'Description is required';
                this.formValid.isi = false;
              } else if (value.trim().length < 10) {
                this.formErrors.isi = 'Description must be at least 10 characters';
                this.formValid.isi = false;
              } else {
                this.formErrors.isi = '';
                this.formValid.isi = true;
              }
              break;
              
            case 'icon':
              if (!value.trim()) {
                this.formErrors.icon = 'Icon is required';
                this.formValid.icon = false;
              } else if (value.trim().length < 2) {
                this.formErrors.icon = 'Icon must be at least 2 characters';
                this.formValid.icon = false;
              } else {
                this.formErrors.icon = '';
                this.formValid.icon = true;
              }
              break;
          }
        },

        canSubmit() {
          return this.formValid.benefit && this.formValid.isi && this.formValid.icon;
        },

        hasFormErrors() {
          return Object.values(this.formErrors).some(error => error !== '');
        }
      }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create New Benefit
      Class</h2>

    <form
      action='/benefit-kelas/{{kelasId}}'
      method='POST'
      class='space-y-6'
      @submit.prevent="if (canSubmit()) { $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

      <!-- Icon -->
      <div class='space-y-2'>
        <label
          for='icon'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Icon
        </label>
        <div class='flex items-center gap-4'>
          <input
            x-model='formData.icon'
            @input='validateField("icon", $event.target.value)'
            type='text'
            id='icon'
            name='icon'
            placeholder='fa-code, fa-layer-group, etc.'
            :class="formErrors.icon ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.icon ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          />

          <!-- Live preview: binds computed class to the <i> element -->
          <div class='flex items-center gap-3'>
            <i :class='computedClass' class='text-2xl text-gray-700'></i>
            <span class='text-sm text-gray-500' x-text='computedClass'></span>
          </div>
        </div>

        <!-- Error Message -->
        <template x-if='formErrors.icon'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.icon'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.icon && !formErrors.icon'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid icon</p>
          </div>
        </template>

        <p class='text-sm text-gray-500 mt-2'>Type a Font Awesome class like
          <code>fa-code</code>
          or include full classes like
          <code>fas fa-code</code>.</p>
      </div>

      <!-- Benefit Title -->
      <div class='space-y-2'>
        <label
          for='benefit'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Benefit Title
        </label>
        <input
          x-model='formData.benefit'
          @input='validateField("benefit", $event.target.value)'
          type='text'
          id='benefit'
          name='benefit'
          required
          :class="formErrors.benefit ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.benefit ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          placeholder='e.g. Lifetime Access, Certificate, Mentoring Support'
        />

        <!-- Error Message -->
        <template x-if='formErrors.benefit'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.benefit'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.benefit && !formErrors.benefit'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid title</p>
          </div>
        </template>
      </div>

      <!-- Description (Full Width) -->
      <div class='space-y-2'>
        <label for='isi' class='block text-sm font-semibold text-gray-700 mb-1'>
          Description
        </label>
        <textarea
          x-model='formData.isi'
          @input='validateField("isi", $event.target.value)'
          id='isi'
          name='isi'
          rows='5'
          required
          :class="formErrors.isi ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.isi ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
          placeholder='Describe the benefit in detail...'
        ></textarea>

        <!-- Error Message -->
        <template x-if='formErrors.isi'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.isi'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.isi && !formErrors.isi'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid description</p>
          </div>
        </template>
      </div>

      <!-- Action Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Create
        </button>
        <a
          href='/kelass/detail/kelas/admin/{{kelasId}}'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>