{{!--
  Halaman: Team Members — Super Admin
  Lokasi: src/views/super_admin/team/index.hbs
  Level: L4 Page

  Data: GET /team → { team }. Kolom `position` dan `description` berbentuk jsonb
  per-bahasa { id, en, ja } — bentuk yang dikirim form create/edit dan yang dibaca
  halaman publik lewat getByLang, bukan array meski entity menyebut string[].
  Search & pagination dijalankan di client lewat clientTable(), karena controller
  sudah mengirim seluruh baris sekaligus (tidak ada endpoint filter).

  `lang` hidup di scope Alpine bersarang: getter `rows` dan `totalPages`
  milik clientTable() akan hilang bila state digabung.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Team Members'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage the team members displayed on the About page of Kesatria Academy.'
      }}
    </div>

    <div
      class='flex flex-col gap-3.5'
      x-data='clientTable({ items: {{json team}}, searchKeys: ["name", "position.id", "position.en", "position.ja", "description.id", "description.en", "description.ja", "instagram", "linkedin"] })'
    >
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search team..'
        searchLabel='Search team'
        createHref='/team/formCreate'
        createLabel='Create Team Member'
      }}

      <div
        class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
        x-data="{ lang: 'id' }"
      >
        <div class='flex flex-col gap-5'>

          {{> components/ui/super_admin/tabs/language/index ariaLabel='Team language' }}

          {{#> components/ui/super_admin/table/card tableClass='min-w-[1310px]'}}
            <colgroup>
              <col class='w-[66px]' />
              <col class='w-[88px]' />
              <col class='w-[180px]' />
              <col class='w-[200px]' />
              <col class='w-[300px]' />
              <col class='w-[180px]' />
              <col class='w-[180px]' />
              <col class='w-[116px]' />
            </colgroup>
            <thead>
              <tr>
                {{> components/ui/super_admin/table/header_cell label='No' }}
                {{> components/ui/super_admin/table/header_cell label='Profile' }}
                {{> components/ui/super_admin/table/header_cell label='Name' }}
                {{> components/ui/super_admin/table/header_cell label='Position' }}
                {{> components/ui/super_admin/table/header_cell label='Description' }}
                {{> components/ui/super_admin/table/header_cell label='Instagram' }}
                {{> components/ui/super_admin/table/header_cell label='Linkedin' }}
                {{> components/ui/super_admin/table/header_cell label='Action' }}
              </tr>
            </thead>
            <tbody>
              <template x-for='(row, index) in rows' :key='row.id'>
                <tr class='transition-colors hover:bg-[#fafafa]'>

                  {{> components/ui/super_admin/table/cell
                    text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
                  }}

                  {{#> components/ui/super_admin/table/cell}}
                    {{> components/ui/super_admin/table/avatar
                      src='row.profile'
                      name='row.name'
                    }}
                  {{/components/ui/super_admin/table/cell}}

                  {{> components/ui/super_admin/table/cell text='row.name || "—"' }}

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='line-clamp-2 font-inter text-sm leading-5 text-[#525252]'
                      x-text="(row.position && row.position[lang]) || '—'"
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='line-clamp-2 font-inter text-sm leading-5 text-[#525252]'
                      x-text="(row.description && row.description[lang]) || '—'"
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    {{> components/ui/super_admin/table/link href='row.instagram' }}
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    {{> components/ui/super_admin/table/link href='row.linkedin' }}
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell variant='action'}}
                    {{> components/ui/super_admin/table/row_actions
                      entity='team member'
                      deleteAction="'/team/' + row.id + '?_method=DELETE'"
                      editHref="'/team/formEdit/' + row.id"
                    }}
                  {{/components/ui/super_admin/table/cell}}
                </tr>
              </template>

              {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='8'}}
                No team members found.
              {{/components/ui/super_admin/table/message_row}}
            </tbody>
          {{/components/ui/super_admin/table/card}}
        </div>
      </div>
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Team Member?'
  description='Are you sure you want to delete this team member? This action will permanently remove their profile and cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}
