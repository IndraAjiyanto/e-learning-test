{{!--
  Halaman: Edit Team Member — Super Admin
  Lokasi: src/views/super_admin/team/edit.hbs
  Level: L4 Page

  Route: GET /team/formEdit/:id -> PATCH /team/:id (multipart + _method override).
  Foto hanya diganti bila user mengunggah yang baru; tanpa itu controller
  mempertahankan `team.profile` yang tersimpan.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Team Member'
      }}

      {{> components/ui/super_admin/description/index
        text='Update this team member as shown on the About page of Kesatria Academy.'
      }}
    </div>

    <form
      action='/team/{{team.id}}?_method=PATCH'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='teamForm({ team: {{json team}} })'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-5'
    >
      <div class='flex flex-col gap-5'>
        {{> components/ui/super_admin/form/team/fields }}

        {{> components/ui/super_admin/form/button
          row=true
          cancelHref='/team'
          submitLabel='Save Changes'
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/team/form }}
