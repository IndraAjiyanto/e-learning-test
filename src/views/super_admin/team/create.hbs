<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        previewUrl: null,
        errorMessage: '',
        isValid: true,
        fileName: '',
        fileSize: 0,
        hasFile: false,
        cropper: null,
        showCropModal: false,
        tempImageUrl: null,
        croppedBlob: null,

        formData: {
          nama: '',
          posisi: {id: '', en: '', ja: ''},
          linkedin: '',
          instagram: '',
          deskripsi: { id: '', en: '', ja: '' }
        },
        formErrors: {
          nama: '',
          posisi: {id: '', en: '', ja: ''},
          linkedin: '',
          instagram: '',
          deskripsi: { id: '', en: '', ja: '' }
        },
        formValid: {
          nama: false,
          posisi: {id: false, en: false, ja: false},
          linkedin: false,
          instagram: true,
          deskripsi: { id: true, en: true, ja: true }
        },

        validateImage(file) {
          if (!file) {
            this.hasFile = false;
            return;
          }

          this.fileName = file.name;
          this.fileSize = file.size;
          this.errorMessage = '';
          this.isValid = true;

          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!allowedTypes.includes(file.type)) {
            this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
            this.isValid = false;
            return;
          }

          const maxSize = 5 * 1024 * 1024;
          if (file.size > maxSize) {
            this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
            this.isValid = false;
            return;
          }

          // Open crop modal
          this.tempImageUrl = URL.createObjectURL(file);
          this.showCropModal = true;
          
          this.$nextTick(() => {
            this.initCropper();
          });
        },

        initCropper() {
          const image = document.getElementById('cropImage');
          if (this.cropper) {
            this.cropper.destroy();
          }
          
          this.cropper = new Cropper(image, {
            aspectRatio: 1,
            viewMode: 1,
            dragMode: 'move',
            autoCropArea: 0.8,
            restore: false,
            guides: false,
            center: true,
            highlight: false,
            cropBoxMovable: true,
            cropBoxResizable: true,
            toggleDragModeOnDblclick: false,
            ready() {
              const cropper = this.cropper;
              const containerData = cropper.getContainerData();
              const cropBoxData = cropper.getCropBoxData();
              
              // Make crop box circular
              const cropBox = cropper.cropBox;
              cropBox.querySelector('.cropper-view-box').style.borderRadius = '50%';
              cropBox.querySelector('.cropper-face').style.borderRadius = '50%';
            }
          });
        },

        async applyCrop() {
          if (!this.cropper) return;

          const canvas = this.cropper.getCropBoxData();
          this.cropper.getCroppedCanvas({
            width: 400,
            height: 400,
            imageSmoothingEnabled: true,
            imageSmoothingQuality: 'high',
          }).toBlob((blob) => {
            this.croppedBlob = blob;
            this.previewUrl = URL.createObjectURL(blob);
            this.hasFile = true;
            this.closeCropModal();
          }, 'image/jpeg', 0.9);
        },

        closeCropModal() {
          this.showCropModal = false;
          if (this.cropper) {
            this.cropper.destroy();
            this.cropper = null;
          }
          if (this.tempImageUrl) {
            URL.revokeObjectURL(this.tempImageUrl);
            this.tempImageUrl = null;
          }
          this.$refs.fileInput.value = null;
        },

        validateField(field, value, lang = null) {
          if (lang) {
            // Multi-language field
            this.formData[field][lang] = value;
          } else {
            // Single language field
            this.formData[field] = value;
          }
          
          switch(field) {
            case 'nama':
              if (!value.trim()) {
                this.formErrors.nama = 'Name is required';
                this.formValid.nama = false;
              } else if (value.trim().length < 2) {
                this.formErrors.nama = 'Name must be at least 2 characters';
                this.formValid.nama = false;
              } else {
                this.formErrors.nama = '';
                this.formValid.nama = true;
              }
              break;
              
            case 'posisi':
              if (!value.trim()) {
                this.formErrors.posisi[lang] = 'Position is required';
                this.formValid.posisi[lang] = false;
              } else if (value.trim().length < 2) {
                this.formErrors.posisi[lang] = 'Position must be at least 2 characters';
                this.formValid.posisi[lang] = false;
              } else {
                this.formErrors.posisi[lang] = '';
                this.formValid.posisi[lang] = true;
              }
              break;
              
            case 'linkedin':
              if (!value.trim()) {
                this.formErrors.linkedin = 'LinkedIn URL is required';
                this.formValid.linkedin = false;
              } else {
                const urlPattern = /^https?:\/\/(www\.)?linkedin\.com\/.+/;
                if (!urlPattern.test(value)) {
                  this.formErrors.linkedin = 'Please enter a valid LinkedIn URL';
                  this.formValid.linkedin = false;
                } else {
                  this.formErrors.linkedin = '';
                  this.formValid.linkedin = true;
                }
              }
              break;
              
            case 'instagram':
              this.formErrors.instagram = '';
              this.formValid.instagram = true;
              break;
              
            case 'deskripsi':
              this.formErrors.deskripsi[lang] = '';
              this.formValid.deskripsi[lang] = true;
              break;
          }
        },

        clearFile() {
          this.previewUrl = null;
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '';
          this.fileSize = 0;
          this.hasFile = false;
          this.croppedBlob = null;
          this.$refs.fileInput.value = null;
        },

        canSubmit() {
          const imageValid = !this.hasFile || this.isValid;
          const posisiValid = Object.values(this.formValid.posisi).every(v => v);
          const formValid = this.formValid.nama && posisiValid && this.formValid.linkedin;
          return imageValid && formValid;
        },

        hasFormErrors() {
          const posisiErrors = Object.values(this.formErrors.posisi).some(e => e !== '');
          const otherErrors = this.formErrors.nama !== '' || posisiErrors || 
                             this.formErrors.linkedin !== '';
          return otherErrors;
        },

        async handleSubmit(e) {
          if (!this.canSubmit()) {
            e.preventDefault();
            alert('Please fix all validation errors before submitting.');
            return;
          }

          // If there's a cropped image, convert blob to file and update input
          if (this.croppedBlob) {
            e.preventDefault();
            
            // Create a new File from the cropped blob
            const file = new File([this.croppedBlob], this.fileName, { 
              type: this.croppedBlob.type 
            });
            
            // Create a new DataTransfer to set the file input
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);
            this.$refs.fileInput.files = dataTransfer.files;
            
            // Now submit the form normally
            e.target.submit();
          }
          // If no cropped image, form will submit normally (we don't prevent default)
        }
      }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create New Team</h2>

    <form
      action='/team'
      method='post'
      class='space-y-6'
      x-data='{loading: false}'
      enctype='multipart/form-data'
      @submit='handleSubmit; if (!canSubmit()) { $event.preventDefault(); return false; } loading = true;'
    >
      <!-- Upload Section -->
      <div class='space-y-3'>
        <label
          for='profile'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Profile Photo
          <span class='text-xs text-gray-500 font-normal'>(max 5MB, JPEG/PNG
            only)</span>
        </label>
        <input
          type='file'
          id='profile'
          name='profile'
          accept='image/*'
          x-ref='fileInput'
          :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-900 file:text-white hover:file:bg-gray-700 file:cursor-pointer'
          @change='validateImage($event.target.files[0])'
        />

        <!-- Error Message -->
        <template x-if='!isValid && errorMessage'>
          <div
            class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <div>
              <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
              <p class='text-xs text-red-700' x-text='errorMessage'></p>
            </div>
          </div>
        </template>

        <!-- Success Message with File Info -->
        <template x-if='hasFile && isValid'>
          <div class='space-y-2'>
            <div
              class='flex items-center justify-between p-3 bg-green-50 border border-green-300 rounded-lg'
            >
              <div class='flex items-center gap-2'>
                <i class='fas fa-check-circle text-green-500'></i>
                <div class='text-xs text-green-700'>
                  <span class='font-semibold'>Image cropped and ready</span>
                </div>
              </div>
              <button
                type='button'
                class='text-red-500 hover:text-red-700 transition-colors'
                @click='clearFile()'
                title='Remove image'
              >
                <i class='fas fa-times-circle'></i>
              </button>
            </div>
          </div>
        </template>

        <!-- Preview -->
        <template x-if='previewUrl'>
          <div class='relative w-32 h-32'>
            <img
              :src='previewUrl'
              alt='Preview Profile'
              class='w-32 h-32 object-cover rounded-full border-2 border-gray-300 circular-preview'
            />
            <button
              type='button'
              class='absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center shadow hover:bg-red-600'
              @click='clearFile()'
            >
              &times;
            </button>
          </div>
        </template>
      </div>

      <!-- Form Fields Grid -->
      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
        <!-- Name -->
        <div class='space-y-2'>
          <label
            for='nama'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Name</label>
          <input
            type='text'
            id='nama'
            name='nama'
            required
            :class="formErrors.nama ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.nama ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
            @input='validateField("nama", $event.target.value)'
          />
          <template x-if='formErrors.nama'>
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.nama'></p>
            </div>
          </template>
          <template x-if='formValid.nama && !formErrors.nama'>
            <div
              class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500'></i>
              <p class='text-xs text-green-700'>Valid name</p>
            </div>
          </template>
        </div>

        <!-- Position -->
        <div class='space-y-4'>
          <label
            for='posisi'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Position</label>
          <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
            <div class='space-y-2'>
              <label class='block text-xs font-medium text-gray-600'>ID</label>
              <input
                x-model='formData.posisi.id'
                @input='validateField("posisi", $event.target.value, "id")'
                type='text'
                name='posisi[id]'
                required
                :class="formErrors.posisi.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.posisi.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              />
              <template x-if='formErrors.posisi.id'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.posisi.id'
                  ></p>
                </div>
              </template>
              <template x-if='formValid.posisi.id && !formErrors.posisi.id'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid position</p>
                </div>
              </template>
            </div>
            <div class='space-y-2'>
              <label class='block text-xs font-medium text-gray-600'>EN</label>
              <input
                x-model='formData.posisi.en'
                @input='validateField("posisi", $event.target.value, "en")'
                type='text'
                name='posisi[en]'
                required
                :class="formErrors.posisi.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.posisi.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              />
              <template x-if='formErrors.posisi.en'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.posisi.en'
                  ></p>
                </div>
              </template>
              <template x-if='formValid.posisi.en && !formErrors.posisi.en'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid position</p>
                </div>
              </template>
            </div>
            <div class='space-y-2'>
              <label class='block text-xs font-medium text-gray-600'>JP</label>

              <input
                x-model='formData.posisi.ja'
                @input='validateField("posisi", $event.target.value, "ja")'
                type='text'
                name='posisi[ja]'
                required
                :class="formErrors.posisi.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.posisi.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              />
              <template x-if='formErrors.posisi.ja'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.posisi.ja'
                  ></p>
                </div>
              </template>
              <template x-if='formValid.posisi.ja && !formErrors.posisi.ja'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid position</p>
                </div>
              </template>
            </div>
          </div>
        </div>

        <!-- LinkedIn -->
        <div class='space-y-2'>
          <label
            for='linkedin'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >LinkedIn URL</label>
          <input
            type='url'
            id='linkedin'
            name='linkedin'
            required
            placeholder='https://linkedin.com/in/username'
            :class="formErrors.linkedin ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.linkedin ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
            @input='validateField("linkedin", $event.target.value)'
          />
          <template x-if='formErrors.linkedin'>
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.linkedin'></p>
            </div>
          </template>
          <template x-if='formValid.linkedin && !formErrors.linkedin'>
            <div
              class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500'></i>
              <p class='text-xs text-green-700'>Valid LinkedIn URL</p>
            </div>
          </template>
        </div>

        <!-- Instagram -->
        <div class='space-y-2'>
          <label
            for='instagram'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >
            Instagram URL
            <span class='text-xs text-gray-500 font-normal'>(optional)</span>
          </label>
          <input
            type='url'
            id='instagram'
            name='instagram'
            placeholder='https://instagram.com/username'
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
            @input='validateField("instagram", $event.target.value)'
          />
          <template x-if='formErrors.instagram'>
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.instagram'></p>
            </div>
          </template>
        </div>
      </div>

      <!-- Description per Bahasa -->
      <div class='space-y-4'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Description
        </label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.deskripsi.id'
              @input='validateField("deskripsi", $event.target.value, "id")'
              name='deskripsi[id]'
              rows='4'
              :class="formErrors.deskripsi.id ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Deskripsi (ID)...'
            ></textarea>
            <template x-if='formErrors.deskripsi.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.deskripsi.id'
                ></p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.deskripsi.en'
              @input='validateField("deskripsi", $event.target.value, "en")'
              name='deskripsi[en]'
              rows='4'
              :class="formErrors.deskripsi.en ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Description (EN)...'
            ></textarea>
            <template x-if='formErrors.deskripsi.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.deskripsi.en'
                ></p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.deskripsi.ja'
              @input='validateField("deskripsi", $event.target.value, "ja")'
              name='deskripsi[ja]'
              rows='4'
              :class="formErrors.deskripsi.ja ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='説明 (JP)...'
            ></textarea>
            <template x-if='formErrors.deskripsi.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.deskripsi.ja'
                ></p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span
            x-show='loading'
            class='loading loading-spinner loading-sm'
          ></span>
          <span x-show='!loading'>Create</span>
        </button>
        <a
          href='/team'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors() || (hasFile && !isValid)'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>

    <!-- Crop Modal -->
    <div
      x-show='showCropModal'
      x-cloak
      class='fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4'
      @click.self='closeCropModal()'
    >
      <div
        class='bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-hidden'
      >
        <div class='p-6 border-b border-gray-200'>
          <h3 class='text-xl font-semibold text-gray-900'>Crop Profile Photo</h3>
          <p class='text-sm text-gray-600 mt-1'>Adjust the cropping area to fit
            your image</p>
