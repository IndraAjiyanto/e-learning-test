<div
  class='py-10 w-full mx-auto px-6'
  x-data="{
  // Form validation states
  formData: {
    number: '',
    title: { id: '', en: '', ja: '' },
    description: { id: '', en: '', ja: '' }
  },
  formErrors: {
    number: '',
    title: { id: '', en: '', ja: '' },
    description: { id: '', en: '', ja: '' }
  },
  formValid: {
    number: false,
    title: { id: false, en: false, ja: false },
    description: { id: false, en: false, ja: false }
  },
  formTouched: {
    number: false,
    title: { id: false, en: false, ja: false },
    description: { id: false, en: false, ja: false }
  },

  validateField(field, value, lang = null) {
    if (lang) {
      this.formData[field][lang] = value;
      this.formTouched[field][lang] = true;
    } else {
      this.formData[field] = value;
      this.formTouched[field] = true;
    }
    
    switch(field) {
      case 'number':
        const num = parseInt(value);
        if (!value.trim()) {
          this.formErrors.number = 'Number is required';
          this.formValid.number = false;
        } else if (isNaN(num) || num < 1) {
          this.formErrors.number = 'Number must be a positive integer';
          this.formValid.number = false;
        } else {
          this.formErrors.number = '';
          this.formValid.number = true;
        }
        break;
        
      case 'title':
        if (!value.trim()) {
          this.formErrors.title[lang] = 'Title is required';
          this.formValid.title[lang] = false;
        } else if (value.trim().length < 3) {
          this.formErrors.title[lang] = 'Title must be at least 3 characters';
          this.formValid.title[lang] = false;
        } else {
          this.formErrors.title[lang] = '';
          this.formValid.title[lang] = true;
        }
        break;
        
      case 'description':
        if (!value.trim()) {
          this.formErrors.description[lang] = 'Description is required';
          this.formValid.description[lang] = false;
        } else if (value.trim().length < 10) {
          this.formErrors.description[lang] = 'Description must be at least 10 characters';
          this.formValid.description[lang] = false;
        } else {
          this.formErrors.description[lang] = '';
          this.formValid.description[lang] = true;
        }
        break;
    }
  },

  canSubmit() {
    const titleValid = Object.values(this.formValid.title).every(v => v);
    const descriptionValid = Object.values(this.formValid.description).every(v => v);
    return this.formValid.number && titleValid && descriptionValid;
  },

  hasFormErrors() {
    return this.formErrors.number !== '' || 
           Object.values(this.formErrors.title).some(e => e !== '') ||
           Object.values(this.formErrors.description).some(e => e !== '');
  }
}"
>
  <div class='max-w-2xl mx-auto bg-white rounded-2xl shadow-xl p-8'>
    <h1 class='text-2xl font-bold text-gray-800 mb-6'>Create Flow Category</h1>

    <form
      action='/flow_category/{{kategoriId}}'
      method='post'
      class='space-y-6'
      x-data="{ loading: false }"
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; } loading = true;'
    >

      <div class='space-y-2'>
        <label
          for='number'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Number
        </label>
        <input
          x-model='formData.number'
          @input='validateField("number", $event.target.value)'
          type='number'
          id='number'
          name='number'
          required
          :class="formErrors.number ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.number ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          placeholder='Enter flow number'
        />

        <!-- Error Message -->
        <template x-if='formErrors.number'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.number'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template
          x-if='formTouched.number && formValid.number && !formErrors.number'
        >
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Number looks good</p>
          </div>
        </template>
      </div>

      <!-- Title per Bahasa -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Title</label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <input
              x-model='formData.title.id'
              @input='validateField("title", $event.target.value, "id")'
              type='text'
              name='title[id]'
              required
              maxlength='255'
              :class="formErrors.title.id ? 'border-red-500 focus:ring-red-500' : (formValid.title.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              placeholder='Judul (ID)'
            />
            <template x-if='formErrors.title.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.title.id'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.title.id && formValid.title.id && !formErrors.title.id'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <input
              x-model='formData.title.en'
              @input='validateField("title", $event.target.value, "en")'
              type='text'
              name='title[en]'
              required
              maxlength='255'
              :class="formErrors.title.en ? 'border-red-500 focus:ring-red-500' : (formValid.title.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              placeholder='Title (EN)'
            />
            <template x-if='formErrors.title.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.title.en'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.title.en && formValid.title.en && !formErrors.title.en'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <input
              x-model='formData.title.ja'
              @input='validateField("title", $event.target.value, "ja")'
              type='text'
              name='title[ja]'
              required
              maxlength='255'
              :class="formErrors.title.ja ? 'border-red-500 focus:ring-red-500' : (formValid.title.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              placeholder='タイトル (JA)'
            />
            <template x-if='formErrors.title.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.title.ja'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.title.ja && formValid.title.ja && !formErrors.title.ja'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Description per Bahasa -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Description</label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.description.id'
              @input='validateField("description", $event.target.value, "id")'
              name='description[id]'
              rows='5'
              required
              :class="formErrors.description.id ? 'border-red-500 focus:ring-red-500' : (formValid.description.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Deskripsi (ID)...'
            ></textarea>
            <template x-if='formErrors.description.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.description.id'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.description.id && formValid.description.id && !formErrors.description.id'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.description.en'
              @input='validateField("description", $event.target.value, "en")'
              name='description[en]'
              rows='5'
              required
              :class="formErrors.description.en ? 'border-red-500 focus:ring-red-500' : (formValid.description.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Description (EN)...'
            ></textarea>
            <template x-if='formErrors.description.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.description.en'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.description.en && formValid.description.en && !formErrors.description.en'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.description.ja'
              @input='validateField("description", $event.target.value, "ja")'
              name='description[ja]'
              rows='5'
              required
              :class="formErrors.description.ja ? 'border-red-500 focus:ring-red-500' : (formValid.description.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='説明 (JA)...'
            ></textarea>
            <template x-if='formErrors.description.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.description.ja'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.description.ja && formValid.description.ja && !formErrors.description.ja'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span x-show="loading" class="loading loading-spinner loading-sm"></span>
          <span x-show="!loading">Create</span>
        </button>
        <a
          href='/kategoris/{{kategoriId}}'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>

    </form>
  </div>
</div>