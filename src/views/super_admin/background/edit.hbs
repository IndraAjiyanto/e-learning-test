<div
  class='py-10'
  x-data="{
  // Form validation states
  formData: {
    content: { id: '{{background.content.id}}', en: '{{background.content.en}}', ja: '{{background.content.ja}}' },
    isi: { id: '{{background.isi.id}}', en: '{{background.isi.en}}', ja: '{{background.isi.ja}}' }
  },
  formErrors: {
    content: { id: '', en: '', ja: '' },
    isi: { id: '', en: '', ja: '' }
  },
  formValid: {
    content: { id: true, en: true, ja: true },
    isi: { id: true, en: true, ja: true }
  },

  validateField(field, lang, value) {
    this.formData[field][lang] = value;
    
    switch(field) {
      case 'content':
        if (!value.trim()) {
          this.formErrors.content[lang] = 'Content is required';
          this.formValid.content[lang] = false;
        } else {
          this.formErrors.content[lang] = '';
          this.formValid.content[lang] = true;
        }
        break;
        
      case 'isi':
        if (!value.trim()) {
          this.formErrors.isi[lang] = 'Text is required';
          this.formValid.isi[lang] = false;
        } else {
          this.formErrors.isi[lang] = '';
          this.formValid.isi[lang] = true;
        }
        break;
    }
  },

  canSubmit() {
    return Object.values(this.formValid.content).every(v => v) && Object.values(this.formValid.isi).every(v => v);
  },

  hasFormErrors() {
    return Object.values(this.formErrors.content).some(e => e !== '') || Object.values(this.formErrors.isi).some(e => e !== '');
  }
}"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Background</h2>

    <form
      action='/background/{{background.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; }'
    >

      <!-- Content per Bahasa -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Content</label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.content.id'
              @input='validateField("content", "id", $event.target.value)'
              id='content_id'
              name='content[id]'
              rows='5'
              required
              :class="formErrors.content.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.content.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Enter content (ID)...'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.content.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.content.id'
                ></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.content.id && !formErrors.content.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Content looks good</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.content.en'
              @input='validateField("content", "en", $event.target.value)'
              id='content_en'
              name='content[en]'
              rows='5'
              required
              :class="formErrors.content.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.content.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Enter content (EN)...'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.content.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.content.en'
                ></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.content.en && !formErrors.content.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Content looks good</p>
              </div>
            </template>
          </div>

          <!-- JA -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JA</label>
            <textarea
              x-model='formData.content.ja'
              @input='validateField("content", "ja", $event.target.value)'
              id='content_ja'
              name='content[ja]'
              rows='5'
              required
              :class="formErrors.content.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.content.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='コンテンツを入力 (JA)...'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.content.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.content.ja'
                ></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.content.ja && !formErrors.content.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Content looks good</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Text per Bahasa -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Text</label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
