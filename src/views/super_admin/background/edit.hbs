{{!--
  Halaman: Edit Background — Super Admin
  Lokasi: src/views/super_admin/background/edit.hbs
  Level: L4 Page

  Route: GET /background/formEdit/:id -> PATCH /background/:id
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Background'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the details of this educational background entry.'
      }}
    </div>

    <div class='flex flex-col gap-4'>
      <form
        action='/background/{{background.id}}?_method=PATCH'
        method='post'
        novalidate
        x-data='{ ...backgroundForm({ content: {{json background.content}}, details: {{json background.details}} }), ...formDirtyGate() }'
        x-init='$nextTick(() => captureBaseline())'
        @input='recomputeDirty()'
        @change='recomputeDirty()'
        @submit.prevent='submitForm($event)'
      >
        {{#> components/ui/super_admin/form/background/fields }}
          <div class='flex flex-col-reverse gap-3 sm:flex-row sm:justify-end'>
            {{> components/ui/super_admin/form/button
              as='link'
              variant='secondary'
              href='/background'
              label='Cancel'
              loading=true
            }}

            {{> components/ui/super_admin/form/button
              type='submit'
              variant='primary'
              label='Save Changes'
              loading=true
              disabled='!canSubmit() || !isDirty || loading'
            }}
          </div>
        {{/components/ui/super_admin/form/background/fields}}
      </form>

      {{> components/ui/super_admin/danger_zone/index
        title='Delete Background'
        description='Permanently remove this educational background from Kesatria Academy. This action cannot be undone.'
        action=(concat '/background/' background.id '?_method=DELETE')
      }}
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Background?'
  description='Are you sure you want to delete this background? This action will permanently remove it and cannot be undone.'
}}

{{> components/ui/super_admin/form/background/form }}