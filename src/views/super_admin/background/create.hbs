<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create Background</h2>

    <form action='/background' method='post' class='space-y-6'>
      <div>
        <label
          for='content'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Content</label>
        <textarea
          id='content'
          name='content'
          rows='4'
          class='w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          placeholder='Enter content...'
          required
        ></textarea>
      </div>

      <div>
        <label
          for='isi'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Isi</label>
        <textarea
          id='isi'
          name='isi'
          rows='6'
          class='w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          placeholder='Enter isi...'
          required
        ></textarea>
      </div>

      <div class='flex justify-end gap-4'>
        <a
          href='/background'
          class='bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition'
        >Cancel</a>
        <button
          type='submit'
          class='bg-gray-900 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition'
        >Create</button>
      </div>
    </form>
  </div>
</div>