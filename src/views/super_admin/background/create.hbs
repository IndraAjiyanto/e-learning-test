{{!--
  Halaman: Create Background — Super Admin
  Lokasi: src/views/super_admin/background/create.hbs
  Level: L4 Page

  Route: GET /background/formCreate -> POST /background
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Background'
      }}

      {{> components/ui/super_admin/description/index
        text='Add a new educational background or academic milestone.'
      }}
    </div>

    <form
      action='/background'
      method='post'
      novalidate
      x-data='backgroundForm()'
      @submit.prevent='submitForm($event)'
    >
      {{#> components/ui/super_admin/form/background/fields }}
        <div class='flex flex-col-reverse gap-3 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href='/background'
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Create Background'
            loading=true
            disabled='!canSubmit() || loading'
          }}
        </div>
      {{/components/ui/super_admin/form/background/fields}}
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/background/form }}