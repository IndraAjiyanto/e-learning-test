<div
  class='py-10'
  x-data="{
  // Form validation states
  formData: {
    content: '',
    isi: ''
  },
  formErrors: {
    content: '',
    isi: ''
  },
  formValid: {
    content: false,
    isi: false
  },

  validateField(field, value) {
    this.formData[field] = value;
    
    switch(field) {
      case 'content':
        if (!value.trim()) {
          this.formErrors.content = 'Content is required';
          this.formValid.content = false;
        } else {
          this.formErrors.content = '';
          this.formValid.content = true;
        }
        break;
        
      case 'isi':
        if (!value.trim()) {
          this.formErrors.isi = 'Isi is required';
          this.formValid.isi = false;
        } else {
          this.formErrors.isi = '';
          this.formValid.isi = true;
        }
        break;
    }
  },

  canSubmit() {
    return this.formValid.content && this.formValid.isi;
  },

  hasFormErrors() {
    return Object.values(this.formErrors).some(error => error !== '');
  }
}"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create Background</h2>

    <form
      action='/background'
      method='POST'
      class='space-y-6'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; }'
    >

      <div class='space-y-2'>
        <label
          for='content'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Content
        </label>
        <textarea
          x-model='formData.content'
          @input='validateField("content", $event.target.value)'
          id='content'
          name='content'
          rows='5'
          required
          :class="formErrors.content ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.content ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
          placeholder='Enter content...'
        ></textarea>

        <!-- Error Message -->
        <template x-if='formErrors.content'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.content'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.content && !formErrors.content'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Content looks good</p>
          </div>
        </template>
      </div>

      <div class='space-y-2'>
        <label for='isi' class='block text-sm font-semibold text-gray-700 mb-1'>
          Text
        </label>
        <textarea
          x-model='formData.isi'
          @input='validateField("isi", $event.target.value)'
          id='isi'
          name='isi'
          rows='5'
          required
          :class="formErrors.isi ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.isi ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
          placeholder='Enter isi...'
        ></textarea>

        <!-- Error Message -->
        <template x-if='formErrors.isi'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.isi'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.isi && !formErrors.isi'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Isi looks good</p>
          </div>
        </template>
      </div>

      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Create
        </button>
        <a
          href='/background'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>

    </form>
  </div>
</div>