<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900 text-center'>
      Edit Partner Category
    </h2>

    <form
      action='/category-partner/{{category.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      x-data="{
        category: '{{category.category}}',
        loading: false,
        get error() {
          if (!this.category.trim()) return 'Category is required';
          if (this.category.trim().length < 2) return 'Minimum 2 characters';
          return '';
        },
        get valid() { return this.error === ''; }
      }"
      @submit='if (!valid) { $event.preventDefault(); return false; } loading = true;'
    >
      <div>
        <label class='block text-sm font-semibold text-gray-700 mb-2'>
          Category Name
        </label>
        <input
          type='text'
          name='category'
          x-model='category'
          placeholder='e.g. Technology, Media, University'
          class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900'
        />
        <p x-show='error' x-text='error' class='mt-1 text-sm text-red-600'></p>
      </div>

      <div class='flex gap-2'>
        <button
          type='submit'
          :disabled='!valid || loading'
          :class="(!valid || loading) ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='py-2 px-4 text-white font-semibold rounded-lg shadow transition'
        >
          <span x-show='loading' class='loading loading-spinner loading-sm'></span>
          <span x-show='!loading'>Update</span>
        </button>
        <a
          href='/category-partner'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>
