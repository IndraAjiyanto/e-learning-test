{{!--
  Halaman: Partner Category — Super Admin
  Lokasi: src/views/super_admin/category_partner/index.hbs
  Level: L4 Page

  - kerangka halaman identik dengan Partnership (judul, toolbar, kartu, tabs);
    yang berbeda hanya tab aktif, label tombol, dan kolom tabel
  - lebar kolom tabel: 266 / 257 / 308 / 179 (total 1010)

  Data: GET /category-partner → { categories } dengan relasi partners.
  Search & pagination dijalankan di client lewat clientTable().
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>
    
    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Partner'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage partnerships and organize partner categories for Kesatria Academy.'
      }}
    </div>

    <div
      class='flex flex-col gap-3.5'
      x-data='clientTable({ items: {{json categories}}, searchKeys: ["category"] })'
    >
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search category..'
        searchLabel='Search partner category'
        createHref='/category-partner/formCreate'
        createLabel='Create Category'
      }}

      
      <div class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'>
        <div class='flex flex-col gap-5'>
          {{> components/ui/super_admin/tabs/partner/index active='category' }}

          {{#> components/ui/super_admin/table/card tableClass='min-w-[1010px]'}}
            <colgroup>
              <col class='w-[266px]' />
              <col class='w-[257px]' />
              <col class='w-[308px]' />
              <col class='w-[179px]' />
            </colgroup>
            <thead>
              <tr>
                {{> components/ui/super_admin/table/header_cell label='No' }}
                {{> components/ui/super_admin/table/header_cell label='Category' }}
                {{> components/ui/super_admin/table/header_cell label='Total Partner' }}
                {{> components/ui/super_admin/table/header_cell label='Action' }}
              </tr>
            </thead>
            <tbody>
              <template x-for='(row, index) in rows' :key='row.id'>
                <tr class='transition-colors hover:bg-[#fafafa]'>
                  
                  {{> components/ui/super_admin/table/cell
                    text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
                  }}

                  
                  {{> components/ui/super_admin/table/cell text='row.category' }}

                  
                  {{#> components/ui/super_admin/table/cell}}
                    {{> components/ui/super_admin/badge/index
                      text='(row.partners || []).length'
                      class='bg-[#f9f5ff] text-[#6941c6]'
                    }}
                  {{/components/ui/super_admin/table/cell}}

                  
                  {{#> components/ui/super_admin/table/cell variant='action'}}
                    <div class='flex items-center gap-1'>
                      <a
                        :href="'/category-partner/formEdit/' + row.id"
                        title='Edit partner category'
                        aria-label='Edit partner category'
                        class='flex h-10 w-10 items-center justify-center rounded-lg p-2.5 text-[#525252] transition-colors hover:bg-[#f5f5f5] hover:text-[#003060] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 active:bg-[#e5e5e5]'
                      >
                        {{!-- lucide: edit-2 --}}
                        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.67' stroke-linecap='round' stroke-linejoin='round' class='h-5 w-5'>
                          <path d='M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z' />
                        </svg>
                      </a>

                      <form :action="'/category-partner/' + row.id + '?_method=DELETE'" method='post'>
                        <button
                          type='button'
                          @click="
                            if ((row.partners || []).length > 0) {
                              window.dispatchEvent(new CustomEvent('toast:error', {
                                detail: {
                                  title: 'Gagal Menghapus Kategori',
                                  description: 'Kategori &quot;' + row.category + '&quot; tidak dapat dihapus karena masih memiliki ' + (row.partners || []).length + ' data partnership. Hapus partnership tersebut terlebih dahulu.'
                                }
                              }));
                            } else {
                              openDeleteModal($el);
                            }
                          "
                          title='Delete partner category'
                          aria-label='Delete partner category'
                          class='flex h-10 w-10 items-center justify-center rounded-lg p-2.5 text-[#dc2626] transition-colors hover:bg-[#fef2f2] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#dc2626]/40 active:bg-[#fee2e2]'
                        >
                          {{!-- lucide: trash-2 --}}
                          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.67' stroke-linecap='round' stroke-linejoin='round' class='h-5 w-5'>
                            <path d='M3 6h18' />
                            <path d='M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6' />
                            <path d='M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2' />
                            <line x1='10' x2='10' y1='11' y2='17' />
                            <line x1='14' x2='14' y1='11' y2='17' />
                          </svg>
                        </button>
                      </form>
                    </div>
                  {{/components/ui/super_admin/table/cell}}
                </tr>
              </template>

              {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='4'}}
                No partner categories found.
              {{/components/ui/super_admin/table/message_row}}
            </tbody>
          {{/components/ui/super_admin/table/card}}
        </div>
      </div>
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Partner Category?'
  description='Are you sure you want to delete this partner category? This action will permanently remove the category and cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}
