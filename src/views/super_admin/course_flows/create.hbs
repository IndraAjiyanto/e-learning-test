{{!--
  Halaman: Create Flow Program — Super Admin
  Lokasi: src/views/super_admin/course_flows/create.hbs
  Level: L4 Page

  Melayani DUA route yang memakai view yang sama:
  - GET /flow-program/formCreate/:courseId -> POST /flow-program/:courseId
    Program sudah ditentukan URL; datanya { courseId }.
  - GET /flow-program/formCreate           -> POST /flow-program
    Dipanggil dari tombol Create di halaman index, jadi program dipilih di form
    lewat field `kelas_id` yang dibaca controller dari req.body; datanya { course }.

  Pembedanya `courseId`: bila tidak ada, select Program dirender dan tujuan Cancel
  kembali ke daftar flow.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Flow Program'
      }}

      {{> components/ui/super_admin/description/index
        text='Add a new step to the program flow in all three languages.'
      }}
    </div>

    <form
      action='{{#if courseId}}/flow-program/{{courseId}}{{else}}/flow-program{{/if}}'
      method='post'
      novalidate
      x-data='courseFlowForm({{#unless courseId}}{ courses: {{json course}} }{{/unless}})'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
    >
      <div class='flex flex-col gap-5'>
        {{#unless courseId}}
          {{> components/ui/super_admin/form/select_field
            id='kelas_id'
            name='kelas_id'
            field='kelas_id'
            label='Program'
            placeholder='Select a program'
            options='courseOptions'
            required=true
          }}
        {{/unless}}

        {{> components/ui/super_admin/tabs/language/index ariaLabel='Flow language' }}

        {{> components/ui/super_admin/form/course_flow/fields }}

        <div class='flex flex-col-reverse gap-3 pt-6 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href=(ternary courseId (concat '/program/detail/program/admin/' courseId) '/flow-program')
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Create Flow'
            loading=true
          }}
        </div>
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/course_flow/form }}
