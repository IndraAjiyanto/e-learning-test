{{!--
  Halaman: Edit Flow Program — Super Admin
  Lokasi: src/views/super_admin/course_flows/edit.hbs
  Level: L4 Page

  Route: GET /flow-program/formEdit/:courseFlowId
         -> PATCH /flow-program/:courseFlowId/:courseId
         (urlencoded + _method override, sesuai UpdateCourseFlowDto).

  Beda dari create.hbs: field terisi nilai existing, program tidak bisa dipindah,
  dan tombol submit "Save Changes".
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Flow Program'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the title and description of this program flow step.'
      }}
    </div>

    <form
      action='/flow-program/{{course_flows.id}}/{{course_flows.course.id}}?_method=PATCH'
      method='post'
      novalidate
      x-data='{ ...courseFlowForm({ title: {{json course_flows.title}}, content: {{json course_flows.content}} }), ...formDirtyGate() }'
      x-init='$nextTick(() => captureBaseline())'
      @input='recomputeDirty()'
      @change='recomputeDirty()'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
    >
      <div class='flex flex-col gap-5'>
        {{> components/ui/super_admin/tabs/language/index ariaLabel='Flow language' }}

        {{> components/ui/super_admin/form/course_flow/fields }}

        <div class='flex flex-col-reverse gap-3 pt-6 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href=(concat '/program/detail/program/admin/' course_flows.course.id)
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            disabled='!isDirty || loading'
            variant='primary'
            label='Save Changes'
            loading=true
          }}
        </div>
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/course_flow/form }}
