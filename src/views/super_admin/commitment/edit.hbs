{{!--
  Halaman: Edit Commitment — Super Admin
  Lokasi: src/views/super_admin/commitment/edit.hbs
  Level: L4 Page

  Route: GET /commitment/formEdit/:id -> PATCH /commitment/:id (urlencoded + _method override).
  Field dikirim sebagai title[id|en|ja], icon, description[id|en|ja];
  `commitmentOrder` tidak ikut — service yang menentukannya (max + 1 saat create,
  di-reindex saat delete).

  Nilai awal lewat helper json, bukan template literal: teksnya bebas diketik
  dan bisa memuat karakter yang memecah skrip. Tidak ada tombol hapus di sini —
  menghapus dilakukan lewat aksi baris di halaman daftar.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Commitment'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the commitment information used across Kesatria Academy.'
      }}
    </div>

    <form
      action='/commitment/{{commitment.id}}?_method=PATCH'
      method='post'
      novalidate
      x-data='iconItemForm({ icon: {{json commitment.icon}}, title: {{json commitment.title}}, description: {{json commitment.description}} })'
      @submit.prevent='submitForm($event)'
    >
      {{#> components/ui/super_admin/form/icon_item/fields
        titleHint='Shown as the heading of the commitment card on the public About page.'
        descriptionHint='Shown under the heading on the commitment card.'
      }}
        <div class='flex flex-col-reverse gap-3 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href='/commitment'
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Save Changes'
            loading=true
          }}
        </div>
      {{/components/ui/super_admin/form/icon_item/fields}}
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/icon_item/form }}
