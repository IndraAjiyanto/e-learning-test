<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Commitment</h2>

    <form
      action='/commitment/{{commitment.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
    >

      <div>
        <label
          for='judul'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Title
        </label>
        <input
          type='text'
          id='judul'
          name='judul'
          value='{{commitment.judul}}'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        />
      </div>

      <div>
        <label
          for='deskripsi'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Description
        </label>
        <textarea
          id='deskripsi'
          name='deskripsi'
          rows='4'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        >{{commitment.deskripsi}}</textarea>
      </div>

      <div>
        <label
          for='icon'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Icon
          <span class='text-xs text-gray-500 font-normal'>(Font Awesome class,
            e.g. fa-check-circle)</span>
        </label>
        <input
          type='text'
          id='icon'
          name='icon'
          value='{{commitment.icon}}'
          placeholder='fa-check-circle'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        />
      </div>

      <div class='flex space-x-4'>
        <button
          type='submit'
          class='bg-gray-900 text-white px-6 py-2 rounded-lg shadow hover:bg-gray-600 transition focus:outline-none focus:ring-2 focus:ring-gray-900'
        >
          Update
        </button>
        <a
          href='/commitment'
          class='bg-white border border-gray-300 text-gray-900 px-6 py-2 rounded-lg shadow hover:bg-gray-100 transition focus:outline-none focus:ring-2 focus:ring-gray-900'
        >
          Cancel
        </a>
      </div>

    </form>
  </div>
</div>