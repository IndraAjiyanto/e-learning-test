<div
  class='py-10'
  x-data="{
    get computedClass() {
      const raw = (this.formData.icon || '').toString().trim();
      if (!raw) return 'fa-solid fa-circle-question';
      const v = raw;
      const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(v) || v.split(/\s+/).some(s => /^fa-/i.test(s));
      if (hasFaPrefix) {
        if (/^fa-\w+/i.test(v) && !/\s+/.test(v)) return 'fa-solid ' + v;
        return v;
      }
      if (!v.includes(' ')) return 'fa-solid fa-' + v;
      return v;
    },

    // Form validation states
    formData: {
      icon: '{{commitment.icon}}',
      judul: '{{commitment.judul}}',
      deskripsi: '{{commitment.deskripsi}}'
    },
    formErrors: {
      icon: '',
      judul: '',
      deskripsi: ''
    },
    formValid: {
      icon: true,
      judul: true,
      deskripsi: true
    },

    validateField(field, value) {
      this.formData[field] = value;
      
      switch(field) {
        case 'icon':
          if (!value.trim()) {
            this.formErrors.icon = 'Icon is required';
            this.formValid.icon = false;
          } else if (value.trim().length < 2) {
            this.formErrors.icon = 'Icon must be at least 2 characters';
            this.formValid.icon = false;
          } else {
            this.formErrors.icon = '';
            this.formValid.icon = true;
          }
          break;
          
        case 'judul':
          if (!value.trim()) {
            this.formErrors.judul = 'Title is required';
            this.formValid.judul = false;
          } else if (value.trim().length < 3) {
            this.formErrors.judul = 'Title must be at least 3 characters';
            this.formValid.judul = false;
          } else {
            this.formErrors.judul = '';
            this.formValid.judul = true;
          }
          break;
          
        case 'deskripsi':
          if (!value.trim()) {
            this.formErrors.deskripsi = 'Description is required';
            this.formValid.deskripsi = false;
          } else if (value.trim().length < 10) {
            this.formErrors.deskripsi = 'Description must be at least 10 characters';
            this.formValid.deskripsi = false;
          } else {
            this.formErrors.deskripsi = '';
            this.formValid.deskripsi = true;
          }
          break;
      }
    },

    canSubmit() {
      return this.formValid.icon && this.formValid.judul && this.formValid.deskripsi;
    },

    hasFormErrors() {
      return Object.values(this.formErrors).some(error => error !== '');
    }
  }"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Commitment</h2>

    <form
      action='/commitment/{{commitment.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; }'
    >

      <div class='space-y-2'>
        <label
          for='judul'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Title
        </label>
        <input
          x-model='formData.judul'
          @input='validateField("judul", $event.target.value)'
          type='text'
          id='judul'
          name='judul'
          required
          :class="formErrors.judul ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.judul ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
        />

        <!-- Error Message -->
        <template x-if='formErrors.judul'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.judul'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.judul && !formErrors.judul'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Title looks good</p>
          </div>
        </template>
      </div>

      <div class='space-y-2'>
        <label
          for='deskripsi'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Description
        </label>
        <textarea
          x-model='formData.deskripsi'
          @input='validateField("deskripsi", $event.target.value)'
          id='deskripsi'
          name='deskripsi'
          rows='5'
          required
          :class="formErrors.deskripsi ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.deskripsi ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
        ></textarea>

        <!-- Error Message -->
        <template x-if='formErrors.deskripsi'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.deskripsi'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.deskripsi && !formErrors.deskripsi'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Description looks good</p>
          </div>
        </template>
      </div>

      <div class='space-y-2'>
        <label
          for='icon'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Icon</label>
        <div class='flex items-center gap-4'>
          <input
            x-model='formData.icon'
            @input='validateField("icon", $event.target.value)'
            type='text'
            id='icon'
            name='icon'
            placeholder='code or fa-code or fa-solid fa-code'
            :class="formErrors.icon ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.icon ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          />

          <div class='flex items-center gap-3'>
            <i :class='computedClass' class='text-2xl text-gray-700'></i>
            <span class='text-sm text-gray-500' x-text='computedClass'></span>
          </div>
        </div>

        <!-- Error Message -->
        <template x-if='formErrors.icon'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.icon'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.icon && !formErrors.icon'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Icon looks good</p>
          </div>
        </template>

        <p class='text-sm text-gray-500 mt-2'>Type an icon name like
          <code>code</code>
          or
          <code>fa-code</code>. It will preview using Font Awesome 6 (e.g.
          <code>fa-solid fa-code</code>).</p>
      </div>

      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Update
        </button>
        <a
          href='/commitment'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>

    </form>
  </div>
</div>