<div
  class='py-10'
  x-data="{
  get computedClass() {
    const raw = (this.formData.icon || '').toString().trim();
    if (!raw) return 'fa-solid fa-circle-question';
    const v = raw;
    const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(v) || v.split(/\s+/).some(s => /^fa-/i.test(s));
    if (hasFaPrefix) {
      if (/^fa-\w+/i.test(v) && !/\s+/.test(v)) return 'fa-solid ' + v;
      return v;
    }
    if (!v.includes(' ')) return 'fa-solid fa-' + v;
    return v;
  },

  // Form validation states
  formData: {
    icon: '',
    title: { id: '', en: '', ja: '' },
    description: { id: '', en: '', ja: '' }
  },
  formErrors: {
    icon: '',
    title: { id: '', en: '', ja: '' },
    description: { id: '', en: '', ja: '' }
  },
  formValid: {
    icon: false,
    title: { id: false, en: false, ja: false },
    description: { id: false, en: false, ja: false }
  },
  loading: false,

  validateField(field, lang, value) {
    if (lang) {
      this.formData[field][lang] = value;
    } else {
      this.formData[field] = value;
    }
    
    switch(field) {
      case 'icon':
        if (!value.trim()) {
          this.formErrors.icon = 'Icon is required';
          this.formValid.icon = false;
        } else if (value.trim().length < 2) {
          this.formErrors.icon = 'Icon must be at least 2 characters';
          this.formValid.icon = false;
        } else {
          this.formErrors.icon = '';
          this.formValid.icon = true;
        }
        break;
        
      case 'title':
        if (!value.trim()) {
          this.formErrors.title[lang] = 'Title is required';
          this.formValid.title[lang] = false;
        } else if (value.trim().length < 3) {
          this.formErrors.title[lang] = 'Title must be at least 3 characters';
          this.formValid.title[lang] = false;
        } else {
          this.formErrors.title[lang] = '';
          this.formValid.title[lang] = true;
        }
        break;
        
      case 'description':
        if (!value.trim()) {
          this.formErrors.description[lang] = 'Description is required';
          this.formValid.description[lang] = false;
        } else if (value.trim().length < 3) {
          this.formErrors.description[lang] = 'Description must be at least 3 characters';
          this.formValid.description[lang] = false;
        } else {
          this.formErrors.description[lang] = '';
          this.formValid.description[lang] = true;
        }
        break;
    }
  },

  get isFormValid() {
    return this.formValid.icon && this.formValid.title.id && this.formValid.title.en && this.formValid.title.ja &&
           this.formValid.description.id && this.formValid.description.en && this.formValid.description.ja;
  },

  get hasAnyError() {
    return (this.formErrors.icon || this.formErrors.title.id || this.formErrors.title.en || this.formErrors.title.ja ||
            this.formErrors.description.id || this.formErrors.description.en || this.formErrors.description.ja) !== '';
  }
}"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create Commitment</h2>

    <form
      action='/commitment'
      method='POST'
      class='space-y-6'
      @submit='if (!isFormValid) { $event.preventDefault(); return false; } loading = true;'
    >

    {{> super_admin/commitment/create/tittle_input }}
    {{> super_admin/commitment/create/description_input }}
    {{> super_admin/commitment/create/icon_input }}

      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!isFormValid || loading'
          :class="!isFormValid || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span x-show="loading" class="loading loading-spinner loading-sm"></span>
          <span x-show="!loading">Create</span>
        </button>
        <a
          href='/commitment'
        :disabled='loading'
        :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300  transition'>
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasAnyError'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>

    </form>
  </div>
</div>