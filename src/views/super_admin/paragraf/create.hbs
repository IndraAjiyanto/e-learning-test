<div
  class='py-10'
  x-data="{
    // Form validation states
    formData: {
      paragraf: { id: '', en: '', ja: '' }
    },
    formErrors: {
      paragraf: { id: '', en: '', ja: '' }
    },
    formValid: {
      paragraf: { id: false, en: false, ja: false }
    },
    formTouched: {
      paragraf: { id: false, en: false, ja: false }
    },

    validateField(field, value, lang = null) {
      if (lang) {
        this.formData[field][lang] = value;
        this.formTouched[field][lang] = true;
      } else {
        this.formData[field] = value;
        this.formTouched[field] = true;
      }
      
      switch(field) {
        case 'paragraf':
          if (!value.trim()) {
            this.formErrors.paragraf[lang] = 'Paragraf content is required';
            this.formValid.paragraf[lang] = false;
          } else if (value.trim().length < 10) {
            this.formErrors.paragraf[lang] = 'Paragraf content must be at least 10 characters';
            this.formValid.paragraf[lang] = false;
          } else {
            this.formErrors.paragraf[lang] = '';
            this.formValid.paragraf[lang] = true;
          }
          break;
      }
    },

    canSubmit() {
      const paragrafValid = Object.values(this.formValid.paragraf).every(v => v);
      return paragrafValid;
    },

    hasFormErrors() {
      return Object.values(this.formErrors.paragraf).some(e => e !== '');
    }
  }"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mt-0 mb-6 text-center text-gray-900'>Create New Paragraf</h2>

    <form
      action='/paragraf'
      method='post'
      class='space-y-6'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; }'
    >

      <!-- Paragraf Content per Bahasa -->
      <div class='space-y-4'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Paragraf
        </label>
        <div class='grid grid-cols-1 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.paragraf.id'
              @input='validateField("paragraf", $event.target.value, "id")'
              name='paragraf[id]'
              rows='5'
              required
              maxlength='2000'
              :class="formErrors.paragraf.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.paragraf.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Konten paragraf (ID)'
            ></textarea>
            <template x-if='formErrors.paragraf.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.paragraf.id'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.paragraf.id && formValid.paragraf.id && !formErrors.paragraf.id'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.paragraf.en'
              @input='validateField("paragraf", $event.target.value, "en")'
              name='paragraf[en]'
              rows='5'
              required
              maxlength='2000'
              :class="formErrors.paragraf.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.paragraf.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Paragraph content (EN)'
            ></textarea>
            <template x-if='formErrors.paragraf.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.paragraf.en'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.paragraf.en && formValid.paragraf.en && !formErrors.paragraf.en'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.paragraf.ja'
              @input='validateField("paragraf", $event.target.value, "ja")'
              name='paragraf[ja]'
              rows='5'
              required
              maxlength='2000'
              :class="formErrors.paragraf.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.paragraf.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='段落コンテンツ (JA)'
            ></textarea>
            <template x-if='formErrors.paragraf.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.paragraf.ja'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.paragraf.ja && formValid.paragraf.ja && !formErrors.paragraf.ja'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Create
        </button>
        <a
          href='/paragraf'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>

    </form>
  </div>
</div>