<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Paragraf</h2>

    <form
      action='/paragraf/{{paragraf.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      x-data="{
        paragraf: '{{paragraf.paragraf}}',
        errors: { paragraf: null },
        success: { paragraf: false },
        validateParagraf() {
          if (!this.paragraf.trim()) {
            this.errors.paragraf = 'Paragraf content is required';
            this.success.paragraf = false;
          } else if (this.paragraf.trim().length < 10) {
            this.errors.paragraf = 'Paragraf content must be at least 10 characters';
            this.success.paragraf = false;
          } else {
            this.errors.paragraf = null;
            this.success.paragraf = true;
          }
        },
        get canSubmit() {
          return this.success.paragraf;
        }
      }"
      @submit.prevent='if (!canSubmit) return false'
    >

      <!-- Paragraf Content -->
      <div>
        <label
          for='paragraf'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Paragraf</label>
        <textarea
          x-model='paragraf'
          @input='validateParagraf()'
          id='paragraf'
          name='paragraf'
          required
          rows='5'
          placeholder='Enter paragraf content...'
          :class="errors.paragraf ? 'border-red-500 focus:ring-red-500' : success.paragraf ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
        >{{paragraf.paragraf}}</textarea>
        <p
          x-show='errors.paragraf'
          x-text='errors.paragraf'
          class='mt-1 text-sm text-red-600'
        ></p>
      </div>

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit'
          :class="canSubmit ? 'bg-gray-900 hover:bg-gray-600' : 'bg-gray-400 cursor-not-allowed'"
          class='text-white px-6 py-2 rounded-lg shadow transition'
        >
          Update
        </button>
        <a
          href='/paragraf'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition'
        >
          Cancel
        </a>
      </div>

    </form>
  </div>
</div>