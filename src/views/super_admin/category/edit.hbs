{{!--
  Halaman: Edit Category — Super Admin
  Lokasi: src/views/super_admin/category/edit.hbs
  Level: L4 Page

  Route: GET /category/formEdit/:id -> PATCH /category/:id
  (multipart: name, icon, hero_section_image, description[lang], text[lang],
  contact, courseType[], type). Data: { category, courseTypes }.
  Delete -> DELETE /category/:id

  Backend hanya mengganti gambar yang dikirim. "Remove" melepas gambar lama di
  form saja; karena gambar wajib, Save tertahan sampai file pengganti dipilih.
  Delete dirender komponen danger_zone di bawah form PATCH — kartu yang sama
  dengan halaman edit super admin lain — yang membawa form DELETE-nya sendiri
  karena form tidak boleh bersarang.
--}}
{{#*inline 'categoryLangFields'}}
  {{!-- x-show, bukan x-if: bahasa di tab yang tidak aktif tetap ikut terkirim. --}}
  <div x-show="lang === '{{code}}'" x-cloak class='flex flex-col gap-5'>
    {{> components/ui/super_admin/form/text_field
      id=(concat 'text-' code)
      name=(concat 'text[' code ']')
      field=(concat 'text.' code)
      label='Caption'
      multiline=true
      placeholder='Enter a caption...'
    }}

    {{> components/ui/super_admin/form/text_field
      id=(concat 'description-' code)
      name=(concat 'description[' code ']')
      field=(concat 'description.' code)
      label='Description'
      multiline=true
      placeholder='Enter a description...'
      required=true
    }}
  </div>
{{/inline}}

<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>
    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Categories'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the category information used across Kesatria Academy.'
      }}
    </div>

    <form
      id='categoryEditForm'
      action='/category/{{category.id}}?_method=PATCH'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='categoryEditForm({ category: {{json category}}, courseTypes: {{json courseTypes}} })'
      @submit.prevent='submitForm($event)'
      class='flex flex-col gap-4'
    >
      <div class='grid gap-5 rounded-xl border border-[#d9d9d9] bg-white px-4 py-5 sm:px-5 sm:py-7 lg:grid-cols-2'>
        {{!-- Tiap dropzone butuh scope sendiri: state & x-ref komponennya bernama tetap. --}}
        <div x-data="imageSlot('icon')">
          {{> components/ui/super_admin/form/image_dropzone
            id='icon'
            name='icon'
            label='Icon Image'
            meta='JPG / PNG / SVG · 1000×1000 – 2000×2000 · Max 5 MB'
            accept='image/jpeg,image/jpg,image/png,image/svg+xml'
            boxClass='h-[220px]'
            required=true
          }}
        </div>

        <div x-data="imageSlot('hero_section_image')">
          {{> components/ui/super_admin/form/image_dropzone
            id='hero_section_image'
            name='hero_section_image'
            label='Hero Section Image'
            meta='JPG / PNG / SVG · Max 5 MB'
            accept='image/jpeg,image/jpg,image/png,image/svg+xml'
            boxClass='h-[220px]'
            required=true
          }}
        </div>
      </div>

      <div class='flex flex-col gap-6 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:p-5'>
        {{!-- Tiga tab berlabel penuh lebih lebar dari layar 400px. --}}
        <div class='overflow-x-auto'>
          {{> components/ui/super_admin/tabs/language/index ariaLabel='Category content language' }}
        </div>

        <div class='flex items-center gap-2'>
          <span class='flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#003060] text-white' aria-hidden='true'>
            <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round' class='h-5 w-5'>
              <path d='M12 16v-5' />
              <path d='M12 7h.01' />
            </svg>
          </span>
          <h2 class='font-montserrat text-base font-semibold leading-6 text-[#003060]'>Basic Information</h2>
        </div>

        <div class='flex flex-col gap-5'>
          <div class='grid gap-x-3 gap-y-3.5 lg:grid-cols-2'>
            {{> components/ui/super_admin/form/text_field
              id='name'
              name='name'
              field='name'
              label='Category Name'
              placeholder='Enter a category name'
              required=true
            }}

            {{> components/ui/super_admin/form/text_field
              id='contact'
              name='contact'
              field='contact'
              label='Contact'
              placeholder='Enter a number'
            }}

            {{> components/ui/super_admin/form/select_field
              id='type'
              name='type'
              field='type'
              label='Type'
              placeholder='Select a type'
              options='typeOptions'
              required=true
            }}

            {{> components/ui/super_admin/form/multi_select_field
              id='courseTypeSearch'
              name='courseType[]'
              label='Program Types'
              options='courseTypeOptions'
              initial='selectedCourseTypes'
              placeholder='Search program types...'
              emptyText='No program types found.'
            }}
          </div>

          <div class='flex flex-col gap-5'>
            {{> categoryLangFields code='id' }}

            {{> categoryLangFields code='en' }}

            {{> categoryLangFields code='ja' }}
          </div>

          <div class='flex flex-col-reverse gap-3 sm:flex-row sm:justify-end'>
            {{> components/ui/super_admin/form/button
              as='link'
              variant='secondary'
              href='/category'
              label='Cancel'
              loading=true
            }}

            {{> components/ui/super_admin/form/button
              type='submit'
              variant='primary'
              label='Save Changes'
              loading=true
            }}
          </div>
        </div>
      </div>
    </form>

    {{!-- Danger Zone — kartu yang sama dengan halaman edit super admin lain. --}}
    {{> components/ui/super_admin/danger_zone/index
      title='Delete Category'
      description='Permanently remove this category. Programs, alumni, galleries and FAQs under it will lose their category. This action cannot be undone.'
      action=(concat '/category/' category.id '?_method=DELETE')
    }}
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Category?'
  description='Are you sure you want to delete this category? This action will permanently remove the category and cannot be undone.'
}}

<script>
  (() => {
    const LANGS = ['id', 'en', 'ja'];
    const LANG_LABEL = { id: 'Indonesian', en: 'English', ja: 'Japanese' };
    const TYPES = ['Special Program', 'Paid Program', 'Free Program'];

    // Batas mengikuti CategoriesController.update.
    const IMAGE_TYPES = ['image/jpeg', 'image/jpg', 'image/png', 'image/svg+xml'];
    const MAX_SIZE = 5 * 1024 * 1024;
    const IMAGE_RULES = {
      icon: { label: 'icon image', minDim: 1000, maxDim: 2000 },
      hero_section_image: { label: 'hero section image' },
    };

    // Urutan = urutan tampil, dipakai untuk memfokuskan error pertama.
    const FIELD_PATHS = [
      'name',
      'contact',
      'type',
      ...LANGS.map((l) => `text.${l}`),
      ...LANGS.map((l) => `description.${l}`),
    ];

    const byLang = (valueFor) => Object.fromEntries(LANGS.map((l) => [l, valueFor(l)]));
    const readPath = (obj, path) => path.split('.').reduce((acc, key) => acc[key], obj);
    const writePath = (obj, path, value) => {
      const keys = path.split('.');
      const last = keys.pop();
      keys.reduce((acc, key) => acc[key], obj)[last] = value;
    };
    const assetUrl = (path) => (path ? (path.startsWith('/') ? path : `/${path}`) : '');
    const emptyImage = (existingUrl) => ({
      existingUrl,
      previewUrl: existingUrl || null,
      errorMessage: '',
      isValid: true,
      hasFile: false,
      fileName: '',
    });

    const errorFor = (path, value) => {
      const [field, lang] = path.split('.');
      const val = (value ?? '').toString().trim();

      switch (field) {
        case 'name':
          return val ? '' : 'Category name is required.';
        case 'type':
          return val ? '' : 'Please select a category type.';
        case 'contact':
          return val && !/^[0-9+\-\s]+$/.test(val) ? 'Contact must be a valid phone number.' : '';
        case 'description':
          return val ? '' : `Description (${LANG_LABEL[lang]}) is required.`;
        default:
          return '';
      }
    };

    window.categoryEditForm = function categoryEditForm({ category, courseTypes }) {
      return {
        loading: false,
        lang: 'id',

        typeOptions: TYPES.map((t) => ({ value: t, label: t })),

        formData: {
          name: category.name ?? '',
          type: category.type ?? '',
          contact: category.contact ?? '',
          description: byLang((l) => category.description?.[l] ?? ''),
          text: byLang((l) => category.text?.[l] ?? ''),
        },
        formErrors: { name: '', type: '', contact: '', description: byLang(() => ''), text: byLang(() => '') },
        // Error baru muncul setelah field disentuh atau setelah submit ditekan.
        touched: { name: false, type: false, contact: false, description: byLang(() => false), text: byLang(() => false) },

        courseTypeOptions: (courseTypes || []).map((c) => ({ value: c.id, label: c.nameClassesType })),
        selectedCourseTypes: (category.courseTypes || []).map((c) => ({ value: c.id, label: c.nameClassesType })),

        images: {
          icon: emptyImage(assetUrl(category.icon)),
          hero_section_image: emptyImage(assetUrl(category.hero_section_image)),
        },

        validateField(path, value) {
          writePath(this.formData, path, value ?? '');
          writePath(this.formErrors, path, readPath(this.touched, path) ? errorFor(path, value) : '');
        },

        touch(path) {
          writePath(this.touched, path, true);
          this.validateField(path, readPath(this.formData, path));
        },

        // Scope untuk satu form/image_dropzone; state aslinya tetap di `images`
        // supaya validasi submit bisa membacanya.
        imageSlot(key) {
          return {
            get previewUrl() { return this.images[key].previewUrl; },
            get errorMessage() { return this.images[key].errorMessage; },
            get isValid() { return this.images[key].isValid; },
            get hasFile() { return this.images[key].hasFile; },
            get fileName() { return this.images[key].fileName; },
            validateImage(file) { this.checkImage(key, file); },
            clearFile() {
              this.images[key].existingUrl = '';
              this.resetImage(key);
              this.$refs.dropInput.value = null;
            },
          };
        },

        checkImage(key, file) {
          this.resetImage(key);
          if (!file) return;

          const slot = this.images[key];
          const rules = IMAGE_RULES[key];
          slot.hasFile = true;
          slot.fileName = file.name;

          if (!IMAGE_TYPES.includes(file.type)) {
            this.setImageError(key, 'Only JPG, PNG, and SVG formats are allowed');
            return;
          }

          if (file.size > MAX_SIZE) {
            this.setImageError(key, `File size too large (${(file.size / 1024 / 1024).toFixed(2)} MB). Maximum 5 MB`);
            return;
          }

          const objectUrl = URL.createObjectURL(file);

          // SVG tidak dicek dimensinya, sama seperti backend.
          if (!rules.minDim || file.type === 'image/svg+xml') {
            slot.previewUrl = objectUrl;
            return;
          }

          const img = new Image();
          img.onload = () => {
            const { minDim, maxDim } = rules;
            if (img.width < minDim || img.width > maxDim || img.height < minDim || img.height > maxDim) {
              URL.revokeObjectURL(objectUrl);
              this.setImageError(
                key,
                `Image is ${img.width}x${img.height}px. Required: ${minDim}x${minDim} to ${maxDim}x${maxDim} pixels`,
              );
              return;
            }
            slot.previewUrl = objectUrl;
          };
          img.onerror = () => {
            URL.revokeObjectURL(objectUrl);
            this.setImageError(key, 'Failed to load image');
          };
          img.src = objectUrl;
        },

        setImageError(key, message) {
          const slot = this.images[key];
          slot.errorMessage = message;
          slot.isValid = false;
          slot.previewUrl = null;
        },

        // Kembali ke gambar yang tersimpan; hanya blob URL yang perlu di-revoke.
        resetImage(key) {
          const slot = this.images[key];
          if (slot.previewUrl?.startsWith('blob:')) URL.revokeObjectURL(slot.previewUrl);
          Object.assign(slot, emptyImage(slot.existingUrl));
        },

        imageReady(slot) {
          return slot.hasFile ? slot.isValid : !!slot.existingUrl;
        },

        validateAll() {
          FIELD_PATHS.forEach((path) => {
            writePath(this.touched, path, true);
            writePath(this.formErrors, path, errorFor(path, readPath(this.formData, path)));
          });

          Object.entries(IMAGE_RULES).forEach(([key, rules]) => {
            const slot = this.images[key];
            if (!slot.hasFile && !slot.existingUrl) this.setImageError(key, `Please upload the ${rules.label}.`);
          });
        },

        hasFormErrors() {
          return FIELD_PATHS.some((path) => readPath(this.formErrors, path) !== '');
        },

        canSubmit() {
          return Object.values(this.images).every((slot) => this.imageReady(slot)) && !this.hasFormErrors();
        },

        // Error bisa berada di tab bahasa lain — pindah tab dulu, baru fokuskan.
        revealFirstInvalid() {
          const path = FIELD_PATHS.find((p) => readPath(this.formErrors, p));
          if (path) {
            const [field, lang] = path.split('.');
            if (lang) this.lang = lang;
            const id = field === 'type' ? 'type-trigger' : path.replace('.', '-');
            this.$nextTick(() => document.getElementById(id)?.focus());
            return;
          }

          const key = Object.keys(this.images).find((k) => !this.imageReady(this.images[k]));
          if (key) document.getElementById(key)?.parentElement.scrollIntoView({ block: 'center' });
        },

        // Tombol submit tidak pernah disabled; validasi dijalankan di sini.
        submitForm(event) {
          this.validateAll();
          if (!this.canSubmit()) {
            this.revealFirstInvalid();
            return;
          }

          this.loading = true;
          event.target.submit();
        },
      };
    };
  })();
</script>
