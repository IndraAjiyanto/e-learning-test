{{!--
  Halaman: Category — Super Admin
  Lokasi: src/views/super_admin/category/index.hbs
  Level: L4 Page

  Data: GET /category → { category }.
  Search & pagination dijalankan di client lewat clientTable().
  Kolom Action: View (detail), Edit (formEdit), Delete (lewat modal konfirmasi).

  `description` adalah kolom jsonb { id, en, ja } (entity masih menyebutnya
  string[], form yang benar), jadi tabelnya memakai tab bahasa seperti Value.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Category'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage program categories for Kesatria Academy.'
      }}
    </div>

    <div
      class='flex flex-col gap-3.5'
      x-data='clientTable({ items: {{json category}}, searchKeys: ["name", "description.id", "description.en", "description.ja"] })'
    >
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search category..'
        searchLabel='Search category'
        createHref='/category/formCreate'
        createLabel='Create Category'
      }}

      <div
        class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
        x-data="{ lang: 'id' }"
      >
        <div class='flex flex-col gap-4'>

          {{> components/ui/super_admin/tabs/language/index ariaLabel='Category language' }}

          {{#> components/ui/super_admin/table/card tableClass='min-w-[1010px]'}}
            <colgroup>
              <col class='w-[90px]' />
              <col class='w-[260px]' />
              <col class='w-[340px]' />
              <col class='w-[160px]' />
              <col class='w-[160px]' />
            </colgroup>
            <thead>
              <tr>
                {{> components/ui/super_admin/table/header_cell label='Icon' }}
                {{> components/ui/super_admin/table/header_cell label='Category Name' }}
                {{> components/ui/super_admin/table/header_cell label='Description' }}
                {{> components/ui/super_admin/table/header_cell label='Type' }}
                {{> components/ui/super_admin/table/header_cell label='Action' }}
              </tr>
            </thead>
            <tbody>
              <template x-for='row in rows' :key='row.id'>
                <tr class='transition-colors hover:bg-[#fafafa]'>
                  {{#> components/ui/super_admin/table/cell}}
                    {{> components/ui/super_admin/table/avatar src='row.icon' name='row.name' }}
                  {{/components/ui/super_admin/table/cell}}

                  {{> components/ui/super_admin/table/cell text='row.name' }}

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='block truncate font-inter text-sm leading-5 text-[#525252]'
                      x-text='(row.description && row.description[lang]) || "—"'
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    {{> components/ui/super_admin/badge/index
                      text='row.type'
                      class='bg-[#f9f5ff] text-[#6941c6]'
                    }}
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell variant='action'}}
                    <div class='flex items-center gap-1'>
                      <a
                        :href="'/category/' + row.id"
                        title='View category'
                        aria-label='View category'
                        class='flex h-10 w-10 items-center justify-center rounded-lg p-2.5 text-[#525252] transition-colors hover:bg-[#f5f5f5] hover:text-[#003060] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 active:bg-[#e5e5e5]'
                      >
                        {{!-- lucide: eye --}}
                        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.67' stroke-linecap='round' stroke-linejoin='round' class='h-5 w-5'>
                          <path d='M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z' />
                          <circle cx='12' cy='12' r='3' />
                        </svg>
                      </a>

                      <a
                        :href="'/category/formEdit/' + row.id"
                        title='Edit category'
                        aria-label='Edit category'
                        class='flex h-10 w-10 items-center justify-center rounded-lg p-2.5 text-[#525252] transition-colors hover:bg-[#f5f5f5] hover:text-[#003060] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 active:bg-[#e5e5e5]'
                      >
                        {{!-- lucide: square-pen --}}
                        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.67' stroke-linecap='round' stroke-linejoin='round' class='h-5 w-5'>
                          <path d='M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7' />
                          <path d='M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z' />
                        </svg>
                      </a>

                      <form :action="'/category/' + row.id + '?_method=DELETE'" method='post'>
                        <button
                          type='button'
                          @click="
                            if ((row.courses || []).length > 0) {
                              window.dispatchEvent(new CustomEvent('toast:error', {
                                detail: {
                                  title: 'Gagal Menghapus Kategori',
                                  description: 'Kategori &quot;' + row.name + '&quot; tidak dapat dihapus karena masih memiliki ' + (row.courses || []).length + ' program. Hapus atau pindahkan program tersebut terlebih dahulu.'
                                }
                              }));
                            } else {
                              openDeleteModal($el);
                            }
                          "
                          title='Delete category'
                          aria-label='Delete category'
                          class='flex h-10 w-10 items-center justify-center rounded-lg p-2.5 text-[#dc2626] transition-colors hover:bg-[#fef2f2] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#dc2626]/40 active:bg-[#fee2e2]'
                        >
                          {{!-- lucide: trash-2 --}}
                          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.67' stroke-linecap='round' stroke-linejoin='round' class='h-5 w-5'>
                            <path d='M3 6h18' />
                            <path d='M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6' />
                            <path d='M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2' />
                            <line x1='10' x2='10' y1='11' y2='17' />
                            <line x1='14' x2='14' y1='11' y2='17' />
                          </svg>
                        </button>
                      </form>
                    </div>
                  {{/components/ui/super_admin/table/cell}}
                </tr>
              </template>

              {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='5'}}
                No categories found.
              {{/components/ui/super_admin/table/message_row}}
            </tbody>
          {{/components/ui/super_admin/table/card}}
        </div>
      </div>
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Category?'
  description='Are you sure you want to delete this category? This action will permanently remove the category and cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}
