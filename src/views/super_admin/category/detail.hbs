{{!--
  Halaman: Detail Category — Super Admin
  Lokasi: src/views/super_admin/category/detail.hbs
  Level: L4 Page

  Route: GET /category/:categoryId -> { user, category }
         Edit   -> GET /category/formEdit/:categoryId
         Delete -> DELETE /category/:categoryId
  Tab mengambil data lewat toggleFetch(); konten tiap tab ada di partials/category/*.

  Tombol hapus memakai openDeleteModal dari modal/delete_confirm, bukan
  confirmDelete milik partial sweetalert global yang menimpa fungsi senama.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Detail Categories'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage and organize categories used across Kesatria Academy.'
      }}
    </div>

    <div class='flex flex-col gap-6 rounded-xl border border-[#d9d9d9] bg-white p-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-5'>
      <div class='flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between'>
        <a
          href='/category'
          class='inline-flex w-fit items-center gap-1 font-montserrat text-sm font-medium leading-5 text-[#525252] transition-colors hover:text-[#003060] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40'
        >
          {{!-- lucide: chevron-left --}}
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='h-4 w-4'>
            <path d='m15 18-6-6 6-6' />
          </svg>
          Back to categories
        </a>

        <div class='flex shrink-0 gap-3 self-end sm:self-auto'>
          <form action='/category/{{category.id}}?_method=DELETE' method='post'>
            {{> components/ui/super_admin/form/button
              variant='danger'
              label='Delete'
              onclick='openDeleteModal(this)'
            }}
          </form>

          {{> components/ui/super_admin/form/button
            as='link'
            href=(concat '/category/formEdit/' category.id)
            label='Edit Category'
          }}
        </div>
      </div>

      {{#if category.icon}}
        <div class='flex justify-center'>
          <img
            src='{{category.icon}}'
            alt='Icon {{category.name}}'
            class='h-40 w-full max-w-[222px] rounded-lg object-contain shadow-[0px_0px_6px_0px_rgba(0,0,0,0.15)] sm:h-[222px]'
          />
        </div>
      {{/if}}
    </div>

    <div class='flex flex-col gap-6 rounded-xl border border-[#d9d9d9] bg-white p-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-5'>
      {{> components/ui/super_admin/description/index
        text='Basic Information'
        class='font-montserrat text-xl font-semibold leading-6 text-[#003060]'
      }}

      <div class='grid grid-cols-1 gap-x-6 gap-y-5 md:grid-cols-2'>
        <div class='flex flex-col gap-5'>
          {{> components/ui/super_admin/detail/field/index label='Category Name' value=category.name }}

          {{> components/ui/super_admin/detail/field/index label='Type' value=category.type }}

          {{#if category.contact}}
            {{> components/ui/super_admin/detail/field/index label='Contact' value=category.contact }}
          {{/if}}

          {{#if category.courseTypes}}
            {{#> components/ui/super_admin/detail/field/index label='Type Program'}}
              <div class='flex flex-wrap gap-2'>
                {{#each category.courseTypes}}
                  <span class='inline-flex items-center gap-1.5 rounded-2xl border border-[#d9d9d9] bg-white px-3 py-1 font-inter text-xs font-medium leading-[18px] text-[#404040]'>
                    <i class='{{computeIcon this.icon}}'></i>
                    {{this.nameClassesType}}
                  </span>
                {{/each}}
              </div>
            {{/components/ui/super_admin/detail/field/index}}
          {{/if}}

          {{#if category.hero_section_image}}
            {{#> components/ui/super_admin/detail/field/index label='Hero Image'}}
              <img
                src='{{category.hero_section_image}}'
                alt='Hero {{category.name}}'
                class='h-32 w-48 rounded-lg border border-[#d9d9d9] object-cover lg:h-40 lg:w-56'
              />
            {{/components/ui/super_admin/detail/field/index}}
          {{/if}}
        </div>

        <div class='flex flex-col gap-5'>
          {{#if category.info}}
            {{> components/ui/super_admin/detail/field/index label='Info' value=category.info multilang=true }}
          {{/if}}

          {{#if category.text}}
            {{> components/ui/super_admin/detail/field/index label='Text' value=category.text multilang=true class='border-t border-[#d9d9d9] pt-5' }}
          {{/if}}

          {{#if category.for}}
            {{> components/ui/super_admin/detail/field/index label='For' value=category.for multilang=true class='border-t border-[#d9d9d9] pt-5' }}
          {{/if}}

          {{#if category.description}}
            {{> components/ui/super_admin/detail/field/index label='Description' value=category.description multilang=true class='border-t border-[#d9d9d9] pt-5' }}
          {{/if}}
        </div>
      </div>
    </div>

    <div
      class='flex flex-col gap-6 rounded-xl border border-[#d9d9d9] bg-white p-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-5'
      x-data='tabData()'
      x-init='init()'
    >
      <nav role='tablist' aria-label='Category sections' class='flex flex-wrap gap-4'>
        {{> components/ui/super_admin/tabs/fetch/index name='course' label='Program' url=(concat '/category/admin/program/' category.id) }}
        {{> components/ui/super_admin/tabs/fetch/index name='alumni' label='Alumni' url=(concat '/category/alumni/' category.id) }}
        {{> components/ui/super_admin/tabs/fetch/index name='gallery' label='Gallery' url=(concat '/category/gallery/' category.id) }}
        {{> components/ui/super_admin/tabs/fetch/index name='faq' label='FAQ' url=(concat '/category/faq/' category.id) }}
        {{> components/ui/super_admin/tabs/fetch/index name='benefit' label='Benefit' url=(concat '/category/benefit/' category.id) }}
      </nav>

      {{> category/kelas_tab }}

      {{> category/alumni_tab }}

      {{> category/faq_tab }}

      {{> category/benefit_tab }}

      {{> category/gallery_tab category=category }}
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Category?'
  description='Are you sure you want to delete this category? This action will permanently remove the category and cannot be undone.'
}}

<script>
  function tabData() {
    return {
      search: '',
      tab: localStorage.getItem('activeTabKategori') || 'course',
      data: localStorage.getItem('activeData')
        ? JSON.parse(localStorage.getItem('activeData'))
        : [],

      async init() {
        if (!this.tab) {
          this.tab = 'course';
          localStorage.setItem('activeTabKategori', 'course');
        }
      },

      async toggleFetch(url, tabName) {
        this.tab = tabName;
        localStorage.setItem('activeTabKategori', tabName);

        try {
          if (url === '') {
            this.data = [];
            localStorage.removeItem('activeData');
            return;
          }

          const response = await fetch(url);
          if (!response.ok) throw new Error('Network error');

          this.data = await response.json();
          localStorage.setItem('activeData', JSON.stringify(this.data));
        } catch (error) {
          console.error('Failed to fetch tab data:', error);
        }
      },
    };
  }
</script>
