{{!--
  Halaman: Detail Category — Super Admin
  Lokasi: src/views/super_admin/category/detail.hbs
  Level: L4 Page

  Route: GET /category/:categoryId -> { user, category }
         Edit   -> GET /category/formEdit/:categoryId
         Delete -> DELETE /category/:categoryId
  Tiap tab mengambil datanya sendiri via clientTable/fetch, jadi tombolnya memakai
  tabs/panel (hanya menukar state) dan lazy fetch memakai template x-if loaded[tab].

  Tombol hapus memakai openDeleteModal dari modal/delete_confirm, bukan
  confirmDelete milik partial sweetalert global yang menimpa fungsi senama.
--}}
{{#*inline 'multilangBox'}}
  <div class='flex flex-col gap-1.5'>
    <span class='font-inter text-sm font-semibold leading-5 text-[#404040]'>{{label}}</span>
    <div class='min-h-32 rounded-lg border border-[#d4d4d4] bg-white px-3.5 py-2.5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]'>
      <p x-show="lang === 'id'" class='whitespace-pre-line break-words font-inter text-base leading-6 text-[#171717]'>{{default value.id '-'}}</p>
      <p x-show="lang === 'en'" x-cloak class='whitespace-pre-line break-words font-inter text-base leading-6 text-[#171717]'>{{default value.en '-'}}</p>
      <p x-show="lang === 'ja'" x-cloak class='whitespace-pre-line break-words font-inter text-base leading-6 text-[#171717]'>{{default value.ja '-'}}</p>
    </div>
  </div>
{{/inline}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Detail Categories'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage and organize categories used across Kesatria Academy.'
      }}
    </div>

    <div class='flex flex-col gap-4'>
      <div class='flex flex-col gap-3.5 rounded-xl border border-[#d9d9d9] bg-white px-4 py-5 sm:px-5 sm:py-7'>
        <a
          href='/category'
          class='inline-flex w-fit items-center gap-1 font-inter text-base font-medium leading-5 text-[#718096] transition-colors hover:text-[#003060] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40'
        >
          {{!-- lucide: chevron-left --}}
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='h-4 w-4'>
            <path d='m15 18-6-6 6-6' />
          </svg>
          Back to categories
        </a>

        <div class='flex justify-end gap-3'>
          {{!-- Aksi hapus entitas di halaman detail digating `showDelete` dan mati secara
     default — hapus dilakukan dari halaman list/edit. Kirim showDelete=true
     dari controller bila suatu saat perlu ditampilkan lagi. Tombol hapus
     pada tabel/daftar di halaman ini sengaja TIDAK ikut digating. --}}
          {{#if showDelete}}
            <form action='/category/{{category.id}}?_method=DELETE' method='post'>
              {{> components/ui/super_admin/form/button
                variant='danger-soft'
                label='Delete'
                onclick='openDeleteModal(this)'
              }}
            </form>
          {{/if}}

          {{> components/ui/super_admin/form/button
            as='link'
            href=(concat '/category/formEdit/' category.id)
            label='Edit Category'
          }}
        </div>

        {{#if category.icon}}
          <div class='flex justify-center'>
            <img
              src='{{category.icon}}'
              alt='Icon {{category.name}}'
              class='aspect-square w-full max-w-[280px] rounded-lg bg-white object-contain shadow-[2px_2px_10px_0px_rgba(0,0,0,0.15)]'
            />
          </div>
        {{/if}}
      </div>

      <div class='flex flex-col gap-6 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:p-5' x-data="{ lang: 'id' }">
        {{!-- Tiga tab berlabel penuh lebih lebar dari layar 400px. --}}
        <div class='overflow-x-auto'>
          {{> components/ui/super_admin/tabs/language/index ariaLabel='Category content language' }}
        </div>

        <div class='flex items-center gap-2'>
          <span class='flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#003060] text-white' aria-hidden='true'>
            <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round' class='h-5 w-5'>
              <path d='M12 16v-5' />
              <path d='M12 7h.01' />
            </svg>
          </span>
          <h2 class='font-inter text-base font-semibold leading-6 text-[#003060]'>Basic Information</h2>
        </div>

        <div class='flex flex-col gap-5'>
          <div class='grid grid-cols-1 gap-3.5 sm:grid-cols-2 sm:gap-x-3'>
            {{!-- Satu label saja; nilainya ikut tab bahasa di atas, persis seperti
                 Description. Kolom EN/JA nullable, jadi nilai kosong berarti publik
                 memakai `name` — fallback nameByLang (sama seperti selisih di index). --}}
            {{#> components/ui/super_admin/detail/field/index label='Category Name'}}
              <p x-show="lang === 'id'" class='break-words font-inter text-sm font-medium leading-[22.75px] text-[#737373]'>{{default category.name '-'}}</p>
              <p x-show="lang === 'en'" x-cloak class='break-words font-inter text-sm font-medium leading-[22.75px] text-[#737373]'>{{default (nameByLang category 'en') '-'}}</p>
              <p x-show="lang === 'ja'" x-cloak class='break-words font-inter text-sm font-medium leading-[22.75px] text-[#737373]'>{{default (nameByLang category 'ja') '-'}}</p>
            {{/components/ui/super_admin/detail/field/index}}

            {{> components/ui/super_admin/detail/field/index label='Contact' value=category.contact }}

            {{> components/ui/super_admin/detail/field/index label='Type' value=category.type }}

            {{> components/ui/super_admin/detail/field/index label='Order Number' value=category.no }}

            {{#> components/ui/super_admin/detail/field/index label='Program Types'}}
              <div class='flex flex-wrap gap-1'>
                {{#each category.courseTypes}}
                  <span class='inline-flex items-center gap-1 rounded-2xl bg-[#f5f5f5] py-0.5 pl-1.5 pr-2 font-inter text-xs font-medium leading-[18px] text-[#404040]'>
                    <i class='{{computeIcon this.icon}}'></i>
                    {{this.nameClassesType}}
                  </span>
                {{else}}
                  <p class='font-inter text-sm font-medium leading-[22.75px] text-[#737373]'>-</p>
                {{/each}}
              </div>
            {{/components/ui/super_admin/detail/field/index}}
          </div>

          {{#> components/ui/super_admin/detail/field/index label='Hero Section Image'}}
            {{#if category.hero_section_image}}
              <img
                src='{{category.hero_section_image}}'
                alt='Hero {{category.name}}'
                class='h-40 w-full max-w-[360px] rounded-lg border border-[#d9d9d9] object-cover'
              />
            {{else}}
              <p class='font-inter text-sm font-medium leading-[22.75px] text-[#737373]'>-</p>
            {{/if}}
          {{/components/ui/super_admin/detail/field/index}}

          {{> multilangBox label='Text' value=category.text }}

          {{> multilangBox label='Description' value=category.description }}
        </div>
      </div>

      <div
        class='flex flex-col gap-5 rounded-xl border border-[#d9d9d9] bg-white px-4 pb-5 pt-3 sm:px-5'
        x-data='tabData()'
      >
        <nav role='tablist' aria-label='Category sections' class='flex overflow-x-auto border-b border-[#d9d9d9]'>
          {{> components/ui/super_admin/tabs/panel/index name='course' label='Program' }}
          {{#unless (eq category.type 'Free Program')}}
          {{> components/ui/super_admin/tabs/panel/index name='alumni' label='Alumni' }}
          {{/unless}}
          {{> components/ui/super_admin/tabs/panel/index name='gallery' label='Gallery' }}
          {{> components/ui/super_admin/tabs/panel/index name='faq' label='FAQ' }}
          {{> components/ui/super_admin/tabs/panel/index name='benefit' label='Benefit' }}
        </nav>

        <div x-show="tab === 'course'">
          <template x-if="loaded['course']">
            <div>{{> category/kelas_tab }}</div>
          </template>
        </div>

        {{#unless (eq category.type 'Free Program')}}
        <div x-show="tab === 'alumni'">
          <template x-if="loaded['alumni']">
            <div>{{> components/ui/super_admin/program/alumni_tab/index categoryId=category.id }}</div>
          </template>
        </div>
        {{/unless}}

        <div x-show="tab === 'gallery'">
          <template x-if="loaded['gallery']">
            <div>{{> category/gallery_tab category=category }}</div>
          </template>
        </div>

        <div x-show="tab === 'faq'">
          <template x-if="loaded['faq']">
            <div>{{> components/ui/super_admin/program/faq_tab/index categoryId=category.id }}</div>
          </template>
        </div>

        <div x-show="tab === 'benefit'">
          <template x-if="loaded['benefit']">
            <div>{{> components/ui/super_admin/program/benefit_tab/index categoryId=category.id }}</div>
          </template>
        </div>
      </div>
    </div>
  </div>
</div>

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}

{{> components/ui/super_admin/table/fa_icon }}

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Category?'
  description='Are you sure you want to delete this category? This action will permanently remove the category and cannot be undone.'
}}

<script>
  function tabData() {
    const isFree = {{#if (eq category.type 'Free Program')}}true{{else}}false{{/if}};
    const fallbackTab = 'course';
    const validTabs = isFree
      ? ['course', 'gallery', 'faq', 'benefit']
      : ['course', 'alumni', 'gallery', 'faq', 'benefit'];

    let initialTab = localStorage.getItem('activeTabKategori') || fallbackTab;
    if (!validTabs.includes(initialTab)) {
      initialTab = fallbackTab;
    }

    return {
      tab: initialTab,
      loaded: {},

      init() {
        this.$watch('tab', (tabName) => {
          this.loaded[tabName] = true;
          localStorage.setItem('activeTabKategori', tabName);
        });

        if (isFree && this.tab === 'alumni') {
          this.tab = fallbackTab;
        }

        if (!validTabs.includes(this.tab)) {
          this.tab = fallbackTab;
        }

        this.loaded[this.tab] = true;
      },
    };
  }
</script>
