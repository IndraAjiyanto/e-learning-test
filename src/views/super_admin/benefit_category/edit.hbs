{{!--
  Halaman: Edit Benefit Category — Super Admin
  Lokasi: src/views/super_admin/benefit_category/edit.hbs
  Level: L4 Page

  Route: GET /benefit_category/formEdit/:id -> PATCH /benefit_category/formEdit/:id/:categoryId
  (urlencoded + _method override). Data: { benefitCategory } dengan relasi category.

  Benefit category tidak punya kolom `no`, jadi kartu Display Order disembunyikan
  dan tombol aksi memakai kartu terpisah seperti create.hbs.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Benefit Category'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the benefit shown on this category program page'
      }}
    </div>

    {{!-- Nilai awal lewat helper json, bukan template literal: backtick atau
         ${ di data tidak lagi memecah skrip. --}}
    <form
      action='/benefit_category/formEdit/{{benefitCategory.id}}/{{benefitCategory.category.id}}?_method=PATCH'
      method='post'
      novalidate
      x-data='benefitForm({ icon: {{json benefitCategory.icon}}, title: {{json benefitCategory.title}}, description: {{json benefitCategory.description}}, withOrder: false })'
      @submit.prevent='submitForm($event)'
      class='flex flex-col gap-3.5'
    >
      {{> components/ui/super_admin/form/benefit/fields hideOrder=true }}

      <div class='flex flex-col-reverse gap-3 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:flex-row sm:justify-end sm:p-5'>
        {{> components/ui/super_admin/form/button
          as='link'
          variant='secondary'
          href=(concat '/category/' benefitCategory.category.id)
          label='Cancel'
          loading=true
        }}

        {{> components/ui/super_admin/form/button
          type='submit'
          variant='primary'
          label='Save Changes'
          loading=true
          disabled='!canSubmit() || loading'
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/benefit/form }}
