{{!--
  Halaman: Create Benefit Category — Super Admin
  Lokasi: src/views/super_admin/benefit_category/create.hbs
  Level: L4 Page

  Route: GET /benefit_category/formCreate/:categoryId -> POST /benefit_category/:categoryId
  (urlencoded). Data: { categoryId }.

  Field dikirim sebagai icon, title[id|en|ja], description[id|en|ja]. Benefit
  category tidak punya kolom `no`, jadi kartu Display Order disembunyikan.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Benefit Category'
      }}

      {{> components/ui/super_admin/description/index
        text='Add a benefit shown on this category program page'
      }}
    </div>

    <form
      action='/benefit_category/{{categoryId}}'
      method='post'
      novalidate
      x-data='benefitForm({ withOrder: false })'
      @submit.prevent='submitForm($event)'
      class='flex flex-col gap-3.5'
    >
      {{> components/ui/super_admin/form/benefit/fields hideOrder=true }}

      <div class='flex flex-col-reverse gap-3 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:flex-row sm:justify-end sm:p-5'>
        {{> components/ui/super_admin/form/button
          as='link'
          variant='secondary'
          href=(concat '/category/' categoryId)
          label='Cancel'
          loading=true
        }}

        {{> components/ui/super_admin/form/button
          type='submit'
          variant='primary'
          label='Create Benefit Category'
          loading=true
          disabled='!canSubmit() || loading'
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/benefit/form }}
