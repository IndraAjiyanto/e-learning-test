{{!--
  Halaman: Edit Paragraph — Super Admin
  Lokasi: src/views/super_admin/paragraphs/edit.hbs
  Level: L4 Page

  Route: GET /paragraphs/formEdit/:id
         -> PATCH /paragraphs/:id (urlencoded + _method override, paragraphs[id|en|ja]).
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Paragraph'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the paragraph content in Indonesian, English, and Japanese.'
      }}
    </div>

    <form
      action='/paragraphs/{{paragraphs.id}}?_method=PATCH'
      method='post'
      novalidate
      x-data='{ ...paragraphsForm({ paragraphs: {{json paragraphs.paragraphs}} }), ...formDirtyGate() }'
      x-init='$nextTick(() => captureBaseline())'
      @input='recomputeDirty()'
      @change='recomputeDirty()'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
    >
      <div class='flex flex-col gap-5'>
        {{> components/ui/super_admin/tabs/language/index ariaLabel='Paragraph language' }}

        {{> components/ui/super_admin/form/paragraphs/fields }}

        <div class='flex flex-col-reverse gap-3 pt-6 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href='/paragraphs'
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Save Changes'
            loading=true
            disabled='!canSubmit() || !isDirty || loading'
          }}
        </div>
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/paragraphs/form }}
