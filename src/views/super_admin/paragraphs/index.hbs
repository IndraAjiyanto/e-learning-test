{{!--
  Halaman: Paragraf — Super Admin
  Lokasi: src/views/super_admin/paragraphs/index.hbs
  Level: L4 Page

  Data: GET /paragraphs → { paragraphs }, kolom `paragraphs` berbentuk jsonb { id, en, ja }.
  Search & pagination dijalankan di client lewat clientTable().

  `lang` hidup di scope Alpine bersarang: getter `rows` dan `totalPages`
  milik clientTable() akan hilang bila state digabung.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Paragraf'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage the paragraphs displayed on the About page of Kesatria Academy.'
      }}
    </div>

    <div
      class='flex flex-col gap-3.5'
      x-data='clientTable({ items: {{json paragraphs}}, searchKeys: ["paragraphs.id", "paragraphs.en", "paragraphs.ja"] })'
    >
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search paragraf..'
        searchLabel='Search paragraf'
        createHref='/paragraphs/formCreate'
        createLabel='Create Paragraf'
      }}

      <div
        class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
        x-data="{ lang: 'id' }"
      >
        <div class='flex flex-col gap-5'>

          {{> components/ui/super_admin/tabs/language/index ariaLabel='Paragraf language' }}

          {{#> components/ui/super_admin/table/card tableClass='min-w-[760px]'}}
            <colgroup>
              <col class='w-[66px]' />
              <col />
              <col class='w-[116px]' />
            </colgroup>
            <thead>
              <tr>
                {{> components/ui/super_admin/table/header_cell label='No' }}
                {{> components/ui/super_admin/table/header_cell label='Paragraf' }}
                {{> components/ui/super_admin/table/header_cell label='Action' }}
              </tr>
            </thead>
            <tbody>
              <template x-for='(row, index) in rows' :key='row.id'>
                <tr class='transition-colors hover:bg-[#fafafa]'>

                  {{> components/ui/super_admin/table/cell
                    text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
                  }}

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='line-clamp-2 font-inter text-sm leading-5 text-[#525252]'
                      x-text="(row.paragraphs && row.paragraphs[lang]) || '—'"
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell variant='action'}}
                    {{> components/ui/super_admin/table/row_actions
                      entity='paragraf'
                      deleteAction="'/paragraphs/' + row.id + '?_method=DELETE'"
                      editHref="'/paragraphs/formEdit/' + row.id"
                    }}
                  {{/components/ui/super_admin/table/cell}}
                </tr>
              </template>

              {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='3'}}
                No paragraphs found.
              {{/components/ui/super_admin/table/message_row}}
            </tbody>
          {{/components/ui/super_admin/table/card}}
        </div>
      </div>
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Paragraf?'
  description='Are you sure you want to delete this paragraph? This action will permanently remove its content in all languages and cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}
