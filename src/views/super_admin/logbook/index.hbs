      <button
        @click='openDetail = false'
        class='absolute top-3 right-3 text-gray-500 hover:text-gray-800'
      >
        ✕
      </button>

      <h2 class='text-xl font-semibold mb-6 text-gray-900'>Logbook Details</h2>

      <!-- Grid Layout -->
      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
        <!-- Left Column -->
        <div class='space-y-4'>
          <!-- Info Kelas & Pertemuan -->
          <div class='bg-gray-50 p-4 rounded-lg'>
            <h3 class='font-semibold text-gray-900 mb-3'>Class & Meeting
              Information</h3>
            <div class='space-y-2 text-sm text-gray-700'>
              <p><strong>Class:</strong>
                <span
                  x-text="selectedLog?.pertemuan?.minggu?.kelas?.nama_kelas ?? '-'"
                  class='ml-2'
                ></span></p>
              <p><strong>Week:</strong>
                <span
                  x-text="selectedLog?.pertemuan?.minggu?.minggu_ke ?? '-'"
                  class='ml-2'
                ></span></p>
              <p><strong>Meeting:</strong>
                <span
                  x-text="selectedLog?.pertemuan?.pertemuan_ke ?? '-'"
                  class='ml-2'
                ></span></p>
            </div>
          </div>

          <!-- Info User -->
          <div class='bg-gray-50 p-4 rounded-lg'>
            <h3 class='font-semibold text-gray-900 mb-3'>User Information</h3>
            <div class='space-y-2 text-sm text-gray-700'>
              <p><strong>Name:</strong>
                <span
                  x-text="selectedLog?.user?.nama ?? '-'"
                  class='ml-2'
                ></span></p>
              <p><strong>Email:</strong>
                <span
                  x-text="selectedLog?.user?.email ?? '-'"
                  class='ml-2'
                ></span></p>
              <p><strong>Username:</strong>
                <span
                  x-text="selectedLog?.user?.username ?? '-'"
                  class='ml-2'
                ></span></p>
            </div>
          </div>
        </div>

        <!-- Right Column -->
        <div class='space-y-4'>
          <!-- Info Logbook -->
          <div class='bg-gray-50 p-4 rounded-lg'>
            <h3 class='font-semibold text-gray-900 mb-3'>Logbook Details</h3>
            <div class='space-y-3 text-sm text-gray-700'>
              <div>
                <p class='font-medium text-gray-900'>Activity:</p>
                <p x-text='selectedLog?.kegiatan' class='mt-1'></p>
              </div>
              <div>
                <p class='font-medium text-gray-900'>Activity Details:</p>
                <p x-text='selectedLog?.rincian_kegiatan' class='mt-1'></p>
              </div>
              <template x-if='selectedLog?.proses'>
                <div>
                  <p class='font-medium text-gray-900'>Process:</p>
                  <p x-text='selectedLog?.proses' class='mt-1'></p>
                </div>
              </template>
              <div>
                <p class='font-medium text-gray-900'>Obstacles:</p>
                <p x-text='selectedLog?.kendala' class='mt-1'></p>
              </div>
              <template x-if='selectedLog?.dokumentasi_lain'>
                <div>
                  <p class='font-medium text-gray-900'>Other Documentation:</p>
                  <p x-text='selectedLog?.dokumentasi_lain' class='mt-1'></p>
                </div>
              </template>
              <div>
                <p class='font-medium text-gray-900'>Created Date:</p>
                <p x-text='selectedLog?.createdAt' class='mt-1'></p>
              </div>
              <div>
                <p class='font-medium text-gray-900'>Updated Date:</p>
                <p x-text='selectedLog?.updatedAt' class='mt-1'></p>
              </div>
            </div>
          </div>

          <!-- Dokumentasi -->
          <template x-if='selectedLog?.dokumentasi'>
            <div class='bg-gray-50 p-4 rounded-lg'>
              <h3 class='font-semibold text-gray-900 mb-3'>Documentation</h3>
              <img
                :src='selectedLog?.dokumentasi'
                alt='Documentation'
                class='rounded-lg border max-h-48 object-contain w-full'
              />
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>
</div>

<script
  src='https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js'
></script>