<div
  x-data="{ 
    tab: 'user', 
    openDetail: false, 
    selectedLog: null,
    search: '',
    filterKelas: '',
    pageNumberUser: 0,
    pageNumberMentor: 0,
    size: 5,
    logbook: {{json logbook}},
    logbook_mentor: {{json logbook_mentor}},
    kelas: {{json kelas}},
    get filteredLogbook() {
      return this.logbook.filter(item => 
        item.kegiatan.toLowerCase().includes(this.search.toLowerCase()) ||
        item.rincian_kegiatan?.toLowerCase().includes(this.search.toLowerCase()) ||
        item.kendala?.toLowerCase().includes(this.search.toLowerCase()) ||
        item.dokumentasi_lain?.toLowerCase().includes(this.search.toLowerCase()) ||
        item.user?.nama?.toLowerCase().includes(this.search.toLowerCase()) ||
        item.user?.email?.toLowerCase().includes(this.search.toLowerCase()) ||
        item.user?.username?.toLowerCase().includes(this.search.toLowerCase()) ||
        (this.filterKelas === '' || item.pertemuan.minggu.kelas.nama_kelas === this.filterKelas)
      );
    },
    get filteredLogbookMentor() {
      return this.logbook_mentor.filter(item => 
        item.kegiatan.toLowerCase().includes(this.search.toLowerCase()) ||
        item.rincian_kegiatan?.toLowerCase().includes(this.search.toLowerCase()) ||
        item.kendala?.toLowerCase().includes(this.search.toLowerCase()) ||
        item.user?.nama?.toLowerCase().includes(this.search.toLowerCase()) ||
        item.user?.email?.toLowerCase().includes(this.search.toLowerCase()) ||
        item.user?.username?.toLowerCase().includes(this.search.toLowerCase()) ||
        (this.filterKelas === '' || item.pertemuan.minggu.kelas.nama_kelas === this.filterKelas)
      );
    },
    get paginatedLogbook() {
      const start = this.pageNumberUser * this.size;
      return this.filteredLogbook.slice(start, start + this.size);
    },
    get paginatedLogbookMentor() {
      const start = this.pageNumberMentor * this.size;
      return this.filteredLogbookMentor.slice(start, start + this.size);
    },
    get uniqueKelas() {
      return this.kelas.map(k => k.nama_kelas);
    },
    get pageCountUser() {
      return Math.ceil(this.filteredLogbook.length / this.size);
    },
    get pageCountMentor() {
      return Math.ceil(this.filteredLogbookMentor.length / this.size);
    },
    pagesUser() {
      return Array.from({ length: this.pageCountUser });
    },
    pagesMentor() {
      return Array.from({ length: this.pageCountMentor });
    },
    nextPageUser() {
      if (this.pageNumberUser < this.pageCountUser - 1) {
        this.pageNumberUser++;
      }
    },
    prevPageUser() {
      if (this.pageNumberUser > 0) {
        this.pageNumberUser--;
      }
    },
    viewPageUser(index) {
      this.pageNumberUser = index;
    },
    nextPageMentor() {
      if (this.pageNumberMentor < this.pageCountMentor - 1) {
        this.pageNumberMentor++;
      }
    },
    prevPageMentor() {
      if (this.pageNumberMentor > 0) {
        this.pageNumberMentor--;
      }
    },
    viewPageMentor(index) {
      this.pageNumberMentor = index;
    },
    exportExcel() {
      const data = this.tab === 'user' ? this.filteredLogbook : this.filteredLogbookMentor;
      const headers = this.tab === 'user' 
        ? ['No', 'Name', 'Email', 'Username', 'Kelas', 'Minggu', 'Pertemuan', 'Kegiatan', 'Rincian Kegiatan', 'Proses', 'Kendala', 'Dokumentasi', 'Dokumentasi Lain', 'Tanggal Dibuat', 'Tanggal Update']
        : ['No', 'Name', 'Email', 'Username', 'Kelas', 'Minggu', 'Pertemuan', 'Kegiatan', 'Rincian Kegiatan', 'Kendala', 'Dokumentasi', 'Tanggal Dibuat', 'Tanggal Update'];
      
      const wsData = [
        headers,
        ...data.map((item, index) => {
          const baseData = [
            index + 1,
            item.user?.nama || '',
            item.user?.email || '',
            item.user?.username || '',
            item.pertemuan?.minggu?.kelas?.nama_kelas || '',
            item.pertemuan?.minggu?.minggu_ke || '',
            item.pertemuan?.pertemuan_ke || '',
            item.kegiatan,
            item.rincian_kegiatan,
            item.kendala,
            item.dokumentasi || '',
            item.createdAt,
            item.updatedAt
          ];
          
          // Add proses and dokumentasi_lain for user logbook
          if (this.tab === 'user') {
            baseData.splice(9, 0, item.proses || ''); // Insert proses after Rincian Kegiatan
            baseData.splice(11, 0, item.dokumentasi_lain || ''); // Insert dokumentasi_lain after Dokumentasi
          }
          
          return baseData;
        })
      ];
      const ws = XLSX.utils.aoa_to_sheet(wsData);
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, 'Logbook');
      XLSX.writeFile(wb, 'logbook.xlsx');
    }
  }"
  class='max-w-7xl mx-auto px-6 py-10'
