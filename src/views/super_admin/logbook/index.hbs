  <!-- Modal Detail -->
  <div
    x-show='openDetail'
    x-transition
    class='fixed inset-0 bg-black/40 flex items-center justify-center z-50'
  >
    <div
      @click.away='openDetail = false'
      class='bg-white rounded-xl p-6 max-w-4xl w-full shadow-lg relative max-h-[90vh] overflow-y-auto'
