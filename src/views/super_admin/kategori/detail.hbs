<div class='py-10 w-full mx-auto px-6'>
  <!-- ===================== CARD DETAIL KATEGORI ===================== -->
  <div
    class='mb-6 mx-auto px-6 py-10 bg-white rounded-2xl shadow-xl space-y-8 relative'
  >

    <!-- Tombol Back -->
    <div>
      <a
        href='/kategoris'
        class='inline-flex items-center text-gray-600 text-base font-medium hover:underline'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='h-5 w-5 mr-1'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='2'
            d='M15 19l-7-7 7-7'
          />
        </svg>
        Back
      </a>
    </div>

    <!-- Tombol Aksi (Top Right Corner) -->
    <div class='absolute top-4 right-4 flex items-center gap-2 z-10'>
      <!-- Tombol Edit -->
      <a
        href='/kategoris/formEdit/{{kategori.id}}'
        class='p-2 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 hover:text-blue-800 transition shadow-sm'
        title='Edit Category'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          fill='none'
          viewBox='0 0 24 24'
          stroke-width='2'
          stroke='currentColor'
          class='w-4 h-4'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M16.862 4.487l1.687-1.688a1.875 1.875
                   0 112.652 2.652L10.582 16.07a4.5
                   4.5 0 01-1.897 1.13l-2.685.805.805-2.685
                   a4.5 4.5 0 011.13-1.897l10.927-10.936z'
          />
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M19.5 7.125L16.875 4.5'
          />
        </svg>
      </a>

      <!-- Tombol Delete -->
      <form
        action='/kategoris/{{kategori.id}}?_method=DELETE'
        method='post'
        class='inline'
      >
        <button
          type='button'
          onclick='confirmDelete(this)'
          class='p-2 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-800 transition shadow-sm'
          title='Delete Category'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            fill='none'
            viewBox='0 0 24 24'
            stroke-width='2'
            stroke='currentColor'
            class='w-4 h-4'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M6 18L18 6M6 6l12 12'
            />
          </svg>
        </button>
      </form>
    </div>

    <!-- Image and Description Row -->
    <div class='flex flex-col lg:flex-row gap-4 mb-4'>

      <!-- Gambar Kategori -->
      <div class='flex-shrink-0'>
        <img
          src='{{kategori.icon}}'
          alt='Icon {{kategori.nama_kategori}}'
          class='w-48 h-32 lg:w-56 lg:h-40 object-cover rounded-lg shadow-md'
        />
      </div>

      <!-- Description Section -->
      <div class='flex-1 bg-white rounded-lg p-3 border border-gray-200'>
        <h3 class='text-sm font-semibold text-gray-800 mb-2 flex items-center'>
          <svg
            class='w-4 h-4 mr-2 text-gray-600'
            fill='none'
            stroke='currentColor'
            viewBox='0 0 24 24'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M4 6h16M4 10h16M4 14h16M4 18h16'
            ></path>
          </svg>
          Description
        </h3>
        <p
          class='text-gray-700 leading-relaxed text-sm'
        >{{kategori.deskripsi}}</p>
      </div>
    </div>

    <!-- Info Cards Below -->
    <div class='grid grid-cols-1 md:grid-cols-2 gap-3'>
      <!-- Basic Information -->
      <div class='bg-gray-50 rounded-lg p-3'>
        <h3 class='text-sm font-semibold text-gray-800 mb-2 flex items-center'>
          <svg
            class='w-4 h-4 mr-2 text-blue-600'
            fill='none'
            stroke='currentColor'
            viewBox='0 0 24 24'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
            ></path>
          </svg>
          Basic Information
        </h3>
        <div class='space-y-1 text-xs'>
          <p><span class='font-medium text-gray-600'>Category Name:</span>
            <span class='text-gray-800'>{{kategori.nama_kategori}}</span></p>
          {{#if kategori.nama_kategori_uniq}}
            <p><span class='font-medium text-gray-600'>Unique Name:</span>
              <span
                class='text-gray-800'
              >{{kategori.nama_kategori_uniq}}</span></p>
          {{/if}}
          {{#if kategori.info}}
            <p><span class='font-medium text-gray-600'>Info:</span>
              <span
                class='text-gray-800'
              >{{kategori.info}}</span></p>
          {{/if}}
          <p><span class='font-medium text-gray-600'>Type:</span>
            <span class='text-gray-800'>{{kategori.type}}</span></p>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================== TAB SECTION ===================== -->
  <div
    class='mx-auto px-6 py-10 bg-white rounded-2xl shadow-xl'
    x-data="{ tab: 'kelas' }"
  >

    <!-- Tab Navigation -->
    <div class='flex space-x-4 mb-6'>
      <button
        @click="tab = 'kelas'"
        :class="tab === 'kelas' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Classes
      </button>
      <button
        @click="tab = 'alumni'"
        :class="tab === 'alumni' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Alumni
      </button>
      <button
        @click="tab = 'faq'"
        :class="tab === 'faq' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
          FAQ
      </button>
      <button
        @click="tab = 'benefit'"
        :class="tab === 'benefit' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Benefit
      </button>
      <button
        @click="tab = 'flow'"
        :class="tab === 'flow' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Flow
      </button>
    </div>

    <!-- Tab Content -->
    <div x-show="tab === 'kelas'" class='space-y-4'>
      <div class='flex justify-between items-center mb-4'>
        <h3 class='text-lg font-semibold text-gray-800'>Classes in this Category</h3>
        <a
          href='/kelass/formCreate?kategori={{kategori.id}}'
          class='bg-gray-900 text-white px-4 py-2 rounded-lg shadow hover:bg-gray-600 transition'
        >
          Add Class
        </a>
      </div>

      {{#if kelas}}
        <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4'>
          {{#each kelas}}
            <div
              class='bg-white border border-gray-200 rounded-lg shadow-md overflow-hidden hover:shadow-lg transition'
            >
              <div class='p-4'>
                <div class='flex items-center mb-3'>
                  <img
                    src='{{this.gambar}}'
                    alt='{{this.nama_kelas}}'
                    class='w-12 h-12 object-cover rounded-lg mr-3'
                  />
                  <div>
                    <h4
                      class='font-semibold text-gray-800 text-sm'
                    >{{this.nama_kelas}}</h4>
                    <p
                      class='text-xs text-gray-600'
                    >{{this.jenis_kelas.nama_jenis_kelas}}</p>
                  </div>
                </div>
                <p
                  class='text-xs text-gray-700 mb-3 line-clamp-2'
                >{{this.deskripsi}}</p>
                <div class='flex justify-between items-center'>
                  <span
                    class='text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded'
                  >{{this.user_kelas.length}} students</span>
                  <a
                    href='/kelass/detail/kelas/admin/{{this.id}}'
                    class='text-blue-600 hover:text-blue-800 text-xs font-medium'
                  >
                    View Details →
                  </a>
                </div>
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class='text-center py-8'>
          <svg
            class='mx-auto h-12 w-12 text-gray-400'
            fill='none'
            stroke='currentColor'
            viewBox='0 0 24 24'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M12 6v6m0 0v6m0-6h6m-6 0H6'
            ></path>
          </svg>
          <h3 class='mt-2 text-sm font-medium text-gray-900'>No classes</h3>
          <p class='mt-1 text-sm text-gray-500'>Get started by creating a new
            class.</p>
          <div class='mt-6'>
            <a
              href='/kelass/formCreate?kategori={{kategori.id}}'
              class='inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-gray-900 hover:bg-gray-700'
            >
              <svg
                class='-ml-1 mr-2 h-5 w-5'
                fill='none'
                stroke='currentColor'
                viewBox='0 0 24 24'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M12 6v6m0 0v6m0-6h6m-6 0H6'
                ></path>
              </svg>
              Add Class
            </a>
          </div>
        </div>
      {{/if}}
    </div>
  </div>
</div>

<script>
  function confirmDelete(button) { const form = button.closest('form');
  Swal.fire({ title: 'Are you sure?', text: "You won't be able to revert this!",
  icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33',
  cancelButtonColor: '#3085d6', confirmButtonText: 'Yes, delete it!'
  }).then((result) => { if (result.isConfirmed) { form.submit(); } }); }
</script>