<div class='py-10 w-full mx-auto px-6'>
  <!-- ===================== CARD DETAIL KATEGORI ===================== -->
  <div
    class='mb-6 mx-auto px-6 py-10 bg-white rounded-2xl shadow-xl space-y-8 relative'
  >

    <!-- Tombol Back -->
    <div>
      <a
        href='/category'
        class='inline-flex items-center text-gray-600 text-base font-medium hover:underline'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='h-5 w-5 mr-1'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='2'
            d='M15 19l-7-7 7-7'
          />
        </svg>
        Back
      </a>
    </div>

    <!-- Tombol Aksi (Top Right Corner) -->
    <div class='absolute top-4 right-4 flex items-center gap-2 z-10'>
      <!-- Tombol Edit -->
      <a
        href='/category/formEdit/{{kategori.id}}'
        class='p-2 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 hover:text-blue-800 transition shadow-sm'
        title='Edit Category'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          fill='none'
          viewBox='0 0 24 24'
          stroke-width='2'
          stroke='currentColor'
          class='w-4 h-4'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M16.862 4.487l1.687-1.688a1.875 1.875
                   0 112.652 2.652L10.582 16.07a4.5
                   4.5 0 01-1.897 1.13l-2.685.805.805-2.685
                   a4.5 4.5 0 011.13-1.897l10.927-10.936z'
          />
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M19.5 7.125L16.875 4.5'
          />
        </svg>
      </a>

      <!-- Tombol Delete -->
      <form
        action='/category/{{kategori.id}}?_method=DELETE'
        method='post'
        class='inline'
      >
        <button
          type='button'
          onclick='confirmDelete(this)'
          class='p-2 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-800 transition shadow-sm'
          title='Delete Category'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            fill='none'
            viewBox='0 0 24 24'
            stroke-width='2'
            stroke='currentColor'
            class='w-4 h-4'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244
  2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0
  0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09
  2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0'
            />
          </svg>
        </button>
      </form>
    </div>

    <!-- Image and Description Row -->
    <div class='space-y-4 mb-4'>

      <!-- Gambar Kategori -->
      <div class='flex justify-center'>
        <img
          src='{{kategori.icon}}'
          alt='Icon {{kategori.nama_kategori}}'
          class='w-64 h-48 object-cover rounded-lg shadow-md'
        />
      </div>

      <!-- Description Section -->
      <div class='bg-gray-50 rounded-lg p-4'>
        <h3 class='text-base font-semibold text-gray-800 mb-3 flex items-center'>
          <svg
            class='w-5 h-5 mr-2 text-blue-600'
            fill='none'
            stroke='currentColor'
            viewBox='0 0 24 24'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
            ></path>
          </svg>
          Basic Information
        </h3>
<div class='space-y-4 text-sm'>

  {{! Field pendek - pakai grid 2 kolom }}
  <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>

    <div class='space-y-1'>
      <span class='text-xs font-semibold uppercase tracking-wide text-gray-500'>Category Name</span>
      <p class='text-gray-800'>{{kategori.nama_kategori}}</p>
    </div>

    <div class='space-y-1'>
      <span class='text-xs font-semibold uppercase tracking-wide text-gray-500'>Type</span>
      <p class='text-gray-800'>{{kategori.type}}</p>
    </div>

    {{#if kategori.contact}}
      <div class='space-y-1'>
        <span class='text-xs font-semibold uppercase tracking-wide text-gray-500'>Contact</span>
        <p class='text-gray-800'>{{kategori.contact}}</p>
      </div>
    {{/if}}

  </div>

  {{! Field multilingual - full width dengan badge bahasa }}
  {{#if kategori.info}}
    <div class='space-y-2 border-t pt-4'>
      <span class='text-xs font-semibold uppercase tracking-wide text-gray-500'>Info</span>
      <div class='space-y-1'>
        <div class='flex gap-2'>
          <span class='shrink-0 text-xs font-medium bg-blue-100 text-blue-700 rounded px-1.5 py-0.5'>ID</span>
          <p class='text-gray-800'>{{kategori.info.id}}</p>
        </div>
        <div class='flex gap-2'>
          <span class='shrink-0 text-xs font-medium bg-green-100 text-green-700 rounded px-1.5 py-0.5'>EN</span>
          <p class='text-gray-800'>{{kategori.info.en}}</p>
        </div>
        <div class='flex gap-2'>
          <span class='shrink-0 text-xs font-medium bg-red-100 text-red-700 rounded px-1.5 py-0.5'>JA</span>
          <p class='text-gray-800'>{{kategori.info.ja}}</p>
        </div>
      </div>
    </div>
  {{/if}}

  {{#if kategori.text}}
    <div class='space-y-2 border-t pt-4'>
      <span class='text-xs font-semibold uppercase tracking-wide text-gray-500'>Text</span>
      <div class='space-y-1'>
        <div class='flex gap-2'>
          <span class='shrink-0 text-xs font-medium bg-blue-100 text-blue-700 rounded px-1.5 py-0.5'>ID</span>
          <p class='text-gray-800'>{{kategori.text.id}}</p>
        </div>
        <div class='flex gap-2'>
          <span class='shrink-0 text-xs font-medium bg-green-100 text-green-700 rounded px-1.5 py-0.5'>EN</span>
          <p class='text-gray-800'>{{kategori.text.en}}</p>
        </div>
        <div class='flex gap-2'>
          <span class='shrink-0 text-xs font-medium bg-red-100 text-red-700 rounded px-1.5 py-0.5'>JA</span>
          <p class='text-gray-800'>{{kategori.text.ja}}</p>
        </div>
      </div>
    </div>
  {{/if}}

  {{#if kategori.for}}
    <div class='space-y-2 border-t pt-4'>
      <span class='text-xs font-semibold uppercase tracking-wide text-gray-500'>For</span>
      <div class='space-y-1'>
        <div class='flex gap-2'>
          <span class='shrink-0 text-xs font-medium bg-blue-100 text-blue-700 rounded px-1.5 py-0.5'>ID</span>
          <p class='text-gray-800'>{{kategori.for.id}}</p>
        </div>
        <div class='flex gap-2'>
          <span class='shrink-0 text-xs font-medium bg-green-100 text-green-700 rounded px-1.5 py-0.5'>EN</span>
          <p class='text-gray-800'>{{kategori.for.en}}</p>
        </div>
        <div class='flex gap-2'>
          <span class='shrink-0 text-xs font-medium bg-red-100 text-red-700 rounded px-1.5 py-0.5'>JA</span>
          <p class='text-gray-800'>{{kategori.for.ja}}</p>
        </div>
      </div>
    </div>
  {{/if}}

  {{#if kategori.deskripsi}}
    <div class='space-y-2 border-t pt-4'>
      <span class='text-xs font-semibold uppercase tracking-wide text-gray-500'>Description</span>
      <div class='space-y-1'>
        <div class='flex gap-2'>
          <span class='shrink-0 text-xs font-medium bg-blue-100 text-blue-700 rounded px-1.5 py-0.5'>ID</span>
          <p class='text-gray-800'>{{kategori.deskripsi.id}}</p>
        </div>
        <div class='flex gap-2'>
          <span class='shrink-0 text-xs font-medium bg-green-100 text-green-700 rounded px-1.5 py-0.5'>EN</span>
          <p class='text-gray-800'>{{kategori.deskripsi.en}}</p>
        </div>
        <div class='flex gap-2'>
          <span class='shrink-0 text-xs font-medium bg-red-100 text-red-700 rounded px-1.5 py-0.5'>JA</span>
          <p class='text-gray-800'>{{kategori.deskripsi.ja}}</p>
        </div>
      </div>
    </div>
  {{/if}}

  {{#if kategori.jenis_kelas}}
    <div class='space-y-2 border-t pt-4'>
      <span class='text-xs font-semibold uppercase tracking-wide text-gray-500'>Type Program</span>
      <div class='flex flex-wrap gap-2'>
        {{#each kategori.jenis_kelas}}
          <span class='inline-flex items-center gap-1.5 px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-medium'>
            <i class="{{computeIcon this.icon}}"></i>
            {{this.nama_jenis_kelas}}
          </span>
        {{/each}}
      </div>
    </div>
  {{/if}}

</div>
      </div>
    </div>

  </div>

  <!-- ===================== TAB SECTION ===================== -->
  <div
    class='mx-auto px-6 py-10 bg-white rounded-2xl shadow-xl'
    x-data="tabData()" x-init="init()"
  >

    <!-- Tab Navigation -->
    <div class='flex space-x-4 mb-6'>
      <button
        @click="toggleFetch('/category/admin/program/{{kategori.id}}', 'kelas')"
        :class="tab === 'kelas' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Program
      </button>
      <button
        @click="toggleFetch('/category/alumni/{{kategori.id}}', 'alumni')"
        :class="tab === 'alumni' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Alumni
      </button>

    {{#if (eq kategori.type 'Special Program') }}
      <button
        @click="toggleFetch('/category/faq/{{kategori.id}}', 'faq')"
        :class="tab === 'faq' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        FAQ
      </button>
      <button
        @click="toggleFetch('/category/benefit/{{kategori.id}}', 'benefit')"
        :class="tab === 'benefit' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Benefit
      </button>
      <button
        @click="toggleFetch('/category/superiority/{{kategori.id}}', 'superiority')"
        :class="tab === 'superiority' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Superiority
      </button>
      <button
        @click="toggleFetch('/category/flow/{{kategori.id}}', 'flow')"
        :class="tab === 'flow' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Flow
      </button>
    {{/if}}

    </div>

    <!-- Tab Content -->
    {{> kategori/kelas_tab }}

    {{> kategori/alumni_tab }}

    {{> kategori/faq_tab }}

    {{> kategori/benefit_tab }}

    {{> kategori/superiority_tab }}

    {{> kategori/flow_tab }}
</div>
</div>

<script>
function tabData() {
  return {
    search: '',
    tab: localStorage.getItem('activeTabKategori') || 'kelas',
    data: localStorage.getItem('activeData')
      ? JSON.parse(localStorage.getItem('activeData'))
      : [],

    async init() {
      if( !this.tab ) {
          this.tab = 'kelas';
          localStorage.setItem('activeTabKategori', 'kelas');
      }
    },
    
    async toggleFetch(url, tabName) {
      this.tab = tabName;
      localStorage.setItem('activeTabKategori', tabName);
      
      try {
        if(url === '') {
          this.data = [];
          localStorage.removeItem('activeData');
          return;
        }else{
          const response = await fetch(url);
        if (!response.ok) throw new Error('Network error');
        
        this.data = await response.json();
        localStorage.setItem('activeData', JSON.stringify(this.data));
        }
      } catch (error) {
      }
    }
  }
}
</script>