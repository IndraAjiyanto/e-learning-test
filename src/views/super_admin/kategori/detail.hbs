<div class='py-10 w-full mx-auto px-6'>
  <!-- ===================== CARD DETAIL KATEGORI ===================== -->
  <div
    class='mb-6 mx-auto px-6 py-10 bg-white rounded-2xl shadow-xl space-y-8 relative'
  >

    <!-- Tombol Back -->
    <div>
      <a
        href='/kategoris'
        class='inline-flex items-center text-gray-600 text-base font-medium hover:underline'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='h-5 w-5 mr-1'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='2'
            d='M15 19l-7-7 7-7'
          />
        </svg>
        Back
      </a>
    </div>

    <!-- Tombol Aksi (Top Right Corner) -->
    <div class='absolute top-4 right-4 flex items-center gap-2 z-10'>
      <!-- Tombol Edit -->
      <a
        href='/kategoris/formEdit/{{kategori.id}}'
        class='p-2 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 hover:text-blue-800 transition shadow-sm'
        title='Edit Category'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          fill='none'
          viewBox='0 0 24 24'
          stroke-width='2'
          stroke='currentColor'
          class='w-4 h-4'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M16.862 4.487l1.687-1.688a1.875 1.875
                   0 112.652 2.652L10.582 16.07a4.5
                   4.5 0 01-1.897 1.13l-2.685.805.805-2.685
                   a4.5 4.5 0 011.13-1.897l10.927-10.936z'
          />
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M19.5 7.125L16.875 4.5'
          />
        </svg>
      </a>

      <!-- Tombol Delete -->
      <form
        action='/kategoris/{{kategori.id}}?_method=DELETE'
        method='post'
        class='inline'
      >
        <button
          type='button'
          onclick='confirmDelete(this)'
          class='p-2 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-800 transition shadow-sm'
          title='Delete Category'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            fill='none'
            viewBox='0 0 24 24'
            stroke-width='2'
            stroke='currentColor'
            class='w-4 h-4'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M6 18L18 6M6 6l12 12'
            />
          </svg>
        </button>
      </form>
    </div>

    <!-- Image and Description Row -->
    <div class='space-y-4 mb-4'>

      <!-- Gambar Kategori -->
      <div class='flex justify-center'>
        <img
          src='{{kategori.icon}}'
          alt='Icon {{kategori.nama_kategori}}'
          class='w-64 h-48 object-cover rounded-lg shadow-md'
        />
      </div>

      <!-- Description Section -->
      <div class='bg-gray-50 rounded-lg p-4'>
        <h3 class='text-base font-semibold text-gray-800 mb-3 flex items-center'>
          <svg
            class='w-5 h-5 mr-2 text-blue-600'
            fill='none'
            stroke='currentColor'
            viewBox='0 0 24 24'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
            ></path>
          </svg>
          Basic Information
        </h3>
        <div class='grid grid-cols-1 md:grid-cols-2 gap-3 text-sm'>
          <div>
            <span class='font-medium text-gray-600'>Category Name:</span>
            <span class='text-gray-800 ml-2'>{{kategori.nama_kategori}}</span>
          </div>
          {{#if kategori.info}}
            <div>
              <span class='font-medium text-gray-600'>Info:</span>
              <span class='text-gray-800 ml-2'>{{kategori.info.id}}</span>
              <span class='text-gray-800 ml-2'>{{kategori.info.en}}</span>
              <span class='text-gray-800 ml-2'>{{kategori.info.ja}}</span>
            </div>
          {{/if}}
          <div>
            <span class='font-medium text-gray-600'>Type:</span>
            <span class='text-gray-800 ml-2'>{{kategori.type}}</span>
          </div>
          {{#if kategori.text}}
            <div>
              <span class='font-medium text-gray-600'>Text:</span>
              <span class='text-gray-800 ml-2'>{{kategori.text.id}}</span>
              <span class='text-gray-800 ml-2'>{{kategori.text.en}}</span>
              <span class='text-gray-800 ml-2'>{{kategori.text.ja}}</span>
            </div>
          {{/if}}
          {{#if kategori.contact}}
            <div>
              <span class='font-medium text-gray-600'>Contact:</span>
              <span class='text-gray-800 ml-2'>{{kategori.contact}}</span>
            </div>
          {{/if}}
          {{#if kategori.for}}
            <div>
              <span class='font-medium text-gray-600'>For:</span>
              <span class='text-gray-800 ml-2'>{{kategori.for.id}}</span>
              <span class='text-gray-800 ml-2'>{{kategori.for.en}}</span>
              <span class='text-gray-800 ml-2'>{{kategori.for.ja}}</span>
            </div>
          {{/if}}
          {{#if kategori.jenis_kelas}}
            <div class='md:col-span-2'>
              <span class='font-medium text-gray-600'>Type Program:</span>
              <p class='text-gray-800 mt-1'>
                {{#each kategori.jenis_kelas}}
                  <i class="{{computeIcon this.icon}}"></i> {{this.nama_jenis_kelas}}
                {{/each}}
              </p>
            </div>
          {{/if}}
          {{#if kategori.deskripsi}}
            <div class='md:col-span-2'>
              <span class='font-medium text-gray-600'>Description:</span>
              <p class='text-gray-800 mt-1'>{{kategori.deskripsi.id}}</p>
              <p class='text-gray-800 mt-1'>{{kategori.deskripsi.en}}</p>
              <p class='text-gray-800 mt-1'>{{kategori.deskripsi.ja}}</p>
            </div>
          {{/if}}

        </div>
      </div>
    </div>

    <!-- Info Cards Below -->
      <!-- Basic Information -->

  </div>

  <!-- ===================== TAB SECTION ===================== -->
  <div
    class='mx-auto px-6 py-10 bg-white rounded-2xl shadow-xl'
    x-data="tabData()" x-init="init()"
  >

    <!-- Tab Navigation -->
    <div class='flex space-x-4 mb-6'>
      <button
        @click="toggleFetch('/kategoris/kelas/{{kategori.id}}', 'kelas')"
        :class="tab === 'kelas' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Program
      </button>
      <button
        @click="toggleFetch('/kategoris/alumni/{{kategori.id}}', 'alumni')"
        :class="tab === 'alumni' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Alumni
      </button>
      <button
        @click="toggleFetch('/kategoris/faq/{{kategori.id}}', 'faq')"
        :class="tab === 'faq' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        FAQ
      </button>
      <button
        @click="toggleFetch('/kategoris/benefit/{{kategori.id}}', 'benefit')"
        :class="tab === 'benefit' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Benefit
      </button>
      <button
        @click="toggleFetch('/kategoris/superiority/{{kategori.id}}', 'superiority')"
        :class="tab === 'superiority' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Superiority
      </button>
      <button
        @click="toggleFetch('/kategoris/flow/{{kategori.id}}', 'flow')"
        :class="tab === 'flow' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700'"
        class='px-4 py-2 rounded-lg shadow transition'
      >
        Flow
      </button>
    </div>

    <!-- Tab Content -->
    {{> kategori/kelas_tab }}

    {{> kategori/alumni_tab }}

    {{> kategori/faq_tab }}

    {{> kategori/benefit_tab }}

    {{> kategori/superiority_tab }}

    {{> kategori/flow_tab }}
</div>
</div>

<script>
function tabData() {
  return {
    search: '',
    tab: localStorage.getItem('activeTabKategori') || 'kelas',
    data: localStorage.getItem('activeData')
      ? JSON.parse(localStorage.getItem('activeData'))
      : [],

    async init() {
      if( !this.tab ) {
          this.tab = 'kelas';
          localStorage.setItem('activeTabKategori', 'kelas');
      }
    },
    
    async toggleFetch(url, tabName) {
      this.tab = tabName;
      localStorage.setItem('activeTabKategori', tabName);
      
      try {
        if(url === '') {
          this.data = [];
          localStorage.removeItem('activeData');
          console.log('ℹ️ No data to fetch for this tab.');
          return;
        }else{
          const response = await fetch(url);
        if (!response.ok) throw new Error('Network error');
        
        this.data = await response.json();
        localStorage.setItem('activeData', JSON.stringify(this.data));
        console.log('✅ Data fetched:', this.data);
        }
      } catch (error) {
        console.error('❌ Error:', error);
      }
    }
  }
}
</script>