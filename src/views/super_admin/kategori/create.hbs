          <!-- Jenis Kelas -->
          <div
            class='space-y-2'
            x-data="{
    searchJenisKelas: '',
    selectedJenisKelas: [],
    showJenisKelasDropdown: false,

    availableJenisKelas: {{json jenisKelas}},

    // Filter Jenis Kelas yg belum dipilih + sesuai pencarian
    get filteredJenisKelas() {
