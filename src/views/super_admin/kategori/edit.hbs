<script>
 function categoryFormData() {
  return {

    /* ============================================================
     * STATE
     * ============================================================ */

    previewUrl: `{{kategori.icon}}` || null,
    errorMessage: '',
    isValid: true,
    fileName: `{{kategori.icon}}` ? 'Current Icon' : '',
    fileSize: 0,
    imageWidth: 0,
    imageHeight: 0,
    hasFile: `{{kategori.icon}}` ? true : false,
    hasOldIcon: `{{kategori.icon}}` ? true : false,
    oldIcon: `{{kategori.icon}}` || '',

    formData: {
      nama_kategori: `{{kategori.nama_kategori}}`,
      deskripsi: {
        id: `{{kategori.deskripsi.id}}`,
        en: `{{kategori.deskripsi.en}}`,
        ja: `{{kategori.deskripsi.ja}}`
      },
      text: {
        id: `{{kategori.text.id}}`,
        en: `{{kategori.text.en}}`,
        ja: `{{kategori.text.ja}}`
      },
      contact: `{{kategori.contact}}`,
      for: {
        id: `{{kategori.for.id}}`,
        en: `{{kategori.for.en}}`,
        ja: `{{kategori.for.ja}}`
      },
      jenis_kelas: [],
      info_id: {{{json kategori.info_id}}} || [''],
      info_en: {{{json kategori.info_en}}} || [''],
      info_ja: {{{json kategori.info_ja}}} || [''],
      type: `{{kategori.type}}`,
    },

    selectedJenisKelas: {{{json kategori.jenis_kelas}}},
    searchJenisKelas: '',
    showJenisKelasDropdown: false,
    availableJenisKelas: {{{json jenisKelas}}},

    infos: {{#if kategori.info}}
      {{{json kategori.info}}}
    {{else}}
      ['']
    {{/if}},

    /* ============================================================
     * ERROR STATES
     * ============================================================ */

    formErrors: {
      nama_kategori: '',
      deskripsi: { id: '', en: '', ja: '' },
      text:       { id: '', en: '', ja: '' },
      contact: '',
      for:        { id: '', en: '', ja: '' },
      jenis_kelas: '',
      info_id: '',
      info_en: '',
      info_ja: '',
      type: '',
    },

    /* ============================================================
     * FIELD VALID STATES
     * ============================================================ */

    formValid: {
      nama_kategori: true,
      deskripsi: { id: true, en: true, ja: true },
      text:      { id: false, en: false, ja: false },
      contact: false,
      for:       { id: false, en: false, ja: false },
      jenis_kelas: {{{json kategori.jenis_kelas}}}.length > 0,
      info_id: {{{json kategori.info_id}}} && {{{json kategori.info_id}}}.some(info => info.trim()),
      info_en: {{{json kategori.info_en}}} && {{{json kategori.info_en}}}.some(info => info.trim()),
      info_ja: {{{json kategori.info_ja}}} && {{{json kategori.info_ja}}}.some(info => info.trim()),
      type: true,
    },

    /* ============================================================
     * TOUCHED STATES
     * ============================================================ */

    formTouched: {
      nama_kategori: true,
      deskripsi: { id: true, en: true, ja: true },
      text:      { id: false, en: false, ja: false },
      contact: false,
      for:       { id: false, en: false, ja: false },
      jenis_kelas: {{{json kategori.jenis_kelas}}}.length > 0,
      info_id: true,
      info_en: true,
      info_ja: true,
      type: true,
    },

    /* ============================================================
     * INIT
     * ============================================================ */

    init() {
      this.formData.jenis_kelas = this.selectedJenisKelas.map(jk => jk.id);
    },

    /* ============================================================
     * IMAGE VALIDATION
     * ============================================================ */

    validateImage(file) {
      if (!file) {
        this.hasFile = false;
        return;
      }

      this.hasFile = true;
      this.fileName = file.name;
      this.fileSize = file.size;
      this.errorMessage = '';
      this.isValid = true;

      const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
      const maxSize = 5 * 1024 * 1024;

      if (!allowedTypes.includes(file.type)) {
        this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
        this.isValid = false;
        this.previewUrl = null;
        return;
      }

      if (file.size > maxSize) {
        const sizeMB = (file.size / 1024 / 1024).toFixed(2);
        this.errorMessage = `File size too large (${sizeMB}MB). Maximum 5MB`;
        this.isValid = false;
        this.previewUrl = null;
        return;
      }

      const img = new Image();
      const objectUrl = URL.createObjectURL(file);

      img.onload = () => {
        this.imageWidth = img.width;
        this.imageHeight = img.height;

        if (img.width < 1000 || img.width > 2000 || img.height < 1000 || img.height > 2000) {
          this.errorMessage =
            `Image dimensions ${img.width}x${img.height}px. ` +
            `Required: 1000x1000 to 2000x2000 pixels`;
          this.isValid = false;
          this.previewUrl = null;
        } else {
          this.previewUrl = objectUrl;
          this.isValid = true;
          this.errorMessage = '';
        }

        URL.revokeObjectURL(objectUrl);
      };

      img.onerror = () => {
        this.errorMessage = 'Failed to load image';
        this.isValid = false;
        this.previewUrl = null;
        URL.revokeObjectURL(objectUrl);
      };

      img.src = objectUrl;
    },

    /* ============================================================
     * INFO VALIDATION
     * ============================================================ */

    validateInfo(lang, infos) {
      this.formTouched['info_' + lang] = true;

      const hasValidInfo = infos && infos.some(info => info.trim());

      if (!hasValidInfo) {
        this.formErrors['info_' + lang] = 'At least one info item is required for ' + lang.toUpperCase();
        this.formValid['info_' + lang] = false;
      } else {
        this.formErrors['info_' + lang] = '';
        this.formValid['info_' + lang] = true;
      }
    },

    /* ============================================================
     * FIELD VALIDATION (ALL TYPES)
     * ============================================================ */

    validateField(field, value, lang = null) {
      if (lang) {
        this.formData[field][lang] = value;
        this.formTouched[field][lang] = true;
      } else {
        this.formData[field] = value;
        this.formTouched[field] = true;
      }

      switch (field) {
        case 'nama_kategori':
          this.formValid.nama_kategori = !!value.trim();
          this.formErrors.nama_kategori = this.formValid.nama_kategori ? '' : 'Category name is required';
          break;

        case 'deskripsi':
          this.formValid.deskripsi[lang] = !!value.trim();
          this.formErrors.deskripsi[lang] = this.formValid.deskripsi[lang] ? '' : 'Description is required';
          break;

        case 'type':
          this.formValid.type = !!value;
          this.formErrors.type = value ? '' : 'Type is required';
          break;

        case 'text':
          this.formValid.text[lang] = value.trim().length > 0;
          this.formErrors.text[lang] = '';
          break;

        case 'contact':
          if (value && isNaN(Number(value))) {
            this.formErrors.contact = 'Contact must be a valid number';
            this.formValid.contact = false;
          } else {
            this.formErrors.contact = '';
            this.formValid.contact = value.toString().trim().length > 0;
          }
          break;

        case 'for':
          this.formValid.for[lang] = value.trim().length > 0;
          this.formErrors.for[lang] = '';
          break;

        case 'jenis_kelas':
          this.formValid.jenis_kelas = Array.isArray(value) && value.length > 0;
          this.formErrors.jenis_kelas = '';
          break;
      }
    },

    /* ============================================================
     * MULTISELECT: JENIS KELAS
     * ============================================================ */

    selectJenisKelas(jk) {
      if (!this.selectedJenisKelas.some(s => s.id === jk.id)) {
        this.selectedJenisKelas.push(jk);
        this.formData.jenis_kelas = this.selectedJenisKelas.map(s => s.id);
        this.validateField('jenis_kelas', this.formData.jenis_kelas);
      }
      this.searchJenisKelas = '';
      this.showJenisKelasDropdown = false;
    },

    removeJenisKelas(id) {
      this.selectedJenisKelas = this.selectedJenisKelas.filter(s => s.id !== id);
      this.formData.jenis_kelas = this.selectedJenisKelas.map(s => s.id);
      this.validateField('jenis_kelas', this.formData.jenis_kelas);
    },

    get filteredJenisKelas() {
      return this.availableJenisKelas.filter(jk =>
        jk.nama_jenis_kelas.toLowerCase().includes(this.searchJenisKelas.toLowerCase()) &&
        !this.selectedJenisKelas.some(s => s.id === jk.id)
      );
    },

    /* ============================================================
     * CLEAR FILE
     * ============================================================ */

    clearFile() {
      this.previewUrl   = this.hasOldIcon ? this.oldIcon : null;
      this.errorMessage = '';
      this.isValid      = true;
      this.fileName     = this.hasOldIcon ? 'Current Icon' : '';
      this.fileSize     = 0;
      this.imageWidth   = 0;
      this.imageHeight  = 0;
      this.hasFile      = this.hasOldIcon;

      if (this.$refs.fileInput) {
        this.$refs.fileInput.value = null;
      }
    },

    /* ============================================================
     * FORM HELPERS
     * ============================================================ */

    canSubmit() {
      const imageValid       = (this.hasOldIcon && !this.hasFile) || (this.hasFile && this.isValid);
      const namaKategoriValid = this.formValid.nama_kategori;
      const deskripsiValid   = Object.values(this.formValid.deskripsi).every(v => v);
      const typeValid        = this.formValid.type;
      const infoValid        = this.formValid.info_id || this.formValid.info_en || this.formValid.info_ja;

      return imageValid && namaKategoriValid && deskripsiValid && typeValid && infoValid;
    },

    hasFormErrors() {
      const checkObject = (obj) => {
        if (typeof obj === 'object' && obj !== null) {
          return Object.values(obj).some(val =>
            typeof val === 'object' ? checkObject(val) : val !== ''
          );
        }
        return obj !== '';
      };

      return Object.values(this.formErrors).some(error => checkObject(error));
    },

  };
}
</script>

<div class='py-10' x-data='categoryFormData()'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Category</h2>

    <form
      action='/category/{{kategori.id}}?_method=PATCH'
      method='POST'
      enctype='multipart/form-data'
      class='space-y-6'
      x-data='{ loading: false }'
      @submit.prevent="if (canSubmit()) { loading = true; $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

      <!-- Form Fields Grid -->
      <div class='grid grid-cols-2 gap-6'>
        <!-- Left Column -->
        <div class='space-y-6'>

        {{> super_admin/category/edit/left_column/name_input }}
        {{> super_admin/category/edit/left_column/text_input }}
        {{> super_admin/category/edit/left_column/contact_input }}
        {{> super_admin/category/edit/left_column/for_input }}
        {{> super_admin/category/edit/left_column/type_program_input }}

        </div>

        <!-- Right Column -->
        <div class='space-y-6'>

        {{> super_admin/category/edit/right_column/type_input }}
        {{> super_admin/category/edit/right_column/image_input }}
        {{> super_admin/category/edit/right_column/description_input }}
        {{> super_admin/category/edit/right_column/info_input }}

        </div>
      </div>

      <template x-if='hasFormErrors() || (hasFile && !isValid)'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500 flex-shrink-0'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>

      <div class='flex gap-3 pt-4'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span
            x-show='loading'
            class='loading loading-spinner loading-sm'
          ></span>
          <span x-show='!loading'>Update</span>
        </button>
        <a
          href='/category/{{kategori.id}}'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'
        >
          Cancel
        </a>
      </div>

    </form>
  </div>
</div>