<script>
  // Alpine.js Component Data (Dipisah dari HTML)
  function categoryFormData() {
    return {
      /* ============================
       * STATE
       ============================ */
      previewUrl: '{{kategori.icon}}' || null,
      errorMessage: '',
      isValid: true,

      fileName: '{{kategori.icon}}' ? 'Current Icon' : '',
      fileSize: 0,
      imageWidth: 0,
      imageHeight: 0,

      hasFile: '{{kategori.icon}}' ? true : false,
      hasOldIcon: '{{kategori.icon}}' ? true : false,
      oldIcon: '{{kategori.icon}}' || '',

      formData: {
        nama_kategori: '{{kategori.nama_kategori}}',
        nama_kategori_uniq: '{{kategori.nama_kategori_uniq}}',
        deskripsi: '{{kategori.deskripsi}}',
        type: '{{kategori.type}}'
      },

      infos:
        {{#if kategori.info}}
          {{{json kategori.info}}}
        {{else}}
          ['']
        {{/if}},

      formErrors: {
        nama_kategori: '',
        nama_kategori_uniq: '',
        deskripsi: '',
        info: '',
        type: ''
      },

      formValid: {
        nama_kategori: true,
        nama_kategori_uniq: '{{kategori.nama_kategori_uniq}}' ? true : false,
        deskripsi: true,
        info:
          {{{json kategori.info}}} &&
          {{{json kategori.info}}}.some(info => info.trim()) ? true : false,
        type: true
      },

      /* ============================
       * IMAGE VALIDATION
       ============================ */
      validateImage(file) {
        if (!file) {
          this.hasFile = false;
          return;
        }

        this.hasFile = true;
        this.fileName = file.name;
        this.fileSize = file.size;
        this.errorMessage = '';
        this.isValid = true;

        const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];

        // File type validation
        if (!allowedTypes.includes(file.type)) {
          this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
          this.isValid = false;
          this.previewUrl = null;
          return;
        }

        // File size validation
        const maxSize = 5 * 1024 * 1024;
        if (file.size > maxSize) {
          const sizeMB = (file.size / 1024 / 1024).toFixed(2);
          this.errorMessage = `File size too large (${sizeMB}MB). Maximum 5MB`;
          this.isValid = false;
          this.previewUrl = null;
          return;
        }

        // Image dimension validation
        const img = new Image();
        const objectUrl = URL.createObjectURL(file);

        img.onload = () => {
          this.imageWidth = img.width;
          this.imageHeight = img.height;

          if (
            img.width < 1000 || img.width > 2000 ||
            img.height < 1000 || img.height > 2000
          ) {
            this.errorMessage =
              `Image dimensions ${img.width}x${img.height}px. ` +
              `Required: 1000x1000 to 2000x2000 pixels`;

            this.isValid = false;
            this.previewUrl = null;

            URL.revokeObjectURL(objectUrl);
          } else {
            this.previewUrl = objectUrl;
            this.isValid = true;
            this.errorMessage = '';
          }
        };

        img.onerror = () => {
          this.errorMessage = 'Failed to load image';
          this.isValid = false;
          this.previewUrl = null;

          URL.revokeObjectURL(objectUrl);
        };

        img.src = objectUrl;
      },

      /* ============================
       * FIELD VALIDATION
       ============================ */
      validateInfo(infos) {
        const hasValidInfo = infos && infos.some(info => info.trim());

        if (!hasValidInfo) {
          this.formErrors.info = 'At least one info item is required';
          this.formValid.info = false;
        } else {
          this.formErrors.info = '';
          this.formValid.info = true;
        }
      },

      validateField(field, value) {
        this.formData[field] = value;

        switch (field) {
          case 'nama_kategori':
            if (!value || !value.trim()) {
              this.formErrors.nama_kategori = 'Category name is required';
              this.formValid.nama_kategori = false;
            } else {
              this.formErrors.nama_kategori = '';
              this.formValid.nama_kategori = true;
            }
            break;

          case 'nama_kategori_uniq':
            if (!value || !value.trim()) {
              this.formErrors.nama_kategori_uniq = 'Unique category name is required';
              this.formValid.nama_kategori_uniq = false;
            } else {
              this.formErrors.nama_kategori_uniq = '';
              this.formValid.nama_kategori_uniq = true;
            }
            break;

          case 'deskripsi':
            if (!value || !value.trim()) {
              this.formErrors.deskripsi = 'Description is required';
              this.formValid.deskripsi = false;
            } else {
              this.formErrors.deskripsi = '';
              this.formValid.deskripsi = true;
            }
            break;

          case 'type':
            if (!value) {
              this.formErrors.type = 'Type is required';
              this.formValid.type = false;
            } else {
              this.formErrors.type = '';
              this.formValid.type = true;
            }
            break;
        }
      },

      /* ============================
       * CLEAR FILE
       ============================ */
      clearFile() {
        this.previewUrl = this.hasOldIcon ? this.oldIcon : null;
        this.errorMessage = '';
        this.isValid = true;

        this.fileName = this.hasOldIcon ? 'Current Icon' : '';
        this.fileSize = 0;
        this.imageWidth = 0;
        this.imageHeight = 0;

        this.hasFile = this.hasOldIcon;

        if (this.$refs.fileInput) {
          this.$refs.fileInput.value = null;
        }
      },

      /* ============================
       * FORM STATE HELPERS
       ============================ */
      canSubmit() {
        const imageValid =
          (this.hasOldIcon && !this.hasFile) ||
          (this.hasFile && this.isValid);

        const formValid =
          this.formValid.nama_kategori &&
          this.formValid.nama_kategori_uniq &&
          this.formValid.deskripsi &&
          this.formValid.info &&
          this.formValid.type;

        return imageValid && formValid;
      },

      hasFormErrors() {
        return Object.values(this.formErrors).some(error => error !== '');
      }
    };
  }
</script>


<div class='py-10' x-data='categoryFormData()'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Category</h2>

    <form
      action='/kategoris/{{kategori.id}}?_method=PATCH'
      method='POST'
      enctype='multipart/form-data'
      class='space-y-6'
      @submit.prevent="if (canSubmit()) { $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

      <!-- Form Fields Grid -->
      <div class='grid grid-cols-2 gap-6'>
        <!-- Left Column -->
        <div class='space-y-6'>
          <!-- Nama Kategori -->
          <div class='space-y-2'>
            <label
              for='nama_kategori'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >
              Category Name
            </label>
            <input
              type='text'
              id='nama_kategori'
              name='nama_kategori'
              required
              :class="formErrors.nama_kategori ? 'border-red-500 focus:ring-red-500' : formValid.nama_kategori && formData.nama_kategori ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              @input='validateField("nama_kategori", $event.target.value)'
              x-model='formData.nama_kategori'
            />

            <template x-if='formErrors.nama_kategori'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.nama_kategori'
                ></p>
              </div>
            </template>

            <template
              x-if='formValid.nama_kategori && !formErrors.nama_kategori && formData.nama_kategori'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid category name</p>
              </div>
            </template>
          </div>

          <!-- Nama Kategori Uniq -->
          <div class='space-y-2'>
            <label
              for='nama_kategori_uniq'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >
              Unique Category Name
            </label>
            <input
              type='text'
              id='nama_kategori_uniq'
              name='nama_kategori_uniq'
              required
              :class="formErrors.nama_kategori_uniq ? 'border-red-500 focus:ring-red-500' : formValid.nama_kategori_uniq && formData.nama_kategori_uniq ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              @input='validateField("nama_kategori_uniq", $event.target.value)'
              x-model='formData.nama_kategori_uniq'
            />

            <template x-if='formErrors.nama_kategori_uniq'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.nama_kategori_uniq'
                ></p>
              </div>
            </template>

            <template
              x-if='formValid.nama_kategori_uniq && !formErrors.nama_kategori_uniq && formData.nama_kategori_uniq'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid unique category name</p>
              </div>
            </template>
          </div>

          <!-- Info -->
          <div>
            <label
              class='block text-sm font-semibold text-gray-700 mb-2'
            >Info</label>
            <template x-for='(info, index) in infos' :key='index'>
              <div class='flex items-center gap-3 mb-3'>
                <input
                  type='text'
                  x-model='infos[index]'
                  name='info[]'
                  placeholder='Enter info item'
                  class='flex-1 border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
                  @input='validateInfo(infos)'
                />
                <button
                  type='button'
                  @click='infos.splice(index,1); validateInfo(infos)'
                  x-show='infos.length > 1'
                  class='text-red-500 hover:text-red-700 font-bold text-lg w-8 h-8 flex items-center justify-center'
                >
                  ✕
                </button>
              </div>
            </template>
            <button
              type='button'
              @click="infos.push(''); validateInfo(infos)"
              class='w-full border-2 border-dashed border-gray-300 rounded-lg px-4 py-2 text-gray-500 hover:border-gray-500 hover:text-gray-700 flex items-center justify-center transition'
            >
              + Add Info
            </button>

            <!-- Error Message -->
            <template x-if='formErrors.info'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg mt-2'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.info'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.info && !formErrors.info'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg mt-2'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid info</p>
              </div>
            </template>
          </div>
        </div>

        <!-- Right Column -->
        <div class='space-y-6'>
          <!-- Type -->
          <div class='space-y-2'>
            <label
              for='type'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >
              Type
            </label>
            <select
              id='type'
              name='type'
              required
              :class="formErrors.type ? 'border-red-500 focus:ring-red-500' : formValid.type && formData.type ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              @change='validateField("type", $event.target.value)'
              x-model='formData.type'
            >
              <option value=''>Select Type</option>
              <option value='Special Program'>Special Program</option>
              <option value='Program'>Program</option>
            </select>

            <template x-if='formErrors.type'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.type'></p>
              </div>
            </template>

            <template
              x-if='formValid.type && !formErrors.type && formData.type'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid type</p>
              </div>
            </template>
          </div>

          <!-- Icon Image -->
          <div class='space-y-3'>
            <label
              for='icon'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >
              Icon Image
              <span class='text-xs text-gray-500 font-normal'>(1000x1000 -
                2000x2000px, max 5MB, JPG/PNG)</span>
            </label>

            <input
              type='file'
              id='icon'
              name='icon'
              accept='image/jpeg,image/jpg,image/png'
              x-ref='fileInput'
              :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-900 file:text-white hover:file:bg-gray-700 file:cursor-pointer'
              @change='validateImage($event.target.files[0])'
            />

            <template x-if='!isValid && errorMessage'>
              <div
                class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
              >
                <i
                  class='fas fa-exclamation-circle text-red-500 mt-0.5 flex-shrink-0'
                ></i>
                <div class='flex-1 min-w-0'>
                  <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
                  <p
                    class='text-xs text-red-700 break-words'
                    x-text='errorMessage'
                  ></p>
                </div>
              </div>
            </template>

            <template x-if='hasFile && isValid'>
              <div class='space-y-2'>
                <div
                  class='flex items-center justify-between p-3 bg-green-50 border border-green-300 rounded-lg'
                >
                  <div class='flex items-center gap-2 flex-1 min-w-0'>
                    <i
                      class='fas fa-check-circle text-green-500 flex-shrink-0'
                    ></i>
                    <div class='min-w-0 flex-1'>
                      <p
                        class='text-sm font-semibold text-green-800 truncate'
                        x-text='fileName'
                      ></p>
                      <p class='text-xs text-green-700' x-show='fileSize > 0'>
                        <span
                          x-text='(fileSize / 1024 / 1024).toFixed(2)'
                        ></span>
                        MB •
                        <span x-text='imageWidth'></span>x<span
                          x-text='imageHeight'
                        ></span>
                        px
                      </p>
                      <p
                        class='text-xs text-green-700'
                        x-show='fileSize === 0 && hasOldIcon'
                      >
                        Existing icon (no changes)
                      </p>
                    </div>
                  </div>
                  <button
                    type='button'
                    @click='clearFile()'
                    class='text-red-500 hover:text-red-700 transition-colors flex-shrink-0 ml-2'
                    title='Remove image'
                    x-show='!hasOldIcon || fileSize > 0'
                  >
                    <i class='fas fa-times'></i>
                  </button>
                </div>

                <div class='relative w-32 h-32'>
                  <img
                    :src='previewUrl'
                    alt='Icon Preview'
                    class='w-32 h-32 object-cover rounded-lg border-2 border-green-500 shadow-sm'
                  />
                  <button
                    type='button'
                    @click='clearFile()'
                    class='absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center hover:bg-red-700 transition-colors'
                    title='Remove image'
                    x-show='!hasOldIcon || fileSize > 0'
                  >
                    <i class='fas fa-times text-xs'></i>
                  </button>
                </div>

                <p
                  class='text-xs text-gray-500'
                  x-show='hasOldIcon && fileSize === 0'
                >
                  <i class='fas fa-info-circle'></i>
                  This is the current icon. Upload a new file to replace it.
                </p>
              </div>
            </template>
          </div>

          <!-- Deskripsi -->
          <div class='space-y-2'>
            <label
              for='deskripsi'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >
              Description
            </label>
            <textarea
              id='deskripsi'
              name='deskripsi'
              rows='4'
              required
              :class="formErrors.deskripsi ? 'border-red-500 focus:ring-red-500' : formValid.deskripsi && formData.deskripsi ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              @input='validateField("deskripsi", $event.target.value)'
              x-model='formData.deskripsi'
            ></textarea>

            <template x-if='formErrors.deskripsi'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.deskripsi'
                ></p>
              </div>
            </template>

            <template
              x-if='formValid.deskripsi && !formErrors.deskripsi && formData.deskripsi'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid description</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <template x-if='hasFormErrors() || (hasFile && !isValid)'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500 flex-shrink-0'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>

      <div class='flex gap-3 pt-4'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Update
        </button>
        <a
          href='/kategoris/{{kategori.id}}'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

    </form>
  </div>
</div>