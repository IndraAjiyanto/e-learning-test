<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        previewUrl: null,
        errorMessage: '',
        isValid: true,
        fileName: '',
        fileSize: 0,
        imageWidth: 0,
        imageHeight: 0,
        hasFile: false,

        // Form validation states
        formData: {
          nama: '',
          posisi: { id: '', en: '', ja: '' },
          linkedin: '',
          instagram: '',
          deskripsi: { id: '', en: '', ja: '' }
        },
        formErrors: {
          nama: '',
          posisi: { id: '', en: '', ja: '' },
          linkedin: '',
          instagram: '',
          deskripsi: { id: '', en: '', ja: '' }
        },
        formValid: {
          nama: false,
          posisi: { id: false, en: false, ja: false },
          linkedin: false,
          instagram: true, // optional
          deskripsi: { id: false, en: false, ja: false }
        },

        validateImage(file) {
          if (!file) {
            this.hasFile = false;
            return;
          }

          this.hasFile = true;
          this.fileName = file.name;
          this.fileSize = file.size;
          this.errorMessage = '';
          this.isValid = true;

          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!allowedTypes.includes(file.type)) {
            this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
            this.isValid = false;
            this.previewUrl = null;
            return;
          }

          const maxSize = 5 * 1024 * 1024; // 5MB
          if (file.size > maxSize) {
            this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
            this.isValid = false;
            this.previewUrl = null;
            return;
          }

          // Create preview without dimension validation (backend doesn't enforce dimensions)
          const img = new Image();
          const objectUrl = URL.createObjectURL(file);

          img.onload = () => {
            this.imageWidth = img.width;
            this.imageHeight = img.height;
            this.previewUrl = objectUrl;
            this.isValid = true;
            this.errorMessage = '';
          };

          img.onerror = () => {
            this.errorMessage = 'Failed to load image';
            this.isValid = false;
            this.previewUrl = null;
            URL.revokeObjectURL(objectUrl);
          };

          img.src = objectUrl;
        },

        validateField(field, value, lang = null) {
          if (lang) {
            this.formData[field][lang] = value;
          } else {
            this.formData[field] = value;
          }
          
          switch(field) {
            case 'nama':
              if (!value.trim()) {
                this.formErrors.nama = 'Name is required';
                this.formValid.nama = false;
              } else if (value.trim().length < 2) {
                this.formErrors.nama = 'Name must be at least 2 characters';
                this.formValid.nama = false;
              } else {
                this.formErrors.nama = '';
                this.formValid.nama = true;
              }
              break;
              
            case 'posisi':
              if (!value.trim()) {
                this.formErrors.posisi[lang] = 'Position is required';
                this.formValid.posisi[lang] = false;
              } else if (value.trim().length < 2) {
                this.formErrors.posisi[lang] = 'Position must be at least 2 characters';
                this.formValid.posisi[lang] = false;
              } else {
                this.formErrors.posisi[lang] = '';
                this.formValid.posisi[lang] = true;
              }
              break;
              
            case 'linkedin':
              if (!value.trim()) {
                this.formErrors.linkedin = 'LinkedIn URL is required';
                this.formValid.linkedin = false;
              } else {
                const urlPattern = /^https?:\/\/(www\.)?linkedin\.com\/.+/;
                if (!urlPattern.test(value)) {
                  this.formErrors.linkedin = 'Please enter a valid LinkedIn URL';
                  this.formValid.linkedin = false;
                } else {
                  this.formErrors.linkedin = '';
                  this.formValid.linkedin = true;
                }
              }
              break;
              
            case 'instagram':
              if (value.trim()) {
                const urlPattern = /^https?:\/\/(www\.)?instagram\.com\/.+/;
                if (!urlPattern.test(value)) {
                  this.formErrors.instagram = 'Please enter a valid Instagram URL';
                  this.formValid.instagram = false;
                } else {
                  this.formErrors.instagram = '';
                  this.formValid.instagram = true;
                }
              } else {
                this.formErrors.instagram = '';
                this.formValid.instagram = true; // optional field
              }
              break;
              
            case 'deskripsi':
              if (!value.trim()) {
                this.formErrors.deskripsi[lang] = 'Description is required';
                this.formValid.deskripsi[lang] = false;
              } else if (value.trim().length < 10) {
                this.formErrors.deskripsi[lang] = 'Description must be at least 10 characters';
                this.formValid.deskripsi[lang] = false;
              } else {
                this.formErrors.deskripsi[lang] = '';
                this.formValid.deskripsi[lang] = true;
              }
              break;
          }
        },

        clearFile() {
          this.previewUrl = null;
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '';
          this.fileSize = 0;
          this.imageWidth = 0;
          this.imageHeight = 0;
          this.hasFile = false;
          this.$refs.fileInput.value = null;
        },

        canSubmit() {
          const imageValid = !this.hasFile || this.isValid;
          const formValid = this.formValid.nama && this.formValid.posisi && 
                           this.formValid.linkedin && this.formValid.instagram && 
                           Object.values(this.formValid.deskripsi).every(v => v);
          return imageValid && formValid;
        },

        hasFormErrors() {
          const checkObject = (obj) => {
            if (typeof obj === 'object' && obj !== null) {
              return Object.values(obj).some(val => typeof val === 'object' ? checkObject(val) : val !== '');
            }
            return obj !== '';
          };
          return Object.values(this.formErrors).some(error => checkObject(error));
        }
      }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create New Team Lead</h2>

    <form
      action='/team-lead'
      method='post'
      class='space-y-6'
      x-data='{loading: false}'
      enctype='multipart/form-data'
      @submit.prevent="if (canSubmit()) { loading = true; $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >
      <!-- Upload Section -->
      <div class='space-y-3'>
        <label
          for='profile'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Profile Photo
          <span class='text-xs text-gray-500 font-normal'>(max 5MB, JPEG/PNG
            only)</span>
        </label>
        <input
          type='file'
          id='profile'
          name='profile'
          accept='image/*'
          x-ref='fileInput'
          :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-900 file:text-white hover:file:bg-gray-700 file:cursor-pointer'
          @change='validateImage($event.target.files[0])'
        />

        <!-- Error Message -->
        <template x-if='!isValid && errorMessage'>
          <div
            class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <div>
              <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
              <p class='text-xs text-red-700' x-text='errorMessage'></p>
            </div>
          </div>
        </template>

        <!-- Success Message with File Info -->
        <template x-if='hasFile && isValid'>
          <div class='space-y-2'>
            <div
              class='flex items-center justify-between p-3 bg-green-50 border border-green-300 rounded-lg'
            >
              <div class='flex items-center gap-2'>
                <i class='fas fa-check-circle text-green-500'></i>
                <div class='text-xs text-green-700'>
                  <span class='font-semibold'>Valid image:</span>
                  <span
                    x-text='`${fileName} (${(fileSize / 1024 / 1024).toFixed(2)}MB)`'
                  ></span>
                </div>
              </div>
              <button
                type='button'
                class='text-red-500 hover:text-red-700 transition-colors'
                @click='clearFile()'
                title='Remove image'
              >
                <i class='fas fa-times-circle'></i>
              </button>
            </div>
          </div>
        </template>

        <!-- Preview -->
        <template x-if='previewUrl'>
          <div class='relative w-32 h-32'>
            <img
              :src='previewUrl'
              alt='Preview Profile'
              class='w-32 h-32 object-cover rounded-lg border border-gray-300'
            />
            <button
              type='button'
              class='absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center shadow hover:bg-red-600'
              @click='clearFile()'
            >
              &times;
            </button>
          </div>
        </template>
      </div>

      <!-- Form Fields Grid -->
      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
        <!-- Name -->
        <div class='space-y-2'>
          <label
            for='nama'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Name</label>
          <input
            type='text'
            id='nama'
            name='nama'
            required
            :class="formErrors.nama ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
            @input='validateField("nama", $event.target.value)'
          />

          <!-- Error Message -->
          <template x-if='formErrors.nama'>
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.nama'></p>
            </div>
          </template>

          <!-- Success Message -->
          <template x-if='formValid.nama && !formErrors.nama'>
            <div
              class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500'></i>
              <p class='text-xs text-green-700'>Valid name</p>
            </div>
          </template>
        </div>

        <!-- Position -->

        <div class='space-y-4'>
          <label
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Position</label>
          <div class='space-y-4'>
            <div class='space-y-2'>
              <label
                class='block text-sm font-semibold text-gray-700 mb-1'
              >ID</label>
              <input
                x-model='formData.posisi.id'
                type='text'
                name='posisi[id]'
                required
                :class="formErrors.posisi.id ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                @input='validateField("posisi", $event.target.value , "id")'
              />

              <!-- Error Message -->
              <template x-if='formErrors.posisi.id'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.posisi.id'
                  ></p>
                </div>
              </template>

              <!-- Success Message -->
              <template x-if='formValid.posisi.id && !formErrors.posisi.id'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid position</p>
                </div>
              </template>
            </div>
            <div class='space-y-2'>
              <label
                class='block text-sm font-semibold text-gray-700 mb-1'
              >ID</label>
              <input
                x-model='formData.posisi.en'
                type='text'
                name='posisi[en]'
                required
                :class="formErrors.posisi.en ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                @input='validateField("posisi", $event.target.value , "en")'
              />

              <!-- Error Message -->
              <template x-if='formErrors.posisi.en'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.posisi.en'
                  ></p>
                </div>
              </template>

              <!-- Success Message -->
              <template x-if='formValid.posisi.en && !formErrors.posisi.en'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid position</p>
                </div>
              </template>
            </div>
            <div class='space-y-2'>
              <label
                class='block text-sm font-semibold text-gray-700 mb-1'
              >JP</label>
              <input
                x-model='formData.posisi.ja'
                type='text'
                name='posisi[ja]'
                required
                :class="formErrors.posisi.ja ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                @input='validateField("posisi", $event.target.value , "ja")'
              />

              <!-- Error Message -->
              <template x-if='formErrors.posisi.ja'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.posisi.ja'
                  ></p>
                </div>
              </template>

              <!-- Success Message -->
              <template x-if='formValid.posisi.ja && !formErrors.posisi.ja'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid position</p>
                </div>
              </template>
            </div>
          </div>
        </div>

        <!-- LinkedIn -->
        <div class='space-y-2'>
          <label
            for='linkedin'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >LinkedIn URL</label>
          <input
            type='url'
            id='linkedin'
            name='linkedin'
            required
            placeholder='https://linkedin.com/in/username'
            :class="formErrors.linkedin ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
            @input='validateField("linkedin", $event.target.value)'
          />

          <!-- Error Message -->
          <template x-if='formErrors.linkedin'>
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.linkedin'></p>
            </div>
          </template>

          <!-- Success Message -->
          <template x-if='formValid.linkedin && !formErrors.linkedin'>
            <div
              class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500'></i>
              <p class='text-xs text-green-700'>Valid LinkedIn URL</p>
            </div>
          </template>
        </div>

        <!-- Instagram -->
        <div class='space-y-2'>
          <label
            for='instagram'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Instagram URL
            <span class='text-xs text-gray-500 font-normal'>(optional)</span>
          </label>
          <input
            type='url'
            id='instagram'
            name='instagram'
            placeholder='https://instagram.com/username'
            :class="formErrors.instagram ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
            @input='validateField("instagram", $event.target.value)'
          />

          <!-- Error Message -->
          <template x-if='formErrors.instagram'>
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.instagram'></p>
            </div>
          </template>

          <!-- Success Message -->
          <template
            x-if='formValid.instagram && !formErrors.instagram && $el.value'
          >
            <div
              class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500'></i>
              <p class='text-xs text-green-700'>Valid Instagram URL</p>
            </div>
          </template>
        </div>

        <!-- Empty column for spacing -->
        <div></div>
      </div>

      <!-- Description (Multi-language) -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Description</label>
        <div class='space-y-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.deskripsi.id'
              @input='validateField("deskripsi", $event.target.value, "id")'
              name='deskripsi[id]'
              required
              rows='4'
              :class="formErrors.deskripsi.id ? 'border-red-500 focus:ring-red-500' : (formValid.deskripsi.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Enter team lead description (ID)...'
            ></textarea>
            <template x-if='formErrors.deskripsi.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.deskripsi.id'
                ></p>
              </div>
            </template>
            <template x-if='formValid.deskripsi.id && !formErrors.deskripsi.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid description (ID)</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.deskripsi.en'
              @input='validateField("deskripsi", $event.target.value, "en")'
              name='deskripsi[en]'
              rows='4'
              :class="formErrors.deskripsi.en ? 'border-red-500 focus:ring-red-500' : (formValid.deskripsi.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Enter team lead description (EN)...'
            ></textarea>
            <template x-if='formErrors.deskripsi.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.deskripsi.en'
                ></p>
              </div>
            </template>
            <template x-if='formValid.deskripsi.en && !formErrors.deskripsi.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid description (EN)</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.deskripsi.ja'
              @input='validateField("deskripsi", $event.target.value, "ja")'
              name='deskripsi[ja]'
              rows='4'
              :class="formErrors.deskripsi.ja ? 'border-red-500 focus:ring-red-500' : (formValid.deskripsi.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='チームリーダーの説明を入力してください (JA)...'
            ></textarea>
            <template x-if='formErrors.deskripsi.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.deskripsi.ja'
                ></p>
              </div>
            </template>
            <template x-if='formValid.deskripsi.ja && !formErrors.deskripsi.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid description (JP)</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span
            x-show='loading'
            class='loading loading-spinner loading-sm'
          ></span>
          <span x-show='!loading'>Create</span>
        </button>
        <a
          href='/team-lead'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors() || (hasFile && !isValid)'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
