{{!--
  Halaman: Create Team Lead — Super Admin
  Lokasi: src/views/super_admin/team_lead/create.hbs
  Level: L4 Page

  Route: GET /team-lead/formCreate -> POST /team-lead
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Team Lead'
      }}

      {{> components/ui/super_admin/description/index
        text='Add a new leadership profile, credentials, and executive bio for Kesatria Academy.'
      }}
    </div>

    <form
      action='/team-lead'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='teamLeadForm()'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white p-5 sm:p-8'
    >
      <div class='flex flex-col gap-6'>
        {{> components/ui/super_admin/form/team_lead/fields }}

        <div class='flex flex-col-reverse gap-3 pt-6 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href='/team-lead'
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Create Team Lead'
            loading=true
          }}
        </div>
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/team_lead/form }}