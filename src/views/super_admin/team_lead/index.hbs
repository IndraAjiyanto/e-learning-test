{{!--
  Halaman: Pengelolaan Team Lead — Super Admin
  Lokasi: src/views/super_admin/team_lead/index.hbs
  Level: L4 Page

  - Shell kartu + pagination dari table/card
  - Header kolom dari table/header_cell
  - Tombol aksi dari table/row_actions terintegrasi dengan modal delete_confirm
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Team Lead'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage leadership profile, credentials, and executive bio displayed on Kesatria Academy.'
      }}
    </div>

    <div
      class='flex flex-col gap-3.5'
      x-data='clientTable({ items: {{json teamLeads}}, searchKeys: ["name", "position.id", "position.en", "position.ja", "description.id", "description.en", "description.ja", "linkedin", "instagram"] })'
    >
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search team lead...'
        searchLabel='Search team lead'
        createHref='/team-lead/formCreate'
        createLabel='Create Team Lead'
        hideCreate=teamLeads.length
      }}

      <!-- Table Card -->
      {{#> components/ui/super_admin/table/card tableClass='min-w-[1100px]'}}
        <colgroup>
          <col class='w-[70px]' />
          <col class='w-[90px]' />
          <col class='w-[200px]' />
          <col class='w-[100px]' />
          <col class='w-[300px]' />
          <col class='w-[160px]' />
          <col class='w-[160px]' />
          <col class='w-[116px]' />
        </colgroup>
        <thead>
          <tr>
            {{> components/ui/super_admin/table/header_cell label='No' }}
            {{> components/ui/super_admin/table/header_cell label='Profile' }}
            {{> components/ui/super_admin/table/header_cell label='Name' }}
            {{> components/ui/super_admin/table/header_cell label='Position' }}
            {{> components/ui/super_admin/table/header_cell label='Description' }}
            {{> components/ui/super_admin/table/header_cell label='LinkedIn' }}
            {{> components/ui/super_admin/table/header_cell label='Instagram' }}
            {{> components/ui/super_admin/table/header_cell label='Action' }}
          </tr>
        </thead>
        <tbody>
          <template x-for='(row, index) in rows' :key='row.id'>
            <tr class='transition-colors hover:bg-[#fafafa]'>
              {{> components/ui/super_admin/table/cell
                text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
              }}

              {{#> components/ui/super_admin/table/cell}}
                <img
                  :src='row.profile || "/public/image/about/orang.png"'
                  :alt='row.name'
                  class='h-12 w-12 rounded-full object-cover ring-1 ring-[#e5e5e5]'
                  onerror="this.onerror=null;this.src='/public/image/about/orang.png';"
                />
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell}}
                <span class='font-inter text-sm font-semibold text-[#171717]' x-text='row.name'></span>
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell}}
                <div class='flex flex-col gap-1'>
                  <template x-for='(item, idx) in (Array.isArray(row.position) ? row.position : Object.values(row.position || {}))' :key='idx'>
                    <div class='line-clamp-2 font-inter text-sm leading-5 text-[#525252]' x-text='item'></div>
                  </template>
                </div>
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell}}
                <div class='flex flex-col gap-1'>
                  <template x-for='(item, idx) in (Array.isArray(row.description) ? row.description : Object.values(row.description || {}))' :key='idx'>
                    <div class='line-clamp-3 font-inter text-sm leading-5 text-[#525252]' x-text='item'></div>
                  </template>
                </div>
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell}}
                <template x-if='row.linkedin'>
                  <a
                    :href='row.linkedin'
                    target='_blank'
                    rel='noopener noreferrer'
                    class='block max-w-[150px] truncate font-inter text-sm text-[#003060] underline transition hover:text-[#00254a]'
                    x-text='row.linkedin'
                  ></a>
                </template>
                <template x-if='!row.linkedin'>
                  <span class='text-[#a3a3a3]'>-</span>
                </template>
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell}}
                <template x-if='row.instagram'>
                  <a
                    :href='row.instagram'
                    target='_blank'
                    rel='noopener noreferrer'
                    class='block max-w-[150px] truncate font-inter text-sm text-[#003060] underline transition hover:text-[#00254a]'
                    x-text='row.instagram'
                  ></a>
                </template>
                <template x-if='!row.instagram'>
                  <span class='text-[#a3a3a3]'>-</span>
                </template>
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell variant='action'}}
                {{> components/ui/super_admin/table/row_actions
                  entity='team-lead'
                  deleteAction="'/team-lead/' + row.id + '?_method=DELETE'"
                  editHref="'/team-lead/formEdit/' + row.id"
                }}
              {{/components/ui/super_admin/table/cell}}
            </tr>
          </template>

          {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='7'}}
            No team lead found.
          {{/components/ui/super_admin/table/message_row}}
        </tbody>
      {{/components/ui/super_admin/table/card}}
    </div>
  </div>
</div>

{{!-- Modal konfirmasi delete --}}
{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Team Lead?'
  description='Are you sure you want to delete this team lead? This action will permanently remove the leadership profile and cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}
