<div
  class='py-10'
  x-data="{
    get computedClass() {
      const raw = (this.formData.icon || '').toString().trim();
      if (!raw) return 'fa-solid fa-circle-question';
      const v = raw;
      const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(v) || v.split(/\s+/).some(s => /^fa-/i.test(s));
      if (hasFaPrefix) {
        if (/^fa-\w+/i.test(v) && !/\s+/.test(v)) return 'fa-solid ' + v;
        return v;
      }
      if (!v.includes(' ')) return 'fa-solid fa-' + v;
      return v;
    },

    // Form validation states
    formData: {
      icon: `{{value.icon}}`,
      title: { id: `{{value.title.id}}`, en: `{{value.title.en}}`, ja: `{{value.title.ja}}` },
      description: { id: `{{value.description.id}}`, en: `{{value.description.en}}`, ja: `{{value.description.ja}}` }
    },
    formErrors: {
      icon: '',
      title: { id: '', en: '', ja: '' },
      description: { id: '', en: '', ja: '' }
    },
    formValid: {
      icon: true,
      title: { id: true, en: true, ja: true },
      description: { id: true, en: true, ja: true }
    },

    validateField(field, langOrValue, valueIfLang) {
      if (field === 'icon') {
        const value = langOrValue;
        this.formData[field] = value;
        
        if (!value.trim()) {
          this.formErrors.icon = 'Icon is required';
          this.formValid.icon = false;
        } else if (value.trim().length < 2) {
          this.formErrors.icon = 'Icon must be at least 2 characters';
          this.formValid.icon = false;
        } else {
          this.formErrors.icon = '';
          this.formValid.icon = true;
        }
      } else {
        const lang = langOrValue;
        const value = valueIfLang;
        this.formData[field][lang] = value;
        
        switch(field) {
          case 'title':
            if (!value.trim()) {
              this.formErrors.title[lang] = 'Title is required';
              this.formValid.title[lang] = false;
            } else if (value.trim().length < 3) {
              this.formErrors.title[lang] = 'Title must be at least 3 characters';
              this.formValid.title[lang] = false;
            } else {
              this.formErrors.title[lang] = '';
              this.formValid.title[lang] = true;
            }
            break;
            
          case 'description':
            if (!value.trim()) {
              this.formErrors.description[lang] = 'Description is required';
              this.formValid.description[lang] = false;
            } else if (value.trim().length < 10) {
              this.formErrors.description[lang] = 'Description must be at least 10 characters';
              this.formValid.description[lang] = false;
            } else {
              this.formErrors.description[lang] = '';
              this.formValid.description[lang] = true;
            }
            break;
        }
      }
    },

    canSubmit() {
      const titleValid = Object.values(this.formValid.title).every(v => v);
      const descriptionValid = Object.values(this.formValid.description).every(v => v);
      return this.formValid.icon && titleValid && descriptionValid;
    },

    hasFormErrors() {
      return this.formErrors.icon !== '' || 
             Object.values(this.formErrors.title).some(e => e !== '') || 
             Object.values(this.formErrors.description).some(e => e !== '');
    }
  }"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Value</h2>

    <form
      action='/value/{{value.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      x-data='{ loading: false }'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; } loading = true;'
    >

    {{> super_admin/value/edit/title_input}}
    {{> super_admin/value/edit/description_input}}
    {{> super_admin/value/edit/icon_input}}

      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span
            x-show='loading'
            class='loading loading-spinner loading-sm'
          ></span>
          <span x-show='!loading'>Update</span>
        </button>
        <a
          href='/value'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>

    </form>
  </div>
</div>