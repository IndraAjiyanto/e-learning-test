{{!--
  Halaman: Value — Super Admin
  Lokasi: src/views/super_admin/value/index.hbs
  Level: L4 Page

  - Sidebar sudah disediakan oleh layouts/main.hbs (offset lg:ml-[319px])

  Data: GET /value -> { values }. Memakai clientTable: barisnya sedikit dan
  controller mengirimnya utuh, jadi paginasi di server tidak memberi keuntungan.

  Kolom Order menampilkan `valueOrder` — DATA yang menentukan urutan tampil di
  halaman publik, bukan nomor baris; itulah sebabnya kolom ini ada meski halaman
  lain tidak memakai penomoran baris.

  `title` dan `description` adalah kolom jsonb { id, en, ja }, jadi tabelnya
  memakai tab bahasa seperti halaman Program Type.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Value'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage the values shown on the About page.'
      }}
    </div>

    <div
      class='flex flex-col gap-2.5'
      x-data='clientTable({ items: {{json values}}, searchKeys: ["title.id", "title.en", "title.ja", "description.id", "description.en", "description.ja"] })'
    >
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search value..'
        searchLabel='Search value'
        createHref='/value/formCreate'
        createLabel='Create Value'
      }}

      <div
        class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
        x-data="{ lang: 'id' }"
      >
        <div class='flex flex-col gap-4'>

          {{> components/ui/super_admin/tabs/language/index ariaLabel='Value language' }}

          {{#> components/ui/super_admin/table/card tableClass='min-w-[1010px]'}}
            <colgroup>
              <col class='w-[90px]' />
              <col class='w-[90px]' />
              <col class='w-[320px]' />
              <col class='w-[394px]' />
              <col class='w-[116px]' />
            </colgroup>
            <thead>
              <tr>
                {{> components/ui/super_admin/table/header_cell label='Order' }}
                {{> components/ui/super_admin/table/header_cell label='Icon' }}
                {{> components/ui/super_admin/table/header_cell label='Title' }}
                {{> components/ui/super_admin/table/header_cell label='Description' }}
                {{> components/ui/super_admin/table/header_cell label='Action' }}
              </tr>
            </thead>
            <tbody>
              <template x-for='row in rows' :key='row.id'>
                <tr class='transition-colors hover:bg-[#fafafa]'>

                  {{#> components/ui/super_admin/table/cell}}
                    {{> components/ui/super_admin/badge/index
                      size='md'
                      text='String(row.valueOrder + 1).padStart(2, "0")'
                      class='bg-[#f9f5ff] text-[#6941c6]'
                    }}
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    <i
                      class='flex h-5 w-5 items-center justify-center text-base text-[#525252]'
                      :class='iconItemIcon(row.icon)'
                      :title='row.icon'
                      aria-hidden='true'
                    ></i>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='block truncate font-inter text-sm font-medium leading-5 text-[#171717]'
                      x-text='(row.title && row.title[lang]) || "—"'
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='block truncate font-inter text-sm leading-5 text-[#525252]'
                      x-text='(row.description && row.description[lang]) || "—"'
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell variant='action'}}
                    {{> components/ui/super_admin/table/row_actions
                      entity='value'
                      editHref="'/value/formEdit/' + row.id"
                      deleteAction="'/value/' + row.id + '?_method=DELETE'"
                    }}
                  {{/components/ui/super_admin/table/cell}}
                </tr>
              </template>

              {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='5'}}
                No value found.
              {{/components/ui/super_admin/table/message_row}}
            </tbody>
          {{/components/ui/super_admin/table/card}}
        </div>
      </div>
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Value?'
  description='Are you sure you want to delete this value? The remaining entries will be renumbered automatically. This action cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}

<script>
  // Sejajar dengan benefitIcon() di halaman Benefit: helper `computeIcon` berjalan
  // di server dan tidak bisa dipanggil dari dalam x-for.
  function iconItemIcon(value) {
    const icon = String(value || '').trim();
    if (!icon) return 'fa-solid fa-circle-question';
    const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(icon)
      || icon.split(/\s+/).some((part) => /^fa-/i.test(part));
    if (hasFaPrefix) return /^fa-\w+/i.test(icon) && !/\s/.test(icon) ? 'fa-solid ' + icon : icon;
    return icon.includes(' ') ? icon : 'fa-solid fa-' + icon;
  }
</script>
