<div
  class='py-10'
  x-data="{
  title: '',
  description: '',
  icon: '',
  errors: { title: null, description: null, icon: null },
  success: { title: false, description: false, icon: false },
  validateTitle() {
    if (!this.title.trim()) {
      this.errors.title = 'Title is required';
      this.success.title = false;
    } else if (this.title.trim().length < 3) {
      this.errors.title = 'Title must be at least 3 characters';
      this.success.title = false;
    } else {
      this.errors.title = null;
      this.success.title = true;
    }
  },
  validateDescription() {
    if (!this.description.trim()) {
      this.errors.description = 'Description is required';
      this.success.description = false;
    } else if (this.description.trim().length < 10) {
      this.errors.description = 'Description must be at least 10 characters';
      this.success.description = false;
    } else {
      this.errors.description = null;
      this.success.description = true;
    }
  },
  validateIcon() {
    if (!this.icon.trim()) {
      this.errors.icon = 'Icon is required';
      this.success.icon = false;
    } else if (this.icon.trim().length < 2) {
      this.errors.icon = 'Icon must be at least 2 characters';
      this.success.icon = false;
    } else {
      this.errors.icon = null;
      this.success.icon = true;
    }
  },
  get computedClass() {
    const raw = (this.icon || '').toString().trim();
    if (!raw) return 'fa-solid fa-circle-question';
    const v = raw;
    const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(v) || v.split(/\s+/).some(s => /^fa-/i.test(s));
    if (hasFaPrefix) {
      if (/^fa-\w+/i.test(v) && !/\s+/.test(v)) return 'fa-solid ' + v;
      return v;
    }
    if (!v.includes(' ')) return 'fa-solid fa-' + v;
    return v;
  },
  get canSubmit() {
    return this.success.title && this.success.description && this.success.icon;
  }
}"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create Value</h2>

    <form action='/value' method='post' class='space-y-6'>

      <div>
        <label
          for='title'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Title
        </label>
        <input
          x-model='title'
          @input='validateTitle()'
          type='text'
          id='title'
          name='title'
          :class="errors.title ? 'border-red-500 focus:ring-red-500' : success.title ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
        />
        <div
          x-show='errors.title'
          class='text-red-500 text-sm mt-1'
          x-text='errors.title'
        ></div>
        <div
          x-show='success.title && !errors.title'
          class='text-green-500 text-sm mt-1'
        >✓ Title looks good</div>
      </div>

      <div>
        <label
          for='description'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Description
        </label>
        <textarea
          x-model='description'
          @input='validateDescription()'
          id='description'
          name='description'
          rows='4'
          :class="errors.description ? 'border-red-500 focus:ring-red-500' : success.description ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
        ></textarea>
        <div
          x-show='errors.description'
          class='text-red-500 text-sm mt-1'
          x-text='errors.description'
        ></div>
        <div
          x-show='success.description && !errors.description'
          class='text-green-500 text-sm mt-1'
        >✓ Description looks good</div>
      </div>

      <div>
        <label
          for='icon'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Icon
        </label>
        <div class='flex items-center gap-4'>
          <input
            x-model='icon'
            @input='validateIcon()'
            type='text'
            id='icon'
            name='icon'
            placeholder='fa-code, fa-layer-group, etc.'
            :class="errors.icon ? 'border-red-500 focus:ring-red-500' : success.icon ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
          />

          <!-- Live preview: binds computed class to the <i> element -->
          <div class='flex items-center gap-3'>
            <i :class='computedClass' class='text-2xl text-gray-700'></i>
            <span class='text-sm text-gray-500' x-text='computedClass'></span>
          </div>
        </div>
        <div
          x-show='errors.icon'
          class='text-red-500 text-sm mt-1'
          x-text='errors.icon'
        ></div>
        <div
          x-show='success.icon && !errors.icon'
          class='text-green-500 text-sm mt-1'
        >✓ Icon looks good</div>
        <p class='text-sm text-gray-500 mt-2'>Type a Font Awesome class like
          <code>fa-code</code>
          or include full classes like
          <code>fas fa-code</code>.</p>
      </div>

      <div class='flex space-x-4'>
        <button
          :disabled='!canSubmit'
          :class="canSubmit ? 'bg-gray-900 hover:bg-gray-600' : 'bg-gray-400 cursor-not-allowed'"
          type='submit'
          class='text-white px-6 py-2 rounded-lg shadow transition focus:outline-none focus:ring-2 focus:ring-gray-900'
        >
          Create
        </button>
        <a
          href='/value'
          class='bg-white border border-gray-300 text-gray-900 px-6 py-2 rounded-lg shadow hover:bg-gray-100 transition focus:outline-none focus:ring-2 focus:ring-gray-900'
        >
          Cancel
        </a>
      </div>

    </form>
  </div>
</div>