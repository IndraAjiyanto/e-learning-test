<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        // Image validation states
        previewUrl: null,
        errorMessage: '',
        isValid: true,
        fileName: '',
        fileSize: 0,
        imageWidth: 0,
        imageHeight: 0,
        hasFile: false,
        oldPhoto: `{{#if mentor.profile}}{{mentor.profile}}{{else}}/images/default-avatar.png{{/if}}`,
      

        // Form validation states
        formData: {
          nama: `{{mentor.nama}}`,
          posisi: {
            id: `{{mentor.posisi.id}}`,
            en: `{{mentor.posisi.en}}`,
            ja: `{{mentor.posisi.ja}}`
          },
          deskripsi: {
            id: `{{mentor.deskripsi.id}}`,
            en: `{{mentor.deskripsi.en}}`,
            ja: `{{mentor.deskripsi.ja}}`
          },
          linkedin: `{{mentor.linkedin}}`,
        },
        formErrors: {
          nama: '',
          posisi: { id: '', en: '', ja: '' },
          deskripsi: { id: '', en: '', ja: '' },
          linkedin: '',
        },
        formValid: {
          nama: true,
          posisi: { id: true, en: true, ja: true },
          deskripsi: { id: true, en: true, ja: true },
          linkedin: true,
        },
        formTouched: {
          nama: false,
          posisi: { id: false, en: false, ja: false },
          deskripsi: { id: false, en: false, ja: false },
          linkedin: false,
        },

        validateField(field, value, lang = null) {
          if (lang) {
            this.formData[field][lang] = value;
            this.formTouched[field][lang] = true;
          } else {
            this.formData[field] = value;
            this.formTouched[field] = true;
          }
          
          switch(field) {
            case 'nama':
              if (!value.trim()) {
                this.formErrors.nama = 'Mentor name is required';
                this.formValid.nama = false;
              } else {
                this.formErrors.nama = '';
                this.formValid.nama = true;
              }
              break;
              
            case 'posisi':
              if (!value.trim()) {
                this.formErrors.posisi[lang] = 'Position is required';
                this.formValid.posisi[lang] = false;
              } else {
                this.formErrors.posisi[lang] = '';
                this.formValid.posisi[lang] = true;
              }
              break;
              
            case 'deskripsi':
              if (!value.trim()) {
                this.formErrors.deskripsi[lang] = 'Description is required';
                this.formValid.deskripsi[lang] = false;
              } else if (value.trim().length < 10) {
                this.formErrors.deskripsi[lang] = 'Description must be at least 10 characters';
                this.formValid.deskripsi[lang] = false;
              } else {
                this.formErrors.deskripsi[lang] = '';
                this.formValid.deskripsi[lang] = true;
              }
              break;
              
            case 'linkedin':
              if (!value.trim()) {
                this.formErrors.linkedin = 'LinkedIn link is required';
                this.formValid.linkedin = false;
              } else {
                this.formErrors.linkedin = '';
                this.formValid.linkedin = true;
              }
              break;
              
          }
        },

        validateImage(file) {
          if (!file) { this.hasFile = false; return; }
          this.hasFile = true;
          this.fileName = file.name;
          this.fileSize = file.size;
          this.errorMessage = '';
          this.isValid = true;
          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!allowedTypes.includes(file.type)) {
            this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
            this.isValid = false;
            this.previewUrl = null;
            return;
          }
          const maxSize = 5 * 1024 * 1024;
          if (file.size > maxSize) {
            this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
            this.isValid = false;
            this.previewUrl = null;
            return;
          }
          const img = new Image();
          const objectUrl = URL.createObjectURL(file);
          img.onload = () => {
            this.imageWidth = img.width;
            this.imageHeight = img.height;
            if (img.width < 300 || img.width > 2000 || img.height < 300 || img.height > 2000) {
              this.errorMessage = `Image dimensions ${img.width}x${img.height}px. Required: 300x300 to 2000x2000 pixels`;
              this.isValid = false;
              this.previewUrl = null;
              URL.revokeObjectURL(objectUrl);
            } else {
              this.previewUrl = objectUrl;
              this.isValid = true;
              this.errorMessage = '';
            }
          };
          img.onerror = () => {
            this.errorMessage = 'Failed to load image';
            this.isValid = false;
            this.previewUrl = null;
            URL.revokeObjectURL(objectUrl);
          };
          img.src = objectUrl;
        },
        

        clearFile() {
          this.previewUrl = null;
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '';
          this.fileSize = 0;
          this.imageWidth = 0;
          this.imageHeight = 0;
          this.hasFile = false;
          this.$refs.profileFile.value = null;
        },
        

        canSubmit() {
          const imageValid = !this.hasFile || this.isValid;
          const posisiValid = Object.values(this.formValid.posisi).every(v => v);
          const deskripsiValid = Object.values(this.formValid.deskripsi).every(v => v);
          const formValid = this.formValid.nama && posisiValid && deskripsiValid && this.formValid.linkedin;
          return imageValid && formValid;
        },

        hasFormErrors() {
          return this.formErrors.nama !== '' ||
                 Object.values(this.formErrors.posisi).some(e => e !== '') ||
                 Object.values(this.formErrors.deskripsi).some(e => e !== '') ||
                 this.formErrors.linkedin !== ''
        }
      }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Data Mentor</h2>
    <form 
      action="/mentor/{{mentor.kelas.id}}/{{mentor.id}}?_method=PATCH" 
      method="POST" 
      enctype="multipart/form-data"
      class='space-y-6'
      x-data="{ loading: false }"
      @submit.prevent="if (canSubmit()) { loading = true; $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >
      <!-- Method Spoofing -->
      <input type="hidden" name="_method" value="PUT">

{{> super_admin/mentor/edit/image_input}}

      <!-- Form Fields Grid -->
      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
        <!-- LEFT COLUMN -->
        <div class='space-y-6'>

          {{> super_admin/mentor/edit/left_column/name_input }}
          {{> super_admin/mentor/edit/left_column/position_input }}
          {{> super_admin/mentor/edit/left_column/technology_input }}

        </div>

        <!-- RIGHT COLUMN -->
        <div class='space-y-6'>

          {{> super_admin/mentor/edit/right_column/description_input }}
          {{> super_admin/mentor/edit/right_column/linkedin_input }}

        </div>
      </div>

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span x-show="loading" class="loading loading-spinner loading-sm"></span>
          <span x-show="!loading">Update</span>
        </button>
        <a
          href='/program/detail/kelas/admin/{{mentor.kelas.id}}'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300  transition'>Cancel</a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors() || (hasFile && !isValid) '>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>
