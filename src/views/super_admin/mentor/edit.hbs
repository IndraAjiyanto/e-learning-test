<div class='py-10'>
  <div class='max-w-4xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-3xl font-bold mb-8 text-gray-900 text-center'>Edit Data Mentor</h2>
    <form 
      action="/mentor/{{mentor.kelas.id}}/{{mentor.id}}?_method=PATCH" 
      method="POST" 
      enctype="multipart/form-data"
      class='space-y-8'
      x-data="{
        nama: '{{mentor.nama}}',
        posisi: '{{mentor.posisi}}',
        deskripsi: '{{mentor.deskripsi}}',
        linkedin: '{{mentor.linkedin}}',
        github: '{{mentor.github}}',
        errors: {},
        success: {},
        validateNama() {
          if (!this.nama.trim()) {
            this.errors.nama = 'Mentor name is required';
            this.success.nama = false;
          } else {
            delete this.errors.nama;
            this.success.nama = true;
          }
        },
        validatePosisi() {
          if (!this.posisi.trim()) {
            this.errors.posisi = 'Position is required';
            this.success.posisi = false;
          } else {
            delete this.errors.posisi;
            this.success.posisi = true;
          }
        },
        validateDeskripsi() {
          if (!this.deskripsi.trim()) {
            this.errors.deskripsi = 'Description is required';
            this.success.deskripsi = false;
          } else {
            delete this.errors.deskripsi;
            this.success.deskripsi = true;
          }
        },
        validateLinkedin() {
          if (!this.linkedin.trim()) {
            this.errors.linkedin = 'LinkedIn link is required';
            this.success.linkedin = false;
          } else {
            delete this.errors.linkedin;
            this.success.linkedin = true;
          }
        },
        validateGithub() {
          if (!this.github.trim()) {
            this.errors.github = 'GitHub link is required';
            this.success.github = false;
          } else {
            delete this.errors.github;
            this.success.github = true;
          }
        },
        canSubmit() {
          return this.nama.trim() && this.posisi.trim() && this.deskripsi.trim() && this.linkedin.trim() && this.github.trim() && Object.keys(this.errors).length === 0;
        }
      }"
      @submit.prevent='if (!canSubmit()) return false'
    >
      <!-- Method Spoofing (karena HTML form tidak support PUT) -->
      <input type="hidden" name="_method" value="PUT">

      <div class='grid grid-cols-1 md:grid-cols-2 gap-8'>
        <!-- LEFT COLUMN -->
        <div class='space-y-6'>
          <!-- Profile / Foto -->
          <div
            x-data="{
                previewUrl: null,
                oldPhoto: '{{#if mentor.profile}}{{mentor.profile}}{{else}}/images/default-avatar.png{{/if}}',
                errorMessage: '',
                isValid: true,
                fileName: '',
                fileSize: 0,
                imageWidth: 0,
                imageHeight: 0,
                hasFile: false,
                validateImage(file) {
                  if (!file) { this.hasFile = false; return; }
                  this.hasFile = true; this.fileName = file.name; this.fileSize = file.size; this.errorMessage = ''; this.isValid = true;
                  const allowedTypes = ['image/jpeg','image/jpg','image/png'];
                  if (!allowedTypes.includes(file.type)) { this.errorMessage = 'Only JPEG, JPG and PNG formats are allowed'; this.isValid = false; this.previewUrl = null; return; }
                  const maxSize = 5 * 1024 * 1024;
                  if (file.size > maxSize) { this.errorMessage = `File size too large (${(file.size/1024/1024).toFixed(2)}MB). Maximum 5MB`; this.isValid = false; this.previewUrl = null; return; }
                  const img = new Image(); const objectUrl = URL.createObjectURL(file);
                  img.onload = () => { this.imageWidth = img.width; this.imageHeight = img.height; if (img.width < 300 || img.width > 2000 || img.height < 300 || img.height > 2000) { this.errorMessage = `Image dimensions ${img.width}x${img.height}px. Required: 300x300 to 2000x2000`; this.isValid = false; this.previewUrl = null; URL.revokeObjectURL(objectUrl); } else { this.previewUrl = objectUrl; this.isValid = true; this.errorMessage = ''; } };
                  img.onerror = () => { this.errorMessage = 'Failed to load image'; this.isValid = false; this.previewUrl = null; URL.revokeObjectURL(objectUrl); };
                  img.src = objectUrl;
                },
                clearFile() { this.previewUrl = null; this.errorMessage = ''; this.isValid = true; this.fileName = ''; this.fileSize = 0; this.imageWidth = 0; this.imageHeight = 0; this.hasFile = false; $refs.profileFile.value = null; }
              }"
            class='space-y-3'
          >
            <label
              for='profile'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Profile Photo
              <span class='text-xs text-gray-500 font-normal'>(300x300 -
                2000x2000px, max 5MB, JPG/PNG)</span></label>
            <input
              type='file'
              id='profile'
              name='profile'
              accept='image/jpeg,image/jpg,image/png'
              x-ref='profileFile'
              class='w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
              @change='validateImage($event.target.files[0])'
            />

            <template x-if="!isValid && errorMessage">
              <div class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'>
                <div class='text-red-600 font-semibold'>Invalid image</div>
                <div class='text-sm text-red-700' x-text='errorMessage'></div>
              </div>
            </template>

            <template x-if="previewUrl && isValid">
              <div class='space-y-2'>
                <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'>
                  <div class='text-xs text-green-700'><span class='font-semibold'>Valid image:</span> <span x-text='`${imageWidth}x${imageHeight}px, ${(fileSize/1024/1024).toFixed(2)}MB`'></span></div>
                </div>
              </div>
            </template>

            <template x-if="!hasFile">
              <div class='space-y-2'>
                <div class='text-sm text-gray-600'>Current photo:</div>
                <img :src='oldPhoto' alt='Current photo' class='w-32 h-32 object-cover rounded-lg border border-gray-300' />
              </div>
            </template>
          </div>

          <!-- Nama -->
          <div>
            <label
              for='nama'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Nama Mentor</label>
            <input
              x-model='nama'
              @input='validateNama()'
              type='text'
              id='nama'
              name='nama'
              value="{{mentor.nama}}"
              placeholder='Enter mentor name'
              required
              :class="errors.nama ? 'border-red-500 focus:ring-red-500' : success.nama ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
            />
            <p x-show='errors.nama' x-text='errors.nama' class='mt-1 text-sm text-red-600'></p>
          </div>

          <!-- Posisi -->
          <div>
            <label
              for='posisi'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Posisi</label>
            <input
              x-model='posisi'
              @input='validatePosisi()'
              type='text'
              id='posisi'
              name='posisi'
              value="{{mentor.posisi}}"
              placeholder='Enter position (e.g., Web Developer, UI/UX Designer)'
              required
              :class="errors.posisi ? 'border-red-500 focus:ring-red-500' : success.posisi ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
            />
            <p x-show='errors.posisi' x-text='errors.posisi' class='mt-1 text-sm text-red-600'></p>
          </div>

          <div
            x-data="{
          search: '',
          selectedTechs: {{json mentor.teknologi}} || [],
          showDropdown: false,
          availableTechs: {{json teknologi}},
          get filteredTechs() {
            return this.availableTechs.filter(t => 
              t.nama.toLowerCase().includes(this.search.toLowerCase()) &&
              !this.selectedTechs.find(s => s.id === t.id)
            );
          },
          selectTech(tech) {
            this.selectedTechs.push(tech);
            this.search = '';
            this.showDropdown = false;
          },
          removeTech(techId) {
            this.selectedTechs = this.selectedTechs.filter(t => t.id !== techId);
          }
        }"
            @click.away='showDropdown = false'
          >
            <label
              class='block text-sm font-semibold text-gray-700 mb-2'
            >Technologies</label>

            <!-- Selected Technologies -->
            <div
              class='flex flex-wrap gap-2 mb-3'
              x-show='selectedTechs.length > 0'
            >
              <template x-for='tech in selectedTechs' :key='tech.id'>
                <div
                  class='flex items-center gap-2 bg-gray-100 border border-gray-300 rounded-lg px-3 py-2'
                >
                  <div
                    class='w-6 h-6 flex items-center justify-center'
                    x-html='tech.svg'
                  ></div>
                  <span
                    class='text-sm font-medium text-gray-700'
                    x-text='tech.nama'
                  ></span>
                  <button
                    type='button'
                    @click='removeTech(tech.id)'
                    class='text-red-500 hover:text-red-700 ml-2'
                  >
                    <i class='fas fa-times'></i>
                  </button>
                  <input type='hidden' name='teknologiIds[]' :value='tech.id' />
                </div>
              </template>
            </div>

            <!-- Search Input -->
            <div class='relative'>
              <input
                type='text'
                x-model='search'
                @focus='showDropdown = true'
                @input='showDropdown = true'
                placeholder='Search and select technologies...'
                class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
              />
              <i
                class='fas fa-search absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400'
              ></i>

              <!-- Dropdown -->
              <div
                x-show='showDropdown && filteredTechs.length > 0'
                class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'
              >
                <template x-for='tech in filteredTechs' :key='tech.id'>
                  <button
                    type='button'
                    @click='selectTech(tech)'
                    class='w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition text-left border-b border-gray-100 last:border-0'
                  >
                    <div
                      class='w-8 h-8 flex items-center justify-center flex-shrink-0'
                      x-html='tech.svg'
                    ></div>
                    <span
                      class='text-sm font-medium text-gray-700'
                      x-text='tech.nama'
                    ></span>
                  </button>
                </template>
              </div>
            </div>

            <p class='text-xs text-gray-500 mt-2'>Click to select technologies
              from the list</p>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class='space-y-6'>
          <!-- Deskripsi -->
          <div>
            <label
              for='deskripsi'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Deskripsi</label>
            <textarea
              x-model='deskripsi'
              @input='validateDeskripsi()'
              id='deskripsi'
              name='deskripsi'
              rows='6'
              placeholder='Write a short description about the mentor...'
              :class="errors.deskripsi ? 'border-red-500 focus:ring-red-500' : success.deskripsi ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
            >{{mentor.deskripsi}}</textarea>
            <p x-show='errors.deskripsi' x-text='errors.deskripsi' class='mt-1 text-sm text-red-600'></p>
          </div>

          <div>
            <label
              for='linkedin'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Linkedin</label>
            <input
              x-model='linkedin'
              @input='validateLinkedin()'
              type='text'
              id='linkedin'
              name='linkedin'
              value="{{mentor.linkedin}}"
              placeholder='link linkedin'
              required
              :class="errors.linkedin ? 'border-red-500 focus:ring-red-500' : success.linkedin ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
            />
            <p x-show='errors.linkedin' x-text='errors.linkedin' class='mt-1 text-sm text-red-600'></p>
          </div>

          <div>
            <label
              for='github'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Github</label>
            <input
              x-model='github'
              @input='validateGithub()'
              type='text'
              id='github'
              name='github'
              value="{{mentor.github}}"
              placeholder='Link github'
              required
              :class="errors.github ? 'border-red-500 focus:ring-red-500' : success.github ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
            />
            <p x-show='errors.github' x-text='errors.github' class='mt-1 text-sm text-red-600'></p>
          </div>
          <!-- TTD -->
          <!-- TTD (signature) - validation mirrors profile -->
          <div
            x-data="{
                previewUrl: null,
                oldTTD: '{{#if mentor.ttd}}{{mentor.ttd}}{{else}}/images/default-signature.png{{/if}}',
                errorMessage: '',
                isValid: true,
                fileName: '',
                fileSize: 0,
                imageWidth: 0,
                imageHeight: 0,
                hasFile: false,
                validateImage(file) {
                  if (!file) { this.hasFile = false; return; }
                  this.hasFile = true; this.fileName = file.name; this.fileSize = file.size; this.errorMessage = ''; this.isValid = true;
                  const allowedTypes = ['image/jpeg','image/jpg','image/png'];
                  if (!allowedTypes.includes(file.type)) { this.errorMessage = 'Only JPEG, JPG and PNG formats are allowed'; this.isValid = false; this.previewUrl = null; return; }
                  const maxSize = 5 * 1024 * 1024;
                  if (file.size > maxSize) { this.errorMessage = `File size too large (${(file.size/1024/1024).toFixed(2)}MB). Maximum 5MB`; this.isValid = false; this.previewUrl = null; return; }
                  const img = new Image(); const objectUrl = URL.createObjectURL(file);
                  img.onload = () => { this.imageWidth = img.width; this.imageHeight = img.height; if (img.width < 300 || img.width > 2000 || img.height < 300 || img.height > 2000) { this.errorMessage = `Image dimensions ${img.width}x${img.height}px. Required: 300x300 to 2000x2000`; this.isValid = false; this.previewUrl = null; URL.revokeObjectURL(objectUrl); } else { this.previewUrl = objectUrl; this.isValid = true; this.errorMessage = ''; } };
                  img.onerror = () => { this.errorMessage = 'Failed to load image'; this.isValid = false; this.previewUrl = null; URL.revokeObjectURL(objectUrl); };
                  img.src = objectUrl;
                },
                clearFile() { this.previewUrl = null; this.errorMessage = ''; this.isValid = true; this.fileName = ''; this.fileSize = 0; this.imageWidth = 0; this.imageHeight = 0; this.hasFile = false; $refs.ttdFile.value = null; }
              }"
            class='space-y-3'
          >
            <label
              for='ttd'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >TTD
              <span class='text-xs text-gray-500'>(300x300 - 2000x2000px, max
                5MB, JPG/PNG)</span></label>
            <input
              type='file'
              id='ttd'
              name='ttd'
              accept='image/jpeg,image/jpg,image/png'
              x-ref='ttdFile'
              class='w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
              @change='validateImage($event.target.files[0])'
            />

            <template x-if='!isValid && errorMessage'>
              <div
                class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
              >
                <div class='text-red-600 font-semibold'>Invalid image</div>
                <div class='text-sm text-red-700' x-text='errorMessage'></div>
              </div>
            </template>

            <template x-if='previewUrl && isValid'>
              <div class='space-y-2'>
                <div class='relative w-32 h-32'>
                  <img
                    :src='previewUrl'
                    alt='Preview'
                    class='w-32 h-32 object-cover rounded-lg border border-gray-300'
                  />
                  <button
                    type='button'
                    class='absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center'
                    @click='clearFile()'
                  >&times;</button>
                </div>
              </div>
            </template>

            <template x-if="!hasFile">
              <div class='space-y-2'>
                <div class='text-sm text-gray-600'>Current signature:</div>
                <img :src='oldTTD' alt='Current signature' class='w-32 h-32 object-cover rounded-lg border border-gray-300' />
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Buttons -->
      <div class='flex justify-end space-x-4'>
        <a
          href='/kelass/detail/kelas/admin/{{mentor.kelas.id}}'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition'
        >Cancel</a>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="canSubmit() ? 'bg-gray-900 hover:bg-gray-600' : 'bg-gray-400 cursor-not-allowed'"
          class='text-white px-6 py-2 rounded-lg shadow transition'
        >Save Changes</button>
      </div>
    </form>
  </div>
</div>
