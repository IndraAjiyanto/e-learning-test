{{!--
  Halaman: Edit Mentor — Super Admin
  Lokasi: src/views/super_admin/mentor/edit.hbs
  Level: L4 Page

  Route: GET /mentor/formEdit/:mentorId -> PATCH /mentor/:courseId/:mentorId
  (multipart + _method override). Foto hanya diganti bila user mengunggah yang
  baru; tanpa itu controller mempertahankan `mentor.profile` yang tersimpan.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Mentor'
      }}

      {{> components/ui/super_admin/description/index
        text='Adjust the information below to edit a mentor.'
      }}
    </div>

    <form
      action='/mentor/{{mentor.course.id}}/{{mentor.id}}?_method=PATCH'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='mentorForm({ mentor: {{json mentor}}, technologies: {{json technologies}} })'
      @submit.prevent='submitForm($event)'
      class='flex flex-col gap-4'
    >
      <div class='rounded-xl border border-[#d9d9d9] bg-white p-5'>
        {{> components/ui/super_admin/form/mentor/fields }}
      </div>

      {{> components/ui/super_admin/form/button
        row=true
        card=true
        cancelHref=(concat '/program/detail/program/admin/' mentor.course.id)
        submitLabel='Save Changes'
        disabled='!canSubmit() || loading'
      }}
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/mentor/form }}
