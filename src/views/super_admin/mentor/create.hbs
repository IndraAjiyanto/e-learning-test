<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        // Image validation states
        previewUrl: null,
        errorMessage: '',
        isValid: true,
        fileName: '',
        fileSize: 0,
        imageWidth: 0,
        imageHeight: 0,
        hasFile: false,
        


        // Form validation states
        formData: {
          nama: '',
          posisi: { id: '', en: '', ja: '' },
          deskripsi: { id: '', en: '', ja: '' },
          linkedin: '',
        },
        formErrors: {
          nama: '',
          posisi: { id: '', en: '', ja: '' },
          deskripsi: { id: '', en: '', ja: '' },
          linkedin: '',
        },
        formValid: {
          nama: false,
          posisi: { id: false, en: false, ja: false },
          deskripsi: { id: false, en: false, ja: false },
          linkedin: false,
        },
        formTouched: {
          nama: false,
          posisi: { id: false, en: false, ja: false },
          deskripsi: { id: false, en: false, ja: false },
          linkedin: false,
        },

        validateField(field, value, lang = null) {
          if (lang) {
            this.formData[field][lang] = value;
            this.formTouched[field][lang] = true;
          } else {
            this.formData[field] = value;
            this.formTouched[field] = true;
          }
          
          switch(field) {
            case 'nama':
              if (!value.trim()) {
                this.formErrors.nama = 'Mentor name is required';
                this.formValid.nama = false;
              } else {
                this.formErrors.nama = '';
                this.formValid.nama = true;
              }
              break;
              
            case 'posisi':
              if (!value.trim()) {
                this.formErrors.posisi[lang] = 'Position is required';
                this.formValid.posisi[lang] = false;
              } else if (value.trim().length < 2) {
                this.formErrors.posisi[lang] = 'Position must be at least 2 characters';
                this.formValid.posisi[lang] = false;
              } else {
                this.formErrors.posisi[lang] = '';
                this.formValid.posisi[lang] = true;
              }
              break;
              
            case 'deskripsi':
              if (!value.trim()) {
                this.formErrors.deskripsi[lang] = 'Description is required';
                this.formValid.deskripsi[lang] = false;
              } else if (value.trim().length < 10) {
                this.formErrors.deskripsi[lang] = 'Description must be at least 10 characters';
                this.formValid.deskripsi[lang] = false;
              } else {
                this.formErrors.deskripsi[lang] = '';
                this.formValid.deskripsi[lang] = true;
              }
              break;
              
            case 'linkedin':
              if (!value.trim()) {
                this.formErrors.linkedin = 'LinkedIn link is required';
                this.formValid.linkedin = false;
              } else {
                this.formErrors.linkedin = '';
                this.formValid.linkedin = true;
              }
              break;
              
          }
        },

        validateImage(file) {
          if (!file) { this.hasFile = false; return; }
          this.hasFile = true;
          this.fileName = file.name;
          this.fileSize = file.size;
          this.errorMessage = '';
          this.isValid = true;
          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!allowedTypes.includes(file.type)) {
            this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
            this.isValid = false;
            this.previewUrl = null;
            return;
          }
          const maxSize = 5 * 1024 * 1024;
          if (file.size > maxSize) {
            this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
            this.isValid = false;
            this.previewUrl = null;
            return;
          }
          const img = new Image();
          const objectUrl = URL.createObjectURL(file);
          img.onload = () => {
            this.imageWidth = img.width;
            this.imageHeight = img.height;
            if (img.width < 300 || img.width > 2000 || img.height < 300 || img.height > 2000) {
              this.errorMessage = `Image dimensions ${img.width}x${img.height}px. Required: 300x300 to 2000x2000 pixels`;
              this.isValid = false;
              this.previewUrl = null;
              URL.revokeObjectURL(objectUrl);
            } else {
              this.previewUrl = objectUrl;
              this.isValid = true;
              this.errorMessage = '';
            }
          };
          img.onerror = () => {
            this.errorMessage = 'Failed to load image';
            this.isValid = false;
            this.previewUrl = null;
            URL.revokeObjectURL(objectUrl);
          };
          img.src = objectUrl;
        },

        clearFile() {
          this.previewUrl = null;
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '';
          this.fileSize = 0;
          this.imageWidth = 0;
          this.imageHeight = 0;
          this.hasFile = false;
          this.$refs.profileFile.value = null;
        },
        

        canSubmit() {
          const imageValid = !this.hasFile || this.isValid;
          const posisiValid = Object.values(this.formValid.posisi).every(v => v);
          const deskripsiValid = Object.values(this.formValid.deskripsi).every(v => v);
          const formValid = this.formValid.nama && posisiValid && deskripsiValid && this.formValid.linkedin;
          return imageValid && formValid;
        },

        hasFormErrors() {
          return this.formErrors.nama !== '' || 
                 Object.values(this.formErrors.posisi).some(e => e !== '') ||
                 Object.values(this.formErrors.deskripsi).some(e => e !== '') ||
                 this.formErrors.linkedin !== '' 
        }
      }"
  >
    <h2 class='text-2xl font-semibold mt-0 mb-6 text-center text-gray-900'>Create Mentor</h2>
    <form
      method='POST'
      action='/mentor/{{kelasId}}'
      enctype='multipart/form-data'
      class='space-y-6'
      @submit.prevent="if (canSubmit()) { $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

      <!-- Profile Photo Upload Section -->
      <div class='space-y-3'>
        <label
          for='profile'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Photos Profile
          <span class='text-xs text-gray-500 font-normal'>(300x300 -
            2000x2000px, max 5MB, JPG/PNG)</span>
        </label>
        <input
          type='file'
          id='profile'
          name='profile'
          accept='image/jpeg,image/jpg,image/png'
          x-ref='profileFile'
          :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-900 file:text-white hover:file:bg-gray-700 file:cursor-pointer'
          @change='validateImage($event.target.files[0])'
        />

        <!-- Error Message -->
        <template x-if='!isValid && errorMessage'>
          <div
            class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <div>
              <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
              <p class='text-xs text-red-700' x-text='errorMessage'></p>
            </div>
          </div>
        </template>

        <!-- Success Message with File Info -->
        <template x-if='hasFile && isValid'>
          <div class='space-y-2'>
            <div
              class='flex items-center justify-between p-3 bg-green-50 border border-green-300 rounded-lg'
            >
              <div class='flex items-center gap-2'>
                <i class='fas fa-check-circle text-green-500'></i>
                <div class='text-xs text-green-700'>
                  <span class='font-semibold'>Valid image:</span>
                  <span
                    x-text='`${imageWidth}x${imageHeight}px, ${(fileSize / 1024).toFixed(1)}KB`'
                  ></span>
                </div>
              </div>
              <button
                type='button'
                class='text-red-500 hover:text-red-700 transition-colors'
                @click='clearFile()'
                title='Remove image'
              >
                <i class='fas fa-times-circle'></i>
              </button>
            </div>

            <!-- Image Preview -->
            <div class='relative w-32 h-32'>
              <img
                :src='previewUrl'
                alt='Preview Photos'
                class='w-32 h-32 object-cover rounded-lg border-2 border-green-500 shadow-sm'
              />
              <button
                type='button'
                class='absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center shadow hover:bg-red-600'
                @click='clearFile()'
              >
                &times;
              </button>
            </div>
          </div>
        </template>
      </div>

      <!-- Form Fields Grid -->
      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
        <!-- LEFT COLUMN -->
        <div class='space-y-6'>
          <!-- Nama -->
          <div class='space-y-2'>
            <label
              for='nama'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Nama Mentor</label>
            <input
              x-model='formData.nama'
              @input='validateField("nama", $event.target.value)'
              type='text'
              id='nama'
              name='nama'
              placeholder='Enter mentor name'
              required
              :class="formErrors.nama ? 'border-red-500 focus:ring-red-500' : formValid.nama && !formErrors.nama ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
            />

            <!-- Error Message -->
            <template x-if='formErrors.nama'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.nama'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.nama && !formErrors.nama'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid mentor name</p>
              </div>
            </template>
          </div>

          <!-- Posisi per Bahasa -->
          <div class='space-y-4'>
            <label
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Position</label>
            <div class='grid grid-cols-1 gap-4'>
              <!-- ID -->
              <div class='space-y-2'>
                <label
                  class='block text-xs font-medium text-gray-600'
                >ID</label>
                <input
                  x-model='formData.posisi.id'
                  @input='validateField("posisi", $event.target.value, "id")'
                  type='text'
                  name='posisi[id]'
                  required
                  maxlength='255'
                  :class="formErrors.posisi.id ? 'border-red-500 focus:ring-red-500' : (formValid.posisi.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
                  class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                  placeholder='Posisi (ID)'
                />
                <template x-if='formErrors.posisi.id'>
                  <div
                    class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                  >
                    <i
                      class='fas fa-exclamation-circle text-red-500 mt-0.5'
                    ></i>
                    <p
                      class='text-xs text-red-700'
                      x-text='formErrors.posisi.id'
                    ></p>
                  </div>
                </template>
                <template
                  x-if='formTouched.posisi.id && formValid.posisi.id && !formErrors.posisi.id'
                >
                  <div
                    class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                  >
                    <i class='fas fa-check-circle text-green-500'></i>
                    <p class='text-xs text-green-700'>Valid</p>
                  </div>
                </template>
              </div>

              <!-- EN -->
              <div class='space-y-2'>
                <label
                  class='block text-xs font-medium text-gray-600'
                >EN</label>
                <input
                  x-model='formData.posisi.en'
                  @input='validateField("posisi", $event.target.value, "en")'
                  type='text'
                  name='posisi[en]'
                  required
                  maxlength='255'
                  :class="formErrors.posisi.en ? 'border-red-500 focus:ring-red-500' : (formValid.posisi.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
                  class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                  placeholder='Position (EN)'
                />
                <template x-if='formErrors.posisi.en'>
                  <div
                    class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                  >
                    <i
                      class='fas fa-exclamation-circle text-red-500 mt-0.5'
                    ></i>
                    <p
                      class='text-xs text-red-700'
                      x-text='formErrors.posisi.en'
                    ></p>
                  </div>
                </template>
                <template
                  x-if='formTouched.posisi.en && formValid.posisi.en && !formErrors.posisi.en'
                >
                  <div
                    class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                  >
                    <i class='fas fa-check-circle text-green-500'></i>
                    <p class='text-xs text-green-700'>Valid</p>
                  </div>
                </template>
              </div>

              <!-- JP -->
              <div class='space-y-2'>
                <label
                  class='block text-xs font-medium text-gray-600'
                >JP</label>
                <input
                  x-model='formData.posisi.ja'
                  @input='validateField("posisi", $event.target.value, "ja")'
                  type='text'
                  name='posisi[ja]'
                  required
                  maxlength='255'
                  :class="formErrors.posisi.ja ? 'border-red-500 focus:ring-red-500' : (formValid.posisi.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
                  class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                  placeholder='役職 (JA)'
                />
                <template x-if='formErrors.posisi.ja'>
                  <div
                    class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                  >
                    <i
                      class='fas fa-exclamation-circle text-red-500 mt-0.5'
                    ></i>
                    <p
                      class='text-xs text-red-700'
                      x-text='formErrors.posisi.ja'
                    ></p>
                  </div>
                </template>
                <template
                  x-if='formTouched.posisi.ja && formValid.posisi.ja && !formErrors.posisi.ja'
                >
                  <div
                    class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                  >
                    <i class='fas fa-check-circle text-green-500'></i>
                    <p class='text-xs text-green-700'>Valid</p>
                  </div>
                </template>
              </div>
            </div>
          </div>

          <!-- Technologies -->
          <div
            x-data="{
          search: '',
          selectedTechs: [],
          showDropdown: false,
          availableTechs: {{json teknologi}},
          get filteredTechs() {
            return this.availableTechs.filter(t => 
              t.nama.toLowerCase().includes(this.search.toLowerCase()) &&
              !this.selectedTechs.find(s => s.id === t.id)
            );
          },
          selectTech(tech) {
            this.selectedTechs.push(tech);
            this.search = '';
            this.showDropdown = false;
          },
          removeTech(techId) {
            this.selectedTechs = this.selectedTechs.filter(t => t.id !== techId);
          }
        }"
            @click.away='showDropdown = false'
          >
            <label
              class='block text-sm font-semibold text-gray-700 mb-2'
            >Technologies</label>

            <!-- Selected Technologies -->
            <div
              class='flex flex-wrap gap-2 mb-3'
              x-show='selectedTechs.length > 0'
            >
              <template x-for='tech in selectedTechs' :key='tech.id'>
                <div
                  class='flex items-center gap-2 bg-gray-100 border border-gray-300 rounded-lg px-3 py-2'
                >
                  <div
                    class='w-6 h-6 flex items-center justify-center'
                    x-html='tech.svg'
                  ></div>
                  <span
                    class='text-sm font-medium text-gray-700'
                    x-text='tech.nama'
                  ></span>
                  <button
                    type='button'
                    @click='removeTech(tech.id)'
                    class='text-red-500 hover:text-red-700 ml-2'
                  >
                    <i class='fas fa-times'></i>
                  </button>
                  <input type='hidden' name='teknologiIds[]' :value='tech.id' />
                </div>
              </template>
            </div>

            <!-- Search Input -->
            <div class='relative'>
              <input
                type='text'
                x-model='search'
                @focus='showDropdown = true'
                @input='showDropdown = true'
                placeholder='Search and select technologies...'
                class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
              />
              <i
                class='fas fa-search absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400'
              ></i>

              <!-- Dropdown -->
              <div
                x-show='showDropdown && filteredTechs.length > 0'
                class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'
              >
                <template x-for='tech in filteredTechs' :key='tech.id'>
                  <button
                    type='button'
                    @click='selectTech(tech)'
                    class='w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition text-left border-b border-gray-100 last:border-0'
                  >
                    <div
                      class='w-8 h-8 flex items-center justify-center flex-shrink-0'
                      x-html='tech.svg'
                    ></div>
                    <span
                      class='text-sm font-medium text-gray-700'
                      x-text='tech.nama'
                    ></span>
                  </button>
                </template>
              </div>
            </div>

            <p class='text-xs text-gray-500 mt-2'>Click to select technologies
              from the list</p>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class='space-y-6'>
          <!-- Deskripsi per Bahasa -->
          <div class='space-y-4'>
            <label
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Description</label>
            <div class='grid grid-cols-1 gap-4'>
              <!-- ID -->
              <div class='space-y-2'>
                <label
                  class='block text-xs font-medium text-gray-600'
                >ID</label>
                <textarea
                  x-model='formData.deskripsi.id'
                  @input='validateField("deskripsi", $event.target.value, "id")'
                  name='deskripsi[id]'
                  rows='6'
                  required
                  maxlength='1000'
                  :class="formErrors.deskripsi.id ? 'border-red-500 focus:ring-red-500' : (formValid.deskripsi.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
                  class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
                  placeholder='Deskripsi (ID)'
                ></textarea>
                <template x-if='formErrors.deskripsi.id'>
                  <div
                    class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                  >
                    <i
                      class='fas fa-exclamation-circle text-red-500 mt-0.5'
                    ></i>
                    <p
                      class='text-xs text-red-700'
                      x-text='formErrors.deskripsi.id'
                    ></p>
                  </div>
                </template>
                <template
                  x-if='formTouched.deskripsi.id && formValid.deskripsi.id && !formErrors.deskripsi.id'
                >
                  <div
                    class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                  >
                    <i class='fas fa-check-circle text-green-500'></i>
                    <p class='text-xs text-green-700'>Valid</p>
                  </div>
                </template>
              </div>

              <!-- EN -->
              <div class='space-y-2'>
                <label
                  class='block text-xs font-medium text-gray-600'
                >EN</label>
                <textarea
                  x-model='formData.deskripsi.en'
                  @input='validateField("deskripsi", $event.target.value, "en")'
                  name='deskripsi[en]'
                  rows='6'
                  required
                  maxlength='1000'
                  :class="formErrors.deskripsi.en ? 'border-red-500 focus:ring-red-500' : (formValid.deskripsi.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
                  class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
                  placeholder='Description (EN)'
                ></textarea>
                <template x-if='formErrors.deskripsi.en'>
                  <div
                    class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                  >
                    <i
                      class='fas fa-exclamation-circle text-red-500 mt-0.5'
                    ></i>
                    <p
                      class='text-xs text-red-700'
                      x-text='formErrors.deskripsi.en'
                    ></p>
                  </div>
                </template>
                <template
                  x-if='formTouched.deskripsi.en && formValid.deskripsi.en && !formErrors.deskripsi.en'
                >
                  <div
                    class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                  >
                    <i class='fas fa-check-circle text-green-500'></i>
                    <p class='text-xs text-green-700'>Valid</p>
                  </div>
                </template>
              </div>

              <!-- JP -->
              <div class='space-y-2'>
                <label
                  class='block text-xs font-medium text-gray-600'
                >JP</label>
                <textarea
                  x-model='formData.deskripsi.ja'
                  @input='validateField("deskripsi", $event.target.value, "ja")'
                  name='deskripsi[ja]'
                  rows='6'
                  required
                  maxlength='1000'
                  :class="formErrors.deskripsi.ja ? 'border-red-500 focus:ring-red-500' : (formValid.deskripsi.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
                  class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
                  placeholder='説明 (JA)'
                ></textarea>
                <template x-if='formErrors.deskripsi.ja'>
                  <div
                    class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                  >
                    <i
                      class='fas fa-exclamation-circle text-red-500 mt-0.5'
                    ></i>
                    <p
                      class='text-xs text-red-700'
                      x-text='formErrors.deskripsi.ja'
                    ></p>
                  </div>
                </template>
                <template
                  x-if='formTouched.deskripsi.ja && formValid.deskripsi.ja && !formErrors.deskripsi.ja'
                >
                  <div
                    class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                  >
                    <i class='fas fa-check-circle text-green-500'></i>
                    <p class='text-xs text-green-700'>Valid</p>
                  </div>
                </template>
              </div>
            </div>
          </div>

          <!-- LinkedIn -->
          <div class='space-y-2'>
            <label
              for='linkedin'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Linkedin</label>
            <input
              x-model='formData.linkedin'
              @input='validateField("linkedin", $event.target.value)'
              type='text'
              id='linkedin'
              name='linkedin'
              placeholder='link linkedin'
              required
              :class="formErrors.linkedin ? 'border-red-500 focus:ring-red-500' : formValid.linkedin && !formErrors.linkedin ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
            />

            <!-- Error Message -->
            <template x-if='formErrors.linkedin'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.linkedin'
                ></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.linkedin && !formErrors.linkedin'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid LinkedIn link</p>
              </div>
            </template>
          </div>


        </div>
      </div>

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >Create</button>
        <a
          href='/kelass/detail/kelas/admin/{{kelasId}}'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >Cancel</a>
      </div>

      <!-- Submit Warning -->
      <template
        x-if='hasFormErrors() || (hasFile && !isValid)'
      >
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>