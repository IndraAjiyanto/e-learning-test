{{!--
  Halaman: Create Mentor — Super Admin
  Lokasi: src/views/super_admin/mentor/create.hbs
  Level: L4 Page

  Route: GET /mentor/formCreate/:courseId -> POST /mentor/:courseId (multipart:
  profile + field teks, position[id|en|ja], description[id|en|ja], technologyId[]).
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Mentor'
      }}

      {{> components/ui/super_admin/description/index
        text='Add a mentor to this program of Kesatria Academy.'
      }}
    </div>

    <form
      action='/mentor/{{courseId}}'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='mentorForm({ technologies: {{json technologies}} })'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-5'
    >
      <div class='flex flex-col gap-5'>
        {{> components/ui/super_admin/form/mentor/fields }}

        {{> components/ui/super_admin/form/button
          row=true
          cancelHref=(concat '/program/detail/program/admin/' courseId)
          submitLabel='Create Mentor'
          disabled='!canSubmit() || loading'
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/mentor/form }}
