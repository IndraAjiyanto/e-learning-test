{{!--
  Halaman: Create Mentor — Super Admin
  Lokasi: src/views/super_admin/mentor/create.hbs
  Level: L4 Page

  Route: GET /mentor/formCreate/:courseId -> POST /mentor/:courseId (multipart:
  profile + field teks, position[id|en|ja], description[id|en|ja], technologyId[]).
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Mentor'
      }}

      {{> components/ui/super_admin/description/index
        text='Fill in the information below to create a new mentor.'
      }}
    </div>

    <form
      action='/mentor/{{courseId}}'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='mentorForm({ technologies: {{json technologies}} })'
      @submit.prevent='submitForm($event)'
      class='flex flex-col gap-4'
    >
      <div class='rounded-xl border border-[#d9d9d9] bg-white p-5'>
        {{> components/ui/super_admin/form/mentor/fields }}
      </div>

      {{> components/ui/super_admin/form/button
        row=true
        card=true
        cancelHref=(concat '/program/detail/program/admin/' courseId)
        submitLabel='Create Mentor'
        disabled='!canSubmit() || loading'
      }}
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/mentor/form }}
