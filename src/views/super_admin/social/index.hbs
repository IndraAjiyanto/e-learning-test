<div
  class='w-full mx-auto px-6 py-10'
  x-data='socialTable({ socials: {{json socials}} })'
>
  <div
    class='mb-6 flex flex-col md:flex-row md:justify-between md:items-center gap-4'
  >
    <h2 class='text-3xl font-bold text-gray-900 text-center md:text-left'>Social
      Media</h2>

    <div class='flex items-center gap-3'>
      {{#if socials.length}}
      {{else}}
      <a
        href='/social/formCreate'
        class='bg-gray-900 text-white px-4 py-2 rounded-lg shadow hover:bg-gray-600 transition whitespace-nowrap'
      >
        Create Social
      </a>
      {{/if}}
    </div>
  </div>

  <div class='overflow-x-auto bg-white shadow-lg rounded-xl'>
    <table class='min-w-full divide-y divide-gray-200'>
      <thead class='bg-gray-100'>
        <tr>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >No</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >LinkedIn</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Instagram</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >YouTube</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >YouTube Video</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Email</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Phone</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Google Maps</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Link Form job</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Action</th>
        </tr>
      </thead>
      <tbody class='divide-y divide-gray-200'>
        {{#each socials}}
          <tr
            class='hover:bg-gray-50 transition'
            x-show="filteredSocials.includes('{{id}}')"
          >
            <td
              class='px-6 py-4 text-sm text-gray-800'
              x-text="filteredSocials.indexOf('{{id}}') + 1 + (pageNumber * size)"
            ></td>
            <td class='px-6 py-4 text-sm text-gray-800'>
              <a
                href='{{linkedin}}'
                target='_blank'
                class='text-blue-600 hover:underline flex items-center gap-2'
              >
                <i class='fab fa-linkedin'></i>
                <span class='truncate max-w-[150px]'>{{linkedin}}</span>
              </a>
            </td>
            <td class='px-6 py-4 text-sm text-gray-800'>
              <a
                href='{{instragram}}'
                target='_blank'
                class='text-pink-600 hover:underline flex items-center gap-2'
              >
                <i class='fab fa-instagram'></i>
                <span class='truncate max-w-[150px]'>{{instragram}}</span>
              </a>
            </td>
            <td class='px-6 py-4 text-sm text-gray-800'>
              <a
                href='{{youtube}}'
                target='_blank'
                class='text-red-600 hover:underline flex items-center gap-2'
              >
                <i class='fab fa-youtube'></i>
                <span class='truncate max-w-[150px]'>{{youtube}}</span>
              </a>
            </td>
            <td class='px-6 py-4 text-sm text-gray-800'>
              {{#if video_youtube}}
                <a
                  href='{{video_youtube}}'
                  target='_blank'
                  class='text-red-600 hover:underline flex items-center gap-2'
                >
                  <i class='fab fa-youtube'></i>
                  <span class='truncate max-w-[150px]'>{{video_youtube}}</span>
                </a>
              {{else}}
                <span class='text-gray-400 italic'>No video</span>
              {{/if}}
            </td>
            <td class='px-6 py-4 text-sm text-gray-800'>
              <a
                href='mailto:{{email}}'
                class='text-gray-600 hover:underline flex items-center gap-2'
              >
                <i class='fas fa-envelope'></i>
                <span class='truncate max-w-[150px]'>{{email}}</span>
              </a>
            </td>
            <td class='px-6 py-4 text-sm text-gray-800'>
              <div class='flex items-center gap-2'>
                <i class='fas fa-phone text-gray-600'></i>
                <span>{{nomor}}</span>
              </div>
            </td>
            <!-- Google Maps Embed -->
            <td class='px-6 py-4 text-sm text-gray-800'>
              {{#if link_alamat}}
                <div
                  class='w-full max-w-xs md:max-w-sm lg:max-w-md mx-auto rounded overflow-hidden border border-gray-200'
                >
                  {{{link_alamat}}}
                </div>
              {{else}}
                <span class='text-gray-400 italic'>No map</span>
              {{/if}}
            </td>
            <td class='px-6 py-4 text-sm text-gray-800'>
              <a
                href='{{link_form}}'
                target='_blank'
                class='text-green-600 hover:underline flex items-center gap-2'
              >
                <i class='fas fa-link'></i>
                <span class='truncate max-w-[150px]'>{{link_form}}</span>
              </a>
            </td>
            <td class='px-6 py-4 text-sm text-gray-800 flex items-center gap-3'>
              <!-- Edit Button -->
              <form action='/social/formEdit/{{id}}' method='get'>
                <button
                  type='submit'
                  class='p-2 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 hover:text-blue-800 transition'
                  title='Edit'
                >
                  <!-- Pencil Icon -->
                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke-width='1.5'
                    stroke='currentColor'
                    class='w-5 h-5'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 
                         2.652L10.582 16.07a4.5 4.5 0 01-1.897 
                         1.13l-2.685.805.805-2.685a4.5 4.5 
                         0 011.13-1.897l10.927-10.936z'
                    />
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M19.5 7.125L16.875 4.5'
                    />
                  </svg>
                </button>
              </form>

              <!-- Delete Button -->
              <form action='/social/{{id}}?_method=DELETE' method='post'>
                <button
                  type='button'
                  onclick='confirmDelete(this)'
                  class='p-2 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-800 transition'
                  title='Delete'
                >
                  <!-- Trash Icon -->
                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke-width='1.5'
                    stroke='currentColor'
                    class='w-5 h-5'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244
  2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0
  0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09
  2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0'
                    />
                  </svg>
                </button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <div
    class='w-full md:w-1/2 mx-auto py-6 flex justify-center gap-2 items-center'
    x-show='pageCount() > 1'
  >
    <button
      @click='prevPage'
      :disabled='pageNumber==0'
      class='px-3 py-1 rounded border border-gray-900 text-gray-900'
      :class="{ 'opacity-50 cursor-not-allowed': pageNumber==0 }"
    >Prev</button>

    <template x-for='(page,index) in pages()' :key='index'>
      <button
        @click='viewPage(index)'
        class='px-3 py-1 rounded'
        :class="{ 'bg-gray-900 text-white font-bold': index===pageNumber }"
        x-text='index+1'
      ></button>
    </template>

    <button
      @click='nextPage'
      :disabled='pageNumber >= pageCount()-1'
      class='px-3 py-1 rounded border border-gray-900 text-gray-900'
      :class="{ 'opacity-50 cursor-not-allowed': pageNumber >= pageCount()-1 }"
    >Next</button>
  </div>
</div>

<script>
  function socialTable({ socials }) {
    return {
      searchInput: "",
      search: "",
      pageNumber: 0,
      size: 5,
      socials,
      amount: 0,

      get filteredSocials() {
        let filtered = this.socials.filter((s) =>
          (
            `${s.linkedin} ${s.instragram} ${s.youtube} ${s.video_youtube} ${s.email} ${s.nomor} ${s.alamat}`
          )
            .toLowerCase()
            .includes(this.search.toLowerCase())
        );

        this.amount = filtered.length;

        const start = this.pageNumber * this.size;
        const end = start + this.size;

        // Mengembalikan hanya ID sebagai string
        return filtered.slice(start, end).map((s) => s.id.toString());
      },

      pages() {
        return Array.from({ length: this.pageCount() });
      },

      pageCount() {
        return Math.ceil(this.amount / this.size);
      },

      nextPage() {
        if (this.pageNumber < this.pageCount() - 1) {
          this.pageNumber++;
        }
      },

      prevPage() {
        if (this.pageNumber > 0) {
          this.pageNumber--;
        }
      },

      viewPage(index) {
        this.pageNumber = index;
      },
    };
  }
</script>
