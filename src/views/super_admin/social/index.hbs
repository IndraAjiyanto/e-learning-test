{{!--
  Halaman: Social Media — Super Admin
  Lokasi: src/views/super_admin/social/index.hbs
  Level: L4 Page

  Data: GET /social -> { socials }. Search & pagination dijalankan di sisi client
  lewat clientTable(), karena controller sudah mengirim seluruh baris sekaligus.

  Tombol Create disembunyikan begitu satu baris sudah ada: halaman publik hanya
  membaca satu set kontak, jadi tabel ini praktis record tunggal.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Social Media'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage the contact and social media links shown across the public site.'
      }}
    </div>

    <div
      class='flex flex-col gap-3.5'
      x-data='clientTable({ items: {{json socials}}, searchKeys: ["linkedin", "instagram", "youtube", "videoYoutube", "email", "number", "address"] })'
    >
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search social media..'
        searchLabel='Search social media'
        createHref='/social/formCreate'
        createLabel='Create Social'
        hideCreate=socials.length
      }}

      {{#> components/ui/super_admin/table/card tableClass='min-w-[1622px]'}}
        <colgroup>
          <col class='w-[66px]' />
          <col class='w-[180px]' />
          <col class='w-[180px]' />
          <col class='w-[180px]' />
          <col class='w-[180px]' />
          <col class='w-[200px]' />
          <col class='w-[160px]' />
          <col class='w-[180px]' />
          <col class='w-[180px]' />
          <col class='w-[116px]' />
        </colgroup>
        <thead>
          <tr>
            {{> components/ui/super_admin/table/header_cell label='No' }}
            {{> components/ui/super_admin/table/header_cell label='LinkedIn' }}
            {{> components/ui/super_admin/table/header_cell label='Instagram' }}
            {{> components/ui/super_admin/table/header_cell label='YouTube' }}
            {{> components/ui/super_admin/table/header_cell label='YouTube Video' }}
            {{> components/ui/super_admin/table/header_cell label='Email' }}
            {{> components/ui/super_admin/table/header_cell label='Phone' }}
            {{> components/ui/super_admin/table/header_cell label='Google Maps' }}
            {{> components/ui/super_admin/table/header_cell label='Link Form Job' }}
            {{> components/ui/super_admin/table/header_cell label='Action' }}
          </tr>
        </thead>
        <tbody>
          <template x-for='(row, index) in rows' :key='row.id'>
            <tr class='transition-colors hover:bg-[#fafafa]'>

              {{> components/ui/super_admin/table/cell
                text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
              }}

              {{#> components/ui/super_admin/table/cell}}
                {{> components/ui/super_admin/table/link href='row.linkedin' }}
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell}}
                {{> components/ui/super_admin/table/link href='row.instagram' }}
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell}}
                {{> components/ui/super_admin/table/link href='row.youtube' }}
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell}}
                {{> components/ui/super_admin/table/link href='row.videoYoutube' }}
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell}}
                <span
                  class='block truncate font-inter text-sm leading-5 text-[#525252]'
                  :title='row.email'
                  x-text='row.email || "—"'
                ></span>
              {{/components/ui/super_admin/table/cell}}

              {{> components/ui/super_admin/table/cell text='row.number || "—"' }}

              {{#> components/ui/super_admin/table/cell}}
                {{> components/ui/super_admin/table/link href='row.linkAddress' }}
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell}}
                {{> components/ui/super_admin/table/link href='row.linkForm' }}
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell variant='action'}}
                {{> components/ui/super_admin/table/row_actions
                  entity='social media'
                  deleteAction="'/social/' + row.id + '?_method=DELETE'"
                  editHref="'/social/formEdit/' + row.id"
                }}
              {{/components/ui/super_admin/table/cell}}
            </tr>
          </template>

          {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='10'}}
            No social media found.
          {{/components/ui/super_admin/table/message_row}}
        </tbody>
      {{/components/ui/super_admin/table/card}}
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Social Media?'
  description='Are you sure you want to delete these social media links? This action will remove them from the public site and cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}
