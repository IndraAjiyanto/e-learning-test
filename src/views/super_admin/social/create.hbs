{{!--
  Halaman: Create Social Media — Super Admin
  Lokasi: src/views/super_admin/social/create.hbs
  Level: L4 Page

  Route: GET /social/formCreate -> POST /social.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Social Media'
      }}

      {{> components/ui/super_admin/description/index
        text='Add the contact and social media links shown across the public site.'
      }}
    </div>

    <form
      action='/social'
      method='post'
      novalidate
      x-data='socialForm()'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-5'
    >
      <div class='flex flex-col gap-5'>
        {{> components/ui/super_admin/form/social/fields }}

        {{> components/ui/super_admin/form/button
          row=true
          cancelHref='/social'
          submitLabel='Create Social Media'
          disabled='!canSubmit() || loading'
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/social/form }}
