<div class='py-10'>
  <div
    class='max-w-3xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
      // Form validation states
      formData: {
        linkedin: '',
        instagram: '',
        youtube: '',
        video_youtube: '',
        email: '',
        nomor: '',
        alamat: '',
        link_alamat: '',
        link_form: ''
      },
      formErrors: {
        linkedin: '',
        instagram: '',
        youtube: '',
        video_youtube: '',
        email: '',
        nomor: '',
        alamat: '',
        link_alamat: '',
        link_form: ''
      },
      formValid: {
        linkedin: false,
        instagram: false,
        youtube: false,
        video_youtube: false,
        email: false,
        nomor: false,
        alamat: false,
        link_alamat: false,
        link_form: false
      },

      validateField(field, value) {
        this.formData[field] = value;
        
        switch(field) {
          case 'linkedin':
            if (!value.trim()) {
              this.formErrors.linkedin = 'LinkedIn URL is required';
              this.formValid.linkedin = false;
            } else {
              try {
                new URL(value);
                if (!value.includes('linkedin.com')) {
                  this.formErrors.linkedin = 'Please enter a valid LinkedIn URL';
                  this.formValid.linkedin = false;
                } else {
                  this.formErrors.linkedin = '';
                  this.formValid.linkedin = true;
                }
              } catch {
                this.formErrors.linkedin = 'Please enter a valid URL';
                this.formValid.linkedin = false;
              }
            }
            break;
            
          case 'instagram':
            if (!value.trim()) {
              this.formErrors.instagram = 'Instagram URL is required';
              this.formValid.instagram = false;
            } else {
              try {
                new URL(value);
                if (!value.includes('instagram.com')) {
                  this.formErrors.instagram = 'Please enter a valid Instagram URL';
                  this.formValid.instagram = false;
                } else {
                  this.formErrors.instagram = '';
                  this.formValid.instagram = true;
                }
              } catch {
                this.formErrors.instagram = 'Please enter a valid URL';
                this.formValid.instagram = false;
              }
            }
            break;
            
          case 'youtube':
            if (!value.trim()) {
              this.formErrors.youtube = 'YouTube URL is required';
              this.formValid.youtube = false;
            } else {
              try {
                new URL(value);
                if (!value.includes('youtube.com') && !value.includes('youtu.be')) {
                  this.formErrors.youtube = 'Please enter a valid YouTube URL';
                  this.formValid.youtube = false;
                } else {
                  this.formErrors.youtube = '';
                  this.formValid.youtube = true;
                }
              } catch {
                this.formErrors.youtube = 'Please enter a valid URL';
                this.formValid.youtube = false;
              }
            }
            break;
            
          case 'video_youtube':
            if (!value.trim()) {
              this.formErrors.video_youtube = 'YouTube Video URL is required';
              this.formValid.video_youtube = false;
            } else {
              try {
                new URL(value);
                if (!value.includes('youtube.com') && !value.includes('youtu.be')) {
                  this.formErrors.video_youtube = 'Please enter a valid YouTube video URL';
                  this.formValid.video_youtube = false;
                } else {
                  this.formErrors.video_youtube = '';
                  this.formValid.video_youtube = true;
                }
              } catch {
                this.formErrors.video_youtube = 'Please enter a valid URL';
                this.formValid.video_youtube = false;
              }
            }
            break;
            
          case 'email':
            if (!value.trim()) {
              this.formErrors.email = 'Email is required';
              this.formValid.email = false;
            } else {
              const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
              if (!emailRegex.test(value)) {
                this.formErrors.email = 'Please enter a valid email address';
                this.formValid.email = false;
              } else {
                this.formErrors.email = '';
                this.formValid.email = true;
              }
            }
            break;
            
          case 'nomor':
            if (!value.trim()) {
              this.formErrors.nomor = 'Phone number is required';
              this.formValid.nomor = false;
            } else if (value.trim().length < 10) {
              this.formErrors.nomor = 'Phone number must be at least 10 characters';
              this.formValid.nomor = false;
            } else {
              this.formErrors.nomor = '';
              this.formValid.nomor = true;
            }
            break;
            
          case 'alamat':
            if (!value.trim()) {
              this.formErrors.alamat = 'Address is required';
              this.formValid.alamat = false;
            } else if (value.trim().length < 10) {
              this.formErrors.alamat = 'Address must be at least 10 characters';
              this.formValid.alamat = false;
            } else {
              this.formErrors.alamat = '';
              this.formValid.alamat = true;
            }
            break;
            
case 'link_alamat':
  if (!value.trim()) {
    this.formErrors.link_alamat = 'Link alamat is required';
    this.formValid.link_alamat = false;
  } else {
    this.formErrors.link_alamat = '';
    this.formValid.link_alamat = true;
  }
  break;

case 'link_form':
  if (!value.trim()) {
    this.formErrors.link_form = 'Link form is required';
    this.formValid.link_form = false;
  } else {
    try {
      new URL(value); // Cek apakah valid URL
      this.formErrors.link_form = '';
      this.formValid.link_form = true;
    } catch {
      this.formErrors.link_form = 'Please enter a valid URL';
      this.formValid.link_form = false;
    }
  }
  break;

        }
      },

      hasFormErrors() {
        return Object.values(this.formErrors).some(error => error !== '');
      },

      canSubmit() {
        return this.formValid.linkedin && this.formValid.instagram && this.formValid.youtube && this.formValid.video_youtube && this.formValid.email && this.formValid.nomor && this.formValid.alamat && this.formValid.link_alamat && this.formValid.link_form;
      }
    }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create Social Media</h2>

    <form
      action='/social'
      method='post'
      class='space-y-6'
      x-data='{ loading: false }'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; } loading = true;'
    >

      <!-- Form Fields Grid -->
      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>

        {{> super_admin/social/create/linkedin_input }}
        {{> super_admin/social/create/instagram_input }}
        {{> super_admin/social/create/youtube_input }}
        {{> super_admin/social/create/video_youtube_input }}
        {{> super_admin/social/create/email_input }}
        {{> super_admin/social/create/phone_input }}

      </div>

        {{> super_admin/social/create/address_input }}
        {{> super_admin/social/create/google_maps_input }}
        {{> super_admin/social/create/link_job_input }}

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span x-show='loading'><i
              class='loading loading-spinner loading-sm'
            ></i></span>
          <span x-show='!loading'>Create</span>
        </button>
        <a
          href='/social'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>