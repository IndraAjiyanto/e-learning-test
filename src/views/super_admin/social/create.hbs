<div class='py-10'>
  <div class='max-w-3xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create Social Media</h2>

    <form action='/social' method='post' class='space-y-6'>

      <!-- LinkedIn -->
      <div>
        <label
          for='linkedin'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          <i class='fab fa-linkedin text-blue-600 mr-2'></i>LinkedIn URL
        </label>
        <input
          type='url'
          id='linkedin'
          name='linkedin'
          required
          placeholder='https://linkedin.com/company/...'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        />
      </div>

      <!-- Instagram -->
      <div>
        <label
          for='instragram'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          <i class='fab fa-instagram text-pink-600 mr-2'></i>Instagram URL
        </label>
        <input
          type='url'
          id='instragram'
          name='instragram'
          required
          placeholder='https://instagram.com/...'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        />
      </div>

      <!-- YouTube -->
      <div>
        <label
          for='youtube'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          <i class='fab fa-youtube text-red-600 mr-2'></i>YouTube URL
        </label>
        <input
          type='url'
          id='youtube'
          name='youtube'
          required
          placeholder='https://youtube.com/@...'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        />
      </div>

      <!-- Email -->
      <div>
        <label
          for='email'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          <i class='fas fa-envelope text-gray-600 mr-2'></i>Email
        </label>
        <input
          type='email'
          id='email'
          name='email'
          required
          placeholder='contact@example.com'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        />
      </div>

      <!-- Phone Number -->
      <div>
        <label
          for='nomor'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          <i class='fas fa-phone text-green-600 mr-2'></i>Phone Number
        </label>
        <input
          type='text'
          id='nomor'
          name='nomor'
          required
          placeholder='+62 xxx xxxx xxxx'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        />
      </div>

      <!-- Address -->
      <div>
        <label
          for='alamat'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          <i class='fas fa-map-marker-alt text-red-600 mr-2'></i>Address
        </label>
        <textarea
          id='alamat'
          name='alamat'
          required
          rows='3'
          placeholder='Full address...'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        ></textarea>
      </div>

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          class='bg-gray-900 text-white px-6 py-2 rounded-lg shadow hover:bg-gray-600 transition'
        >
          Create
        </button>
        <a
          href='/social'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition'
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>