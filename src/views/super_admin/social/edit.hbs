<div class='py-10'>
  <div
    class='max-w-3xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
      // Form validation states
      formData: {
        linkedin: '{{social.linkedin}}',
        instagram: '{{social.instragram}}',
        youtube: '{{social.youtube}}',
        email: '{{social.email}}',
        nomor: '{{social.nomor}}',
        alamat: '{{social.alamat}}'
      },
      formErrors: {
        linkedin: '',
        instagram: '',
        youtube: '',
        email: '',
        nomor: '',
        alamat: ''
      },
      formValid: {
        linkedin: true,
        instagram: true,
        youtube: true,
        email: true,
        nomor: true,
        alamat: true
      },

      validateField(field, value) {
        this.formData[field] = value;
        
        switch(field) {
          case 'linkedin':
            if (!value.trim()) {
              this.formErrors.linkedin = 'LinkedIn URL is required';
              this.formValid.linkedin = false;
            } else {
              try {
                new URL(value);
                if (!value.includes('linkedin.com')) {
                  this.formErrors.linkedin = 'Please enter a valid LinkedIn URL';
                  this.formValid.linkedin = false;
                } else {
                  this.formErrors.linkedin = '';
                  this.formValid.linkedin = true;
                }
              } catch {
                this.formErrors.linkedin = 'Please enter a valid URL';
                this.formValid.linkedin = false;
              }
            }
            break;
            
          case 'instagram':
            if (!value.trim()) {
              this.formErrors.instagram = 'Instagram URL is required';
              this.formValid.instagram = false;
            } else {
              try {
                new URL(value);
                if (!value.includes('instagram.com')) {
                  this.formErrors.instagram = 'Please enter a valid Instagram URL';
                  this.formValid.instagram = false;
                } else {
                  this.formErrors.instagram = '';
                  this.formValid.instagram = true;
                }
              } catch {
                this.formErrors.instagram = 'Please enter a valid URL';
                this.formValid.instagram = false;
              }
            }
            break;
            
          case 'youtube':
            if (!value.trim()) {
              this.formErrors.youtube = 'YouTube URL is required';
              this.formValid.youtube = false;
            } else {
              try {
                new URL(value);
                if (!value.includes('youtube.com') && !value.includes('youtu.be')) {
                  this.formErrors.youtube = 'Please enter a valid YouTube URL';
                  this.formValid.youtube = false;
                } else {
                  this.formErrors.youtube = '';
                  this.formValid.youtube = true;
                }
              } catch {
                this.formErrors.youtube = 'Please enter a valid URL';
                this.formValid.youtube = false;
              }
            }
            break;
            
          case 'email':
            if (!value.trim()) {
              this.formErrors.email = 'Email is required';
              this.formValid.email = false;
            } else {
              const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
              if (!emailRegex.test(value)) {
                this.formErrors.email = 'Please enter a valid email address';
                this.formValid.email = false;
              } else {
                this.formErrors.email = '';
                this.formValid.email = true;
              }
            }
            break;
            
          case 'nomor':
            if (!value.trim()) {
              this.formErrors.nomor = 'Phone number is required';
              this.formValid.nomor = false;
            } else if (value.trim().length < 10) {
              this.formErrors.nomor = 'Phone number must be at least 10 characters';
              this.formValid.nomor = false;
            } else {
              this.formErrors.nomor = '';
              this.formValid.nomor = true;
            }
            break;
            
          case 'alamat':
            if (!value.trim()) {
              this.formErrors.alamat = 'Address is required';
              this.formValid.alamat = false;
            } else if (value.trim().length < 10) {
              this.formErrors.alamat = 'Address must be at least 10 characters';
              this.formValid.alamat = false;
            } else {
              this.formErrors.alamat = '';
              this.formValid.alamat = true;
            }
            break;
        }
      },

      canSubmit() {
        return this.formValid.linkedin && this.formValid.instagram && this.formValid.youtube && this.formValid.email && this.formValid.nomor && this.formValid.alamat;
      },

      hasFormErrors() {
        return Object.values(this.formErrors).some(error => error !== '');
      }
    }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Social Media</h2>

    <form
      action='/social/{{social.id}}?_method=PATCH'
      method='POST'
      class='space-y-6'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; }'
    >

      <!-- Form Fields Grid -->
      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>

        <!-- LinkedIn -->
        <div class='space-y-2'>
          <label
            for='linkedin'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >
            <i class='fab fa-linkedin text-blue-600 mr-2'></i>LinkedIn URL
          </label>
          <input
            x-model='formData.linkedin'
            @input='validateField("linkedin", $event.target.value)'
            type='url'
            id='linkedin'
            name='linkedin'
            required
            placeholder='https://linkedin.com/company/...'
            :class="formErrors.linkedin ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.linkedin ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          />

          <!-- Error Message -->
          <template x-if='formErrors.linkedin'>
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.linkedin'></p>
            </div>
          </template>

          <!-- Success Message -->
          <template x-if='formValid.linkedin && !formErrors.linkedin'>
            <div
              class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500'></i>
              <p class='text-xs text-green-700'>Valid LinkedIn URL</p>
            </div>
          </template>
        </div>

        <!-- Instagram -->
        <div class='space-y-2'>
          <label
            for='instragram'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >
            <i class='fab fa-instagram text-pink-600 mr-2'></i>Instagram URL
          </label>
          <input
            x-model='formData.instagram'
            @input='validateField("instagram", $event.target.value)'
            type='url'
            id='instragram'
            name='instragram'
            required
            placeholder='https://instagram.com/...'
            :class="formErrors.instagram ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.instagram ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          />

          <!-- Error Message -->
          <template x-if='formErrors.instagram'>
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.instagram'></p>
            </div>
          </template>

          <!-- Success Message -->
          <template x-if='formValid.instagram && !formErrors.instagram'>
            <div
              class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500'></i>
              <p class='text-xs text-green-700'>Valid Instagram URL</p>
            </div>
          </template>
        </div>

        <!-- YouTube -->
        <div class='space-y-2'>
          <label
            for='youtube'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >
            <i class='fab fa-youtube text-red-600 mr-2'></i>YouTube URL
          </label>
          <input
            x-model='formData.youtube'
            @input='validateField("youtube", $event.target.value)'
            type='url'
            id='youtube'
            name='youtube'
            required
            placeholder='https://youtube.com/@...'
            :class="formErrors.youtube ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.youtube ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          />

          <!-- Error Message -->
          <template x-if='formErrors.youtube'>
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.youtube'></p>
            </div>
          </template>

          <!-- Success Message -->
          <template x-if='formValid.youtube && !formErrors.youtube'>
            <div
              class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500'></i>
              <p class='text-xs text-green-700'>Valid YouTube URL</p>
            </div>
          </template>
        </div>

        <!-- Email -->
        <div class='space-y-2'>
          <label
            for='email'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >
            <i class='fas fa-envelope text-gray-600 mr-2'></i>Email
          </label>
          <input
            x-model='formData.email'
            @input='validateField("email", $event.target.value)'
            type='email'
            id='email'
            name='email'
            required
            placeholder='contact@example.com'
            :class="formErrors.email ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.email ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          />

          <!-- Error Message -->
          <template x-if='formErrors.email'>
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.email'></p>
            </div>
          </template>

          <!-- Success Message -->
          <template x-if='formValid.email && !formErrors.email'>
            <div
              class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500'></i>
              <p class='text-xs text-green-700'>Valid email address</p>
            </div>
          </template>
        </div>

        <!-- Phone Number -->
        <div class='space-y-2'>
          <label
            for='nomor'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >
            <i class='fas fa-phone text-green-600 mr-2'></i>Phone Number
          </label>
          <input
            x-model='formData.nomor'
            @input='validateField("nomor", $event.target.value)'
            type='text'
            id='nomor'
            name='nomor'
            required
            placeholder='+62 xxx xxxx xxxx'
            :class="formErrors.nomor ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.nomor ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          />

          <!-- Error Message -->
          <template x-if='formErrors.nomor'>
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.nomor'></p>
            </div>
          </template>

          <!-- Success Message -->
          <template x-if='formValid.nomor && !formErrors.nomor'>
            <div
              class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500'></i>
              <p class='text-xs text-green-700'>Valid phone number</p>
            </div>
          </template>
        </div>

        <!-- Empty column for spacing -->
        <div></div>
      </div>

      <!-- Address (Full Width) -->
      <div class='space-y-2'>
        <label
          for='alamat'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          <i class='fas fa-map-marker-alt text-red-600 mr-2'></i>Address
        </label>
        <textarea
          x-model='formData.alamat'
          @input='validateField("alamat", $event.target.value)'
          id='alamat'
          name='alamat'
          required
          rows='3'
          placeholder='Full address...'
          :class="formErrors.alamat ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.alamat ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
        ></textarea>

        <!-- Error Message -->
        <template x-if='formErrors.alamat'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.alamat'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.alamat && !formErrors.alamat'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid address</p>
          </div>
        </template>
      </div>

      <!-- Google Maps Embed Link -->
      <div class='space-y-2'>
        <label
          for='link_alamat'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          <i class='fas fa-map text-blue-600 mr-2'></i>Google Maps Embed Link
          (iframe)
        </label>
        <textarea
          id='link_alamat'
          name='link_alamat'
          x-model='formData.link_alamat'
          rows='3'
          required
          placeholder='<iframe src="..." ...></iframe>'
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none border-gray-300 focus:ring-gray-900'
        >{{social.link_alamat}}</textarea>
        <p class='text-xs text-gray-500'>Paste the Google Maps embed iframe code
          here.</p>
      </div>

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Update
        </button>
        <a
          href='/social'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>