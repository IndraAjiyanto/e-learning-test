<div class='py-10'>
  <div
    class='max-w-3xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
      // Form validation states
      formData: {
        linkedin: `{{social.linkedin}}`,
        instagram: `{{social.instagram}}`,
        youtube: `{{social.youtube}}`,
        videoYoutube: `{{social.videoYoutube}}`,
        email: `{{social.email}}`,
        number: `{{social.number}}`,
        address: `{{social.address}}`,
        linkAddress: `{{social.linkAddress}}`,
        linkForm: `{{social.linkForm}}`
      },
      formErrors: {
        linkedin: '',
        instagram: '',
        youtube: '',
        videoYoutube: '',
        email: '',
        number: '',
        address: '',
        linkAddress: '',
        linkForm: ''
      },
      formValid: {
        linkedin: true,
        instagram: true,
        youtube: true,
        videoYoutube: true,
        email: true,
        number: true,
        address: true,
        linkAddress: true,
        linkForm: true
      },

      validateField(field, value) {
        this.formData[field] = value;
        
        switch(field) {
          case 'linkedin':
            if (!value.trim()) {
              this.formErrors.linkedin = 'LinkedIn URL is required';
              this.formValid.linkedin = false;
            } else {
              try {
                new URL(value);
                if (!value.includes('linkedin.com')) {
                  this.formErrors.linkedin = 'Please enter a valid LinkedIn URL';
                  this.formValid.linkedin = false;
                } else {
                  this.formErrors.linkedin = '';
                  this.formValid.linkedin = true;
                }
              } catch {
                this.formErrors.linkedin = 'Please enter a valid URL';
                this.formValid.linkedin = false;
              }
            }
            break;
            
          case 'instagram':
            if (!value.trim()) {
              this.formErrors.instagram = 'Instagram URL is required';
              this.formValid.instagram = false;
            } else {
              try {
                new URL(value);
                if (!value.includes('instagram.com')) {
                  this.formErrors.instagram = 'Please enter a valid Instagram URL';
                  this.formValid.instagram = false;
                } else {
                  this.formErrors.instagram = '';
                  this.formValid.instagram = true;
                }
              } catch {
                this.formErrors.instagram = 'Please enter a valid URL';
                this.formValid.instagram = false;
              }
            }
            break;
            
          case 'youtube':
            if (!value.trim()) {
              this.formErrors.youtube = 'YouTube URL is required';
              this.formValid.youtube = false;
            } else {
              try {
                new URL(value);
                if (!value.includes('youtube.com') && !value.includes('youtu.be')) {
                  this.formErrors.youtube = 'Please enter a valid YouTube URL';
                  this.formValid.youtube = false;
                } else {
                  this.formErrors.youtube = '';
                  this.formValid.youtube = true;
                }
              } catch {
                this.formErrors.youtube = 'Please enter a valid URL';
                this.formValid.youtube = false;
              }
            }
            break;
            
          case 'videoYoutube':
            if (!value.trim()) {
              this.formErrors.videoYoutube = 'YouTube Video URL is required';
              this.formValid.videoYoutube = false;
            } else {
              try {
                new URL(value);
                if (!value.includes('youtube.com') && !value.includes('youtu.be')) {
                  this.formErrors.videoYoutube = 'Please enter a valid YouTube video URL';
                  this.formValid.videoYoutube = false;
                } else {
                  this.formErrors.videoYoutube = '';
                  this.formValid.videoYoutube = true;
                }
              } catch {
                this.formErrors.videoYoutube = 'Please enter a valid URL';
                this.formValid.videoYoutube = false;
              }
            }
            break;
            
          case 'email':
            if (!value.trim()) {
              this.formErrors.email = 'Email is required';
              this.formValid.email = false;
            } else {
              const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
              if (!emailRegex.test(value)) {
                this.formErrors.email = 'Please enter a valid email address';
                this.formValid.email = false;
              } else {
                this.formErrors.email = '';
                this.formValid.email = true;
              }
            }
            break;
            
          case 'number':
            if (!value.trim()) {
              this.formErrors.number = 'Phone number is required';
              this.formValid.number = false;
            } else if (value.trim().length < 10) {
              this.formErrors.number = 'Phone number must be at least 10 characters';
              this.formValid.number = false;
            } else {
              this.formErrors.number = '';
              this.formValid.number = true;
            }
            break;
            
          case 'address':
            if (!value.trim()) {
              this.formErrors.address = 'Address is required';
              this.formValid.address = false;
            } else if (value.trim().length < 10) {
              this.formErrors.address = 'Address must be at least 10 characters';
              this.formValid.address = false;
            } else {
              this.formErrors.address = '';
              this.formValid.address = true;
            }
            break;

case 'linkAddress':
  if (!value.trim()) {
    this.formErrors.linkAddress = 'Link address is required';
    this.formValid.linkAddress = false;
  } else {
    this.formErrors.linkAddress = '';
    this.formValid.linkAddress = true;
  }
  break;

  case 'linkForm':
  if (!value.trim()) {
    this.formErrors.linkForm = 'Link form is required';
    this.formValid.linkForm = false;
  } else {
    try {
      new URL(value); // Cek apakah valid URL
      this.formErrors.linkForm = '';
      this.formValid.linkForm = true;
    } catch {
      this.formErrors.linkForm = 'Please enter a valid URL';
      this.formValid.linkForm = false;
    }
  }
  break;



        }
      },

      canSubmit() {
        return this.formValid.linkedin && this.formValid.instagram && this.formValid.youtube && this.formValid.videoYoutube && this.formValid.email && this.formValid.number && this.formValid.address && this.formValid.linkAddress && this.formValid.linkForm;
      },

      hasFormErrors() {
        return Object.values(this.formErrors).some(error => error !== '');
      }
    }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Social Media</h2>

    <form
      action='/social/{{social.id}}?_method=PATCH'
      method='POST'
      class='space-y-6'
      x-data='{ loading: false }'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; } loading = true;'
    >

      <!-- Form Fields Grid -->
      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>

        {{> super_admin/social/edit/linkedin_input }}
        {{> super_admin/social/edit/instagram_input }}
        {{> super_admin/social/edit/youtube_input }}
        {{> super_admin/social/edit/videoYoutube_input }}
        {{> super_admin/social/edit/email_input }}
        {{> super_admin/social/edit/phone_input }}

      </div>

        {{> super_admin/social/edit/address_input }}
        {{> super_admin/social/edit/google_maps_input }}
        {{> super_admin/social/edit/link_job_input }}

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span x-show='loading'><i
              class='loading loading-spinner loading-sm'
            ></i></span>
          <span x-show='!loading'>Update</span>
        </button>
        <a
          href='/social'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>