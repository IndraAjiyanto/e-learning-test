<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create Misi</h2>

    <form
      action='/misi'
      method='post'
      class='space-y-6'
      x-data="{
      content: '',
      isi: '',
      errors: {},
      success: {},
      validateContent() {
        if (!this.content.trim()) {
          this.errors.content = 'Content is required';
          this.success.content = false;
        } else {
          delete this.errors.content;
          this.success.content = true;
        }
      },
      validateIsi() {
        if (!this.isi.trim()) {
          this.errors.isi = 'Isi is required';
          this.success.isi = false;
        } else {
          delete this.errors.isi;
          this.success.isi = true;
        }
      },
      canSubmit() {
        return this.content.trim() && this.isi.trim() && Object.keys(this.errors).length === 0;
      }
    }"
      @submit.prevent='if (!canSubmit()) return false'
    >
      <div>
        <label
          for='content'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Content</label>
        <textarea
          x-model='content'
          @input='validateContent()'
          id='content'
          name='content'
          rows='4'
          :class="errors.content ? 'border-red-500 focus:ring-red-500' : success.content ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
          placeholder='Enter content...'
          required
        ></textarea>
        <p
          x-show='errors.content'
          x-text='errors.content'
          class='mt-1 text-sm text-red-600'
        ></p>
      </div>

      <div>
        <label
          for='isi'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Isi</label>
        <textarea
          x-model='isi'
          @input='validateIsi()'
          id='isi'
          name='isi'
          rows='6'
          :class="errors.isi ? 'border-red-500 focus:ring-red-500' : success.isi ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
          placeholder='Enter isi...'
          required
        ></textarea>
        <p
          x-show='errors.isi'
          x-text='errors.isi'
          class='mt-1 text-sm text-red-600'
        ></p>
      </div>

      <div class='flex justify-end gap-4'>
        <a
          href='/misi'
          class='bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition'
        >Cancel</a>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="canSubmit() ? 'bg-gray-900 hover:bg-gray-600' : 'bg-gray-400 cursor-not-allowed'"
          class='text-white px-4 py-2 rounded-lg transition'
        >Create</button>
      </div>
    </form>
  </div>
</div>