<div
  class='py-10'
  x-data="{
  // Form validation states
  formData: {
    content: { id: '', en: '', ja: '' },
    isi: { id: '', en: '', ja: '' }
  },
  formErrors: {
    content: { id: '', en: '', ja: '' },
    isi: { id: '', en: '', ja: '' }
  },
  formValid: {
    content: { id: false, en: false, ja: false },
    isi: { id: false, en: false, ja: false }
  },
  formTouched: {
    content: { id: false, en: false, ja: false },
    isi: { id: false, en: false, ja: false }
  },

  validateField(field, value, lang = null) {
    if (lang) {
      this.formData[field][lang] = value;
      this.formTouched[field][lang] = true;
    } else {
      this.formData[field] = value;
      this.formTouched[field] = true;
    }
    
    switch(field) {
      case 'content':
        if (!value.trim()) {
          this.formErrors.content[lang] = 'Content is required';
          this.formValid.content[lang] = false;
        } else {
          this.formErrors.content[lang] = '';
          this.formValid.content[lang] = true;
        }
        break;
        
      case 'isi':
        if (!value.trim()) {
          this.formErrors.isi[lang] = 'Text is required';
          this.formValid.isi[lang] = false;
        } else {
          this.formErrors.isi[lang] = '';
          this.formValid.isi[lang] = true;
        }
        break;
    }
  },

  canSubmit() {
    const contentValid = Object.values(this.formValid.content).every(v => v);
    const isiValid = Object.values(this.formValid.isi).every(v => v);
    return contentValid && isiValid;
  },

  hasFormErrors() {
    return Object.values(this.formErrors.content).some(e => e !== '') ||
           Object.values(this.formErrors.isi).some(e => e !== '');
  }
}"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create Misi</h2>

    <form
      action='/misi'
      method='POST'
      class='space-y-6'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; }'
    >

      <!-- Content per Bahasa -->
      <div class='space-y-4'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Content
        </label>
        <div class='grid grid-cols-1 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.content.id'
              @input='validateField("content", $event.target.value, "id")'
              name='content[id]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.content.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.content.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Konten (ID)'
            ></textarea>
            <template x-if='formErrors.content.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.content.id'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.content.id && formValid.content.id && !formErrors.content.id'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.content.en'
              @input='validateField("content", $event.target.value, "en")'
              name='content[en]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.content.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.content.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Content (EN)'
            ></textarea>
            <template x-if='formErrors.content.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.content.en'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.content.en && formValid.content.en && !formErrors.content.en'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JA -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JA</label>
            <textarea
              x-model='formData.content.ja'
              @input='validateField("content", $event.target.value, "ja")'
              name='content[ja]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.content.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.content.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='コンテンツ (JA)'
            ></textarea>
            <template x-if='formErrors.content.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.content.ja'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.content.ja && formValid.content.ja && !formErrors.content.ja'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Text per Bahasa -->
      <div class='space-y-4'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Text
        </label>
        <div class='grid grid-cols-1 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.isi.id'
              @input='validateField("isi", $event.target.value, "id")'
              name='isi[id]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.isi.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.isi.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Teks (ID)'
            ></textarea>
            <template x-if='formErrors.isi.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.isi.id'></p>
              </div>
            </template>
            <template
              x-if='formTouched.isi.id && formValid.isi.id && !formErrors.isi.id'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.isi.en'
              @input='validateField("isi", $event.target.value, "en")'
              name='isi[en]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.isi.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.isi.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Text (EN)'
            ></textarea>
            <template x-if='formErrors.isi.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.isi.en'></p>
              </div>
            </template>
            <template
              x-if='formTouched.isi.en && formValid.isi.en && !formErrors.isi.en'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JA -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JA</label>
            <textarea
              x-model='formData.isi.ja'
              @input='validateField("isi", $event.target.value, "ja")'
              name='isi[ja]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.isi.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.isi.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='テキスト (JA)'
            ></textarea>
            <template x-if='formErrors.isi.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.isi.ja'></p>
              </div>
            </template>
            <template
              x-if='formTouched.isi.ja && formValid.isi.ja && !formErrors.isi.ja'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Create
        </button>
        <a
          href='/misi'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>

    </form>
  </div>
</div>