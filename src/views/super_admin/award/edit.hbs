<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Award</h2>

    <form
      action='/award/{{award.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
    >
      <div>
        <label
          for='content'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Content</label>
        <textarea
          id='content'
          name='content'
          rows='4'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          placeholder='Enter content...'
          required
        >{{award.content}}</textarea>
      </div>

      <div>
        <label
          for='isi'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Isi</label>
        <textarea
          id='isi'
          name='isi'
          rows='6'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          placeholder='Enter isi...'
          required
        >{{award.isi}}</textarea>
      </div>

      <div class='flex gap-3'>
        <button
          type='submit'
          class='bg-gray-900 text-white px-6 py-2 rounded-lg shadow hover:bg-gray-600 transition'
        >Update</button>
        <a
          href='/award'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition'
        >Cancel</a>
      </div>
    </form>
  </div>
</div>