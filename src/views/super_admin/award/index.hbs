<div class="max-w-5xl mx-auto px-6 py-10" 
     x-data="awardTable({ awards: {{json awards}} })">
  <div class="mb-6 flex flex-col md:flex-row md:justify-between md:items-center gap-4">
    <h2 class="text-3xl font-bold text-gray-900 text-center md:text-left">Awards</h2>

    <div class="flex items-center gap-3">
      <div class="relative w-full md:w-64">
        <input 
          type="text" 
          placeholder="Search award..." 
          x-model="searchInput"
          @input="search = searchInput; pageNumber=0"
          class="border border-gray-300 bg-white text-gray-900 rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-gray-900 w-full"
        />
        <button 
          @click="search = searchInput; pageNumber=0"
          class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-900"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1110.5 3a7.5 7.5 0 016.15 13.65z"/>
          </svg>
        </button>
      </div>

      <a href="/award/formCreate" 
         class="bg-gray-900 text-white px-4 py-2 rounded-lg shadow hover:bg-gray-600 transition">
        Create Award
      </a>
    </div>
  </div>

<div class="overflow-x-auto bg-white shadow-lg rounded-xl">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-100">
      <tr>
        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">No</th>
        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Content</th>
        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Isi</th>
        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Action</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      {{#each awards}}
      <tr class="hover:bg-gray-50 transition"
          x-show="filteredAwards.includes('{{id}}')">
        <td class="px-6 py-4 text-sm text-gray-800">{{addOne @index}}</td>
        <td class="px-6 py-4 text-sm text-gray-800">{{content}}</td>
        <td class="px-6 py-4 text-sm text-gray-800">{{isi}}</td>
        <td class="px-6 py-4 text-sm text-gray-800">
          <a href="/award/{{id}}/edit" class="text-blue-600 hover:text-blue-900 mr-4">Edit</a>
          <form action="/award/{{id}}?_method=DELETE" method="post" class="inline">
            <button type="submit" class="text-red-600 hover:text-red-900" onclick="return confirm('Are you sure?')">Delete</button>
          </form>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<script>
function awardTable({ awards }) {
  return {
    awards,
    searchInput: '',
    search: '',
    pageNumber: 0,
    pageSize: 10,
    get filteredAwards() {
      if (!this.search) return this.awards.map(a => a.id);
      return this.awards
        .filter(a => a.content.toLowerCase().includes(this.search.toLowerCase()) || a.isi.toLowerCase().includes(this.search.toLowerCase()))
        .map(a => a.id);
    },
    get paginatedAwards() {
      const start = this.pageNumber * this.pageSize;
      return this.filteredAwards.slice(start, start + this.pageSize);
    }
  }
}
</script>