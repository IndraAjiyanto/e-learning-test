{{!--
  Halaman: Edit Course Benefit — Super Admin
  Lokasi: src/views/super_admin/course_benefits/edit.hbs
  Level: L4 Page

  Route: GET /benefit-program/formEdit/:programBenefitId ->
  PATCH /benefit-program/:programBenefitId/:courseId (urlencoded + _method override).
  Data: { program_benefit }.

  Sama seperti create.hbs, kolom Title dikirim sebagai `benefit[...]` dan kartu
  urutan disembunyikan. Nilai awal lewat helper json, bukan template literal:
  backtick atau ${ di data tidak lagi memecah skrip.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Benefit Class'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the benefit shown on this program detail page.'
      }}
    </div>

    <form
      action='/benefit-program/{{program_benefit.id}}/{{program_benefit.course.id}}?_method=PATCH'
      method='post'
      novalidate
      x-data='{ ...benefitForm({ withOrder: false, icon: {{json program_benefit.icon}}, title: {{json program_benefit.benefit}}, description: {{json program_benefit.description}} }), ...formDirtyGate() }'
      x-init='$nextTick(() => captureBaseline())'
      @input='recomputeDirty()'
      @change='recomputeDirty()'
      @submit.prevent='submitForm($event)'
      class='flex flex-col gap-3.5'
    >
      {{> components/ui/super_admin/form/benefit/fields
        hideOrder=true
        titleName='benefit'
      }}

      <div class='flex flex-col-reverse gap-3 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:flex-row sm:justify-end sm:p-5'>
        {{> components/ui/super_admin/form/button
          as='link'
          variant='secondary'
          href=(concat '/program/detail/program/admin/' program_benefit.course.id)
          label='Cancel'
          loading=true
        }}

        {{> components/ui/super_admin/form/button
          type='submit'
            disabled='!isDirty || loading'
          variant='primary'
          label='Save Changes'
          loading=true
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/benefit/form }}
