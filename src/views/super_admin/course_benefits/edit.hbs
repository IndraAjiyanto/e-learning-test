<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="benefitKelasEditData()"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Benefit Class</h2>

    <form
      action='/benefit-program/{{program_title.id}}/{{program_title.course.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      x-data="{ loading: false }"
      @submit.prevent="if (canSubmit()) { loading = true; $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

    {{> super_admin/course_benefits/edit/icon_input }}
    {{> super_admin/course_benefits/edit/tittle_input }}
{{> super_admin/course_benefits/edit/description_input }}

      <!-- Action Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='bg-gray-900 text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span x-show="loading" class="loading loading-spinner loading-sm"></span>
          <span x-show="!loading">Update</span>
        </button>
        <a
          href='/program/detail/program/admin/{{program_title.course.id}}'
            :disabled='loading'
        :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='bg-white px-6 py-2 rounded-lg border border-gray-300  transition'>
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>

<script>
  function benefitKelasEditData() {
    return {
      formData: {
        title: {
          id: `{{program_title.title.id}}`,
          en: `{{program_title.title.en}}`,
          ja: `{{program_title.title.ja}}`
        },
        description: {
          id: `{{program_title.description.id}}`,
          en: `{{program_title.description.en}}`,
          ja: `{{program_title.description.ja}}`
        },
        icon: `{{program_title.icon}}`
      },
      formErrors: {
        title: { id: '', en: '', ja: '' },
        description: { id: '', en: '', ja: '' },
        icon: ''
      },
      formValid: {
        title: { id: true, en: true, ja: true },
        description: { id: true, en: true, ja: true },
        icon: true
      },

      get computedClass() {
        const raw = (this.formData.icon || '').toString().trim();
        if (!raw) return 'fa-solid fa-circle-question';
        const v = raw;
        const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(v) || v.split(/\s+/).some(s => /^fa-/i.test(s));
        if (hasFaPrefix) {
          if (/^fa-\w+/i.test(v) && !/\s+/.test(v)) return 'fa-solid ' + v;
          return v;
        }
        if (!v.includes(' ')) return 'fa-solid fa-' + v;
        return v;
      },

      validateField(field, lang, value) {
        if (lang) {
          this.formData[field][lang] = value;
        } else {
          this.formData[field] = value;
        }

        switch(field) {
          case 'title':
            if (!value.trim()) {
              this.formErrors.title[lang] = 'Benefit title is required';
              this.formValid.title[lang] = false;
            } else if (value.trim().length < 3) {
              this.formErrors.title[lang] = 'Benefit title must be at least 3 characters';
              this.formValid.title[lang] = false;
            } else {
              this.formErrors.title[lang] = '';
              this.formValid.title[lang] = true;
            }
            break;

          case 'description':
            if (!value.trim()) {
              this.formErrors.description[lang] = 'Description is required';
              this.formValid.description[lang] = false;
            } else if (value.trim().length < 10) {
              this.formErrors.description[lang] = 'Description must be at least 10 characters';
              this.formValid.description[lang] = false;
            } else {
              this.formErrors.description[lang] = '';
              this.formValid.description[lang] = true;
            }
            break;

          case 'icon':
            if (!value.trim()) {
              this.formErrors.icon = 'Icon is required';
              this.formValid.icon = false;
            } else if (value.trim().length < 2) {
              this.formErrors.icon = 'Icon must be at least 2 characters';
              this.formValid.icon = false;
            } else {
              this.formErrors.icon = '';
              this.formValid.icon = true;
            }
            break;
        }
      },

      hasFormErrors() {
        return Object.values(this.formValid).some(v => typeof v === 'object' ? Object.values(v).some(val => !val) : !v);
      },

      canSubmit() {
        return !this.hasFormErrors();
      }
    }
  }
</script>
