{{!--
  Halaman: Create Course Benefit — Super Admin
  Lokasi: src/views/super_admin/course_benefits/create.hbs
  Level: L4 Page

  Route: GET /benefit-program/formCreate/:courseId -> POST /benefit-program/:courseId
  (urlencoded). Data: { courseId }.

  Field dikirim sebagai icon, benefit[id|en|ja], description[id|en|ja] — kolom
  Title di sini bernama `benefit` di backend, karena itu titleName di-override.
  Tidak ada kolom urutan, jadi kartu 03 disembunyikan (hideOrder + withOrder:false).
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Benefit Class'
      }}

      {{> components/ui/super_admin/description/index
        text='Add a new benefit that will be shown on this program detail page.'
      }}
    </div>

    <form
      action='/benefit-program/{{courseId}}'
      method='post'
      novalidate
      x-data='benefitForm({ withOrder: false })'
      @submit.prevent='submitForm($event)'
      class='flex flex-col gap-3.5'
    >
      {{> components/ui/super_admin/form/benefit/fields
        hideOrder=true
        titleName='benefit'
      }}

      <div class='flex flex-col-reverse gap-3 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:flex-row sm:justify-end sm:p-5'>
        {{> components/ui/super_admin/form/button
          as='link'
          variant='secondary'
          href=(concat '/program/detail/program/admin/' courseId)
          label='Cancel'
          loading=true
        }}

        {{> components/ui/super_admin/form/button
          type='submit'
          disabled='!canSubmit() || loading'
          variant='primary'
          label='Create Benefit'
          loading=true
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/benefit/form }}
