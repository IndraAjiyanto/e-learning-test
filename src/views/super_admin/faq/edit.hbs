{{!--
  Halaman: Edit FAQ — Super Admin
  Lokasi: src/views/super_admin/faq/edit.hbs
  Level: L4 Page

  Route: GET /faq/formEdit/:faqId -> PATCH /faq/:faqId
  (urlencoded + _method override, sesuai UpdateFaqDto).

  Beda dari create.hbs: field terisi nilai existing, tombol submit
  "Save Changes", dan ada kartu Danger Zone berisi aksi hapus FAQ.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-2.5'>
    <div class='flex flex-col gap-7'>

      <div class='flex flex-col gap-1'>
        {{> components/ui/super_admin/page_header/index
          title='Edit FAQ'
        }}

        {{> components/ui/super_admin/description/index
          text='Update the question and answer for this FAQ entry.'
        }}
      </div>

      <form
        action='/faq/{{faq.id}}?_method=PATCH'
        method='post'
        novalidate
        {{!-- kolom jsonb nullable; faqForm menormalkan null jadi { id, en, ja } kosong --}}
        x-data='faqForm({ question: {{json faq.question}}, answer: {{json faq.answer}} })'
        @submit.prevent='submitForm($event)'
        class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
      >
        <div class='flex flex-col gap-5'>
          {{> components/ui/super_admin/tabs/language/index ariaLabel='FAQ language' }}

          {{> components/ui/super_admin/form/faq_fields }}

          <div class='flex flex-col-reverse gap-3 pt-6 sm:flex-row sm:justify-end'>
            {{> components/ui/super_admin/form/button
              as='link'
              variant='secondary'
              href='/faq'
              label='Cancel'
              loading=true
            }}

            {{> components/ui/super_admin/form/button
              type='submit'
              variant='primary'
              label='Save Changes'
              loading=true
            }}
          </div>
        </div>
      </form>
    </div>

    {{!-- Tombol hapus memakai openDeleteModal dari modal/delete_confirm, bukan
         confirmDelete milik partial sweetalert global yang menimpa fungsi senama. --}}
    <div
      class='flex flex-col gap-4 rounded-2xl border border-[#d9d9d9] bg-white px-4 py-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:flex-row sm:items-end sm:justify-between sm:gap-11 sm:px-[31px] sm:py-[19px]'
    >
      <div class='flex items-start gap-4 sm:min-h-[72px]'>
        <span
          class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-8 border-[#fef2f2] bg-[#fee2e2]'
        >
          {{!-- lucide: alert-circle --}}
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#dc2626' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='h-5 w-5'>
            <circle cx='12' cy='12' r='10' />
            <path d='M12 8v4' />
            <path d='M12 16h.01' />
          </svg>
        </span>

        <div class='flex flex-col gap-1'>
          {{> components/ui/super_admin/description/index
            text='Delete FAQ'
            class='font-montserrat text-base font-semibold leading-5 text-[#003060]'
          }}

          {{> components/ui/super_admin/description/index
            text='Permanently remove this FAQ from Kesatria Academy. This action cannot be undone.'
            class='font-montserrat text-sm font-medium leading-5 text-[#718096]'
          }}
        </div>
      </div>

      <form
        action='/faq/{{faq.id}}?_method=DELETE'
        method='post'
        class='shrink-0'
      >
        {{> components/ui/super_admin/form/button
          variant='danger'
          label='Delete FAQ'
          onclick='openDeleteModal(this)'
          class='w-full sm:w-auto'
        }}
      </form>
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete FAQ?'
  description='Are you sure you want to delete this FAQ? This action will permanently remove the question and answer in all languages and cannot be undone.'
}}

{{> components/ui/super_admin/form/faq_form }}
