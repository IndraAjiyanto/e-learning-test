<div class='py-10'>
  <div
    class='max-w-4xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        // Form validation states
        formData: {
          question: { id: '{{faq.question.id}}', en: '{{faq.question.en}}', ja: '{{faq.question.ja}}' },
          answer: { id: '{{faq.answer.id}}', en: '{{faq.answer.en}}', ja: '{{faq.answer.ja}}' }
        },
        formErrors: {
          question: { id: '', en: '', ja: '' },
          answer: { id: '', en: '', ja: '' }
        },
        formValid: {
          question: { id: true, en: true, ja: true },
          answer: { id: true, en: true, ja: true }
        },

        validateField(field, lang, value) {
          this.formData[field][lang] = value;
          
          switch(field) {
            case 'question':
              if (!value.trim()) {
                this.formErrors.question[lang] = 'Question is required';
                this.formValid.question[lang] = false;
              } else if (value.trim().length < 10) {
                this.formErrors.question[lang] = 'Question must be at least 10 characters';
                this.formValid.question[lang] = false;
              } else {
                this.formErrors.question[lang] = '';
                this.formValid.question[lang] = true;
              }
              break;
              
            case 'answer':
              if (!value.trim()) {
                this.formErrors.answer[lang] = 'Answer is required';
                this.formValid.answer[lang] = false;
              } else if (value.trim().length < 20) {
                this.formErrors.answer[lang] = 'Answer must be at least 20 characters';
                this.formValid.answer[lang] = false;
              } else {
                this.formErrors.answer[lang] = '';
                this.formValid.answer[lang] = true;
              }
              break;
          }
        },

        canSubmit() {
          const questionValid = Object.values(this.formValid.question).every(v => v);
          const answerValid = Object.values(this.formValid.answer).every(v => v);
          return questionValid && answerValid;
        },

        hasFormErrors() {
          return Object.values(this.formErrors.question).some(e => e !== '') || Object.values(this.formErrors.answer).some(e => e !== '');
        }
      }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit FAQ</h2>

    <form
      action='/faq/{{faq.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      @submit.prevent="if (canSubmit()) { $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

      <!-- Question per Bahasa -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Question</label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.question.id'
              @input='validateField("question", "id", $event.target.value)'
              name='question[id]'
              required
              rows='4'
              :class="formErrors.question.id ? 'border-red-500 focus:ring-red-500' : (formValid.question.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Pertanyaan (ID)...'
              x-init='$el.value = formData.question.id'
            ></textarea>
            <template x-if='formErrors.question.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.question.id'
                ></p>
              </div>
            </template>
            <template x-if='formValid.question.id && !formErrors.question.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.question.en'
              @input='validateField("question", "en", $event.target.value)'
              name='question[en]'
              required
              rows='4'
              :class="formErrors.question.en ? 'border-red-500 focus:ring-red-500' : (formValid.question.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Question (EN)...'
              x-init='$el.value = formData.question.en'
            ></textarea>
            <template x-if='formErrors.question.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.question.en'
                ></p>
              </div>
            </template>
            <template x-if='formValid.question.en && !formErrors.question.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.question.ja'
              @input='validateField("question", "ja", $event.target.value)'
              name='question[ja]'
              required
              rows='4'
              :class="formErrors.question.ja ? 'border-red-500 focus:ring-red-500' : (formValid.question.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='質問 (JA)...'
              x-init='$el.value = formData.question.ja'
            ></textarea>
            <template x-if='formErrors.question.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.question.ja'
                ></p>
              </div>
            </template>
            <template x-if='formValid.question.ja && !formErrors.question.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Answer per Bahasa -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Answer</label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.answer.id'
              @input='validateField("answer", "id", $event.target.value)'
              name='answer[id]'
              required
              rows='6'
              :class="formErrors.answer.id ? 'border-red-500 focus:ring-red-500' : (formValid.answer.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Jawaban (ID)...'
              x-init='$el.value = formData.answer.id'
            ></textarea>
            <template x-if='formErrors.answer.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.answer.id'
                ></p>
              </div>
            </template>
            <template x-if='formValid.answer.id && !formErrors.answer.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.answer.en'
              @input='validateField("answer", "en", $event.target.value)'
              name='answer[en]'
              required
              rows='6'
              :class="formErrors.answer.en ? 'border-red-500 focus:ring-red-500' : (formValid.answer.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Answer (EN)...'
              x-init='$el.value = formData.answer.en'
            ></textarea>
            <template x-if='formErrors.answer.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.answer.en'
                ></p>
              </div>
            </template>
            <template x-if='formValid.answer.en && !formErrors.answer.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.answer.ja'
              @input='validateField("answer", "ja", $event.target.value)'
              name='answer[ja]'
              required
              rows='6'
              :class="formErrors.answer.ja ? 'border-red-500 focus:ring-red-500' : (formValid.answer.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='回答 (JA)...'
              x-init='$el.value = formData.answer.ja'
            ></textarea>
            <template x-if='formErrors.answer.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.answer.ja'
                ></p>
              </div>
            </template>
            <template x-if='formValid.answer.ja && !formErrors.answer.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Tombol aksi -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="canSubmit() ? 'bg-gray-900 hover:bg-gray-700' : 'bg-gray-400 cursor-not-allowed'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Update
        </button>
        <a
          href='/faq'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>