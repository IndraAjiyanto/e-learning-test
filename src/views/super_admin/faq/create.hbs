{{!--
  Halaman: Create FAQ — Super Admin
  Lokasi: src/views/super_admin/faq/create.hbs
  Level: L4 Page

  Route: GET /faq/formCreate -> POST /faq (urlencoded, CreateFaqDto).

  Field dikirim sebagai question[id]/question[en]/question[ja] (idem answer)
  supaya express urlencoded extended merakitnya jadi objek — bentuk yang sama
  dengan kolom jsonb entity, jadi DTO & service tidak perlu diubah.

  Toast sukses tidak dirender di sini: submit redirect ke /faq, jadi
  notifikasinya muncul di index.hbs lewat flash `toast`.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create FAQ'
      }}

      {{> components/ui/super_admin/description/index
        text='Create a new frequently asked question and answer for Kesatria Academy.'
      }}
    </div>

    <form
      action='/faq'
      method='post'
      novalidate
      x-data='faqForm()'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
    >
      <div class='flex flex-col gap-5'>
        {{> components/ui/super_admin/tabs/language/index ariaLabel='FAQ language' }}

        {{> components/ui/super_admin/form/faq_fields }}

        <div class='flex flex-col-reverse gap-3 pt-6 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href='/faq'
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Create FAQ'
            loading=true
          }}
        </div>
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/faq_form }}
