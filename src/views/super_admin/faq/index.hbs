{{!--
  Halaman: FAQ — Super Admin
  Lokasi: src/views/super_admin/faq/index.hbs
  Level: L4 Page

  Data: GET /faq → { faq }, question & answer berbentuk jsonb { id, en, ja }.
  Search & pagination dijalankan di client lewat clientTable().

  Tab bahasa hanya menukar bahasa yang ditampilkan kolom Question & Answer —
  tidak memfilter baris dan tidak pindah rute. Karena itu `lang` hidup di scope
  Alpine bersarang di dalam clientTable(): getter `rows` dan `totalPages` akan
  hilang bila kedua state digabung lewat object spread.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='FAQs'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage frequently asked questions and answers for Kesatria Academy.'
      }}
    </div>

    <div
      class='flex flex-col gap-3.5'
      x-data='clientTable({ items: {{json faq}}, searchKeys: ["question.id", "question.en", "question.ja", "answer.id", "answer.en", "answer.ja"] })'
    >
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search FAQ..'
        searchLabel='Search FAQ'
        createHref='/faq/formCreate'
        createLabel='Create FAQ'
      }}

      <div
        class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
        x-data="{ lang: 'id' }"
      >
        <div class='flex flex-col gap-5'>

          {{> components/ui/super_admin/tabs/language/index ariaLabel='FAQ language' }}

          {{#> components/ui/super_admin/table/card tableClass='min-w-[1010px]'}}
            <colgroup>
              <col class='w-[66px]' />
              <col class='w-[382px]' />
              <col class='w-[426px]' />
              <col class='w-[136px]' />
            </colgroup>
            <thead>
              <tr>
                {{> components/ui/super_admin/table/header_cell label='No' }}
                {{> components/ui/super_admin/table/header_cell label='Question' }}
                {{> components/ui/super_admin/table/header_cell label='Answer' }}
                {{> components/ui/super_admin/table/header_cell label='Action' }}
              </tr>
            </thead>
            <tbody>
              <template x-for='(row, index) in rows' :key='row.id'>
                <tr class='transition-colors hover:bg-[#fafafa]'>

                  {{> components/ui/super_admin/table/cell
                    text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
                  }}

                  {{!-- teks panjang dipotong 2 baris agar tinggi baris tetap konsisten --}}
                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='line-clamp-2 font-inter text-sm leading-5 text-[#171717]'
                      x-text="(row.question && row.question[lang]) || '—'"
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='line-clamp-2 font-inter text-sm leading-5 text-[#525252]'
                      x-text="(row.answer && row.answer[lang]) || '—'"
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell variant='action'}}
                    {{> components/ui/super_admin/table/row_actions
                      entity='FAQ'
                      deleteAction="'/faq/' + row.id + '?_method=DELETE'"
                      editHref="'/faq/formEdit/' + row.id"
                    }}
                  {{/components/ui/super_admin/table/cell}}
                </tr>
              </template>

              {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='4'}}
                No FAQs found.
              {{/components/ui/super_admin/table/message_row}}
            </tbody>
          {{/components/ui/super_admin/table/card}}
        </div>
      </div>
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete FAQ?'
  description='Are you sure you want to delete this FAQ? This action will permanently remove the question and answer in all languages and cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}
