{{!--
  Halaman: Create Experience — Super Admin
  Lokasi: src/views/super_admin/experience/create.hbs
  Level: L4 Page

  Route: GET /experience/formCreate -> POST /experience
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Experience'
      }}

      {{> components/ui/super_admin/description/index
        text='Add a new professional experience or career milestone.'
      }}
    </div>

    <form
      action='/experience'
      method='post'
      novalidate
      x-data='experienceForm()'
      @submit.prevent='submitForm($event)'
    >
      {{#> components/ui/super_admin/form/experience/fields }}
        <div class='flex flex-col-reverse gap-3 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href='/experience'
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Create Experience'
            loading=true
            disabled='!canSubmit() || loading'
          }}
        </div>
      {{/components/ui/super_admin/form/experience/fields}}
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/experience/form }}