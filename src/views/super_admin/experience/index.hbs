{{!--
  Halaman: Pengelolaan Experience — Super Admin
  Lokasi: src/views/super_admin/experience/index.hbs
  Level: L4 Page

  - Shell kartu + pagination dari table/card
  - Header kolom dari table/header_cell
  - Tombol aksi dari table/row_actions terintegrasi dengan modal delete_confirm
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Experience'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage professional experience and career milestones displayed across Kesatria Academy.'
      }}
    </div>

    <div
      class='flex flex-col gap-3.5'
      x-data='clientTable({ items: {{json experience}}, searchKeys: ["content.id", "content.en", "content.ja", "details.id", "details.en", "details.ja"] })'
    >
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search experience...'
        searchLabel='Search experience'
        createHref='/experience/formCreate'
        createLabel='Create Experience'
      }}

      <!-- Table Card -->
      {{#> components/ui/super_admin/table/card tableClass='min-w-[1010px]'}}
        <colgroup>
          <col class='w-[80px]' />
          <col class='w-[450px]' />
          <col class='w-[450px]' />
          <col class='w-[116px]' />
        </colgroup>
        <thead>
          <tr>
            {{> components/ui/super_admin/table/header_cell label='No' }}
            {{> components/ui/super_admin/table/header_cell label='Content' }}
            {{> components/ui/super_admin/table/header_cell label='Text' }}
            {{> components/ui/super_admin/table/header_cell label='Action' }}
          </tr>
        </thead>
        <tbody>
          <template x-for='(row, index) in rows' :key='row.id'>
            <tr class='transition-colors hover:bg-[#fafafa]'>
              {{> components/ui/super_admin/table/cell
                text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
              }}

              {{#> components/ui/super_admin/table/cell}}
                <div class='flex flex-col gap-1'>
                  <template x-for='(item, idx) in (Array.isArray(row.content) ? row.content : Object.values(row.content || {}))' :key='idx'>
                    <div class='line-clamp-3 font-inter text-sm leading-5 text-[#525252]' x-text='item'></div>
                  </template>
                </div>
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell}}
                <div class='flex flex-col gap-1'>
                  <template x-for='(item, idx) in (Array.isArray(row.details) ? row.details : Object.values(row.details || {}))' :key='idx'>
                    <div class='line-clamp-3 font-inter text-sm leading-5 text-[#525252]' x-text='item'></div>
                  </template>
                </div>
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell variant='action'}}
                {{> components/ui/super_admin/table/row_actions
                  entity='experience'
                  deleteAction="'/experience/' + row.id + '?_method=DELETE'"
                  editHref="'/experience/formEdit/' + row.id"
                }}
              {{/components/ui/super_admin/table/cell}}
            </tr>
          </template>

          {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='4'}}
            No experiences found.
          {{/components/ui/super_admin/table/message_row}}
        </tbody>
      {{/components/ui/super_admin/table/card}}
    </div>
  </div>
</div>

{{!-- Modal konfirmasi delete --}}
{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Experience?'
  description='Are you sure you want to delete this experience? This action will permanently remove it and cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}
