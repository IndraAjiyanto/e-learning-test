{{!--
  Halaman: Create FAQ Program — Super Admin
  Lokasi: src/views/super_admin/course_questions/create.hbs
  Level: L4 Page

  Route: GET /question-program/formCreate/:courseId
         -> POST /question-program/:courseId (urlencoded, CreateCourseQuestionDto).

  Field & validasinya sama dengan FAQ umum, jadi memakai ulang form/faq;
  bedanya hanya action, tujuan Cancel, dan `questionName` (DTO di sini
  menerima `questions`, bukan `question`).
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create FAQ Program'
      }}

      {{> components/ui/super_admin/description/index
        text='Add a new frequently asked question and answer for this program.'
      }}
    </div>

    <form
      action='/question-program/{{courseId}}'
      method='post'
      novalidate
      x-data='faqForm()'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
    >
      <div class='flex flex-col gap-5'>
        {{> components/ui/super_admin/tabs/language/index ariaLabel='FAQ language' }}

        {{> components/ui/super_admin/form/faq/fields
          questionName='questions'
          questionMax=500
          answerMax=2000
        }}

        <div class='flex flex-col-reverse gap-3 pt-6 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href=(concat '/program/detail/program/admin/' courseId)
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Create FAQ'
            loading=true
          }}
        </div>
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/faq/form }}
