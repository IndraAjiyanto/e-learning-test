{{!--
  Halaman: Edit FAQ Program — Super Admin
  Lokasi: src/views/super_admin/course_questions/edit.hbs
  Level: L4 Page

  Route: GET /question-program/formEdit/:id
         -> PATCH /question-program/:id/:courseId
         (urlencoded + _method override, sesuai UpdateCourseQuestionDto).

  Beda dari create.hbs: field terisi nilai existing dan tombol submit
  "Save Changes".

  Entity memakai `questions`/`answers`, sedangkan DTO menerima
  `questions`/`answer` — prefill di bawah membaca entity, `name` field dikirim
  form/faq/fields. Keduanya benar di tempatnya masing-masing.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit FAQ Program'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the question and answer for this program FAQ.'
      }}
    </div>

    <form
      action='/question-program/{{courseQuestion.id}}/{{courseQuestion.course.id}}?_method=PATCH'
      method='post'
      novalidate
      x-data='{ ...faqForm({ question: {{json courseQuestion.questions}}, answer: {{json courseQuestion.answers}} }), ...formDirtyGate() }'
      x-init='$nextTick(() => captureBaseline())'
      @input='recomputeDirty()'
      @change='recomputeDirty()'
      @submit.prevent='submitForm($event)'
      class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
    >
      <div class='flex flex-col gap-5'>
        {{> components/ui/super_admin/tabs/language/index ariaLabel='FAQ language' }}

        {{> components/ui/super_admin/form/faq/fields
          questionName='questions'
          questionMax=500
          answerMax=2000
        }}

        <div class='flex flex-col-reverse gap-3 pt-6 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href=(concat '/program/detail/program/admin/' courseQuestion.course.id)
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            disabled='!canSubmit() || !isDirty || loading'
            variant='primary'
            label='Save Changes'
            loading=true
          }}
        </div>
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/faq/form }}
