<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{ 
    previewUrl: '{{tentang.gambar}}',
    oldImage: '{{tentang.gambar}}',
    errorMessage: '',
    isValid: true,
    fileName: '',
    fileSize: 0,
    imageWidth: 0,
    imageHeight: 0,
    hasFile: false,
    hasNewFile: false,
    validateImage(file) {
      if (!file) {
        this.hasNewFile = false;
        return;
      }
      
      this.hasNewFile = true;
      this.hasFile = true;
      this.fileName = file.name;
      this.fileSize = file.size;
      this.errorMessage = '';
      this.isValid = true;

      // Validasi tipe file
      const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
      if (!allowedTypes.includes(file.type)) {
        this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
        this.isValid = false;
        this.previewUrl = '{{tentang.gambar}}';
        return;
      }

      // Validasi ukuran file (5MB)
      const maxSize = 5 * 1024 * 1024; // 5MB
      if (file.size > maxSize) {
        this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
        this.isValid = false;
        this.previewUrl = '{{tentang.gambar}}';
        return;
      }

      // Validasi dimensi gambar
      const img = new Image();
      const objectUrl = URL.createObjectURL(file);
      
      img.onload = () => {
        this.imageWidth = img.width;
        this.imageHeight = img.height;
        
        if (img.width < 700 || img.width > 4000 || img.height < 700 || img.height > 4000) {
          this.errorMessage = `Image dimensions ${img.width}x${img.height}px. Required: Width 700-4000px, Height 700-4000px`;
          this.isValid = false;
          this.previewUrl = '{{tentang.gambar}}';
          URL.revokeObjectURL(objectUrl);
        } else {
          this.previewUrl = objectUrl;
          this.isValid = true;
          this.errorMessage = '';
        }
      };
      
      img.onerror = () => {
        this.errorMessage = 'Failed to load image';
        this.isValid = false;
        this.previewUrl = '{{tentang.gambar}}';
        URL.revokeObjectURL(objectUrl);
      };
      
      img.src = objectUrl;
    },
    clearFile() {
      this.previewUrl = '{{tentang.gambar}}';
      this.errorMessage = '';
      this.isValid = true;
      this.fileName = '';
      this.fileSize = 0;
      this.imageWidth = 0;
      this.imageHeight = 0;
      this.hasFile = false;
      this.hasNewFile = false;
      $refs.fileInput.value = null;
    },
    canSubmit() {
      // Jika ada file baru yang diupload, harus valid
      if (this.hasNewFile) {
        return this.isValid;
      }
      // Jika tidak ada file baru, tetap bisa submit (gunakan gambar lama)
      return true;
    }
  }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900 text-center'>Edit
      Tentang</h2>

    <form
      action='/tentang/{{tentang.id}}?_method=PATCH'
      method='post'
      enctype='multipart/form-data'
      class='space-y-6'
      @submit.prevent="if(canSubmit()) { $el.submit(); } else { alert('Please fix the image validation errors before submitting.'); }"
    >

      <!-- Input Judul -->
      <div>
        <label
          for='judul'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Title
          <span class='text-red-500'>*</span>
        </label>
        <input
          type='text'
          id='judul'
          name='judul'
          value='{{tentang.judul}}'
          required
          maxlength='255'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          placeholder='Enter title'
        />
      </div>

      <!-- Input Text -->
      <div>
        <label
          for='text'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Description
          <span class='text-red-500'>*</span>
        </label>
        <textarea
          id='text'
          name='text'
          rows='5'
          required
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          placeholder='Enter description'
        >{{tentang.text}}</textarea>
      </div>

      <!-- Upload Gambar -->
      <div class='space-y-3'>
        <label
          for='gambar'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Replace Image (optional)
          <span class='text-xs text-gray-500 font-normal'>(Width: 700-4000px,
            Height: 700-4000px, max 5MB, JPG/PNG)</span>
        </label>

        <input
          type='file'
          id='gambar'
          name='gambar'
          accept='image/jpeg,image/jpg,image/png'
          x-ref='fileInput'
          :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          @change='validateImage($event.target.files[0])'
        />

        <!-- Error Message -->
        <template x-if='!isValid && errorMessage'>
          <div
            class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <div>
              <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
              <p class='text-xs text-red-700' x-text='errorMessage'></p>
            </div>
          </div>
        </template>

        <!-- Preview Baru with validation success -->
        <template x-if='previewUrl && isValid && hasNewFile'>
          <div class='space-y-2'>
            <!-- Success Message -->
            <div
              class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500'></i>
              <div class='text-xs text-green-700'>
                <span class='font-semibold'>Valid image:</span>
                <span
                  x-text='`${imageWidth}x${imageHeight}px, ${(fileSize / 1024).toFixed(1)}KB`'
                ></span>
              </div>
            </div>

            <!-- Image Preview -->
            <div class='relative w-full max-w-md'>
              <img
                :src='previewUrl'
                alt='New Image Preview'
                class='w-full h-auto object-contain rounded-lg border-2 border-green-500 shadow-sm'
              />

              <button
                type='button'
                class='absolute top-2 right-2 bg-red-500 text-white w-8 h-8 rounded-full flex items-center justify-center shadow-lg hover:bg-red-600 transition-colors'
                @click='clearFile()'
              >
                <svg
                  class='w-5 h-5'
                  fill='none'
                  stroke='currentColor'
                  viewBox='0 0 24 24'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M6 18L18 6M6 6l12 12'
                  />
                </svg>
              </button>
            </div>
          </div>
        </template>

        <!-- Preview Lama -->
        <template x-if='!hasNewFile && oldImage'>
          <div class='space-y-2'>
            <p class='text-xs text-gray-500 font-medium'>Current Image:</p>
            <div class='relative w-full max-w-md'>
              <img
                :src='oldImage'
                alt='Current Image'
                class='w-full h-auto object-contain rounded-lg border border-gray-300 shadow-sm'
              />
            </div>
          </div>
        </template>
      </div>

      <!-- Tombol aksi -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-600'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <i class='fas fa-save'></i>
          Save Changes
        </button>
        <a
          href='/tentang'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          <i class='fas fa-times'></i>
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasNewFile && !isValid'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix the image validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>