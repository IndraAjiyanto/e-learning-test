<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        previewUrl: null,
        errorMessage: '',
        isValid: true,
        fileName: '',
        fileSize: 0,
        imageWidth: 0,
        imageHeight: 0,
        hasFile: false,

        // Form validation states
        formData: {
          judul: { id: '', en: '', ja: '' },
          text: { id: '', en: '', ja: '' }
        },
        formErrors: {
          judul: { id: '', en: '', ja: '' },
          text: { id: '', en: '', ja: '' }
        },
        formValid: {
          judul: { id: false, en: false, ja: false },
          text: { id: false, en: false, ja: false }
        },

        validateImage(file) {
          if (!file) {
            this.hasFile = false;
            return;
          }

          this.hasFile = true;
          this.fileName = file.name;
          this.fileSize = file.size;
          this.errorMessage = '';
          this.isValid = true;

          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!allowedTypes.includes(file.type)) {
            this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
            this.isValid = false;
            this.previewUrl = null;
            return;
          }

          const maxSize = 5 * 1024 * 1024; // 5MB
          if (file.size > maxSize) {
            this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
            this.isValid = false;
            this.previewUrl = null;
            return;
          }

          // Create preview with dimension validation
          const img = new Image();
          const objectUrl = URL.createObjectURL(file);

          img.onload = () => {
            this.imageWidth = img.width;
            this.imageHeight = img.height;

            // Check dimensions
            const minDim = 700;
            const maxDim = 4000;
            if (this.imageWidth < minDim || this.imageWidth > maxDim || this.imageHeight < minDim || this.imageHeight > maxDim) {
              this.errorMessage = `Image dimensions must be between ${minDim}-${maxDim}px for both width and height. Current: ${this.imageWidth}x${this.imageHeight}px`;
              this.isValid = false;
              this.previewUrl = null;
              URL.revokeObjectURL(objectUrl);
              return;
            }

            this.previewUrl = objectUrl;
            this.isValid = true;
            this.errorMessage = '';
          };

          img.onerror = () => {
            this.errorMessage = 'Failed to load image';
            this.isValid = false;
            this.previewUrl = null;
            URL.revokeObjectURL(objectUrl);
          };

          img.src = objectUrl;
        },

        validateField(field, lang, value) {
          this.formData[field][lang] = value;
          
          if (field === 'judul') {
            if (!value.trim()) {
              this.formErrors.judul[lang] = 'Title is required';
              this.formValid.judul[lang] = false;
            } else if (value.trim().length < 2) {
              this.formErrors.judul[lang] = 'Title must be at least 2 characters';
              this.formValid.judul[lang] = false;
            } else {
              this.formErrors.judul[lang] = '';
              this.formValid.judul[lang] = true;
            }
          } else if (field === 'text') {
            if (!value.trim()) {
              this.formErrors.text[lang] = 'Text is required';
              this.formValid.text[lang] = false;
            } else if (value.trim().length < 10) {
              this.formErrors.text[lang] = 'Text must be at least 10 characters';
              this.formValid.text[lang] = false;
            } else {
              this.formErrors.text[lang] = '';
              this.formValid.text[lang] = true;
            }
          }
        },

        clearFile() {
          this.previewUrl = null;
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '';
          this.fileSize = 0;
          this.imageWidth = 0;
          this.imageHeight = 0;
          this.hasFile = false;
          this.$refs.fileInput.value = null;
        },

        canSubmit() {
          const imageValid = !this.hasFile || this.isValid;
          const judulValid = this.formValid.judul.id && this.formValid.judul.en && this.formValid.judul.ja;
          const textValid = this.formValid.text.id && this.formValid.text.en && this.formValid.text.ja;
          return imageValid && judulValid && textValid;
        },

        hasFormErrors() {
          return Object.values(this.formErrors.judul).some(error => error !== '') || 
                 Object.values(this.formErrors.text).some(error => error !== '');
        }
      }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create New Header</h2>

    <form
      action='/tentang'
      method='post'
      enctype='multipart/form-data'
      class='space-y-6'
    >

      <!-- Upload Image -->
      <div class='space-y-3'>
        <label
          for='gambar'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Image
          <span class='text-xs text-gray-500 font-normal'>(Width: 700-4000px,
            Height: 700-4000px, max 5MB, JPG/PNG)</span>
        </label>

        <input
          type='file'
          id='gambar'
          name='gambar'
          accept='image/jpeg,image/jpg,image/png'
          required
          x-ref='fileInput'
          :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-900 file:text-white hover:file:bg-gray-700 file:cursor-pointer'
          @change='validateImage($event.target.files[0])'
        />

        <!-- Error Message -->
        <template x-if='!isValid && errorMessage'>
          <div
            class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <div>
              <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
              <p class='text-xs text-red-700' x-text='errorMessage'></p>
            </div>
          </div>
        </template>

        <!-- Success Message with File Info -->
        <template x-if='hasFile && isValid'>
          <div class='space-y-2'>
            <div
              class='flex items-center justify-between p-3 bg-green-50 border border-green-300 rounded-lg'
            >
              <div class='flex items-center gap-2'>
                <i class='fas fa-check-circle text-green-500'></i>
                <div class='text-xs text-green-700'>
                  <span class='font-semibold'>Valid image:</span>
                  <span
                    x-text='`${fileName} (${(fileSize / 1024 / 1024).toFixed(2)}MB)`'
                  ></span>
                </div>
              </div>
              <button
                type='button'
                class='text-red-500 hover:text-red-700 transition-colors'
                @click='clearFile()'
                title='Remove image'
              >
                <i class='fas fa-times-circle'></i>
              </button>
            </div>
          </div>
        </template>

        <!-- Preview -->
        <template x-if='previewUrl'>
          <div class='relative w-32 h-32'>
            <img
              :src='previewUrl'
              alt='Preview Image'
              class='w-32 h-32 object-cover rounded-lg border border-gray-300'
            />
            <button
              type='button'
              class='absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center shadow hover:bg-red-600'
              @click='clearFile()'
            >
              &times;
            </button>
          </div>
        </template>
      </div>
      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
        <!-- Judul -->
        <div class='space-y-2'>

          <label
            for='judul'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >
            Title
          </label>

          <div class='flex flex-col gap-3'>
            <!-- Indonesia -->
            <div class='space-y-1'>
              <label class='block text-xs font-medium text-gray-600'>ID</label>
              <input
                type='text'
                x-model='formData.judul.id'
                name='judul[id]'
                placeholder='Judul'
                required
                :class="formErrors.judul.id ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                @input='validateField("judul", "id", $event.target.value)'
              />
              <template x-if='formErrors.judul.id'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.judul.id'
                  ></p>
                </div>
              </template>
              <template x-if='formValid.judul.id && !formErrors.judul.id'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid title (ID)</p>
                </div>
              </template>
            </div>

            <!-- English -->
            <div class='space-y-1'>
              <label class='block text-xs font-medium text-gray-600'>EN</label>
              <input
                type='text'
                x-model='formData.judul.en'
                name='judul[en]'
                placeholder='Title'
                required
                :class="formErrors.judul.en ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                @input='validateField("judul", "en", $event.target.value)'
              />
              <template x-if='formErrors.judul.en'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.judul.en'
                  ></p>
                </div>
              </template>
              <template x-if='formValid.judul.en && !formErrors.judul.en'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid title (EN)</p>
                </div>
              </template>
            </div>

            <!-- Japanese -->
            <div class='space-y-1'>
              <label class='block text-xs font-medium text-gray-600'>JP</label>
              <input
                type='text'
                x-model='formData.judul.ja'
                name='judul[ja]'
                placeholder='タイトル'
                required
                :class="formErrors.judul.ja ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                @input='validateField("judul", "ja", $event.target.value)'
              />
              <template x-if='formErrors.judul.ja'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.judul.ja'
                  ></p>
                </div>
              </template>
              <template x-if='formValid.judul.ja && !formErrors.judul.ja'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid title (JA)</p>
                </div>
              </template>
            </div>
          </div>

        </div>

        <!-- Empty column for spacing -->
        <div></div>
      </div>

      <!-- Text (Full Width) -->
      <div class='space-y-2'>
        <label
          for='text'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Text
        </label>

        <div class='space-y-3'>
          <!-- Indonesia -->
          <div class='space-y-1'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.text.id'
              name='text[id]'
              placeholder='Teks'
              required
              rows='4'
              :class="formErrors.text.id ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              @input='validateField("text", "id", $event.target.value)'
            ></textarea>
            <template x-if='formErrors.text.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.text.id'></p>
              </div>
            </template>
            <template x-if='formValid.text.id && !formErrors.text.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid text (ID)</p>
              </div>
            </template>
          </div>

          <!-- English -->
          <div class='space-y-1'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.text.en'
              name='text[en]'
              placeholder='Text'
              required
              rows='4'
              :class="formErrors.text.en ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              @input='validateField("text", "en", $event.target.value)'
            ></textarea>
            <template x-if='formErrors.text.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.text.en'></p>
              </div>
            </template>
            <template x-if='formValid.text.en && !formErrors.text.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid text (EN)</p>
              </div>
            </template>
          </div>

          <!-- Japanese -->
          <div class='space-y-1'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.text.ja'
              name='text[ja]'
              placeholder='テキスト'
              required
              rows='4'
              :class="formErrors.text.ja ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              @input='validateField("text", "ja", $event.target.value)'
            ></textarea>
            <template x-if='formErrors.text.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.text.ja'></p>
              </div>
            </template>
            <template x-if='formValid.text.ja && !formErrors.text.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid text (JA)</p>
              </div>
            </template>
          </div>
        </div>

      </div>

      <!-- Tombol aksi -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="!canSubmit() ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          Create
        </button>
        <a
          href='/tentang'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition flex items-center gap-2'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors() || (hasFile && !isValid)'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>