<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
    // Form validation states
    formData: {
      pertanyaan: { id: '', en: '', ja: '' },
      jawaban: { id: '', en: '', ja: '' }
    },
    formErrors: {
      pertanyaan: { id: '', en: '', ja: '' },
      jawaban: { id: '', en: '', ja: '' }
    },
    formValid: {
      pertanyaan: { id: false, en: false, ja: false },
      jawaban: { id: false, en: false, ja: false }
    },
    formTouched: {
      pertanyaan: { id: false, en: false, ja: false },
      jawaban: { id: false, en: false, ja: false }
    },

    validateField(field, value, lang = null) {
      if (lang) {
        this.formData[field][lang] = value;
        this.formTouched[field][lang] = true;
      } else {
        this.formData[field] = value;
        this.formTouched[field] = true;
      }
      
      switch(field) {
        case 'pertanyaan':
          if (!value.trim()) {
            this.formErrors.pertanyaan[lang] = 'Question is required';
            this.formValid.pertanyaan[lang] = false;
          } else if (value.trim().length < 10) {
            this.formErrors.pertanyaan[lang] = 'Question must be at least 10 characters';
            this.formValid.pertanyaan[lang] = false;
          } else {
            this.formErrors.pertanyaan[lang] = '';
            this.formValid.pertanyaan[lang] = true;
          }
          break;
          
        case 'jawaban':
          if (!value.trim()) {
            this.formErrors.jawaban[lang] = 'Answer is required';
            this.formValid.jawaban[lang] = false;
          } else if (value.trim().length < 20) {
            this.formErrors.jawaban[lang] = 'Answer must be at least 20 characters';
            this.formValid.jawaban[lang] = false;
          } else {
            this.formErrors.jawaban[lang] = '';
            this.formValid.jawaban[lang] = true;
          }
          break;
      }
    },

    canSubmit() {
      const pertanyaanValid = Object.values(this.formValid.pertanyaan).every(v => v);
      const jawabanValid = Object.values(this.formValid.jawaban).every(v => v);
      return pertanyaanValid && jawabanValid;
    },

    hasFormErrors() {
      return Object.values(this.formErrors.pertanyaan).some(e => e !== '') ||
             Object.values(this.formErrors.jawaban).some(e => e !== '');
    }
  }"
  >
    <h2 class='text-2xl font-semibold mt-0 mb-6 text-center text-gray-900'>Create FAQ</h2>

    <form
      action='/pertanyaan-umum/{{kategoriId}}'
      method='post'
      class='space-y-6'
      @submit.prevent="if (canSubmit()) { $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"

      <!-- Pertanyaan per Bahasa -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Question
        </label>
        <div class='grid grid-cols-1 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.pertanyaan.id'
              @input='validateField("pertanyaan", $event.target.value, "id")'
              name='pertanyaan[id]'
              rows='3'
              required
              maxlength='500'
              :class="formErrors.pertanyaan.id ? 'border-red-500 focus:ring-red-500' : (formValid.pertanyaan.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 resize-none'
              placeholder='Pertanyaan (ID)'
            ></textarea>
            <template x-if='formErrors.pertanyaan.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.pertanyaan.id'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.pertanyaan.id && formValid.pertanyaan.id && !formErrors.pertanyaan.id'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.pertanyaan.en'
              @input='validateField("pertanyaan", $event.target.value, "en")'
              name='pertanyaan[en]'
              rows='3'
              required
              maxlength='500'
              :class="formErrors.pertanyaan.en ? 'border-red-500 focus:ring-red-500' : (formValid.pertanyaan.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 resize-none'
              placeholder='Question (EN)'
            ></textarea>
            <template x-if='formErrors.pertanyaan.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.pertanyaan.en'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.pertanyaan.en && formValid.pertanyaan.en && !formErrors.pertanyaan.en'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.pertanyaan.ja'
              @input='validateField("pertanyaan", $event.target.value, "ja")'
              name='pertanyaan[ja]'
              rows='3'
              required
              maxlength='500'
              :class="formErrors.pertanyaan.ja ? 'border-red-500 focus:ring-red-500' : (formValid.pertanyaan.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 resize-none'
              placeholder='質問 (JA)'
            ></textarea>
            <template x-if='formErrors.pertanyaan.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.pertanyaan.ja'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.pertanyaan.ja && formValid.pertanyaan.ja && !formErrors.pertanyaan.ja'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Jawaban per Bahasa -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Answer
        </label>
        <div class='grid grid-cols-1 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.jawaban.id'
              @input='validateField("jawaban", $event.target.value, "id")'
              name='jawaban[id]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.jawaban.id ? 'border-red-500 focus:ring-red-500' : (formValid.jawaban.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 resize-none'
              placeholder='Jawaban (ID)'
            ></textarea>
            <template x-if='formErrors.jawaban.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.jawaban.id'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.jawaban.id && formValid.jawaban.id && !formErrors.jawaban.id'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.jawaban.en'
              @input='validateField("jawaban", $event.target.value, "en")'
              name='jawaban[en]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.jawaban.en ? 'border-red-500 focus:ring-red-500' : (formValid.jawaban.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 resize-none'
              placeholder='Answer (EN)'
            ></textarea>
            <template x-if='formErrors.jawaban.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.jawaban.en'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.jawaban.en && formValid.jawaban.en && !formErrors.jawaban.en'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.jawaban.ja'
              @input='validateField("jawaban", $event.target.value, "ja")'
              name='jawaban[ja]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.jawaban.ja ? 'border-red-500 focus:ring-red-500' : (formValid.jawaban.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 resize-none'
              placeholder='回答 (JA)'
            ></textarea>
            <template x-if='formErrors.jawaban.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.jawaban.ja'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.jawaban.ja && formValid.jawaban.ja && !formErrors.jawaban.ja'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>

      <!-- Action buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="canSubmit() ? 'bg-gray-900 hover:bg-gray-600' : 'bg-gray-400 cursor-not-allowed'"
          class='text-white px-6 py-2 rounded-lg shadow transition'
        >
          Create
        </button>
        <a
          href='/kategoris/{{kategoriId}}'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition'
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>