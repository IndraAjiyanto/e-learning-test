<div class="py-10">
  <div class="max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg">
    <h2 class="text-2xl font-semibold mb-6 text-gray-900">Edit FAQ</h2>

    <form action="/faqs/{{pertanyaan_umum.id}}?_method=PATCH" method="post" class="space-y-6">

      <!-- Question -->
      <div>
        <label for="pertanyaan" class="block text-sm font-semibold text-gray-700 mb-1">
          Question
        </label>
        <textarea 
          id="pertanyaan" 
          name="pertanyaan" 
          rows="4"
          class="w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700">{{pertanyaan_umum.pertanyaan}}</textarea>
      </div>

      <!-- Answer -->
      <div>
        <label for="jawaban" class="block text-sm font-semibold text-gray-700 mb-1">
          Answer
        </label>
        <textarea 
          id="jawaban" 
          name="jawaban" 
          rows="4"
          class="w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700">{{pertanyaan_umum.jawaban}}</textarea>
      </div>

            <div>
        <label
          for="for"
          class="block text-sm font-semibold text-gray-700 mb-1"
        >For</label>
        <select
          name="for"
          id="for"
          class="w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700"
        >
          <option value="" disabled>-- Select For --</option>
          <option value="wip" {{#if (eq pertanyaan_umum.for "wip")}}selected{{/if}}>WIP</option>
          <option value="general" {{#if (eq pertanyaan_umum.for "general")}}selected{{/if}}>General</option>
          <option value="short_class" {{#if (eq pertanyaan_umum.for "short_class")}}selected{{/if}}>Admin</option>
          <option value="bootcamp" {{#if (eq pertanyaan_umum.for "bootcamp")}}selected{{/if}}>Bootcamp</option>
          <option value="course" {{#if (eq pertanyaan_umum.for "course")}}selected{{/if}}>Course</option>
        </select>
      </div>

      <!-- Action buttons -->
      <div class="flex gap-3">
        <button type="submit" 
          class="bg-gray-900 text-white px-6 py-2 rounded-lg shadow hover:bg-gray-600 transition">
          Update
        </button>
        <a href="/pertanyaan-umum"
          class="px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>
