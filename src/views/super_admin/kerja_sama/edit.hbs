<div class="pt-28 py-20">
  <div class="max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg">
    <h2 class="text-2xl font-semibold mb-6 text-gray-900 text-center">Edit Cooperation</h2>

    <form action="/kerja-sama/{{kerja_sama.id}}?_method=PATCH" method="post" enctype="multipart/form-data" class="space-y-6">
      
      <!-- Upload Gambar -->
      <div x-data="{ 
              previewUrl: null,
              oldImage: '{{kerja_sama.gambar}}'
           }" class="space-y-3">

        <label for="gambar" class="block text-sm font-semibold text-gray-700 mb-1">
          Replace Image (optional)
        </label>

        <input 
          type="file" 
          id="gambar" 
          name="gambar" 
          accept="image/*"
          x-ref="fileInput"
          class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none 
                 focus:ring-2 focus:ring-gray-900 text-gray-700"
          @change="previewUrl = $event.target.files[0] ? URL.createObjectURL($event.target.files[0]) : null"
        >

        <!-- Preview Baru -->
        <template x-if="previewUrl">
          <div class="relative w-32 h-32">
            <img 
              :src="previewUrl" 
              alt="New Image Preview" 
              class="w-32 h-32 object-cover rounded-lg border border-gray-300"
            >
            <button 
              type="button" 
              class="absolute -top-2 -right-2 bg-red-500 text-white w-6 h-6 rounded-full 
                     flex items-center justify-center shadow hover:bg-red-600"
              @click="previewUrl = null; $refs.fileInput.value = null">
              &times;
            </button>
          </div>
        </template>

        <!-- Preview Lama -->
        <template x-if="!previewUrl && oldImage">
          <div class="relative w-32 h-32">
            <img 
              :src="'/uploads/kerjasama/' + oldImage" 
              alt="Old Image" 
              class="w-32 h-32 object-cover rounded-lg border border-gray-300"
            >
            <p class="text-xs text-gray-500 mt-1">Current Image</p>
          </div>
        </template>
      </div>

      <!-- Tombol aksi -->
      <div class="flex gap-3 justify-end">
        <button type="submit" 
          class="bg-gray-900 text-white px-6 py-2 rounded-lg shadow hover:bg-gray-700 transition">
          Save Changes
        </button>
        <a href="/kerja-sama"
          class="px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>
