{{!--
  Halaman: Create Visi — Super Admin
  Lokasi: src/views/super_admin/visions/create.hbs
  Level: L4 Page

  Route: GET /vision/formCreate -> POST /vision (urlencoded).
  Field dikirim sebagai visions[id] / visions[en] / visions[ja] — express
  urlencoded extended merakitnya jadi objek sesuai kolom jsonb entity.

  Toast sukses tidak dirender di sini: submit redirect ke /vision, jadi
  notifikasinya muncul di index.hbs lewat flash `toast`.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Visi'
      }}

      {{> components/ui/super_admin/description/index
        text='Create a new vision statement for use across Kesatria Academy.'
      }}
    </div>

    <form
      action='/vision'
      method='post'
      novalidate
      x-data='visionForm()'
      @submit.prevent='submitForm($event)'
    >
      {{#> components/ui/super_admin/form/vision/fields }}
        <div class='flex flex-col-reverse gap-3 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href='/vision'
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Create Visi'
            loading=true
          }}
        </div>
      {{/components/ui/super_admin/form/vision/fields}}
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/vision/form }}
