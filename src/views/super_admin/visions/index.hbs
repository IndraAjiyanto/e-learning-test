{{!--
  Halaman: Visi — Super Admin
  Lokasi: src/views/super_admin/visions/index.hbs
  Level: L4 Page

  - Sidebar sudah disediakan oleh layouts/main.hbs (offset lg:ml-[319px])

  Data: GET /vision → { visions }. Memakai clientTable (bukan endpoint filter):
  baris visi sangat sedikit dan controller mengirimnya utuh, jadi paginasi di
  server tidak memberi keuntungan apa pun.

  `visions` adalah kolom jsonb { id, en, ja }, jadi tabelnya memakai tab bahasa
  seperti halaman Program Type.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Visi'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage the vision statement shown on the About page.'
      }}
    </div>

    <div
      class='flex flex-col gap-2.5'
      x-data='clientTable({ items: {{json visions}}, searchKeys: ["visions.id", "visions.en", "visions.ja"] })'
    >
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search visi..'
        searchLabel='Search visi'
        createHref='/vision/formCreate'
        createLabel='Create Visi'
      }}

      <div
        class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
        x-data="{ lang: 'id' }"
      >
        <div class='flex flex-col gap-4'>

          {{> components/ui/super_admin/tabs/language/index ariaLabel='Visi language' }}

          {{#> components/ui/super_admin/table/card tableClass='min-w-[900px]'}}
            <colgroup>
              <col class='w-[894px]' />
              <col class='w-[116px]' />
            </colgroup>
            <thead>
              <tr>
                {{> components/ui/super_admin/table/header_cell label='Visi' }}
                {{> components/ui/super_admin/table/header_cell label='Action' }}
              </tr>
            </thead>
            <tbody>
              <template x-for='row in rows' :key='row.id'>
                <tr class='transition-colors hover:bg-[#fafafa]'>

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='block truncate font-inter text-sm leading-5 text-[#525252]'
                      x-text='(row.visions && row.visions[lang]) || "—"'
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell variant='action'}}
                    {{> components/ui/super_admin/table/row_actions
                      entity='visi'
                      editHref="'/vision/formEdit/' + row.id"
                      deleteAction="'/vision/' + row.id + '?_method=DELETE'"
                    }}
                  {{/components/ui/super_admin/table/cell}}
                </tr>
              </template>

              {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='2'}}
                No visi found.
              {{/components/ui/super_admin/table/message_row}}
            </tbody>
          {{/components/ui/super_admin/table/card}}
        </div>
      </div>
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Visi?'
  description='Are you sure you want to delete this visi? It will disappear from the public About page in all languages. This action cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}
