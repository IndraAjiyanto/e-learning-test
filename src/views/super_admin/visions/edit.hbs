{{!--
  Halaman: Edit Visi — Super Admin
  Lokasi: src/views/super_admin/visions/edit.hbs
  Level: L4 Page

  Route: GET /vision/formEdit/:visionsId -> PATCH /vision/:visionsId
  (urlencoded + _method override). Data: { vision }.

  Beda dari create.hbs: field terisi nilai existing. Tidak ada tombol hapus di
  sini — menghapus dilakukan lewat aksi baris di halaman daftar, sama seperti
  halaman Teknologi dan Program Type.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Visi'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the vision statement used across Kesatria Academy.'
      }}
    </div>

    {{!-- Nilai awal lewat helper json, bukan template literal: teks visi bebas
         diketik dan bisa memuat karakter yang memecah skrip. --}}
    <div class='flex flex-col gap-4'>
      <form
      action='/vision/{{vision.id}}?_method=PATCH'
      method='post'
      novalidate
      x-data='{ ...visionForm({ visions: {{json vision.visions}} }), ...formDirtyGate() }'
      x-init='$nextTick(() => captureBaseline())'
      @input='recomputeDirty()'
      @change='recomputeDirty()'
      @submit.prevent='submitForm($event)'
    >
      {{#> components/ui/super_admin/form/vision/fields }}
        <div class='flex flex-col-reverse gap-3 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href='/vision'
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Save Changes'
            loading=true
            disabled='!canSubmit() || !isDirty || loading'
          }}
        </div>
      {{/components/ui/super_admin/form/vision/fields}}
      </form>

      {{!-- Danger Zone — bentuk dan jaraknya mengikuti super_admin/user/edit.hbs. --}}
      {{> components/ui/super_admin/danger_zone/index
        title='Delete Visi'
        description='Permanently remove this visi from the public About page in all languages. This action cannot be undone.'
        action=(concat '/vision/' vision.id '?_method=DELETE')
      }}
    </div>
  </div>
</div>

{{!-- Konfirmasi delete — komponen yang sama dengan halaman daftar. Tombol Danger
     Zone memakai onclick='openDeleteModal(this)'; fungsi itu didefinisikan oleh
     komponen modal ini. --}}
{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Visi?'
  description='Are you sure you want to delete this visi? It will disappear from the public About page in all languages. This action cannot be undone.'
}}

{{> components/ui/super_admin/form/vision/form }}
