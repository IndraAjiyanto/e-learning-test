<div
  class='py-10'
  x-data="{
  // Form validation states
  formData: {
    visions: { id: `{{visions.visions.id}}`, en: `{{visions.visions.en}}`, ja: `{{visions.visions.ja}}` }
  },
  formErrors: {
    visions: { id: '', en: '', ja: '' }
  },
  formValid: {
    visions: { id: false, en: false, ja: false }
  },

  init() {
    // Validate initial values
    this.validateField('visions', 'id', this.formData.visions.id);
    this.validateField('visions', 'en', this.formData.visions.en);
    this.validateField('visions', 'ja', this.formData.visions.ja);
  },

  validateField(field, lang, value) {
    this.formData[field][lang] = value;
    
    switch(field) {
      case 'visions':
        if (!value.trim()) {
          this.formErrors.visions[lang] = 'Visi is required';
          this.formValid.visions[lang] = false;
        } else if (value.trim().length < 10) {
          this.formErrors.visions[lang] = 'Visi must be at least 10 characters';
          this.formValid.visions[lang] = false;
        } else {
          this.formErrors.visions[lang] = '';
          this.formValid.visions[lang] = true;
        }
        break;
    }
  },

  canSubmit() {
    return Object.values(this.formValid.visions).every(v => v);
  },

  hasFormErrors() {
    return Object.values(this.formErrors.visions).some(e => e !== '');
  }
}"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Visi</h2>

    <form
      action='/vision/{{visions.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      x-data='{ loading: false }'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; } loading = true;'
    >

{{> super_admin/visions/edit/visions_input }}

      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span
            x-show='loading'
            class='loading loading-spinner loading-sm'
          ></span>
          <span x-show='!loading'>Update</span>
        </button>
        <a
          href='/vision'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors()'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>

    </form>
  </div>
</div>