<div
  class='py-10'
  x-data="{
    type: '{{voucher.type}}',
    selectedCourses: [{{#each voucher.courses}}{{#if @index}},{{/if}}{{this.id}}{{/each}}],
    searchQuery: '',
    
    selectedUsers: [{{#if voucher.allowed_user_ids}}{{#each voucher.allowed_user_ids}}{{#if @index}},{{/if}}{{this}}{{/each}}{{/if}}],
    searchUserQuery: '',

    get filteredCourses() {
      const q = this.searchQuery.toLowerCase();
      return {{json courses}}.filter(c => c.name.toLowerCase().includes(q) && !this.selectedCourses.includes(c.id));
    },

    get filteredUsers() {
      const q = this.searchUserQuery.toLowerCase();
      return {{json users}}.filter(u => 
        (u.username.toLowerCase().includes(q) || u.email.toLowerCase().includes(q)) && 
        !this.selectedUsers.includes(u.id)
      );
    },

    toggleCourse(id) {
      const idx = this.selectedCourses.indexOf(id);
      if (idx > -1) this.selectedCourses.splice(idx, 1);
      else this.selectedCourses.push(id);
    },

    removeCourse(id) {
      const idx = this.selectedCourses.indexOf(id);
      if (idx > -1) this.selectedCourses.splice(idx, 1);
    },

    getCourseName(id) {
      const c = {{json courses}}.find(c => c.id === id);
      return c ? c.name : '';
    },

    toggleUser(id) {
      const idx = this.selectedUsers.indexOf(id);
      if (idx > -1) this.selectedUsers.splice(idx, 1);
      else this.selectedUsers.push(id);
    },

    removeUser(id) {
      const idx = this.selectedUsers.indexOf(id);
      if (idx > -1) this.selectedUsers.splice(idx, 1);
    },

    getUserName(id) {
      const u = {{json users}}.find(u => u.id === id);
      return u ? `${u.username} (${u.email})` : '';
    }
  }"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Voucher</h2>

    <form
      action='/voucher/{{voucher.id}}?_method=PATCH'
      method='post'
      class='space-y-6'
      x-data='{ loading: false }'
      @submit='loading = true;'
    >

      <div>
        <label class='block text-sm font-medium text-gray-700 mb-1'>Voucher Code</label>
        <input
          type='text'
          name='code_voucher'
          required
          value='{{voucher.code_voucher}}'
          class='w-full bg-white border border-gray-300 rounded-lg px-4 py-2 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white'
        />
      </div>

      <div>
        <label class='block text-sm font-medium text-gray-700 mb-1'>Type</label>
        <select
          name='type'
          x-model='type'
          class='w-full bg-white border border-gray-300 rounded-lg px-4 py-2 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white'
        >
          <option value='free'>Free</option>
          <option value='discount'>Discount</option>
        </select>
      </div>

      <div x-show="type === 'discount'">
        <label class='block text-sm font-medium text-gray-700 mb-1'>Percent (%)</label>
        <input
          type='number'
          name='percent'
          min='0'
          max='100'
          value='{{voucher.percent}}'
          placeholder='e.g. 50'
          class='w-full bg-white border border-gray-300 rounded-lg px-4 py-2 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white'
        />
      </div>

      <div class='flex items-center gap-3'>
        <input type='hidden' name='active' value='false' />
        <input
          type='checkbox'
          name='active'
          value='true'
          id='active'
          {{#if voucher.active}}checked{{/if}}
          class='w-5 h-5 rounded border-gray-300 text-gray-900 focus:ring-gray-900'
        />
        <label for='active' class='text-sm font-medium text-gray-700'>Active</label>
      </div>

      <div class="border-t border-gray-200 pt-6 mt-6">
        <label class='block text-sm font-medium text-gray-700 mb-1'>Programs (Optional)</label>
        <p class="text-xs text-gray-500 mb-2">Leave empty if the voucher applies to all programs.</p>
        <input
          type='text'
          x-model='searchQuery'
          placeholder='Search programs...'
          class='w-full bg-white border border-gray-300 rounded-lg px-4 py-2 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white'
        />

        <div class='mt-2 max-h-48 overflow-y-auto border border-gray-200 rounded-lg divide-y divide-gray-100'>
          <template x-for='course in filteredCourses' :key='course.id'>
            <button
              type='button'
              @click='toggleCourse(course.id)'
              class='w-full text-left px-4 py-2 hover:bg-gray-50 transition text-sm text-gray-700'
              x-text='course.name'
            ></button>
          </template>
          <template x-if='filteredCourses.length === 0'>
            <div class='px-4 py-2 text-sm text-gray-400'>No programs found</div>
          </template>
        </div>

        <div class='mt-3 flex flex-wrap gap-2' x-show='selectedCourses.length > 0'>
          <template x-for='id in selectedCourses' :key='id'>
            <span class='inline-flex items-center gap-1 px-3 py-1 bg-gray-100 text-gray-800 rounded-full text-sm'>
              <span x-text='getCourseName(id)'></span>
              <button type='button' @click='removeCourse(id)' class='text-gray-500 hover:text-red-600'>&times;</button>
            </span>
          </template>
        </div>

        <template x-for='id in selectedCourses' :key='id'>
          <input type='hidden' name='courseIds' :value='id' />
        </template>
      </div>

      <div class="border-t border-gray-200 pt-6 mt-6">
        <label class='block text-sm font-medium text-gray-700 mb-1'>Allowed Users (Optional)</label>
        <p class="text-xs text-gray-500 mb-2">Leave empty if the voucher can be used by anyone.</p>
        <input
          type='text'
          x-model='searchUserQuery'
          placeholder='Search username or email...'
          class='w-full bg-white border border-gray-300 rounded-lg px-4 py-2 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white'
        />

        <div class='mt-2 max-h-48 overflow-y-auto border border-gray-200 rounded-lg divide-y divide-gray-100'>
          <template x-for='user in filteredUsers' :key='user.id'>
            <button
              type='button'
              @click='toggleUser(user.id)'
              class='w-full text-left px-4 py-2 hover:bg-gray-50 transition text-sm text-gray-700 flex justify-between'
            >
              <span x-text='user.username' class="font-medium"></span>
              <span x-text='user.email' class="text-gray-500 text-xs"></span>
            </button>
          </template>
          <template x-if='filteredUsers.length === 0'>
            <div class='px-4 py-2 text-sm text-gray-400'>No users found</div>
          </template>
        </div>

        <div class='mt-3 flex flex-wrap gap-2' x-show='selectedUsers.length > 0'>
          <template x-for='id in selectedUsers' :key='id'>
            <span class='inline-flex items-center gap-1 px-3 py-1 bg-blue-50 text-blue-800 border border-blue-200 rounded-full text-sm'>
              <span x-text='getUserName(id)'></span>
              <button type='button' @click='removeUser(id)' class='text-blue-500 hover:text-red-600'>&times;</button>
            </span>
          </template>
        </div>

        <template x-for='id in selectedUsers' :key='id'>
          <input type='hidden' name='allowed_user_ids' :value='id' />
        </template>
      </div>

      <div class='flex gap-3 pt-4'>
        <button
          type='submit'
          :disabled='loading'
          :class="loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span x-show='loading' class='loading loading-spinner loading-sm'></span>
          <span x-show='!loading'>Update</span>
        </button>
        <a
          href='/voucher'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>
