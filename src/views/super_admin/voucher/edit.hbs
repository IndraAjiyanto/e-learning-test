{{!--
  Halaman: Edit Voucher — Super Admin
  Lokasi: src/views/super_admin/voucher/edit.hbs
  Level: L4 Page

  Route: GET /voucher/formEdit/:id -> PATCH /voucher/:id
  (urlencoded + _method override). Data: { voucher, courses, users }.

  `voucher.courses` dikirim sebagai objek Course utuh dan `allowed_user_ids`
  sebagai array id; factory voucherForm menormalkan keduanya jadi chip terpilih.

  Beda dari create.hbs: field terisi nilai existing, tombol aksi berada di dalam
  kartu 02, dan ada kartu Danger Zone untuk menghapus voucher.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Voucher'
      }}

      {{> components/ui/super_admin/description/index
        text='Update this voucher, its discount, and who is allowed to redeem it.'
      }}
    </div>

    <div class='flex flex-col gap-3.5'>
      {{!-- Nilai awal lewat helper json, bukan template literal: kode voucher
           bebas diketik super admin dan bisa memuat karakter yang memecah skrip. --}}
      <form
        action='/voucher/{{voucher.id}}?_method=PATCH'
        method='post'
        novalidate
        x-data='{ ...voucherForm({
          code_voucher: {{json voucher.code_voucher}},
          type: {{json voucher.type}},
          percent: {{json voucher.percent}},
          active: {{json voucher.active}},
          courses: {{json courses}},
          users: {{json users}},
          selectedCourseIds: {{json voucher.courses}},
          selectedUserIds: {{json voucher.allowed_user_ids}}
        }), ...formDirtyGate() }'
        x-init='$nextTick(() => captureBaseline())'
        @input='recomputeDirty()'
        @change='recomputeDirty()'
        @submit.prevent='submitForm($event)'
      >
        {{#> components/ui/super_admin/form/voucher/fields }}
          <div class='flex flex-col-reverse gap-3 sm:flex-row sm:justify-end'>
            {{> components/ui/super_admin/form/button
              as='link'
              variant='secondary'
              href='/voucher'
              label='Cancel'
              loading=true
            }}

            {{> components/ui/super_admin/form/button
              type='submit'
              variant='primary'
              label='Save Changes'
              loading=true
              disabled='!canSubmit() || !isDirty || loading'
            }}
          </div>
        {{/components/ui/super_admin/form/voucher/fields}}
      </form>

      {{!-- Tombol hapus memakai openDeleteModal dari modal/delete_confirm, bukan
           confirmDelete milik partial sweetalert global yang menimpa fungsi senama. --}}
      {{!-- Kartu hapus digating `showDelete` dan mati secara default. Kirim
     showDelete=true dari controller bila perlu ditampilkan lagi. --}}
      {{#if showDelete}}
        <div
          class='flex flex-col gap-4 rounded-2xl border border-[#d9d9d9] bg-white px-4 py-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:flex-row sm:items-end sm:justify-between sm:gap-11 sm:px-[31px] sm:py-[19px]'
        >
          <div class='flex items-start gap-4 sm:min-h-[72px]'>
            <span
              class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-8 border-[#fef2f2] bg-[#fee2e2]'
            >
              {{!-- lucide: alert-circle --}}
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#dc2626' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='h-5 w-5'>
                <circle cx='12' cy='12' r='10' />
                <path d='M12 8v4' />
                <path d='M12 16h.01' />
              </svg>
            </span>

            <div class='flex flex-col gap-1'>
              {{> components/ui/super_admin/description/index
                text='Delete Voucher'
                class='font-montserrat text-base font-semibold leading-5 text-[#003060]'
              }}

              {{> components/ui/super_admin/description/index
                text='Permanently remove this voucher. Anyone holding the code will no longer be able to redeem it. This action cannot be undone.'
                class='font-montserrat text-sm font-medium leading-5 text-[#718096]'
              }}
            </div>
          </div>

          <form
            action='/voucher/{{voucher.id}}?_method=DELETE'
            method='post'
            class='shrink-0'
          >
            {{> components/ui/super_admin/form/button
              variant='danger'
              label='Delete Voucher'
              onclick='openDeleteModal(this)'
              class='w-full sm:w-auto'
            }}
          </form>
        </div>
      {{/if}}
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Voucher?'
  description='Are you sure you want to delete this voucher? Anyone holding the code will no longer be able to redeem it. This action cannot be undone.'
}}

{{> components/ui/super_admin/form/voucher/form }}
