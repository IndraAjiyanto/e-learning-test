{{!--
  Halaman: Create Voucher — Super Admin
  Lokasi: src/views/super_admin/voucher/create.hbs
  Level: L4 Page

  Route: GET /voucher/formCreate -> POST /voucher (urlencoded).
  Data: { courses, users }.

  Field dikirim sebagai code_voucher, type, percent, active, lalu courseIds dan
  allowed_user_ids sebagai hidden input berulang — bentuk yang sudah dibaca
  VoucherService.parseIds. `url_code` tidak ada di form: kolomnya @Generated('uuid').

  Toast sukses tidak dirender di sini: submit redirect ke /voucher, jadi
  notifikasinya muncul di index.hbs lewat flash `toast`.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Voucher'
      }}

      {{> components/ui/super_admin/description/index
        text='Issue a new discount or free-access voucher and choose who can redeem it.'
      }}
    </div>

    <form
      action='/voucher'
      method='post'
      novalidate
      x-data='voucherForm({ courses: {{json courses}}, users: {{json users}} })'
      @submit.prevent='submitForm($event)'
      class='flex flex-col gap-3.5'
    >
      {{> components/ui/super_admin/form/voucher/fields }}

      <div class='flex flex-col-reverse gap-3 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:flex-row sm:justify-end sm:p-5'>
        {{> components/ui/super_admin/form/button
          as='link'
          variant='secondary'
          href='/voucher'
          label='Cancel'
          loading=true
        }}

        {{> components/ui/super_admin/form/button
          type='submit'
          variant='primary'
          label='Create Voucher'
          loading=true
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/voucher/form }}
