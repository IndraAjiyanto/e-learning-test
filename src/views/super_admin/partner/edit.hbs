{{!--
  Halaman: Edit Partnership — Super Admin
  Lokasi: src/views/super_admin/partner/edit.hbs
  Level: L4 Page

  Beda dari create.hbs: kategori terisi, Cover Program tampil sebagai berkas
  existing + tombol Replace, submit "Save Changes", dan ada kartu Danger Zone.

  Route: GET /partnership/formEdit/:partnerId
         -> PATCH /partnership/:partnerId (multipart, image opsional)
         -> DELETE /partnership/:partnerId
  Data: { partner, categories }. Sidebar disediakan layouts/main.hbs.

  Toast sukses tidak ada di file ini: submit redirect ke /partnership, jadi
  notifikasinya dirender index.hbs dari flash `partnerUpdated`.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-2.5'>
    <div class='flex flex-col gap-7'>
      <div class='flex flex-col gap-1'>
        {{> components/ui/super_admin/page_header/index
          title='Edit Partnership'
        }}

        {{> components/ui/super_admin/description/index
          text='Update the partner category or replace the official partner logo.'
        }}
      </div>

      <form
        action='/partnership/{{partner.id}}?_method=PATCH'
        method='post'
        enctype='multipart/form-data'
        novalidate
        x-data='editPartnerForm({
          categories: {{json categories}},
          categoryPartnerId: {{json (default partner.categoryPartner.id "")}},
          image: {{json (default partner.image "")}},
          imageName: {{json (default partner.categoryPartner.category "Partner logo")}}
        })'
        @submit.prevent='submitForm($event)'
        class='rounded-xl border border-[#d9d9d9] bg-white p-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-5'
      >
        <div class='flex flex-col gap-6'>
          {{> components/ui/super_admin/description/index
            text='Partnership Detail'
            class='font-montserrat text-xl font-semibold leading-6 text-[#003060]'
          }}

          <div class='flex flex-col gap-5'>
            {{> components/ui/super_admin/form/select_field
              id='categoryPartnerId'
              name='categoryPartnerId'
              field='categoryPartnerId'
              label='Partner Category'
              placeholder='Select a category'
              hint='Select the category that best matches this partner.'
              options='categoryOptions'
              required=true
            }}

            <div class='flex flex-col gap-2.5'>
              <label
                for='image'
                class='font-inter text-sm font-medium leading-5 text-[#404040]'
              >Cover Program<span class='text-[#dc2626]'>*</span></label>

              <input
                type='file'
                id='image'
                name='image'
                accept='image/jpeg,image/jpg,image/png'
                x-ref='fileInput'
                class='sr-only'
                @change='validateImage($event.target.files[0])'
              />

              <div
                @dragover.prevent='dragging = true'
                @dragenter.prevent='dragging = true'
                @dragleave.prevent='dragging = false'
                @drop.prevent='dragging = false; $refs.fileInput.files = $event.dataTransfer.files; validateImage($event.dataTransfer.files[0])'
                :class="dragging
                  ? 'border-[#0080ff] bg-[#eef7ff]'
                  : (errorMessage ? 'border-[#fca5a5] bg-[#fef7f7]' : 'border-[#d9d9d9] bg-[#f8fafc]')"
                class='flex flex-col gap-4 rounded-lg border px-4 py-4 transition-colors sm:flex-row sm:items-center sm:justify-between sm:px-5'
              >
                <div class='flex items-center gap-5'>
                  <template x-if='previewUrl'>
                    <img
                      :src='previewUrl'
                      :alt='fileName'
                      @load='readDimensions($event.target)'
                      @error='previewUrl = ""'
                      class='h-20 w-20 shrink-0 rounded-lg object-cover'
                    />
                  </template>

                  <template x-if='!previewUrl'>
                    <div
                      class='flex h-20 w-20 shrink-0 items-center justify-center rounded-lg bg-[#c7b9da]'
                    >
                      <span
                        class='font-inter text-xl font-semibold leading-6 text-white'
                        x-text='(fileName || "?").charAt(0).toUpperCase()'
                      ></span>
                    </div>
                  </template>

                  <div class='flex min-w-0 flex-col'>
                    <span
                      x-text='fileName'
                      class='truncate font-inter text-sm font-medium leading-5 text-[#525252]'
                    ></span>
                    <span
                      x-text='fileMeta'
                      class='truncate font-inter text-sm leading-5 text-[#525252]'
                    ></span>
                  </div>
                </div>

                {{!-- Class disalin dari form/button variant='secondary'; jaga tetap sinkron. --}}
                <button
                  type='button'
                  @click='$refs.fileInput.click()'
                  :disabled='loading'
                  class='inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-lg border border-[#d4d4d4] bg-white px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-[#003060] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#a3a3a3] hover:bg-[#f5f5f5] active:bg-[#ededed] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60'
                >
                  {{!-- lucide: upload --}}
                  <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.67' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='h-5 w-5'>
                    <path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4' />
                    <path d='M17 8l-5-5-5 5' />
                    <path d='M12 3v12' />
                  </svg>
                  Replace
                </button>
              </div>

              <p
                x-show='errorMessage'
                x-cloak
                x-text='errorMessage'
                class='font-inter text-sm leading-5 text-[#ef4444]'
              ></p>
            </div>

            {{!-- Sengaja tanpa border-t, berbeda dari Create Partnership. --}}
            <div class='flex flex-col-reverse gap-3 pt-6 sm:flex-row sm:justify-end'>
              {{> components/ui/super_admin/form/button
                as='link'
                variant='secondary'
                href='/partnership'
                label='Cancel'
                loading=true
              }}

              {{> components/ui/super_admin/form/button
                type='submit'
                variant='primary'
                label='Save Changes'
                loading=true
              }}
            </div>
          </div>
        </div>
      </form>
    </div>

    {{!-- Tombol hapus memakai openDeleteModal dari modal/delete_confirm, bukan
         confirmDelete milik partial sweetalert global yang menimpa fungsi senama. --}}
    <div
      class='flex flex-col gap-4 rounded-2xl border border-[#d9d9d9] bg-white px-4 py-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:flex-row sm:items-end sm:justify-between sm:gap-11 sm:px-[31px] sm:py-[19px]'
    >
      <div class='flex items-start gap-4 sm:min-h-[72px]'>
        <span
          class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-8 border-[#fef2f2] bg-[#fee2e2]'
        >
          {{!-- lucide: alert-circle --}}
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#dc2626' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='h-5 w-5'>
            <circle cx='12' cy='12' r='10' />
            <path d='M12 8v4' />
            <path d='M12 16h.01' />
          </svg>
        </span>

        <div class='flex flex-col gap-1'>
          {{> components/ui/super_admin/description/index
            text='Delete Partnership'
            class='font-montserrat text-base font-semibold leading-5 text-[#003060]'
          }}

          {{> components/ui/super_admin/description/index
            text='Permanently remove this partnership from Kesatria Academy. This action cannot be undone.'
            class='font-montserrat text-sm font-medium leading-5 text-[#718096]'
          }}
        </div>
      </div>

      <form
        action='/partnership/{{partner.id}}?_method=DELETE'
        method='post'
        class='shrink-0'
      >
        {{> components/ui/super_admin/form/button
          variant='danger'
          label='Delete Partnership'
          onclick='openDeleteModal(this)'
          class='w-full sm:w-auto'
        }}
      </form>
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Partnership?'
  description='Are you sure you want to delete this partnership? This action will permanently remove the partnership and cannot be undone.'
}}

<script>
  // Tanpa guard, pop() pada URL tanpa ekstensi mengembalikan seluruh path.
  function extensionOf(url) {
    const ext = (url || '').split('?')[0].split('#')[0].split('.').pop();
    return /^[a-z0-9]{2,4}$/i.test(ext) ? ext.toUpperCase() : '';
  }

  function editPartnerForm({ categories, categoryPartnerId, image, imageName }) {
    return {
      loading: false,
      dragging: false,

      categoryOptions: (categories || []).map((c) => ({ value: c.id, label: c.category })),

      previewUrl: image || '',
      objectUrl: null,
      fileName: imageName || 'Partner logo',
      // Backend tidak menyimpan tipe & dimensi, jadi keduanya diturunkan di client:
      // tipe dari ekstensi URL, dimensi dari readDimensions() saat pratinjau dimuat.
      fileType: extensionOf(image),
      fileDimensions: '',
      errorMessage: '',
      isValid: true,

      formData: { categoryPartnerId: categoryPartnerId || '' },
      formErrors: { categoryPartnerId: '' },

      get fileMeta() {
        const parts = [this.fileType, this.fileDimensions].filter(Boolean);
        return parts.length ? parts.join(' • ') : 'No image uploaded';
      },

      readDimensions(img) {
        if (!img.naturalWidth) return;
        this.fileDimensions = `${img.naturalWidth} × ${img.naturalHeight} px`;
      },

      // Batas mengikuti kontrak backend (@ValidateImage pada PartnerController):
      // JPG/PNG, 300–2000 px, maks 5 MB.
      validateImage(file) {
        if (!file) return;

        this.errorMessage = '';
        this.isValid = true;

        const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
        if (!allowedTypes.includes(file.type)) {
          this.setImageError('Only JPG and PNG formats are allowed');
          return;
        }

        const maxSize = 5 * 1024 * 1024;
        if (file.size > maxSize) {
          this.setImageError(
            `File size too large (${(file.size / 1024 / 1024).toFixed(2)} MB). Maximum 5 MB`,
          );
          return;
        }

        const img = new Image();
        const nextUrl = URL.createObjectURL(file);

        img.onload = () => {
          if (img.width < 300 || img.width > 2000 || img.height < 300 || img.height > 2000) {
            URL.revokeObjectURL(nextUrl);
            this.setImageError(
              `Image is ${img.width}x${img.height}px. Required: 300x300 to 2000x2000 pixels`,
            );
            return;
          }

          this.applyFile(file, nextUrl, img);
        };

        img.onerror = () => {
          URL.revokeObjectURL(nextUrl);
          this.setImageError('Failed to load image');
        };

        img.src = nextUrl;
      },

      applyFile(file, nextUrl, img) {
        if (this.objectUrl) URL.revokeObjectURL(this.objectUrl);

        this.objectUrl = nextUrl;
        this.previewUrl = nextUrl;
        this.fileName = file.name;
        this.fileType = (file.type.split('/')[1] || 'image').toUpperCase();
        this.fileDimensions = `${img.width} × ${img.height} px`;
        this.isValid = true;
        this.errorMessage = '';
      },

      // Berkas ditolak: gambar lama tetap di layar dan input dikosongkan agar
      // berkas itu tidak ikut terkirim.
      setImageError(message) {
        this.errorMessage = message;
        this.isValid = false;
        this.$refs.fileInput.value = null;
      },

      errorFor(field, val) {
        if (field === 'categoryPartnerId') return val ? '' : 'Please select a partner category.';
        return '';
      },

      // Dipanggil select_field setiap kali sebuah option dipilih
      touch(field) {
        this.formErrors[field] = this.errorFor(field, this.formData[field]);
      },

      validateAll() {
        Object.keys(this.formData).forEach((field) => {
          this.formErrors[field] = this.errorFor(field, this.formData[field]);
        });
      },

      hasFormErrors() {
        return Object.values(this.formErrors).some((error) => error !== '');
      },

      // Tanpa berkas baru, gambar lama dipakai — jadi tidak ada syarat "harus ada
      // file" seperti di halaman Create.
      canSubmit() {
        return this.isValid && !this.hasFormErrors();
      },

      focusFirstInvalid() {
        const firstInvalid = Object.keys(this.formErrors).find((f) => this.formErrors[f]);
        if (firstInvalid) {
          document.getElementById(`${firstInvalid}-trigger`)?.focus();
          return;
        }

        if (!this.isValid) this.$refs.fileInput.parentElement.scrollIntoView({ block: 'center' });
      },

      // Tombol Save Changes selalu aktif; validasi dijalankan di sini.
      submitForm(event) {
        this.validateAll();
        if (!this.canSubmit()) {
          this.focusFirstInvalid();
          return;
        }

        this.loading = true;
        event.target.submit();
      },
    };
  }
</script>
