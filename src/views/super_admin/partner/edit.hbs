<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{ 
    previewUrl: null,
    oldImage: `{{partner.image}}`,
    errorMessage: '',
    isValid: true,
    fileName: '',
    fileSize: 0,
    imageWidth: 0,
    imageHeight: 0,
    hasFile: false,
    hasNewImage: false,
    cropper: null,
    showCropModal: false,
    tempImageUrl: null,
    croppedBlob: null,
    categoryPartnerId: '{{partner.categoryPartner.id}}',
    validateImage(file) {
      if (!file) {
        this.hasFile = false;
        this.hasNewImage = false;
        return;
      }
      
      this.fileName = file.name;
      this.fileSize = file.size;
      this.errorMessage = '';
      this.isValid = true;

      // Validasi tipe file
      const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
      if (!allowedTypes.includes(file.type)) {
        this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
        this.isValid = false;
        this.previewUrl = null;
        return;
      }

      // Validasi ukuran file (5MB)
      const maxSize = 5 * 1024 * 1024; // 5MB
      if (file.size > maxSize) {
        this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
        this.isValid = false;
        this.previewUrl = null;
        return;
      }

      // Validasi dimensi gambar
      const img = new Image();
      const objectUrl = URL.createObjectURL(file);
      
      img.onload = () => {
        this.imageWidth = img.width;
        this.imageHeight = img.height;
        
        if (img.width < 300 || img.width > 2000 || img.height < 300 || img.height > 2000) {
          this.errorMessage = `Image dimensions ${img.width}x${img.height}px. Required: 300x300 to 2000x2000 pixels`;
          this.isValid = false;
          this.previewUrl = null;
          URL.revokeObjectURL(objectUrl);
        } else {
          // Buka crop modal
          this.tempImageUrl = objectUrl;
          this.showCropModal = true;

          this.$nextTick(() => {
            this.initCropper();
          });
        }
      };
      
      img.onerror = () => {
        this.errorMessage = 'Failed to load image';
        this.isValid = false;
        this.previewUrl = null;
        URL.revokeObjectURL(objectUrl);
      };
      
      img.src = objectUrl;
    },

    initCropper() {
      const image = document.getElementById('cropImage');
      if (this.cropper) {
        this.cropper.destroy();
      }

      this.cropper = new Cropper(image, {
        aspectRatio: 1,
        viewMode: 1,
        dragMode: 'move',
        autoCropArea: 0.8,
        restore: false,
        guides: false,
        center: true,
        highlight: false,
        cropBoxMovable: true,
        cropBoxResizable: true,
        toggleDragModeOnDblclick: false,
        ready() {
          const cropper = this.cropper;
          const containerData = cropper.getContainerData();
          const cropBoxData = cropper.getCropBoxData();

          // Make crop box circular
          const cropBox = cropper.cropBox;
          cropBox.querySelector('.cropper-view-box').style.borderRadius = '50%';
          cropBox.querySelector('.cropper-face').style.borderRadius = '50%';
        }
      });
    },

    async applyCrop() {
      if (!this.cropper) return;

      const canvas = this.cropper.getCropBoxData();
      this.cropper.getCroppedCanvas({
        width: 400,
        height: 400,
        imageSmoothingEnabled: true,
        imageSmoothingQuality: 'high',
      }).toBlob((blob) => {
        this.croppedBlob = blob;
        this.previewUrl = URL.createObjectURL(blob);
        this.hasFile = true;
        this.hasNewImage = true;
        this.isValid = true;
        this.errorMessage = '';
        this.closeCropModal();
      }, 'image/jpeg', 0.9);
    },

    closeCropModal() {
      this.showCropModal = false;
      if (this.cropper) {
        this.cropper.destroy();
        this.cropper = null;
      }
      if (this.tempImageUrl) {
        URL.revokeObjectURL(this.tempImageUrl);
        this.tempImageUrl = null;
      }
      this.$refs.fileInput.value = null;
    },

    cancelCrop() {
      // Kembali ke kondisi gambar lama saat modal dibatalkan
      this.previewUrl = null;
      this.hasFile = false;
      this.hasNewImage = false;
      this.croppedBlob = null;
      this.isValid = true;
      this.errorMessage = '';
      this.fileName = '';
      this.fileSize = 0;
      this.closeCropModal();
    },

    async handleSubmit(e) {
      if (!this.canSubmit()) {
        e.preventDefault();
        alert('Please fix the image validation errors before submitting.');
        return;
      }

      // If there's a cropped image, convert blob to file and update input
      if (this.croppedBlob) {
        e.preventDefault();

        // Create a new File from the cropped blob
        const file = new File([this.croppedBlob], this.fileName, { 
          type: this.croppedBlob.type 
        });

        // Create a new DataTransfer to set the file input
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(file);
        this.$refs.fileInput.files = dataTransfer.files;

        // Now submit the form normally
        e.target.submit();
      }
      // If no cropped image, form will submit normally (we don't prevent default)
    },
    clearFile() {
      this.previewUrl = null;
      this.errorMessage = '';
      this.isValid = true;
      this.fileName = '';
      this.fileSize = 0;
      this.imageWidth = 0;
      this.imageHeight = 0;
      this.hasFile = false;
      this.hasNewImage = false;
      this.croppedBlob = null;
      $refs.fileInput.value = null;
    },
    canSubmit() {
      // Kategori wajib dipilih
      if (this.categoryPartnerId === '') {
        return false;
      }
      // Jika ada file baru yang diupload, harus valid
      if (this.hasNewImage) {
        return this.isValid;
      }
      // Jika tidak ada file baru, tetap bisa submit (gunakan gambar lama)
      return true;
    }
  }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Cooperation</h2>

    <form
      action='/partnership/{{partner.id}}?_method=PATCH'
      method='post'
      enctype='multipart/form-data'
      class='space-y-6'
      x-data='{ loading: false }'
      @submit='handleSubmit; if (!canSubmit()) { $event.preventDefault(); return false; } loading = true;'
    >

      <!-- Pilih Kategori Partner -->
      <div>
        <label class='block text-sm font-semibold text-gray-700 mb-2'>
          Partner Category
        </label>
        <select
          name='categoryPartnerId'
          x-model='categoryPartnerId'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900'
        >
          <option value='' disabled>-- Select category --</option>
          {{#each categories}}
            <option value='{{id}}'>{{category}}</option>
          {{/each}}
        </select>
        <p
          x-show="categoryPartnerId === ''"
          class='mt-1 text-sm text-red-600'
        >Category is required</p>
      </div>

    {{> super_admin/partnership/edit/image_input}}

      <!-- Tombol aksi -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2'
        >
          <span
            x-show='loading'
            class='loading loading-spinner loading-sm'
          ></span>
          <span x-show='!loading'>Update</span>
        </button>
        <a
          href='/partnership'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasNewImage && !isValid'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix the image validation errors above.
          </p>
        </div>
      </template>
    </form>

{{> super_admin/partnership/edit/crop_modal}}
  </div>
</div>