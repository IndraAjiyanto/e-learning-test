{{!--
  Halaman: Edit Teknologi — Super Admin
  Lokasi: src/views/super_admin/technologies/edit.hbs
  Level: L4 Page

  Judul, sub-judul, dan label field memakai istilah "Teknologi" sesuai Figma.

  Route: GET /technology/formEdit/:id -> PATCH /technology/:id
  (multipart + _method override). Data: { technologies }.

  Beda dari create.hbs: field terisi nilai existing, termasuk pratinjau gambar
  lama lewat previewUrl.

  TIDAK ADA TOMBOL HAPUS DI SINI — sesuai Figma, halaman edit hanya menyimpan
  perubahan. Menghapus teknologi dilakukan lewat aksi baris di halaman daftar,
  yang sudah memakai modal konfirmasi yang sama.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Teknologi'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the teknologi information used across Kesatria Academy.'
      }}
    </div>

    <div class='flex flex-col gap-4'>
      {{!-- Nilai awal lewat helper json, bukan template literal: markup SVG
           yang tersimpan mengandung kutip dan tanda kurung yang akan memecah
           skrip kalau ditempel mentah. --}}
      <form
        action='/technology/{{technologies.id}}?_method=PATCH'
        method='post'
        enctype='multipart/form-data'
        novalidate
        x-data='{ ...technologyForm({ name: {{json technologies.name}}, svg: {{json technologies.svg}}, imgUrl: {{json technologies.imgUrl}} }), ...formDirtyGate() }'
        x-init='$nextTick(() => captureBaseline())'
        @input='recomputeDirty()'
        @change='recomputeDirty()'
        @submit.prevent='submitForm($event)'
      >
        {{#> components/ui/super_admin/form/technology/fields showPreview=true }}
          <div class='flex flex-col-reverse gap-3 pt-2 sm:flex-row sm:justify-end'>
            {{> components/ui/super_admin/form/button
              as='link'
              variant='secondary'
              href='/technology'
              label='Cancel'
              loading=true
            }}

            {{> components/ui/super_admin/form/button
              type='submit'
              variant='primary'
              label='Save Changes'
              loading=true
              disabled='!canSubmit() || !isDirty || loading'
            }}
          </div>
        {{/components/ui/super_admin/form/technology/fields}}
      </form>

      {{!-- Danger Zone — bentuk dan jaraknya mengikuti super_admin/user/edit.hbs. --}}
      {{> components/ui/super_admin/danger_zone/index
        title='Delete Teknologi'
        description='Permanently remove this teknologi. Programs already referencing it will lose the badge. This action cannot be undone.'
        action=(concat '/technology/' technologies.id '?_method=DELETE')
      }}

    </div>
  </div>
</div>

{{!-- Konfirmasi delete — komponen yang sama dengan halaman daftar. Tombol Danger
     Zone memakai onclick='openDeleteModal(this)'; fungsi itu didefinisikan oleh
     komponen modal ini. --}}
{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Teknologi?'
  description='Are you sure you want to delete this teknologi? Programs already referencing it will lose the badge. This action cannot be undone.'
}}

{{> components/ui/super_admin/form/technology/form }}
