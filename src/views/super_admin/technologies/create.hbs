{{!--
  Halaman: Create Teknologi — Super Admin
  Lokasi: src/views/super_admin/technologies/create.hbs
  Level: L4 Page

  Figma: LMS Kesatria — page "Super Admin", frame "Program/ Create Teknologi".
  Judul, sub-judul, dan label field memakai istilah "Teknologi" sesuai Figma.

  Route: GET /technology/formCreate -> POST /technology
  (multipart: name, svg, image, remove_image).

  Baris aksi dirender di dalam kartu form lewat partial block — di Figma tombol
  Cancel / Create Teknologi berada di kartu yang sama, bukan kartu terpisah.

  Toast sukses tidak dirender di sini: submit redirect ke /technology, jadi
  notifikasinya muncul di index.hbs lewat flash `toast`.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Teknologi'
      }}

      {{> components/ui/super_admin/description/index
        text='Create a new teknologi for use across Kesatria Academy.'
      }}
    </div>

    <form
      action='/technology'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='technologyForm()'
      @submit.prevent='submitForm($event)'
    >
      {{#> components/ui/super_admin/form/technology/fields }}
        <div class='flex flex-col-reverse gap-3 pt-2 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href='/technology'
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Create Teknologi'
            loading=true
          }}
        </div>
      {{/components/ui/super_admin/form/technology/fields}}
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/technology/form }}
