{{!--
  Halaman: Create Tech — Super Admin
  Lokasi: src/views/super_admin/technologies/create.hbs
  Level: L4 Page

  Route: GET /technology/formCreate -> POST /technology
  (multipart: name, svg, image, remove_image).

  Toast sukses tidak dirender di sini: submit redirect ke /technology, jadi
  notifikasinya muncul di index.hbs lewat flash `toast`.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Tech'
      }}

      {{> components/ui/super_admin/description/index
        text='Add a technology to the stack shown on program and portfolio pages.'
      }}
    </div>

    <form
      action='/technology'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='technologyForm()'
      @submit.prevent='submitForm($event)'
      class='flex flex-col gap-3.5'
    >
      {{> components/ui/super_admin/form/technology/fields }}

      <div class='flex flex-col-reverse gap-3 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:flex-row sm:justify-end sm:p-5'>
        {{> components/ui/super_admin/form/button
          as='link'
          variant='secondary'
          href='/technology'
          label='Cancel'
          loading=true
        }}

        {{> components/ui/super_admin/form/button
          type='submit'
          variant='primary'
          label='Create Tech'
          loading=true
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/technology/form }}
