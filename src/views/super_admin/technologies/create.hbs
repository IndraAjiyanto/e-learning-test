<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create Technology</h2>

    <form
  action='/technology'
  method='post'
  enctype='multipart/form-data'
  class='space-y-6'
  x-data="{
    loading: false,
    name: '',
    svg: '',
    svgPreview: '',
    svgError: '',
    errors: { name: null, svg: null, image: null },
    success: { name: false, svg: false, image: false },
    dragover: false,
    imagePreview: null,
    
    handleDrop(e) {
      this.dragover = false;
      const file = e.dataTransfer.files[0];
      this.processFile(file);
    },
    
    handleFileSelect(e) {
      const file = e.target.files[0];
      this.processFile(file);
    },
    
    processFile(file) {
      if (!file) return;
      
      if (!file.type.startsWith('image/')) {
        this.errors.image = 'Hanya file gambar yang diperbolehkan';
        this.success.image = false;
        this.imagePreview = null;
        $refs.fileInput.value = '';
        return;
      }
      
      if (file.size > 2 * 1024 * 1024) {
        this.errors.image = 'Ukuran maksimal file 2 MB. Silakan ganti file.';
        this.success.image = false;
        this.imagePreview = null;
        $refs.fileInput.value = '';
        return;
      }
      
      this.errors.image = null;
      this.success.image = true;
      
      const reader = new FileReader();
      reader.onload = (e) => {
        this.imagePreview = e.target.result;
      };
      reader.readAsDataURL(file);
    },

    removeImage() {
      this.imagePreview = null;
      this.success.image = false;
      this.errors.image = null;
      $refs.fileInput.value = '';
    },

    validateNama() {
      if (!this.name.trim()) {
        this.errors.name = 'Technology name is required';
        this.success.name = false;
      } else if (this.name.trim().length < 2) {
        this.errors.name = 'Technology name must be at least 2 characters';
        this.success.name = false;
      } else {
        this.errors.name = null;
        this.success.name = true;
      }
    },
    validateSVG(text) {
      this.svgError = '';
      this.errors.svg = null;
      this.success.svg = false;
      
      if (!text) {
        this.svgPreview = '';
        return;
      }
      
      if (!text.trim().startsWith('<svg') || !text.trim().endsWith('</svg>')) {
        this.svgError = 'Invalid SVG format. Must start with <svg and end with </svg>';
        this.errors.svg = this.svgError;
        this.svgPreview = '';
        return;
      }
      
      this.svgPreview = text;
      this.success.svg = true;
    },
    get canSubmit() {
      return this.success.name && (this.success.svg || this.success.image);
    }
  }"
  @submit.prevent="if (canSubmit) { loading = true; $el.submit(); } else { alert('Please fix validation errors, and ensure at least SVG or Image is provided.'); }"
>

{{> super_admin/technology/create/name_input}}

<!-- SVG or Image Selection -->
<div class='bg-gray-50 p-6 rounded-xl border border-gray-200'>
  <h3 class='text-lg font-semibold text-gray-800 mb-4'>Technology Icon</h3>
  <p class='text-sm text-gray-500 mb-6'>Wajib mengisi salah satu (SVG Code atau Upload Gambar)</p>
  
  <div class='space-y-6'>
    {{> super_admin/technology/create/svg_input}}

    <div class='flex items-center gap-4 py-2'>
      <div class='flex-1 h-px bg-gray-300'></div>
      <span class='text-gray-500 font-medium text-sm'>ATAU</span>
      <div class='flex-1 h-px bg-gray-300'></div>
    </div>

    <!-- Image Upload Drag and Drop -->
    <div class='space-y-2'>
      <label class='block text-sm font-semibold text-gray-700 mb-1'>Upload Gambar (Maks 2MB)</label>
      <div 
        @dragover.prevent="dragover = true"
        @dragleave.prevent="dragover = false"
        @drop.prevent="handleDrop($event)"
        :class="dragover ? 'border-blue-500 bg-blue-50' : (errors.image ? 'border-red-500 bg-red-50' : 'border-gray-300 bg-white hover:bg-gray-50')"
        class='border-dashed border-2 rounded-xl p-8 text-center cursor-pointer transition relative'
        @click="$refs.fileInput.click()"
      >
        <input type="file" name="image" accept="image/*" class="hidden" x-ref="fileInput" @change="handleFileSelect($event)">
        
        <template x-if="!imagePreview">
          <div>
            <i class="fas fa-cloud-upload-alt text-4xl text-gray-400 mb-3"></i>
            <p class="text-sm text-gray-600 font-medium">Klik untuk memilih file atau Drag & Drop ke sini</p>
            <p class="text-xs text-gray-500 mt-1">PNG, JPG up to 2MB</p>
          </div>
        </template>

        <template x-if="imagePreview">
          <div class="flex flex-col items-center">
            <img :src="imagePreview" class="h-24 object-contain rounded mb-4" />
            <button type="button" @click.stop="removeImage()" class="text-xs text-red-600 hover:text-red-800 font-medium">Hapus Gambar</button>
          </div>
        </template>
      </div>

      <template x-if='errors.image'>
        <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg mt-2'>
          <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
          <p class='text-xs text-red-700' x-text='errors.image'></p>
        </div>
      </template>
    </div>
  </div>
</div>

      <!-- Action Buttons -->
<div class='flex gap-3'>
    <button
      type='submit'
      :disabled='!canSubmit || loading'
      :class="!canSubmit || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
      class='text-white px-6 py-2 rounded-lg shadow transition focus:outline-none focus:ring-2 focus:ring-gray-900 flex items-center gap-2'
    >
      <span x-show='loading' class='loading loading-spinner loading-sm'></span>
      <span x-show='!loading'>Create</span>
    </button>
    <a
      href='/technology'
      :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
      class='px-6 py-2 rounded-lg border border-gray-300 transition'>
      Cancel
    </a>
  </div>
</form>

    <!-- Submit Warning -->
    <template x-if='errors.name || errors.svg || svgError'>
      <div
        class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
      >
        <i class='fas fa-exclamation-triangle text-red-500'></i>
        <p class='text-sm text-red-800'>
          <span class='font-semibold'>Cannot submit:</span>
          Please fix all validation errors above.
        </p>
      </div>
    </template>
  </div>
</div>