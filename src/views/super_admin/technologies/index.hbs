{{!--
  Halaman: Tech — Super Admin
  Lokasi: src/views/super_admin/technologies/index.hbs
  Level: L4 Page

  - Sidebar sudah disediakan oleh layouts/main.hbs (offset lg:ml-[319px])

  Data: GET /technology/filter → { data, totalItems, totalPages, currentPage }

  Field entity Technology: `name`, `svg` (markup SVG mentah, nullable),
  `imgUrl` (hasil upload, nullable). Backend mewajibkan salah satu terisi,
  jadi kolom Icon selalu punya sesuatu untuk dirender.
--}}
<div
  class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'
  x-data='technologyTable()'
  x-init='fetchTechnologies()'
>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Tools'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage and organize tools used across Kesatria Academy.'
      }}
    </div>

    <div class='flex flex-col gap-2.5'>
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search tools..'
        searchLabel='Search tools'
        createHref='/technology/formCreate'
        createLabel='Create Tools'
      }}

      {{#> components/ui/super_admin/table/card tableClass='min-w-[760px]'}}
        <colgroup>
          <template x-if='selectMode'><col class='w-[48px]' /></template>
          <col class='w-[104px]' />
          <col class='w-[540px]' />
          <col class='w-[116px]' />
        </colgroup>
        <thead>
          <tr>
            {{> components/ui/super_admin/table/header_cell checkbox=true }}
            {{> components/ui/super_admin/table/header_cell label='Icon' }}
            {{> components/ui/super_admin/table/header_cell label='Tools Name' }}
            {{> components/ui/super_admin/table/header_cell label='Action' }}
          </tr>
        </thead>
        <tbody>
          {{#> components/ui/super_admin/table/message_row show='loading' colspan='4'}}
            <i class='fas fa-spinner fa-spin text-xl'></i>
          {{/components/ui/super_admin/table/message_row}}

          <template x-for='row in (loading ? [] : items)' :key='row.id'>
            <tr
              class='transition-colors hover:bg-[#fafafa]'
              :class="selectedIds && selectedIds.some(id => String(id) === String(row.id)) ? 'bg-[#FEF2F2]/60 hover:bg-[#FEF2F2]' : ''"
            >
              {{> components/ui/super_admin/table/cell checkbox=true }}

              {{!-- `svg` menang atas `imgUrl`, sama seperti tampilan publik.
                   Markup-nya dirender apa adanya lewat x-html — isinya
                   ditempel super admin, setara dengan {{{svg}}} di versi lama. --}}
              {{#> components/ui/super_admin/table/cell variant='media'}}
                <span class='flex h-10 w-10 items-center justify-center [&>svg]:h-8 [&>svg]:w-8'>
                  <template x-if='row.svg'>
                    <span class='flex h-8 w-8 items-center justify-center [&>svg]:h-full [&>svg]:w-full [&>svg]:max-h-full [&>svg]:max-w-full [&>svg]:object-contain' x-html='row.svg'></span>
                  </template>
                  <template x-if='!row.svg && !row.imgUrl'>
                    <span class='font-inter text-xs leading-[18px] text-[#a3a3a3]'>—</span>
                  </template>
                  <template x-if='!row.svg && row.imgUrl'>
                    <img :src='row.imgUrl' :alt='row.name' class='h-8 w-8 object-contain' />
                  </template>
                </span>
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell}}
                <span
                  class='block truncate font-inter text-sm leading-5 text-[#525252]'
                  x-text="row.name || '—'"
                ></span>
              {{/components/ui/super_admin/table/cell}}

              {{#> components/ui/super_admin/table/cell variant='action'}}
                {{> components/ui/super_admin/table/row_actions
                  entity='tools'
                  editHref="'/technology/formEdit/' + row.id"
                  deleteAction="'/technology/' + row.id + '?_method=DELETE'"
                }}
              {{/components/ui/super_admin/table/cell}}
            </tr>
          </template>

          {{#> components/ui/super_admin/table/message_row show='!loading && items.length === 0' colspan='3'}}
            No tools found.
          {{/components/ui/super_admin/table/message_row}}
        </tbody>
      {{/components/ui/super_admin/table/card}}
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Tools?'
  description='Are you sure you want to delete this tool? Programs already referencing it will lose the badge. This action cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

<script>
  function technologyTable() {
    return {
      items: [],
      searchInput: '',
      currentPage: 1,
      totalPages: 1,
      totalItems: 0,
      size: 10,
      loading: false,
      searchTimeout: null,
      selectedIds: [],
      selectMode: false,

      get rows() {
        return this.items;
      },

      toggleSelectMode() {
        this.selectMode = !this.selectMode;
        if (!this.selectMode) {
          this.selectedIds = [];
        }
      },

      toggleSelectAllOnPage() {
        if (!this.items || this.items.length === 0) return;
        if (this.isAllSelected()) {
          const currentSet = new Set(this.items.map((i) => String(i.id)));
          this.selectedIds = this.selectedIds.filter((id) => !currentSet.has(String(id)));
        } else {
          const currentIds = this.items.map((i) => i.id);
          const currentSet = new Set(this.selectedIds.map(String));
          currentIds.forEach((id) => {
            if (!currentSet.has(String(id))) {
              this.selectedIds.push(id);
              currentSet.add(String(id));
            }
          });
        }
      },

      confirmDeleteAll() {
        if (!this.items || this.items.length === 0) return;

        openDeleteModal({
          title: 'Delete ALL Tools?',
          description: 'WARNING: You are about to delete ALL tools. This action is permanent and cannot be undone!',
          confirmLabel: 'Yes, Delete ALL Tools',
          cancelLabel: 'Cancel',
          onConfirm: async () => {
            await this.executeDeleteAll();
          },
        });
      },

      async executeDeleteAll() {
        try {
          const res = await fetch('/api/bulk-delete/all', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              entity: 'technology',
            }),
          });
          const json = await res.json();

          if (json.success) {
            this.selectedIds = [];
            this.selectMode = false;
            window.dispatchEvent(
              new CustomEvent('toast:success', {
                detail: {
                  title: 'Deleted Successfully',
                  description: json.message || 'All tools have been deleted.',
                },
              }),
            );
            await this.fetchTechnologies();
          } else {
            window.dispatchEvent(
              new CustomEvent('toast:error', {
                detail: {
                  title: 'Failed to Delete',
                  description: json.message || 'Failed to delete all tools.',
                },
              }),
            );
          }
        } catch (err) {
          window.dispatchEvent(
            new CustomEvent('toast:error', {
              detail: {
                title: 'Error',
                description: 'A network or server error occurred while deleting data.',
              },
            }),
          );
        }
      },

      isAllSelected() {
        if (!this.items || this.items.length === 0) return false;
        return this.items.every((item) => this.selectedIds.some((id) => String(id) === String(item.id)));
      },

      toggleSelectAll(event) {
        if (!this.items || this.items.length === 0) return;
        if (event.target.checked) {
          const currentIds = this.items.map((i) => i.id);
          const currentSet = new Set(this.selectedIds.map(String));
          currentIds.forEach((id) => {
            if (!currentSet.has(String(id))) {
              this.selectedIds.push(id);
              currentSet.add(String(id));
            }
          });
        } else {
          const currentSet = new Set(this.items.map((i) => String(i.id)));
          this.selectedIds = this.selectedIds.filter((id) => !currentSet.has(String(id)));
        }
      },

      clearSelection() {
        this.selectedIds = [];
      },

      confirmDeleteSelected() {
        const count = this.selectedIds.length;
        if (count === 0) return;

        openDeleteModal({
          title: `Delete ${count} Selected Tools?`,
          description: `Are you sure you want to delete ${count} selected tools? This action is permanent and cannot be undone.`,
          confirmLabel: `Delete (${count})`,
          cancelLabel: 'Cancel',
          onConfirm: async () => {
            await this.executeDeleteSelected();
          },
        });
      },

      async executeDeleteSelected() {
        try {
          const res = await fetch('/api/bulk-delete/selected', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              entity: 'technology',
              ids: this.selectedIds,
            }),
          });
          const json = await res.json();

          if (json.success) {
            this.selectedIds = [];
            window.dispatchEvent(
              new CustomEvent('toast:success', {
                detail: {
                  title: 'Deleted Successfully',
                  description: json.message || 'Selected tools have been deleted successfully.',
                },
              }),
            );
            await this.fetchTechnologies();
          } else {
            window.dispatchEvent(
              new CustomEvent('toast:error', {
                detail: {
                  title: 'Failed to Delete',
                  description: json.message || 'An error occurred while deleting data.',
                },
              }),
            );
          }
        } catch (err) {
          window.dispatchEvent(
            new CustomEvent('toast:error', {
              detail: {
                title: 'Error',
                description: 'A network or server error occurred while deleting data.',
              },
            }),
          );
        }
      },

      async fetchTechnologies() {
        this.loading = true;
        try {
          const params = new URLSearchParams();
          if (this.searchInput.trim()) params.set('search', this.searchInput.trim());
          params.set('page', this.currentPage);
          params.set('limit', this.size);

          const res = await fetch(`/technology/filter?${params.toString()}`);
          const json = await res.json();

          this.items = json.data;
          this.totalItems = json.totalItems;
          this.totalPages = json.totalPages;
          this.currentPage = json.currentPage;
        } catch (err) {
          console.error('Fetch tech error:', err);
        } finally {
          this.loading = false;
        }
      },

      handleSearch() {
        clearTimeout(this.searchTimeout);
        this.searchTimeout = setTimeout(() => {
          this.currentPage = 1;
          this.fetchTechnologies();
        }, 300);
      },

      async changePage(page) {
        if (page < 1 || page > this.totalPages) return;
        this.currentPage = page;
        await this.fetchTechnologies();
      },
    }
  }
</script>
