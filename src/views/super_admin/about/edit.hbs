<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
        previewUrl: null,
        errorMessage: '',
        isValid: true,
        fileName: '',
        fileSize: 0,
        imageWidth: 0,
        imageHeight: 0,
        hasFile: false,
        hasNewFile: false,
        loading: false,
        oldImage: `{{about.image}}`,

        // Form validation states
        formData: {
          title: { id: `{{about.title.id}}`, en: `{{about.title.en}}`, ja: `{{about.title.ja}}` },
          text: { id: `{{about.text.id}}`, en: `{{about.text.en}}`, ja: `{{about.text.ja}}` }
        },
        formErrors: {
          title: { id: '', en: '', ja: '' },
          text: { id: '', en: '', ja: '' }
        },
        formValid: {
          title: { id: true, en: true, ja: true },
          text: { id: true, en: true, ja: true }
        },

        validateImage(file) {
          if (!file) {
            this.hasNewFile = false;
            return;
          }
          
          this.hasNewFile = true;
          this.hasFile = true;
          this.fileName = file.name;
          this.fileSize = file.size;
          this.errorMessage = '';
          this.isValid = true;

          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!allowedTypes.includes(file.type)) {
            this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
            this.isValid = false;
            this.previewUrl = `{{about.image}}`;
            return;
          }

          const maxSize = 5 * 1024 * 1024;
          if (file.size > maxSize) {
            this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 5MB`;
            this.isValid = false;
            this.previewUrl = `{{about.image}}`;
            return;
          }

          const img = new Image();
          const objectUrl = URL.createObjectURL(file);
          
          img.onload = () => {
            this.imageWidth = img.width;
            this.imageHeight = img.height;
            
            if (img.width < 700 || img.width > 4000 || img.height < 700 || img.height > 4000) {
              this.errorMessage = `Image dimensions ${img.width}x${img.height}px. Required: Width 700-4000px, Height 700-4000px`;
              this.isValid = false;
              this.previewUrl = `{{about.image}}`;
              URL.revokeObjectURL(objectUrl);
            } else {
              this.previewUrl = objectUrl;
              this.isValid = true;
              this.errorMessage = '';
            }
          };
          
          img.onerror = () => {
            this.errorMessage = 'Failed to load image';
            this.isValid = false;
            this.previewUrl = `{{about.image}}`;
            URL.revokeObjectURL(objectUrl);
          };
          
          img.src = objectUrl;
        },

        validateField(field, lang, value) {
          this.formData[field][lang] = value;
          
          switch(field) {
            case 'title':
              if (!value.trim()) {
                this.formErrors.title[lang] = 'Title is required';
                this.formValid.title[lang] = false;
              } else if (value.trim().length < 3) {
                this.formErrors.title[lang] = 'Title must be at least 3 characters';
                this.formValid.title[lang] = false;
              } else {
                this.formErrors.title[lang] = '';
                this.formValid.title[lang] = true;
              }
              break;
              
            case 'text':
              if (!value.trim()) {
                this.formErrors.text[lang] = 'Text content is required';
                this.formValid.text[lang] = false;
              } else if (value.trim().length < 10) {
                this.formErrors.text[lang] = 'Text content must be at least 10 characters';
                this.formValid.text[lang] = false;
              } else {
                this.formErrors.text[lang] = '';
                this.formValid.text[lang] = true;
              }
              break;
          }
        },

        clearFile() {
          this.previewUrl = `{{about.image}}`;
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '';
          this.fileSize = 0;
          this.imageWidth = 0;
          this.imageHeight = 0;
          this.hasFile = false;
          this.hasNewFile = false;
          this.$refs.fileInput.value = null;
        },

        canSubmit() {
          const imageValid = !this.hasNewFile || this.isValid;
          const judulValid = Object.values(this.formValid.title).every(v => v);
          const textValid = Object.values(this.formValid.text).every(v => v);
          return imageValid && judulValid && textValid;
        },

        hasFormErrors() {
          return Object.values(this.formErrors.title).some(e => e !== '') || Object.values(this.formErrors.text).some(e => e !== '');
        }
      }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Header</h2>

    <form
      action='/about/{{about.id}}?_method=PATCH'
      method='post'
      enctype='multipart/form-data'
      class='space-y-6'
      @submit.prevent="if (canSubmit()) { loading = true; $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

        {{> super_admin/header/edit/image_input}}
    {{> super_admin/header/edit/title_input}}
    {{> super_admin/header/edit/text_input}}

      <!-- Tombol aksi -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit() || loading'
          class='bg-[#111827] text-white px-6 py-2 rounded-lg shadow transition flex items-center gap-2 hover:bg-gray-700 disabled:opacity-50 disabled:cursor-not-allowed'
        >
          <span
            x-show='loading'
            class='loading loading-spinner loading-sm'
          ></span>
          <span x-show='!loading'>Update</span>
        </button>
        <a
          href='/about'
          :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300 transition'
        >
          Cancel
        </a>
      </div>

      <!-- Submit Warning -->
      <template x-if='hasFormErrors() || (hasNewFile && !isValid)'>
        <div
          class='flex items-center gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
        >
          <i class='fas fa-exclamation-triangle text-red-500'></i>
          <p class='text-sm text-red-800'>
            <span class='font-semibold'>Cannot submit:</span>
            Please fix all validation errors above.
          </p>
        </div>
      </template>
    </form>
  </div>
</div>