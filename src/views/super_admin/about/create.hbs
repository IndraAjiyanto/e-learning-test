{{!--
  Halaman: Create Header (About) — Super Admin
  Lokasi: src/views/super_admin/about/create.hbs
  Level: L4 Page

  Route: GET /about/formCreate -> POST /about (multipart, image wajib)
  Tidak ada frame Figma khusus Create; mengikuti Header/ Edit.
  Toast sukses dirender about/index.hbs dari flash setelah redirect.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>
    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Header'
      }}

      {{> components/ui/super_admin/description/index
        text='Fill in the information below to create a new header.'
      }}
    </div>

    <form
      action='/about'
      method='post'
      enctype='multipart/form-data'
      novalidate
      x-data='headerForm({ requireImage: true })'
      @submit.prevent='submitForm($event)'
      class='flex flex-col gap-5 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:p-5'
    >
      {{> components/ui/super_admin/form/header/fields imageRequired=true }}

      <div class='flex flex-col-reverse gap-3 pt-6 sm:flex-row sm:justify-end'>
        {{> components/ui/super_admin/form/button
          as='link'
          variant='secondary'
          href='/about'
          label='Cancel'
          loading=true
        }}

        {{> components/ui/super_admin/form/button
          type='submit'
          variant='primary'
          label='Create Header'
          loading=true
          disabled='!canSubmit() || loading'
        }}
      </div>
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/header/form }}
