{{!--
  Halaman: Header (About) — Super Admin
  Lokasi: src/views/super_admin/about/index.hbs
  Level: L4 Page

  Data: GET /about → { about }, title & text berbentuk jsonb { id, en, ja }.
  Tanpa search & pagination: header hanya berisi sedikit baris.
  Tombol create hanya muncul di empty state — halaman ini dirancang untuk satu header.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Header'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage header for Kesatria Academy.'
      }}
    </div>

    <div
      class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
      x-data='{ lang: "id", rows: {{json about}} }'
    >
      <div class='flex flex-col gap-5'>

        {{> components/ui/super_admin/tabs/language/index ariaLabel='Header language' }}

        {{#> components/ui/super_admin/table/card tableClass='min-w-[1010px]' hidePagination=true}}
          <colgroup>
            <col class='w-[138px]' />
            <col class='w-[320px]' />
            <col class='w-[436px]' />
            <col class='w-[116px]' />
          </colgroup>
          <thead>
            <tr>
              {{> components/ui/super_admin/table/header_cell label='Image' }}
              {{> components/ui/super_admin/table/header_cell label='Title' }}
              {{> components/ui/super_admin/table/header_cell label='Description' }}
              {{> components/ui/super_admin/table/header_cell label='Action' }}
            </tr>
          </thead>
          <tbody>
            <template x-for='row in rows' :key='row.id'>
              <tr class='transition-colors hover:bg-[#fafafa]'>

                {{#> components/ui/super_admin/table/cell variant='media'}}
                  <div class='h-[52px] w-[90px] overflow-hidden rounded-xl border border-[#e9d7fe] bg-[#f9f5ff]'>
                    <img
                      x-show='row.image'
                      :src='row.image'
                      :alt="(row.title && row.title[lang]) || 'Header image'"
                      class='h-full w-full object-cover'
                    />
                  </div>
                {{/components/ui/super_admin/table/cell}}

                {{#> components/ui/super_admin/table/cell}}
                  <span
                    class='block truncate font-inter text-sm leading-5 text-[#171717]'
                    x-text="(row.title && row.title[lang]) || '—'"
                  ></span>
                {{/components/ui/super_admin/table/cell}}

                {{#> components/ui/super_admin/table/cell}}
                  <span
                    class='block truncate font-inter text-sm leading-5 text-[#525252]'
                    x-text="(row.text && row.text[lang]) || '—'"
                  ></span>
                {{/components/ui/super_admin/table/cell}}

                {{#> components/ui/super_admin/table/cell variant='action'}}
                  {{> components/ui/super_admin/table/row_actions
                    entity='header'
                    deleteAction="'/about/' + row.id + '?_method=DELETE'"
                    editHref="'/about/formEdit/' + row.id"
                  }}
                {{/components/ui/super_admin/table/cell}}
              </tr>
            </template>

            {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='4'}}
              <span class='flex flex-col items-center gap-3'>
                No header found.
                <a
                  href='/about/formCreate'
                  class='inline-flex h-11 items-center justify-center rounded-lg border border-[#003060] bg-[#003060] px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#00254a] hover:bg-[#00254a] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 focus-visible:ring-offset-2 active:bg-[#001c39]'
                >Create Header</a>
              </span>
            {{/components/ui/super_admin/table/message_row}}
          </tbody>
        {{/components/ui/super_admin/table/card}}
      </div>
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Header?'
  description='Are you sure you want to delete this header? This action will permanently remove its image, title and description in all languages and cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}
