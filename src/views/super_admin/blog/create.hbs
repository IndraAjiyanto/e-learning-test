<div class='max-w-7xl mx-auto px-6 py-10'>

  <h2 class='text-2xl font-semibold mb-6 text-gray-900 text-center'>
    Create New Blog Post
  </h2>

  <form
    method='POST'
    action='/blog'
    enctype='multipart/form-data'
    class='space-y-6'
    x-data='{ loading: false }'
    @submit='loading = true'
  >

    <div class='flex flex-col lg:flex-row gap-8 lg:gap-12'>

      <div class='lg:w-2/3'>
      {{> super_admin/blog/create/left_content/image_input }}


{{> super_admin/blog/create/left_content/text_editor_input }}

      </div>


      <div class='space-y-6 lg:w-1/3'>

{{> super_admin/blog/create/right_content/title_input }}

{{> super_admin/blog/create/right_content/description_input }}

{{> super_admin/blog/create/right_content/category_input }}

{{> super_admin/blog/create/right_content/author_input }}

{{> super_admin/blog/create/right_content/topic_input }}

{{> super_admin/blog/create/right_content/keyword_input }}

{{> super_admin/blog/create/right_content/tag_input }}

      </div>
    </div>

    <div class='flex gap-2'>
      <button
        type='submit'
        :disabled='loading'
        class='py-2 px-4 bg-gray-900 text-white font-semibold rounded-lg shadow hover:bg-gray-600 transition'
      >
        <span
          x-show='loading'
          class='loading loading-spinner loading-sm'
        ></span>
        <span x-show='!loading'>Create</span>
      </button>
      <a
        href='/blog'
        :disabled='loading'
        :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
        class='px-6 py-2 rounded-lg border border-gray-300 transition'
      >
        Cancel
      </a>
    </div>
  </form>
</div>

<style>
  .codex-editor .ce-block__content,
  .codex-editor .ce-toolbar__content {
    max-width: 100% !important;
    margin-left: 16px !important;
    margin-right: auto !important;
  }

  .codex-editor__redactor {
    padding-left: 0 !important;
  }

  #editor img {
    max-width: 300px;
    margin: auto;
    border-radius: 1rem;
  }

  #editor h4 {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 600;
  }

  #editor h5 {
    margin-bottom: 0.5rem;
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 500;
  }

  #editor h6 {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
  }
</style>