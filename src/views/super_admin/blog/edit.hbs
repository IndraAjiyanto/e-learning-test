<div class='py-10'>
  <div class='max-w-4xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900 text-center'>Edit Blog Post</h2>

    <form method='POST' action='/blog/{{blog.id}}?_method=PATCH' enctype='multipart/form-data' class="space-y-6">
      <div class='grid grid-cols-1 lg:grid-cols-2 gap-8'>

        <!-- Kolom Kiri -->
        <div class='space-y-6'>
          <!-- Author -->
          <div>
            <label for='author' class='block text-sm font-medium text-gray-700 mb-2'>Author</label>
            <input
              type='text'
              id='author'
              name='author'
              required
              value="{{blog.author}}"
              placeholder='Enter author name'
              class='w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-900 bg-white'
            />
          </div>

          <!-- Title -->
          <div>
            <label for='judul' class='text-sm font-medium text-gray-700 mb-2'>Blog Title</label>
            <input
              type='text'
              id='judul'
              name='judul'
              required
              value="{{blog.judul}}"
              placeholder='Enter blog title'
              class='w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-900 bg-white'
            />
          </div>

          <!-- Category -->
          <div
            x-data="{
              search: '{{blog.kategori_blog.nama}}',
              selectedCategory: {{json blog.kategori_blog}},
              showDropdown: false,
              availableCategories: {{json categories}},
              get filteredCategories() {
                return this.availableCategories.filter(c => 
                  c.nama.toLowerCase().includes(this.search.toLowerCase())
                );
              },
              selectCategory(category) {
                this.selectedCategory = category;
                this.search = category.nama;
                this.showDropdown = false;
              },
              clearCategory() {
                this.selectedCategory = null;
                this.search = '';
              }
            }"
            @click.away='showDropdown = false'
          >
            <label for='kategori_blog' class='block text-sm font-medium text-gray-700 mb-2'>Category</label>

            <div class='relative'>
              <input
                type='text'
                x-model='search'
                @focus='showDropdown = true'
                @input='showDropdown = true'
                placeholder='Search and select category...'
                class='w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-900 bg-white pr-10'
              />
              <i class='fas fa-search absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400'></i>

              <!-- Dropdown -->
              <div
                x-show='showDropdown && filteredCategories.length > 0'
                class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'
              >
                <template x-for='category in filteredCategories' :key='category.id'>
                  <button
                    type='button'
                    @click='selectCategory(category)'
                    class='w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition text-left border-b border-gray-100 last:border-0'
                    :class="{'bg-gray-100': selectedCategory && selectedCategory.id === category.id}"
                  >
                    <span class='text-sm font-medium text-gray-700' x-text='category.nama'></span>
                    <span x-show='selectedCategory && selectedCategory.id === category.id' class='ml-auto text-blue-500'>
                      <i class='fas fa-check'></i>
                    </span>
                  </button>
                </template>
              </div>

              <input
                type='hidden'
                id='kategori_blog'
                name='kategori_blog'
                x-model='selectedCategory ? selectedCategory.id : ""'
                required
              />
            </div>
          </div>

          <!-- Topic -->
          <div
            x-data="{
              search: '{{blog.topic.nama}}',
              selectedTopic: {{json blog.topics}},
              showDropdown: false,
              availableTopics: {{json topics}},
              get filteredTopics() {
                return this.availableTopics.filter(c => 
                  c.nama.toLowerCase().includes(this.search.toLowerCase())
                );
              },
              selectTopic(topic) {
                this.selectedTopic = topic;
                this.search = topic.nama;
                this.showDropdown = false;
              },
              clearTopic() {
                this.selectedTopic = null;
                this.search = '';
              }
            }"
            @click.away='showDropdown = false'
          >
            <label for='topic' class='block text-sm font-medium text-gray-700 mb-2'>Topic</label>

            <div class='relative'>
              <input
                type='text'
                x-model='search'
                @focus='showDropdown = true'
                @input='showDropdown = true'
                placeholder='Search and select topic...'
                class='w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-900 bg-white pr-10'
              />
              <i class='fas fa-search absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400'></i>

              <!-- Dropdown -->
              <div
                x-show='showDropdown && filteredTopics.length > 0'
                class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'
              >
                <template x-for='topic in filteredTopics' :key='topic.id'>
                  <button
                    type='button'
                    @click='selectTopic(topic)'
                    class='w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition text-left border-b border-gray-100 last:border-0'
                    :class="{'bg-gray-100': selectedTopic && selectedTopic.id === topic.id}"
                  >
                    <span class='text-sm font-medium text-gray-700' x-text='topic.nama'></span>
                    <span x-show='selectedTopic && selectedTopic.id === topic.id' class='ml-auto text-blue-500'>
                      <i class='fas fa-check'></i>
                    </span>
                  </button>
                </template>
              </div>

              <input
                type='hidden'
                id='topic'
                name='topic'
                x-model='selectedTopic ? selectedTopic.id : ""'
                required
              />
            </div>
          </div>

          <!-- Content -->
          <div>
            <label for='isi' class='text-sm font-medium text-gray-700 mb-2'>Content</label>
            <textarea
              name='isi'
              id='isi'
              required
              placeholder='Write your blog content here...'
              rows='10'
              class='w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-900 bg-white'
            >{{blog.isi}}</textarea>
          </div>
        </div>

        <!-- Kolom Kanan -->
        <div class='space-y-6'>
          <!-- Current Images -->
          {{#if blog.gambar}}
          <div>
            <label class='text-sm font-medium text-gray-700 mb-2'>Current Images</label>
            <div class='grid grid-cols-2 gap-4 mb-6'>
              {{#if (isArray blog.gambar)}}
                {{#each blog.gambar}}
                <div class='relative group'>
                  <div class='p-4 bg-slate-50 rounded-xl border border-slate-200'>
                    <img
                      src='{{this}}'
                      alt='Current Image {{@index}}'
                      class='w-full h-48 object-cover rounded-lg border-2 border-blue-500 shadow-sm'
                    />
                  </div>
                  <button
                    type='button'
                    onclick="removeExistingImage('{{this}}')"
                    class='absolute -top-2 -right-2 bg-red-500 text-white w-8 h-8 rounded-full flex items-center justify-center shadow-lg hover:bg-red-600 transition-all duration-300 transform hover:scale-110'
                  >
                    <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M6 18L18 6M6 6l12 12' />
                    </svg>
                  </button>
                  <input type='hidden' name='existing_images[]' value='{{this}}' id='existing-{{@index}}'>
                </div>
                {{/each}}
              {{else}}
                <div class='relative group'>
                  <div class='p-4 bg-slate-50 rounded-xl border border-slate-200'>
                    <img
                      src='{{blog.gambar}}'
                      alt='Current Image'
                      class='w-full h-48 object-cover rounded-lg border-2 border-blue-500 shadow-sm'
                    />
                  </div>
                  <button
                    type='button'
                    onclick="removeExistingImage('{{blog.gambar}}')"
                    class='absolute -top-2 -right-2 bg-red-500 text-white w-8 h-8 rounded-full flex items-center justify-center shadow-lg hover:bg-red-600 transition-all duration-300 transform hover:scale-110'
                  >
                    <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M6 18L18 6M6 6l12 12' />
                    </svg>
                  </button>
                  <input type='hidden' name='existing_images[]' value='{{blog.gambar}}' id='existing-0'>
                </div>
              {{/if}}
            </div>
            <input type='hidden' id='removed_images' name='removed_images' value=''>
          </div>
          {{/if}}

          <!-- Upload New Images -->
          <div x-data='{ 
            files: [], 
            validateFile(file) {
              const allowedTypes = ["image/jpeg", "image/jpg", "image/png", "image/gif", "image/webp"];
              return allowedTypes.includes(file.type);
            }
          }' class='space-y-4'>
            <label class='text-sm font-medium text-gray-700 mb-2'>
              {{#if blog.gambar}}Upload Additional Images{{else}}Upload Images{{/if}}
            </label>

            <template x-for='(file, index) in files' :key='index'>
              <div class='space-y-4'>
                <div class='flex items-center gap-4'>
                  <div class='flex-1'>
                    <input
                      type='file'
                      name='gambar'
                      accept='image/jpeg,image/jpg,image/png,image/gif,image/webp'
                      @change='if ($event.target.files[0]) { 
                        if (validateFile($event.target.files[0])) {
                          file.preview = URL.createObjectURL($event.target.files[0]);
                        } else {
                          alert("Only image files (JPEG, JPG, PNG, GIF, WEBP) are allowed");
                          $event.target.value = "";
                        }
                      }'
                      class='w-full border border-slate-300 rounded-xl px-5 py-4 bg-white/70 hover:bg-white focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-400 transition-all duration-300 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200'
                    />
                  </div>

                  <button
                    type='button'
                    @click='files.splice(index, 1)'
                    class='w-12 h-12 bg-red-500 hover:bg-red-600 text-white rounded-xl flex items-center justify-center transition-all duration-300 transform hover:scale-105 shadow-lg'
                  >
                    <svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M6 18L18 6M6 6l12 12'></path>
                    </svg>
                  </button>
                </div>

                <!-- Image Preview -->
                <template x-if='file.preview'>
                  <div class='relative'>
                    <div class='p-4 bg-slate-50 rounded-xl border border-slate-200'>
                      <img
                        :src='file.preview'
                        alt='Image Preview'
                        class='w-full max-w-xs h-48 object-cover rounded-lg border-2 border-slate-300 shadow-sm mx-auto'
                      />
                      <button
                        type='button'
                        class='absolute -top-2 -right-2 bg-red-500 text-white w-8 h-8 rounded-full flex items-center justify-center shadow-lg hover:bg-red-600 transition-all duration-300 transform hover:scale-110'
                        @click='file.preview = null'
                      >
                        <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M6 18L18 6M6 6l12 12' />
                        </svg>
                      </button>
                    </div>
                  </div>
                </template>
              </div>
            </template>

            <button
              type='button'
              @click='files.push({ preview: null })'
              class='w-full border-2 border-dashed border-slate-300 rounded-xl px-6 py-4 text-slate-500 hover:border-slate-400 hover:text-slate-600 hover:bg-slate-50 flex items-center justify-center gap-2 transition-all duration-300 group'
            >
              <svg
                class='w-5 h-5 group-hover:scale-110 transition-transform duration-200'
                fill='none'
                stroke='currentColor'
                viewBox='0 0 24 24'
              >
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 6v6m0 0v6m0-6h6m-6 0H6'></path>
              </svg>
              {{#if blog.gambar}}Add Additional Image{{else}}Add Image{{/if}}
            </button>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class='flex gap-2'>
        <button
          type='submit'
          class='py-2 px-4 bg-gray-900 text-white font-semibold rounded-lg shadow hover:bg-gray-600 transition'
        >
          Update
        </button>
        <a
          href='/blog'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition items-center'
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>

<script>
// Function to remove existing images
let removedImages = [];
function removeExistingImage(imageUrl) {
  if (confirm('Are you sure you want to remove this image?')) {
    // Add to removed images array
    removedImages.push(imageUrl);
    
    // Update hidden input with JSON string
    document.getElementById('removed_images').value = JSON.stringify(removedImages);
    
    // Hide the image container
    const imgContainer = event.target.closest('.group');
    if (imgContainer) {
      imgContainer.style.display = 'none';
    }
  }
}

// Form validation to ensure at least one image
document.addEventListener('DOMContentLoaded', function() {
  const form = document.querySelector('form');
  
  form.addEventListener('submit', function(e) {
    // Check if there are any existing images that haven't been removed
    const existingImagesInputs = document.querySelectorAll('input[name="existing_images[]"]');
    let hasExistingImages = false;
    
    existingImagesInputs.forEach(input => {
      if (input.closest('.group') && input.closest('.group').style.display !== 'none') {
        hasExistingImages = true;
      }
    });
    
    // Check if there are any new images
    const fileInputs = document.querySelectorAll('input[type="file"][name="gambar"]');
    let hasNewImages = false;
    
    fileInputs.forEach(input => {
      if (input.files && input.files.length > 0 && input.files[0].size > 0) {
        hasNewImages = true;
      }
    });
    
    // If no images at all, prevent submission
    if (!hasExistingImages && !hasNewImages) {
      e.preventDefault();
      alert('At least one image is required for the blog post.');
      return false;
    }
    
    return true;
  });
});
</script>