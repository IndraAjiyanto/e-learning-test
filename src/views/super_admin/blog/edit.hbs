<div class='max-w-7xl mx-auto px-6 py-10'>
  <h2 class='text-2xl font-semibold mb-6 text-gray-900 text-center'>
    Edit Blog Post
  </h2>

  <form method='POST' action='/blog/{{blog.id}}?_method=PATCH' x-data="{ loading: false }"
  @submit="loading = true" enctype='multipart/form-data' class='space-y-6'>
    <!-- Menambahkan method spoofing untuk PUT/PATCH -->

    <div class='flex flex-col lg:flex-row gap-8 lg:gap-12'>
      <!-- Bagian Kiri: Editor -->
      <div class='lg:w-2/3'>
        <!-- Upload Images Section with Split Concept -->
        <div class="space-y-6">
          <!-- Existing Images Section -->
          <div x-data="{ existingImages: {{#if blog.gambar}}{{json blog.gambar}}{{else}}[]{{/if}} }" class="space-y-4">
            <label class="block text-lg font-semibold text-gray-700 mb-3">
              Current Images
            </label>
            
            <template x-for="(url, index) in existingImages" :key="'existing-' + index">
              <div class="space-y-4">
                <div class="flex items-center gap-4">
                  <div class="flex-1">
                    <div class="w-full border border-slate-300 rounded-xl px-5 py-4 bg-white/70 text-gray-700 flex items-center justify-between">
                      <div class="flex items-center gap-3">
                        <div class="relative">
                          <img :src="url" class="w-12 h-12 object-cover rounded-lg border-2 border-slate-200 shadow-sm" />
                          <div class="absolute -top-1 -right-1 w-4 h-4 bg-green-500 rounded-full flex items-center justify-center">
                            <svg class="w-2 h-2 text-white" fill="currentColor" viewBox="0 0 20 20">
                              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                            </svg>
                          </div>
                        </div>
                        <span class="text-sm font-medium text-slate-700">Existing Image</span>
                      </div>
                      <span class="text-xs text-slate-500 bg-slate-100 px-2 py-1 rounded">Saved</span>
                    </div>
                  </div>
                  <input type="hidden" name="gambar[]" :value="url">
                  <button type="button" @click="existingImages.splice(index, 1)" 
                  class="w-12 h-12 bg-red-500 hover:bg-red-600 text-white rounded-xl flex items-center justify-center transition-all duration-300 transform hover:scale-105 shadow-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </template>
          </div>

          <!-- Upload New Images Section -->
          <div x-data="{ newFiles: [] }" class="space-y-4">
            <label class="block text-lg font-semibold text-gray-700 mb-3">
              Add New Images
            </label>
            <p class="text-xs text-slate-500 mb-3">You can upload multiple new images</p>
            
            <template x-for="(file, index) in newFiles" :key="index">
              <div class="space-y-4">
                <div class="flex items-center gap-4">
                  <div class="flex-1">
                    <input 
                      type="file" 
                      :name="'gambar'"
                      accept="image/jpeg,image/jpg,image/png"
                      @change="
                        file.error = '';
                        const selectedFile = $event.target.files[0];
                        if (selectedFile) {
                          // Validasi tipe file
                          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
                          if (!allowedTypes.includes(selectedFile.type)) {
                            file.error = 'Only JPG, JPEG, and PNG images are allowed!';
                            $event.target.value = null;
                            file.preview = null;
                            return;
                          }
                          
                          // Validasi ukuran file (max 3MB)
                          const maxSize = 3 * 1024 * 1024; // 3MB
                          if (selectedFile.size > maxSize) {
                            file.error = 'File size must not exceed 3MB!';
                            $event.target.value = null;
                            file.preview = null;
                            return;
                          }
                          
                          // Set preview jika valid
                          file.preview = URL.createObjectURL(selectedFile);
                        } else {
                          file.preview = null;
                        }
                      "
                      class="w-full border border-slate-300 rounded-xl px-5 py-4 bg-white/70 hover:bg-white focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-400 transition-all duration-300 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200">
                  </div>

                  <button type="button" @click="newFiles.splice(index, 1)"
                    class="w-12 h-12 bg-red-500 hover:bg-red-600 text-white rounded-xl flex items-center justify-center transition-all duration-300 transform hover:scale-105 shadow-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </button>
                </div>

                <!-- Error Message -->
                <template x-if="file.error">
                  <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-sm font-medium" x-text="file.error"></span>
                  </div>
                </template>

                <!-- Image Preview -->
                <template x-if="file.preview">
                  <div class="relative">
                    <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
                      <img 
                        :src="file.preview" 
                        alt="Image Preview" 
                        class="w-full max-w-xs h-48 object-cover rounded-lg border-2 border-slate-300 shadow-sm mx-auto"
                        @error="file.preview = null"
                      >
                      <button 
                        type="button" 
                        class="absolute -top-2 -right-2 bg-red-500 text-white w-8 h-8 rounded-full flex items-center justify-center shadow-lg hover:bg-red-600 transition-all duration-300 transform hover:scale-110"
                        @click="file.preview = null; $el.closest('.space-y-4').querySelector('input[type=file]').value = ''">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                      </button>
                    </div>
                  </div>
                </template>
              </div>
            </template>

            <!-- Add New Image Button -->
            <button type="button" @click="newFiles.push({ preview: null, error: '' })"
              class="w-full border-2 border-dashed border-slate-300 rounded-xl px-6 py-4 text-slate-500 hover:border-slate-400 hover:text-slate-600 hover:bg-slate-50 flex items-center justify-center gap-2 transition-all duration-300 group">
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
              Add New Image
            </button>

            <!-- Image Requirements Info -->
            <div class='mt-4 p-3 bg-blue-50 rounded-lg border border-blue-200'>
              <p class='text-xs text-blue-800 font-medium mb-1'>Image Requirements:</p>
              <ul class='text-xs text-blue-700 space-y-1'>
                <li class='flex items-center'>
                  <svg class='w-3 h-3 mr-1 text-blue-600' fill='currentColor' viewBox='0 0 20 20'>
                    <path fill-rule='evenodd' d='M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z' clip-rule='evenodd' />
                  </svg>
                  Formats: JPEG, JPG, PNG only
                </li>
                <li class='flex items-center'>
                  <svg class='w-3 h-3 mr-1 text-blue-600' fill='currentColor' viewBox='0 0 20 20'>
                    <path fill-rule='evenodd' d='M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z' clip-rule='evenodd' />
                  </svg>
                  Maximum size: 3MB
                </li>
                <li class='flex items-center'>
                  <svg class='w-3 h-3 mr-1 text-blue-600' fill='currentColor' viewBox='0 0 20 20'>
                    <path fill-rule='evenodd' d='M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z' clip-rule='evenodd' />
                  </svg>
                  Dimensions: 800×400 to 1920×1080 pixels
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Editor Section -->
        <label for="isi" class="mb-2 block font-medium text-gray-700 mt-6">Content</label>
        <div id="editor" class="text-left text-black max-w-none min-h-[500px] border border-gray-300 rounded-md bg-white p-4"></div>
        <input type="hidden" name="isi" id="isi">
      </div>

      <!-- Bagian Kanan: Form Fields (sama seperti sebelumnya) -->
      <div class='space-y-6 lg:w-1/3'>
        <!-- Blog Title -->
        <div>
          <label for='judul' class='block text-sm font-medium text-gray-700 mb-2'>Blog Title</label>
          <input
            type='text'
            id='judul'
            name='judul'
            required
            value="{{blog.judul}}"
            placeholder='Enter blog title'
            class='w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-900 bg-white'
          />
        </div>

        <!-- Category -->
        <div x-data="{
          search: '{{blog.kategori_blog.nama}}',
          selectedCategory: {{json blog.kategori_blog}},
          showDropdown: false,
          availableCategories: {{json categories}},
          get filteredCategories() {
            return this.availableCategories.filter(c =>
              c.nama.toLowerCase().includes(this.search.toLowerCase())
            );
          },
          selectCategory(category) {
            this.selectedCategory = category;
            this.search = category.nama;
            this.showDropdown = false;
            $dispatch('category-selected', { category });
          },
          clearCategory() {
            this.selectedCategory = null;
            this.search = '';
            $dispatch('category-selected', { category: null });
          }
        }" @click.away='showDropdown = false'>
          <label for='kategori_blog' class='block text-sm font-medium text-gray-700 mb-2'>Category</label>
          <div class='relative'>
            <input
              type='text'
              x-model='search'
              @focus='showDropdown = true'
              @input='showDropdown = true'
              placeholder='Search and select category...'
              class='w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-900 bg-white pr-10'
            />
            <i class='fas fa-search absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400'></i>

            <div x-show='showDropdown && filteredCategories.length > 0'
                 class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'>
              <template x-for='category in filteredCategories' :key='category.id'>
                <button type='button' @click='selectCategory(category)'
                        class='w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition text-left border-b border-gray-100 last:border-0'>
                  <span class='text-sm font-medium text-gray-700' x-text='category.nama'></span>
                </button>
              </template>
            </div>

            <input type='hidden' id='kategori_blog' name='kategori_blog' x-model='selectedCategory ? selectedCategory.id : ""' required />
          </div>
        </div>

        <!-- Author -->
        <div>
          <label for='author' class='block text-sm font-medium text-gray-700 mb-2'>Author</label>
          <input
            type='text'
            id='author'
            name='author'
            required
            value="{{blog.author}}"
            placeholder='Enter author name'
            class='w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-900 bg-white'
          />
        </div>

        <!-- Topic -->
        <div x-data="{
          search: '{{blog.topic.nama}}',
          selectedTopic: {{json blog.topic}},
          showDropdown: false,
          availableTopics: {{json topics}},
          get filteredTopics() {
            return this.availableTopics.filter(c =>
              c.nama.toLowerCase().includes(this.search.toLowerCase())
            );
          },
          selectTopic(topic) {
            this.selectedTopic = topic;
            this.search = topic.nama;
            this.showDropdown = false;
            $dispatch('topic-selected', { topic });
          },
          clearTopic() {
            this.selectedTopic = null;
            this.search = '';
            $dispatch('topic-selected', { topic: null });
          }
        }" @click.away='showDropdown = false'>
          <label for='topic' class='block text-sm font-medium text-gray-700 mb-2'>Topic</label>
          <div class='relative'>
            <input
              type='text'
              x-model='search'
              @focus='showDropdown = true'
              @input='showDropdown = true'
              placeholder='Search and select topic...'
              class='w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-900 bg-white pr-10'
            />
            <i class='fas fa-search absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400'></i>

            <div x-show='showDropdown && filteredTopics.length > 0'
                 class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'>
              <template x-for='topic in filteredTopics' :key='topic.id'>
                <button type='button' @click='selectTopic(topic)'
                        class='w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition text-left border-b border-gray-100 last:border-0'>
                  <span class='text-sm font-medium text-gray-700' x-text='topic.nama'></span>
                </button>
              </template>
            </div>

            <input type='hidden' id='topic' name='topic' x-model='selectedTopic ? selectedTopic.id : ""' required />
          </div>
        </div>

        <!-- Keyword -->
        <div>
          <label for='keyword' class='block text-sm font-medium text-gray-700 mb-2'>Keyword</label>
          <input
            type='text'
            id='keyword'
            name='keyword'
            required
            value="{{blog.keyword}}"
            placeholder='Enter keyword name'
            class='w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-900 bg-white'
          />
        </div>

        <!-- Tags -->
        <div>
          <label class='block text-sm font-semibold text-gray-700 mb-2'>Tags</label>
          <div x-data="tagInput('{{json blog.tags}}')">
            <template x-for="(tag, index) in tags" :key="index">
              <div class="flex items-center gap-3 mb-3">
                <input
                  type="text"
                  x-model="tags[index]"
                  @input="format(index)"
                  name="tags[]"
                  placeholder="Enter a tag"
                  class="flex-1 border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700"
                />

                <button
                  type="button"
                  @click="tags.splice(index,1)"
                  x-show="tags.length > 1"
                  class="text-red-500 hover:text-red-700 font-bold text-lg w-8 h-8 flex items-center justify-center"
                >
                  ✕
                </button>
              </div>
            </template>

            <button
              type="button"
              @click="tags.push('#')"
              class="w-full border-2 border-dashed border-gray-300 rounded-lg px-4 py-2 text-gray-500 hover:border-gray-500 hover:text-gray-700 flex items-center justify-center transition"
            >
              + Add Tag
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Form Actions -->
    <div class='flex gap-2'>
      <button type='submit' :disabled='loading' class='py-2 px-4 bg-gray-900 text-white font-semibold rounded-lg shadow hover:bg-gray-600 transition'>
        <span x-show="loading" class="loading loading-spinner loading-sm"></span>
        <span x-show="!loading">Update</span>
      </button>
      <a href='/blog' class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition'>
        Cancel
      </a>
    </div>
  </form>
</div>

<style>
.codex-editor .ce-block__content,
.codex-editor .ce-toolbar__content {
  max-width: 100% !important;
  margin-left: 16px!important;
  margin-right: auto !important;
}

.codex-editor__redactor {
  padding-left: 0 !important;
}

#editor img {
  max-width: 300px;
  margin: auto;
  border-radius: 1rem;
}

#editor h4 {
  margin-bottom: 0.5rem;
  font-size: 1.125rem;
  line-height: 1.75rem;
  font-weight: 600;
}

#editor h5 {
  margin-bottom: 0.5rem;
  font-size: 1rem;
  line-height: 1.5rem;
  font-weight: 500;
}

#editor h6 {
  margin-bottom: 0.5rem;
  font-size: 0.875rem;
  line-height: 1.25rem;
  font-weight: 500;
}
</style>

<script>
// Tag Input Function dengan initial data
function tagInput(initialTags = '[]') {
  return {
    prefix: "#",
    tags: JSON.parse(initialTags).length > 0 ? JSON.parse(initialTags) : ["#"],

    format(index) {
      let val = this.tags[index];
      if (!val.startsWith(this.prefix)) {
        this.tags[index] = this.prefix + val.replace(this.prefix, "");
      }
    }
  }
}

// EditorJS Initialization dengan existing content
document.addEventListener('DOMContentLoaded', async () => {
  // Parse existing content jika ada
    const editorData = JSON.parse(`{{{blog.isi_editorjs}}}`);

  
  const editor = new EditorJS({
    holder: 'editor',
    placeholder: 'enter your content here...',
    data: editorData || {}, // Load existing content jika ada
    tools: {
      header: {
        class: EditorTools.Header,
        inlineToolbar: ['link']
      },
      paragraph: {
        class: EditorTools.Paragraph,
        inlineToolbar: true,
      },
      list: {
        class: EditorTools.List,
        inlineToolbar: true
      },
      marker: {
        class: EditorTools.Marker,
        shortcut: 'CMD+SHIFT+M'
      },
      image: {
        class: EditorTools.ImageTool,
        tunes: {
          "stretched": false,
          "withBorder": false,
          "withBackground": false
        },
        config: {
          endpoints: {
            byFile: '/blog/upload-image',
            byUrl: '/blog/fetch-image'
          }
        }
      },
      linkTool: {
        class: EditorTools.LinkTool,
        config: { endpoint: '/blog/fetch-link' }
      }
    }
  });

  const form = document.querySelector('form');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const output = await editor.save();
    document.getElementById('isi').value = JSON.stringify(output);
    form.submit();
  });
});
</script>

