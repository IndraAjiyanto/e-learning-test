<div
  class='py-10'
  x-data='{ 
    bulan: `{{cicilan.bulan}}`, 
    hargaValues: {{json cicilan.harga}}, 
    hargaDisplays: [], 
    dpValue: `{{cicilan.dp}}`, 
    dpDisplay: "",

    // Form validation states
    formData: {
      bulan: `{{cicilan.bulan}}`,
      dp: `{{cicilan.dp}}`,
      harga: {{json cicilan.harga}}
    },
    formErrors: {
      bulan: "",
      dp: "",
      harga: []
    },
    formValid: {
      bulan: false,
      dp: false,
      harga: []
    },

    validateField(field, value, index = null) {
      if (field === "harga") {
        this.formData.harga[index] = value;
        const numValue = parseInt(value);
        if (!value || isNaN(numValue)) {
          this.formErrors.harga[index] = "Valid payment amount required";
          this.formValid.harga[index] = false;
        } else {
          this.formErrors.harga[index] = "";
          this.formValid.harga[index] = true;
        }
      } else {
        this.formData[field] = value;
        
        switch(field) {
          case "bulan":
            if (!value) {
              this.formErrors.bulan = "Installment period is required";
              this.formValid.bulan = false;
            } else {
              this.formErrors.bulan = "";
              this.formValid.bulan = true;
            }
            break;
            
          case "dp":
            const dpNumValue = parseInt(value);
            if (!value || isNaN(dpNumValue) || dpNumValue <= 0) {
              this.formErrors.dp = "Valid down payment amount required";
              this.formValid.dp = false;
            } else {
              this.formErrors.dp = "";
              this.formValid.dp = true;
            }
            break;
        }
      }
    },

    get canSubmit() {
      const bulanCount = parseInt(this.bulan);
      const allHargaValid = Array.from({length: bulanCount}, (_, i) => this.formValid.harga[i] || false).every(valid => valid);
      return this.formValid.bulan && this.formValid.dp && allHargaValid;
    },

    hasFormErrors() {
      return Object.values(this.formErrors).some(error => error !== "" || (Array.isArray(error) && error.some(e => e !== "")));
    },

    handleSubmit() {
      if (!this.canSubmit) {
        return false;
      }
      return true;
    },

    formatNumber(event, index = null) { 
      let angka = event.target.value.replace(/\D/g, ""); 
      if (index !== null) { 
        this.hargaValues[index] = angka; 
        this.hargaDisplays[index] = new Intl.NumberFormat("id-ID").format(angka);
        this.validateField("harga", angka, index);
      } else { 
        this.dpValue = angka; 
        this.dpDisplay = new Intl.NumberFormat("id-ID").format(angka);
        this.validateField("dp", angka);
      } 
    }
  }'
  x-init="hargaDisplays = hargaValues.map(h => new Intl.NumberFormat('id-ID').format(h)); dpDisplay = new Intl.NumberFormat('id-ID').format(dpValue); formValid.harga = Array(parseInt(bulan)).fill(true); formErrors.harga = Array(parseInt(bulan)).fill('')"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Edit Installment</h2>

    <form
      action='/cicilan/{{cicilan.id}}?_method=PATCH'
      method='POST'
      x-data="{ loading: false }"
      @submit='handleSubmit(); loading = true'
      class='space-y-6'
    >

    {{> super_admin/installment/edit/month_input }}

{{> super_admin/installment/edit/price_input }}

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='loading'
          class='text-white px-6 py-2 rounded-lg shadow transition bg-gray-900 hover:bg-gray-600'
        >
        <span x-show="loading" class="loading loading-spinner loading-sm"></span>
        <span x-show="!loading">Update</span>
        </button>
        <a
          href='/kelass/detail/kelas/admin/{{cicilan.kelas.id}}'
        :disabled='loading'
        :class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300  transition'>
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>