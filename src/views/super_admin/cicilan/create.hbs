<div
  class='py-10'
  x-data="{ bulan: 3, hargaDisplays: Array(3).fill(''), hargaValues: Array(3).fill(''), dpDisplay: '', dpValue: '', formatNumber(event, index = null) { let angka = event.target.value.replace(/\D/g, ''); if (index !== null) { this.hargaValues[index] = angka; this.hargaDisplays[index] = new Intl.NumberFormat('id-ID').format(angka); } else { this.dpValue = angka; this.dpDisplay = new Intl.NumberFormat('id-ID').format(angka); } } }"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create New Cicilan</h2>

    <form action='/cicilan/{{kelasId}}' method='POST' class='space-y-6'>

      <!-- Pilih Bulan -->
      <div>
        <label
          for='bulan'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Installment Period
        </label>
        <select
          id='bulan'
          name='bulan'
          x-model='bulan'
          @change="hargaDisplays = Array(parseInt(bulan)).fill(''); hargaValues = Array(parseInt(bulan)).fill('')"
          required
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        >
          <option value='3'>3 Months</option>
          <option value='6'>6 Months</option>
          <option value='12'>12 Months</option>
        </select>
      </div>

      <!-- Input Harga Per Bulan -->
      <div>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Monthly Payment Amounts
        </label>
        <!-- Down Payment (DP) -->
        <div class='mb-4'>
          <label
            for='dp'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >
            Down Payment (DP)
          </label>
          <input
            type='text'
            id='dp'
            x-model='dpDisplay'
            @input='formatNumber($event)'
            placeholder='Enter down payment amount'
            required
            class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
          />
          <input type='hidden' name='dp' x-model='dpValue' />
        </div>
        <div class='space-y-2'>
          <template x-for='(price, index) in parseInt(bulan)' :key='index'>
            <div class='flex items-center gap-3'>
              <span
                class='text-sm text-gray-600 w-20'
                x-text="'Month ' + (index + 1)"
              ></span>
              <input
                type='text'
                x-model='hargaDisplays[index]'
                @input='formatNumber($event, index)'
                placeholder='Enter amount'
                required
                class='flex-1 border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
              />
              <input
                type='hidden'
                name='harga[]'
                x-model='hargaValues[index]'
              />
            </div>
          </template>
        </div>
      </div>

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          class='bg-gray-900 text-white px-6 py-2 rounded-lg shadow hover:bg-gray-600 transition'
        >
          Create
        </button>
        <a
          href='/kelass/detail/kelas/admin/{{kelasId}}'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition'
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>