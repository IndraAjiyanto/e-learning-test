<div
  class='py-10'
  x-data="{ 
    bulan: 3, 
    hargaDisplays: Array(3).fill(''), 
    hargaValues: Array(3).fill(''), 
    dpDisplay: '', 
    dpValue: '',

    // Form validation states
    formData: {
      bulan: '3',
      dp: '',
      harga: []
    },
    formErrors: {
      bulan: '',
      dp: '',
      harga: []
    },
    formValid: {
      bulan: false,
      dp: false,
      harga: []
    },

    validateField(field, value, index = null) {
      if (field === 'harga') {
        this.formData.harga[index] = value;
        const numValue = parseInt(value);
        if (!value || isNaN(numValue) || numValue <= 0) {
          this.formErrors.harga[index] = 'Valid payment amount required';
          this.formValid.harga[index] = false;
        } else {
          this.formErrors.harga[index] = '';
          this.formValid.harga[index] = true;
        }
      } else {
        this.formData[field] = value;
        
        switch(field) {
          case 'bulan':
            if (!value) {
              this.formErrors.bulan = 'Installment period is required';
              this.formValid.bulan = false;
            } else {
              this.formErrors.bulan = '';
              this.formValid.bulan = true;
            }
            break;
            
          case 'dp':
            const dpNumValue = parseInt(value);
            if (!value || isNaN(dpNumValue) || dpNumValue <= 0) {
              this.formErrors.dp = 'Valid down payment amount required';
              this.formValid.dp = false;
            } else {
              this.formErrors.dp = '';
              this.formValid.dp = true;
            }
            break;
        }
      }
    },

    canSubmit() {
      const bulanCount = parseInt(this.bulan);
      const allHargaValid = Array.from({length: bulanCount}, (_, i) => this.formValid.harga[i] || false).every(valid => valid);
      return this.formValid.bulan && this.formValid.dp && allHargaValid;
    },

    hasFormErrors() {
      return Object.values(this.formErrors).some(error => error !== '' || (Array.isArray(error) && error.some(e => e !== '')));
    },

    formatNumber(event, index = null) { 
      let angka = event.target.value.replace(/\D/g, ''); 
      if (index !== null) { 
        this.hargaValues[index] = angka; 
        this.hargaDisplays[index] = new Intl.NumberFormat('id-ID').format(angka);
        this.validateField('harga', angka, index);
      } else { 
        this.dpValue = angka; 
        this.dpDisplay = new Intl.NumberFormat('id-ID').format(angka);
        this.validateField('dp', angka);
      } 
    }
  }"
>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create New Cicilan</h2>

    <form
      action='/cicilan/{{kelasId}}'
      method='POST'
      @submit='if (!canSubmit()) { $event.preventDefault(); return false; }'
      class='space-y-6'
    >

      <!-- Pilih Bulan -->
      <div>
        <label
          for='bulan'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Installment Period
        </label>
        <select
          id='bulan'
          name='bulan'
          x-model='formData.bulan'
          @change='validateField("bulan", $event.target.value); bulan = $event.target.value; hargaDisplays = Array(parseInt(bulan)).fill(""); hargaValues = Array(parseInt(bulan)).fill(""); formValid.harga = Array(parseInt(bulan)).fill(false); formErrors.harga = Array(parseInt(bulan)).fill("")'
          required
          :class="formErrors.bulan ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.bulan ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
        >
          <option value='3'>3 Months</option>
          <option value='6'>6 Months</option>
          <option value='12'>12 Months</option>
        </select>
        <div
          x-show='formErrors.bulan'
          class='mt-1 text-sm text-red-600'
          x-text='formErrors.bulan'
        ></div>
        <div
          x-show='formValid.bulan && !formErrors.bulan'
          class='mt-1 text-sm text-green-600'
        >✓ Period selected</div>
      </div>

      <!-- Input Harga Per Bulan -->
      <div>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Monthly Payment Amounts
        </label>
        <!-- Down Payment (DP) -->
        <div class='mb-4'>
          <label
            for='dp'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >
            Down Payment (DP)
          </label>
          <input
            type='text'
            id='dp'
            x-model='dpDisplay'
            @input='formatNumber($event)'
            placeholder='Enter down payment amount'
            required
            :class="formErrors.dp ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.dp ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
          />
          <input type='hidden' name='dp' x-model='dpValue' />
          <div
            x-show='formErrors.dp'
            class='mt-1 text-sm text-red-600'
            x-text='formErrors.dp'
          ></div>
          <div
            x-show='formValid.dp && !formErrors.dp'
            class='mt-1 text-sm text-green-600'
          >✓ Down payment looks good</div>
        </div>
        <div class='space-y-2'>
          <template x-for='(price, index) in parseInt(bulan)' :key='index'>
            <div class='flex items-center gap-3'>
              <span
                class='text-sm text-gray-600 w-20'
                x-text="'Month ' + (index + 1)"
              ></span>
              <input
                type='text'
                x-model='hargaDisplays[index]'
                @input='formatNumber($event, index)'
                placeholder='Enter amount'
                required
                :class="formErrors.harga[index] ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.harga[index] ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='flex-1 border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
              />
              <input
                type='hidden'
                name='harga[]'
                x-model='hargaValues[index]'
              />
            </div>
            <div
              x-show='formErrors.harga[index]'
              class='mt-1 text-sm text-red-600 ml-20'
              x-text='formErrors.harga[index]'
            ></div>
            <div
              x-show='formValid.harga[index] && !formErrors.harga[index]'
              class='mt-1 text-sm text-green-600 ml-20'
            >✓ Amount looks good</div>
          </template>
        </div>
      </div>

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit()'
          :class="canSubmit() ? 'bg-gray-900 hover:bg-gray-600' : 'bg-gray-400 cursor-not-allowed'"
          class='text-white px-6 py-2 rounded-lg shadow transition'
        >
          Create
        </button>
        <a
          href='/kelass/detail/kelas/admin/{{kelasId}}'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition'
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>