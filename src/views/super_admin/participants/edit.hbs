{{!--
  Halaman: Edit Participant — Super Admin
  Lokasi: src/views/super_admin/participants/edit.hbs
  Level: L4 Page

  Route: GET /participants/formEdit/:participantId
  -> PATCH /participants/:participantId/:courseId (urlencoded + _method override).
  Field dikirim sebagai title[id|en|ja], icon, description[id|en|ja].

  Bentuk field-nya sama persis dengan value/commitment, jadi memakai komponen
  form/icon_item yang sama.

  Nilai awal lewat helper json, bukan template literal: teksnya bebas diketik
  dan bisa memuat karakter yang memecah skrip. Tidak ada tombol hapus di sini —
  menghapus dilakukan lewat aksi baris di tab Participants halaman detail program.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Participant'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the participant criteria shown on the public program page.'
      }}
    </div>

    <form
      action='/participants/{{participant.id}}/{{participant.course.id}}?_method=PATCH'
      method='post'
      novalidate
      x-data='iconItemForm({ icon: {{json participant.icon}}, title: {{json participant.title}}, description: {{json participant.description}} })'
      @submit.prevent='submitForm($event)'
    >
      {{#> components/ui/super_admin/form/icon_item/fields
        titleHint='Shown as the heading of the participant card on the public program page.'
        descriptionHint='Shown under the heading on the participant card.'
      }}
        <div class='flex flex-col-reverse gap-3 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href=(concat '/program/detail/program/admin/' participant.course.id)
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Save Changes'
            loading=true
          }}
        </div>
      {{/components/ui/super_admin/form/icon_item/fields}}
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/icon_item/form }}
