{{!--
  Halaman: Misi — Super Admin
  Lokasi: src/views/super_admin/missions/index.hbs
  Level: L4 Page

  - Sidebar sudah disediakan oleh layouts/main.hbs (offset lg:ml-[319px])

  Data: GET /mission → { missions }. Memakai clientTable: barisnya sedikit dan
  controller mengirimnya utuh, jadi paginasi di server tidak memberi keuntungan.

  Kolom Order menampilkan `missionOrder`, yaitu DATA yang menentukan urutan misi
  di halaman publik — bukan nomor baris. Karena itu kolom ini ada meski halaman
  lain tidak memakai penomoran baris.

  `content` dan `items` adalah kolom jsonb { id, en, ja }, jadi tabelnya memakai
  tab bahasa seperti halaman Program Type.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Misi'
      }}

      {{> components/ui/super_admin/description/index
        text='Manage the mission statements shown on the About page.'
      }}
    </div>

    <div
      class='flex flex-col gap-2.5'
      x-data='clientTable({ items: {{json missions}}, searchKeys: ["content.id", "content.en", "content.ja", "items.id", "items.en", "items.ja"] })'
    >
      {{> components/ui/super_admin/table/toolbar
        placeholder='Search misi..'
        searchLabel='Search misi'
        createHref='/mission/formCreate'
        createLabel='Create Misi'
      }}

      <div
        class='rounded-xl border border-[#d9d9d9] bg-white px-5 pb-5 pt-3'
        x-data="{ lang: 'id' }"
      >
        <div class='flex flex-col gap-4'>

          {{> components/ui/super_admin/tabs/language/index ariaLabel='Misi language' }}

          {{#> components/ui/super_admin/table/card tableClass='min-w-[1010px]'}}
            <colgroup>
              <col class='w-[90px]' />
              <col class='w-[340px]' />
              <col class='w-[464px]' />
              <col class='w-[116px]' />
            </colgroup>
            <thead>
              <tr>
                {{> components/ui/super_admin/table/header_cell label='Order' }}
                {{> components/ui/super_admin/table/header_cell label='Mission Title' }}
                {{> components/ui/super_admin/table/header_cell label='Mission Description' }}
                {{> components/ui/super_admin/table/header_cell label='Action' }}
              </tr>
            </thead>
            <tbody>
              <template x-for='row in rows' :key='row.id'>
                <tr class='transition-colors hover:bg-[#fafafa]'>

                  {{#> components/ui/super_admin/table/cell}}
                    {{> components/ui/super_admin/badge/index
                      size='md'
                      text='String(row.missionOrder + 1).padStart(2, "0")'
                      class='bg-[#f9f5ff] text-[#6941c6]'
                    }}
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='block truncate font-inter text-sm font-medium leading-5 text-[#171717]'
                      x-text='(row.content && row.content[lang]) || "—"'
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell}}
                    <span
                      class='block truncate font-inter text-sm leading-5 text-[#525252]'
                      x-text='(row.items && row.items[lang]) || "—"'
                    ></span>
                  {{/components/ui/super_admin/table/cell}}

                  {{#> components/ui/super_admin/table/cell variant='action'}}
                    {{> components/ui/super_admin/table/row_actions
                      entity='misi'
                      editHref="'/mission/formEdit/' + row.id"
                      deleteAction="'/mission/' + row.id + '?_method=DELETE'"
                    }}
                  {{/components/ui/super_admin/table/cell}}
                </tr>
              </template>

              {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='4'}}
                No misi found.
              {{/components/ui/super_admin/table/message_row}}
            </tbody>
          {{/components/ui/super_admin/table/card}}
        </div>
      </div>
    </div>
  </div>
</div>

{{> components/ui/super_admin/modal/delete_confirm/index
  title='Delete Misi?'
  description='Are you sure you want to delete this misi? The remaining missions will be renumbered automatically. This action cannot be undone.'
}}

{{> components/ui/super_admin/toast/success/index toast=toast }}

{{> components/ui/super_admin/table/client_table }}
