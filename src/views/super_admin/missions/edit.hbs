{{!--
  Halaman: Edit Misi — Super Admin
  Lokasi: src/views/super_admin/missions/edit.hbs
  Level: L4 Page

  Route: GET /mission/formEdit/:id -> PATCH /mission/:id
  (urlencoded + _method override).

  Data: { missions } — namanya jamak tapi isinya SATU misi; itu yang dikirim
  controller, jadi dibiarkan apa adanya agar kontraknya tidak berubah.

  Beda dari create.hbs: field terisi nilai existing. Tidak ada tombol hapus di
  sini — menghapus dilakukan lewat aksi baris di halaman daftar, sama seperti
  halaman Teknologi dan Program Type.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Edit Misi'
      }}

      {{> components/ui/super_admin/description/index
        text='Update the mission statement used across Kesatria Academy.'
      }}
    </div>

    {{!-- Nilai awal lewat helper json, bukan template literal: teks misi bebas
         diketik dan bisa memuat karakter yang memecah skrip. --}}
    <form
      action='/mission/{{missions.id}}?_method=PATCH'
      method='post'
      novalidate
      x-data='missionForm({ content: {{json missions.content}}, items: {{json missions.items}} })'
      @submit.prevent='submitForm($event)'
    >
      {{#> components/ui/super_admin/form/mission/fields }}
        <div class='flex flex-col-reverse gap-3 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href='/mission'
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Save Changes'
            loading=true
          }}
        </div>
      {{/components/ui/super_admin/form/mission/fields}}
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/mission/form }}
