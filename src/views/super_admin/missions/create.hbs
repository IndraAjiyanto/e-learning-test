{{!--
  Halaman: Create Misi — Super Admin
  Lokasi: src/views/super_admin/missions/create.hbs
  Level: L4 Page

  Route: GET /mission/formCreate -> POST /mission (urlencoded).
  Field dikirim sebagai content[id|en|ja] dan items[id|en|ja]; `missionOrder`
  tidak ikut, MissionsService yang menentukannya (max + 1).

  Toast sukses tidak dirender di sini: submit redirect ke /mission, jadi
  notifikasinya muncul di index.hbs lewat flash `toast`.
--}}
<div class='min-h-screen bg-[#f3f3f3] px-4 py-8 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        title='Create Misi'
      }}

      {{> components/ui/super_admin/description/index
        text='Create a new mission statement for use across Kesatria Academy.'
      }}
    </div>

    <form
      action='/mission'
      method='post'
      novalidate
      x-data='missionForm()'
      @submit.prevent='submitForm($event)'
    >
      {{#> components/ui/super_admin/form/mission/fields }}
        <div class='flex flex-col-reverse gap-3 sm:flex-row sm:justify-end'>
          {{> components/ui/super_admin/form/button
            as='link'
            variant='secondary'
            href='/mission'
            label='Cancel'
            loading=true
          }}

          {{> components/ui/super_admin/form/button
            type='submit'
            variant='primary'
            label='Create Misi'
            loading=true
          }}
        </div>
      {{/components/ui/super_admin/form/mission/fields}}
    </form>
  </div>
</div>

{{> components/ui/super_admin/form/mission/form }}
