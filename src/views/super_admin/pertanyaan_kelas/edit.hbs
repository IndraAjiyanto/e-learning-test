{{> header user=user}}
{{> sidebar user=user}}

<div class="p-4 sm:ml-64">
  <div class="p-4 mt-14">
    <div class="max-w-3xl mx-auto">
      
      <!-- Header -->
      <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Edit FAQ</h1>
        <p class="text-gray-600">Update FAQ information</p>
      </div>

      <!-- Form Card -->
      <div class="bg-white rounded-xl shadow-lg p-6">
        <form action="/pertanyaan-kelas/{{pertanyaanKelas.id}}?_method=PATCH" method="POST">
          
          <!-- Kelas Dropdown -->
          <div class="mb-6">
            <label for="kelasId" class="block text-sm font-semibold text-gray-700 mb-2">
              Class
            </label>
            <select 
              name="kelasId" 
              id="kelasId" 
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900"
              required>
              <option value="">-- Select Class --</option>
              {{#each kelass}}
                <option value="{{this.id}}" {{#if (eq this.id ../pertanyaanKelas.kelas.id)}}selected{{/if}}>
                  {{this.nama_kelas}}
                </option>
              {{/each}}
            </select>
          </div>

          <!-- Pertanyaan -->
          <div class="mb-6">
            <label for="pertanyaan" class="block text-sm font-semibold text-gray-700 mb-2">
              Question
            </label>
            <textarea 
              name="pertanyaan" 
              id="pertanyaan" 
              rows="3"
              placeholder="Enter question..."
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900"
              required>{{pertanyaanKelas.pertanyaan}}</textarea>
          </div>

          <!-- Jawaban -->
          <div class="mb-6">
            <label for="jawaban" class="block text-sm font-semibold text-gray-700 mb-2">
              Answer
            </label>
            <textarea 
              name="jawaban" 
              id="jawaban" 
              rows="5"
              placeholder="Enter answer..."
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900"
              required>{{pertanyaanKelas.jawaban}}</textarea>
          </div>

          <!-- Buttons -->
          <div class="flex items-center gap-4">
            <button 
              type="submit" 
              class="bg-gray-900 text-white px-6 py-2 rounded-lg hover:bg-gray-700 transition">
              Update FAQ
            </button>
            <a 
              href="/pertanyaan-kelas" 
              class="text-gray-700 px-6 py-2 rounded-lg border border-gray-300 hover:bg-gray-50 transition">
              Cancel
            </a>
          </div>

        </form>
      </div>

    </div>
  </div>
</div>

{{> footer}}
