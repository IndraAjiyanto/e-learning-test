<div class='py-10'>
  <div class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'>
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create New FAQ</h2>

    <form
      action='/pertanyaan-kelas/{{kelasId}}'
      method='post'
      class='space-y-6'
    >

      <!-- Pertanyaan -->
      <div>
        <label
          for='pertanyaan'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Question
        </label>
        <textarea
          id='pertanyaan'
          name='pertanyaan'
          rows='3'
          required
          placeholder='Enter the question...'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        ></textarea>
      </div>

      <!-- Jawaban -->
      <div>
        <label
          for='jawaban'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Answer
        </label>
        <textarea
          id='jawaban'
          name='jawaban'
          rows='5'
          required
          placeholder='Enter the answer...'
          class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
        ></textarea>
      </div>

      <!-- Buttons -->
      <div class='flex gap-3'>
        <button
          type='submit'
          class='bg-gray-900 text-white px-6 py-2 rounded-lg shadow hover:bg-gray-600 transition'
        >
          Create
        </button>
        <a
          href='/kelass/detail/kelas/admin/{{kelasId}}'
          class='px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition'
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>