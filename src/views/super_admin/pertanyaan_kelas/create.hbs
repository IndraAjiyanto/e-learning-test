<div class='py-10'>
  <div
    class='max-w-2xl mx-auto px-6 py-10 bg-white rounded-xl shadow-lg'
    x-data="{
    // Form validation states
    formData: {
      pertanyaan: { id: '', en: '', ja: '' },
      jawaban: { id: '', en: '', ja: '' }
    },
    formErrors: {
      pertanyaan: { id: '', en: '', ja: '' },
      jawaban: { id: '', en: '', ja: '' }
    },
    formValid: {
      pertanyaan: { id: false, en: false, ja: false },
      jawaban: { id: false, en: false, ja: false }
    },
    formTouched: {
      pertanyaan: { id: false, en: false, ja: false },
      jawaban: { id: false, en: false, ja: false }
    },

    validateField(field, value, lang = null) {
      if (lang) {
        this.formData[field][lang] = value;
        this.formTouched[field][lang] = true;
      } else {
        this.formData[field] = value;
        this.formTouched[field] = true;
      }
      
      switch(field) {
        case 'pertanyaan':
          if (!value.trim()) {
            this.formErrors.pertanyaan[lang] = 'Question is required';
            this.formValid.pertanyaan[lang] = false;
          } else if (value.trim().length < 10) {
            this.formErrors.pertanyaan[lang] = 'Question must be at least 10 characters';
            this.formValid.pertanyaan[lang] = false;
          } else {
            this.formErrors.pertanyaan[lang] = '';
            this.formValid.pertanyaan[lang] = true;
          }
          break;
          
        case 'jawaban':
          if (!value.trim()) {
            this.formErrors.jawaban[lang] = 'Answer is required';
            this.formValid.jawaban[lang] = false;
          } else if (value.trim().length < 20) {
            this.formErrors.jawaban[lang] = 'Answer must be at least 20 characters';
            this.formValid.jawaban[lang] = false;
          } else {
            this.formErrors.jawaban[lang] = '';
            this.formValid.jawaban[lang] = true;
          }
          break;
      }
    },

    canSubmit() {
      const pertanyaanValid = Object.values(this.formValid.pertanyaan).every(v => v);
      const jawabanValid = Object.values(this.formValid.jawaban).every(v => v);
      return pertanyaanValid && jawabanValid;
    },

    hasFormErrors() {
      return Object.values(this.formErrors.pertanyaan).some(e => e !== '') ||
             Object.values(this.formErrors.jawaban).some(e => e !== '');
    }
  }"
  >
    <h2 class='text-2xl font-semibold mb-6 text-gray-900'>Create New FAQ</h2>

    <form
      action='/pertanyaan-kelas/{{kelasId}}'
      method='post'
      class='space-y-6'
      x-data='{ loading: false }'
      @submit.prevent="if (canSubmit()) { loading = true; $el.submit(); } else { alert('Please fix all validation errors before submitting.'); }"
    >

{{> super_admin/faq_program/create/question_input}}
{{> super_admin/faq_program/create/answer_input}}

      <div class='flex gap-3'>
        <button
          type='submit'
          :disabled='!canSubmit () || loading'
          :class="!canSubmit() || loading ? 'bg-gray-400 cursor-not-allowed' : 'bg-gray-900 hover:bg-gray-700'"
          class='text-white px-6 py-2 rounded-lg shadow transition'
        >
          <span x-show='loading'><i
              class='loading loading-spinner loading-sm'
            ></i></span>
          <span x-show='!loading'>Create</span>
        </button>
        <a
          href='/program/detail/program/admin/{{kelasId}}'
:class="loading ? 'bg-gray-100 cursor-not-allowed' : 'hover:bg-gray-100 text-gray-700'"
          class='px-6 py-2 rounded-lg border border-gray-300  transition'>
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>