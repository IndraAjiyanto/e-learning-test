{{!-- {{> free_program/program }} --}}
  {{!-- {{> free_program/benefit }} --}}
  {{!-- {{> free_program/cta }} --}}

  <!-- Modal Registrasi -->
  <div
    x-show="showModal"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-[9999] flex items-center justify-center p-4"
    style="display: none;"
  >
    <!-- Overlay -->
    <div
      @click="closeRegistrationModal()"
      class="absolute inset-0 bg-black/50 backdrop-blur-sm"
    ></div>

    <!-- Modal Content -->
    <div
      x-show="showModal"
      x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 scale-95 translate-y-4"
    x-transition:enter-end="opacity-100 scale-100 translate-y-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100 scale-100 translate-y-0"
    x-transition:leave-end="opacity-0 scale-95 translate-y-4"
      class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl max-h-[90vh] overflow-y-auto"
    >
      <!-- Header -->
      <div class="flex items-center justify-between p-6 border-b border-gray-100 sticky top-0 bg-white rounded-t-2xl z-10">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center">
            <i class="fas fa-gift text-emerald-600 text-lg"></i>
          </div>
          <div>
            <h3 class="text-lg font-bold text-slate-800">Registrasi Program</h3>
            <p class="text-xs text-emerald-600 font-semibold uppercase">Free Program</p>
          </div>
        </div>
        <button
          @click="closeRegistrationModal()"
          class="w-9 h-9 rounded-full hover:bg-gray-100 flex items-center justify-center transition-colors"
        >
          <i class="fas fa-times text-slate-500"></i>
        </button>
      </div>

      {{#if user}}
        {{#if check_user}}
          <!-- Already enrolled -->
          <div class="p-6 text-center">
            <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <i class="fas fa-check-circle text-emerald-600 text-2xl"></i>
            </div>
            <p class="text-slate-700 font-semibold mb-2">Anda sudah terdaftar di program ini</p>
            <a
              href="/program/{{course.id}}"
              class="inline-flex items-center justify-center gap-2 w-full h-[50px] bg-[#032A55] hover:bg-[#021b3a] text-white font-medium text-[15px] rounded-[10px] transition-colors mt-4"
            >
              <i class="fas fa-play-circle"></i>
              Continue Learning
            </a>
          </div>
        {{else}}
          <!-- Registration Form -->
          <form
            action="/registration/{{user.id}}/{{course.id}}"
            enctype="multipart/form-data"
            method="post"
            class="p-6 space-y-5"
            @submit="submitting = true"
          >
            <!-- Info -->
            <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-4">
              <div class="flex items-start gap-2">
                <i class="fas fa-info-circle text-emerald-600 mt-0.5"></i>
                <p class="text-xs text-emerald-700">
                  Program ini gratis. Silakan upload bukti registrasi (foto/screenshot) untuk menyelesaikan pendaftaran. Admin akan memverifikasi pendaftaran Anda.
                </p>
              </div>
            </div>

            <!-- File Upload -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">
                <i class="fas fa-file-image mr-2"></i>
                Upload Bukti Registrasi
                <span class="text-red-500">*</span>
              </label>
              <div class="bg-blue-50 border border-blue-100 rounded-lg p-3 mb-3">
                <p class="text-xs text-blue-600">
                  <i class="fas fa-info-circle mr-1"></i>
                  Format: JPG, JPEG, PNG. Maksimal 5MB.
                </p>
              </div>
              <input
                type="file"
                name="file"
                required
                accept="image/jpeg,image/jpg,image/png"
                @change="validateFile($event)"
                :class="fileError ? 'border-red-500' : isValidFile ? 'border-emerald-500' : 'border-slate-300'"
                class="w-full bg-white p-3 border rounded-xl transition-all file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200"
              />

              <!-- Error Message -->
              <div x-show="fileError" x-transition class="mt-2">
                <p class="text-xs text-red-600 flex items-start gap-1">
                  <i class="fas fa-exclamation-circle mt-0.5"></i>
                  <span x-text="fileError"></span>
                </p>
              </div>

              <!-- Success Message -->
              <div x-show="isValidFile && !fileError" x-transition class="mt-2">
                <p class="text-xs text-emerald-600 flex items-center gap-1">
                  <i class="fas fa-check-circle"></i>
                  <span>File valid dan siap diupload</span>
                </p>
              </div>
            </div>

            <!-- Preview -->
            <template x-if="previewUrl && isValidFile">
              <div>
                <p class="text-xs text-slate-500 mb-2">Preview:</p>
                <img
                  :src="previewUrl"
                  alt="Preview"
                  class="rounded-xl border-2 border-emerald-200 max-h-48 w-full object-contain"
                />
              </div>
            </template>

            <!-- Submit -->
            <button
              type="submit"
              :disabled="(fileError) || (!isValidFile && fileInputTouched) || submitting"
              :class="(fileError) || (!isValidFile && fileInputTouched) || submitting ? 'opacity-50 cursor-not-allowed' : 'hover:bg-[#021b3a]'"
              class="flex items-center justify-center gap-2 w-full h-[50px] bg-[#032A55] text-white font-medium text-[15px] rounded-[10px] transition-all"
            >
              <span x-show="!submitting" class="flex items-center gap-2">
                <i class="fas fa-user-plus"></i>
                Submit Registrasi
              </span>
              <span x-show="submitting" class="flex items-center gap-2">
                <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Mengirim...
              </span>
            </button>
          </form>
        {{/if}}
      {{else}}
        <!-- Not logged in -->
        <div class="p-6 text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-sign-in-alt text-blue-600 text-2xl"></i>
          </div>
          <p class="text-slate-700 font-semibold mb-2">Silakan login terlebih dahulu</p>
          <p class="text-sm text-slate-500 mb-4">Anda harus login untuk mendaftar program ini</p>
          <a
            href="/login"
            class="inline-flex items-center justify-center gap-2 w-full h-[50px] bg-[#032A55] hover:bg-[#021b3a] text-white font-medium text-[15px] rounded-[10px] transition-colors"
          >
            <i class="fas fa-sign-in-alt"></i>
            Login Sekarang
          </a>
        </div>
      {{/if}}

    </div>
  </div>

</div>