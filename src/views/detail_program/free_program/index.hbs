<div class="w-full text-slate-900"
    x-data="{
    activeTab: localStorage.getItem('activeDetailTab') || 'info',

    benefit: null,
    faq: null,
    flow: null,
    mentor: null,
    lang: '{{lang}}',
    
    // Status loading per tab
    loading: { benefit: false, faq: false, flow: false, mentor: false },
    fetched: { benefit: false, faq: false, flow: false, mentor: false },

    // Modal registrasi state
    showModal: false,
    fileError: '',
    isValidFile: false,
    previewUrl: null,
    fileInputTouched: false,
    submitting: false,

    init() {
        const savedTab = localStorage.getItem('activeDetailTab');
        if (savedTab) this.activeTab = savedTab;
        
        this.fetchTab(this.activeTab);

        this.$watch('activeTab', value => {
            localStorage.setItem('activeDetailTab', value);
        });
    },

    async fetchTab(tab) {
      if (tab === 'info') return;
      if (this.fetched[tab]) return;
      
      this.loading[tab] = true;
      try {
        const map = {
          benefit: '/program/api/detail/{{course.id}}/benefit',
          faq:     '/program/api/detail/{{course.id}}/faq',
          flow:    '/program/api/detail/{{course.id}}/flow',
          mentor:  '/program/api/detail/{{course.id}}/mentor'
        };
        const res = await fetch(map[tab]);
        this[tab] = await res.json();
        this.fetched[tab] = true;
      } catch(e) {
        console.error('Gagal mengambil data tab:', e);
    } finally {
        this.loading[tab] = false;
    }
    },

    switchTab(tab) {
    this.activeTab = tab;
    this.fetchTab(tab);
    },

    openRegistrationModal() {
        {{#if user}}
            {{#if check_user}}
                window.location.href = '/program/{{course.id}}';
            {{else}}
                this.showModal = true;
                document.body.style.overflow = 'hidden';
            {{/if}}
        {{else}}
            window.location.href = '/login';
        {{/if}}
    },

    closeRegistrationModal() {
        this.showModal = false;
        document.body.style.overflow = '';
        this.fileError = '';
        this.isValidFile = false;
        this.previewUrl = null;
        this.fileInputTouched = false;
    },

    validateFile(event) {
        this.fileInputTouched = true;
        const file = event.target.files[0];
        if (!file) {
            this.isValidFile = false;
            this.previewUrl = null;
            return;
        }
        const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
        const maxSize = 5 * 1024 * 1024;
        if (!allowedTypes.includes(file.type)) {
            this.fileError = 'File harus berupa gambar JPG, JPEG, atau PNG';
            this.isValidFile = false;
            this.previewUrl = null;
            return;
        }
        if (file.size > maxSize) {
            this.fileError = 'Ukuran file maksimal 5MB';
            this.isValidFile = false;
            this.previewUrl = null;
            return;
        }
        this.fileError = '';
        this.isValidFile = true;
        this.previewUrl = URL.createObjectURL(file);
    }
}"
