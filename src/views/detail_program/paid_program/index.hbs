<div class="bg-[linear-gradient(180deg,_#FAFAFA_-33%,_#CEE5F6_33%,_#FAFAFA_93.51%)] min-h-screen pt-32 pb-24 font-montserrat overflow-x-hidden">
  <div class="container mx-auto px-8 lg:px-12 max-w-[1400px]">
    
    <!-- Back Button -->
    <div class="mb-10">
      <a href="javascript:history.back()" class="inline-flex items-center justify-center w-10 h-10 md:w-[50px] md:h-[50px] rounded-[100px] border-[1px] border-[#003060] shadow-[0_0_4px_rgba(0,0,0,0.25)] bg-transparent text-[#0B1F3B]">
        <i class="fas fa-arrow-left text-[14px] md:text-[16px]"></i>
      </a>
    </div>

    <div class="flex flex-col lg:flex-row gap-12 justify-between">
      
      <!-- Left Content -->
      <div class="flex-1 lg:max-w-2xl pt-2">
        <!-- Batch Pill -->
        <div class="inline-flex items-center justify-center px-5 lg:px-6 py-2 lg:py-2.5 mb-6 lg:mb-8 rounded-full border-2 border-white bg-white/80 backdrop-blur-[6.6px] shadow-[0_0_4px_rgba(0,0,0,0.1)] w-fit max-w-full">
          <span class="text-[#0B1F3B] font-[600] text-[30px] leading-none text-center">{{course.group}} - {{t 'test.paidProgram.header.startLearning'}} {{formatDate course.startDate lang}}</span>
        </div>

        <!-- Title -->
        <h1 class="text-[40px] font-[600] text-[#000000] leading-none mb-4 lg:mb-6">
          {{course.name}}
        </h1>

        <!-- Description -->
        <p class="text-[#000000] font-['Open_Sans'] font-[400] text-[25px] leading-[50px] text-justify mb-8 lg:mb-0">
          {{getByLang course.description lang}}
        </p>
      </div>

      <!-- Right Content (Card) -->
      <div class="lg:w-[480px]">
        <div class="card bg-white/60 backdrop-blur-[6.6px] shadow-[0_0_6px_rgba(0,0,0,0.25)] p-8 md:p-10 border border-[#F0F0F0] rounded-xl">
          
          <div class="space-y-7 mb-10">
            <!-- Learning Date -->
            <div class="flex items-start gap-5">
              <div class="mt-0.5">
                <img src="/public/image/icons/paid_program/calendar.svg" alt="Calendar Icon" class="w-[30px] h-[30px]" />
              </div>
              <div>
                <h3 class="font-[600] text-[#0F0F0F] text-[25px] leading-none mb-1.5">{{t 'test.paidProgram.header.learningDate'}}</h3>
                <p class="text-[#545454] font-[400] text-[20px]">{{formatDate course.startDate lang}} - {{formatDate course.startEnd lang}} - {{course.method}}</p>
              </div>
            </div>

            <!-- Location -->
            <div class="flex items-start gap-5">
              <div class="mt-0.5 ml-0.5">
                <img src="/public/image/icons/paid_program/location.svg" alt="Location Icon" class="w-[23px] h-[32px]" />
              </div>
              <div>
                <h3 class="font-[600] text-[#0F0F0F] text-[25px] leading-none mb-1.5">{{t 'test.paidProgram.header.location'}}</h3>
                <p class="text-[#545454] font-[400] text-[20px]">{{getByLang course.locations lang}}</p>
              </div>
            </div>

            <!-- Capacity -->
            <div class="flex items-start gap-5">
              <div class="mt-0.5">
                <img src="/public/image/icons/paid_program/capacity.svg" alt="Capacity Icon" class="w-[30px] h-[21px]" />
              </div>
              <div>
                <h3 class="font-[600] text-[#0F0F0F] text-[25px] leading-none mb-1.5">{{t 'test.paidProgram.header.capacity'}}</h3>
                <p class="text-[#545454] font-[400] text-[20px]">{{course.quota}} {{t 'test.paidProgram.header.students'}}</p>
              </div>
            </div>
          </div>

          <!-- Registration Status -->
          <div class="text-center mb-6">
            <p class="text-[#D32F2F] font-bold text-[17px]">{{t 'test.paidProgram.header.registrationTime'}} {{formatDate course.date_registration lang}}</p>
          </div>

          <!-- Button -->
          {{!-- BUTTON BELUM DIUBAH --}}
          <button class="btn bg-[#003060] hover:bg-[#002244] w-full text-white text-lg h-14 rounded-lg shadow-md border-none">
            {{t 'test.paidProgram.header.registrationNow'}}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Tabs Bar -->
{{> paid_program/nav_menu }}

<!-- PARTICIPANTS SECTION -->
<section id="participants" class="bg-[#FAFAFA] py-20 font-montserrat">
  <div class="container mx-auto px-4 lg:px-12 max-w-[1400px] flex flex-col items-center">
    
    <!-- Title Pill -->
    <div class="inline-flex items-center justify-center border border-[#003060] bg-[#6EB6E5]/[20%] text-[#003060] px-14 py-2.5 rounded-[100px] font-[600] text-[16px] mb-14">
      {{t 'test.paidProgram.title.participants'}}
    </div>

    <!-- Cards Grid (2x2) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 w-full max-w-[1000px]">
      
      {{#each course.criteriaId}}
      <div class="bg-white border border-[#E0E0E0] rounded-[16px] p-8 flex gap-6 hover:shadow-lg transition-shadow duration-300">
        <div class="text-[#0F0F0F] text-[32px] mt-1">
          <i class="fas fa-check-circle"></i>
        </div>
        <div>
           <h3 class="text-[#0F0F0F] font-[700] text-[17px] mb-2">Students & Fresh Graduates</h3>
          <p class="text-[#545454] text-[14px] leading-[1.6]">{{this}}</p>
        </div>
      </div>
      {{/each}}

    </div>
  </div>
</section>

<!-- WHAT YOU'LL LEARN SECTION -->
<section id="what-you-will-learn" class="bg-[#FAFAFA] py-20 font-montserrat overflow-x-hidden">
  <div class="container mx-auto px-4 lg:px-12 max-w-[1400px] flex flex-col items-center">
    
    <div class="inline-flex items-center justify-center border border-[#003060] bg-[#6EB6E5]/[20%] text-[#003060] px-14 py-2.5 rounded-[100px] font-[600] text-[16px] mb-14">
      {{t 'test.paidProgram.navbarMenu.whatYouLearn'}}
    </div>

    <div class="flex flex-col lg:flex-row items-center gap-4 w-full max-w-[1200px]">
      <div class="flex-1 w-full" data-animate="slide-right">
        <ul class="space-y-6 text-[#0F0F0F] text-[14px] md:text-[15px]">
          {{#if (eq lang 'en')}}
            {{#each course.learningTargetsEn}}
              <li class="flex items-start gap-4">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-[#0F0F0F] flex-shrink-0"></span>
                <span class="leading-relaxed">{{this}}</span>
              </li>
            {{/each}}
          {{else if (eq lang 'ja')}}
            {{#each course.learningTargetsJa}}
              <li class="flex items-start gap-4">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-[#0F0F0F] flex-shrink-0"></span>
                <span class="leading-relaxed">{{this}}</span>
              </li>
            {{/each}}
          {{else}}
            {{#each course.learningTargetsId}}
              <li class="flex items-start gap-4">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-[#0F0F0F] flex-shrink-0"></span>
                <span class="leading-relaxed">{{this}}</span>
              </li>
            {{/each}}
          {{/if}}
        </ul>
      </div>

      <div class="flex-1 w-full flex justify-center" data-animate="scale-up">
        <img src="/public/image/image_learn.png" alt="What You'll Learn Illustration" class="w-full max-w-[500px] object-contain">
      </div>
    </div>
  </div>
</section>

<!-- BENEFITS SECTION -->
<section id="benefits" class="bg-[#FAFAFA] py-20 font-montserrat overflow-x-hidden">
  <div class="container mx-auto px-4 lg:px-12 max-w-[1400px] flex flex-col items-center">
    <div class="inline-flex items-center justify-center border border-[#003060] bg-[#6EB6E5]/[20%] text-[#003060] px-14 py-2.5 rounded-[100px] font-[600] text-[16px] mb-14">
