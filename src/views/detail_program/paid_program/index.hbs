<section id="learning-flow" class="bg-[#FAFAFA] py-20 font-montserrat relative z-0">
  <div class="container mx-auto px-4 lg:px-8 max-w-[1200px] flex flex-col items-center">
    
    <div class="inline-flex items-center justify-center border border-[#003060] bg-[#6EB6E5]/[20%] text-[#003060] px-14 py-2.5 rounded-[100px] font-[600] text-[16px] mb-14">
      Learning Flow
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-x-3 gap-y-16 w-full">

      <!-- Flow 1 -->
      <div class="flex flex-col items-center text-center relative lg:before:block before:hidden before:absolute before:top-[19px] before:left-[50%] before:w-full before:h-[1px] before:bg-[#0F0F0F] before:-z-10 order-1 lg:order-1">
        <div class="w-10 h-10 min-w-[40px] min-h-[40px] flex-shrink-0 flex-grow-0 rounded-full bg-[#6EB6E5] text-black flex items-center justify-center font-[600] text-[12px] mb-4 relative z-10">1</div>
        <div class="bg-white backdrop-blur-[6.6px] shadow-[0_0_6px_rgba(0,0,0,0.25)] rounded-[16px] p-4 w-full h-full min-h-[260px] flex flex-col items-center hover:shadow-lg transition-shadow duration-300">
          <img src="/public/image/icons/paid_program/learning-flow/1.svg" alt="Step 1" class="w-[28px] h-[28px] mb-4 object-contain" />
          <h3 class="text-[#2D2D2D] font-[600] text-[15px] mb-3 leading-tight max-w-[140px]">Introduction to UI/UX Design</h3>
          <p class="text-[#2D2D2D] text-[12px] leading-[25px] w-[137px]">Introduction to UI/UX differences, digital design process, and initial use of Figma and Figjam for team collaboration.</p>
        </div>
      </div>
  
      <!-- Flow 2 -->
      <div class="flex flex-col items-center text-center relative lg:before:block before:hidden before:absolute before:top-[19px] before:left-[50%] before:w-full before:h-[1px] before:bg-[#0F0F0F] before:-z-10 order-2 lg:order-2">
        <div class="w-10 h-10 min-w-[40px] min-h-[40px] flex-shrink-0 flex-grow-0 rounded-full bg-[#6EB6E5] text-black flex items-center justify-center font-[600] text-[12px] mb-4 relative z-10">2</div>
        <div class="bg-white backdrop-blur-[6.6px] shadow-[0_0_6px_rgba(0,0,0,0.25)] rounded-[16px] p-4 w-full h-full min-h-[260px] flex flex-col items-center hover:shadow-lg transition-shadow duration-300">
          <img src="/public/image/icons/paid_program/learning-flow/2.svg" alt="Step 2" class="w-[28px] h-[28px] mb-4 object-contain" />
          <h3 class="text-[#2D2D2D] font-[600] text-[15px] mb-3 leading-tight max-w-[140px]">Visual Design Principles</h3>
          <p class="text-[#2D2D2D] text-[12px] leading-[25px] w-[137px]">Learning color theory, typography, visual hierarchy, grid systems, and creating a basic style guide.</p>
        </div>
      </div>
  
      <!-- Flow 3 -->
      <div class="flex flex-col items-center text-center relative lg:before:block before:hidden before:absolute before:top-[19px] before:left-[50%] before:w-full before:h-[1px] before:bg-[#0F0F0F] before:-z-10 order-3 lg:order-3">
        <div class="w-10 h-10 min-w-[40px] min-h-[40px] flex-shrink-0 flex-grow-0 rounded-full bg-[#6EB6E5] text-black flex items-center justify-center font-[600] text-[12px] mb-4 relative z-10">3</div>
        <div class="bg-white backdrop-blur-[6.6px] shadow-[0_0_6px_rgba(0,0,0,0.25)] rounded-[16px] p-4 w-full h-full min-h-[260px] flex flex-col items-center hover:shadow-lg transition-shadow duration-300">
          <img src="/public/image/icons/paid_program/learning-flow/3.svg" alt="Step 3" class="w-[28px] h-[28px] mb-4 object-contain" />
          <h3 class="text-[#2D2D2D] font-[600] text-[15px] mb-3 leading-tight max-w-[140px]">User Research and Personas</h3>
          <p class="text-[#2D2D2D] text-[12px] leading-[25px] w-[137px]">User interview practices, Design Thinking methods, and the creation of personas, empathy maps, and customer journeys.</p>
        </div>
      </div>
  
      <!-- Flow 4 -->
      <div class="flex flex-col items-center text-center relative lg:before:block before:hidden before:absolute before:top-[19px] before:left-[50%] before:w-full before:h-[1px] before:bg-[#0F0F0F] before:-z-10 order-4 lg:order-4">
        <div class="w-10 h-10 min-w-[40px] min-h-[40px] flex-shrink-0 flex-grow-0 rounded-full bg-[#6EB6E5] text-black flex items-center justify-center font-[600] text-[12px] mb-4 relative z-10">4</div>
        <div class="bg-white backdrop-blur-[6.6px] shadow-[0_0_6px_rgba(0,0,0,0.25)] rounded-[16px] p-4 w-full h-full min-h-[260px] flex flex-col items-center hover:shadow-lg transition-shadow duration-300">
          <img src="/public/image/icons/paid_program/learning-flow/4.svg" alt="Step 4" class="w-[28px] h-[28px] mb-4 object-contain" />
          <h3 class="text-[#2D2D2D] font-[600] text-[15px] mb-3 leading-tight max-w-[140px]">User Flow and Wireframing</h3>
          <p class="text-[#2D2D2D] text-[12px] leading-[25px] w-[137px]">Identifying user flows using FigJam, sketching, and hands-on wireframing practices in Figma.</p>
        </div>
      </div>
  
      <!-- Flow 5 -->
      <div class="flex flex-col items-center text-center relative lg:before:block before:hidden before:absolute before:top-[19px] before:left-[50%] before:w-full before:h-[1px] before:bg-[#0F0F0F] before:-z-10 order-5 lg:order-5">
        <div class="w-10 h-10 min-w-[40px] min-h-[40px] flex-shrink-0 flex-grow-0 rounded-full bg-[#6EB6E5] text-black flex items-center justify-center font-[600] text-[12px] mb-4 relative z-10">5</div>
        <div class="bg-white backdrop-blur-[6.6px] shadow-[0_0_6px_rgba(0,0,0,0.25)] rounded-[16px] p-4 w-full h-full min-h-[260px] flex flex-col items-center hover:shadow-lg transition-shadow duration-300">
          <img src="/public/image/icons/paid_program/learning-flow/5.svg" alt="Step 5" class="w-[28px] h-[28px] mb-4 object-contain" />
          <h3 class="text-[#2D2D2D] font-[600] text-[15px] mb-3 leading-tight max-w-[140px]">User Interface Design</h3>
          <p class="text-[#2D2D2D] text-[12px] leading-[25px] w-[137px]">Applying layout principles, designing basic UI components, and determining the theme for Capstone Project phase one.</p>
        </div>
      </div>
  
      <!-- Flow 6 -->
      <div class="flex flex-col items-center text-center relative lg:before:block before:hidden before:absolute before:top-[19px] before:left-[50%] before:w-[calc(50%+1.5rem)] before:h-[calc(100%+4rem)] before:border-t-[1px] before:border-r-[1px] before:border-b-[1px] before:border-[#0F0F0F] before:-z-10 order-6 lg:order-6">
        <div class="w-10 h-10 min-w-[40px] min-h-[40px] flex-shrink-0 flex-grow-0 rounded-full bg-[#6EB6E5] text-black flex items-center justify-center font-[600] text-[12px] mb-4 relative z-10">6</div>
        <div class="bg-white backdrop-blur-[6.6px] shadow-[0_0_6px_rgba(0,0,0,0.25)] rounded-[16px] p-4 w-full h-full min-h-[260px] flex flex-col items-center hover:shadow-lg transition-shadow duration-300">
