<div
  class='min-h-screen flex items-center justify-center bg-gradient-to-br from-primary via-secondary to-gray-800 px-4 pt-28 py-20'>
  <div class='w-full max-w-4xl flex items-center justify-center'>
    <div class='w-full max-w-lg mx-auto bg-white/5 backdrop-blur-xl border border-white/20 shadow-2xl rounded-3xl p-8'>

      <!-- Logo -->
      <div class='flex items-center justify-center mb-6'>
        <i class='fa-solid fa-envelope text-5xl' style='color: #ffffff;'></i>
      </div>

      <!-- Title -->
      <div class='text-center mb-6'>
        <h1 class='text-2xl whitespace-nowrap font-bold text-white mt-2 font-montserrat'>{{t 'test.verify.verifyEmail'}}
        </h1>
        <p class='text-gray-400 text-sm mt-2'>
          {{t 'test.verify.description'}}
        </p>
      </div>

      <!-- Success Alert -->
      {{#if success}}
      <div role='alert' class='mb-6 p-4 rounded-xl bg-green-900/30 border border-green-500/40 backdrop-blur-sm'>
        <div class='flex items-start gap-3'>
          <div class='flex-shrink-0 mt-0.5'>
            <svg xmlns='http://www.w3.org/2000/svg' class='h-5 w-5 text-green-400' fill='none' viewBox='0 0 24 24'
              stroke='currentColor' stroke-width='2'>
              <path stroke-linecap='round' stroke-linejoin='round' d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' />
            </svg>
          </div>
          <div class='flex-1'>
            <p class='text-sm font-medium text-green-200'>{{success}}</p>
          </div>
          <button type='button' onclick="this.parentElement.parentElement.style.display='none'"
            class='flex-shrink-0 text-green-400 hover:text-green-300 transition-colors'>
            <svg class='h-4 w-4' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2'>
              <path stroke-linecap='round' stroke-linejoin='round' d='M6 18L18 6M6 6l12 12' />
            </svg>
          </button>
        </div>
      </div>
      {{/if}}

      <!-- Error Alert -->
      {{#if error}}
      <div role='alert' class='mb-6 p-4 rounded-xl bg-red-900/30 border border-red-500/40 backdrop-blur-sm'>
        <div class='flex items-start gap-3'>
          <div class='flex-shrink-0 mt-0.5'>
            <svg xmlns='http://www.w3.org/2000/svg' class='h-5 w-5 text-red-400' fill='none' viewBox='0 0 24 24'
              stroke='currentColor' stroke-width='2'>
              <path stroke-linecap='round' stroke-linejoin='round'
                d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' />
            </svg>
          </div>
          <div class='flex-1'>
            <p class='text-sm font-medium text-red-200'>{{error}}</p>
          </div>
          <button type='button' onclick="this.parentElement.parentElement.style.display='none'"
            class='flex-shrink-0 text-red-400 hover:text-red-300 transition-colors'>
            <svg class='h-4 w-4' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2'>
              <path stroke-linecap='round' stroke-linejoin='round' d='M6 18L18 6M6 6l12 12' />
            </svg>
          </button>
        </div>
      </div>
      {{/if}}

      {{#if remainingMs}}
      <div class='my-countdown simply-countdown'></div>

      <script>
        const remainingMs = {{ remainingMs }};
        const target = new Date(Date.now() + remainingMs);

        simplyCountdown('.my-countdown', {
          year: target.getFullYear(),
          month: target.getMonth() + 1,
          day: target.getDate(),
          hours: target.getHours(),
          minutes: target.getMinutes(),
          seconds: target.getSeconds(),

          words: {
            days: {
              root: `{{t 'test.verify.day'}}`,
              lambda: (root, n) => root
            },
            hours: {
              root: `{{t 'test.verify.hour'}}`,
              lambda: (root, n) => root
            },
            minutes: {
              root: `{{t 'test.verify.minute'}}`,
              lambda: (root, n) => root
            },
            seconds: {
              root: `{{t 'test.verify.second'}}`,
              lambda: (root, n) => root
            }
          },

          onEnd: () => location.reload()
        });
      </script>

      {{else}}

      <!-- Forgot Password Form -->
      <form action='/users/send-verify-email?token={{user.verificationToken}}' method='post' class='space-y-6'
        x-data='{ loading: false }' @submit='loading = true'>

        <!-- Submit Button -->
        <button type='submit' :disabled='loading'
          class='btn border-0 text-base w-full py-3 rounded-lg bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white font-semibold transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-xl'>
          <span x-show='loading' class='loading loading-spinner loading-sm'></span>
          <span x-show='!loading'>{{t 'test.verify.sendButton'}}</span>
        </button>
      </form>
      {{/if}}

    </div>
  </div>
</div>