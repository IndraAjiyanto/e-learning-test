{{!--
  Halaman: Verify Email
  Lokasi: src/views/verify-email.hbs
  Menggunakan komponen global auth (src/views/partials/components/ui/auth/index.hbs)
--}}

{{#if remainingMs}}
  {{!-- Tampilan dengan Countdown --}}
  {{> components/ui/auth/index
    variant="verify-email"
    title=(t 'test.verify.verifyEmail')
    description=(t 'test.verify.description2')
    success=success
    error=error
    showCountdown=true
    remainingMs=remainingMs
    countdownDayText=(t 'test.verify.day')
    countdownHourText=(t 'test.verify.hour')
    countdownMinuteText=(t 'test.verify.minute')
    countdownSecondText=(t 'test.verify.second')
    hideBottomLink=true
  }}
{{else}}
  {{!-- Tampilan dengan Form Button --}}
  {{> components/ui/auth/index
    variant="verify-email"
    action=(concat "/users/send-verify-email?token=" user.verificationToken)
    method="post"
    title=(t 'test.verify.verifyEmail')
    description=(t 'test.verify.description')
    success=success
    error=error
    submitText=(t 'test.verify.sendButton')
    hideBottomLink=true
  }}
{{/if}}
