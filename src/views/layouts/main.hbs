  {{!-- Toast gagal dipasang di sini, bukan per halaman, supaya setiap layar
       punya kanal kabar buruk yang seragam: kegagalan sisi klien tinggal
       mengirim event `toast:error`, dan kegagalan sisi server memakai
       flashToastError(). Toast sukses tetap dipasang per halaman seperti
       sebelumnya - memindahkannya ke sini akan membuat halaman yang sudah
       memasangnya menampilkan dua toast sekaligus. --}}
  {{> components/ui/super_admin/toast/error/index toast=toastError }}

    <script>
      document.addEventListener('DOMContentLoaded', function() {
      const scrollAnimator = new ScrollAnimator();
      scrollAnimator.initAll();
      
      const staggerContainers = document.querySelectorAll('[data-stagger-container]');
      staggerContainers.forEach(container => {
        scrollAnimator.initStagger(container);
      });

      window.scrollAnimator = scrollAnimator;
      })
    </script>

    <script>
    const isAuthenticated = {{{json isAuthenticated}}};
    
  if (!isAuthenticated) {
        const keep = ['activeSection', 'activeDetailTab'];
        
        Object.keys(localStorage).forEach(key => {
            if (!keep.includes(key)) {
                localStorage.removeItem(key);
            }
        });
    }
</script>


