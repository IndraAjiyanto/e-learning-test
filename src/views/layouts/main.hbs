<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {{#if blog.title}}
  <title>{{blog.title}}</title>
  <meta property="og:title" content="{{blog.title}}" />
  <meta property="og:description" content="{{blog.isi}}" />
  <meta property="og:url" content="https://e-learning.inndra.me/blog/detail/{{blog.id}}" />
  <meta property="og:type" content="article" />
  <meta property="og:image" content="{{blog.image.[0]}}" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{blog.title}}" />
  <meta name="twitter:description" content="{{blog.isi}}" />
  <meta name="twitter:image" content="{{blog.image.[0]}}" />
  {{else}}
  <title>Kesatria Academy</title>
  {{/if}}

  <link rel="icon" type="image/png" href="/public/image/logo.png" />
<link rel="apple-touch-icon" href="/public/image/logo.png" />

  <script src="/public/js/sweetalert2.all.min.js"></script>
  <script src="/public/js/easytimer.min.js"></script>
  <script defer  src="/public/assets/main.js"></script>
  <script defer src="/public/assets/editor.bundle.js"></script>
  <script src="/public/js/simplycountdown.js"></script>
  <link href="/public/css/style.css" rel="stylesheet">
  <link href="/public/css/all.min.css" rel="stylesheet">
  <link href="/public/css/sweetalert2.css" rel="stylesheet">

  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/scroll-animations.css">
  <link rel="stylesheet" href="/public/css/flag-icons.min.css">
  <link rel="stylesheet" href="/public/css/cropper.min.css">
      <link rel="stylesheet" href="/public/css/simplyCountdown.css">
      <link rel="stylesheet" href="/public/css/quil.css">
<script src="/public/js/cropper.min.js"></script>

</head>
<body class="bg-slate-50 text-base-content font-montserrat">
  
  {{#if (roles user.role 'admin' 'super_admin')}}
          {{#if notSidebar}}
                <main class="min-h-screen">
        {{{ body }}}  
      </main>
      {{else}}
    {{> sidebar}}
    <div class="lg:ml-64 min-h-screen">
      <main class="min-h-screen">
        {{{ body }}}  
      </main>
    </div>
    {{/if}}
  {{else}}
    {{> navbar}}  
    <main class="min-h-screen">
      {{{ body }}}  
    </main>
    {{> footer}}
  {{/if}} 


  {{> sweetalert}}

    <script>
      document.addEventListener('DOMContentLoaded', function() {
      const scrollAnimator = new ScrollAnimator();
      scrollAnimator.initAll();
      
      const staggerContainers = document.querySelectorAll('[data-stagger-container]');
      staggerContainers.forEach(container => {
        scrollAnimator.initStagger(container);
      });

      window.scrollAnimator = scrollAnimator;
      })
    </script>

    <script>
    const isAuthenticated = {{{json isAuthenticated}}};
    
  if (!isAuthenticated) {
        const keep = ['activeSection', 'activeDetailTab'];
        
        Object.keys(localStorage).forEach(key => {
            if (!keep.includes(key)) {
                localStorage.removeItem(key);
            }
        });
    }
</script>


    <script src="/public/js/scroll-animator.js"></script>
    <script src="/public/js/texttype.js"></script>

</body>
</html>
