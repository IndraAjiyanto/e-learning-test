<!-- FAQ Section -->

<section class='py-20 bg-gradient-to-br from-slate-50 via-white to-slate-100'>
  <div class='container mx-auto px-6 max-w-6xl'>

    <div class='max-w-4xl mx-auto space-y-8'>
        {{!-- {{!-- {{> highlightText
          before="Frequented Asked"
          highlight="Question"
          after=""
          textColor="text-gray-900"
          bg="bg-primary"
          color="text-white"
        }}  --}}
       <h2 class="text-4xl md:text-5xl font-bold leading-tight text-center font-montserrat text-gray-900">Frequently Asked Questions</h2>

      <div
        x-data="{
          activeIndex: null,
          currentPage: 1,
          itemsPerPage: 5,
          faqs: [
            {{#if kategori.pertanyaan_umum}}
              {{#each kategori.pertanyaan_umum}}
                { question: `{{pertanyaan}}`, answer: `{{jawaban}}` },
              {{/each}}
            {{else}}
              { question: 'How long is the bootcamp program?', answer: 'Our bootcamp program typically runs for 4 months with intensive weekend classes. You\'ll learn through hands-on projects and mentorship from industry experts.' },
              { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.' },
              { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.' },
              { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.' },
              { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.' },
              { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.' },
              { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.' },
              { question: 'What is the payment method?', answer: 'We offer flexible payment options including full payment, installments, and early bird discounts. Contact us for more details.' }
            {{/if}}
          ],
          get paginatedFaqs() {
            const start = (this.currentPage - 1) * this.itemsPerPage;
            const end = start + this.itemsPerPage;
            return this.faqs.slice(start, end);
          },
          get totalPages() {
            return Math.ceil(this.faqs.length / this.itemsPerPage);
          },
          toggle(index) {
            this.activeIndex = this.activeIndex === index ? null : index;
          }
        }"
      >
        <!-- FAQ Items -->
        <template x-for="(faq, index) in paginatedFaqs" :key="index">
          <div
            class='group bg-white rounded-2xl shadow-lg border border-slate-200 hover:shadow-2xl hover:border-slate-300 transition-all duration-300 overflow-hidden mb-5'
          >
            <button
              @click="toggle((currentPage - 1) * itemsPerPage + index)"
              class='w-full text-left p-8 focus:outline-none'
            >
              <div class='flex items-center justify-between'>
                <h3
                  class='text-xl font-bold text-gray-900 group-hover:text-slate-700 transition-colors duration-300'
                  x-text="faq.question"
                ></h3>
                <div
                  class='w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 group-hover:bg-slate-200 transition-colors duration-300'
                >
                  <i
                    class='fas fa-chevron-down text-slate-600 transition-transform duration-300'
                    :class="activeIndex === (currentPage - 1) * itemsPerPage + index ? 'rotate-180' : ''"
                  ></i>
                </div>
              </div>
            </button>
            <div
              x-show="activeIndex === (currentPage - 1) * itemsPerPage + index"
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 max-h-0"
              x-transition:enter-end="opacity-100 max-h-screen"
              x-transition:leave="transition ease-in duration-200"
              x-transition:leave-start="opacity-100 max-h-screen"
              x-transition:leave-end="opacity-0 max-h-0"
              class='overflow-hidden'
            >
              <div class='px-8 pb-8'>
                <p class='text-gray-600 leading-relaxed text-lg' x-text="faq.answer"></p>
              </div>
            </div>
          </div>
        </template>

        <!-- Pagination -->

<div class="flex items-center justify-center gap-3 flex-wrap">
            <!-- First Page -->
            <button
              @click="currentPage = 1"
              :disabled="currentPage === 1"
              class="p-2.5 rounded-lg bg-white hover:bg-slate-700 hover:text-white text-slate-700 disabled:opacity-20 disabled:cursor-not-allowed transition-all duration-300 shadow-md hover:shadow-xl"
            >
              <i class="fas fa-angles-left"></i>
            </button>

      

            <!-- Current Page Display -->
            <div class="px-6 py-3 text-gray-900 font-bold">
              <span class="text-xl" x-text="currentPage"></span>
              <span class="text-slate-300 mx-2">/</span>
              <span class="text-lg text-slate-300" x-text="totalPages"></span>
            </div>


            <!-- Last Page -->
            <button
              @click="currentPage = totalPages"
              :disabled="currentPage === totalPages"
              class="p-2.5 rounded-lg bg-white hover:bg-slate-700 hover:text-white text-slate-700 disabled:opacity-20 disabled:cursor-not-allowed transition-all duration-300 shadow-md hover:shadow-xl"
            >
              <i class="fas fa-angles-right"></i>
            </button>
          </div>
      </div>
    </div>
  </div>
</section>


</div>


