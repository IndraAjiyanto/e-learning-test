<div
  class='min-h-screen flex items-center justify-center bg-[linear-gradient(180deg,_#FAFAFA_-33%,_#CEE5F6_33%,_#FAFAFA_93.51%)] px-4 pt-28 py-20'
  x-data='resetPassword()'
>
  <div class='w-full max-w-4xl flex items-center justify-center'>
    <div
      class='w-full max-w-4xl mx-auto bg-[#FFFFFF] rounded-3xl p-8 shadow-2xl'
    >
      <div class='flex items-center justify-center -mt-32'>
        <img src='/public/image/logo_baru.png' alt='Logo' class='max-h-96 w-auto object-contain' />
      </div>
      <div class='text-center -mt-32 mb-12'>
        <h1
          class='text-[36px] whitespace-nowrap font-semibold text-gray-900 mt-2 font-montserrat'
        >{{t 'test.resetPassword.resetPassword'}}</h1>
        <p class='text-gray-900 text-[20px] mt-8'>
          {{t 'test.resetPassword.description'}}
        </p>
      </div>
      {{#if error}}
        <div
          role='alert'
          class='mb-6 p-4 rounded-xl bg-red-900/30 border border-red-500/40 backdrop-blur-sm'
        >
          <div class='flex items-start gap-3'>
            <div class='flex-shrink-0 mt-0.5'>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5 text-red-400'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                />
              </svg>
            </div>
            <div class='flex-1'>
              <p class='text-sm font-medium text-red-200'>{{error}}</p>
            </div>
            <button
              type='button'
              onclick="this.parentElement.parentElement.style.display='none'"
              class='flex-shrink-0 text-red-400 hover:text-red-300 transition-colors'
            >
              <svg
                class='h-4 w-4'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M6 18L18 6M6 6l12 12'
                />
              </svg>
            </button>
          </div>
        </div>
      {{/if}}

      <form
        x-data='{ loading: false }'
        @submit='loading = true'
        action='/users/reset-password'
        method='post'
        class='space-y-6'
        @submit='validateForm'
      >

        <input type='hidden' name='token' value='{{token}}' />

        <div x-data='{ show: false }'>
          <label class='block text-gray-900 mb-2 text-[20px] font-medium'>
            {{t 'test.resetPassword.newPassword'}}
          </label>
          <div class='relative'>
            <input
              :type="show ? 'text' : 'password'"
              name='password'
              x-model='password'
              placeholder='{{t "test.resetPassword.placeholderNewPassword"}}'
              required
              minlength='8'
              class='w-full px-4 py-3 rounded-lg bg-white border text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white pr-10 transition-all duration-300'
              :class="password.length === 0 ? 'border-gray-300' : (isPasswordValid ? 'border-green-500' : 'border-red-400')"
            />
            <button
              type='button'
              @click='show = !show'
              class='absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-gray-800'
            >
              <svg
                x-show='!show'
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M15 12a3 3 0 11-6 0 3 3 0 016 0z'
                />
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M2.458 12C3.732 7.943 7.523 5 12 5c4.478 
                     0 8.268 2.943 9.542 7-1.274 4.057-5.064 
                     7-9.542 7-4.477 0-8.268-2.943-9.542-7z'
                />
              </svg>
              <svg
                x-show='show'
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M13.875 18.825A10.05 10.05 0 0112 19c-4.478 
                     0-8.268-2.943-9.542-7a9.973 
                     9.973 0 012.042-3.362M6.223 
                     6.223A9.956 9.956 0 0112 5c4.478 
                     0 8.268 2.943 9.542 7a9.978 
                     9.978 0 01-4.121 4.592M15 
                     12a3 3 0 11-6 0 3 3 0 016 
                     0z'
                />
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M3 3l18 18'
                />
              </svg>
            </button>
          </div>
          <ul class='mt-2 space-y-1'>
            <li class='text-sm flex items-center gap-2' :class="hasLength ? 'text-green-600' : 'text-gray-500'">
              <i class='fas text-xs' :class="hasLength ? 'fa-check-circle' : 'fa-circle'"></i>
              {{t 'test.passwordChecklist.length'}}
            </li>
            <li class='text-sm flex items-center gap-2' :class="hasUpper ? 'text-green-600' : 'text-gray-500'">
              <i class='fas text-xs' :class="hasUpper ? 'fa-check-circle' : 'fa-circle'"></i>
              {{t 'test.passwordChecklist.uppercase'}}
            </li>
            <li class='text-sm flex items-center gap-2' :class="hasLower ? 'text-green-600' : 'text-gray-500'">
              <i class='fas text-xs' :class="hasLower ? 'fa-check-circle' : 'fa-circle'"></i>
              {{t 'test.passwordChecklist.lowercase'}}
            </li>
            <li class='text-sm flex items-center gap-2' :class="hasNumber ? 'text-green-600' : 'text-gray-500'">
              <i class='fas text-xs' :class="hasNumber ? 'fa-check-circle' : 'fa-circle'"></i>
              {{t 'test.passwordChecklist.number'}}
            </li>
            <li class='text-sm flex items-center gap-2' :class="hasSpecial ? 'text-green-600' : 'text-gray-500'">
              <i class='fas text-xs' :class="hasSpecial ? 'fa-check-circle' : 'fa-circle'"></i>
              {{t 'test.passwordChecklist.special'}}
            </li>
          </ul>

        </div>

        <div x-data='{ show: false }'>
          <label class='block text-gray-900 mb-2 text-[20px] font-medium'>
            {{t 'test.resetPassword.confirmNewPassword'}}
          </label>
          <div class='relative'>
            <input
              :type="show ? 'text' : 'password'"
              name='confirmPassword'
              x-model='confirmPassword'
              placeholder='{{t
                "test.resetPassword.placeholderConfirmPassword"
              }}'
              required
              minlength='8'
              class='w-full px-4 py-3 rounded-lg bg-white border text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white pr-10 transition-all duration-300'
              :class="confirmPassword.length === 0 ? 'border-gray-300' : (password === confirmPassword ? 'border-green-500' : 'border-red-400')"
            />
            <button
              type='button'
              @click='show = !show'
              class='absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-gray-800'
            >
              <svg
                x-show='!show'
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M15 12a3 3 0 11-6 0 3 3 0 016 0z'
                />
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M2.458 12C3.732 7.943 7.523 5 12 5c4.478 
                     0 8.268 2.943 9.542 7-1.274 4.057-5.064 
                     7-9.542 7-4.477 0-8.268-2.943-9.542-7z'
                />
              </svg>
              <svg
                x-show='show'
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M13.875 18.825A10.05 10.05 0 0112 19c-4.478 
                     0-8.268-2.943-9.542-7a9.973 
                     9.973 0 012.042-3.362M6.223 
                     6.223A9.956 9.956 0 0112 5c4.478 
                     0 8.268 2.943 9.542 7a9.978 
                     9.978 0 01-4.121 4.592M15 
                     12a3 3 0 11-6 0 3 3 0 016 
                     0z'
                />
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M3 3l18 18'
                />
              </svg>
            </button>
          </div>
        </div>

        <div x-show='password && confirmPassword' x-transition>
          <div
            :class="password === confirmPassword ? 'bg-green-900/30 border-green-500/40' : 'bg-red-900/30 border-red-500/40'"
            class='p-3 rounded-lg border'
          >
            <p
              :class="password === confirmPassword ? 'text-white' : 'text-white'"
              class='text-sm flex items-center gap-2'
            >
              <template x-if='password === confirmPassword'>
                <i class='fas fa-check-circle'></i>
              </template>
              <template x-if='password !== confirmPassword'>
                <i class='fas fa-times-circle'></i>
              </template>
              <span
                x-text='password === confirmPassword ? `{{t
                  "test.resetPassword.alertSuccess"
                }}` : `{{t "test.resetPassword.alertError"}}`'
              ></span>
            </p>
          </div>
        </div>

        <button
          type='submit'
          :disabled='loading'
          class='btn border-0 text-base w-full py-3 rounded-lg bg-[#003060] text-white font-semibold transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed'
          :disabled='password !== confirmPassword'
        >
          <span
            x-show='loading'
            class='loading loading-spinner loading-sm'
          ></span>

          <span x-show='!loading'>
            {{t 'test.resetPassword.resetButton'}}</span>
        </button>
      </form>

      <div class='text-center mt-6'>
        <p class='text-[20px] text-gray-900'>
          {{t 'test.resetPassword.backTo'}}
          <a
            href='/login'
            class='text-indigo-400 hover:text-indigo-300 font-medium transition-colors'
          >
            {{t 'test.resetPassword.login'}}
          </a>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  function resetPassword() {
    return {
      password: '',
      confirmPassword: '',

      get hasLength() { return this.password.length >= 8; },
      get hasUpper() { return /[A-Z]/.test(this.password); },
      get hasLower() { return /[a-z]/.test(this.password); },
      get hasNumber() { return /[0-9]/.test(this.password); },
      get hasSpecial() { return /[^A-Za-z0-9]/.test(this.password); },
      get isPasswordValid() {
        return this.hasLength && this.hasUpper && this.hasLower && this.hasNumber && this.hasSpecial;
      },

      validateForm(event) {
        if (this.password !== this.confirmPassword) {
          event.preventDefault();
          alert('{{t "test.resetPassword.alertError"}}');
          return false;
        }
        return true;
      }
    };
  }
</script>