{{!--
  Halaman: Reset Password
  Lokasi: src/views/reset-password.hbs
  Menggunakan komponen global auth (src/views/partials/components/ui/auth/index.hbs)
--}}

{{> components/ui/auth/index
  variant="reset-password"
  action="/users/reset-password"
  method="post"
  title=(t 'test.resetPassword.resetPassword')
  description=(t 'test.resetPassword.description')
  error=error
  passwordLabel=(t 'test.resetPassword.newPassword')
  passwordPlaceholder=(t 'test.resetPassword.placeholderNewPassword')
  confirmPasswordLabel=(t 'test.resetPassword.confirmNewPassword')
  confirmPasswordPlaceholder=(t 'test.resetPassword.placeholderConfirmPassword')
  lengthText=(t 'test.passwordChecklist.length')
  uppercaseText=(t 'test.passwordChecklist.uppercase')
  lowercaseText=(t 'test.passwordChecklist.lowercase')
  numberText=(t 'test.passwordChecklist.number')
  specialText=(t 'test.passwordChecklist.special')
  matchText=(t 'test.passwordChecklist.match')
  noMatchText=(t 'test.passwordChecklist.noMatch')
  submitText=(t 'test.resetPassword.resetButton')
  bottomTitle=(t 'test.resetPassword.backTo')
  bottomLinkText=(t 'test.resetPassword.login')
  bottomLinkUrl="/login"
  token=token
}}