    </button>

    <!-- Dot Indicators -->
    <div class='flex justify-center mt-8 gap-3'>
      <template x-for='(s, i) in slides' :key='i'>
        <button
          class='w-4 h-4 rounded-full transition-all duration-300'
          :class="active === i ? 'bg-white scale-125' : 'bg-white/50 hover:bg-white/70'"
          @click='active = i'
        ></button>
      </template>
    </div>
    {{else}}
    <!-- Fallback - No Alumni Data -->
    <div class='text-center py-12'>
      <div
        class='bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl shadow-2xl p-10 max-w-3xl mx-auto'
