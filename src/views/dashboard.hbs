        <p class='text-white text-xl leading-relaxed mb-8 italic'>
          This bootcamp transformed my career completely! The mentors were amazing, and the curriculum was very comprehensive. Now I work at a leading tech company with a great salary.
        </p>
        <div class='flex items-center gap-6 justify-center'>
          <img
            src='https://ui-avatars.com/api/?name=John+Doe&background=64748b&color=fff&size=128'
            alt='Alumni'
            class='w-16 h-16 rounded-full border-4 border-white/20'
          />
          <div class='text-left'>
            <p class='font-bold text-white text-lg'>John Doe</p>
            <p class='text-slate-300'>Senior Software Engineer</p>
            <p class='text-slate-400 text-sm'>Full Stack Development Bootcamp</p>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
  </div>
</section>

