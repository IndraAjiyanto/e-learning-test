<style>
  html {
    scroll-behavior: smooth;
  }
  body {
    background-color: #FFFFFF;
  }
</style>

<div class="w-full bg-white">
  {{> components/ui/sections/free_hero/index
    category=category
    lang=lang
  }}

  {{> components/ui/sections/free_program/index category=category courses=courses lang=lang}}

  {{> components/ui/sections/free_benefit/index category=category benefit_category=benefit_category lang=lang}}

  {{!-- Alumni Section - reuse existing alumni component with paid variant --}}
  {{!-- {{> components/ui/sections/alumni/index
      headerVariant="paid"
      showMobile=true
      titleKey="test.categoryFreeProgram.alumni.title"
      descKey="test.categoryFreeProgram.alumni.description"
      footerTextKey="test.categoryFreeProgram.alumni.footer"
      footerLinkTextKey="test.categoryFreeProgram.alumni.allStories"
      alumni=alumni
      category=category
      lang=lang
  }} --}}

  {{!-- Gallery Section - reuse existing gallery component --}}
  {{> components/ui/sections/gallery/index
      renderMobile=true
      showBadge=false
      showDivider=false
      showBottomLink=true
      titleKey="test.categoryFreeProgram.gallery.title"
      descKey="test.categoryFreeProgram.gallery.description"
      linkKey="test.categoryFreeProgram.gallery.allGaleries"
      gallery=gallery
  }}

  {{!-- FAQ Section - reuse existing faq component --}}
  {{> components/ui/sections/faq/index
      sectionClass="bg-[#F9FAFB]"
      titleText=(default (t 'test.categoryFreeProgram.faq.title') (t 'test.home.faq.title'))
      descText=(default (t 'test.categoryFreeProgram.faq.description') (t 'test.home.faq.description'))
      faqs=faqs
      lang=lang
  }}

  {{> components/ui/sections/free_cta/index category=category lang=lang}}
</div>
