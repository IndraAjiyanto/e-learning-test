<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<div 
  class='relative min-h-screen bg-slate-50' 
  x-data="{
    activeSection: localStorage.getItem('activeSection') || 'story',
    get bgImage() {
      switch(this.activeSection) {
        case 'story': return '/public/image/about/bgStory.png';
        case 'mission': return '/public/image/about/bgVisionMission.png';
        case 'values': return '/public/image/about/bgValues.png';
        case 'team': return '/public/image/about/bgTeam.png';
        default: return '/public/image/about/bgStory.png';
      }
    },
    async toggleActiveSection(sectionName) {
      this.activeSection = sectionName;
      localStorage.setItem('activeSection', sectionName);
    }
  }"
>
  <!-- Fixed Dynamic Background Image per Tab (Contained to About Section) -->
  <div 
    class="absolute inset-0 w-full h-full pointer-events-none z-0 bg-fixed bg-cover bg-top bg-no-repeat transition-all duration-500 opacity-90"
    :style="`background-image: url('${bgImage}');`"
  ></div>

  <!-- MOBILE ABOUT SECTION (< 640px) -->
  <div class="block sm:hidden w-full px-5 pt-20 pb-14 relative font-montserrat overflow-hidden">
    <!-- Mobile Top Navigation Bar (Pill Buttons matching Figma) -->
    <div class="mb-6">
      <div class="overflow-x-auto scrollbar-hide">
        <nav class="flex items-center justify-start gap-2.5 min-w-max pb-2">
          <button
            @click="toggleActiveSection('story');"
            :class="activeSection === 'story' ? 'bg-[#003060] text-white shadow-md' : 'bg-white text-[#0B1F3B] border border-[#D9D9D9]'"
            class="px-4 py-2.5 rounded-[12px] transition-all duration-200 flex items-center gap-2 whitespace-nowrap text-sm font-semibold font-montserrat"
          >
            <i class="fas fa-book-open text-sm"></i>
            <span>{{t "test.about.tabAbout.story"}}</span>
          </button>
          <button
            @click="toggleActiveSection('mission');"
            :class="activeSection === 'mission' ? 'bg-[#003060] text-white shadow-md' : 'bg-white text-[#0B1F3B] border border-[#D9D9D9]'"
            class="px-4 py-2.5 rounded-[12px] transition-all duration-200 flex items-center gap-2 whitespace-nowrap text-sm font-semibold font-montserrat"
          >
            <i class="fas fa-bullseye text-sm"></i>
            <span>{{t "test.about.tabAbout.visionsMisi"}}</span>
          </button>
          <button
            @click="toggleActiveSection('values');"
            :class="activeSection === 'values' ? 'bg-[#003060] text-white shadow-md' : 'bg-white text-[#0B1F3B] border border-[#D9D9D9]'"
            class="px-4 py-2.5 rounded-[12px] transition-all duration-200 flex items-center gap-2 whitespace-nowrap text-sm font-semibold font-montserrat"
          >
            <i class="fas fa-heart text-sm"></i>
            <span>{{t "test.about.tabAbout.value"}}</span>
          </button>
          <button
            @click="toggleActiveSection('team');"
            :class="activeSection === 'team' ? 'bg-[#003060] text-white shadow-md' : 'bg-white text-[#0B1F3B] border border-[#D9D9D9]'"
            class="px-4 py-2.5 rounded-[12px] transition-all duration-200 flex items-center gap-2 whitespace-nowrap text-sm font-semibold font-montserrat"
          >
            <i class="fas fa-users text-sm"></i>
            <span>{{t "test.about.tabAbout.team"}}</span>
          </button>
        </nav>
      </div>
    </div>

    <!-- Mobile Tab Content Container -->
    <div class="w-full">
      <div x-show="activeSection === 'story'">
        {{> about/story_tab}}
      </div>
      <div x-show="activeSection === 'mission'">
        {{> about/mission_tab}}
      </div>
      <div x-show="activeSection === 'team'">
        {{> about/team_tab}}
      </div>
      <div x-show="activeSection === 'values'">
        {{> about/values_tab}}
      </div>
    </div>
  </div>

  <!-- DESKTOP ABOUT SECTION (>= 640px / Preserving Original Baseline) -->
  <div class='hidden sm:block relative z-10 max-w-full mx-8 mt-4 p-4 sm:p-8 py-8 md:py-20 lg:py-24'>

    <div class='grid grid-cols-1 lg:grid-cols-12 gap-8'>
      <!-- Desktop Sidebar Navigation -->
      <div class='hidden lg:block lg:col-span-4 w-full max-w-[488px] sticky top-24 self-start'>
        <div class='space-y-4'>
          <nav class='space-y-4'>
            <button
              @click="toggleActiveSection('story');"
              :class="activeSection === 'story' ? 'bg-[#003060] text-white shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)]' : 'text-[#000000] border border-[#D9D9D9] shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)]'"
              class='w-full max-w-[488px] h-[84px] text-left px-[30px] py-[10px] gap-[10px] rounded-[6px] transition-all duration-200 flex items-center font-inter font-medium text-[25px] leading-none tracking-normal'
            >
              <i class='fas fa-book-open text-xl w-7 text-center'></i>
              <span>{{t "test.about.tabAbout.story"}}</span>
            </button>
            <button
              @click="toggleActiveSection('mission');"
              :class="activeSection === 'mission' ? 'bg-[#003060] text-white shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)]' : 'text-[#000000] border border-[#D9D9D9] shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)]'"
              class='w-full max-w-[488px] h-[84px] text-left px-[30px] py-[10px] gap-[10px] rounded-[6px] transition-all duration-200 flex items-center font-inter font-medium text-[25px] leading-none tracking-normal'
            >
              <i class='fas fa-bullseye text-xl w-7 text-center'></i>
              <span>{{t "test.about.tabAbout.visionsMisi"}}</span>
            </button>
            <button
              @click="toggleActiveSection('values');"
              :class="activeSection === 'values' ? 'bg-[#003060] text-white shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)]' : 'text-[#000000] border border-[#D9D9D9] shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)]'"
              class='w-full max-w-[488px] h-[84px] text-left px-[30px] py-[10px] gap-[10px] rounded-[6px] transition-all duration-200 flex items-center font-inter font-medium text-[25px] leading-none tracking-normal'
            >
              <i class='fas fa-heart text-xl w-7 text-center'></i>
              <span>{{t "test.about.tabAbout.value"}}</span>
            </button>
            <button
              @click="toggleActiveSection('team');"
              :class="activeSection === 'team' ? 'bg-[#003060] text-white shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)]' : 'text-[#000000] border border-[#D9D9D9] shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)]'"
              class='w-full max-w-[488px] h-[84px] text-left px-[30px] py-[10px] gap-[10px] rounded-[6px] transition-all duration-200 flex items-center font-inter font-medium text-[25px] leading-none tracking-normal'
            >
              <i class='fas fa-users text-xl w-7 text-center'></i>
              <span>{{t "test.about.tabAbout.team"}}</span>
            </button>
          </nav>
        </div>
      </div>

      <div class='lg:col-span-8'>
        <div x-show="activeSection === 'story'">
          {{> about/story_tab}}
        </div>

        <div x-show="activeSection === 'mission'">
          {{> about/mission_tab}}
        </div>

        <div x-show="activeSection === 'team'">
          {{> about/team_tab}}
        </div>

        <div x-show="activeSection === 'values'">
          {{> about/values_tab}}
        </div>
      </div>
    </div>
  </div>
  </div>
