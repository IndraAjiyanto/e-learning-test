<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<div class='pt-20 min-h-screen bg-[linear-gradient(180deg,_#FAFAFA_-33%,_#CEE5F6_33%,_#FAFAFA_93.51%)]' x-data="
          {
            activeSection: localStorage.getItem('activeSection') || 'story',

            async toggleActiveSection(sectionName) {
this.activeSection = sectionName;
localStorage.setItem('activeSection', sectionName);
}
          }
        ">
  <div class='max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-12'>

    <div class='lg:hidden mb-6 -mx-4 sm:mx-0'>
      <div class='overflow-x-auto scrollbar-hide px-4 sm:px-0'>
        <nav class='flex space-x-2 min-w-max sm:min-w-0 pb-4' >
          <button
            @click="toggleActiveSection('story');"
            :class="activeSection === 'story' ? 'bg-slate-100 text-slate-700 shadow-lg' : 'text-slate-600 hover:text-slate-700 hover:shadow-xl hover:bg-slate-50'"
            class='px-4 py-2.5 rounded-lg transition-all duration-200 flex items-center space-x-2 whitespace-nowrap text-sm font-medium border border-gray-300 '
          >
            <i class='fas fa-book-open text-xs'></i>
            <span>{{t "test.about.tabAbout.story"}}</span>
          </button>
          <button
            @click="toggleActiveSection('mission');"
            :class="activeSection === 'mission' ? 'bg-slate-100 text-slate-700 shadow-lg' : 'text-slate-600 hover:text-slate-700 hover:shadow-xl hover:bg-slate-50'"
            class='px-4 py-2.5 rounded-lg transition-all duration-200 flex items-center space-x-2 whitespace-nowrap text-sm font-medium border border-gray-300'
          >
            <i class='fas fa-bullseye text-xs'></i>
            <span>{{t "test.about.tabAbout.visionsMisi"}}</span>
          </button>
          <button
            @click="toggleActiveSection('values');"
            :class="activeSection === 'values' ? 'bg-slate-100 text-slate-700 shadow-lg' : 'text-slate-600 hover:text-slate-700 hover:shadow-xl hover:bg-slate-50'"
            class='px-4 py-2.5 rounded-lg transition-all duration-200 flex items-center space-x-2 whitespace-nowrap text-sm font-medium border border-gray-300'
          >
            <i class='fas fa-heart text-xs'></i>
            <span>{{t "test.about.tabAbout.value"}}</span>
          </button>
          <button
            @click="toggleActiveSection('team');"
            :class="activeSection === 'team' ? 'bg-slate-100 text-slate-700 shadow-lg' : 'text-slate-600 hover:text-slate-700 hover:shadow-xl hover:bg-slate-50'"
            class='px-4 py-2.5 rounded-lg transition-all duration-200 flex items-center space-x-2 whitespace-nowrap text-sm font-medium border border-gray-300'
          >
            <i class='fas fa-users text-xs'></i>
            <span>{{t "test.about.tabAbout.team"}}</span>
          </button>
          
          {{!-- <button
            @click="toggleActiveSection('contact');"
            :class="activeSection === 'contact' ? 'bg-slate-100 text-slate-700 shadow-lg' : 'text-slate-600 hover:text-slate-700 hover:shadow-xl hover:bg-slate-50'"
            class='px-4 py-2.5 rounded-lg transition-all duration-200 flex items-center space-x-2 whitespace-nowrap text-sm font-medium border border-gray-300'
          >
            <i class='fas fa-envelope text-xs'></i>
            <span>{{t "test.about.tabAbout.contact"}}</span>
          </button> --}}
        </nav>
      </div>
    </div>

    <div class='grid grid-cols-1 lg:grid-cols-4 gap-8'>
      <!-- Desktop Sidebar Navigation -->
      <div class='hidden lg:block lg:col-span-1'>
        <div class='sticky top-32 space-y-2'>
          <nav class='space-y-1'>
            <button
              @click="toggleActiveSection('story');"
              :class="activeSection === 'story' ? 'bg-secondary text-white shadow-lg' : 'text-slate-600 hover:text-slate-700 hover:shadow-xl hover:bg-slate-50'"
              class='w-full text-left px-4 py-3 rounded-lg transition-all duration-200 flex items-center space-x-3 border border-gray-300'
            >
              <i class='fas fa-book-open text-sm'></i>
              <span>{{t "test.about.tabAbout.story"}}</span>
            </button>
            <button
              @click="toggleActiveSection('mission');"
              :class="activeSection === 'mission' ? 'bg-secondary text-white shadow-lg' : 'text-slate-600 hover:text-slate-700 hover:shadow-xl hover:bg-slate-50'"
              class='w-full text-left px-4 py-3 rounded-lg transition-all duration-200 flex items-center space-x-3 border border-gray-300'
            >
              <i class='fas fa-bullseye text-sm'></i>
              <span>{{t "test.about.tabAbout.visionsMisi"}}</span>
            </button>
                 <button
              @click="toggleActiveSection('values');"
              :class="activeSection === 'values' ? 'bg-secondary text-white shadow-lg' : 'text-slate-600 hover:text-slate-700 hover:shadow-xl hover:bg-slate-50'"
              class='w-full text-left px-4 py-3 rounded-lg transition-all duration-200 flex items-center space-x-3 border border-gray-300'
            >
              <i class='fas fa-heart text-sm'></i>
              <span>{{t "test.about.tabAbout.value"}}</span>
            </button>
            <button
              @click="toggleActiveSection('team');"
              :class="activeSection === 'team' ? 'bg-secondary text-white shadow-lg' : 'text-slate-600 hover:text-slate-700 hover:shadow-xl hover:bg-slate-50'"
              class='w-full text-left px-4 py-3 rounded-lg transition-all duration-200 flex items-center space-x-3 border border-gray-300'
            >
              <i class='fas fa-users text-sm'></i>
              <span>{{t "test.about.tabAbout.team"}}</span>
            </button>
       
            {{!-- <button
              @click="toggleActiveSection('contact');"
              :class="activeSection === 'contact' ? 'bg-slate-100 text-slate-700 shadow-lg' : 'text-slate-600 hover:text-slate-700 hover:shadow-xl hover:bg-slate-50'"
              class='w-full text-left px-4 py-3 rounded-lg transition-all duration-200 flex items-center space-x-3 border border-gray-300'
            >
              <i class='fas fa-envelope text-sm'></i>
              <span>{{t "test.about.tabAbout.contact"}}</span>
            </button> --}}
          </nav>
        </div>
      </div>

      <div class='lg:col-span-3'>
        <div x-show="activeSection === 'story'">
        {{> about/story_tab}}
        </div>

<div x-show="activeSection === 'mission'">
        {{> about/mission_tab}}
        </div>

<div x-show="activeSection === 'team'">
        {{> about/team_tab}}
        </div>
<div x-show="activeSection === 'values'">
        {{> about/values_tab}}
        </div>
{{!-- <div x-show="activeSection === 'contact'">
        {{> about/contact_tab}}
        </div> --}}
      </div>
    </div>
  </div>
  </div>
