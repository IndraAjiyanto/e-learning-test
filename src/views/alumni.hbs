<div class="pt-24 pb-16 min-h-screen bg-[#F9FAFB]" x-data="alumniApp()">

  <div class="max-w-[1600px] mx-auto px-4 md:px-14 py-12 flex flex-col gap-9 items-center">

    <!-- ALUMNI HEADER -->
    <header class="flex flex-col items-center gap-4 w-full">
      {{> components/ui/text/section_header/index
        wrapperClass="mb-0"
        title=(t 'test.alumni.title')
        titleClass="text-4xl md:text-[56px] leading-[110%] font-bold text-[#111827] text-center font-montserrat"
        showDivider=false
        description=(t 'test.alumni.description')
        descClass="max-w-[702px] text-center text-[18px] leading-[160%] text-[#6B7280] font-sans font-normal"
      }}
    </header>

    <!-- ALUMNI STATS -->
    <section class="w-full max-w-[964px] bg-white border-2 border-[#E5E7EB] rounded-2xl shadow-[0px_8px_24px_-8px_rgba(0,0,0,0.04)] p-8 flex flex-col md:flex-row justify-center items-center gap-6">
      <!-- Alumni Stat -->
      <div class="flex-1 flex flex-col items-center gap-2">
        <div class="flex items-center gap-3">
          <i class="fas fa-users w-7 h-7 text-[#003060]"></i>
          <span class="text-[40px] leading-[48px] font-bold text-[#003060]">1,000+</span>
        </div>
        <span class="text-sm font-medium tracking-[0.02em] uppercase text-[#6B7280]">{{t 'test.alumni.statAlumni'}}</span>
      </div>
      <!-- Career Growth Stat -->
      <div class="flex-1 flex flex-col items-center gap-2">
        <div class="flex items-center gap-3">
          <i class="fas fa-chart-line w-7 h-7 text-[#003060]"></i>
          <span class="text-[40px] leading-[48px] font-bold text-[#003060]">95%</span>
        </div>
        <span class="text-sm font-medium tracking-[0.02em] uppercase text-[#6B7280]">{{t 'test.alumni.statCareerGrowth'}}</span>
      </div>
      <!-- Hiring Partners Stat -->
      <div class="flex-1 flex flex-col items-center gap-2">
        <div class="flex items-center gap-3">
          <i class="fas fa-briefcase w-7 h-7 text-[#003060]"></i>
          <span class="text-[40px] leading-[48px] font-bold text-[#003060]">200+</span>
        </div>
        <span class="text-sm font-medium tracking-[0.02em] uppercase text-[#6B7280]">{{t 'test.alumni.statHiringPartners'}}</span>
      </div>
    </section>

    <!-- FILTER SECTION -->
    <section class="w-full flex flex-col gap-8">
      <h2 class="text-2xl font-semibold text-[#111827]">{{t 'test.alumni.programTittle'}}</h2>
      <div class="flex flex-col gap-6">
        <!-- Search & Clear -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <div class="flex items-center w-[420px] h-[44px] bg-white border border-[#E5E7EB] rounded-xl px-4 py-3 gap-3">
            <i class="fas fa-search w-5 h-5 text-[#9CA3AF] shrink-0"></i>
            <input
              type="text"
              x-model="searchQuery"
              @input.debounce.500ms="currentPage = 1; fetchAlumni()"
              placeholder="Search alumni"
              class="w-full text-sm font-normal text-[#9CA3AF] placeholder-[#9CA3AF] bg-transparent outline-none border-none font-sans"
            />
          </div>
          <button
            type="button"
            @click="resetFilters()"
            class="flex items-center w-auto h-[42px] bg-white border border-[#E5E7EB] rounded-xl px-4 py-3 gap-2 whitespace-nowrap"
          >
            <i class="fas fa-trash w-[18px] h-[18px] text-[#6B7280]"></i>
            <span class="text-sm font-medium font-sans text-[#374151] whitespace-nowrap">Clear Filter</span>
          </button>
        </div>
        <!-- Pill Filters -->
        <div class="flex flex-wrap gap-3" id="pills">
          <button
            type="button"
            @click="selectKategori(null)"
            :class="!selectedKategoriId ? 'bg-[#003060] text-white border-[#003060] font-semibold' : 'bg-white border-[#E5E7EB] text-[#374151]'"
            class="px-5 py-2.5 rounded-full border text-sm font-medium transition-all"
          >{{t 'test.alumni.allProgram'}}</button>
          {{#if kategoriList}}
            {{#each kategoriList}}
              <button
                type="button"
                @click="selectKategori('{{this.id}}')"
                :class="selectedKategoriId == '{{this.id}}' ? 'bg-[#003060] text-white border-[#003060] font-semibold' : 'bg-white border-[#E5E7EB] text-[#374151]'"
                class="px-5 py-2.5 rounded-full border text-sm font-medium transition-all"
              >{{this.name}}</button>
            {{/each}}
          {{/if}}
        </div>
      </div>
    </section>

    <!-- ALUMNI GRID -->
    <section class="w-full flex flex-col items-center gap-8">
      <div x-show="alumniItems.length > 0" class="w-full grid md:grid-cols-2 xl:grid-cols-3 gap-6">
        <template x-for="alumni in alumniItems" :key="alumni.id">
          <article class="relative rounded-[20px] border border-[#E2E8F0] shadow-[0px_12px_32px_-4px_rgba(11,31,59,0.03)] p-8 flex flex-col gap-5 overflow-hidden" style="background: linear-gradient(90deg, #FFFFFF 0%, #F1F5F9 100%);">
            <!-- Decorative Quote -->
            <span class="font-montserrat absolute right-6 top-4 text-[120px] leading-[146px] font-extrabold text-[#0B1F3B] opacity-5 select-none pointer-events-none">&ldquo;</span>

            <!-- Profile -->
            <div class="relative flex items-center gap-4">
              <div class="w-[72px] h-[72px] rounded-full border-2 border-[#003060] p-[3px] flex items-center justify-center shrink-0">
                <img
                  :src="alumni.profile || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + alumni.name"
                  :alt="getByLang(alumni.name, lang)"
                  class="w-[60px] h-[60px] rounded-full object-cover"
                />
              </div>
              <div>
                <h3 class="text-[18px] font-bold text-[#0F172A] leading-[22px]" x-text="getByLang(alumni.name, lang)"></h3>
                <p class="text-sm font-medium text-[#475569]" x-text="getByLang(alumni.currentPosition, lang)"></p>
              </div>
            </div>

            <!-- Quote -->
            <p class="relative text-[15px] leading-[160%] text-[#0F172A]">
              &ldquo;<span x-text="getByLang(alumni.message, lang)"></span>&rdquo;
            </p>

            <!-- Badge -->
            <div class="relative">
              <span class="inline-flex px-3.5 py-1.5 rounded-full text-xs font-semibold" :class="getBadgeColor(alumni.course?.category?.name)" x-text="(alumni.course?.category?.name ? alumni.course.category.name + ': ' : '') + getKelasName(alumni)"></span>
            </div>
          </article>
        </template>
      </div>

      <!-- Empty State -->
      {{> components/ui/empty_state/index
        show="alumniItems.length === 0"
        icon="fas fa-users"
        title=(t 'test.alumni.noAlumni')
        description=(t 'test.alumni.tryAdjusting')
        actionText=(t 'test.alumni.resetFilters')
        onAction="resetFilters()"
      }}

      <!-- Pagination -->
      {{> components/ui/pagination/index
        currentPage="currentPage"
        totalPages="totalPages"
        onPageChange="changePage"
      }}
    </section>

  </div>
</div>

<script>
function alumniApp() {
  return {
    selectedKategoriId: {{#if kategoriId}}{{kategoriId}}{{else}}null{{/if}},

    kelasList: {{#if course}}{{{json course}}}{{else}}[]{{/if}},
    filteredKelasList: [],

    selectedKelas: '',
    selectedKelasId: '',
    searchQuery: '',

    currentPage: 1,
    totalPages: 1,
    alumniItems: [],
    lang: '{{lang}}' || 'id',
    unknown: "{{t 'test.alumni.unknown'}}",
    loading: false,

    async init() {
      this.kelasList = this.kelasList.sort((a, b) =>
        (a.name || '').localeCompare(b.name || '')
      );
      this.filterKelasByKategori();
      await this.fetchAlumni();
    },
    filterKelasByKategori() {
      if (this.selectedKategoriId) {
        this.filteredKelasList = this.kelasList.filter(k => k.category?.id == this.selectedKategoriId);
      } else {
        this.filteredKelasList = [...this.kelasList];
      }
    },

    async selectKategori(kategoriId) {
      this.selectedKategoriId = kategoriId;
      this.selectedKelasId = null;
      this.selectedKelas = '';
      this.currentPage = 1;
      
      this.filterKelasByKategori(); 
      await this.fetchAlumni();   
    },

    getByLang(obj, lang) {
      if (!obj) return '';
      if (typeof obj === 'string') return obj;
      if (typeof obj !== 'object') return '';
      return obj[lang] || obj.id || obj.en || '';
    },

    filterPrograms() {
      const query = this.searchQuery.toLowerCase().trim();
      const baseList = this.selectedKategoriId 
        ? this.kelasList.filter(k => k.category?.id == this.selectedKategoriId)
        : this.kelasList;
      this.filteredKelasList = query
        ? baseList.filter(k => k.name.toLowerCase().includes(query))
        : [...baseList];
    },

    async fetchAlumni() {
      this.loading = true;
      try {
        const params = new URLSearchParams();
        if (this.searchQuery && this.searchQuery.trim() !== '') {
          params.set('search', this.searchQuery.trim());
        }

        if (this.selectedKelasId) {
          params.set('course_id', this.selectedKelasId);
        }

        if (this.selectedKategoriId) {
          params.set('category_id', this.selectedKategoriId);
        }
        params.set('page', this.currentPage);
        params.set('limit', 6);

        const res = await fetch(`/dashboard/alumni/filter?${params.toString()}`);
        const json = await res.json();

        this.alumniItems = json.data || [];
        this.totalItems = json.totalItems || 0;
        this.totalPages = json.totalPages || 1;
        this.currentPage = json.currentPage || 1;
      } catch (err) {
        console.error('Fetch alumni error:', err);
      } finally {
        this.loading = false;
      }
    },

    async selectKelas(kelasId) {
      this.selectedKelasId = kelasId;
      this.currentPage = 1;

      if (kelasId) {
        const course = this.kelasList.find(k => k.id == kelasId);
        this.selectedKelas = course ? course.name : '';
      } else {
        this.selectedKelas = '';
      }
      await this.fetchAlumni();
    },

    async changePage(page) {
      this.currentPage = page;
      await this.fetchAlumni();
    },

    async resetFilters() {
      this.selectedKategoriId = null;
      this.selectedKelasId = null;
      this.selectedKelas = '';
      this.searchQuery = '';
      this.filterKelasByKategori();
      this.currentPage = 1;
      await this.fetchAlumni();
    },

    getKelasName(alumni) {
      const name = alumni.course?.name;
      return name ? (typeof name === 'object' ? this.getByLang(name, this.lang) : name) : this.unknown;
    },

    getBadgeColor(categoryName) {
      const colorMap = {
        'Bootcamp':          'bg-[#DBEAFE] text-[#1E40AF]',
        'Short Class':       'bg-[#DCFCE7] text-[#166534]',
        'In House Training': 'bg-[#FCE7F3] text-[#9D174D]',
        'Internship':        'bg-[#E0E7FF] text-[#3730A3]',
        'Free Program':      'bg-[#FEF3C7] text-[#92400E]',
        'Special Program':   'bg-[#E0F2FE] text-[#0369A1]',
      };
      return colorMap[categoryName] || 'bg-[#F1F5F9] text-[#475569]';
    }
  };
}

document.addEventListener('alpine:init', () => {
  Alpine.data('alumniApp', alumniApp);
});
</script>
