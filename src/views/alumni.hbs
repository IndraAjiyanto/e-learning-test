<div class='pt-24 min-h-screen bg-white' x-data='alumniApp()' x-init='init()'>

  <div class='container mx-auto px-4 pb-16'>
    <div class='text-center mb-12'>
      <h1 class='text-4xl font-bold text-gray-900 mb-4 font-montserrat'>{{t
          'test.alumni.tittle'
        }}</h1>
      <p class='text-gray-600 max-w-2xl mx-auto text-lg font-inter'>
        {{t 'test.alumni.description'}}
      </p>
    </div>

    <div class='grid grid-cols-1 lg:grid-cols-4 gap-8'>
      <!-- Sidebar Filters -->
      <div class='lg:col-span-1'>
        <div
          class='bg-white rounded-xl shadow-sm border border-gray-200 p-6 sticky top-6'
        >
          <!-- Active Filters -->
          <div class='mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200'>
            <div class='flex items-center justify-between mb-3'>
              <h4
                class='text-sm font-semibold text-gray-700 font-montserrat'
              >{{t 'test.alumni.activeFilters'}}</h4>
              <button
                @click='resetFilters()'
                class='text-xs text-gray-500 hover:text-gray-700 transition-colors flex items-center'
              >
                <i class='fas fa-undo-alt mr-1 text-xs'></i>
                {{t 'test.alumni.resetFilters'}}
              </button>
            </div>
            <div class='space-y-2'>
              <template x-if="selectedKelas === ''">
                <div
                  class='text-xs text-gray-500 text-center py-2 bg-white rounded border border-gray-200'
                >
                  {{t 'test.alumni.noFilters'}}
                </div>
              </template>

              <template x-if="selectedKelas !== ''">
                <span
                  class='block px-3 py-1 text-xs rounded-full bg-gradient-to-r from-slate-100 to-slate-200 text-gray-700 font-medium border border-gray-300'
                >
                  <span x-text='selectedKelas'></span>
                </span>
              </template>
            </div>
          </div>

          <!-- Search Program -->
          <div class='mb-6'>
            <h3
              class='text-base font-semibold text-gray-900 mb-3 flex items-center font-montserrat'
            >
              <i class='fas fa-search text-gray-500 mr-2'></i>
              {{t 'test.alumni.searchProgram'}}
            </h3>
            <div class='relative'>
              <input
                type='text'
                x-model='searchQuery'
                @input='filterPrograms()'
                placeholder='{{t "test.alumni.searchProgramPlaceholder"}}'
                class='w-full text-gray-600 px-4 py-3 pl-10 bg-white rounded-lg border border-gray-300 focus:border-gray-700 focus:ring-2 focus:ring-gray-700 transition-all duration-200'
              />
              <i
                class='fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400'
              ></i>
            </div>
          </div>

          <!-- Kelas Filter -->
          <div class='mb-6'>
            <h3
              class='text-base font-semibold text-gray-900 mb-3 flex items-center font-montserrat'
            >
              <i class='fas fa-graduation-cap text-gray-500 mr-2'></i>
              {{t 'test.alumni.programTittle'}}
            </h3>

            <div class='space-y-2 max-h-64 overflow-y-auto'>
              <button
                @click='selectKelas(null)'
                :class="!selectedKelasId ? 'bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white' : 'bg-white text-gray-700 hover:bg-gray-50'"
                class='w-full px-4 py-3 rounded-lg font-medium transition-all duration-200 flex items-center justify-between border border-gray-300'
              >
                <span class='text-sm'>{{t 'test.alumni.allProgram'}}</span>
              </button>
              <template x-for='kelas in filteredKelasList' :key='kelas.id'>
                <button
                  @click='selectKelas(kelas.id)'
                  :class="selectedKelasId == kelas.id ? 'bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white' : 'bg-white text-gray-700 hover:bg-gray-50'"
                  class='w-full px-4 py-3 rounded-lg font-medium transition-all duration-200 flex items-center justify-between border border-gray-300'
                >
                  <span class='text-sm text-left' x-text='kelas.nama_kelas'></span>
                </button>
              </template>
            </div>
          </div>

          <!-- Alumni Count -->
          <div class='mt-6 p-4 bg-gray-50 rounded-lg border border-gray-200'>
            <div class='text-center'>
              <div
                class='text-2xl font-bold text-gray-900'
                x-text='totalItems'
              ></div>
              <div class='text-sm text-gray-600'>{{t
                  'test.alumni.alumni'
                }}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Alumni Grid -->
      <div class='lg:col-span-3'>
        <!-- Alumni Cards -->
        <div class='grid md:grid-cols-2 gap-6'>
          <template x-for='alumni in displayedAlumni' :key='alumni.id'>
            <div
              class='bg-white border border-gray-300 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1 group'
            >
              <!-- Profile Header -->
              <div
                class='relative bg-gradient-to-br from-gray-50 to-white rounded-t-xl p-6 border-b border-gray-200'
              >
                <!-- Profile Image -->
                <div class='flex items-center gap-4'>
                  <div class='relative'>
                    <img
                      :src="alumni.profile || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + alumni.nama"
                      :alt='alumni.nama'
                      class='w-16 h-16 rounded-full border-4 border-white shadow-md object-cover'
                    />
                  </div>
                  <div class='flex-1 min-w-0'>
                    <h3
                      class='font-bold text-gray-900 text-lg truncate'
                      x-text='getByLang(alumni.nama, lang)'
                    ></h3>
                    <p
                      class='text-sm text-gray-600 truncate'
                      x-text='getKelasName(alumni)'
                    ></p>
                  </div>
                </div>
              </div>

              <!-- Card Content -->
              <div class='p-6 space-y-4'>
                <!-- Current Position -->
                <div class='bg-gray-50 rounded-lg p-4 border border-gray-200'>
                  <div class='flex items-start gap-3'>
                    <div
                      class='w-10 h-10 bg-gradient-to-br from-primary via-secondary to-gray-900 rounded-lg flex items-center justify-center flex-shrink-0'
                    >
                      <i class='fas fa-briefcase text-white text-sm'></i>
                    </div>
                    <div class='flex-1 min-w-0'>
                      <p
                        class='text-xs font-semibold text-gray-600 uppercase tracking-wide mb-1'
                      >
                        {{t 'test.alumni.currentPosition'}}
                      </p>
                      <p
                        class='font-bold text-gray-900 text-sm'
                        x-text='getByLang(alumni.posisi_sekarang, lang)'
                      ></p>
                      <p
                        class='text-xs text-gray-500 mt-1'
                        x-text="getByLang(alumni.alumni, lang) || 'Unknown'"
                      ></p>
                    </div>
                  </div>
                </div>

                <!-- Testimonial -->
                <div class='bg-white rounded-lg p-4 border border-gray-200'>
                  <div class='flex items-start gap-3'>
                    <div
                      class='w-8 h-8 bg-gradient-to-br from-primary via-secondary to-gray-900  rounded-full flex items-center justify-center flex-shrink-0 mt-1'
                    >
                      <i class='fas fa-quote-left text-white text-xs'></i>
                    </div>
                    <div class='flex-1 min-w-0'>
                      <p
                        class='text-sm text-gray-700 leading-relaxed'
                        x-text='getByLang(alumni.pesan, lang)'
                      ></p>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </template>
        </div>

        <!-- No Results Message -->
        <div x-show='displayedAlumni.length === 0' class='text-center py-12'>
          <div
            class='w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4'
          >
            <i class='fas fa-users text-gray-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-semibold text-gray-900 mb-2'>{{t
              'test.alumni.noAlumni'
            }}</h3>
          <p class='text-gray-600 mb-6'>{{t 'test.alumni.tryAdjusting'}}</p>
          <button
            @click='resetFilters()'
            class='bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition-all duration-300 border border-gray-700'
          >
            {{t 'test.alumni.resetAllFilters'}}
          </button>
        </div>

        <!-- Pagination -->
        <div
          class='flex justify-center items-center gap-4 mt-12'
          x-show='totalPages > 1'
        >
          <button
            @click='changePage(Math.max(1, currentPage - 1))'
            :disabled='currentPage === 1'
            class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'
          >
            <i class='fas fa-chevron-left'></i>
          </button>

          <template x-for='page in totalPages' :key='page'>
            <button
              @click='changePage(page)'
              class='w-12 h-12 rounded-xl text-lg font-semibold transition-all duration-300 border shadow-sm'
              :class="currentPage === page ? 'bg-gradient-to-r from-slate-600 to-slate-800 text-white border-slate-700 shadow-md' : 'bg-white text-gray-700 border-gray-300 hover:bg-slate-50'"
              x-text='page'
            ></button>
          </template>

          <button
            @click='changePage(Math.min(totalPages, currentPage + 1))'
            :disabled='currentPage === totalPages'
            class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'
          >
            <i class='fas fa-chevron-right'></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function alumniApp() {
    return {
      // ============================
      // State
      // ============================
      allAlumni: {{#if alumni}}{{{json alumni}}}{{else}}[]{{/if}},
      displayedAlumni: [],
      kelasList: {{#if kelas}}{{{json kelas}}}{{else}}[]{{/if}},
      filteredKelasList: [],
      selectedKelas: '',
      selectedKelasId: '',
      searchQuery: '',
      currentPage: 1,
      itemsPerPage: 6,
      totalPages: 1,
      loading: false,
      lang: '{{lang}}' || 'id',

      // ============================
      // Init
      // ============================
      init() {
        this.kelasList = this.kelasList.sort((a, b) =>
          a.nama_kelas.localeCompare(b.nama_kelas)
        );

        this.filteredKelasList = [...this.kelasList];
        this.filterAndPaginate();
      },

      // ============================
      // Helper: get text by language
      // ============================
      getByLang(obj, lang) {
        if (!obj || typeof obj !== 'object') return '';
        return obj[lang] || obj.id || obj.en || '';
      },

      // ============================
      // Filter kelas by search query
      // ============================
      filterPrograms() {
        if (this.searchQuery.trim() === '') {
          this.filteredKelasList = [...this.kelasList];
        } else {
          const query = this.searchQuery.toLowerCase().trim();

          this.filteredKelasList = this.kelasList.filter(kelas =>
            kelas.nama_kelas.toLowerCase().includes(query)
          );
        }
      },

      // ============================
      // Filtering + Pagination alumni
      // ============================
      filterAndPaginate() {
        let filtered = this.allAlumni;

        // Filter by kelas
        if (this.selectedKelasId) {
          filtered = filtered.filter(alumni =>
            alumni.kelas && alumni.kelas.id == this.selectedKelasId
          );
        }

        this.totalPages = Math.ceil(filtered.length / this.itemsPerPage);

        const startIndex = (this.currentPage - 1) * this.itemsPerPage;
        const endIndex = startIndex + this.itemsPerPage;

        this.displayedAlumni = filtered.slice(startIndex, endIndex);
      },

      // ============================
      // Getter: alumni untuk UI
      // ============================
      get alumniItems() {
        return this.displayedAlumni || [];
      },

      // ============================
      // Getter: total alumni setelah filter
      // ============================
      get totalItems() {
        let filtered = this.allAlumni;

        if (this.selectedKelasId) {
          filtered = filtered.filter(
            alumni => alumni.kelas && alumni.kelas.id == this.selectedKelasId
          );
        }

        return filtered.length;
      },

      // ============================
      // Select kelas
      // ============================
      selectKelas(kelasId) {
        this.selectedKelasId = kelasId;
        this.currentPage = 1;
        this.filterAndPaginate();

        if (kelasId) {
          const kelas = this.kelasList.find(k => k.id == kelasId);
          this.selectedKelas = kelas ? kelas.nama_kelas : '';
        } else {
          this.selectedKelas = '';
        }
      },

      // ============================
      // Pagination
      // ============================
      changePage(page) {
        this.currentPage = page;
        this.filterAndPaginate();
      },

      // ============================
      // Reset filter
      // ============================
      resetFilters() {
        this.selectedKelasId = null;
        this.selectedKelas = '';
        this.searchQuery = '';
        this.filteredKelasList = [...this.kelasList];

        this.currentPage = 1;
        this.filterAndPaginate();
      },

      // ============================
      // Helper: ambil nama kelas alumni
      // ============================
      getKelasName(alumni) {
        return alumni.kelas?.nama_kelas || 'Unknown';
      }
    };
  }

  document.addEventListener('alpine:init', () => {
    Alpine.data('alumniApp', alumniApp);
  });
</script>
