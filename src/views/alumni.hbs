<div class='pt-24 min-h-screen bg-cover bg-top bg-no-repeat bg-fixed' style="background-image: url('/public/image/dashboard/bgAlumniPage.png');" x-data='alumniApp()'>

  <div class='container mx-auto px-4 pb-16 max-w-[1440px]'>
    
    <!-- Header -->
    <div class='flex flex-col items-center mb-[50px]'>
      <!-- Badge -->
      <div class='flex justify-center items-center rounded-full mb-[30px]' style="width: 250px; height: 35px; background: rgba(110, 182, 229, 0.2); border: 1px solid #003060;">
        <span class='font-montserrat font-medium' style="font-size: 20px; color: #003060;">{{t 'test.alumni.alumni'}}</span>
      </div>

      <!-- Title & Subtitle -->
      <div class='flex flex-col items-center gap-[10px] w-full'>
        <h1 class='font-montserrat font-semibold text-center text-black' style="font-size: 40px; line-height: 55px;">{{{t 'test.alumni.title'}}}</h1>
        <div class="rounded-[6px]" style="width: 70px; height: 5px; background: #0B1F3B;"></div>
        <p class='text-center' style="max-width: 1396px; font-family: 'Open Sans'; font-weight: 400; font-size: 25px; line-height: 45px; color: rgba(0, 0, 0, 0.8);">
          {{t 'test.alumni.description'}}
        </p>
      </div>
    </div>

    <!-- Stats -->
    <div class='mx-auto px-4' style="max-width: 819px; margin-bottom: 100px;">
      <div class='flex flex-row items-center justify-between w-full' style="height: 102px; padding: 0 28px; background: rgba(224, 241, 249, 0.5); box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.5); backdrop-filter: blur(3.3px); border-radius: 12px;">
        
        <!-- Alumni -->
        <div class='flex flex-row items-center gap-[10px]' style="width: 208.67px;">
          <div class='flex items-center justify-center rounded-full flex-shrink-0' style="width: 59.67px; height: 59.67px; background: rgba(110, 182, 229, 0.3);">
            <i class='fas fa-users text-[#0B1F3B] text-xl'></i>
          </div>
          <div class='flex flex-col'>
            <span class='font-bold text-[#2D2D2D]' style="font-family: 'Open Sans'; font-size: 25px; line-height: 34px;">1000+</span>
            <span class='font-normal text-[#2D2D2D]' style="font-family: 'Open Sans'; font-size: 18px; line-height: 25px;">Alumni</span>
          </div>
        </div>

        <!-- Career Growth -->
        <div class='flex flex-row items-center gap-[10px]' style="width: 199.67px;">
          <div class='flex items-center justify-center rounded-full flex-shrink-0' style="width: 59.67px; height: 59.67px; background: rgba(110, 182, 229, 0.3);">
            <i class='fas fa-chart-line text-[#0B1F3B] text-xl'></i>
          </div>
          <div class='flex flex-col'>
            <span class='font-bold text-[#2D2D2D]' style="font-family: 'Open Sans'; font-size: 25px; line-height: 34px;">95%</span>
            <span class='font-normal text-[#2D2D2D]' style="font-family: 'Open Sans'; font-size: 18px; line-height: 25px;">Career Growth</span>
          </div>
        </div>

        <!-- Hiring Partners -->
        <div class='flex flex-row items-center gap-[10px]' style="width: 201.67px;">
          <div class='flex items-center justify-center rounded-full flex-shrink-0' style="width: 59.67px; height: 59.67px; background: rgba(110, 182, 229, 0.3);">
            <i class='fas fa-briefcase text-[#0B1F3B] text-xl'></i>
          </div>
          <div class='flex flex-col'>
            <span class='font-bold text-[#2D2D2D]' style="font-family: 'Open Sans'; font-size: 25px; line-height: 34px;">200+</span>
            <span class='font-normal text-[#2D2D2D]' style="font-family: 'Open Sans'; font-size: 18px; line-height: 25px;">Hiring Partners</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Content & Sidebar -->
    <div class='w-full mx-auto mb-12'>
      {{> alumni/sidebar}}
      {{> alumni/content}}
    </div>
  </div>
</div>

<script>
function alumniApp() {
  return {
    selectedKategoriId: {{#if kategoriId}}{{kategoriId}}{{else}}null{{/if}},
   kategoriList: {{#if kategoriList}}{{{json kategoriList}}}{{else}}[]{{/if}},

    kelasList: {{#if course}}{{{json course}}}{{else}}[]{{/if}},
    filteredKelasList: [],

    selectedKelas: '',
    selectedKelasId: '',
    searchQuery: '',

    currentPage: 1,
    totalPages: 1,
    totalItems: 0,
    loading: false,
    alumniItems: [],
    lang: '{{lang}}' || 'id',

    async init() {
      this.kelasList = this.kelasList.sort((a, b) =>
        (a.name || '').localeCompare(b.name || '')
      );
       this.filterKelasByKategori();
      await this.fetchAlumni();
    },
    filterKelasByKategori() {
      if (this.selectedKategoriId) {
        this.filteredKelasList = this.kelasList.filter(k =>  k.category?.id  == this.selectedKategoriId);
      } else {
        this.filteredKelasList = [...this.kelasList];
           }
    },

    // Hanya kelas/program yang sesuai kategori terpilih
    get filteredKelasList() {
      if (this.selectedKategoriId) {
        return this.kelasList.filter(k => k.kategori?.id == this.selectedKategoriId);
      }
      return this.kelasList;
    },

     async selectKategori(kategoriId) {
      this.selectedKategoriId = kategoriId;
  this.selectedKelasId = null;
      this.selectedKelas = '';
      this.currentPage = 1;
      
      this.filterKelasByKategori(); 
      await this.fetchAlumni();   
    },

    getByLang(obj, lang) {
      if (!obj || typeof obj !== 'object') return '';
      return obj[lang] || obj.id || obj.en || '';
    },

    filterPrograms() {
      const query = this.searchQuery.toLowerCase().trim();
       const baseList = this.selectedKategoriId 
        ? this.kelasList.filter(k => k.category?.id == this.selectedKategoriId)
        : this.kelasList;
         this.filteredKelasList = query
        ? baseList.filter(k => k.name.toLowerCase().includes(query))
        : [...baseList];
    },

    async fetchAlumni() {
      this.loading = true;
      try {
        const params = new URLSearchParams();
        if (this.searchQuery && this.searchQuery.trim() !== '') {
          params.set('search', this.searchQuery.trim());
        }

        // 2. Parameter Kelas ID
        if (this.selectedKelasId) {
          params.set('course_id', this.selectedKelasId);
        }

        // 3. Parameter Kategori ID
        if (this.selectedKategoriId) {
          params.set('category_id', this.selectedKategoriId);
        }
        params.set('page', this.currentPage);
        params.set('limit', 6);

        const res = await fetch(`/dashboard/alumni/filter?${params.toString()}`);
        const json = await res.json();

        this.alumniItems = json.data || [];
        this.totalItems = json.totalItems || 0;
        this.totalPages = json.totalPages || 1;
        this.currentPage = json.currentPage || 1; 
      } catch (err) {
        console.error('Fetch alumni error:', err);
      } finally {
        this.loading = false;
      }
    },

    async selectKelas(kelasId) {
      this.selectedKelasId = kelasId;
      this.currentPage = 1;

      if (kelasId) {
        const course = this.kelasList.find(k => k.id == kelasId);
        this.selectedKelas = course ? course.name : '';
      } else {
        this.selectedKelas = '';
        // Jika program dihapus, keep kategori tetap aktif
      }
      await this.fetchAlumni();
    },

    async changePage(page) {
      this.currentPage = page;
      await this.fetchAlumni();
    },

    async resetFilters() {
      this.selectedKelasId = null;
      this.selectedKelas = '';
      this.searchQuery = '';
      this.filterKelasByKategori();
      this.currentPage = 1;
      await this.fetchAlumni();
    },

    getKelasName(alumni) {
      return alumni.course?.name || 'Unknown';
    }
  };
}

document.addEventListener('alpine:init', () => {
  Alpine.data('alumniApp', alumniApp);
});
</script>
