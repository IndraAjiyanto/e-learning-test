<div class="pt-24 pb-16 min-h-screen bg-cover bg-top bg-no-repeat bg-fixed" style="background-image: url('/public/image/dashboard/bgAlumniPage.png');" x-data="alumniApp()">

  <div class="container mx-auto px-8 max-w-[1440px]">
    
    <!-- ALUMNI HEADER (Unified Mobile & Desktop) -->
    <div class="flex flex-col items-center pt-4 mb-6 lg:pt-0 lg:mb-[50px]">
      {{> components/alumni/badge text=(t 'test.alumni.alumni')}}
      
      <div class="flex flex-col items-center w-full gap-2 lg:gap-[10px]">
        {{> components/alumni/title title=(t 'test.alumni.title')}}
        <div class="w-10 h-1 mx-auto my-2 bg-[#0B1F3B] rounded-full lg:w-[70px] lg:h-[5px] lg:my-3 lg:rounded-[6px]"></div>
        {{> components/alumni/description text=(t 'test.alumni.description')}}
      </div>
    </div>

    <!-- ALUMNI STATS (Unified Mobile & Desktop) -->
    <div class="w-full max-w-[819px] mx-auto mb-8 lg:mb-[100px]">
      <div class="flex flex-col items-stretch justify-between gap-3 w-full lg:flex-row lg:items-center lg:gap-0 lg:h-[102px] lg:px-7 lg:bg-[rgba(224,241,249,0.5)] lg:rounded-[12px] lg:shadow-[0px_0px_5px_rgba(0,0,0,0.5)] lg:backdrop-blur-[3.3px]">
        
        <!-- Alumni Stat -->
        <div class="flex items-center gap-4 p-4 shadow-xs w-full bg-white/90 border border-[#E0F1F9] rounded-[16px] lg:flex-row lg:items-center lg:gap-[10px] lg:w-[208.67px] lg:p-0 lg:bg-transparent lg:border-0 lg:rounded-none lg:shadow-none">
          <div class="flex items-center justify-center shrink-0 size-12 rounded-[12px] text-[#0B1F3B] bg-[#E0F1F9] lg:size-[59.67px] lg:rounded-full lg:bg-[#6EB6E5]/30">
            <i class="fas fa-users text-lg lg:text-xl"></i>
          </div>
          <div class="flex flex-col">
            <span class="font-sans font-bold text-[22px] text-[#2D2D2D] leading-none lg:text-[25px] lg:leading-[34px]">1,000+</span>
            <span class="font-sans font-normal text-[13px] text-[#676767] leading-none mt-1 lg:mt-0 lg:text-[18px] lg:text-[#2D2D2D] lg:leading-[25px]">{{t 'test.alumni.statAlumni'}}</span>
          </div>
        </div>

        <!-- Career Growth Stat -->
        <div class="flex items-center gap-4 p-4 shadow-xs w-full bg-white/90 border border-[#E0F1F9] rounded-[16px] lg:flex-row lg:items-center lg:gap-[10px] lg:w-[199.67px] lg:p-0 lg:bg-transparent lg:border-0 lg:rounded-none lg:shadow-none">
          <div class="flex items-center justify-center shrink-0 size-12 rounded-[12px] text-[#0B1F3B] bg-[#E0F1F9] lg:size-[59.67px] lg:rounded-full lg:bg-[#6EB6E5]/30">
            <i class="fas fa-chart-line text-lg lg:text-xl"></i>
          </div>
          <div class="flex flex-col">
            <span class="font-sans font-bold text-[22px] text-[#2D2D2D] leading-none lg:text-[25px] lg:leading-[34px]">95%</span>
            <span class="font-sans font-normal text-[13px] text-[#676767] leading-none mt-1 lg:mt-0 lg:text-[18px] lg:text-[#2D2D2D] lg:leading-[25px]">{{t 'test.alumni.statCareerGrowth'}}</span>
          </div>
        </div>

        <!-- Hiring Partners Stat -->
        <div class="flex items-center gap-4 p-4 shadow-xs w-full bg-white/90 border border-[#E0F1F9] rounded-[16px] lg:flex-row lg:items-center lg:gap-[10px] lg:w-[201.67px] lg:p-0 lg:bg-transparent lg:border-0 lg:rounded-none lg:shadow-none">
          <div class="flex items-center justify-center shrink-0 size-12 rounded-[12px] text-[#0B1F3B] bg-[#E0F1F9] lg:size-[59.67px] lg:rounded-full lg:bg-[#6EB6E5]/30">
            <i class="fas fa-briefcase text-lg lg:text-xl"></i>
          </div>
          <div class="flex flex-col">
            <span class="font-sans font-bold text-[22px] text-[#2D2D2D] leading-none lg:text-[25px] lg:leading-[34px]">200+</span>
            <span class="font-sans font-normal text-[13px] text-[#676767] leading-none mt-1 lg:mt-0 lg:text-[18px] lg:text-[#2D2D2D] lg:leading-[25px]">{{t 'test.alumni.statHiringPartners'}}</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Content & Sidebar -->
    <div class="w-full mx-auto">
      {{> alumni/sidebar}}
      {{> alumni/content}}
    </div>
  </div>
</div>

<script>
function alumniApp() {
  return {
    selectedKategoriId: {{#if kategoriId}}{{kategoriId}}{{else}}null{{/if}},

    kelasList: {{#if course}}{{{json course}}}{{else}}[]{{/if}},
    filteredKelasList: [],

    selectedKelas: '',
    selectedKelasId: '',
    searchQuery: '',

    currentPage: 1,
    totalPages: 1,
    alumniItems: [],
    lang: '{{lang}}' || 'id',
    unknown: "{{t 'test.alumni.unknown'}}",
    loading: false,

    async init() {
      this.kelasList = this.kelasList.sort((a, b) =>
        (a.name || '').localeCompare(b.name || '')
      );
      this.filterKelasByKategori();
      await this.fetchAlumni();
    },
    filterKelasByKategori() {
      if (this.selectedKategoriId) {
        this.filteredKelasList = this.kelasList.filter(k => k.category?.id == this.selectedKategoriId);
      } else {
        this.filteredKelasList = [...this.kelasList];
      }
    },

    async selectKategori(kategoriId) {
      this.selectedKategoriId = kategoriId;
      this.selectedKelasId = null;
      this.selectedKelas = '';
      this.currentPage = 1;
      
      this.filterKelasByKategori(); 
      await this.fetchAlumni();   
    },

    getByLang(obj, lang) {
      if (!obj) return '';
      if (typeof obj === 'string') return obj;
      if (typeof obj !== 'object') return '';
      return obj[lang] || obj.id || obj.en || '';
    },

    filterPrograms() {
      const query = this.searchQuery.toLowerCase().trim();
      const baseList = this.selectedKategoriId 
        ? this.kelasList.filter(k => k.category?.id == this.selectedKategoriId)
        : this.kelasList;
      this.filteredKelasList = query
        ? baseList.filter(k => k.name.toLowerCase().includes(query))
        : [...baseList];
    },

    async fetchAlumni() {
      this.loading = true;
      try {
        const params = new URLSearchParams();
        if (this.searchQuery && this.searchQuery.trim() !== '') {
          params.set('search', this.searchQuery.trim());
        }

        if (this.selectedKelasId) {
          params.set('course_id', this.selectedKelasId);
        }

        if (this.selectedKategoriId) {
          params.set('category_id', this.selectedKategoriId);
        }
        params.set('page', this.currentPage);
        params.set('limit', 6);

        const res = await fetch(`/dashboard/alumni/filter?${params.toString()}`);
        const json = await res.json();

        this.alumniItems = json.data || [];
        this.totalItems = json.totalItems || 0;
        this.totalPages = json.totalPages || 1;
        this.currentPage = json.currentPage || 1;
      } catch (err) {
        console.error('Fetch alumni error:', err);
      } finally {
        this.loading = false;
      }
    },

    async selectKelas(kelasId) {
      this.selectedKelasId = kelasId;
      this.currentPage = 1;

      if (kelasId) {
        const course = this.kelasList.find(k => k.id == kelasId);
        this.selectedKelas = course ? course.name : '';
      } else {
        this.selectedKelas = '';
        // Jika program dihapus, keep kategori tetap aktif
      }
      await this.fetchAlumni();
    },

    async changePage(page) {
      this.currentPage = page;
      await this.fetchAlumni();
    },

    async resetFilters() {
      this.selectedKelasId = null;
      this.selectedKelas = '';
      this.searchQuery = '';
      this.filterKelasByKategori();
      this.currentPage = 1;
      await this.fetchAlumni();
    },

    getKelasName(alumni) {
      const name = alumni.course?.name;
      return name ? (typeof name === 'object' ? this.getByLang(name, this.lang) : name) : this.unknown;
    }
  };
}

document.addEventListener('alpine:init', () => {
  Alpine.data('alumniApp', alumniApp);
});
</script>
