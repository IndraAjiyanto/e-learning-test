<div class='pt-24 min-h-screen bg-white' x-data='alumniApp()' x-init='init()'>

  <div class='container mx-auto px-4 pb-16'>
    <div class='text-center mb-12'>
      <h1 class='text-4xl font-bold text-gray-900 mb-4 font-montserrat'>{{t
          'test.alumni.tittle'
        }}</h1>
      <p class='text-gray-600 max-w-2xl mx-auto text-lg'>
        {{t 'test.alumni.description'}}
      </p>
    </div>

    <div class='grid grid-cols-1 lg:grid-cols-4 gap-8'>

{{> alumni/sidebar}}
{{> alumni/content}}
    </div>
  </div>
</div>

<script>
function alumniApp() {
  return {

    // ============================
    // State
    // ============================
    allAlumni: {{#if alumni}}{{{json alumni}}}{{else}}[]{{/if}},
    displayedAlumni: [],

    kelasList: {{#if kelas}}{{{json kelas}}}{{else}}[]{{/if}},
    filteredKelasList: [],

    selectedKelas: '',
    selectedKelasId: '',
    searchQuery: '',

    currentPage: 1,
    itemsPerPage: 6,
    totalPages: 1,

    loading: false,
    lang: '{{lang}}' || 'id',

    // ============================
    // Init
    // ============================
    init() {
      this.kelasList = this.kelasList.sort((a, b) =>
        a.nama_kelas.localeCompare(b.nama_kelas)
      );

      this.filteredKelasList = [...this.kelasList];
      this.filterAndPaginate();
    },

    // ============================
    // Helper: get text by language
    // ============================
    getByLang(obj, lang) {
      if (!obj || typeof obj !== 'object') return '';
      return obj[lang] || obj.id || obj.en || '';
    },

    // ============================
    // Filter kelas by search query
    // ============================
    filterPrograms() {
      if (this.searchQuery.trim() === '') {
        this.filteredKelasList = [...this.kelasList];
      } else {
        const query = this.searchQuery.toLowerCase().trim();

        this.filteredKelasList = this.kelasList.filter(kelas =>
          kelas.nama_kelas.toLowerCase().includes(query)
        );
      }
    },

    // ============================
    // Filtering + Pagination alumni
    // ============================
    filterAndPaginate() {
      let filtered = this.allAlumni;

      // Filter by kelas
      if (this.selectedKelasId) {
        filtered = filtered.filter(
          alumni => alumni.kelas && alumni.kelas.id == this.selectedKelasId
        );
      }

      this.totalPages = Math.ceil(filtered.length / this.itemsPerPage);

      const startIndex = (this.currentPage - 1) * this.itemsPerPage;
      const endIndex = startIndex + this.itemsPerPage;

      this.displayedAlumni = filtered.slice(startIndex, endIndex);
    },

    // ============================
    // Getter: alumni untuk UI
    // ============================
    get alumniItems() {
      return this.displayedAlumni || [];
    },

    // ============================
    // Getter: total alumni setelah filter
    // ============================
    get totalItems() {
      let filtered = this.allAlumni;

      if (this.selectedKelasId) {
        filtered = filtered.filter(
          alumni => alumni.kelas && alumni.kelas.id == this.selectedKelasId
        );
      }

      return filtered.length;
    },

    // ============================
    // Select kelas
    // ============================
    selectKelas(kelasId) {
      this.selectedKelasId = kelasId;
      this.currentPage = 1;

      this.filterAndPaginate();

      if (kelasId) {
        const kelas = this.kelasList.find(k => k.id == kelasId);
        this.selectedKelas = kelas ? kelas.nama_kelas : '';
      } else {
        this.selectedKelas = '';
      }
    },

    // ============================
    // Pagination
    // ============================
    changePage(page) {
      this.currentPage = page;
      this.filterAndPaginate();
    },

    // ============================
    // Reset filter
    // ============================
    resetFilters() {
      this.selectedKelasId = null;
      this.selectedKelas = '';
      this.searchQuery = '';

      this.filteredKelasList = [...this.kelasList];
      this.currentPage = 1;

      this.filterAndPaginate();
    },

    // ============================
    // Helper: ambil nama kelas alumni
    // ============================
    getKelasName(alumni) {
      return alumni.kelas?.nama_kelas || 'Unknown';
    }

  };
}

document.addEventListener('alpine:init', () => {
  Alpine.data('alumniApp', alumniApp);
});
</script>