<div class='pt-24 min-h-screen bg-white' x-data='portfolioApp()'>
  <div class='container mx-auto px-4 pb-16'>

{{> portfolio/header}}

    <div class='grid grid-cols-1 lg:grid-cols-4 gap-8'>

{{> portfolio/filter}}

{{> portfolio/portfolio}}


      </div>

      </div>
    </div>
  </div>
</div>

<script>
  function portfolioApp() {
    return {
      allKategori: {{{json kategori}}},
      allJenisKelas: {{{json jenis_kelas}}},
      filteredKategoriList: [],
      filteredJenisKelasList: [],
      selectedKategori: '',
      selectedJenisKelas: '',
      selectedKategoriId: '',
      selectedJenisKelasId: '',
      searchKategoriQuery: '',
      searchJenisKelasQuery: '',
      currentPage: 1,
      totalPages: 1,
      totalItems: 0,
      loading: false,
      portfolioItems: [],
      lang: '{{lang}}',

      async init() {
        this.allKategori = this.allKategori.sort((a, b) =>
          a.nama_kategori.localeCompare(b.nama_kategori)
        );
        this.allJenisKelas = this.allJenisKelas.sort((a, b) =>
          a.nama_jenis_kelas.localeCompare(b.nama_jenis_kelas)
        );
        this.filteredKategoriList = [...this.allKategori];
        this.filteredJenisKelasList = [...this.allJenisKelas];
        await this.fetchPortfolio();
      },

      getByLang(obj, lang) {
        if (!obj || typeof obj !== 'object') return '';
        return obj[lang] || obj.id || obj.en || '';
      },

      filterKategori() {
        const query = this.searchKategoriQuery.toLowerCase().trim();
        this.filteredKategoriList = query
          ? this.allKategori.filter(k => k.nama_kategori.toLowerCase().includes(query))
          : [...this.allKategori];
      },

      filterJenisKelas() {
        const query = this.searchJenisKelasQuery.toLowerCase().trim();
        this.filteredJenisKelasList = query
          ? this.allJenisKelas.filter(j =>
              this.getByLang(j.nama_jenis_kelas, this.lang).toLowerCase().includes(query)
            )
          : [...this.allJenisKelas];
      },

      async fetchPortfolio() {
        this.loading = true;
        try {
          const params = new URLSearchParams();
          if (this.selectedKategoriId) params.set('kategori_id', this.selectedKategoriId);
          if (this.selectedJenisKelasId) params.set('jenis_kelas_id', this.selectedJenisKelasId);
          params.set('page', this.currentPage);
          params.set('limit', 6);

          const res = await fetch(`/dashboard/portofolio/filter?${params.toString()}`);
          const json = await res.json();

          this.portfolioItems = json.data;
          this.totalItems = json.totalItems;
          this.totalPages = json.totalPages;
          this.currentPage = json.currentPage;
        } catch (err) {
        } finally {
          this.loading = false;
        }
      },

      async selectKategori(kategoriId) {
        this.selectedKategoriId = kategoriId;
        this.currentPage = 1;
        if (kategoriId) {
          const kat = this.allKategori.find(k => k.id == kategoriId);
          this.selectedKategori = kat ? kat.nama_kategori : '';
        } else {
          this.selectedKategori = '';
        }
        await this.fetchPortfolio();
      },

      async selectJenisKelas(jenisKelasId) {
        this.selectedJenisKelasId = jenisKelasId;
        this.currentPage = 1;
        if (jenisKelasId) {
          const jenis = this.allJenisKelas.find(j => j.id == jenisKelasId);
          this.selectedJenisKelas = jenis ? jenis.nama_jenis_kelas : '';
        } else {
          this.selectedJenisKelas = '';
        }
        await this.fetchPortfolio();
      },

      async changePage(page) {
        this.currentPage = page;
        await this.fetchPortfolio();
      },

      async resetFilters() {
        this.selectedKategoriId = '';
        this.selectedJenisKelasId = '';
        this.selectedKategori = '';
        this.selectedJenisKelas = '';
        this.searchKategoriQuery = '';
        this.searchJenisKelasQuery = '';
        this.filteredKategoriList = [...this.allKategori];
        this.filteredJenisKelasList = [...this.allJenisKelas];
        this.currentPage = 1;
        await this.fetchPortfolio();
      },

      getCategoryName(item) {
        return item.kelas?.kategori?.nama_kategori
          || item.kategori?.nama_kategori
          || item.kelas?.nama_kategori
          || null;
      },

      getJenisKelasName(item) {
        return item.kelas?.jenis_kelas?.nama_jenis_kelas
          || item.jenis_kelas?.nama_jenis_kelas
          || item.kelas?.nama_jenis_kelas
          || null;
      }
    };
  }
</script>
