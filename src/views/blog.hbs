<div class='pt-24 min-h-screen bg-gray-50 ' x-data='blogApp()'>
  <div class='container mx-auto max-w-7xl px-6  pb-16'>

{{> blog/header}}

{{> blog/blog_trending}}

{{> blog/main}}

  </div>
</div>

<script>
  function blogApp() {
  return {
    allKategori: {{{json kategori_blog}}},
    excludeIds: {{{json excludeIds}}},
    filteredKategoriList: [],
    selectedKategori: '',
    selectedKategoriId: '',
    searchKategoriQuery: '',
    searchQuery: '',
    currentPage: 1,
    itemsPerPage: 9,
    totalPages: 1,
    totalItems: 0,
    loading: false,
    lang: `{{lang}}`,
    blogItems: [],
    slideStates: {},
    likedStates: {},
    searchTimeout: null,

    async init() {
      this.filteredKategoriList = [...this.allKategori];
      await this.fetchBlog();
    },

    async fetchBlog() {
      this.loading = true;
      try {
        const params = new URLSearchParams();
        if (this.selectedKategoriId) params.set('kategori_id', this.selectedKategoriId);
        if (this.searchQuery.trim()) params.set('search', this.searchQuery.trim());
    if (!this.selectedKategoriId && this.excludeIds?.length > 0) {
      params.set('exclude_ids', this.excludeIds.join(','));
    }
        params.set('page', this.currentPage);
        params.set('limit', this.itemsPerPage);

        const res = await fetch(`/blog/filter?${params.toString()}`);
        const json = await res.json();

        this.blogItems = json.data;
        this.totalItems = json.totalItems;
        this.totalPages = json.totalPages;
        this.currentPage = json.currentPage;

        this.blogItems.forEach(item => this.initCard(item));
      } catch (err) {
        console.error('Fetch blog error:', err);
      } finally {
        this.loading = false;
      }
    },

    handleSearch() {
      clearTimeout(this.searchTimeout);
      this.searchTimeout = setTimeout(() => {
        this.currentPage = 1;
        this.fetchBlog();
      }, 300);
    },

    initCard(item) {
      if (this.slideStates[item.id] === undefined) {
        this.slideStates[item.id] = 0;
      }
      if (this.likedStates[item.id] === undefined) {
        const currentUserId = {{#if user}}{{user.id}}{{else}}null{{/if}};
        this.likedStates[item.id] = currentUserId !== null
          && Array.isArray(item.likes)
          && item.likes.some(like => like.user?.id == currentUserId);
      }
    },

    getSlide(itemId) {
      return this.slideStates[itemId] || 0;
    },

    setSlide(itemId, index) {
      this.slideStates[itemId] = index;
    },

    nextSlide(item) {
      const len = Array.isArray(item.gambar) ? item.gambar.length : 1;
      this.slideStates[item.id] = (this.getSlide(item.id) + 1) % len;
    },

    prevSlide(item) {
      const len = Array.isArray(item.gambar) ? item.gambar.length : 1;
      this.slideStates[item.id] = this.getSlide(item.id) === 0 ? len - 1 : this.getSlide(item.id) - 1;
    },

    isLiked(item) {
      return this.likedStates[item.id] || false;
    },

    filterKategori() {
      if (this.searchKategoriQuery.trim() === '') {
        this.filteredKategoriList = [...this.allKategori];
      } else {
        const query = this.searchKategoriQuery.toLowerCase().trim();
        this.filteredKategoriList = this.allKategori.filter(category =>
          this.getLocalizedText(category.name)?.toLowerCase().includes(query)
        );
      }
    },

    getLocalizedText(obj) {
      if (!obj) return '';
      if (typeof obj === 'string') {
        try { obj = JSON.parse(obj); } catch { return obj; }
      }
      return obj[this.lang] || obj['id'] || obj['en'] || Object.values(obj)[0] || '';
    },

    async selectKategori(kategoriId) {
      this.selectedKategoriId = kategoriId;
      this.currentPage = 1;
      if (kategoriId) {
        const kat = this.allKategori.find(k => k.id == kategoriId);
        this.selectedKategori = kat ? this.getLocalizedText(kat.name) : '';
      } else {
        this.selectedKategori = '';
      }
      await this.fetchBlog();
    },

    async changePage(page) {
      this.currentPage = page;
      await this.fetchBlog();
    },

    async resetFilters() {
      this.selectedKategoriId = '';
      this.selectedKategori = '';
      this.searchKategoriQuery = '';
      this.searchQuery = '';
      this.filteredKategoriList = [...this.allKategori];
      this.currentPage = 1;
      await this.fetchBlog();
    },

    getCategoryName(item) {
      return this.getLocalizedText(item.kategori_blog?.name) || null;
    },

    viewBlog(id) {
      fetch('/blog/view/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      })
      .then(res => res.json())
      .catch(err => console.error('Error view blog:', err));
    },

    computeIcon(iconValue) {
      const raw = (iconValue || '').toString().trim();
      if (!raw) return 'fa-solid fa-circle-question';
      if (/^fa-/.test(raw)) return 'fa-solid ' + raw;
      return raw;
    },
  }
}
</script>

