<div class='pt-24 min-h-screen bg-white' x-data='blogApp()'>
  <div class='container mx-auto px-4 pb-16'>
    <div class='text-center mb-12'>
      <h1 class='text-4xl font-bold text-gray-900 mb-4 font-montserrat'>{{t "test.blog.tittle"}}</h1>
      <p class='text-gray-600 max-w-2xl mx-auto text-lg font-inter'>
        {{t "test.blog.description"}}
      </p>
    </div>

    <div class='grid grid-cols-1 lg:grid-cols-4 gap-8'>
      <div class='lg:col-span-1'>
        <div
          class='bg-white rounded-xl shadow-sm border border-gray-200 p-6 sticky top-6'
        >
          <div class='mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200'>
            <div class='flex items-center justify-between mb-3'>
              <h4 class='text-sm font-semibold text-gray-700 font-montserrat'>{{t "test.blog.filterTittle"}}</h4>
              <button
                @click='resetFilters()'
                class='text-xs text-gray-500 hover:text-gray-700 transition-colors flex items-center'
              >
                <i class='fas fa-undo-alt mr-1 text-xs'></i>
                {{t "test.blog.resetFilters"}}
              </button>
            </div>
            <div class='space-y-2'>
              <template
                x-if="selectedKategori === ''"
              >
                <div
                  class='text-xs text-gray-500 text-center py-2 bg-white rounded border border-gray-200'
                >
                  {{t "test.blog.noFilters"}}
                </div>
              </template>

              <template x-if="selectedKategori !== ''">
                <span
                  class='block px-3 py-1 text-xs rounded-full bg-gray-100 text-gray-700 font-medium border'
                >
                  <span x-text='selectedKategori'></span>
                </span>
              </template>
            </div>
          </div>

          <div class='mb-6'>
            <h3
              class='text-base font-semibold text-gray-900 mb-3 flex items-center font-montserrat'
            >
              <i class='fas fa-tags text-gray-500 mr-2'></i>
                {{t "test.blog.categoryTittle"}}
            </h3>

            <div class='mb-3'>
              <div class='relative'>
                <input
                  type='text'
                  x-model='searchKategoriQuery'
                  @input='filterKategori()'
                  placeholder='{{t "test.blog.searchCategoryPlaceholder"}}'
                  class='w-full text-gray-600 px-4 py-3 pl-10 bg-white rounded-lg border border-gray-300 focus:border-gray-700 focus:ring-2 focus:ring-gray-700 transition-all duration-200'
                />
                <i
                  class='fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400'
                ></i>
              </div>
            </div>

            <div class='space-y-2 max-h-64 overflow-y-auto'>
              <button
                @click="selectKategori('')"
                :class="selectedKategoriId === '' ? 'bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white' : 'bg-white text-gray-700'"
                class='w-full px-4 py-3 rounded-lg font-medium transition-all duration-200 flex items-center justify-between border border-gray-300'
              >
                <span class='text-sm text-left'>{{t "test.blog.allCategory"}}</span>
              </button>
              <template x-for='kategori in filteredKategoriList' :key='kategori.id'>
                <button
                  @click='selectKategori(kategori.id)'
                  :class="selectedKategoriId == kategori.id ? 'bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white' : 'bg-white text-gray-700'"
                  class='w-full px-4 py-3 rounded-lg font-medium transition-all duration-200 flex items-center justify-between border border-gray-300'
                >
                  <span class='text-sm' x-text='kategori.nama'></span>
                </button>
              </template>
            </div>
          </div>

          <div class='mt-6 p-4 bg-gray-50 rounded-lg border border-gray-200'>
            <div class='text-center'>
              <div
                class='text-2xl font-bold text-gray-900'
                x-text='totalItems'
              ></div>
              <div class='text-sm text-gray-600'>{{t "test.blog.projectAvailable"}}</div>
            </div>
          </div>
        </div>
      </div>

      <div class='lg:col-span-3'>
        <div
          x-show='loading'
          class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'
        >
          <template x-for='i in 6' :key='i'>
            <div
              class='bg-white border border-gray-200 rounded-xl shadow-lg animate-pulse'
            >
              <div class='h-44 bg-gray-200 rounded-t-xl'></div>
              <div class='p-6 space-y-4'>
                <div class='h-4 bg-gray-200 rounded w-3/4'></div>
                <div class='h-4 bg-gray-200 rounded w-1/2'></div>
                <div class='h-20 bg-gray-200 rounded'></div>
              </div>
            </div>
          </template>
        </div>

        <div
          x-show='!loading'
          class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'
        >
          <template
            x-for='item in blogItems'
            :key='item.id'
            x-data='{ currentSlide: 0, autoSlide: null }'
            x-init="
                            // Handle multiple images
                            const images = Array.isArray(item.gambar) ? item.gambar : [item.gambar || 'https://via.placeholder.com/400x300?text=No+Image'];
                            // Auto slide jika ada lebih dari 1 gambar
                            if (images.length > 1) {
                                autoSlide = setInterval(() => { 
                                    currentSlide = (currentSlide + 1) % images.length 
                                }, 3000);
                            }
                        "
            @mouseenter='if (autoSlide) clearInterval(autoSlide)'
            @mouseleave='if (Array.isArray(item.gambar) && item.gambar.length > 1) autoSlide = setInterval(() => { currentSlide = (currentSlide + 1) % (Array.isArray(item.gambar) ? item.gambar.length : 1) }, 3000)'
          >

            <div
              class='bg-white border border-gray-200 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1'
            >
              <div class='relative overflow-hidden rounded-t-xl'>
                <div class='relative h-44 w-full'>
                  <template
                    x-for="(image, index) in (Array.isArray(item.gambar) ? item.gambar : [item.gambar || 'https://via.placeholder.com/400x300?text=No+Image'])"
                    :key='index'
                  >
                    <img
                      :src='image'
                      :alt="item.judul + ' - Image ' + (index + 1)"
                      class='absolute inset-0 w-full h-44 object-cover transition-opacity duration-500'
                      :class="{ 'opacity-100': currentSlide === index, 'opacity-0': currentSlide !== index }"
                    />
                  </template>
                </div>

                <template
                  x-if='Array.isArray(item.gambar) && item.gambar.length > 1'
                >
                  <div>
                    <button
                      @click='currentSlide = currentSlide === 0 ? (Array.isArray(item.gambar) ? item.gambar.length : 1) - 1 : currentSlide - 1'
                      class='absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-800 rounded-full p-2 shadow-md transition-all duration-200 hover:scale-110 z-10'
                    >
                      <svg
                        class='w-4 h-4'
                        fill='none'
                        stroke='currentColor'
                        viewBox='0 0 24 24'
                      >
                        <path
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          stroke-width='2'
                          d='M15 19l-7-7 7-7'
                        ></path>
                      </svg>
                    </button>
                    <button
                      @click='currentSlide = (currentSlide + 1) % (Array.isArray(item.gambar) ? item.gambar.length : 1)'
                      class='absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-800 rounded-full p-2 shadow-md transition-all duration-200 hover:scale-110 z-10'
                    >
                      <svg
                        class='w-4 h-4'
                        fill='none'
                        stroke='currentColor'
                        viewBox='0 0 24 24'
                      >
                        <path
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          stroke-width='2'
                          d='M9 5l7 7-7 7'
                        ></path>
                      </svg>
                    </button>
                  </div>
                </template>

                <div
                  class='absolute top-3 left-3 bg-white/95 backdrop-blur-sm text-gray-800 text-xs px-3 py-1 rounded-md shadow-md'
                >
                  <span x-text="item.author"></span>
                </div>

                <template
                  x-if='Array.isArray(item.gambar) && item.gambar.length > 1'
                >
                  <div
                    class='absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2'
                  >
                    <template
                      x-for='(image, index) in item.gambar'
                      :key='index'
                    >
                      <button
                        @click='currentSlide = index'
                        class='w-2 h-2 rounded-full transition-all duration-200'
                        :class="{ 'bg-white': currentSlide === index, 'bg-white/50': currentSlide !== index }"
                      ></button>
                    </template>
                  </div>
                </template>
              </div>

              <div class='p-6 space-y-4'>
                <div class='flex flex-wrap gap-1'>
                  <span
                    class='badge bg-gradient-to-br from-primary via-secondary to-gray-900  text-white px-3 py-1 text-xs font-semibold rounded-full'
                    x-text="getCategoryName(item) || 'No Type'"
                  >
                  </span>
                </div>

                <h3
                  class='text-lg font-semibold text-gray-900 leading-tight'
                  x-text="item.judul || 'No Title'"
                ></h3>


                <div class='mt-6'>
                  <a
                    :href="'/blog/detail/' + item.id"
                    class='btn bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white text-lg px-8 py-3 w-full border-0 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1'
                  >
                    {{t "test.blog.detailButton"}}
                  </a>
                </div>
              </div>
            </div>
          </template>
        </div>

        <div
          x-show='!loading && blogItems.length === 0'
          class='text-center py-12'
        >
          <div
            class='w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4'
          >
            <i class='fas fa-search text-gray-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-semibold text-gray-900 mb-2 font-montserrat'>{{t "test.blog.blogNotFound"}}</h3>
          <p class='text-gray-600 mb-6 font-inter'>{{t "test.blog.tryAdjusting"}}</p>
          <button
            @click='resetFilters()'
            class='bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white px-6 py-3 rounded-lg  transition-all duration-300'
          >
            {{t "test.blog.resetAllFilters"}}
          </button>
        </div>
        </div>

        <div
          class='flex justify-center items-center gap-4 mt-12'
          x-show='!loading && totalPages > 1'
        >
          <button
            @click='changePage(Math.max(1, currentPage - 1))'
            :disabled='currentPage === 1 || loading'
            class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'
          >
            <i class='fas fa-chevron-left'></i>
          </button>

          <template x-for='page in totalPages' :key='page'>
            <button
              @click='changePage(page)'
              :disabled='loading'
              class='w-12 h-12 rounded-xl text-lg font-semibold transition-all duration-300 border shadow-sm disabled:opacity-50'
              :class="currentPage === page ? 'bg-gradient-to-r from-slate-600 to-slate-800 text-white border-slate-700 shadow-md' : 'bg-white text-gray-700 border-gray-300 hover:bg-slate-50'"
              x-text='page'
            ></button>
          </template>

          <button
            @click='changePage(Math.min(totalPages, currentPage + 1))'
            :disabled='currentPage === totalPages || loading'
            class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'
          >
            <i class='fas fa-chevron-right'></i>
          </button>
        </div>
      </div>
      </div>
    </div>
  </div>
</div>

<script>
  function blogApp() {
    return {
      allBlog: {{#if blog}}{{{json blog}}}{{else}}[]{{/if}},
      displayedBlog: [],
      allKategori: {{{json kategori_blog}}},
      filteredKategoriList: [],
      selectedKategori: '',
      selectedKategoriId: '',
      searchKategoriQuery: '',
      currentPage: 1,
      itemsPerPage: 6,
      totalPages: 1,
      loading: false,
      lang: '{{lang}}',

      init() {
        this.allKategori = this.allKategori.sort((a, b) =>
          a.nama.localeCompare(b.nama)
        );
        this.filteredKategoriList = [...this.allKategori];
        this.filterAndPaginate();
      },

      getByLang(obj, lang) {
        if (!obj || typeof obj !== 'object') return '';
        return obj[lang] || obj.id || obj.en || '';
      },

      filterKategori() {
        if (this.searchKategoriQuery.trim() === '') {
          this.filteredKategoriList = [...this.allKategori];
        } else {
          const query = this.searchKategoriQuery.toLowerCase().trim();
          this.filteredKategoriList = this.allKategori.filter(kategori =>
            kategori.nama.toLowerCase().includes(query)
          );
        }
      },

      filterAndPaginate() {
        let filtered = this.allBlog;
        
        if (this.selectedKategoriId) {
          filtered = filtered.filter(item => {
            const kategoriId = item.kategori_blog?.id;
            return kategoriId == this.selectedKategoriId;
          });
        }
        
        this.totalPages = Math.ceil(filtered.length / this.itemsPerPage);
        
        const startIndex = (this.currentPage - 1) * this.itemsPerPage;
        const endIndex = startIndex + this.itemsPerPage;
        
        this.displayedBlog = filtered.slice(startIndex, endIndex);
      },

      get blogItems() {
        return this.displayedBlog || [];
      },

      get totalItems() {
        let filtered = this.allBlog;
        
        if (this.selectedKategoriId) {
          filtered = filtered.filter(item => {
            const kategoriId = item.kategori_blog?.id;
            return kategoriId == this.selectedKategoriId;
          });
        }
        
        return filtered.length;
      },

      selectKategori(kategoriId) {
        this.selectedKategoriId = kategoriId;
        this.currentPage = 1;
        this.filterAndPaginate();
        
        if (kategoriId) {
          const kat = this.allKategori.find(k => k.id == kategoriId);
          this.selectedKategori = kat ? kat.nama : '';
        } else {
          this.selectedKategori = '';
        }
      },

      changePage(page) {
        this.currentPage = page;
        this.filterAndPaginate();
      },

      resetFilters() {
        this.selectedKategoriId = '';
        this.selectedKategori = '';
        this.searchKategoriQuery = '';
        this.filteredKategoriList = [...this.allKategori];
        this.currentPage = 1;
        this.filterAndPaginate();
      },

      getCategoryName(item) {
        if (item.kategori_blog?.nama)
          return item.kategori_blog.nama;
        return null;
      },
  }
  }
</script>
