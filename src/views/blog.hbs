<div class='pt-24 min-h-screen bg-gray-50 ' x-data='blogApp()'>
  <div class='container mx-auto max-w-7xl px-6  pb-16'>

{{> blog/header}}

{{> blog/blog_trending}}

{{> blog/main}}

  </div>
</div>

<script>
  function blogApp() {
    return {
      allBlog: {{{json blog}}},
      displayedBlog: [],
      allKategori: {{{json kategori_blog}}},
      filteredKategoriList: [],
      selectedKategori: '',
      selectedKategoriId: '',
      searchKategoriQuery: '',
      searchQuery: '',
      currentPage: 1,
      itemsPerPage: 9,
      totalPages: 1,
      loading: false,
      lang: {{lang}},
      slideStates: {},   
      likedStates: {},    
      searchTimeout: null,

      init() {
        this.filterAndPaginate();
      },

      handleSearch() {
        clearTimeout(this.searchTimeout);
        this.searchTimeout = setTimeout(() => {
          this.currentPage = 1;
          this.filterAndPaginate();
        }, 300);
      },

      initCard(item) {
        if (this.slideStates[item.id] === undefined) {
          this.slideStates[item.id] = 0;
        }
        if (this.likedStates[item.id] === undefined) {
          const currentUserId = {{#if user}}{{user.id}}{{else}}null{{/if}};
          this.likedStates[item.id] = currentUserId !== null
            && Array.isArray(item.likes)
            && item.likes.some(like => like.user?.id == currentUserId);
        }
      },

      getSlide(itemId) {
        return this.slideStates[itemId] || 0;
      },

      setSlide(itemId, index) {
        this.slideStates[itemId] = index;
      },

      nextSlide(item) {
        const len = Array.isArray(item.gambar) ? item.gambar.length : 1;
        this.slideStates[item.id] = (this.getSlide(item.id) + 1) % len;
      },

      prevSlide(item) {
        const len = Array.isArray(item.gambar) ? item.gambar.length : 1;
        this.slideStates[item.id] = this.getSlide(item.id) === 0 ? len - 1 : this.getSlide(item.id) - 1;
      },

      isLiked(item) {
        return this.likedStates[item.id] || false;
      },

      getKategoriCount(kategoriId) {
        let filtered = this.allBlog;
        
        filtered = filtered.filter(item => item.kategori_blog?.id == kategoriId);
        
        if (this.searchQuery.trim() !== '') {
          const query = this.searchQuery.toLowerCase().trim();
          filtered = filtered.filter(item => {
            return item.judul?.toLowerCase().includes(query) ||
                   item.description?.toLowerCase().includes(query) ||
                   item.tags?.some(tag => tag.toLowerCase().includes(query));
          });
        }
        
        return filtered.length;
      },

      filterKategori() {
        if (this.searchKategoriQuery.trim() === '') {
          this.filteredKategoriList = [...this.allKategori];
        } else {
          const query = this.searchKategoriQuery.toLowerCase().trim();
          this.filteredKategoriList = this.allKategori.filter(kategori =>
            kategori.nama[this.lang]?.toLowerCase().includes(query)
          );
        }
      },

      filterAndPaginate() {
        let filtered = this.allBlog;
        
        if (this.selectedKategoriId) {
          filtered = filtered.filter(item => {
            const kategoriId = item.kategori_blog?.id;
            return kategoriId == this.selectedKategoriId;
          });
        }
        
        // Filter berdasarkan pencarian
        if (this.searchQuery.trim() !== '') {
          const query = this.searchQuery.toLowerCase().trim();
          filtered = filtered.filter(item => {
            // Cari di judul
            const matchJudul = item.judul?.toLowerCase().includes(query);
            // Cari di deskripsi
            const matchDeskripsi = item.description?.toLowerCase().includes(query);
            // Cari di tags
            const matchTags = item.tags?.some(tag => tag.toLowerCase().includes(query));
            
            return matchJudul || matchDeskripsi || matchTags;
          });
        }
        
        this.totalPages = Math.ceil(filtered.length / this.itemsPerPage);
        
        const startIndex = (this.currentPage - 1) * this.itemsPerPage;
        const endIndex = startIndex + this.itemsPerPage;
        
        this.displayedBlog = filtered.slice(startIndex, endIndex);
      },

      get blogItems() {
        return this.displayedBlog || [];
      },

      get totalItems() {
        let filtered = this.allBlog;
        
        if (this.selectedKategoriId) {
          filtered = filtered.filter(item => {
            const kategoriId = item.kategori_blog?.id;
            return kategoriId == this.selectedKategoriId;
          });
        }
        
        if (this.searchQuery.trim() !== '') {
          const query = this.searchQuery.toLowerCase().trim();
          filtered = filtered.filter(item => {
            return item.judul?.toLowerCase().includes(query) ||
                   item.description?.toLowerCase().includes(query) ||
                   item.tags?.some(tag => tag.toLowerCase().includes(query));
          });
        }
        
        return filtered.length;
      },

      viewBlog(id) {
        fetch('/blog/view/' + id, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
        })
        .then(res => res.json())
        .catch(err => console.error('Error view blog:', err));
      },

      selectKategori(kategoriId) {
        this.selectedKategoriId = kategoriId;
        this.currentPage = 1;
        this.filterAndPaginate();
        
        if (kategoriId) {
          const kat = this.allKategori.find(k => k.id == kategoriId);
          console.log('Selected kategori:', kat.nama[this.lang]);
          this.selectedKategori = kat ? kat.nama[this.lang] : '';
        } else {
          this.selectedKategori = '';
        }
      },

      changePage(page) {
        this.currentPage = page;
        this.filterAndPaginate();
      },

      resetFilters() {
        this.selectedKategoriId = '';
        this.selectedKategori = '';
        this.searchKategoriQuery = '';
        this.searchQuery = ''; // Reset search query juga
        this.filteredKategoriList = [...this.allKategori];
        this.currentPage = 1;
        this.filterAndPaginate();
      },

      computeIcon(iconValue) {
        const raw = (iconValue || '').toString().trim();
        if (!raw) return 'fa-solid fa-circle-question';
        if (/^fa-/.test(raw)) return 'fa-solid ' + raw;
        return raw;
      },

      getCategoryName(item) {
        if (item.kategori_blog?.nama[this.lang])
          return item.kategori_blog.nama[this.lang];
        return null;
      }
    }
  }
</script>

