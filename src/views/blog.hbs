<div class='pt-24 min-h-screen bg-gray-50 ' x-data='blogApp()'>
  <div class='container mx-auto max-w-7xl px-6  pb-16'>

    <!-- Header dengan featured story -->
    <div class="mb-8">

      <!-- Header Navigation -->
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center space-x-6">
          <h1 class="text-3xl font-bold text-gray-900 font-montserrat">Blog</h1>
        </div>
        
        <!-- Search Bar -->
        <div class="relative hidden lg:block">
          <input type="text" placeholder="Cari artikel..." 
            class="w-64 pl-10 pr-4 py-2 border bg-white border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-900 focus:border-transparent">
          <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
        </div>
      </div>

      <!-- Kategori Horizontal dengan icon -->
      <div class="flex items-center space-x-4 overflow-x-auto pb-4 scrollbar-hide border-b border-gray-200">
        <button
          @click="selectKategori('')"
          :class="selectedKategoriId === '' ? 'text-gray-900 font-semibold border-b-2 border-gray-900' : 'text-gray-600 hover:text-gray-900'"
          class="pb-2 text-sm whitespace-nowrap transition-all duration-200 flex items-center space-x-2"
        >
          <i class="fas fa-home"></i>
          <span>Semua</span>
        </button>
        <template x-for='kategori in allKategori' :key='kategori.id'>
          <button
            @click='selectKategori(kategori.id)'
            :class="selectedKategoriId == kategori.id ? 'text-gray-900 font-semibold border-b-2 border-gray-900' : 'text-gray-600 hover:text-gray-900'"
            class="pb-2 text-sm whitespace-nowrap transition-all duration-200 flex items-center space-x-2"
          >
            <i :class="computeIcon(kategori.icon)"></i>
            <span x-text='kategori.nama'></span>
            <span class="bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded text-xs" x-text="getKategoriCount(kategori.id)"></span>
          </button>
        </template>
      </div>
    </div>

    <!-- Featured Stories Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
      <!-- Main Featured -->
      <div class="lg:col-span-2 bg-white rounded-xl shadow-lg overflow-hidden group cursor-pointer">

        <div class="relative h-80">
                  <a   href="/blog/detail/{{blog_tranding.id}}"
                  @click="viewBlog({{blog_tranding.id}})" >
          <img src="{{blog_tranding.gambar.[0]}}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-6 text-white">
            <span class="bg-red-600 text-xs px-3 py-1 rounded-full mb-3 inline-block">Trending</span>
            <h2 class="text-3xl font-bold mb-2">{{blog_tranding.judul}}</h2>
            <p class="text-gray-200 mb-4">{{blog_tranding.description}}</p>
            <div class="flex items-center space-x-4 text-sm">
                    <span class="flex items-center space-x-4 text-sm"><i class="far fa-heart mr-2" :class="{'fas text-red-500': {{blog_tranding.isLiked}} }"></i>{{blog_tranding.likesCount}}</span>
              <span class="flex items-center"><i class="far fa-eye mr-2"></i> {{blog_tranding.views}}</span>
            </div>
            </span>
          </div>
        </a>

        </div>
      </div>

      <!-- Side Featured -->
      <div class="space-y-4">

        {{#each kategori_tranding}}
        <div class="bg-white rounded-xl shadow-lg p-4 flex space-x-4 group cursor-pointer">
          <img src="{{this.blog.gambar.[0]}}" class="w-20 h-20 object-cover rounded-lg">
          <div>
            <i class="{{computeIcon this.icon}}"></i>
            <span class="text-xs text-blue-600 font-semibold">{{this.nama}}</span>
            <h3 class="font-semibold group-hover:text-blue-600">
              <a href="/blog/detail/{{this.blog.id}}"
                  @click="viewBlog({{this.blog.id}})">{{this.blog.judul}}</a></h3>
                                  <p class="text-xs text-gray-600 line-clamp-2 mb-3 text-justify" >{{this.blog.description}}</p>
            <div class="flex items-center space-x-2 text-xs text-gray-500 mt-2">
              <span><i class="far fa-heart mr-1" :class="{'fas text-red-500': {{this.blog.isLiked}} }"></i>{{this.blog.likesCount}}</span>
              <span><i class="far fa-eye"></i> {{this.blog.views}}</span>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    <!-- Main Content -->
    <div class='grid grid-cols-1 lg:grid-cols-4 gap-8'>

      <!-- Content Area -->
      <div class='lg:col-span-4'>
        <!-- Loading State -->
        <div x-show='loading' class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'>
          <template x-for='i in 6' :key='i'>
            <div class='bg-white border border-gray-200 rounded-xl shadow-lg animate-pulse'>
              <div class='h-44 bg-gray-200 rounded-t-xl'></div>
              <div class='p-6 space-y-4'>
                <div class='h-4 bg-gray-200 rounded w-3/4'></div>
                <div class='h-4 bg-gray-200 rounded w-1/2'></div>
                <div class='h-20 bg-gray-200 rounded'></div>
              </div>
            </div>
          </template>
        </div>

        <!-- Blog Grid -->
        <div x-show='!loading' class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'>
          <template
            x-for='item in blogItems'
            :key='item.id'
          >
            <div  x-init="initCard(item)" class='bg-white border border-gray-200 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1'>
              <!-- Image Container -->
              <div class='relative overflow-hidden rounded-t-xl'>
                <div class='relative h-44 w-full'>
                  <template
       x-for="(image, index) in (Array.isArray(item.gambar) ? item.gambar : [item.gambar])"
      :key='index'
                  >
      <img
        :src='image'
        class='absolute inset-0 w-full h-44 object-cover transition-opacity duration-500'
        :class="{ 'opacity-100': getSlide(item.id) === index, 'opacity-0': getSlide(item.id) !== index }"
      />
                  </template>
                </div>

                <!-- Slide Controls -->
                <template x-if='Array.isArray(item.gambar) && item.gambar.length > 1'>
                  <div>
                    <button
                      @click='prevSlide(item)'
                      class='absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-800 rounded-full p-2 shadow-md transition-all duration-200 hover:scale-110 z-10'
                    >
                      <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 19l-7-7 7-7'></path>
                      </svg>
                    </button>
                    <button
                      @click='nextSlide(item)'
                      class='absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-gray-800 rounded-full p-2 shadow-md transition-all duration-200 hover:scale-110 z-10'
                    >
                      <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                        <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7'></path>
                      </svg>
                    </button>
                  </div>
                </template>

                <!-- Author Badge -->
                <div class='absolute top-3 left-3 bg-white/95 backdrop-blur-sm text-gray-800 text-xs px-3 py-1 rounded-md shadow-md flex items-center'>
                  {{!-- <img :src="'https://i.pravatar.cc/20?img=' + item.authorId" class="w-4 h-4 rounded-full mr-1"> --}}
                  <span x-text="item.author"></span>
                </div>


                <!-- Slide Indicators -->
                <template x-if='Array.isArray(item.gambar) && item.gambar.length > 1'>
                  <div class='absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2'>
                    <template x-for='(image, index) in item.gambar' :key='index'>
                      <button
                        @click='currentSlide = index'
                        class='w-2 h-2 rounded-full transition-all duration-200'
                        :class="{ 'bg-white': currentSlide === index, 'bg-white/50': currentSlide !== index }"
                      ></button>
                    </template>
                  </div>
                </template>
              </div>

              <!-- Content -->
              <div class='p-4'>
                <!-- Category and Date -->
                <div class='flex items-center justify-between mb-2'>
                  <span
                    class='badge bg-gradient-to-br from-primary via-secondary to-gray-900 text-white px-2 py-0.5 text-xs font-semibold rounded-full'
                    x-text="getCategoryName(item) || 'No Type'"
                  >
                  </span>
                </div>

                <!-- Title -->
                <h3 class='text-base font-semibold text-gray-900 leading-tight hover:text-gray-700 transition-colors line-clamp-2 mb-2' x-text="item.judul || 'No Title'"></h3>
                
                <!-- Excerpt -->
                <p class="text-xs text-gray-600 line-clamp-2 mb-3 text-justify" x-text="item.description"></p>

                <!-- Stats -->
                <div class="flex items-center justify-between text-xs text-gray-500 mb-3">
                  <div class="flex items-center space-x-3">
                    <span class="flex items-center">
                      <i class="far fa-heart mr-1" :class="{'fas text-red-500': isLiked(item)}"></i>
                      <span x-text="item.likes.length"></span>
                    </span>

                  </div>
                  <span class="flex items-center">
                    <i class="far fa-eye mr-1"></i>
                    <span x-text="item.views"></span>
                  </span>
                </div>

                <!-- Tags -->
                <div class="flex flex-wrap gap-1 mb-3">
                  <template x-for="tag in item.tags" :key="tag">
                    <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full" x-text="tag"></span>
                  </template>
                </div>

                <!-- Detail Button -->
                <a
                  :href="'/blog/detail/' + item.id"
                  @click="viewBlog(item.id)"
                  class='btn bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white text-sm px-4 py-2 w-full border-0 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 rounded-lg flex items-center justify-center'
                >
                  <span>Baca Selengkapnya</span>
                  <i class="fas fa-arrow-right ml-2 text-xs"></i>
                </a>
              </div>
            </div>
          </template>
        </div>

        <!-- No Results -->
        <div x-show='!loading && blogItems.length === 0' class='text-center py-12'>
          <div class='w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4'>
            <i class='fas fa-search text-gray-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-semibold text-gray-900 mb-2 font-montserrat'>{{t "test.blog.blogNotFound"}}</h3>
          <p class='text-gray-600 mb-6'>{{t "test.blog.tryAdjusting"}}</p>
          <button
            @click='resetFilters()'
            class='bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white px-6 py-3 rounded-lg transition-all duration-300'
          >
            {{t "test.blog.resetAllFilters"}}
          </button>
        </div>

        <!-- Pagination -->
        <div class='flex justify-center items-center gap-4 mt-12' x-show='!loading && totalPages > 1'>
          <button
            @click='changePage(Math.max(1, currentPage - 1))'
            :disabled='currentPage === 1 || loading'
            class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'
          >
            <i class='fas fa-chevron-left'></i>
          </button>

          <template x-for='page in totalPages' :key='page'>
            <button
              @click='changePage(page)'
              :disabled='loading'
              class='w-12 h-12 rounded-xl text-lg font-semibold transition-all duration-300 border shadow-sm disabled:opacity-50'
              :class="currentPage === page ? 'bg-gradient-to-r from-slate-600 to-slate-800 text-white border-slate-700 shadow-md' : 'bg-white text-gray-700 border-gray-300 hover:bg-slate-50'"
              x-text='page'
            ></button>
          </template>

          <button
            @click='changePage(Math.min(totalPages, currentPage + 1))'
            :disabled='currentPage === totalPages || loading'
            class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'
          >
            <i class='fas fa-chevron-right'></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function blogApp() {
    return {
      allBlog: {{{json blog}}},
      displayedBlog: [],
      allKategori: {{{json kategori_blog}}},
      filteredKategoriList: [],
      selectedKategori: '',
      selectedKategoriId: '',
      searchKategoriQuery: '',
      currentPage: 1,
      itemsPerPage: 9,
      totalPages: 1,
      loading: false,
      lang: 'id',
       slideStates: {},   
    likedStates: {},    

      init() {
        this.filterAndPaginate();
      },

          initCard(item) {
      if (this.slideStates[item.id] === undefined) {
        this.slideStates[item.id] = 0;
      }
      if (this.likedStates[item.id] === undefined) {
        const currentUserId = {{#if user}}{{user.id}}{{else}}null{{/if}};
        this.likedStates[item.id] = currentUserId !== null
          && Array.isArray(item.likes)
          && item.likes.some(like => like.user?.id == currentUserId);
      }
    },

    getSlide(itemId) {
      return this.slideStates[itemId] || 0;
    },

    setSlide(itemId, index) {
      this.slideStates[itemId] = index;
    },

    nextSlide(item) {
      const len = Array.isArray(item.gambar) ? item.gambar.length : 1;
      this.slideStates[item.id] = (this.getSlide(item.id) + 1) % len;
    },

    prevSlide(item) {
      const len = Array.isArray(item.gambar) ? item.gambar.length : 1;
      this.slideStates[item.id] = this.getSlide(item.id) === 0 ? len - 1 : this.getSlide(item.id) - 1;
    },

    isLiked(item) {
      return this.likedStates[item.id] || false;
    },

      getKategoriCount(kategoriId) {
        return this.allBlog.filter(item => item.kategori_blog?.id == kategoriId).length;
      },

      filterKategori() {
        if (this.searchKategoriQuery.trim() === '') {
          this.filteredKategoriList = [...this.allKategori];
        } else {
          const query = this.searchKategoriQuery.toLowerCase().trim();
          this.filteredKategoriList = this.allKategori.filter(kategori =>
            kategori.nama.toLowerCase().includes(query)
          );
        }
      },

      filterAndPaginate() {
        let filtered = this.allBlog;
        
        if (this.selectedKategoriId) {
          filtered = filtered.filter(item => {
            const kategoriId = item.kategori_blog?.id;
            return kategoriId == this.selectedKategoriId;
          });
        }
        
        this.totalPages = Math.ceil(filtered.length / this.itemsPerPage);
        
        const startIndex = (this.currentPage - 1) * this.itemsPerPage;
        const endIndex = startIndex + this.itemsPerPage;
        
        this.displayedBlog = filtered.slice(startIndex, endIndex);
      },

      get blogItems() {
        return this.displayedBlog || [];
      },

      get totalItems() {
        let filtered = this.allBlog;
        
        if (this.selectedKategoriId) {
          filtered = filtered.filter(item => {
            const kategoriId = item.kategori_blog?.id;
            return kategoriId == this.selectedKategoriId;
          });
        }
        
        return filtered.length;
      },

viewBlog(id) {
  fetch('/blog/view/' + id, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
  })
  .then(res => res.json())
  .catch(err => console.error('Error view blog:', err));
},


      selectKategori(kategoriId) {
        this.selectedKategoriId = kategoriId;
        this.currentPage = 1;
        this.filterAndPaginate();
        
        if (kategoriId) {
          const kat = this.allKategori.find(k => k.id == kategoriId);
          this.selectedKategori = kat ? kat.nama : '';
        } else {
          this.selectedKategori = '';
        }
      },

      changePage(page) {
        this.currentPage = page;
        this.filterAndPaginate();
      },

      resetFilters() {
        this.selectedKategoriId = '';
        this.selectedKategori = '';
        this.searchKategoriQuery = '';
        this.filteredKategoriList = [...this.allKategori];
        this.currentPage = 1;
        this.filterAndPaginate();
      },

              computeIcon(iconValue) {
      const raw = (iconValue || '').toString().trim();
      if (!raw) return 'fa-solid fa-circle-question';
      if (/^fa-/.test(raw)) return 'fa-solid ' + raw;
      return raw;
    },

      getCategoryName(item) {
        if (item.kategori_blog?.nama)
          return item.kategori_blog.nama;
        return null;
      }
    }
  }
</script>

<!-- Styles -->
<style>
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.animate-marquee {
  animation: marquee 20s linear infinite;
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.scrollbar-hide::-webkit-scrollbar {
  display: none;
}

.scrollbar-hide {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.badge {
  display: inline-block;
}
</style>