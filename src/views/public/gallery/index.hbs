<div
  class="pt-24 pb-16 lg:px-5 min-h-screen bg-cover bg-top bg-no-repeat bg-fixed bg-[url('/public/image/dashboard/bgGallery.png')]"
  x-data="galleryTable({
    gallery: {{{json gallery}}},
    programs: {{{json programs}}}
  })"
>
  <div class="container mx-auto px-5 max-w-[1440px]">

    <!-- UNIFIED GALLERY HEADER (Mobile & Desktop) -->
    <div class="flex flex-col items-center pt-4 mb-6 lg:pt-0 lg:mb-[50px]">
      <!-- Badge -->
      {{> components/alumni/badge text=(t 'test.gallery.gallery')}}

      <!-- Title & Subtitle Container -->
      <div class="flex flex-col items-center w-full gap-2 lg:gap-[10px]">
        {{> components/alumni/title
          title=(t 'test.gallery.title')}}
        <div class="w-10 h-1 mx-auto my-1 bg-[#0B1F3B] rounded-full lg:w-[70px] lg:h-[5px] lg:my-0 lg:rounded-[6px]"></div>
        {{> components/alumni/description
          text=(t 'test.gallery.description')}}
      </div>
    </div>

    <!-- UNIFIED FILTERS (Mobile & Desktop) -->
    <div class="flex flex-col items-center justify-end w-full gap-3 mb-6 lg:flex-row lg:gap-[30px] lg:mb-[50px]">
      
      <!-- Dropdown Program -->
      {{> components/alumni/sidebar_program
            items="programs"
            selectedValue="selectedProgram"
            placeholder=(t 'test.gallery.allPrograms')
            valueKey="id"
            labelKey="name"
            onSelect="selectProgram"
        }}

      <!-- Search Box -->
      <div class="relative w-full lg:w-[423px] lg:shrink-0"
        @input.debounce.500ms="search = searchInput; currentPage = 1">
          {{> components/alumni/sidebar_search
            value="searchInput"
            placeholder=(t 'test.gallery.searchPlaceholder')
          }}
      </div>
    </div>

    <!-- GALLERY CONTENT CONTAINER (Flex Col + Justify Between like Alumni) -->
    <div class="flex flex-col justify-between w-full min-h-[550px] lg:min-h-[650px]">
      
      <!-- UNIFIED GALLERY CARDS GRID (Mobile & Desktop) -->
      <div x-show="amount > 0" class="grid min-h-[400px] grid-cols-2 gap-3.5 mb-8 md:grid-cols-2 lg:grid-cols-3 lg:auto-rows-[460px] lg:content-start lg:gap-[30px] lg:mb-12 lg:min-h-[1440px]">
        <template x-for="item in paginatedGallery" :key="item.id">
          <div
            class="flex flex-col relative w-full overflow-hidden bg-white border border-[#E0F1F9] rounded-[16px] shadow-xs backdrop-blur-[3.3px] transition-all duration-300 hover:-translate-y-2 lg:min-h-[460px] lg:bg-[rgba(245,245,245,0.5)] lg:border-2 lg:border-white/10 lg:rounded-[12px] lg:shadow-[0px_0px_4px_rgba(0,0,0,0.25)]"
          >
            <!-- Image -->
            <div class="w-full aspect-[4/3] bg-gray-100 overflow-hidden lg:h-[374px] lg:aspect-none lg:bg-[#FAFAFA]">
              <img
                :src="item.filePath"
                :alt="getByLang(item.title, lang)"
                class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
              />
            </div>
            <!-- Title -->
            <div class="flex flex-col items-center justify-center flex-1 p-3 bg-white text-center min-h-[44px] lg:p-[14px] lg:bg-transparent">
              <h3 class="w-full font-montserrat font-bold text-[12px] leading-tight text-[#111111] line-clamp-2 text-center lg:font-medium lg:text-[23px] lg:leading-[28px] lg:text-[#0B1F3B] lg:truncate lg:line-clamp-none" x-text="getByLang(item.title, lang)">
              </h3>
            </div>
          </div>
        </template>
      </div>

      <!-- Empty state -->
      {{> components/alumni/empty_state
        show="amount === 0"
        icon="fas fa-image text-3xl lg:text-4xl"
        title=(t 'test.gallery.noResults')
      }}

      <!-- Pagination -->
      {{> components/alumni/pagination
        currentPage="currentPage"
        totalPages="totalPages"
        onPageChange="changePage"
      }}
    </div>
  </div>
</div>

<script>
function galleryTable({ gallery, programs }) {
  return {
    gallery: gallery || [],
    programs: programs || [],

    search: "",
    searchInput: "",

    currentPage: 1,
    size: 9,

    selectedProgram: null,

    lang: '{{lang}}' || 'id',

    getByLang(obj, lang) {
      if (!obj) return '';
      if (typeof obj === 'string') return obj;
      if (typeof obj !== 'object') return '';
      return obj[lang] || obj['id'] || obj['en'] || '';
    },

    get filteredGalleryFull() {
      return this.gallery.filter((item) => {
        const matchSearch = this.getByLang(item.title, this.lang)
          .toLowerCase()
          .includes(this.search.toLowerCase());

        const matchProgram =
          this.selectedProgram === null ||
          String(item.category?.id) === String(this.selectedProgram);

        return matchSearch && matchProgram;
      });
    },

    get amount() {
      return this.filteredGalleryFull.length;
    },

    get paginatedGallery() {
      const start = (this.currentPage - 1) * this.size;
      const end = start + this.size;
      return this.filteredGalleryFull.slice(start, end);
    },

    get totalPages() {
      return Math.max(
        1,
        Math.ceil(this.amount / this.size)
      );
    },

    changePage(page) {
      if (page < 1 || page > this.totalPages) return;
      this.currentPage = page;
    },

    resetFilters() {
      this.search = "";
      this.searchInput = "";
      this.selectedProgram = null;
      this.currentPage = 1;
    },

    selectProgram(id) {
      this.selectedProgram = id === null ? null : String(id);
      this.currentPage = 1;
    },
  };
}
</script>