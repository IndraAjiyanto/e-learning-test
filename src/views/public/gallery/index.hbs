{{!--
  Halaman: Gallery (user)
  Lokasi: src/views/public/gallery/index.hbs
  Satu pohon markup, base + lg. .page-shell, sizeClass.
  Header polos (tanpa eyebrow/divider) -> filter (label + search + pill "All Programs" + Clear)
  -> sub-header "Our Activities" -> masonry 3 kolom (gambar + gradient + caption), semua item
  tampil sekaligus (pagination dihapus per instruksi desainer, yana WA 2026-09-10).
--}}
{{!-- data goes through a <script> var, not the x-data attribute: {{{json}}} emits raw quotes that would terminate the attribute --}}
<div
  class="w-full min-h-screen bg-[#F9FAFB] py-12 font-inter lg:py-16"
  x-data="galleryTable(window.__galleryPage || {})"
>
  <div class="page-shell flex flex-col items-center gap-12 lg:gap-[50px]">

    {{!-- ============ PAGE HEADER ============ --}}
    <div class="flex max-w-[760px] flex-col items-center gap-4 text-center">
      <h1 class="{{sizeClass 'display'}} font-inter font-bold tracking-tight text-[#111827]">
        {{t 'test.gallery.title'}}
      </h1>
      <p class="{{sizeClass 'lead'}} font-inter text-[#4A5568]">
        {{t 'test.gallery.description'}}
      </p>
    </div>

    {{!-- ============ FILTER ============ --}}
    {{> components/ui/filter/program_filter/index
        label=(t 'test.gallery.filterByProgram')
        searchModel="search"
        searchEvent="isExpanded = false; currentPage = 1;"
        searchPlaceholder=(t 'test.gallery.searchPlaceholder')
        items="programs"
        selected="selectedProgram"
        onSelect="selectProgram"
        allLabel=(t 'test.gallery.allPrograms')
        onClear="resetFilters()"
        showClear="hasFilter"
        clearLabel=(t 'test.gallery.clearFilter') }}

    {{!-- ============ ACTIVITIES ============ --}}
    <div id="activities-section" class="flex w-full flex-col items-center gap-8 lg:gap-10">
      <div class="flex flex-col items-center gap-2 text-center">
        <h2 class="{{sizeClass 'h2'}} font-inter font-bold text-[#0F172A]">{{t 'test.gallery.activitiesTitle'}}</h2>
        <p class="{{sizeClass 'body'}} max-w-[560px] font-inter text-[#475569]">{{t 'test.gallery.activitiesSubtitle'}}</p>
      </div>

      <div class="flex w-full flex-col">

        {{!-- masonry: explicit columns (round-robin distribution) + checkerboard tall/short --}}
        <div x-show="amount > 0" class="flex flex-col gap-6 sm:flex-row sm:items-start">
          <template x-for="(col, ci) in masonryColumns" :key="ci">
            <div class="flex flex-1 flex-col gap-6">
              <template x-for="(item, ri) in col" :key="item.id">
                <a
                  :href="item.filePath"
                  target="_blank"
                  rel="noopener"
                  class="group block overflow-hidden rounded-[20px] shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-[0px_12px_28px_rgba(11,31,59,0.10)]"
                >
                  <div class="relative w-full" :class="((ci + ri) % 2 === 0) ? 'aspect-[11/10]' : 'aspect-[16/10]'">
                    <img
                      :src="item.filePath"
                      :alt="getByLang(item.title, lang)"
                      onerror="this.onerror=null;this.src='/public/image/dashboard/bgHeroSection.png'"
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    {{!-- flat 40% black wash + caption top-left --}}
                    <div class="absolute inset-0 bg-black/40 transition group-hover:bg-black/50"></div>
                    <div class="absolute inset-x-0 top-0 flex flex-col gap-1.5 p-4">
                      <h3 class="font-inter text-base font-bold leading-snug text-white" x-text="getByLang(item.title, lang)"></h3>
                      <p x-show="item.description" class="font-inter text-[13px] leading-relaxed text-white/90" x-text="item.description"></p>
                    </div>
                  </div>
                </a>
              </template>
            </div>
          </template>
        </div>

        {{!-- "View All Activities": menampilkan data gallery selanjutnya --}}
        <button
          type="button"
          x-show="!isExpanded && amount > initialLimit"
          @click="viewAllActivities()"
          class="mt-8 self-center font-inter text-base font-semibold text-[#003060] underline decoration-1 underline-offset-4 transition hover:text-[#00244a] cursor-pointer focus:outline-none"
        >
          {{t 'test.gallery.viewAllActivities'}}
        </button>

        {{!-- Pagination jika data kelebihan untuk ditampilkan di satu halaman --}}
        <div x-show="isExpanded && totalPages > 1" class="w-full">
          {{> components/ui/pagination/index
            currentPage="currentPage"
            totalPages="totalPages"
            onPageChange="changePage"
          }}
        </div>

        {{> components/ui/empty_state/index
          show="amount === 0"
          icon="fas fa-image text-3xl lg:text-4xl"
          title=(t 'test.gallery.noResults')
        }}
      </div>
    </div>
  </div>
</div>

<script>
  window.__galleryPage = {
    gallery: {{{json gallery}}},
    programs: {{{json programs}}}
  };

function galleryTable(data) {
  const { gallery, programs } = data || {};
  return {
    gallery: gallery || [],
    programs: programs || [],

    search: "",
    selectedProgram: null,
    colCount: 3,

    initialLimit: 6,
    maxSinglePage: 9,
    pageSize: 9,

    isExpanded: false,
    currentPage: 1,

    lang: '{{lang}}' || 'id',

    init() {
      const sync = () => {
        this.colCount = window.innerWidth >= 1024 ? 3 : window.innerWidth >= 640 ? 2 : 1;
      };
      sync();
      window.addEventListener('resize', sync);

      if (this.$watch) {
        this.$watch('search', () => {
          this.isExpanded = false;
          this.currentPage = 1;
        });
      }
    },

    getByLang(obj, lang) {
      if (!obj) return '';
      if (typeof obj === 'string') return obj;
      if (typeof obj !== 'object') return '';
      return obj[lang] || obj['id'] || obj['en'] || '';
    },

    get filteredGalleryFull() {
      return this.gallery.filter((item) => {
        const matchSearch = this.getByLang(item.title, this.lang)
          .toLowerCase()
          .includes(this.search.toLowerCase());

        const matchProgram = 
          this.selectedProgram === null ||
          String(item.category?.id) === String(this.selectedProgram);

        return matchSearch && matchProgram;
      });
    },

    get amount() {
      return this.filteredGalleryFull.length;
    },

    get hasFilter() {
      return !!this.search || this.selectedProgram !== null;
    },

    get totalPages() {
      if (!this.isExpanded || this.amount <= this.maxSinglePage) return 1;
      return Math.max(1, Math.ceil(this.amount / this.pageSize));
    },

    get displayedGallery() {
      if (!this.isExpanded) {
        return this.filteredGalleryFull.slice(0, this.initialLimit);
      }
      if (this.amount <= this.maxSinglePage) {
        return this.filteredGalleryFull;
      }
      const total = this.totalPages;
      const safePage = Math.min(Math.max(1, this.currentPage), total);
      const start = (safePage - 1) * this.pageSize;
      return this.filteredGalleryFull.slice(start, start + this.pageSize);
    },

    get masonryColumns() {
      const cols = Array.from({ length: this.colCount }, () => []);
      this.displayedGallery.forEach((item, i) => cols[i % this.colCount].push(item));
      return cols;
    },

    viewAllActivities() {
      this.isExpanded = true;
      this.currentPage = 1;
    },

    changePage(page) {
      if (page < 1 || page > this.totalPages) return;
      this.currentPage = page;
      const el = document.getElementById('activities-section') || document.querySelector('.page-shell');
      if (el) {
        el.scrollIntoView({ behavior: 'smooth' });
      }
    },

    resetFilters() {
      this.search = "";
      this.selectedProgram = null;
      this.isExpanded = false;
      this.currentPage = 1;
    },

    selectProgram(id) {
      this.selectedProgram = id === null ? null : String(id);
      this.isExpanded = false;
      this.currentPage = 1;
    },
  };
}
</script>
