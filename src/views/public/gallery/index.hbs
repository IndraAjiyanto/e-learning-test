{{!--
  Halaman: Gallery (user)
  Lokasi: src/views/public/gallery/index.hbs
  Satu pohon markup, base + lg. .page-shell, sizeClass.
  Header polos (tanpa eyebrow/divider) -> filter (label + search + pill "All Programs" + Clear)
  -> sub-header "Our Activities" -> masonry 3 kolom (gambar + gradient + caption), semua item
  tampil sekaligus (pagination dihapus per instruksi desainer, yana WA 2026-09-10).
--}}
{{!-- data goes through a <script> var, not the x-data attribute: {{{json}}} emits raw quotes that would terminate the attribute --}}
<div
  class="w-full min-h-screen bg-[#F9FAFB] py-12 font-inter lg:py-16"
  x-data="galleryTable(window.__galleryPage || {})"
>
  <div class="page-shell flex flex-col items-center gap-12 lg:gap-[50px]">

    {{!-- ============ PAGE HEADER ============ --}}
    <div class="flex max-w-[760px] flex-col items-center gap-4 text-center">
      <h1 class="{{sizeClass 'display'}} font-inter font-bold tracking-tight text-[#111827]">
        {{t 'test.gallery.title'}}
      </h1>
      <p class="{{sizeClass 'lead'}} font-inter text-[#4A5568]">
        {{t 'test.gallery.description'}}
      </p>
    </div>

    {{!-- ============ FILTER ============ --}}
    {{> components/ui/filter/program_filter/index
        label=(t 'test.gallery.filterByProgram')
        searchModel="search"
        searchEvent="isExpanded = false; currentPage = 1;"
        searchPlaceholder=(t 'test.gallery.searchPlaceholder')
        items="programs"
        selected="selectedProgram"
        onSelect="selectProgram"
        allLabel=(t 'test.gallery.allPrograms')
        onClear="resetFilters()"
        showClear="hasFilter"
        clearLabel=(t 'test.gallery.clearFilter') }}

    {{!-- ============ ACTIVITIES ============ --}}
    <div id="activities-section" class="flex w-full flex-col items-center gap-8 lg:gap-10">
      <div class="flex flex-col items-center gap-2 text-center">
        <h2 class="{{sizeClass 'h2'}} font-inter font-bold text-[#0F172A]">{{t 'test.gallery.activitiesTitle'}}</h2>
        <p class="{{sizeClass 'body'}} max-w-[560px] font-inter text-[#475569]">{{t 'test.gallery.activitiesSubtitle'}}</p>
      </div>

      <div class="flex w-full flex-col">

        {{!-- Galeri aktivitas: Bento grid 5 cards per block matching Figma layout --}}
        <div
          x-show="amount > 0"
          class="gallery-bento-grid w-full"
        >
          <template x-for="(item, index) in displayedGallery" :key="item.id">
            <a
              :href="item.filePath"
              target="_blank"
              rel="noopener"
              class="group relative block h-full w-full overflow-hidden rounded-[20px] shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-[0px_12px_28px_rgba(11,31,59,0.15)]"
              :class="getItemColClass(index, displayedGallery.length)"
            >
              {{!-- Photo Image --}}
              <img
                :src="item.filePath"
                :alt="getByLang(item.title, lang)"
                onerror="this.onerror=null;this.src='/public/image/dashboard/bgHeroSection.png'"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />

              {{!-- Dark gradient overlay at bottom for crystal-clear readability --}}
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent transition-opacity duration-300 group-hover:from-black/90 group-hover:via-black/50"></div>

              {{!-- Text caption at bottom-left --}}
              <div
                class="relative z-10 flex h-full w-full flex-col justify-end"
                :class="isLargeCard(index, displayedGallery.length) ? 'p-6 sm:p-8 lg:p-10' : 'p-4 sm:p-5 lg:p-6'"
              >
                <h3
                  class="font-inter font-bold text-white tracking-tight"
                  :class="isLargeCard(index, displayedGallery.length) ? 'text-xl sm:text-2xl lg:text-3xl leading-tight' : 'text-base sm:text-lg lg:text-xl leading-snug'"
                  x-text="getByLang(item.title, lang)"
                ></h3>
                <p
                  x-show="item.description"
                  class="font-inter text-white/90"
                  :class="isLargeCard(index, displayedGallery.length) ? 'mt-2 sm:mt-3 text-sm sm:text-base leading-relaxed max-w-xl' : 'mt-1 text-xs sm:text-sm leading-normal line-clamp-2'"
                  x-text="getByLang(item.description, lang) || item.description"
                ></p>
              </div>
            </a>
          </template>
        </div>

        {{!-- "Lihat Semua Aktivitas": button to view more activities --}}
        <button
          type="button"
          x-show="!isExpanded && amount > initialLimit"
          @click="viewAllActivities()"
          class="mt-10 self-center inline-flex items-center gap-3 rounded-xl bg-[#003060] px-8 py-3.5 font-inter text-base font-semibold text-white shadow-sm transition hover:bg-[#00244a] cursor-pointer focus:outline-none"
        >
          <span>{{t 'test.gallery.viewAllActivities'}}</span>
          <svg class="size-4 shrink-0" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3.33334 8H12.6667M12.6667 8L8.66668 4M12.6667 8L8.66668 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        {{!-- Pagination jika data kelebihan untuk ditampilkan di satu halaman --}}
        <div x-show="isExpanded && totalPages > 1" class="mt-10 w-full">
          {{> components/ui/pagination/index
            currentPage="currentPage"
            totalPages="totalPages"
            onPageChange="changePage"
          }}
        </div>

        {{> components/ui/empty_state/index
          show="amount === 0"
          icon="fas fa-image text-3xl lg:text-4xl"
          title=(t 'test.gallery.noResults')
        }}
      </div>
    </div>
  </div>
</div>

<script>
  window.__galleryPage = {
    gallery: {{{json gallery}}},
    programs: {{{json programs}}}
  };

function galleryTable(data) {
  const { gallery, programs } = data || {};
  return {
    gallery: gallery || [],
    programs: programs || [],

    search: "",
    selectedProgram: null,

    initialLimit: 5,
    maxSinglePage: 10,
    pageSize: 10,

    isExpanded: false,
    currentPage: 1,

    lang: '{{lang}}' || 'id',

    init() {
      if (this.$watch) {
        this.$watch('search', () => {
          this.isExpanded = false;
          this.currentPage = 1;
        });
      }
    },

    getByLang(obj, lang) {
      if (!obj) return '';
      if (typeof obj === 'string') return obj;
      if (typeof obj !== 'object') return '';
      return obj[lang] || obj['id'] || obj['en'] || '';
    },

    get filteredGalleryFull() {
      return this.gallery.filter((item) => {
        const matchSearch = this.getByLang(item.title, this.lang)
          .toLowerCase()
          .includes(this.search.toLowerCase());

        const matchProgram = 
          this.selectedProgram === null ||
          String(item.category?.id) === String(this.selectedProgram);

        return matchSearch && matchProgram;
      });
    },

    get amount() {
      return this.filteredGalleryFull.length;
    },

    get hasFilter() {
      return !!this.search || this.selectedProgram !== null;
    },

    get totalPages() {
      if (!this.isExpanded || this.amount <= this.maxSinglePage) return 1;
      return Math.max(1, Math.ceil(this.amount / this.pageSize));
    },

    get displayedGallery() {
      if (!this.isExpanded) {
        return this.filteredGalleryFull.slice(0, this.initialLimit);
      }
      if (this.amount <= this.maxSinglePage) {
        return this.filteredGalleryFull;
      }
      const total = this.totalPages;
      const safePage = Math.min(Math.max(1, this.currentPage), total);
      const start = (safePage - 1) * this.pageSize;
      return this.filteredGalleryFull.slice(start, start + this.pageSize);
    },

    isLargeCard(index, count) {
      if (count <= 2) return true;
      return index % 5 === 0;
    },

    getItemColClass(index, count) {
      if (count === 1) return 'gallery-item-full col-span-1 md:col-span-2 lg:col-span-4 lg:row-span-2';
      if (count === 2) return 'gallery-item-large col-span-1 md:col-span-1 lg:col-span-2 lg:row-span-2';
      if (index % 5 === 0) return 'gallery-item-large col-span-1 md:col-span-2 lg:col-span-2 lg:row-span-2';
      return 'gallery-item-small col-span-1 md:col-span-1 lg:col-span-1 lg:row-span-1';
    },

    viewAllActivities() {
      this.isExpanded = true;
      this.currentPage = 1;
    },

    changePage(page) {
      if (page < 1 || page > this.totalPages) return;
      this.currentPage = page;
      const el = document.getElementById('activities-section') || document.querySelector('.page-shell');
      if (el) {
        el.scrollIntoView({ behavior: 'smooth' });
      }
    },

    resetFilters() {
      this.search = "";
      this.selectedProgram = null;
      this.isExpanded = false;
      this.currentPage = 1;
    },

    selectProgram(id) {
      this.selectedProgram = id === null ? null : String(id);
      this.isExpanded = false;
      this.currentPage = 1;
    },
  };
}
</script>

<style>
  .gallery-bento-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.25rem;
    grid-auto-rows: 250px;
  }
  @media (min-width: 640px) {
    .gallery-bento-grid {
      grid-auto-rows: 270px;
    }
  }
  @media (min-width: 768px) {
    .gallery-bento-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 270px;
    }
  }
  @media (min-width: 1024px) {
    .gallery-bento-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
      grid-auto-rows: 270px;
    }
  }
  @media (min-width: 1280px) {
    .gallery-bento-grid {
      grid-auto-rows: 290px;
    }
  }
  @media (min-width: 1536px) {
    .gallery-bento-grid {
      grid-auto-rows: 310px;
    }
  }

  .gallery-item-large {
    grid-column: span 1 / span 1;
    grid-row: span 1 / span 1;
  }
  @media (min-width: 768px) {
    .gallery-item-large {
      grid-column: span 2 / span 2;
      grid-row: span 1 / span 1;
    }
  }
  @media (min-width: 1024px) {
    .gallery-item-large {
      grid-column: span 2 / span 2;
      grid-row: span 2 / span 2;
    }
  }

  .gallery-item-small {
    grid-column: span 1 / span 1;
    grid-row: span 1 / span 1;
  }

  .gallery-item-full {
    grid-column: 1 / -1;
    grid-row: span 1 / span 1;
  }
  @media (min-width: 1024px) {
    .gallery-item-full {
      grid-row: span 2 / span 2;
    }
  }
</style>
