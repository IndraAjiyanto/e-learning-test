          <button
            @click='resetFilters()'
            class='px-6 py-2.5 bg-gradient-to-r from-gray-700 to-gray-900 hover:from-gray-600 hover:to-gray-800 text-white rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg font-medium'
          >
            <i class='fas fa-redo mr-2'></i>Reset All
          </button>
        </div>
      </div>

      <!-- Results Counter -->
      <div class='mt-6 text-center'>
        <p class='text-gray-600 font-inter'>
          Menampilkan
          <span class='text-gray-900 font-bold' x-text='filteredKelas.filter((el, idx) => paginatedKelas(el)).length'></span>
          dari
          <span class='text-gray-900 font-bold' x-text='filteredKelas.length'></span>
          program
        </p>
      </div>
    </div>

    <!-- Programs Grid -->
    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto' x-ref='kelasList'>
      {{#each kelas}}
      <div
        class='group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-200'
        data-category='{{jenis_kelas.nama_jenis_kelas}}'
        data-nama='{{nama_kelas}}'
        data-deskripsi='{{deskripsi}}'
        data-location='{{metode}}'
        x-show='paginatedKelas($el)'
        x-transition
      >
        <!-- Image -->
        <div class='relative h-56 overflow-hidden bg-gradient-to-br from-gray-100 to-gray-200'>
          {{#if gambar}}
            <img src='{{gambar}}' alt='{{nama_kelas}}' class='w-full h-full object-cover group-hover:scale-110 transition-transform duration-500'>
          {{else}}
            <div class='w-full h-full flex items-center justify-center'>
              <i class='fas fa-briefcase text-6xl text-gray-400'></i>
            </div>
          {{/if}}
          <div class='absolute top-4 right-4'>
            <span class='bg-white/90 backdrop-blur-sm px-4 py-2 rounded-full text-sm font-bold text-gray-700'>
              WIP
            </span>
          </div>
          <div class='absolute top-4 left-4'>
            <span class='bg-gradient-to-r from-gray-700 to-gray-900 text-white px-3 py-1 rounded-full text-xs font-semibold'>
              {{jenis_kelas.nama_jenis_kelas}}
            </span>
          </div>
        </div>

        <!-- Content -->
        <div class='p-6'>
          <div class='flex gap-2 mb-3'>
            <span class='badge bg-gray-100 text-gray-700 px-3 py-1 text-xs font-semibold rounded-full flex items-center gap-1'>
              <i class='fas fa-laptop text-xs'></i>
              {{metode}}
            </span>
            <span class='badge bg-gray-100 text-gray-700 px-3 py-1 text-xs font-semibold rounded-full flex items-center gap-1'>
              <i class='fas fa-map-marker-alt text-xs'></i>
              {{lokasi}}
            </span>
          </div>

          <h3 class='text-xl font-bold text-gray-900 mb-3 font-montserrat group-hover:text-gray-700 transition-colors'>
            {{nama_kelas}}
          </h3>
          
          <p class='text-gray-600 text-sm mb-4 font-inter line-clamp-2 leading-relaxed'>
            {{deskripsi}}
          </p>

          <!-- Info -->
          <div class='bg-gradient-to-br from-gray-50 to-gray-100 rounded-lg p-4 mb-4 border border-gray-200'>
            <div class='flex justify-between items-center mb-3'>
              <span class='text-sm font-semibold text-gray-700 flex items-center gap-2'>
                <i class='fas fa-users text-gray-600'></i>
                Kuota Peserta
              </span>
              <span class='text-sm font-bold text-gray-800 bg-white px-3 py-1 rounded-full shadow-sm'>
                {{#if user_kelas}}{{user_kelas.length}}{{else}}0{{/if}} / {{kuota}}
              </span>
            </div>
            <div class='w-full bg-gray-200 rounded-full h-2 overflow-hidden'>
              <div
                class='h-2 rounded-full bg-gradient-to-r from-gray-400 to-gray-700 transition-all duration-500'
                style='width: {{#if user_kelas}}{{multiply (divide user_kelas.length kuota) 100}}{{else}}0{{/if}}%'
              ></div>
            </div>
          </div>

          <!-- Price & CTA -->
          <div class='flex items-center justify-between pt-4 border-t border-gray-200'>
            <div>
              {{#if harga}}
                <div class='text-2xl font-bold text-gray-800'>
                  Rp {{formatPrice harga}}
                </div>
              {{else}}
                <div class='text-2xl font-bold text-green-600'>Gratis</div>
              {{/if}}
            </div>
            <a href='/kelass/{{id}}' class='bg-gradient-to-r from-gray-700 to-gray-900 hover:from-gray-600 hover:to-gray-800 text-white px-6 py-3 rounded-xl font-semibold transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5'>
              Daftar
            </a>
          </div>
        </div>
      </div>
      {{/each}}
    </div>

    <!-- No Results -->
    <div x-show='filteredKelas.length === 0' class='text-center py-20' x-transition>
      <div class='bg-gray-100 backdrop-blur-md border border-gray-200 w-32 h-32 mx-auto mb-6 rounded-full flex items-center justify-center'>
        <i class='fas fa-inbox text-5xl text-gray-400'></i>
      </div>
      <h3 class='text-3xl font-bold text-gray-900 mb-3 font-montserrat'>Program Tidak Ditemukan</h3>
      <p class='text-gray-600 text-lg mb-6 font-inter'>Coba sesuaikan pencarian atau filter kriteria.</p>
      <button
        @click='resetFilters()'
        class='px-6 py-3 bg-gradient-to-r from-gray-700 to-gray-900 hover:from-gray-600 hover:to-gray-800 text-white rounded-lg transition-all duration-300 transform hover:scale-105 font-semibold shadow-md'
      >
        <i class='fas fa-redo mr-2'></i>Clear All Filters
      </button>
    </div>

    <!-- Pagination -->
    <div class='flex justify-center items-center gap-4 mt-12' x-show='totalPages > 1'>
      <button
        @click='currentPage = Math.max(1, currentPage - 1)'
        :disabled='currentPage === 1'
        class='px-5 py-3 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'
      >
        <i class='fas fa-chevron-left'></i>
      </button>

      <template x-for='page in totalPages' :key='page'>
        <button
          @click='currentPage = page'
          class='w-12 h-12 rounded-xl text-lg font-semibold transition-all duration-300 border shadow-sm'
          :class="currentPage === page ? 'bg-gradient-to-r from-gray-700 to-gray-900 text-white border-gray-800 shadow-md' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50'"
          x-text='page'
        ></button>
      </template>

      <button
        @click='currentPage = Math.min(totalPages, currentPage + 1)'
        :disabled='currentPage === totalPages'
        class='px-5 py-3 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'
      >
        <i class='fas fa-chevron-right'></i>
      </button>
    </div>
  </div>
</section>



<section class='py-20 bg-gradient-to-br from-slate-50 via-white to-slate-100'>
  <div class='container mx-auto px-6 max-w-6xl'>
    <h2 class='text-4xl md:text-5xl font-bold text-center mb-16 text-gray-900'>
      Frequently Asked Questions
    </h2>

    <div class='max-w-4xl mx-auto space-y-6'>
      <div
        class='group bg-white p-8 rounded-2xl shadow-lg border border-slate-200 hover:shadow-2xl hover:border-slate-300 transition-all duration-300 transform hover:-translate-y-1'
      >
        <h3
          class='text-xl font-bold text-gray-900 mb-4 group-hover:text-slate-700 transition-colors duration-300'
        >How long is the bootcamp program?</h3>
        <p class='text-gray-600 leading-relaxed text-lg'>Our bootcamp program typically runs for 4 months with intensive weekend classes. You'll learn through hands-on projects and mentorship from industry experts.</p>
      </div>
      <div
        class='group bg-white p-8 rounded-2xl shadow-lg border border-slate-200 hover:shadow-2xl hover:border-slate-300 transition-all duration-300 transform hover:-translate-y-1'
      >
        <h3
          class='text-xl font-bold text-gray-900 mb-4 group-hover:text-slate-700 transition-colors duration-300'
        >Do I need prior programming experience?</h3>
        <p class='text-gray-600 leading-relaxed text-lg'>No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.</p>
      </div>
      <div
        class='group bg-white p-8 rounded-2xl shadow-lg border border-slate-200 hover:shadow-2xl hover:border-slate-300 transition-all duration-300 transform hover:-translate-y-1'
      >
        <h3
          class='text-xl font-bold text-gray-900 mb-4 group-hover:text-slate-700 transition-colors duration-300'
        >What is the payment method?</h3>
        <p class='text-gray-600 leading-relaxed text-lg'>We offer flexible payment options including full payment, installments, and early bird discounts. Contact us for more details.</p>
      </div>
    </div>
  </div>
</section>



</div>