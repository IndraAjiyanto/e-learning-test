<body
  class='bg-gradient-to-br from-white via-slate-50 to-slate-100 min-h-screen'
>
  <!-- Hero Section -->
  <div
    class='hero min-h-screen bg-gradient-to-br from-primary via-secondary to-gray-800 px-4 py-16'
  >
    <div class='hero-content text-center max-w-4xl mx-auto'>

      <!-- Main Content -->
      <div class='max-w-2xl mx-auto'>
        <!-- Badge -->
        <div
          class='inline-flex items-center gap-2 bg-gradient-to-r from-red-100 to-red-200 text-red-700 px-4 py-2 rounded-full mb-8 shadow-md'
        >
          <i class='fas fa-exclamation-triangle text-red-600'></i>
          <span class='font-semibold text-sm'>{{t
              'test.500.internalServerError'
            }}</span>
        </div>

        <!-- Large 500 Number -->
        <div
          class='text-8xl sm:text-9xl md:text-[12rem] font-black font-montserrat mb-6'
        >
          <span
            class='bg-gradient-to-r from-white via-slate-50 to-slate-200 bg-clip-text text-transparent'
          >
            {{t 'test.500.500'}}
          </span>
        </div>

        <!-- Action Buttons -->
        <div
          class='flex flex-col sm:flex-row gap-4 justify-center items-center'
        >
          <a
            href='/dashboard'
            class='btn text-lg bg-white hover:bg-slate-50 text-slate-800 hover:text-slate-900 shadow-lg hover:shadow-2xl transition-all duration-300 transform border-2 border-secondary hover:-translate-y-1'
          >

            <svg
              xmlns='http://www.w3.org/2000/svg'
              class='h-5 w-5 mr-2'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6'
              />
            </svg>
            {{t 'test.500.backTodashboard'}}
          </a>

        </div>

      </div>
    </div>
  </div>

  <!-- WhatsApp Chat Button -->
  <div
    x-data='{ showTooltip: false }'
    class='fixed bottom-6 right-6 md:bottom-8 md:right-8 z-50 group'
    @mouseenter='showTooltip = true'
    @mouseleave='showTooltip = false'
  >
    <!-- Tooltip -->
    <div
      x-show='showTooltip'
      x-transition:enter='transition ease-out duration-200'
      x-transition:enter-start='opacity-0 translate-x-2'
      x-transition:enter-end='opacity-100 translate-x-0'
      x-transition:leave='transition ease-in duration-150'
      x-transition:leave-start='opacity-100 translate-x-0'
      x-transition:leave-end='opacity-0 translate-x-2'
      class='hidden md:block absolute right-20 top-1/2 -translate-y-1/2 bg-gradient-to-r from-slate-700 to-slate-800 text-white px-4 py-2 rounded-lg shadow-xl whitespace-nowrap font-medium text-sm'
    >
      {{t 'test.500.needHelpChat'}}
      <div
        class='absolute -right-2 top-1/2 -translate-y-1/2 w-0 h-0 border-t-6 border-b-6 border-l-6 border-transparent border-l-slate-800'
      ></div>
    </div>

    <!-- Button -->
    <a
      href='https://wa.me/62895618452602?text=Halo%20Kesatria%20Academy!%20Saya%20mengalami%20masalah%20dengan%20halaman%20500'
      target='_blank'
      class='relative flex items-center justify-center w-14 h-14 md:w-16 md:h-16 bg-gradient-to-br from-green-500 to-green-600 rounded-full shadow-lg hover:shadow-2xl hover:scale-110 hover:-translate-y-2 hover:from-green-400 hover:to-green-500 transition-all duration-300 group'
      aria-label='Chat WhatsApp'
    >
      <i class='fab fa-whatsapp text-white text-2xl md:text-3xl'></i>
    </a>
  </div>

  <style>
    .font-montserrat {
      font-family: 'Montserrat', sans-serif;
    }
  </style>

  <script src='https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js' defer></script>


</body>