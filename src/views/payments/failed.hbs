<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4 py-12">
  <div class="max-w-lg w-full bg-white rounded-2xl shadow-lg p-8 text-center">
    
    <!-- Failed Icon -->
    <div class="mx-auto w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mb-6">
      <svg class="w-10 h-10 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </div>

    <h1 class="text-2xl font-bold text-[#003060] mb-2">Pembayaran Gagal</h1>
    <p class="text-gray-600 mb-6">Maaf, pembayaran Anda tidak berhasil atau telah kedaluwarsa. Silakan coba lagi.</p>

    {{#if order}}
    <div class="bg-gray-50 rounded-xl p-5 mb-6 text-left space-y-3">
      <div class="flex justify-between">
        <span class="text-gray-500 text-sm">Order ID</span>
        <span class="text-gray-700 text-sm font-mono">{{order.id}}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-500 text-sm">Status</span>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-red-100 text-red-700 rounded-full text-xs font-medium">
          <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span> {{order.status}}
        </span>
      </div>
    </div>
    {{/if}}

    <a href="/" class="block w-full h-[50px] bg-[#003060] hover:bg-[#082a4d] text-white rounded-xl font-semibold text-base transition-colors shadow-sm leading-[50px]">
      Kembali ke Beranda
    </a>
  </div>
</div>
