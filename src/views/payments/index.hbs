<div class="min-h-screen bg-[#FAFAFA] font-inter pt-20 md:pt-28 pb-16">
  <div class="max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Back Link (Figma Layer: Back link) -->
    <div class="mb-8">
      {{> components/ui/button/back_link/index
        label="Back"
      }}
    </div>

    <!-- Page Header (Dynamic based on selected program) -->
    {{> components/ui/text/section_header/index
      title=(default course.name "Program Registration")
      titleTag="h1"
      titleClass="font-montserrat font-bold text-2xl sm:text-3xl md:text-[34px] leading-tight md:leading-[42px] text-[#003060]"
      description="Please complete your payment to verify your registration and activate your participation."
      descClass="font-montserrat font-normal text-sm sm:text-base text-[#718096] mt-1"
      align="text-left"
      wrapperClass="mb-10 md:mb-14"
    }}

    <!-- Icon Stepper (Figma Layer: Steps / Icon Stepper Core) -->
    {{> components/ui/stepper/icon_stepper/index }}

    <!-- Form Container Card (Figma Layer: Personal information card) -->
    {{#> components/ui/card/form_card/index}}
      <!-- Step 1: Registration Form -->
      <div id="step-1-content" class="step-content">
        {{> payments/registration}}
      </div>

      <!-- Step 2: Payment Method -->
      <div id="step-2-content" class="step-content hidden">
        {{> payments/paymentMethod}}
      </div>

      <!-- Step 3: Confirmation / Checkout Result -->
      <div id="step-3-content" class="step-content hidden">
        {{> payments/successfull}}
      </div>
    {{/components/ui/card/form_card/index}}

  </div>
</div>

<script>
  const paymentStorageUserId = '{{user.id}}';
  const paymentStorageCourseId = '{{course.id}}';
  const paymentProgressStorageKey = paymentStorageUserId && paymentStorageCourseId
    ? `payment-${paymentStorageUserId}-${paymentStorageCourseId}-form`
    : null;

  function readPaymentProgressDraft() {
    if (!paymentProgressStorageKey) return null;

    const raw = localStorage.getItem(paymentProgressStorageKey);
    if (!raw) return null;

    try {
      return JSON.parse(raw);
    } catch (error) {
      return null;
    }
  }

  function savePaymentProgressStep(step) {
    if (!paymentProgressStorageKey) return;

    const safeStep = [1, 2, 3].includes(Number(step)) ? Number(step) : 1;
    const existingDraft = readPaymentProgressDraft() || {};
    if (Number(existingDraft.form) === safeStep) return;

    const nextDraft = {
      ...existingDraft,
      userId: paymentStorageUserId,
      courseId: paymentStorageCourseId,
      form: safeStep,
      forms: existingDraft.forms || {},
    };

    localStorage.setItem(paymentProgressStorageKey, JSON.stringify(nextDraft));
  }

  window.getPaymentProgressStorageKey = function() {
    return paymentProgressStorageKey;
  };

  function goToStep(step, skipValidation = false) {
    // Validate step 1 if trying to go to step 2
    if (step === 2 && !skipValidation) {
      const form = document.getElementById('step-1-form');
      if (form && !form.checkValidity()) {
        form.reportValidity(); // This shows browser's required messages
        return; // Stop execution, don't change step
      }
    }

    // Hide all contents
    document.querySelectorAll('.step-content').forEach(el => el.classList.add('hidden'));
    
    // Show target content
    const targetContent = document.getElementById(`step-${step}-content`);
    if (targetContent) {
      targetContent.classList.remove('hidden');
      targetContent.classList.add('animate-fade-in');
    }

    // Update Step Indicators (Icon Stepper)
    document.querySelectorAll('.step-indicator').forEach(indicator => {
      const indicatorStep = parseInt(indicator.dataset.step);
      const circle = indicator.querySelector('.step-circle') || indicator.querySelector('div');
      const icon = indicator.querySelector('.step-icon');
      const title = indicator.querySelector('.step-title');
      const subtitle = indicator.querySelector('.step-subtitle');

      const originalIcon =
        indicatorStep === 1
          ? 'fa-solid fa-user'
          : indicatorStep === 2
          ? 'fa-regular fa-credit-card'
          : 'fa-regular fa-circle-check';

      if (indicatorStep < step) {
        // Completed step
        if (circle) circle.className = 'step-circle flex items-center justify-center size-12 rounded-full transition-all duration-300 bg-[#1A56DB] border-4 border-white shadow-[0px_4px_8px_rgba(26,86,219,0.14)]';
        if (icon) icon.className = 'step-icon fa-solid fa-check text-lg text-white transition-colors duration-300';
        if (title) title.className = 'step-title font-inter font-bold text-xs sm:text-sm md:text-base text-[#1A56DB] transition-colors duration-300';
        if (subtitle) subtitle.className = 'step-subtitle font-inter font-normal text-[11px] sm:text-xs md:text-[13px] text-[#6B7280] transition-colors duration-300 mt-0.5';
      } else if (indicatorStep === step) {
        // Current active step
        if (circle) circle.className = 'step-circle flex items-center justify-center size-12 rounded-full transition-all duration-300 bg-[#1A56DB] border-4 border-white shadow-[0px_4px_8px_rgba(26,86,219,0.14)]';
        if (icon) icon.className = `step-icon ${originalIcon} text-lg text-white transition-colors duration-300`;
        if (title) title.className = 'step-title font-inter font-bold text-xs sm:text-sm md:text-base text-[#1A56DB] transition-colors duration-300';
        if (subtitle) subtitle.className = 'step-subtitle font-inter font-normal text-[11px] sm:text-xs md:text-[13px] text-[#6B7280] transition-colors duration-300 mt-0.5';
      } else {
        // Future / inactive step
        if (circle) circle.className = 'step-circle flex items-center justify-center size-12 rounded-full transition-all duration-300 bg-white border-2 border-[#E5E7EB] shadow-[0px_2px_4px_rgba(0,0,0,0.02)]';
        if (icon) icon.className = `step-icon ${originalIcon} text-lg text-[#9CA3AF] transition-colors duration-300`;
        if (title) title.className = 'step-title font-inter font-semibold text-xs sm:text-sm md:text-base text-[#6B7280] transition-colors duration-300';
        if (subtitle) subtitle.className = 'step-subtitle font-inter font-normal text-[11px] sm:text-xs md:text-[13px] text-[#9CA3AF] transition-colors duration-300 mt-0.5';
      }
    });

    // Scroll back to top of form
    window.scrollTo({ top: 0, behavior: 'smooth' });
    
    // Save step to sessionStorage & localStorage
    sessionStorage.setItem('currentPaymentStep', step);
    savePaymentProgressStep(step);

    document.dispatchEvent(
      new CustomEvent('payment:step-changed', {
        detail: { step: Number(step) || 1 }
      })
    );
  }

  // Restore step on page reload and handle Back Button
  document.addEventListener('DOMContentLoaded', () => {
    const backBtn = document.querySelector('a[href="javascript:history.back()"]');
    if (backBtn) {
      backBtn.addEventListener('click', (e) => {
        const localDraft = readPaymentProgressDraft();
        const currentStep = Number(localDraft?.form) || parseInt(sessionStorage.getItem('currentPaymentStep') || '1');
        if (currentStep > 1) {
          e.preventDefault();
          goToStep(currentStep - 1, true);
        }
      });
    }

    const navigationEntry = performance.getEntriesByType('navigation')[0];
    const navigationType = navigationEntry ? navigationEntry.type : 'navigate';
    const localDraft = readPaymentProgressDraft();
    const savedStep = Number(localDraft?.form) || parseInt(sessionStorage.getItem('currentPaymentStep') || '1');

    if (navigationType !== 'reload') {
      goToStep(1, true);
      return;
    }

    if (savedStep >= 1 && savedStep <= 3) {
      goToStep(savedStep, true);
    } else {
      goToStep(1, true);
    }
  });
</script>

{{#if autoStep}}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    goToStep({{autoStep}}, true);
    sessionStorage.removeItem('currentPaymentStep');
  });
</script>
{{/if}}

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.4s ease-out forwards;
  }
</style>
