<!-- GALLERY SECTION -->
<section id="gallery" class="w-full bg-[#FAFAFA] font-montserrat">
  
  <!-- 1. KONTEN KHUSUS MOBILE (< 640px) -->
  <div class="block sm:hidden w-full py-12 px-5">
    
    <!-- Header Section -->
    {{> components/ui/section_header
        wrapperClass="mb-14"
        title=(t 'test.categoryFreeProgram.gallery.title')
        titleClass="font-montserrat font-semibold text-3xl sm:text-4xl lg:text-4xl text-center mb-12"
        description=(t 'test.categoryFreeProgram.gallery.description')
        descClass="font-sans font-normal text-base sm:text-lg lg:text-xl text-[#000000]/80 text-center max-w-auto mx-auto"
    }}

    <!-- 2. Gallery Grid (3 Kolom) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 justify-items-center w-full max-w-[1200px]">
      
      <!-- KOLOM 1 -->
      <div class="flex flex-col gap-6 lg:gap-8 w-full">
        {{> components/ui/card_gallery heightClass="h-[225px] md:h-[240px]" image=(default gallery.[0].filePath "https://upload.wikimedia.org/wikipedia/commons/2/29/Kepala_Badan_Koordinasi_Penanaman_Modal_Bahlil_Lahadalia_%28cropped%29.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled") }}
        {{> components/ui/card_gallery heightClass="h-[433px] md:h-[460px]" image=(default gallery.[3].filePath "https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=600&h=800&fit=crop") }}
      </div>
      
      <!-- KOLOM 2 -->
      <div class="flex flex-col gap-6 lg:gap-8 w-full">
        {{> components/ui/card_gallery heightClass="h-[433px] md:h-[460px]" image=(default gallery.[1].filePath "https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=600&h=800&fit=crop") }}
        {{> components/ui/card_gallery heightClass="h-[225px] md:h-[240px]" image=(default gallery.[4].filePath "https://images.unsplash.com/photo-1552664730-d307ca884978?q=80&w=600&h=400&fit=crop") }}
      </div>
      
      <!-- KOLOM 3 -->
      <div class="flex flex-col gap-6 lg:gap-8 w-full">
        {{> components/ui/card_gallery heightClass="h-[225px] md:h-[240px]" image=(default gallery.[2].filePath "https://images.unsplash.com/photo-1542744173-8e7e53415bb0?q=80&w=600&h=400&fit=crop") }}
        {{> components/ui/card_gallery heightClass="h-[433px] md:h-[460px]" image=(default gallery.[5].filePath "https://images.unsplash.com/photo-1515169067868-5387ec356754?q=80&w=600&h=800&fit=crop") }}
      </div>
    </div>

    <!-- See All Link Mobile -->
    <div class="text-center mt-10">
      <a href="/dashboard/gallery" class="inline-flex items-center gap-2 text-[#0B1F3B] text-sm font-semibold border-b-[1.5px] border-[#0B1F3B] pb-1">
        {{t 'test.categoryFreeProgram.gallery.allGaleries'}} <i class="fa-solid fa-arrow-right-long text-xs"></i>
      </a>
    </div>

  </div>
</section>
