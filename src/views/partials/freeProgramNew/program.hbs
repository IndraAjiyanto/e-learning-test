<section id="programs" class="py-20 bg-[#FAFAFA] font-montserrat">
  <div class="w-full px-6 max-w-[1440px] mx-auto">
    
    <!-- Section Header -->
    <div class="text-center mb-14">
      <h2 class="font-montserrat font-semibold text-2xl sm:text-3xl lg:text-4xl text-[#6EB6E5] leading-none tracking-normal text-center mb-7">
        {{category.name}} <span class="text-black">{{t 'test.categoryFreeProgram.program.title'}}</span>
      </h2>
      <p class="font-sans font-normal text-base sm:text-lg lg:text-xl leading-relaxed lg:leading-[45px] tracking-normal text-center text-black/80 max-w-auto mx-auto">
        {{t 'test.categoryFreeProgram.program.description1'}} {{category.name}} {{t 'test.categoryFreeProgram.program.description2'}}
      </p>
    </div>

    <!-- Course Cards Grid -->
    <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-8 justify-items-start">
      
      {{#if courses.length}}
        {{#each courses}}
          {{> components/ui/card/category/free/index 
              id=this.id 
              image=this.image 
              name=this.name 
              day=this.day 
              method=this.method 
              quota=this.quota
          }}
        {{/each}}
      {{else}}
        <!-- Default Fallback Card -->
        {{> components/ui/card/category/free/index 
            isFallback=true
            name="COMING SOON" 
            method="Offline" 
            quota="100"
        }}
      {{/if}}

    </div>

  </div>
</section>

