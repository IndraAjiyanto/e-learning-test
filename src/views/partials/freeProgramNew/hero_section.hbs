<section 
  class="relative z-10 w-full font-montserrat min-h-[850px] lg:min-h-[920px] pt-14 sm:pt-16 pb-[480px] sm:pb-[540px] lg:pb-[600px] bg-[#FAFAFA] overflow-hidden"
  x-data="{
    currentIndex: 0,
    intervalId: null,
    images: [
      '/public/image/freeProgram/bg2.png',
      '/public/image/freeProgram/bg1.png',
      '/public/image/freeProgram/bg4.png',
      '/public/image/freeProgram/bg3.png'
    ],
    init() {
      // Preload all 4 background images to prevent flashing/blank frames
      this.images.forEach(src => {
        const img = new Image();
        img.src = src;
      });

      // Respect prefers-reduced-motion settings
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return;
      }

      // Continuous loop: hold briefly (2.5s) + 0.5s smooth crossfade transition
      this.intervalId = setInterval(() => {
        this.currentIndex = (this.currentIndex + 1) % this.images.length;
      }, 3000);
    }
  }"
>
  <!-- Animated Background Stack Layers (bg2 -> bg1 -> bg4 -> bg3) -->
  <div class="absolute inset-0 z-0 w-full h-full pointer-events-none select-none overflow-hidden">
    <img 
      src="/public/image/freeProgram/bg2.png" 
      alt="" 
      class="absolute inset-0 w-full h-full object-cover object-bottom transition-opacity duration-500 ease-in-out"
      :class="currentIndex === 0 ? 'opacity-100' : 'opacity-0'"
    />
    <img 
      src="/public/image/freeProgram/bg1.png" 
      alt="" 
      class="absolute inset-0 w-full h-full object-cover object-bottom transition-opacity duration-500 ease-in-out"
      :class="currentIndex === 1 ? 'opacity-100' : 'opacity-0'"
    />
    <img 
      src="/public/image/freeProgram/bg4.png" 
      alt="" 
      class="absolute inset-0 w-full h-full object-cover object-bottom transition-opacity duration-500 ease-in-out"
      :class="currentIndex === 2 ? 'opacity-100' : 'opacity-0'"
    />
    <img 
      src="/public/image/freeProgram/bg3.png" 
      alt="" 
      class="absolute inset-0 w-full h-full object-cover object-bottom transition-opacity duration-500 ease-in-out"
      :class="currentIndex === 3 ? 'opacity-100' : 'opacity-0'"
    />
  </div>

  <!-- Content Container (Static, Sharp & Above Background) -->
  <div class="relative z-10 container mx-auto my-20 px-6 max-w-[1320px] text-center flex flex-col items-center">
    
    <!-- Title -->
    <h1 class="font-montserrat font-semibold text-2xl sm:text-3xl lg:text-4xl text-[#000000] leading-none tracking-normal text-center mb-4">
      Free Short Classes to Boost Your Career
    </h1>

    <!-- Subtitle -->
    <p class="font-sans font-normal text-base sm:text-lg lg:text-xl leading-relaxed lg:leading-[45px] tracking-normal text-center text-[#000000] max-w-3xl mx-auto mb-8">
      Learn practical skills from industry experts through our free short class.
    </p>

    <!-- View Program Button -->
    <button
      onclick="document.getElementById('programs') ? document.getElementById('programs').scrollIntoView({ behavior: 'smooth' }) : window.scrollTo({ top: 600, behavior: 'smooth' })"
      class="inline-flex items-center justify-center gap-[10px] bg-[#003060] hover:bg-[#001f3f] text-white border border-[#003060] rounded-[12px] p-[10px] w-full sm:w-[281px] h-[54px] shadow-[0px_0px_4px_0px_rgba(0,0,0,0.5)] transition-all duration-300 cursor-pointer"
    >
      <span class="font-montserrat font-medium text-lg sm:text-[25px] leading-none tracking-normal text-center">View Program</span>
      <i class="fa-solid fa-arrow-down text-base sm:text-lg"></i>
    </button>

  </div>
</section>
