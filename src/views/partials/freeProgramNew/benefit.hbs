<section class="relative w-full min-h-[1090px] py-16 lg:py-20 bg-[#FAFAFA] font-montserrat overflow-hidden justify-center">
  
  <!-- Background Image (Student + Plant + Dots Pattern) -->
  <div 
    class="absolute inset-0 z-0 w-full h-full min-h-[1090px] bg-cover bg-center md:bg-right bg-no-repeat pointer-events-none opacity-100"
    style="background-image: url('/public/image/freeProgram/bgBenefit.png');"
  ></div>

  <!-- Content Container -->
  <div class="relative z-10 container mx-auto px-6 lg:px-16 max-w-[1440px]">
    <div class="w-full lg:w-full flex flex-col items-start text-left">
      
      <!-- Title Badge with Stabilo Highlight Animation -->
      <div 
        class="relative w-fit rounded-[10px] mb-4 flex items-center justify-start overflow-hidden shadow-sm"
        x-data="{
          isHighlighted: false,
          init() {
            const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  this.isHighlighted = true;
                }
              });
            }, { threshold: 0.4, rootMargin: '0px 0px -50px 0px' });
            observer.observe(this.$el);
          }
        }"
      >
        <!-- Base Text (Initial State before Stabilo) -->
        <h2 class="font-montserrat font-semibold text-[#003060] text-2xl sm:text-3xl lg:text-4xl leading-none tracking-normal text-left whitespace-nowrap px-6 py-3.5">
          Benefits of Joining a Short Class
        </h2>

        <!-- Blue Stabilo Highlight Layer (Sweeps from Left 0% to 100% Width) -->
        <div 
          class="absolute inset-y-0 left-0 bg-[#003060] rounded-[10px] transition-all duration-[800ms] ease-out overflow-hidden flex items-center justify-start whitespace-nowrap shadow-md pointer-events-none"
          :class="isHighlighted ? 'w-full' : 'w-0'"
        >
          <!-- White Text Revealed as Blue Stabilo Sweeps Over -->
          <h2 class="font-montserrat font-semibold text-white text-2xl sm:text-3xl lg:text-4xl leading-none tracking-normal text-left whitespace-nowrap px-6 py-3.5 min-w-max">
            Benefits of Joining a Short Class
          </h2>
        </div>
      </div>

      <!-- Subtitle -->
      <p class="font-sans font-normal text-base sm:text-lg lg:text-xl leading-relaxed lg:leading-[45px] tracking-normal text-[#000000CC] max-w-none lg:whitespace-nowrap mb-10">
        Get the most out of our free short class with valuable learning benefits
      </p>

      <!-- Benefit Pills / Box List (Staggered Fade In from Left Animation) -->
      <div 
        class="flex flex-col items-start gap-10 w-full max-w-2xl"
        x-data="{
          isVisible: false,
          init() {
            const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  this.isVisible = true;
                }
              });
            }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });
            observer.observe(this.$el);
          }
        }"
      >
        
        <!-- Item 1 -->
        <div 
          class="bg-[#E0F1F9]/50 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)] px-6 py-5 sm:h-[78px] flex items-center justify-start text-[#003060] font-sans font-normal text-lg sm:text-[25px] leading-snug sm:leading-[45px] tracking-normal text-left transition-all duration-700 ease-out"
          :class="isVisible ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-[250px]'"
          style="transition-delay: 100ms;"
        >
          Full Program access
        </div>

        <!-- Item 2 -->
        <div 
          class="bg-[#E0F1F9]/50 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)] px-6 py-5 sm:h-[78px] flex items-center justify-start text-[#003060] font-sans font-normal text-lg sm:text-[25px] leading-snug sm:leading-[45px] tracking-normal text-left transition-all duration-700 ease-out"
          :class="isVisible ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-[250px]'"
          style="transition-delay: 250ms;"
        >
          Lifetime Learning materials
        </div>

        <!-- Item 3 -->
        <div 
          class="bg-[#E0F1F9]/50 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)] px-6 py-5 sm:h-[78px] flex items-center justify-start text-[#003060] font-sans font-normal text-lg sm:text-[25px] leading-snug sm:leading-[45px] tracking-normal text-left transition-all duration-700 ease-out"
          :class="isVisible ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-[250px]'"
          style="transition-delay: 400ms;"
        >
          Certificate of Completion
        </div>

        <!-- Item 4 -->
        <div 
          class="bg-[#E0F1F9]/50 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)] px-6 py-5 sm:h-[78px] flex items-center justify-start text-[#003060] font-sans font-normal text-lg sm:text-[25px] leading-snug sm:leading-[45px] tracking-normal text-left transition-all duration-700 ease-out"
          :class="isVisible ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-[250px]'"
          style="transition-delay: 550ms;"
        >
          Community Support
        </div>

        <!-- Item 5 -->
        <div 
          class="bg-[#E0F1F9]/50 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)] p-6 sm:p-7 min-h-[78px] h-auto max-w-xl sm:max-w-2xl flex items-center justify-start text-[#003060] font-sans font-normal text-lg sm:text-[22px] lg:text-[25px] leading-relaxed sm:leading-[38px] tracking-normal text-left transition-all duration-700 ease-out"
          :class="isVisible ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-[250px]'"
          style="transition-delay: 700ms;"
        >
          <span>Meet and interact directly with industry experts <br class="hidden sm:inline" />through live Q&A sessions</span>
        </div>

      </div>

    </div>
  </div>
</section>
