<section id="faq" class='w-full py-20 bg-[#FAFAFA]'>
  <div class='container mx-auto px-4 lg:px-8 max-w-5xl'>
    <!-- Bagian Header -->
    <div class='max-w-3xl mx-auto text-center mb-12 space-y-3'>
      <!-- Judul 2 Warna -->
      <h2 class='text-3xl md:text-4xl font-semibold font-montserrat leading-tight'>
        <span style="color: #0B1F3B;">Frequently Asked</span> <span style="color: #6EB6E5;">Questions</span>
      </h2>
      <!-- Jika ingin kembali menggunakan translasi dinamis, gunakan kode ini: -->
      <!-- <h2 class="text-3xl md:text-4xl font-semibold font-montserrat leading-tight text-[#0B1F3B]">{{t "test.specialProgram.faqSection.title"}}</h2> -->
      
      <p class='text-[16px] md:text-[17px]' style="color: #374151; font-family: 'Open Sans', sans-serif;">
        Browse common questions and get the information you need quickly and easily.
      </p>
    </div>
    <!-- Bagian Alpine.js & Daftar FAQ -->
    <div class='max-w-4xl mx-auto'
      x-data="{
        activeIndex: null,
        currentPage: 1,
        itemsPerPage: 5,
        faqs: [
          {{#if faqs.length}}
            {{#each faqs}}
              { question: `{{getByLang question ../lang}}`, answer: `{{getByLang answer ../lang}}` }{{#unless @last}},{{/unless}}
            {{/each}}
          {{else}}
            // DUMMY DATA: Tampil otomatis jika database/tabel faqs kosong
            { question: 'How long in house training program?', answer: 'Our bootcamp program typically runs for 4 months with intensive weekend classes. You\'ll learn through hands-on projects and mentorship from industry experts.' },
            { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.' },
            { question: 'What is the payment method?', answer: 'We offer flexible payment options including full payment, installments, and early bird discounts. Contact us for more details.' }
          {{/if}}
        ],
        get paginatedFaqs() {
          const start = (this.currentPage - 1) * this.itemsPerPage;
          const end = start + this.itemsPerPage;
          return this.faqs.slice(start, end);
        },
        get totalPages() {
          return Math.ceil(this.faqs.length / this.itemsPerPage);
        },
        toggle(index) {
          this.activeIndex = this.activeIndex === index ? null : index;
        }
      }"
    >
      
      <!-- Wrapper Daftar FAQ -->
      <div class="border-t border-gray-200">
        <template x-for="(faq, index) in paginatedFaqs" :key="index">
          <div class="border-b border-gray-200">
            
            <!-- Tombol Pertanyaan -->
            <button
              @click="toggle((currentPage - 1) * itemsPerPage + index)"
              class="w-full text-left py-6 focus:outline-none flex items-center justify-between group"
            >
              <div class="flex items-center gap-4">
                <!-- Titik Hitam (Bullet) -->
                <div class="w-1.5 h-1.5 bg-[#0B1F3B] rounded-full flex-shrink-0"></div>
                <!-- Garis Vertikal Tipis -->
                <div class="w-[1px] h-5 bg-gray-300 flex-shrink-0"></div>
                <!-- Teks Pertanyaan -->
                <h3 class="text-[16px] md:text-[17px] font-semibold text-gray-900 group-hover:text-[#6EB6E5] transition-colors duration-300" x-text="faq.question"></h3>
              </div>
              
              <!-- Icon Chevron -->
              <div class="flex-shrink-0 ml-4">
                <i class="fas fa-chevron-down text-gray-500 transition-transform duration-300"
                   :class="activeIndex === (currentPage - 1) * itemsPerPage + index ? 'rotate-180 text-[#6EB6E5]' : ''">
                </i>
              </div>
            </button>
            
            <!-- Jawaban (Accordion Dropdown dengan Transisi Asli) -->
            <div
              x-show="activeIndex === (currentPage - 1) * itemsPerPage + index"
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 max-h-0"
              x-transition:enter-end="opacity-100 max-h-[500px]"
              x-transition:leave="transition ease-in duration-200"
              x-transition:leave-start="opacity-100 max-h-[500px]"
              x-transition:leave-end="opacity-0 max-h-0"
              class="overflow-hidden"
            >
              <!-- Padding Left (pl-10) untuk menyejajarkan teks answer dengan teks pertanyaan (melewati bullet) -->
              <div class="pl-10 pr-4 pb-6">
                <p class="text-gray-600 leading-relaxed text-[15px] md:text-[16px]" x-html="faq.answer"></p>
              </div>
            </div>
            
          </div>
        </template>
      </div>
      <!-- Pagination Minimalis (Hanya tampil jika Halaman > 1) -->
      <div class="flex items-center justify-center gap-4 mt-10" x-show="totalPages > 1" style="display: none;">
        <!-- Tombol Mundur -->
        <button
          @click="currentPage = Math.max(1, currentPage - 1)"
          :disabled="currentPage === 1"
          class="text-slate-400 hover:text-[#0B1F3B] disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
        >
          <i class="fas fa-angles-left"></i>
        </button>
        <!-- Angka Halaman -->
        <div class="text-[15px] font-semibold text-gray-600">
          <span x-text="currentPage" class="text-[#0B1F3B]"></span>
          <span class="mx-1">/</span>
          <span x-text="totalPages"></span>
        </div>
        <!-- Tombol Maju -->
        <button
          @click="currentPage = Math.min(totalPages, currentPage + 1)"
          :disabled="currentPage === totalPages"
          class="text-slate-400 hover:text-[#0B1F3B] disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
        >
          <i class="fas fa-angles-right"></i>
        </button>
      </div>
    </div>
  </div>
</section>