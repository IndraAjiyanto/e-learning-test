<section class="bg-gradient-to-b from-[#CEE5F6] to-[#fafafa] min-h-[659px] w-full flex justify-center items-center pt-28 pb-16 relative">
  
  <div class="w-full max-w-[1537px] px-8 lg:px-16 mx-auto flex flex-col">
    
    <!-- Tombol Kembali -->
    <div class="w-full mb-12">
      <a href="javascript:history.back()" class="inline-flex items-center justify-center w-11 h-11 rounded-full border border-[#0B1F3B]/30 text-[#0B1F3B] hover:bg-[#0B1F3B]/10 transition-all shadow-sm">
        <i class="fa-solid fa-arrow-left text-[15px]"></i>
      </a>
    </div>

    <!-- Wrapper Konten Utama -->
    <!-- PERUBAHAN: Mengubah items-center menjadi items-start agar sejajar atas -->
    <div class="flex flex-col lg:flex-row justify-between items-start gap-12 lg:gap-8 w-full">
      
      <!-- ========================================== -->
      <!-- KONTEN KIRI: JUDUL, DESKRIPSI & LEARN MORE -->
      <!-- ========================================== -->
      <!-- PERUBAHAN: Menambahkan pt-2 agar secara visual lebih presisi dengan sudut kartu -->
      <div class="w-full lg:w-[calc(100%-680px)] flex flex-col items-start pt-2">
        
        <!-- Judul: Ukuran diperbesar ke 42px dan jarak antar baris dirapatkan -->
        <h1 class="text-[#0B1F3B] text-[38px] lg:text-[42px] leading-[1.25] font-semibold font-montserrat uppercase">
          {{course.name}}
        </h1>
        
        <!-- Deskripsi: mt-7 untuk jarak yang pas dari judul, leading-[1.8] agar baris lega -->
        <p class="text-gray-700 text-[18px] leading-[1.8] mt-7 pr-8 font-normal font-montserrat">
          {{#if course.description}}
            {{getByLang course.description lang}}
          {{else}}
            Learn the fundamentals of Python for data analysis from scratch to better understand data insights in a simpler and more structured way.
          {{/if}}
        </p>

        <!-- Tombol: mt-12 untuk memberi jarak yang jauh dari description (seperti desain) -->
        <a href="#participants" class="flex items-center justify-center w-[273px] h-[71px] mt-12 border border-[#7AA3C4] text-[#0B1F3B] bg-transparent text-[17px] font-semibold rounded-[8px] hover:bg-[#7AA3C4]/10 transition-colors">
          {{t 'test.freeProgram.hero.learn'}} <i class="fa-solid fa-arrow-down ml-3 text-[15px]"></i>
        </a>
      </div>

      <!-- ========================================== -->
      <!-- KONTEN KANAN: KARTU PENDAFTARAN -->
      <!-- ========================================== -->
      <div class="w-full lg:w-[634px] lg:h-[559px] shrink-0 bg-[#F4F9FD] rounded-[16px] border border-gray-200 shadow-sm p-10 lg:p-12 flex flex-col justify-between font-sans">
          
          <div class="flex flex-col gap-7">
            <!-- Save The Date -->
            <div>
              <div class="flex items-center gap-3 text-black">
                <i class="fa-regular fa-calendar-days text-[22px]"></i>
                <span class="font-bold text-[18px]">{{t 'test.freeProgram.hero.saveDate'}}</span>
              </div>
              <p class="text-gray-800 text-[15px] mt-1.5 ml-[35px]">
                {{formatDate course.startDate lang}} - <span class="capitalize">{{course.method}}</span>
              </p>
            </div>

            <!-- Location -->
            <div>
              <div class="flex items-center gap-3 text-black">
                <i class="fa-solid fa-location-dot text-[22px]"></i>
                <span class="font-bold text-[18px]">{{t 'test.freeProgram.hero.location'}}</span>
              </div>
              <p class="text-gray-800 text-[15px] mt-1.5 ml-[35px] leading-relaxed pr-4">
                {{#if (eq course.method 'offline')}}
                  {{getByLang course.locations lang}}
                {{else}}
                  Zoom / Google Meet (Link will be provided)
                {{/if}}
              </p>
            </div>

            <!-- Grid Waktu & Kapasitas -->
            <div class="grid grid-cols-2 gap-6 mt-1">
              <div>
                <div class="flex items-center gap-3 text-black">
                  <i class="fa-regular fa-clock text-[22px]"></i>
                  <span class="font-bold text-[18px]">{{t 'test.freeProgram.hero.time'}}</span>
                </div>
                <p class="text-gray-800 text-[15px] mt-1.5 ml-[35px]">
                  {{formatTime course.time_start}}
                </p>
              </div>
              <div>
                <div class="flex items-center gap-3 text-black">
                  <i class="fa-solid fa-user-group text-[20px]"></i>
                  <span class="font-bold text-[18px]">{{t 'test.freeProgram.hero.capacity'}}</span>
                </div>
                <p class="text-gray-800 text-[15px] mt-1.5 ml-[35px]">
                  {{course.quota}} {{t 'test.freeProgram.hero.students'}}
                </p>
              </div>
            </div>
          </div>

          <!-- Bagian Bawah Kartu -->
          <div class="mt-8 flex flex-col items-center w-full">
            <p class="text-[#CC0000] font-bold text-[18px] text-center mb-5">
              {{t 'test.freeProgram.hero.regisUntil'}} {{formatDate course.date_registration lang}}
            </p>
            <a @click.prevent="openRegistrationModal()" class="flex items-center justify-center w-full h-[58px] bg-[#032A55] hover:bg-[#021b3a] text-white font-medium text-[17px] rounded-[10px] transition-colors shadow-sm cursor-pointer">
              {{t 'test.freeProgram.hero.regisNow'}}
            </a>
          </div>

      </div>

    </div>
  </div>
</section>