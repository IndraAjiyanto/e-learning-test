<!-- PARTICIPANTS SECTION -->
<!-- Menambahkan id="participants" agar tombol di Nav Menu bisa scroll ke sini -->
<section id="participants" class="w-full bg-[#FAFAFA] py-20 font-montserrat">
  
  <div class="max-w-[1537px] mx-auto px-8 lg:px-16 flex flex-col items-center">
    
    <!-- 1. Badge Judul (Tengah) -->
    <div class="inline-flex items-center justify-center border border-[#7AA3C4] bg-[#EBF3F9] text-[#0B1F3B] px-10 py-2.5 rounded-full font-medium text-[16px] mb-14">
      {{t 'test.freeProgram.badge.participants'}}
    </div>

    <!-- 2. Grid Kartu -->
    <!-- Dibatasi max-w-[1100px] agar ketiga kartu mengelompok di tengah seperti desain -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 w-full max-w-[1100px]">
      
      {{#each course.participants}}
      <div class="bg-white border border-gray-200 rounded-[12px] p-8 md:p-10 flex flex-col items-center justify-center text-center hover:shadow-md transition-shadow">
        <!-- Area Icon -->
        <div class="text-black mb-7 flex items-center justify-center h-[60px]">
          <i class="fa-solid {{this.icon}} text-[42px]"></i>
        </div>
        <!-- Title -->
        <h3 class="text-black font-semibold text-[17px] leading-[1.5] mb-2">
          {{getByLang this.title ../lang}}
        </h3>
        <!-- Deskripsi -->
        <p class="text-[#545454] text-[14px] leading-[1.6]">
          {{getByLang this.description ../lang}}
        </p>
      </div>
      {{/each}}

    </div>

  </div>
</section>