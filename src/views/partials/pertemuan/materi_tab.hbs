<script>
function materiModal() {
  return {
    isOpen: false,
    currentSlide: 0,
    materi: {
      id: null,
      judul: '',
      jenis_file: '',
      file: '',
      slides: []
    },
    
    get totalSlides() {
      return this.materi.slides ? this.materi.slides.length : 0;
    },
    
    openModal(data) {
      console.log('Opening modal with data:', data);
      console.log('Jenis file:', data.jenis_file);
      console.log('Slides:', data.slides);
      
      this.materi = data;
      
      // Pastikan slides adalah array
      if (data.slides && !Array.isArray(data.slides)) {
        console.log('Slides bukan array, converting...');
        this.materi.slides = [];
      }
      
      this.currentSlide = 0;
      this.isOpen = true;
      document.body.style.overflow = 'hidden';
      
      console.log('Modal opened, isOpen:', this.isOpen);
    },
    
    closeModal() {
      this.isOpen = false;
      document.body.style.overflow = 'auto';
    },
    
    nextSlide() {
      if (this.currentSlide < this.totalSlides - 1) {
        this.currentSlide++;
      }
    },
    
    prevSlide() {
      if (this.currentSlide > 0) {
        this.currentSlide--;
      }
    }
  }
}

function materiData() {
  return {
    tabMateri: localStorage.getItem('tabMateri') || 'pdf',
    dataMateri: localStorage.getItem('dataMateri') ? JSON.parse(localStorage.getItem('dataMateri')) : [],

    async init() {
      const urlMap = {
        pdf: '/pertemuans/pdf/{{pertemuan.id}}',
        video: '/pertemuans/video/{{pertemuan.id}}',
        ppt: '/pertemuans/ppt/{{pertemuan.id}}'
      }

      await this.toggleFetchMateri(urlMap[this.tabMateri], this.tabMateri);
    },

    async toggleFetchMateri(url, jenis) {
      this.tabMateri = jenis;
      localStorage.setItem('tabMateri', jenis);
      try{
      const res = await fetch(url);
      this.dataMateri = await res.json();
  
      localStorage.setItem('dataMateri', JSON.stringify(this.dataMateri));
      } catch (error) {
        console.error('❌ Error:', error);
      }

    }


  }
}
</script>