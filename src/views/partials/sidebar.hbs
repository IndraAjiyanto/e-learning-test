{{!--
  Partial: Sidebar (L3 Layout)
  Lokasi: src/views/partials/sidebar.hbs

  Shell sidebar dashboard: header logo, navigasi per-role, dan kartu profil user.
  Seluruh item navigasi dirangkai dari atomik L1 di
  `components/ui/sidebar/{nav_link,nav_group,nav_icon,user_pill}`.

  State Alpine (dipakai oleh atomik nav_link / nav_group):
  - isMobile          : true bila viewport < 1024px (di-update saat resize)
  - sidebarOpen       : sidebar terlihat (selalu true di desktop)
  - active            : path item daun yang sedang aktif
  - activeDropdown    : key dropdown level 1 yang terbuka
  - activeSubDropdown : key dropdown level 2 yang terbuka
--}}

<div
  x-data="{
    isMobile: window.innerWidth < 1024,
    sidebarOpen: window.innerWidth >= 1024,
    active: localStorage.getItem('activeLink') || '/dashboard',
    activeDropdown: localStorage.getItem('activeDropdown') || null,
    activeSubDropdown: localStorage.getItem('activeSubDropdown') || null,

    setActive(path) {
      if (path === '/users') {
        this.activeDropdown = null;
        localStorage.removeItem('activeDropdown');
      }
      this.active = path;
      localStorage.setItem('activeLink', path);
      if (this.isMobile) {
        this.sidebarOpen = false;
      }
    },

    setActiveDropdown(dropdown) {
      if (this.active === '/users') {
        this.active = null;
        localStorage.removeItem('activeLink');
      }
      if (this.activeDropdown === dropdown) {
        this.activeDropdown = null;
        localStorage.removeItem('activeDropdown');
      } else {
        this.activeDropdown = dropdown;
        localStorage.setItem('activeDropdown', dropdown);
      }
    },

    setActiveSubDropdown(subDropdown) {
      if (this.activeSubDropdown === subDropdown) {
        this.activeSubDropdown = null;
        localStorage.removeItem('activeSubDropdown');
      } else {
        this.activeSubDropdown = subDropdown;
        localStorage.setItem('activeSubDropdown', subDropdown);
      }
    },

    init() {
      window.addEventListener('resize', () => {
        const wasMobile = this.isMobile;
        this.isMobile = window.innerWidth < 1024;
        if (this.isMobile !== wasMobile) {
          this.sidebarOpen = !this.isMobile;
        }
      });
    }
  }"
  class="relative"
>
  {{!-- Tombol toggle (mobile) --}}
  <button
    type="button"
    @click="sidebarOpen = !sidebarOpen"
    :aria-expanded="sidebarOpen"
    aria-label="Toggle sidebar"
    class="lg:hidden fixed top-4 left-4 z-50 p-2 rounded-[8px] bg-white text-[#003060] border border-[#D9D9D9]
      shadow-[0px_1px_2px_0px_rgba(0,0,0,0.08)] transition-colors duration-150
      hover:bg-[#E7F3FB] active:bg-[#D7E9F6]
      focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#055C90]/40"
  >
    <svg x-show="!sidebarOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    <svg x-show="sidebarOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  {{!-- Overlay (mobile) --}}
  <div
    x-show="sidebarOpen && isMobile"
    @click="sidebarOpen = false"
    x-transition:enter="transition-opacity ease-linear duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition-opacity ease-linear duration-300"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 bg-black/40 z-40 lg:hidden"
  ></div>

  <aside
    x-show="sidebarOpen"
    x-transition:enter="transition ease-out duration-300 transform"
    x-transition:enter-start="-translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-300 transform"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="-translate-x-full"
    class="fixed left-0 top-0 z-40 h-screen w-[319px] max-w-[85vw] flex flex-col justify-between
      bg-[#FAFAFA] border-r border-[#D9D9D9]"
  >
    {{!-- Header logo --}}
    <div class="flex flex-col flex-1 min-h-0 overflow-hidden">
      <div class="flex items-center h-[88px] px-[28px] border-b border-[#D9D9D9] shrink-0">
        {{> components/ui/icon/logo_kesatria/index
            src='/public/image/sidebar/logo_kesatria_blue.png'
            alt='Kesatria Academy'
            class='h-[60px] w-[189px]'
            wrapperClass='!justify-start'
        }}
      </div>

      {{!-- Navigasi --}}
      <nav
        class="sidebar-scroll flex-1 min-h-0 overflow-y-auto bg-[#FAFAFA] px-[12px] py-[16px] space-y-[4px]"
        aria-label="Sidebar navigation"
      >
        {{#if (eq user.role 'admin')}}

          {{> components/ui/sidebar/nav_link/index href='/program' label='Program' icon='icon_program'}}

        {{else if (eq user.role 'super_admin')}}

          {{> components/ui/sidebar/nav_link/index href='/users' label='Users' icon='icon_users'}}

          {{#> components/ui/sidebar/nav_group/index key='dashboard' label='Dashboard' icon='icon_dashboard'}}
            {{> components/ui/sidebar/nav_link/index href='/partnership' label='Partner' level=2 icon=''}}
            {{> components/ui/sidebar/nav_link/index href='/faq' label='FAQ' level=2 icon=''}}
            {{> components/ui/sidebar/nav_link/index href='/benefit' label='Benefit' level=2 icon=''}}
            {{> components/ui/sidebar/nav_link/index href='/about' label='Header' level=2 icon=''}}
          {{/components/ui/sidebar/nav_group/index}}

          {{#> components/ui/sidebar/nav_group/index key='program' label='Program' icon='icon_program'}}
            {{> components/ui/sidebar/nav_link/index href='/category' label='Category' level=2 icon=''}}
            {{> components/ui/sidebar/nav_link/index href='/type-program' label='Program Type' level=2 icon=''}}
            {{> components/ui/sidebar/nav_link/index href='/technology' label='Tech' level=2 icon=''}}
            {{> components/ui/sidebar/nav_link/index href='/program' label='Program' level=2 icon=''}}
            {{> components/ui/sidebar/nav_link/index href='/voucher' label='Voucher' level=2 icon=''}}
          {{/components/ui/sidebar/nav_group/index}}

          {{#> components/ui/sidebar/nav_group/index key='about' label='About' icon='icon_about'}}
            {{> components/ui/sidebar/nav_link/index href='/paragraphs' label='Story' level=2 icon=''}}
            {{> components/ui/sidebar/nav_link/index href='/team' label='Team' level=2 icon=''}}
            {{> components/ui/sidebar/nav_link/index href='/social' label='Social' level=2 icon=''}}
            {{> components/ui/sidebar/nav_link/index href='/value' label='Value' level=2 icon=''}}
            {{> components/ui/sidebar/nav_link/index href='/commitment' label='Commitment' level=2 icon=''}}

            {{#> components/ui/sidebar/nav_group/index key='visionsMisi' label='Visi Misi' level=2 icon=''}}
              {{> components/ui/sidebar/nav_link/index href='/vision' label='Visi' level=3 icon=''}}
              {{> components/ui/sidebar/nav_link/index href='/mission' label='Misi' level=3 icon=''}}
            {{/components/ui/sidebar/nav_group/index}}

            {{#> components/ui/sidebar/nav_group/index key='teamLead' label='Team Lead' level=2 icon=''}}
              {{> components/ui/sidebar/nav_link/index href='/team-lead' label='Information' level=3 icon=''}}
              {{> components/ui/sidebar/nav_link/index href='/experience' label='Experience' level=3 icon=''}}
              {{> components/ui/sidebar/nav_link/index href='/background' label='Background' level=3 icon=''}}
            {{/components/ui/sidebar/nav_group/index}}
          {{/components/ui/sidebar/nav_group/index}}

        {{/if}}
      </nav>
    </div>

    {{!-- Kartu profil user --}}
    <div class="shrink-0 bg-[#FAFAFA] border-t border-[#D9D9D9] px-[20px] pt-[21px] pb-[20px]">
      {{> components/ui/sidebar/user_pill/index
          username=user.username
          role=user.role
          profile=user.profile
          initial=(substring user.username 0 1)
      }}
    </div>
  </aside>
</div>
