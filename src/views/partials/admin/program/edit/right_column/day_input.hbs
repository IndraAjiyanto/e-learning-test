                    <!-- Day -->
                    <div
                      x-show="!paidClass"
                    >
                      <label for='day' class='block text-sm font-semibold text-gray-700 mb-1'>Day</label>
                      <div x-data="{
                        display: '',
                        value: '',
                        formatHari(event) {
                          let angka = event.target.value.replace(/\D/g, '');
                          this.value = angka;
                          this.display = angka;
                        }
                      }"
                      x-init="
                        value = '{{course.day}}';
                        display = value;
                      ">
                        <input type='text'
                               id='day'
                               x-model="display"
                               @input="formatHari($event)"
                               placeholder='Enter day (1-31)'
                               class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'>
                        <input type="hidden" name="day" x-model="value">
                      </div>
                    </div>