<!-- Cover Program* — EDIT (oldPhoto) -->
<div
  x-data="{
    previewUrl: null,
    oldPhoto: '{{course.image}}',
    errorMessage: '',
    isValid: true,
    fileName: '',
    fileSize: 0,
    imageWidth: 0,
    imageHeight: 0,
    hasFile: false,
    isDragOver: false,
    validateImage(file) {
        if (!file) {
            this.hasFile = false;
            $dispatch('cover-validation', { isValid: true, hasFile: false });
            return;
        }
        this.hasFile = true;
        this.fileName = file.name;
        this.fileSize = file.size;
        this.errorMessage = '';
        this.isValid = true;
        const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
        if (!allowedTypes.includes(file.type)) {
            this.errorMessage = 'Only JPEG, JPG, and PNG formats are allowed';
            this.isValid = false;
            this.previewUrl = null;
            $dispatch('cover-validation', { isValid: false, hasFile: true });
            return;
        }
        const maxSize = 10 * 1024 * 1024;
        if (file.size > maxSize) {
            this.errorMessage = `File size too large (${(file.size / 1024 / 1024).toFixed(2)}MB). Maximum 10MB`;
            this.isValid = false;
            this.previewUrl = null;
            $dispatch('cover-validation', { isValid: false, hasFile: true });
            return;
        }
        const img = new Image();
        const objectUrl = URL.createObjectURL(file);
        img.onload = () => {
            this.imageWidth = img.width;
            this.imageHeight = img.height;
            if (img.width < 1900 || img.width > 1920 || img.height < 1000 || img.height > 1080) {
                this.errorMessage = `Image dimensions ${img.width}x${img.height}px. Required: 1900x1000 to 1920x1080 pixels`;
                this.isValid = false;
                this.previewUrl = null;
                URL.revokeObjectURL(objectUrl);
                $dispatch('cover-validation', { isValid: false, hasFile: true });
            } else {
                this.previewUrl = objectUrl;
                this.isValid = true;
                this.errorMessage = '';
                $dispatch('cover-validation', { isValid: true, hasFile: true });
            }
        };
        img.onerror = () => {
            this.errorMessage = 'Failed to load image';
            this.isValid = false;
            this.previewUrl = null;
            URL.revokeObjectURL(objectUrl);
            $dispatch('cover-validation', { isValid: false, hasFile: true });
        };
        img.src = objectUrl;
    },
    clearFile() {
        this.previewUrl = null;
        this.errorMessage = '';
        this.isValid = true;
        this.fileName = '';
        this.fileSize = 0;
        this.imageWidth = 0;
        this.imageHeight = 0;
        this.hasFile = false;
        this.isDragOver = false;
        $refs.fileInput.value = null;
        $dispatch('cover-validation', { isValid: true, hasFile: false });
    },
    handleDrop(e) {
        this.isDragOver = false;
        const file = e.dataTransfer.files[0];
        if (file) {
            const dt = new DataTransfer();
            dt.items.add(file);
            $refs.fileInput.files = dt.files;
            this.validateImage(file);
        }
    }
  }"
  @cover-validation.window="updateCoverValidation($event.detail.isValid, $event.detail.hasFile)"
  @category-selected.window="categorySelected = $event.detail.category"
  class="flex flex-col gap-2 w-full"
>
  <label class="text-sm font-medium font-inter text-[#404040]">Cover Program*</label>
  <input type="file" id="image" name="image" accept="image/jpeg,image/jpg,image/png" x-ref="fileInput" class="hidden" @change="validateImage($event.target.files[0])">
  <input type="hidden" name="old_image" value="{{course.image}}">

  <!-- Drop Zone — sama persis dengan Create: 363.5×128 -->
  <label
    for="image"
    @dragover.prevent="isDragOver = true"
    @dragleave="isDragOver = false"
    @drop.prevent="handleDrop($event)"
    :class="isDragOver ? 'border-[#003060] bg-[#E4F1F7]' : 'border-[#D9D9D9] bg-[#F8F9FA]'"
    class="box-border flex flex-col justify-center items-center p-[8px_16px] gap-[10px] w-full h-[128px] border rounded-[8px] cursor-pointer transition-colors hover:border-[#003060] hover:bg-[#E4F1F7]"
  >
    <!-- Placeholder when no preview and no oldPhoto -->
    <template x-if="!previewUrl && !oldPhoto">
      <div class="flex flex-col items-center w-[329.5px] h-[72px]">
        <div class="w-10 h-10 flex justify-center items-center">
          <i class="fas fa-image text-[#718096] text-[32px] leading-none"></i>
        </div>
        <p class="font-inter font-medium text-[12px] leading-[16px] text-[#718096] text-center w-[329.5px]">Drag & Drop your Image here or click to browse</p>
        <p class="font-inter font-medium text-[10px] leading-[12px] text-[#ADB7C5] text-center w-[329.5px]">JPG / PNG · 1900×1000 – 1920×1080 · Max 10 MB</p>
      </div>
    </template>

    <!-- New preview -->
    <template x-if="previewUrl">
      <div class="w-[240px] h-[126px] rounded-[4px] overflow-hidden flex justify-center items-center shrink-0">
        <img :src="previewUrl" alt="Preview" class="w-full h-full object-cover" />
      </div>
    </template>

    <!-- Old photo when no new file -->
    <template x-if="!previewUrl && oldPhoto">
      <div class="w-[240px] h-[126px] rounded-[4px] overflow-hidden flex justify-center items-center shrink-0">
        <img :src="oldPhoto" alt="Current Cover" class="w-full h-full object-cover" />
      </div>
    </template>
  </label>

  <!-- Info -->
  <template x-if="previewUrl && isValid">
    <div class="flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg">
      <i class="fas fa-check-circle text-green-500"></i>
      <span class="text-xs text-green-700 font-inter"><span class="font-semibold">Valid image:</span> <span x-text="`${imageWidth}x${imageHeight}px, ${(fileSize / 1024 / 1024).toFixed(2)}MB`"></span></span>
      <button type="button" @click="clearFile()" class="ml-auto text-red-500 hover:text-red-700"><i class="fas fa-times"></i></button>
    </div>
  </template>

  <template x-if="!previewUrl && oldPhoto">
    <p class="text-xs text-gray-500 font-inter">Current image — drag & drop atau click untuk ganti</p>
  </template>

  <template x-if="!isValid && errorMessage">
    <div class="flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg">
      <i class="fas fa-exclamation-circle text-red-500 mt-0.5"></i>
      <div>
        <p class="text-sm font-semibold text-red-800">Invalid Image</p>
        <p class="text-xs text-red-700" x-text="errorMessage"></p>
      </div>
    </div>
  </template>
</div>
