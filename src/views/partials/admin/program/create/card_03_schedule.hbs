{{!--
  Card 03 - Schedule & Location
  Path: partials/admin/program/create/card_03_schedule.hbs
--}}
{{#> components/ui/admin/form/form-card num="03" title="Schedule & Location" id="section-03"}}
<div class='flex flex-col gap-[16px] w-full'>

  {{!-- Time & Registration Date Row --}}
  <div class='flex flex-row gap-[16px] w-full'>
    <div class='flex-1' x-show='!paidClass'>
      {{#> components/ui/admin/form/form-field label="Time Start*" for="time_start" errorId="time_start_error"}}
        <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'>
          <input type='time' id='time_start' name='time_start' value='{{#if course}}{{formatTime course.time_start}}{{/if}}'
            :disabled='paidClass'
            class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none [color-scheme:light] cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed'
            @blur='validateTimeFields()' @input='clearTimeErrors()' />
        </div>
      {{/components/ui/admin/form/form-field}}
    </div>
    <div class='flex-1' x-show='!paidClass'>
      {{#> components/ui/admin/form/form-field label="Time End*" for="time_end" errorId="time_end_error"}}
        <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'>
          <input type='time' id='time_end' name='time_end' value='{{#if course}}{{formatTime course.time_end}}{{/if}}'
            :disabled='paidClass'
            class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none [color-scheme:light] cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed'
            @blur='validateTimeFields()' @input='clearTimeErrors()' />
        </div>
      {{/components/ui/admin/form/form-field}}
    </div>

    {{#> components/ui/admin/form/form-field label="Registration Date*" for="date_registration" errorId="date_registration_error" class="flex-1"}}
      <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'>
        <input type='date' id='date_registration' name='date_registration' value='{{formDate course.date_registration}}'
          class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none [color-scheme:light] cursor-pointer'
          @blur='validateDateField("date_registration", "Date Registration")' />
      </div>
    {{/components/ui/admin/form/form-field}}
  </div>

  {{!-- Month / Day / Start Date / End Date Row --}}
  <div class='flex flex-row gap-[16px] w-full'>
    <div class='flex-1' x-show='paidClass'>
      {{#> components/ui/admin/form/form-field label="Month*" for="month" errorId="month_error"}}
        <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'>
          <input type='number' id='month' name='month' placeholder='1-12' value='{{#if course}}{{course.month}}{{/if}}'
            :disabled='!paidClass'
            class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]'
            @blur='validateNumberField("month", "Month", 1, 12)' />
        </div>
      {{/components/ui/admin/form/form-field}}
    </div>
    <div class='flex-1' x-show='!paidClass'>
      {{#> components/ui/admin/form/form-field label="Day*" for="day" errorId="day_error"}}
        <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'>
          <input type='number' id='day' name='day' placeholder='1-31' value='{{#if course}}{{course.day}}{{/if}}'
            :disabled='paidClass'
            class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]'
            @blur='validateNumberField("day", "Day", 1, 31)' />
        </div>
      {{/components/ui/admin/form/form-field}}
    </div>

    {{#> components/ui/admin/form/form-field label="Start Date*" for="startDate" errorId="startDate_error" class="flex-1"}}
      <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'>
        <input type='date' id='startDate' name='startDate' value='{{formDate course.startDate}}'
          class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none [color-scheme:light] cursor-pointer'
          @blur='validateDateField("startDate", "Start Date")' />
      </div>
    {{/components/ui/admin/form/form-field}}

    {{#> components/ui/admin/form/form-field label="End Date*" for="endDate" errorId="endDate_error" class="flex-1"}}
      <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'>
        <input type='date' id='endDate' name='endDate' value='{{formDate course.startEnd}}'
          class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none [color-scheme:light] cursor-pointer'
          @blur='validateDateField("endDate", "End Date", "startDate", "Start Date")' />
      </div>
    {{/components/ui/admin/form/form-field}}
  </div>

  {{!-- Location Tabs + Price/Quota Row --}}
  <div class='flex flex-col gap-[16px] w-full'
    x-data="{ locTab: 'id' }">

    {{!-- Location Tabs --}}
    {{> components/ui/admin/form/language-tabs alpineVar="locTab" variant="compact"}}

    {{!-- Location Inputs --}}
    <div class='flex flex-col gap-[6px] w-full'>
      <label class='text-[14px]/[normal] text-[#404040] font-inter font-medium'>Location*</label>
      <div x-show='locTab === "id"'>
        <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'>
          <input type='text' id='lokasi_id' name='lokasi_id' placeholder='Enter location...'
            x-model='formData.location.id'
            @blur='validateField("location", "id")'
            class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]' />
        </div>
        <div id='lokasi_id_error' class='hidden text-red-500 text-xs mt-1'></div>
      </div>
      <div x-show='locTab === "en"'>
        <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'>
          <input type='text' id='lokasi_en' name='lokasi_en' placeholder='Enter location...'
            x-model='formData.location.en'
            @blur='validateField("location", "en")'
            class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]' />
        </div>
        <div id='lokasi_en_error' class='hidden text-red-500 text-xs mt-1'></div>
      </div>
      <div x-show='locTab === "ja"'>
        <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'>
          <input type='text' id='lokasi_ja' name='lokasi_ja' placeholder='Enter location...'
            x-model='formData.location.ja'
            @blur='validateField("location", "ja")'
            class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]' />
        </div>
        <div id='lokasi_ja_error' class='hidden text-red-500 text-xs mt-1'></div>
      </div>
    </div>

    {{!-- Price / Promo (super_admin only) --}}
    <div class='flex flex-row gap-[16px] w-full'>
      {{#if (roles user.role 'super_admin')}}
      <div class='flex-1'>
        {{#> components/ui/admin/form/form-field label="Price" for="harga1" errorId="harga1_error"}}
          <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FEFCE8] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'
            x-data="{ display: '', value: '', formatHarga(e) { let angka = e.target.value.replace(/\D/g, ''); this.value = angka; this.display = new Intl.NumberFormat('id-ID').format(angka); } }"
            {{#if course}}x-init="value = '{{course.price}}'; display = value ? new Intl.NumberFormat('id-ID').format(value) : '';"{{/if}}>
            <input type='text' id='harga1' x-model='display' @input='formatHarga($event)' placeholder='Enter price'
              class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]' />
            <input type='hidden' name='price' x-model='value' />
          </div>
        {{/components/ui/admin/form/form-field}}
      </div>
      <div class='flex-1'>
        {{#> components/ui/admin/form/form-field label="Promo" for="promo1" errorId="promo1_error"}}
          <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FEFCE8] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'
            x-data="{ display: '', value: '', formatPromo(e) { let angka = e.target.value.replace(/\D/g, ''); this.value = angka; this.display = new Intl.NumberFormat('id-ID').format(angka); } }"
            {{#if course}}x-init="value = '{{course.promo}}'; display = value ? new Intl.NumberFormat('id-ID').format(value) : '';"{{/if}}>
            <input type='text' id='promo1' x-model='display' @input='formatPromo($event)' placeholder='Enter promo'
              class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]' />
            <input type='hidden' name='promo' x-model='value' />
          </div>
        {{/components/ui/admin/form/form-field}}
      </div>
      {{/if}}
    </div>
  </div>

  {{!-- Link Location --}}
  {{#> components/ui/admin/form/form-field label="Link Location*" for="locationLink" errorId="locationLink_error"}}
    <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'
      :class="formErrors.locationLink ? '[outline-color:#DC2626]' : (formValid.locationLink ? '[outline-color:#22C55E]' : '')">
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#737373' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px] shrink-0'><path d='M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71'/><path d='M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71'/></svg>
      <input type='url' id='locationLink' name='locationLink' placeholder='https://...'
        x-model='formData.locationLink'
        @blur='validateLocationLink()'
        class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]' />
    </div>
    <template x-if='formErrors.locationLink'>
      <div class='text-red-500 text-xs mt-1' x-text='formErrors.locationLink'></div>
    </template>
  {{/components/ui/admin/form/form-field}}

  {{!-- Registration Form Link (super_admin, free program) --}}
  {{#if (roles user.role 'super_admin')}}
  <div>
    {{#> components/ui/admin/form/form-field label="Registration Form Link" for="form" errorId="form_error"}}
      <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FEFCE8] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'>
        <input type='url' id='form' name='form' placeholder='https://forms.google.com/...' value='{{#if course}}{{course.form}}{{/if}}'
          class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]' />
      </div>
    {{/components/ui/admin/form/form-field}}
  </div>
  {{/if}}

</div>
{{/components/ui/admin/form/form-card}}
