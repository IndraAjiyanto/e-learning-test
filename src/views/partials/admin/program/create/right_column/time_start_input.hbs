 <!-- Time Start-->
 <div x-show='!paidClass'>
          <label
            for='time_start'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Time Start</label>
          <input
            type='time'
            id='time_start'
            name='time_start'
            :disabled='paidClass'
            :class="borderClass('time_start')"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed'
            style='color-scheme: light;'
          />
          <div id='time_start_error' class='hidden text-red-500 text-xs mt-1'></div>
        </div>