        <!-- Category -->
        <div
          x-data="{
          search: '',
          selectedCategory: null,
          showDropdown: false,
          categoryLocked: {{#if categoryId}}true{{else}}false{{/if}},
          initialCategoryId: {{#if categoryId}}{{categoryId}}{{else}}null{{/if}},
          availableCategories: {{json category}},
          init() {
            if (this.initialCategoryId) {
              const preselected = this.availableCategories.find(c => c.id == this.initialCategoryId);
              if (preselected) this.selectCategory(preselected);
            }
          },
          get filteredCategories() {
            return this.availableCategories.filter(c =>
              c.name.toLowerCase().includes(this.search.toLowerCase())
            );
          },
          selectCategory(category) {
            this.selectedCategory = category;
            this.search = category.name;
            this.showDropdown = false;
            $dispatch('category-selected', { category });
          },
          clearCategory() {
            if (this.categoryLocked) return;
            this.selectedCategory = null;
            this.search = '';
            $dispatch('category-selected', { category: null });
          }
        }"
          @click.away='showDropdown = false'
        >
          <label
            for="categoryId"
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Category</label>

          <div class='relative'>
            <input
              type='text'
              x-model='search'
              @focus='if (!categoryLocked) showDropdown = true'
              @input='if (!categoryLocked) showDropdown = true'
              :disabled='categoryLocked'
              placeholder='Search and select category...'
              :class="[borderClass('categoryId'), categoryLocked ? 'bg-gray-100 text-gray-500 cursor-not-allowed' : 'bg-white text-gray-700']"
              class='w-full border rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2'
            />
            
            <!-- Dropdown -->
            <div
              x-show='!categoryLocked && showDropdown && filteredCategories.length > 0'
              class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'
            >
              <template
                x-for='category in filteredCategories'
                :key='category.id'
              >
                <button
                  type='button'
                  @click='selectCategory(category)'
                  class='w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition text-left border-b border-gray-100 last:border-0'
                >
                  <span
                    class='text-sm font-medium text-gray-700'
                    x-text='category.name'
                  ></span>
                </button>
              </template>
            </div>

            <input
              type='hidden'
              name="categoryId"
              :value='selectedCategory ? selectedCategory.id : ""'
            />
          </div>
          <div id='categoryId_error' class='hidden text-red-500 text-xs mt-1'></div>
        </div>