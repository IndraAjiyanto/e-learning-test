        <!-- Class Type -->
        <div
          x-data="{
          search: '',
          selectedJenisKelas: null,
          showDropdown: false,
          availableJenisKelas: {{json courseType}},
          get filteredJenisKelas() {
            return this.availableJenisKelas.filter(j => 
              j.name_clasess_type.toLowerCase().includes(this.search.toLowerCase())
            );
          },
          selectJenisKelas(jenisKelas) {
            this.selectedJenisKelas = jenisKelas;
            this.search = jenisKelas.name_clasess_type;
            this.showDropdown = false;
          },
          clearJenisKelas() {
            this.selectedJenisKelas = null;
            this.search = '';
          }
        }"
          @click.away='showDropdown = false'
        >
          <label
            for='jenis_kelasId'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Program Type</label>

          <div class='relative'>
            <input
              type='text'
              x-model='search'
              @focus='showDropdown = true'
              @input='showDropdown = true'
              placeholder='Search and select program type...'
              class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
            />
            <i
              class='fas fa-search absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400'
            ></i>

            <!-- Dropdown -->
            <div
              x-show='showDropdown && filteredJenisKelas.length > 0'
              class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'
            >
              <template
                x-for='jenisKelas in filteredJenisKelas'
                :key='jenisKelas.id'
              >
                <button
                  type='button'
                  @click='selectJenisKelas(jenisKelas)'
                  class='w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition text-left border-b border-gray-100 last:border-0'
                >
                  <span
                    class='text-sm font-medium text-gray-700'
                    x-text='jenisKelas.name_clasess_type'
                  ></span>
                </button>
              </template>
            </div>

            <input
              type='hidden'
              name='jenis_kelasId'
              x-model='selectedJenisKelas ? selectedJenisKelas.id : ""'
            />
          </div>
        </div>