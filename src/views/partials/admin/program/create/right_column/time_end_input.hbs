          <label
            for="time_end"
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Time End</label>
          <input
            type='time'
            id="time_end"
            name="time_end"
            class='w-full border bg-white border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700 cursor-pointer'
            style='color-scheme: light;'
          />
        </div>

        {{/if}}