{{!--
  Baris sesi yang belum terbuka.

  Bentuknya sengaja sejajar dengan baris sesi yang terbuka di
  start_learning/index.hbs - lencana nomor, judul, keterangan - hanya warnanya
  teredam dan ikonnya gembok. Versi lama berupa kartu tebal dengan `opacity-75`
  sehingga tampak seperti komponen rusak, bukan sesuatu yang memang belum bisa
  dibuka.

  Syaratnya kebalikan dari baris terbuka: sesi terkunci bila belum punya baris
  progres atau `isAttended` masih false. Ingat, `isAttended` di sini berarti
  "sesi sudah terbuka", bukan "student sudah absen".
--}}
<template x-if='session.sessionProgress.length === 0 || session.sessionProgress[0].isAttended === false'>
  <div class='flex items-center justify-between gap-3 rounded-lg border border-[#E5E5E5] bg-[#FAFAFA] px-4 py-3'>
    <div class='flex min-w-0 items-center gap-3'>
      <span class='grid size-8 shrink-0 place-items-center rounded-lg bg-[#E5E5E5] text-[#a3a3a3]'>
        <i class='fa-solid fa-lock text-xs'></i>
      </span>
      <div class='min-w-0'>
        <h4
          class='truncate font-montserrat text-sm font-bold text-[#737373]'
          x-text='session.topic || `{{t "test.startLearning.session"}} ${session.sessionOrder}`'
        ></h4>
        <p class='mt-0.5 font-inter text-xs text-[#a3a3a3]'>
          {{t 'test.startLearning.completeThePreviousSession'}}
        </p>
      </div>
    </div>
  </div>
</template>
