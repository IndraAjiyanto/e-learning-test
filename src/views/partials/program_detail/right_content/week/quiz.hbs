                  <!-- Week Quiz Section -->
                  <div
                    class='mt-6 p-4 bg-gradient-to-r from-slate-50 to-slate-100 rounded-lg border border-slate-200'
                  >
                    <h4
                      class='font-semibold text-gray-800 mb-3 flex items-center text-sm'
                    >
                      <svg
                        class='w-4 h-4 mr-1.5 text-slate-600'
                        fill='none'
                        stroke='currentColor'
                        viewBox='0 0 24 24'
                      >
                        <path
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          stroke-width='2'
                          d='M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z'
                        />
                      </svg>
                      {{t 'test.startLearning.weekQuiz'}}
                    </h4>

                    <template x-for='quiz in quizData' :key='quiz.id'>
                      <div>
                        <template x-if='quiz.progres_quiz.length > 0'>
                          <div>
                            <template x-if='quiz.question?.length > 0'>

                              <a
                                :href='`/quiz/form/${quiz.id}`'
                                class='btn border-0 group flex items-center justify-center w-full text-center px-5 py-2.5 bg-gradient-to-r from-slate-700 to-slate-800 text-white rounded-lg shadow-md hover:shadow-lg hover:-translate-y-1 hover:from-slate-600 hover:to-slate-700 transform transition-all duration-300 text-sm'
                              >
                                <svg
                                  class='w-4 h-4 mr-1.5 group-hover:-translate-y-1 transition-transform'
                                  fill='none'
                                  stroke='currentColor'
                                  viewBox='0 0 24 24'
                                >
                                  <path
                                    stroke-linecap='round'
                                    stroke-linejoin='round'
                                    stroke-width='2'
                                    d='M13 10V3L4 14h7v7l9-11h-7z'
                                  />
                                </svg>
                                <span class='font-semibold'>{{t
                                    'test.startLearning.takeQuiz'
                                  }}</span>

                              </a>

                            </template>
                            <template x-if='!quiz.question?.length'>
                              <div
                                class='flex items-center justify-center p-3 bg-gray-100 rounded-lg'
                              >
                                <svg
                                  class='w-4 h-4 text-gray-400 mr-1.5'
                                  fill='none'
                                  stroke='currentColor'
                                  viewBox='0 0 24 24'
                                >
                                  <path
                                    stroke-linecap='round'
                                    stroke-linejoin='round'
                                    stroke-width='2'
                                    d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                                  />
                                </svg>
                                <p
                                  class='text-gray-500 text-center text-xs font-medium'
                                >{{t 'test.startLearning.quizNotAvailable'}}</p>
                              </div>
                            </template>
                          </div>
                        </template>
                        <template x-if='quiz.progres_quiz.length === 0'>
                          <div
                            class='flex items-center p-3 bg-yellow-50 border border-yellow-200 rounded-lg'
                          >
                            <svg
                              class='w-4 h-4 text-yellow-600 mr-2'
                              fill='none'
                              stroke='currentColor'
                              viewBox='0 0 24 24'
                            >
                              <path
                                stroke-linecap='round'
                                stroke-linejoin='round'
                                stroke-width='2'
                                d='M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z'
                              />
                            </svg>
                            <p class='text-xs text-yellow-800 font-medium'>
                              {{t
                                'test.startLearning.completeAllSessionsToAccessQuiz'
                              }}
                            </p>
                          </div>
                        </template>
                      </div>
                    </template>
                  </div>