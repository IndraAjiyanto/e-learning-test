{{!--
  Baris kuis minggu, dipasang di kaki daftar sesi.

  Versi lama menampilkannya sebagai pita gelap selebar penuh dengan gradien dan
  efek angkat saat disentuh, sehingga bobotnya melebihi sesi-sesi yang justru
  harus dikerjakan lebih dulu. Sekarang bentuknya sebaris dengan kartu sesi:
  ikon, judul, lalu satu tombol berukuran wajar di kanan.

  Tiga keadaan yang mungkin, sama seperti sebelumnya:
  - kuis terbuka dan ada soal        -> tombol Take Quiz
  - kuis terbuka tetapi belum ada soal -> keterangan abu
  - kuis belum terbuka               -> pita kuning berisi alasannya
--}}
{{!-- Baris ini hanya muncul bila minggunya memang punya kuis. Tanpa penjaga
     ini, minggu tanpa kuis tetap menampilkan judul "Week Quiz" kosong. --}}
<div x-show='quizData && quizData.length' class='mt-3 rounded-lg border border-[#E5E5E5] bg-white'>
  <div class='flex flex-wrap items-center justify-between gap-3 px-4 py-3'>
    <div class='flex min-w-0 items-center gap-2.5'>
      <span class='grid size-8 shrink-0 place-items-center rounded-lg bg-[#E4F1F7] text-[#003060]'>
        <svg class='size-4' fill='none' stroke='currentColor' viewBox='0 0 24 24' aria-hidden='true'>
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='2'
            d='M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z'
          />
        </svg>
      </span>
      <h4 class='truncate font-inter text-sm font-bold text-[#171717]'>
        {{t 'test.startLearning.weekQuiz'}}
      </h4>
    </div>

    <template x-for='quiz in quizData' :key='quiz.id'>
      <div class='shrink-0'>
        <template x-if='quiz.quizProgresses.length > 0'>
          <div>
            <template x-if='quiz.questions?.length > 0'>
              <a
                :href='`/quiz/form/${quiz.id}`'
                class='inline-flex h-10 items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-4 font-inter text-sm font-semibold text-white no-underline transition-colors hover:bg-[#00254a]'
              >
                <svg class='size-4' fill='none' stroke='currentColor' viewBox='0 0 24 24' aria-hidden='true'>
                  <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M13 10V3L4 14h7v7l9-11h-7z' />
                </svg>
                {{t 'test.startLearning.takeQuiz'}}
              </a>
            </template>
            <template x-if='!quiz.questions?.length'>
              <span class='inline-flex items-center gap-1.5 rounded-[8px] bg-[#F5F5F5] px-3 py-2 font-inter text-xs text-[#737373]'>
                <svg class='size-4' fill='none' stroke='currentColor' viewBox='0 0 24 24' aria-hidden='true'>
                  <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' />
                </svg>
                {{t 'test.startLearning.quizNotAvailable'}}
              </span>
            </template>
          </div>
        </template>
      </div>
    </template>
  </div>

  {{!-- Alasan kuis belum terbuka; dipisah ke pita bawah supaya barisnya tetap
       ringkas saat kuis memang sudah bisa dikerjakan. --}}
  <template x-for='quiz in quizData' :key='`lock-${quiz.id}`'>
    <template x-if='quiz.quizProgresses.length === 0'>
      <div class='flex items-start gap-2 border-t border-[#FEF08A] bg-[#FEFCE8] px-4 py-2.5'>
        <svg class='mt-0.5 size-4 shrink-0 text-[#A16207]' fill='none' stroke='currentColor' viewBox='0 0 24 24' aria-hidden='true'>
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='2'
            d='M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z'
          />
        </svg>
        <p class='font-inter text-xs text-[#A16207]'>
          {{t 'test.startLearning.completeAllSessionsToAccessQuiz'}}
        </p>
      </div>
    </template>
  </template>
</div>
