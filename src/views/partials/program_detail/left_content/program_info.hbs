      <div
        class='bg-white rounded-xl shadow-md border border-slate-200 overflow-hidden sticky top-24'
      >
        <div class='p-5'>
          <!-- Gambar Kelas -->
          <div class='mb-4'>
            <div class='relative rounded-lg overflow-hidden'>
              <img
                src="{{course.image}}"
                alt='{{course.name}}'
                class='w-full h-40 object-cover hover:scale-110 transition-transform duration-500'
              />
            </div>
          </div>

          <!-- Badges -->
          <div class='flex flex-wrap gap-2 mb-3'>
            <span
              class='badge bg-slate-100 text-slate-700 px-3 py-1 text-xs font-semibold rounded-md border border-slate-200'
            >
              {{course.category.name}}
            </span>
            <span
              class='badge bg-gradient-to-br from-primary via-secondary to-gray-900 text-white px-3 py-1 text-xs font-semibold rounded-md'
            >
              {{course.courseType.nameClassesType}}
            </span>
          </div>

          <!-- Content -->
          <div class='mb-3'>
            <h1
              class='text-xl font-bold text-slate-900 mb-2 leading-tight font-montserrat'
            >
              {{course.name}}
            </h1>
            <p class='text-sm text-justify text-slate-600 leading-relaxed'>
              {{getByLang course.description lang}}
            </p>
          </div>

          <!-- Actions -->
          <div class='card-actions'>
            <a
              href='{{course.grup}}'
              target='_blank'
              rel='noopener noreferrer'
              class='btn bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-500 hover:to-blue-700 text-white text-lg px-8 py-3 w-full border-0 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 mb-3'
            >
              <i class='fa-solid fa-users'></i>
              {{t 'test.startLearning.joinGroup'}}
            </a>
            <a
              href='/logbooks/user/{{course.id}}'
              class='btn bg-gradient-to-r from-green-600 to-green-800 hover:from-green-500 hover:to-green-700 text-white text-lg px-8 py-3 w-full border-0 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 mb-3'
            >
              <i class='fa-solid fa-book'></i>
              {{t 'test.startLearning.myLogbook'}}
            </a>
            <a
              href='/program/program/detail/{{course.id}}'
              class='btn bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white text-lg px-8 py-3 w-full border-0 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1'
            >
              <i class='fa-solid fa-circle-info'></i>
              {{t 'test.startLearning.detailProgram'}}
            </a>
          </div>
        </div>
      </div>