      <div
        class='bg-white rounded-xl shadow-md border border-[#E5E5E5] overflow-hidden sticky top-24'
      >
        <div class='p-5'>
          <!-- Gambar Kelas -->
          <div class='mb-4'>
            <div class='relative rounded-lg overflow-hidden'>
              <img
                src="{{course.image}}"
                alt='{{course.name}}'
                class='w-full h-40 object-cover transition-transform duration-500'
              />
            </div>
          </div>

          <!-- Badges -->
          <div class='flex flex-wrap gap-2 mb-3'>
            <span
              class='bg-slate-100 text-[#404040] px-3 py-1 text-xs font-semibold rounded-md border border-[#E5E5E5]'
            >
              {{course.category.name}}
            </span>
            <span
              class='bg-[#003060] text-white px-3 py-1 text-xs font-semibold rounded-md'
            >
              {{course.courseType.nameClassesType}}
            </span>
          </div>

          <!-- Content -->
          <div class='mb-3'>
            <h1
              class='text-xl font-bold text-[#171717] mb-2 leading-tight font-inter'
            >
              {{course.name}}
            </h1>
            <p class='text-sm text-justify text-[#525252] leading-relaxed'>
              {{getByLang course.description lang}}
            </p>
          </div>

          <!-- Actions -->
          <div class=''>
            <a
              href='{{course.group}}'
              target='_blank'
              rel='noopener noreferrer'
              class='bg-[#003060] hover:bg-[#00254a] text-white text-lg px-8 py-3 w-full border-0 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-all duration-300 mb-3'
            >
              <i class='fa-solid fa-users'></i>
              {{t 'test.startLearning.joinGroup'}}
            </a>
            <a
              href='/logbooks/user/{{course.id}}'
              class='bg-[#15803d] hover:bg-[#166534] text-white text-lg px-8 py-3 w-full border-0 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-all duration-300 mb-3'
            >
              <i class='fa-solid fa-book'></i>
              {{t 'test.startLearning.myLogbook'}}
            </a>
            <a
              href='/program/program/detail/{{course.id}}'
              class='bg-[#003060] hover:bg-[#00254a] text-white text-lg px-8 py-3 w-full border-0 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-all duration-300'
            >
              <i class='fa-solid fa-circle-info'></i>
              {{t 'test.startLearning.detailProgram'}}
            </a>
          </div>
        </div>
      </div>