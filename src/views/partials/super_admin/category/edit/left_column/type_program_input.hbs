          <!-- Jenis Kelas -->
          <div class='space-y-2'>
            <label
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Program Types</label>

            <!-- Selected Jenis Kelas -->
            <div
              class='flex flex-wrap gap-2 mb-2'
              x-show='selectedJenisKelas.length > 0'
            >
              <template x-for='jk in selectedJenisKelas' :key='jk.id'>
                <div
                  class='inline-flex items-center gap-2 px-3 py-1 bg-gray-100 text-gray-800 rounded-full text-sm'
                >
                  <span x-text='jk.nameClassesType'></span>
                  <button
                    type='button'
                    @click='removeJenisKelas(jk.id)'
                    class='text-gray-500 hover:text-red-500 transition'
                  >
                    <svg
                      xmlns='http://www.w3.org/2000/svg'
                      fill='none'
                      viewBox='0 0 24 24'
                      stroke-width='1.5'
                      stroke='currentColor'
                      class='w-4 h-4'
                    >
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        d='M6 18L18 6M6 6l12 12'
                      />
                    </svg>
                  </button>
                </div>
              </template>
            </div>

            <!-- Search Input -->
            <div class='relative'>
              <input
                type='text'
                x-model='searchJenisKelas'
                @input='showJenisKelasDropdown = true'
                @focus='showJenisKelasDropdown = true'
                placeholder='Search program types...'
                class='w-full border border-gray-300 bg-white rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-gray-900 text-gray-700'
              />
              <i
                class='fas fa-search absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400'
              ></i>

              <!-- Dropdown -->
              <div
                x-show='showJenisKelasDropdown && filteredJenisKelas.length > 0'
                class='absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-60 overflow-y-auto'
              >
                <template x-for='jk in filteredJenisKelas' :key='jk.id'>
                  <div
                    @click='selectJenisKelas(jk)'
                    class='px-4 py-2 hover:bg-gray-100 cursor-pointer text-gray-700'
                    x-text='jk.nameClassesType'
                  ></div>
                </template>
              </div>
            </div>

            <!-- Hidden inputs for selected courseType IDs -->
            <template x-for='id in formData.courseType' :key='id'>
              <input type='hidden' name='courseType[]' :value='id' />
            </template>

            <p class='text-xs text-gray-500 mt-2'>Click to select program types</p>

            <!-- Error Message -->
            <template x-if='formErrors.courseType'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.courseType'
                ></p>
              </div>
            </template>

            <!-- Success Message -->
            <template
              x-if='formTouched.courseType && formValid.courseType && !formErrors.courseType'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Program types look good</p>
              </div>
            </template>
          </div>