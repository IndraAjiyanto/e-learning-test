                  >
                    <i class='fas fa-check-circle text-green-500'></i>
                    <p class='text-xs text-green-700'>Valid</p>
                  </div>
                </template>
              </div>

              <!-- JP -->
              <div class='space-y-2'>
                <label
                  class='block text-xs font-medium text-gray-600'
                >JP</label>
                <input
                  type='text'
                  x-model='formData.for.ja'
                  @input='validateField("for", $event.target.value, "ja")'
