          <!-- For -->
          <div class='space-y-4'>
            <label
              class='block text-sm font-semibold text-gray-700 mb-1'
            >For</label>
            <div class='space-y-4'>
              <!-- ID -->
              <div class='space-y-2'>
                <label
                  class='block text-xs font-medium text-gray-600'
                >ID</label>
                <input
                  type='text'
                  x-model='formData.for.id'
                  @input='validateField("for", $event.target.value, "id")'
                  name='for[id]'
                  :class="formErrors.for.id ? 'border-red-500 focus:ring-red-500' : (formValid.for.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
                  class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                  placeholder='Untuk field (ID) (opsional)'
                />
                <template x-if='formErrors.for.id'>
                  <div
                    class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                  >
                    <i
                      class='fas fa-exclamation-circle text-red-500 mt-0.5'
                    ></i>
                    <p
                      class='text-xs text-red-700'
                      x-text='formErrors.for.id'
                    ></p>
                  </div>
                </template>
                <template
                  x-if='formTouched.for.id && formValid.for.id && !formErrors.for.id'
                >
                  <div
                    class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                  >
                    <i class='fas fa-check-circle text-green-500'></i>
                    <p class='text-xs text-green-700'>Valid</p>
                  </div>
                </template>
              </div>

              <!-- EN -->
              <div class='space-y-2'>
                <label
                  class='block text-xs font-medium text-gray-600'
                >EN</label>
                <input
                  type='text'
                  x-model='formData.for.en'
