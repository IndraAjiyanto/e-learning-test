          <!-- Type -->
          <div class='space-y-2'>
            <label
              for='type'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >
              Type
            </label>
            <select
              id='type'
              name='type'
              required
              :class="formErrors.type ? 'border-red-500 focus:ring-red-500' : formValid.type && formData.type ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              @change='validateField("type", $event.target.value)'
              x-model='formData.type'
            >
              <option value=''>Select Type</option>
              <option value='Special Program'>Special Program</option>
              <option value='Paid Program'>Paid Program</option>
              <option value='Free Program'>Free Program</option>
            </select>

            <template x-if='formErrors.type'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.type'></p>
              </div>
            </template>

            <template
              x-if='formValid.type && !formErrors.type && formData.type'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid type</p>
              </div>
            </template>
          </div>