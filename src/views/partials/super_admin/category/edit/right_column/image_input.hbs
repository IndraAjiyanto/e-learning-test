          <!-- Icon Image -->
          <div class='space-y-3'>
            <label
              for='icon'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >
              Icon Image
              <span class='text-xs text-gray-500 font-normal'>(1000x1000 -
                2000x2000px, max 5MB, JPG/PNG)</span>
            </label>

            <input
              type='file'
              id='icon'
              name='icon'
              accept='image/jpeg,image/jpg,image/png'
              x-ref='fileInput'
              :class="!isValid && errorMessage ? 'border-red-500 focus:ring-red-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-900 file:text-white hover:file:bg-gray-700 file:cursor-pointer'
              @change='validateImage($event.target.files[0])'
            />

            <template x-if='!isValid && errorMessage'>
              <div
                class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
              >
                <i
                  class='fas fa-exclamation-circle text-red-500 mt-0.5 flex-shrink-0'
                ></i>
                <div class='flex-1 min-w-0'>
                  <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
                  <p
                    class='text-xs text-red-700 break-words'
                    x-text='errorMessage'
                  ></p>
                </div>
              </div>
            </template>

            <template x-if='hasFile && isValid'>
              <div class='space-y-2'>
                <div
                  class='flex items-center justify-between p-3 bg-green-50 border border-green-300 rounded-lg'
                >
                  <div class='flex items-center gap-2 flex-1 min-w-0'>
                    <i
                      class='fas fa-check-circle text-green-500 flex-shrink-0'
                    ></i>
                    <div class='min-w-0 flex-1'>
                      <p
                        class='text-sm font-semibold text-green-800 truncate'
                        x-text='fileName'
                      ></p>
                      <p class='text-xs text-green-700' x-show='fileSize > 0'>
                        <span
                          x-text='(fileSize / 1024 / 1024).toFixed(2)'
                        ></span>
                        MB •
                        <span x-text='imageWidth'></span>x<span
                          x-text='imageHeight'
                        ></span>
                        px
                      </p>
                      <p
                        class='text-xs text-green-700'
                        x-show='fileSize === 0 && hasOldIcon'
                      >
                        Existing icon (no changes)
                      </p>
                    </div>
                  </div>
                  <button
                    type='button'
                    @click='clearFile()'
                    class='text-red-500 hover:text-red-700 transition-colors flex-shrink-0 ml-2'
                    title='Remove image'
                    x-show='!hasOldIcon || fileSize > 0'
                  >
                    <i class='fas fa-times'></i>
                  </button>
                </div>

                <div class='relative w-32 h-32'>
                  <img
                    :src='previewUrl'
                    alt='Icon Preview'
                    class='w-32 h-32 object-cover rounded-lg border-2 border-green-500 shadow-sm'
                  />
                  <button
                    type='button'
                    @click='clearFile()'
                    class='absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center hover:bg-red-700 transition-colors'
                    title='Remove image'
                    x-show='!hasOldIcon || fileSize > 0'
                  >
                    <i class='fas fa-times text-xs'></i>
                  </button>
                </div>

                <p
                  class='text-xs text-gray-500'
                  x-show='hasOldIcon && fileSize === 0'
                >
                  <i class='fas fa-info-circle'></i>
                  This is the current icon. Upload a new file to replace it.
                </p>
              </div>
            </template>
          </div>