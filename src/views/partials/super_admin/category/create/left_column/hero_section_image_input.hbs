          <!-- Hero Section Image -->
          <div class='space-y-2'>
            <label
              for='hero_section_image'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >
              Hero Section Image
              <span class='text-xs text-gray-500 font-normal'>(max 5MB, JPG/PNG/SVG)</span>
            </label>

            <input
              type='file'
              id='hero_section_image'
              name='hero_section_image'
              accept='image/jpeg,image/jpg,image/png,image/svg+xml'
              x-ref='heroSectionFileInput'
              class='w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-900 file:text-white hover:file:bg-gray-700 file:cursor-pointer'
              @change='validateHeroSectionImage($event.target.files[0])'
            />

            <!-- Error Message -->
            <template x-if='heroSectionErrorMessage'>
              <div
                class='flex items-start gap-2 p-3 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <div>
                  <p class='text-sm font-semibold text-red-800'>Invalid Image</p>
                  <p
                    class='text-xs text-red-700'
                    x-text='heroSectionErrorMessage'
                  ></p>
                </div>
              </div>
            </template>

            <!-- Success Message with File Info + Preview -->
            <template x-if='heroSectionHasFile && heroSectionIsValid'>
              <div class='space-y-2'>
                <div
                  class='flex items-center justify-between p-3 bg-green-50 border border-green-300 rounded-lg'
                >
                  <div class='flex items-center gap-2'>
                    <i class='fas fa-check-circle text-green-500'></i>
                    <div>
                      <p
                        class='text-sm font-semibold text-green-800'
                        x-text='heroSectionFileName'
                      ></p>
                      <p class='text-xs text-green-700'>
                        <span
                          x-text='(heroSectionFileSize / 1024 / 1024).toFixed(2)'
                        ></span>
                        MB
                      </p>
                    </div>
                  </div>
                  <button
                    type='button'
                    @click='clearHeroSectionFile()'
                    class='text-red-500 hover:text-red-700 transition-colors'
                    title='Remove image'
                  >
                    <i class='fas fa-times'></i>
                  </button>
                </div>

                <!-- Image Preview -->
                <div class='relative w-32 h-32'>
                  <img
                    :src='heroSectionPreviewUrl'
                    alt='Hero Section Preview'
                    class='w-32 h-32 object-cover rounded-lg border-2 border-green-500 shadow-sm'
                  />
                  <button
                    type='button'
                    @click='clearHeroSectionFile()'
                    class='absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center hover:bg-red-700 transition-colors'
                    title='Remove image'
                  >
                    <i class='fas fa-times text-xs'></i>
                  </button>
                </div>
              </div>
            </template>
          </div>
