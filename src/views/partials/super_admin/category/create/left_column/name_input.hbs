          <!-- Nama Kategori -->
          <div class='space-y-2'>
            <label
              for='nama_kategori'
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Category Name</label>
            <input
              type='text'
              id='nama_kategori'
              name='nama_kategori'
              required
              :class="formErrors.nama_kategori ? 'border-red-500 focus:ring-red-500' : formValid.nama_kategori ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              @input='validateField("nama_kategori", $event.target.value)'
            />

            <!-- Error Message -->
            <template x-if='formErrors.nama_kategori'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.nama_kategori'
                ></p>
              </div>
            </template>

            <!-- Success Message -->
            <template
              x-if='formTouched.nama_kategori && formValid.nama_kategori && !formErrors.nama_kategori'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid category name</p>
              </div>
            </template>
          </div>