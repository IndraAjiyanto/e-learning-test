      <!-- Number Select -->
      <div class='space-y-2'>
        <label for='no' class='block text-sm font-semibold text-gray-700 mb-1'>
          Number

        </label>
        <select
          x-model='no'
          @change='validateNo()'
          id='no'
          name='no'
          required
          :class="errors.no ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : success.no ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
        >
          <option value=''>-- Select Number --</option>
          {{#each availableNumbers}}
            <option value='{{this}}'>{{this}}</option>
          {{/each}}
        </select>

        <!-- Error Message -->
        <template x-if='errors.no'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='errors.no'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='success.no && !errors.no'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Number selected</p>
          </div>
        </template>
      </div>
