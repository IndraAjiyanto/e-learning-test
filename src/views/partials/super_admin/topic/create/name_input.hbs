<div class="space-y-4">
  <label class='block text-sm font-medium text-gray-700'>Topic Name</label>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

    <!-- ID -->
    <div>
      <label for='nama_id' class='block text-xs font-medium text-gray-600 uppercase tracking-wide mb-1'>ID</label>
      <input
        type='text'
        id='nama_id'
        name='nama[id]'
        required
        placeholder='Nama topik dalam bahasa Indonesia'
        class='w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 text-gray-900 bg-white'
        :class="formErrors.nama.id ? 'border-red-500 focus:ring-red-500' : (formValid.nama?.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
        x-model='formData.nama.id'
        @input="validateField('nama', 'id', $event.target.value)"
      />
      <template x-if='formErrors.nama.id'>
        <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg mt-2'>
          <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
          <p class='text-xs text-red-700' x-text='formErrors.nama.id'></p>
        </div>
      </template>
      <template x-if='formValid.nama.id && !formErrors.nama.id'>
        <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg mt-2'>
          <i class='fas fa-check-circle text-green-500'></i>
          <p class='text-xs text-green-700'>Looks good</p>
        </div>
      </template>
    </div>

    <!-- EN -->
    <div>
      <label for='nama_en' class='block text-xs font-medium text-gray-600 uppercase tracking-wide mb-1'>EN</label>
      <input
        type='text'
        id='nama_en'
        name='nama[en]'
        required
        placeholder='Topic name in English'
        class='w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 text-gray-900 bg-white'
        :class="formErrors.nama?.en ? 'border-red-500 focus:ring-red-500' : (formValid.nama?.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
        x-model='formData.nama.en'
        @input="validateField('nama', 'en', $event.target.value)"
      />
      <template x-if='formErrors.nama?.en'>
        <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg mt-2'>
          <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
          <p class='text-xs text-red-700' x-text='formErrors.nama.en'></p>
        </div>
      </template>
      <template x-if='formValid.nama?.en && !formErrors.nama?.en'>
        <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg mt-2'>
          <i class='fas fa-check-circle text-green-500'></i>
          <p class='text-xs text-green-700'>Looks good</p>
        </div>
      </template>
    </div>

    <!-- ja -->
    <div>
      <label for='nama_ja' class='block text-xs font-medium text-gray-600 uppercase tracking-wide mb-1'>ja</label>
      <input
        type='text'
        id='nama_ja'
        name='nama[ja]'
        required
        placeholder='トピック名（日本語）'
        class='w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 text-gray-900 bg-white'
        :class="formErrors.nama?.ja ? 'border-red-500 focus:ring-red-500' : (formValid.nama?.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
        x-model='formData.nama.ja'
        @input="validateField('nama', 'ja', $event.target.value)"
      />
      <template x-if='formErrors.nama?.ja'>
        <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg mt-2'>
          <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
          <p class='text-xs text-red-700' x-text='formErrors.nama.ja'></p>
        </div>
      </template>
      <template x-if='formValid.nama?.ja && !formErrors.nama?.ja'>
        <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg mt-2'>
          <i class='fas fa-check-circle text-green-500'></i>
          <p class='text-xs text-green-700'>Looks good</p>
        </div>
      </template>
    </div>

  </div>
</div>