      <!-- Text per Bahasa -->
      <div class='space-y-4'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Text
        </label>
        <div class='grid grid-cols-1 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.items.id'
              @input='validateField("items", $event.target.value, "id")'
              name='items[id]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.items.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.items.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Teks (ID)'
            ></textarea>
            <template x-if='formErrors.items.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.items.id'></p>
              </div>
            </template>
            <template
              x-if='formTouched.items.id && formValid.items.id && !formErrors.items.id'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.items.en'
              @input='validateField("items", $event.target.value, "en")'
              name='items[en]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.items.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.items.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Text (EN)'
            ></textarea>
            <template x-if='formErrors.items.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.items.en'></p>
              </div>
            </template>
            <template
              x-if='formTouched.items.en && formValid.items.en && !formErrors.items.en'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.items.ja'
              @input='validateField("items", $event.target.value, "ja")'
              name='items[ja]'
              rows='5'
              required
              maxlength='1000'
              :class="formErrors.items.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.items.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='テキスト (JA)'
            ></textarea>
            <template x-if='formErrors.items.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.items.ja'></p>
              </div>
            </template>
            <template
              x-if='formTouched.items.ja && formValid.items.ja && !formErrors.items.ja'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>