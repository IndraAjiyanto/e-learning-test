      <!-- Message per Bahasa -->
      <div class='space-y-4'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>Message</label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.pesan.id'
              @input='validateField("pesan", "id", $event.target.value)'
              name='pesan[id]'
              required
              rows='8'
              :class="formErrors.pesan.id ? 'border-red-500 focus:ring-red-500' : (formValid.pesan.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              x-init='$el.value = formData.pesan.id'
            ></textarea>
            <template x-if='formErrors.pesan.id'>
              <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'>
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.pesan.id'></p>
              </div>
            </template>
            <template x-if='formValid.pesan.id && !formErrors.pesan.id'>
              <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'>
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.pesan.en'
              @input='validateField("pesan", "en", $event.target.value)'
              name='pesan[en]'
              required
              rows='8'
              :class="formErrors.pesan.en ? 'border-red-500 focus:ring-red-500' : (formValid.pesan.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              x-init='$el.value = formData.pesan.en'
            ></textarea>
            <template x-if='formErrors.pesan.en'>
              <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'>
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.pesan.en'></p>
              </div>
            </template>
            <template x-if='formValid.pesan.en && !formErrors.pesan.en'>
              <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'>
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.pesan.ja'
              @input='validateField("pesan", "ja", $event.target.value)'
              name='pesan[ja]'
              required
              rows='8'
              :class="formErrors.pesan.ja ? 'border-red-500 focus:ring-red-500' : (formValid.pesan.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              x-init='$el.value = formData.pesan.ja'
            ></textarea>
            <template x-if='formErrors.pesan.ja'>
              <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'>
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.pesan.ja'></p>
              </div>
            </template>
            <template x-if='formValid.pesan.ja && !formErrors.pesan.ja'>
              <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'>
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>