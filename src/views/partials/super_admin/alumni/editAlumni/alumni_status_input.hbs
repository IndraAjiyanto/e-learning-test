      <!-- Alumni Status -->
      <div class='space-y-4'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>Alumni
          Status</label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <input
              x-model='formData.alumni.id'
              @input='validateField("alumni", "id", $event.target.value)'
              type='text'
              name='alumni[id]'
              required
              maxlength='255'
              :class="formErrors.alumni.id ? 'border-red-500 focus:ring-red-500' : (formValid.alumni.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              placeholder='Status Alumni (ID)'
            />
            <template x-if='formErrors.alumni.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.alumni.id'
                ></p>
              </div>
            </template>
            <template x-if='formValid.alumni.id && !formErrors.alumni.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <input
              x-model='formData.alumni.en'
              @input='validateField("alumni", "en", $event.target.value)'
              type='text'
              name='alumni[en]'
              required
              maxlength='255'
              :class="formErrors.alumni.en ? 'border-red-500 focus:ring-red-500' : (formValid.alumni.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              placeholder='Alumni Status (EN)'
            />
            <template x-if='formErrors.alumni.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.alumni.en'
                ></p>
              </div>
            </template>
            <template x-if='formValid.alumni.en && !formErrors.alumni.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <input
              x-model='formData.alumni.ja'
              @input='validateField("alumni", "ja", $event.target.value)'
              type='text'
              name='alumni[ja]'
              required
              maxlength='255'
              :class="formErrors.alumni.ja ? 'border-red-500 focus:ring-red-500' : (formValid.alumni.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              placeholder='卒業生ステータス (JA)'
            />
            <template x-if='formErrors.alumni.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.alumni.ja'
                ></p>
              </div>
            </template>
            <template x-if='formValid.alumni.ja && !formErrors.alumni.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>