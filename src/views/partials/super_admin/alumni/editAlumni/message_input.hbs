      <!-- Message -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Message</label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.message.id'
              @input='validateField("message", "id", $event.target.value)'
              name='message[id]'
              required
              rows='8'
              :class="formErrors.message.id ? 'border-red-500 focus:ring-red-500' : (formValid.message.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Pesan (ID)...'
            ></textarea>
            <template x-if='formErrors.message.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.message.id'
                ></p>
              </div>
            </template>
            <template x-if='formValid.message.id && !formErrors.message.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.message.en'
              @input='validateField("message", "en", $event.target.value)'
              name='message[en]'
              required
              rows='8'
              :class="formErrors.message.en ? 'border-red-500 focus:ring-red-500' : (formValid.message.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Message (EN)...'
            ></textarea>
            <template x-if='formErrors.message.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.message.en'
                ></p>
              </div>
            </template>
            <template x-if='formValid.message.en && !formErrors.message.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.message.ja'
              @input='validateField("message", "ja", $event.target.value)'
              name='message[ja]'
              required
              rows='8'
              :class="formErrors.message.ja ? 'border-red-500 focus:ring-red-500' : (formValid.message.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='メッセージ (JA)...'
            ></textarea>
            <template x-if='formErrors.message.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.message.ja'
                ></p>
              </div>
            </template>
            <template x-if='formValid.message.ja && !formErrors.message.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>
