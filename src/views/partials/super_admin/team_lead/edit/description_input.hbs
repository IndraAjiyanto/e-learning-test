      <!-- Description (Multi-language) -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Description</label>
        <div class='space-y-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label
              class='block text-xs font-medium text-gray-600'
            >ID</label>
            <textarea
              x-model='formData.description.id'
              x-init="$el.value = formData.description.id"
              @input='validateField("description", $event.target.value, "id")'
              name='description[id]'
              required
              rows='4'
              :class="formErrors.description.id ? 'border-red-500 focus:ring-red-500' : (formValid.description.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Enter team lead description (ID)...'
            ></textarea>
            <template x-if='formErrors.description.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.description.id'></p>
              </div>
            </template>
            <template x-if='formValid.description.id && !formErrors.description.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid description (ID)</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label
              class='block text-xs font-medium text-gray-600'
            >EN</label>
            <textarea
              x-model='formData.description.en'
              x-init="$el.value = formData.description.en"
              @input='validateField("description", $event.target.value, "en")'
              name='description[en]'
              rows='4'
              :class="formErrors.description.en ? 'border-red-500 focus:ring-red-500' : (formValid.description.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Enter team lead description (EN)...'
            ></textarea>
            <template x-if='formErrors.description.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.description.en'></p>
              </div>
            </template>
            <template x-if='formValid.description.en && !formErrors.description.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid description (EN)</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label
              class='block text-xs font-medium text-gray-600'
            >JP</label>
            <textarea
              x-model='formData.description.ja'
              x-init="$el.value = formData.description.ja"
              @input='validateField("description", $event.target.value, "ja")'
              name='description[ja]'
              rows='4'
              :class="formErrors.description.ja ? 'border-red-500 focus:ring-red-500' : (formValid.description.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='チームリーダーの説明を入力してください (JA)...'
            ></textarea>
            <template x-if='formErrors.description.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.description.ja'></p>
              </div>
            </template>
            <template x-if='formValid.description.ja && !formErrors.description.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid description (JP)</p>
              </div>
            </template>
          </div>
        </div>
      </div>