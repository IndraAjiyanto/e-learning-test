      <!-- Text per Bahasa -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Text</label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.details.id'
              @input='validateField("details", "id", $event.target.value)'
              name='details[id]'
              rows='5'
              required
              :class="formErrors.details.id ? 'border-red-500 focus:ring-red-500' : (formValid.details.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Teks (ID)...'
            ></textarea>
            <template x-if='formErrors.details.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.details.id'></p>
              </div>
            </template>
            <template x-if='formValid.details.id && !formErrors.details.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.details.en'
              @input='validateField("details", "en", $event.target.value)'
              name='details[en]'
              rows='5'
              required
              :class="formErrors.details.en ? 'border-red-500 focus:ring-red-500' : (formValid.details.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Text (EN)...'
            ></textarea>
            <template x-if='formErrors.details.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.details.en'></p>
              </div>
            </template>
            <template x-if='formValid.details.en && !formErrors.details.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.details.ja'
              @input='validateField("details", "ja", $event.target.value)'
              name='details[ja]'
              rows='5'
              required
              :class="formErrors.details.ja ? 'border-red-500 focus:ring-red-500' : (formValid.details.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='テキスト (JA)...'
            ></textarea>
            <template x-if='formErrors.details.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.details.ja'></p>
              </div>
            </template>
            <template x-if='formValid.details.ja && !formErrors.details.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>
