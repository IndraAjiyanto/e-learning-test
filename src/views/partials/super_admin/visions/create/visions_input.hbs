      <!-- Visi per Bahasa -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Visi</label>
        <div class='grid grid-cols-1 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.visions.id'
              @input='validateField("visions", "id", $event.target.value)'
              id='visions_id'
              name='visions[id]'
              rows='5'
              required
              :class="formErrors.visions.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.visions.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Tulis visions dalam bahasa Indonesia...'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.visions.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.visions.id'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.visions.id && !formErrors.visions.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Visi valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.visions.en'
              @input='validateField("visions", "en", $event.target.value)'
              id='visions_en'
              name='visions[en]'
              rows='5'
              required
              :class="formErrors.visions.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.visions.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Write vision in English...'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.visions.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.visions.en'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.visions.en && !formErrors.visions.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Vision looks good</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.visions.ja'
              @input='validateField("visions", "ja", $event.target.value)'
              id='visions_ja'
              name='visions[ja]'
              rows='5'
              required
              :class="formErrors.visions.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.visions.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='ビジョンを日本語で書いてください...'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.visions.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.visions.ja'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.visions.ja && !formErrors.visions.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>ビジョンが有効です</p>
              </div>
            </template>
          </div>
        </div>
      </div>