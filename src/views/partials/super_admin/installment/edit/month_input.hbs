      <!-- Pilih Bulan -->
              {{#if availableMonths.length}}
      <div>
        <label
          for='month'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Installment Period
        </label>
        <select
          id='month'
          name='month'
          x-model='formData.month'
          @change='validateField("month", $event.target.value); month = $event.target.value; priceDisplays = Array(parseInt(month)).fill(""); priceValues = Array(parseInt(month)).fill(""); formValid.price = Array(parseInt(month)).fill(false); formErrors.price = Array(parseInt(month)).fill("")'
          required
          :class="formErrors.month ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.month ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
        >
        <option value='{{cicilan.month}}' selected>{{cicilan.month}} Months</option>
        {{#each availableMonths}}
          <option value='{{this}}'>{{this}} Months</option>
        {{/each}}

        </select>
        <!-- Error Message -->
        <template x-if='formErrors.month'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.month'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.month && !formErrors.month'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid period</p>
          </div>
        </template>
      </div>
      {{/if}}