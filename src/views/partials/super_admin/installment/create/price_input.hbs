      <!-- Input Harga Per Bulan -->
      <div class='space-y-2'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Monthly Payment Amounts
        </label>
        <!-- Down Payment (DP) -->
        <div class='space-y-2'>
          <label
            for='downPayment'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >
            Down Payment (DP)
          </label>
          <input
            type='text'
            id='downPayment'
            x-model='downPaymentDisplay'
            @input='formatNumber($event)'
            placeholder='Enter down payment amount'
            required
            :class="formErrors.downPayment ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.downPayment ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
          />
          <input type='hidden' name='downPayment' x-model='downPaymentValue' />
          <!-- Error Message -->
          <template x-if='formErrors.downPayment'>
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.downPayment'></p>
            </div>
          </template>

          <!-- Success Message -->
          <template x-if='formValid.downPayment && !formErrors.downPayment'>
            <div
              class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500'></i>
              <p class='text-xs text-green-700'>Valid down payment</p>
            </div>
          </template>
        </div>
        <div class='space-y-2'>
          <template x-for='(price, index) in parseInt(month)' :key='index'>
            <div class='flex items-center gap-3'>
              <span
                class='text-sm text-gray-600 w-20'
                x-text="'Month ' + (index + 1)"
              ></span>
              <input
                type='text'
                x-model='priceDisplays[index]'
                @input='formatNumber($event, index)'
                placeholder='Enter amount'
                required
                :class="formErrors.price[index] ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.price[index] ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='flex-1 border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
              />
              <input
                type='hidden'
                name='price[]'
                x-model='priceValues[index]'
              />
            </div>
            <!-- Error Message -->
            <template x-if='formErrors.price[index]'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg ml-20'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.price[index]'
                ></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.price[index] && !formErrors.price[index]'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg ml-20'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid payment amount</p>
              </div>
            </template>
          </template>
        </div>
      </div>