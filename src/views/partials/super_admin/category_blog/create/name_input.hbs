<!-- Nama -->
<div>
  <label for='nama' class='block text-sm font-medium text-gray-700 mb-2'>
    Category Name
    <span class='text-red-500'>*</span>
  </label>
  <input
    type='text'
    id='nama'
    name='nama'
    required
    placeholder='Enter category name (e.g., Technology, Education)'
    :class="formErrors.nama ? 'border-red-500 focus:ring-red-500' : (formValid.nama ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
    class='w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 text-gray-900 bg-white transition-colors'
    x-model='formData.nama'
    @input="validateField('nama', $event.target.value)"
  />
  <template x-if='formErrors.nama'>
    <div
      class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg mt-2'
    >
      <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
      <p class='text-xs text-red-700' x-text='formErrors.nama'></p>
    </div>
  </template>
  <template x-if='formValid.nama && !formErrors.nama'>
    <div
      class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg mt-2'
    >
      <i class='fas fa-check-circle text-green-500'></i>
      <p class='text-xs text-green-700'>Category Name looks good</p>
    </div>
  </template>
</div>