<div class="space-y-4">
  <label class='block text-sm font-medium text-gray-700'>Topic Name</label>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

    <!-- ID -->
    <div>
      <label for='nama_id' class='block text-xs font-medium text-gray-600 uppercase tracking-wide mb-1'>ID</label>
      <input
        type='text'
        id='nama_id'
        name='name[id]'
        required
        placeholder='Nama topik dalam bahasa Indonesia'
        class='w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 text-gray-900 bg-white'
        :class="formErrors.name.id ? 'border-red-500 focus:ring-red-500' : (formValid.name?.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
        x-model='formData.name.id'
        @input="validateField('name', 'id', $event.target.value)"
      />
      <template x-if='formErrors.name.id'>
        <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg mt-2'>
          <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
          <p class='text-xs text-red-700' x-text='formErrors.name.id'></p>
        </div>
      </template>
      <template x-if='formValid.name.id && !formErrors.name.id'>
        <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg mt-2'>
          <i class='fas fa-check-circle text-green-500'></i>
          <p class='text-xs text-green-700'>Looks good</p>
        </div>
      </template>
    </div>

    <!-- EN -->
    <div>
      <label for='nama_en' class='block text-xs font-medium text-gray-600 uppercase tracking-wide mb-1'>EN</label>
      <input
        type='text'
        id='nama_en'
        name='name[en]'
        required
        placeholder='Topic name in English'
        class='w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 text-gray-900 bg-white'
        :class="formErrors.name?.en ? 'border-red-500 focus:ring-red-500' : (formValid.name?.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
        x-model='formData.name.en'
        @input="validateField('name', 'en', $event.target.value)"
      />
      <template x-if='formErrors.name?.en'>
        <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg mt-2'>
          <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
          <p class='text-xs text-red-700' x-text='formErrors.name.en'></p>
        </div>
      </template>
      <template x-if='formValid.name?.en && !formErrors.name?.en'>
        <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg mt-2'>
          <i class='fas fa-check-circle text-green-500'></i>
          <p class='text-xs text-green-700'>Looks good</p>
        </div>
      </template>
    </div>

    <!-- ja -->
    <div>
      <label for='nama_ja' class='block text-xs font-medium text-gray-600 uppercase tracking-wide mb-1'>ja</label>
      <input
        type='text'
        id='nama_ja'
        name='name[ja]'
        required
        placeholder='トピック名（日本語）'
        class='w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 text-gray-900 bg-white'
        :class="formErrors.name?.ja ? 'border-red-500 focus:ring-red-500' : (formValid.name?.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
        x-model='formData.name.ja'
        @input="validateField('name', 'ja', $event.target.value)"
      />
      <template x-if='formErrors.name?.ja'>
        <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg mt-2'>
          <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
          <p class='text-xs text-red-700' x-text='formErrors.name.ja'></p>
        </div>
      </template>
      <template x-if='formValid.name?.ja && !formErrors.name?.ja'>
        <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg mt-2'>
          <i class='fas fa-check-circle text-green-500'></i>
          <p class='text-xs text-green-700'>Looks good</p>
        </div>
      </template>
    </div>

  </div>
</div>