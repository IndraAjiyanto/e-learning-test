          <!-- Instagram -->
          <div class='space-y-2'>
            <label for='instagram' class='block text-sm font-semibold text-gray-700 mb-1'>
              Instagram URL
              <span class='text-xs text-gray-500 font-normal'>(optional)</span>
            </label>
            <input
              type='url'
              id='instagram'
              name='instagram'
              placeholder='https://instagram.com/username'
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              @input='validateField("instagram", $event.target.value)'
              x-init="$el.value = formData.instagram"
            />
            <template x-if='formErrors.instagram'>
              <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'>
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.instagram'></p>
              </div>
            </template>
          </div>