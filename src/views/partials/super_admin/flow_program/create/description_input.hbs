        <!-- Isi per Bahasa -->
        <div class='space-y-4'>
          <label
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Description</label>
          <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
            <!-- ID -->
            <div class='space-y-2'>
              <label class='block text-xs font-medium text-gray-600'>ID</label>
              <textarea
                name='isi[id]'
                rows='4'
                required
                placeholder='Deskripsi (ID)...'
                :class="formErrors.isi.id ? 'border-red-500 focus:ring-red-500' : formValid.isi.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                x-model='formData.isi.id'
                @input='validateField("isi", "id", $event.target.value)'
              ></textarea>

              <!-- Error Message -->
              <template x-if='formErrors.isi.id'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.isi.id'
                  ></p>
                </div>
              </template>

              <!-- Success Message -->
              <template x-if='formValid.isi.id && !formErrors.isi.id'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid description</p>
                </div>
              </template>
            </div>

            <!-- EN -->
            <div class='space-y-2'>
              <label class='block text-xs font-medium text-gray-600'>EN</label>
              <textarea
                name='isi[en]'
                rows='4'
                required
                placeholder='Description (EN)...'
                :class="formErrors.isi.en ? 'border-red-500 focus:ring-red-500' : formValid.isi.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                x-model='formData.isi.en'
                @input='validateField("isi", "en", $event.target.value)'
              ></textarea>

              <!-- Error Message -->
              <template x-if='formErrors.isi.en'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.isi.en'
                  ></p>
                </div>
              </template>

              <!-- Success Message -->
              <template x-if='formValid.isi.en && !formErrors.isi.en'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid description</p>
                </div>
              </template>
            </div>

            <!-- JA -->
            <div class='space-y-2'>
              <label class='block text-xs font-medium text-gray-600'>JA</label>
              <textarea
                name='isi[ja]'
                rows='4'
                required
                placeholder='説明 (JA)...'
                :class="formErrors.isi.ja ? 'border-red-500 focus:ring-red-500' : formValid.isi.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
                class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                x-model='formData.isi.ja'
                @input='validateField("isi", "ja", $event.target.value)'
              ></textarea>

              <!-- Error Message -->
              <template x-if='formErrors.isi.ja'>
                <div
                  class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                >
                  <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                  <p
                    class='text-xs text-red-700'
                    x-text='formErrors.isi.ja'
                  ></p>
                </div>
              </template>

              <!-- Success Message -->
              <template x-if='formValid.isi.ja && !formErrors.isi.ja'>
                <div
                  class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                >
                  <i class='fas fa-check-circle text-green-500'></i>
                  <p class='text-xs text-green-700'>Valid description</p>
                </div>
              </template>
            </div>
          </div>
        </div>