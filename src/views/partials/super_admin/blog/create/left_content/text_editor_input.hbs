<!-- Editor ID -->
<label class='mb-2 block font-medium text-gray-700'>Content ID</label>
<div
  id='editor-id'
  class='text-left text-black max-w-none min-h-[300px] border border-gray-300 rounded-md bg-white p-2'
></div>
<input type='hidden' name='details[id]' id='details-id' />

<!-- Editor EN -->
<label class='mb-2 block font-medium text-gray-700 mt-4'>Content EN</label>
<div
  id='editor-en'
  class='text-left text-black max-w-none min-h-[300px] border border-gray-300 rounded-md bg-white p-2'
></div>
<input type='hidden' name='details[en]' id='details-en' />

<!-- Editor JP -->
<label class='mb-2 block font-medium text-gray-700 mt-4'>Content JP</label>
<div
  id='editor-ja'
  class='text-left text-black max-w-none min-h-[300px] border border-gray-300 rounded-md bg-white p-2'
></div>
<input type='hidden' name='details[ja]' id='details-ja' />

<script>
document.addEventListener('DOMContentLoaded', () => {
  const initQuill = (holderId) => {
    if (!window.QuillEditor) {
      setTimeout(() => initQuill(holderId), 100);
      return null;
    }
    return window.QuillEditor.create(holderId, {
      placeholder: 'Enter your content here...',
      uploadUrl: '/blog/upload-image'
    });
  };

  const editors = {
    id: initQuill('editor-id'),
    en: initQuill('editor-en'),
    ja: initQuill('editor-ja')
  };

  const form = document.querySelector('form');
  if (form) {
    form.addEventListener('submit', (e) => {
      const getHtml = (quill) => {
        if (!quill) return '';
        const html = quill.getSemanticHTML ? quill.getSemanticHTML() : quill.root.innerHTML;
        return html === '<p><br></p>' ? '' : html;
      };

      const idVal = getHtml(editors.id);
      const enVal = getHtml(editors.en);
      const jaVal = getHtml(editors.ja);

      const elId = document.getElementById('details-id');
      const elEn = document.getElementById('details-en');
      const elJa = document.getElementById('details-ja');

      if (elId) elId.value = idVal;
      if (elEn) elEn.value = enVal;
      if (elJa) elJa.value = jaVal;
    });
  }
});
</script>