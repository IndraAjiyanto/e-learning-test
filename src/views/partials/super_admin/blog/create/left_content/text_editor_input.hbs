<!-- Editor ID -->
<label class='mb-2 block font-medium text-gray-700'>Content ID</label>
<div
  id='editor-id'
  class='text-left text-black max-w-none min-h-[500px] border border-gray-300 rounded-md bg-white p-4'
></div>
<input type='hidden' name='isi[id]' id='isi-id' />

<!-- Editor EN -->
<label class='mb-2 block font-medium text-gray-700'>Content EN</label>
<div
  id='editor-en'
  class='text-left text-black max-w-none min-h-[500px] border border-gray-300 rounded-md bg-white p-4'
></div>
<input type='hidden' name='isi[en]' id='isi-en' />

<!-- Editor JP -->
<label class='mb-2 block font-medium text-gray-700'>Content JP</label>
<div
  id='editor-jp'
  class='text-left text-black max-w-none min-h-[500px] border border-gray-300 rounded-md bg-white p-4'
></div>
<input type='hidden' name='isi[jp]' id='isi-jp' />

<script>
document.addEventListener('DOMContentLoaded', async () => {
  const editorConfig = (holderId) => ({
    holder: holderId,
    placeholder: 'Enter your content here...',
    tools: {
      header: {
        class: EditorTools.Header,
        inlineToolbar: ['link']
      },
      paragraph: {
        class: EditorTools.Paragraph,
        inlineToolbar: true,
      },
      list: {
        class: EditorTools.List,
        inlineToolbar: true
      },
      marker: {
        class: EditorTools.Marker,
        shortcut: 'CMD+SHIFT+M'
      },
      image: {
        class: EditorTools.ImageTool,
        config: {
          endpoints: {
            byFile: '/blog/upload-image',
            byUrl: '/blog/fetch-image'
          }
        }
      },
      linkTool: {
        class: EditorTools.LinkTool,
        config: { endpoint: '/blog/fetch-link' }
      }
    }
  });

  // Inisialisasi 3 editor
  const editors = {
    id: new EditorJS(editorConfig('editor-id')),
    en: new EditorJS(editorConfig('editor-en')),
    jp: new EditorJS(editorConfig('editor-jp')),
  };

  const form = document.querySelector('form');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Save semua editor sekaligus
    const [outputId, outputEn, outputJp] = await Promise.all([
      editors.id.save(),
      editors.en.save(),
      editors.jp.save(),
    ]);

    document.getElementById('isi-id').value = JSON.stringify(outputId);
    document.getElementById('isi-en').value = JSON.stringify(outputEn);
    document.getElementById('isi-jp').value = JSON.stringify(outputJp);

    form.submit();
  });
});
</script>