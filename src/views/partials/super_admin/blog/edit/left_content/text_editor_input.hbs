<!-- Editor ID -->
<label class="mb-2 block font-medium text-gray-700 mt-6">Content ID</label>
<div id="editor-id" class="text-left text-black max-w-none min-h-[500px] border border-gray-300 rounded-md bg-white p-4"></div>
<input type="hidden" name="isi[id]" id="isi-id">

<!-- Editor EN -->
<label class="mb-2 block font-medium text-gray-700 mt-6">Content EN</label>
<div id="editor-en" class="text-left text-black max-w-none min-h-[500px] border border-gray-300 rounded-md bg-white p-4"></div>
<input type="hidden" name="isi[en]" id="isi-en">

<!-- Editor JP -->
<label class="mb-2 block font-medium text-gray-700 mt-6">Content JP</label>
<div id="editor-jp" class="text-left text-black max-w-none min-h-[500px] border border-gray-300 rounded-md bg-white p-4"></div>
<input type="hidden" name="isi[jp]" id="isi-jp">

<script>
function tagInput(initialTags = '[]') {
  return {
    prefix: "#",
    tags: JSON.parse(initialTags).length > 0 ? JSON.parse(initialTags) : ["#"],
    format(index) {
      let val = this.tags[index];
      if (!val.startsWith(this.prefix)) {
        this.tags[index] = this.prefix + val.replace(this.prefix, "");
      }
    }
  }
}

document.addEventListener('DOMContentLoaded', async () => {
  // Load existing content per bahasa
  const existingData = {
    id: (() => { try { return JSON.parse(`{{{blog.isi_editorjs.id}}}`); } catch { return {}; } })(),
    en: (() => { try { return JSON.parse(`{{{blog.isi_editorjs.en}}}`); } catch { return {}; } })(),
    jp: (() => { try { return JSON.parse(`{{{blog.isi_editorjs.jp}}}`); } catch { return {}; } })(),
  };

  const editorConfig = (holderId, lang) => ({
    holder: holderId,
    placeholder: 'Enter your content here...',
    data: existingData[lang] || {},
    tools: {
      header: {
        class: EditorTools.Header,
        inlineToolbar: ['link']
      },
      paragraph: {
        class: EditorTools.Paragraph,
        inlineToolbar: true,
      },
      list: {
        class: EditorTools.List,
        inlineToolbar: true
      },
      marker: {
        class: EditorTools.Marker,
        shortcut: 'CMD+SHIFT+M'
      },
      image: {
        class: EditorTools.ImageTool,
        tunes: {
          "stretched": false,
          "withBorder": false,
          "withBackground": false
        },
        config: {
          endpoints: {
            byFile: '/blog/upload-image',
            byUrl: '/blog/fetch-image'
          }
        }
      },
      linkTool: {
        class: EditorTools.LinkTool,
        config: { endpoint: '/blog/fetch-link' }
      }
    }
  });

  const editors = {
    id: new EditorJS(editorConfig('editor-id', 'id')),
    en: new EditorJS(editorConfig('editor-en', 'en')),
    jp: new EditorJS(editorConfig('editor-jp', 'jp')),
  };

  const form = document.querySelector('form');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const [outputId, outputEn, outputJp] = await Promise.all([
      editors.id.save(),
      editors.en.save(),
      editors.jp.save(),
    ]);

    document.getElementById('isi-id').value = JSON.stringify(outputId);
    document.getElementById('isi-en').value = JSON.stringify(outputEn);
    document.getElementById('isi-jp').value = JSON.stringify(outputJp);

    form.submit();
  });
});
</script>