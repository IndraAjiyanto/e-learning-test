<!-- Editor ID -->
<label class="mb-2 block font-medium text-gray-700 mt-6">Content ID</label>
<div id="editor-id" class="text-left text-black max-w-none min-h-[300px] border border-gray-300 rounded-md bg-white p-2"></div>
<input type="hidden" name="details[id]" id="details-id">

<!-- Editor EN -->
<label class="mb-2 block font-medium text-gray-700 mt-6">Content EN</label>
<div id="editor-en" class="text-left text-black max-w-none min-h-[300px] border border-gray-300 rounded-md bg-white p-2"></div>
<input type="hidden" name="details[en]" id="details-en">

<!-- Editor JA -->
<label class="mb-2 block font-medium text-gray-700 mt-6">Content JP</label>
<div id="editor-ja" class="text-left text-black max-w-none min-h-[300px] border border-gray-300 rounded-md bg-white p-2"></div>
<input type="hidden" name="details[ja]" id="details-ja">

<script>
function tagInput(initialTags = '[]') {
  return {
    prefix: "#",
    tags: JSON.parse(initialTags).length > 0 ? JSON.parse(initialTags) : ["#"],
    format(index) {
      let val = this.tags[index];
      if (!val.startsWith(this.prefix)) {
        this.tags[index] = this.prefix + val.replace(this.prefix, "");
      }
    }
  }
}

document.addEventListener('DOMContentLoaded', () => {
  const existingData = {
    id: `{{{default blog.editor_data.id (default blog.isi.id '')}}}`,
    en: `{{{default blog.editor_data.en (default blog.isi.en '')}}}`,
    ja: `{{{default blog.editor_data.ja (default blog.isi.ja '')}}}`
  };

  const initQuill = (holderId, lang) => {
    if (!window.QuillEditor) {
      setTimeout(() => initQuill(holderId, lang), 100);
      return null;
    }
    return window.QuillEditor.create(holderId, {
      placeholder: 'Enter your content here...',
      initialContent: existingData[lang],
      uploadUrl: '/blog/upload-image'
    });
  };

  const editors = {
    id: initQuill('editor-id', 'id'),
    en: initQuill('editor-en', 'en'),
    ja: initQuill('editor-ja', 'ja')
  };

  const form = document.querySelector('form');
  if (form) {
    form.addEventListener('submit', (e) => {
      const getHtml = (quill) => {
        if (!quill) return '';
        const html = quill.getSemanticHTML ? quill.getSemanticHTML() : quill.root.innerHTML;
        return html === '<p><br></p>' ? '' : html;
      };

      const idVal = getHtml(editors.id);
      const enVal = getHtml(editors.en);
      const jaVal = getHtml(editors.ja);

      const elId = document.getElementById('details-id');
      const elEn = document.getElementById('details-en');
      const elJa = document.getElementById('details-ja');

      if (elId) elId.value = idVal;
      if (elEn) elEn.value = enVal;
      if (elJa) elJa.value = jaVal;
    });
  }
});
</script>