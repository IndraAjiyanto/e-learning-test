      <!-- Paragraf Content per Bahasa -->
      <div class='space-y-4'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Paragraf
        </label>
        <div class='grid grid-cols-1 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.paragraphs.id'
              @input='validateField("paragraphs", $event.target.value, "id")'
              name='paragraphs[id]'
              rows='5'
              required
              maxlength='2000'
              :class="formErrors.paragraphs.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.paragraphs.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Konten paragraphs (ID)'
            ></textarea>
            <template x-if='formErrors.paragraphs.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.paragraphs.id'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.paragraphs.id && formValid.paragraphs.id && !formErrors.paragraphs.id'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.paragraphs.en'
              @input='validateField("paragraphs", $event.target.value, "en")'
              name='paragraphs[en]'
              rows='5'
              required
              maxlength='2000'
              :class="formErrors.paragraphs.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.paragraphs.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Paragraph content (EN)'
            ></textarea>
            <template x-if='formErrors.paragraphs.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.paragraphs.en'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.paragraphs.en && formValid.paragraphs.en && !formErrors.paragraphs.en'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.paragraphs.ja'
              @input='validateField("paragraphs", $event.target.value, "ja")'
              name='paragraphs[ja]'
              rows='5'
              required
              maxlength='2000'
              :class="formErrors.paragraphs.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : (formValid.paragraphs.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900')"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='段落コンテンツ (JA)'
            ></textarea>
            <template x-if='formErrors.paragraphs.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.paragraphs.ja'
                ></p>
              </div>
            </template>
            <template
              x-if='formTouched.paragraphs.ja && formValid.paragraphs.ja && !formErrors.paragraphs.ja'
            >
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>