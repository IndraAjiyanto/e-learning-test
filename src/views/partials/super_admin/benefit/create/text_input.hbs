      <!-- Text -->
      <div class='space-y-2'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Description
        </label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- Indonesian -->
          <div class='space-y-1'>
            <label
              for='text_id'
              class='block text-xs font-medium text-gray-600 uppercase tracking-wide'
            >ID</label>
            <textarea
              x-model='formData.text.id'
              @input='validateField("text", "id", $event.target.value)'
              id='text_id'
              name='text[id]'
              rows='4'
              placeholder='Deskripsi benefit dalam bahasa Indonesia'
              :class="formErrors.text.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.text.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
            ></textarea>
            <template x-if='formErrors.text.id'>
              <div
                class='flex items-start gap-1 p-1 bg-red-50 border border-red-300 rounded'
              >
                <i
                  class='fas fa-exclamation-circle text-red-500 text-xs mt-0.5'
                ></i>
                <p class='text-xs text-red-700' x-text='formErrors.text.id'></p>
              </div>
            </template>
            <template x-if='formValid.text.id && !formErrors.text.id'>
              <div
                class='flex items-center gap-1 p-1 bg-green-50 border border-green-300 rounded'
              >
                <i class='fas fa-check-circle text-green-500 text-xs'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- English -->
          <div class='space-y-1'>
            <label
              for='text_en'
              class='block text-xs font-medium text-gray-600 uppercase tracking-wide'
            >EN</label>
            <textarea
              x-model='formData.text.en'
              @input='validateField("text", "en", $event.target.value)'
              id='text_en'
              name='text[en]'
              rows='4'
              placeholder='Benefit description in English'
              :class="formErrors.text.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.text.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
            ></textarea>
            <template x-if='formErrors.text.en'>
              <div
                class='flex items-start gap-1 p-1 bg-red-50 border border-red-300 rounded'
              >
                <i
                  class='fas fa-exclamation-circle text-red-500 text-xs mt-0.5'
                ></i>
                <p class='text-xs text-red-700' x-text='formErrors.text.en'></p>
              </div>
            </template>
            <template x-if='formValid.text.en && !formErrors.text.en'>
              <div
                class='flex items-center gap-1 p-1 bg-green-50 border border-green-300 rounded'
              >
                <i class='fas fa-check-circle text-green-500 text-xs'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- Japanese -->
          <div class='space-y-1'>
            <label
              for='text_ja'
              class='block text-xs font-medium text-gray-600 uppercase tracking-wide'
            >JP</label>
            <textarea
              x-model='formData.text.ja'
              @input='validateField("text", "ja", $event.target.value)'
              id='text_ja'
              name='text[ja]'
              rows='4'
              placeholder='ベネフィットの説明（日本語）'
              :class="formErrors.text.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.text.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
            ></textarea>
            <template x-if='formErrors.text.ja'>
              <div
                class='flex items-start gap-1 p-1 bg-red-50 border border-red-300 rounded'
              >
                <i
                  class='fas fa-exclamation-circle text-red-500 text-xs mt-0.5'
                ></i>
                <p class='text-xs text-red-700' x-text='formErrors.text.ja'></p>
              </div>
            </template>
            <template x-if='formValid.text.ja && !formErrors.text.ja'>
              <div
                class='flex items-center gap-1 p-1 bg-green-50 border border-green-300 rounded'
              >
                <i class='fas fa-check-circle text-green-500 text-xs'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>