      <!-- Number -->
      <div class='space-y-2'>
        <label
          for='no'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Number
          
        </label>
        <select
          id='no'
          name='no'
          required
          :class="formErrors.no ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.no ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          x-model='formData.no'
          @change='validateField("no", null, $event.target.value)'
          x-init='$el.value = formData.no'
        >
          <option value=''>-- Select Number --</option>
          <option value='1' {{#if (eq benefit.no 1)}}selected{{/if}}>1</option>
          <option value='2' {{#if (eq benefit.no 2)}}selected{{/if}}>2</option>
          <option value='3' {{#if (eq benefit.no 3)}}selected{{/if}}>3</option>
        </select>

        <!-- Error Message -->
        <template x-if='formErrors.no'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.no'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.no && !formErrors.no'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid number selection</p>
          </div>
        </template>
      </div>