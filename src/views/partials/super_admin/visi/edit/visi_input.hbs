      <!-- Visi per Bahasa -->
      <div class='space-y-4'>
        <label
          class='block text-sm font-semibold text-gray-700 mb-1'
        >Visi</label>
        <div class='grid grid-cols-1 gap-4'>
          <!-- ID -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>ID</label>
            <textarea
              x-model='formData.visi.id'
              @input='validateField("visi", "id", $event.target.value)'
              id='visi_id'
              name='visi[id]'
              rows='5'
              required
              :class="formErrors.visi.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.visi.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Tulis visi dalam bahasa Indonesia...'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.visi.id'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.visi.id'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.visi.id && !formErrors.visi.id'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Visi valid</p>
              </div>
            </template>
          </div>

          <!-- EN -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>EN</label>
            <textarea
              x-model='formData.visi.en'
              @input='validateField("visi", "en", $event.target.value)'
              id='visi_en'
              name='visi[en]'
              rows='5'
              required
              :class="formErrors.visi.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.visi.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='Write vision in English...'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.visi.en'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.visi.en'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.visi.en && !formErrors.visi.en'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>Vision looks good</p>
              </div>
            </template>
          </div>

          <!-- JP -->
          <div class='space-y-2'>
            <label class='block text-xs font-medium text-gray-600'>JP</label>
            <textarea
              x-model='formData.visi.ja'
              @input='validateField("visi", "ja", $event.target.value)'
              id='visi_ja'
              name='visi[ja]'
              rows='5'
              required
              :class="formErrors.visi.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.visi.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              placeholder='ビジョンを日本語で書いてください...'
            ></textarea>

            <!-- Error Message -->
            <template x-if='formErrors.visi.ja'>
              <div
                class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
              >
                <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
                <p class='text-xs text-red-700' x-text='formErrors.visi.ja'></p>
              </div>
            </template>

            <!-- Success Message -->
            <template x-if='formValid.visi.ja && !formErrors.visi.ja'>
              <div
                class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
              >
                <i class='fas fa-check-circle text-green-500'></i>
                <p class='text-xs text-green-700'>ビジョンが有効です</p>
              </div>
            </template>
          </div>
        </div>
      </div>