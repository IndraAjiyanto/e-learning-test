      <div class='space-y-2'>
        <label class='block text-sm font-semibold text-gray-700 mb-1'>
          Description
        </label>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
          <!-- Indonesian -->
          <div class='space-y-1'>
            <label
              for='deskripsi_id'
              class='block text-xs font-medium text-gray-600 uppercase tracking-wide'
            >ID</label>
            <textarea
              x-model='formData.deskripsi.id'
              @input='validateField("deskripsi", "id", $event.target.value)'
              id='deskripsi_id'
              name='deskripsi[id]'
              rows='4'
              placeholder='Deskripsi commitment dalam bahasa Indonesia'
              :class="formErrors.deskripsi.id ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.deskripsi.id ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              x-init='$el.value = formData.deskripsi.id'
            ></textarea>
            <template x-if='formErrors.deskripsi.id'>
              <div
                class='flex items-start gap-1 p-1 bg-red-50 border border-red-300 rounded'
              >
                <i
                  class='fas fa-exclamation-circle text-red-500 text-xs mt-0.5'
                ></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.deskripsi.id'
                ></p>
              </div>
            </template>
            <template x-if='formValid.deskripsi.id && !formErrors.deskripsi.id'>
              <div
                class='flex items-center gap-1 p-1 bg-green-50 border border-green-300 rounded'
              >
                <i class='fas fa-check-circle text-green-500 text-xs'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- English -->
          <div class='space-y-1'>
            <label
              for='deskripsi_en'
              class='block text-xs font-medium text-gray-600 uppercase tracking-wide'
            >EN</label>
            <textarea
              x-model='formData.deskripsi.en'
              @input='validateField("deskripsi", "en", $event.target.value)'
              id='deskripsi_en'
              name='deskripsi[en]'
              rows='4'
              placeholder='Commitment description in English'
              :class="formErrors.deskripsi.en ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.deskripsi.en ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              x-init='$el.value = formData.deskripsi.en'
            ></textarea>
            <template x-if='formErrors.deskripsi.en'>
              <div
                class='flex items-start gap-1 p-1 bg-red-50 border border-red-300 rounded'
              >
                <i
                  class='fas fa-exclamation-circle text-red-500 text-xs mt-0.5'
                ></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.deskripsi.en'
                ></p>
              </div>
            </template>
            <template x-if='formValid.deskripsi.en && !formErrors.deskripsi.en'>
              <div
                class='flex items-center gap-1 p-1 bg-green-50 border border-green-300 rounded'
              >
                <i class='fas fa-check-circle text-green-500 text-xs'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>

          <!-- Japanese -->
          <div class='space-y-1'>
            <label
              for='deskripsi_ja'
              class='block text-xs font-medium text-gray-600 uppercase tracking-wide'
            >JP</label>
            <textarea
              x-model='formData.deskripsi.ja'
              @input='validateField("deskripsi", "ja", $event.target.value)'
              id='deskripsi_ja'
              name='deskripsi[ja]'
              rows='4'
              placeholder='コミットメントの説明（日本語）'
              :class="formErrors.deskripsi.ja ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.deskripsi.ja ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors resize-none'
              x-init='$el.value = formData.deskripsi.ja'
            ></textarea>
            <template x-if='formErrors.deskripsi.ja'>
              <div
                class='flex items-start gap-1 p-1 bg-red-50 border border-red-300 rounded'
              >
                <i
                  class='fas fa-exclamation-circle text-red-500 text-xs mt-0.5'
                ></i>
                <p
                  class='text-xs text-red-700'
                  x-text='formErrors.deskripsi.ja'
                ></p>
              </div>
            </template>
            <template x-if='formValid.deskripsi.ja && !formErrors.deskripsi.ja'>
              <div
                class='flex items-center gap-1 p-1 bg-green-50 border border-green-300 rounded'
              >
                <i class='fas fa-check-circle text-green-500 text-xs'></i>
                <p class='text-xs text-green-700'>Valid</p>
              </div>
            </template>
          </div>
        </div>
      </div>