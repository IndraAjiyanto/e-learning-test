          <!-- Posisi per Bahasa -->
          <div class='space-y-4'>
            <label
              class='block text-sm font-semibold text-gray-700 mb-1'
            >Position</label>
            <div class='grid grid-cols-1 gap-4'>
              <!-- ID -->
              <div class='space-y-2'>
                <label
                  class='block text-xs font-medium text-gray-600'
                >ID</label>
                <input
                  x-model='formData.position.id'
                  @input='validateField("position", $event.target.value, "id")'
                  type='text'
                  name='position[id]'
                  required
                  maxlength='255'
                  :class="formErrors.position.id ? 'border-red-500 focus:ring-red-500' : (formValid.position.id ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
                  class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                  placeholder='Posisi (ID)'
                />
                <template x-if='formErrors.position.id'>
                  <div
                    class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                  >
                    <i
                      class='fas fa-exclamation-circle text-red-500 mt-0.5'
                    ></i>
                    <p
                      class='text-xs text-red-700'
                      x-text='formErrors.position.id'
                    ></p>
                  </div>
                </template>
                <template
                  x-if='formTouched.position.id && formValid.position.id && !formErrors.position.id'
                >
                  <div
                    class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                  >
                    <i class='fas fa-check-circle text-green-500'></i>
                    <p class='text-xs text-green-700'>Valid</p>
                  </div>
                </template>
              </div>

              <!-- EN -->
              <div class='space-y-2'>
                <label
                  class='block text-xs font-medium text-gray-600'
                >EN</label>
                <input
                  x-model='formData.position.en'
                  @input='validateField("position", $event.target.value, "en")'
                  type='text'
                  name='position[en]'
                  required
                  maxlength='255'
                  :class="formErrors.position.en ? 'border-red-500 focus:ring-red-500' : (formValid.position.en ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
                  class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                  placeholder='Position (EN)'
                />
                <template x-if='formErrors.position.en'>
                  <div
                    class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                  >
                    <i
                      class='fas fa-exclamation-circle text-red-500 mt-0.5'
                    ></i>
                    <p
                      class='text-xs text-red-700'
                      x-text='formErrors.position.en'
                    ></p>
                  </div>
                </template>
                <template
                  x-if='formTouched.position.en && formValid.position.en && !formErrors.position.en'
                >
                  <div
                    class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                  >
                    <i class='fas fa-check-circle text-green-500'></i>
                    <p class='text-xs text-green-700'>Valid</p>
                  </div>
                </template>
              </div>

              <!-- JP -->
              <div class='space-y-2'>
                <label
                  class='block text-xs font-medium text-gray-600'
                >JP</label>
                <input
                  x-model='formData.position.ja'
                  @input='validateField("position", $event.target.value, "ja")'
                  type='text'
                  name='position[ja]'
                  required
                  maxlength='255'
                  :class="formErrors.position.ja ? 'border-red-500 focus:ring-red-500' : (formValid.position.ja ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
                  class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
                  placeholder='役職 (JA)'
                />
                <template x-if='formErrors.position.ja'>
                  <div
                    class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
                  >
                    <i
                      class='fas fa-exclamation-circle text-red-500 mt-0.5'
                    ></i>
                    <p
                      class='text-xs text-red-700'
                      x-text='formErrors.position.ja'
                    ></p>
                  </div>
                </template>
                <template
                  x-if='formTouched.position.ja && formValid.position.ja && !formErrors.position.ja'
                >
                  <div
                    class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
                  >
                    <i class='fas fa-check-circle text-green-500'></i>
                    <p class='text-xs text-green-700'>Valid</p>
                  </div>
                </template>
              </div>
            </div>
          </div>