     <!-- Class Type Name -->
      <div class='space-y-2'>
        <label
          for='nama_jenis_kelas'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Class Type Name
        </label>
        <input
          x-model='formData.nama_jenis_kelas'
          @input='validateField("nama_jenis_kelas", $event.target.value)'
          type='text'
          id='nama_jenis_kelas'
          name='nama_jenis_kelas'
          required
          maxlength='255'
          :class="formErrors.nama_jenis_kelas ? 'border-red-500 focus:ring-red-500' : (formValid.nama_jenis_kelas ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900')"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          placeholder='Enter class type name'
        />

        <!-- Error Message -->
        <template x-if='formErrors.nama_jenis_kelas'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p
              class='text-xs text-red-700'
              x-text='formErrors.nama_jenis_kelas'
            ></p>
          </div>
        </template>

        <!-- Success Message -->
        <template
          x-if='formTouched.nama_jenis_kelas && formValid.nama_jenis_kelas && !formErrors.nama_jenis_kelas'
        >
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid</p>
          </div>
        </template>
      </div>