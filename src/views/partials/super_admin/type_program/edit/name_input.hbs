      <!-- Class Type Name -->
      <div class='space-y-2'>
        <label
          for='nameClassesType'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          Class Type Name
        </label>
        <input
          x-model='formData.nameClassesType'
          @input='validateField("nameClassesType", $event.target.value)'
          type='text'
          id='nameClassesType'
          name='nameClassesType'
          required
          maxlength='255'
          :class="formErrors.nameClassesType ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.nameClassesType ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
          placeholder='Enter class type name'
        />

        <!-- Error Message -->
        <template x-if='formErrors.nameClassesType'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p
              class='text-xs text-red-700'
              x-text='formErrors.nameClassesType'
            ></p>
          </div>
        </template>

        <!-- Success Message -->
        <template
          x-if='formTouched.nameClassesType && formValid.nameClassesType && !formErrors.nameClassesType'
        >
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid</p>
          </div>
        </template>
      </div>