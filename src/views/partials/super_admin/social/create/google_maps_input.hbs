      <!-- Google Maps Link -->
      <div class='space-y-2'>
        <label
          for='linkAddress'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >
          <i class='fas fa-map text-blue-600 mr-2'></i>Google Maps Link
        </label>
        <input
          x-model='formData.linkAddress'
          @input='validateField("linkAddress", $event.target.value)'
          id='linkAddress'
          required
          name='linkAddress'
          placeholder='https://maps.app.goo.gl/... or https://www.google.com/maps/...'
          :class="formErrors.linkAddress ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : formValid.linkAddress ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
        />

        <!-- Error Message -->
        <template x-if='formErrors.linkAddress'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='formErrors.linkAddress'></p>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='formValid.linkAddress && !formErrors.linkAddress'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid link google maps</p>
          </div>
        </template>
      </div>