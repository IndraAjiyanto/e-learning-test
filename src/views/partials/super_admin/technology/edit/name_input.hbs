      <!-- Nama Teknologi -->
      <div class='space-y-2'>
        <label for='nama' class='block text-sm font-semibold text-gray-700 mb-1'>Technology Name</label>
        <input
          x-model='nama'
          @input='validateNama()'
          type='text'
          id='nama'
          name='nama'
          value='{{teknologi.nama}}'
          required
          :class="errors.nama ? 'border-red-500 focus:ring-red-500' : success.nama ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700'
        />
        
        <template x-if='errors.nama'>
          <div class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'>
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='errors.nama'></p>
          </div>
        </template>

        <template x-if='success.nama && !errors.nama'>
          <div class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'>
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid technology name</p>
          </div>
        </template>
      </div>