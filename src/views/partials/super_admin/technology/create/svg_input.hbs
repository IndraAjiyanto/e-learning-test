      <!-- SVG Code -->
      <div class='space-y-2'>
        <label
          for='svg'
          class='block text-sm font-semibold text-gray-700 mb-1'
        >SVG Code</label>
        <textarea
          x-model='svg'
          @input='validateSVG($event.target.value)'
          id='svg'
          name='svg'
          rows='8'
          placeholder='Paste your SVG code here...'
          :class="errors.svg ? 'border-red-500 focus:ring-red-500' : success.svg ? 'border-green-500 focus:ring-green-500' : 'border-gray-300 focus:ring-gray-900'"
          class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 font-mono text-sm'
          x-ref='svgInput'
        ></textarea>

        <!-- Error Message -->
        <template x-if='svgError'>
          <div
            class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
          >
            <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
            <p class='text-xs text-red-700' x-text='svgError'></p>
          </div>
        </template>

        <!-- SVG Preview -->
        <template x-if='svgPreview && !svgError'>
          <div class='mt-4'>
            <p class='text-sm font-semibold text-gray-700 mb-2'>Preview:</p>
            <div
              class='p-4 bg-gray-50 border border-gray-200 rounded-lg flex items-center justify-center'
            >
              <div
                class='w-24 h-24 flex items-center justify-center'
                x-html='svgPreview'
              ></div>
            </div>
          </div>
        </template>

        <!-- Success Message -->
        <template x-if='success.svg && !svgError'>
          <div
            class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
          >
            <i class='fas fa-check-circle text-green-500'></i>
            <p class='text-xs text-green-700'>Valid SVG code</p>
          </div>
        </template>
      </div>