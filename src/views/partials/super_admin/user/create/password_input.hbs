<!-- Password -->
<div class='space-y-2'>
  <label
    for='password'
    class='block text-sm font-semibold text-gray-700 mb-1'
  >Password</label>
  <div class='relative' x-data='{ showPassword: false }'>
    <input
      :type="showPassword ? 'text' : 'password'"
      id='password'
      name='password'
      required
      minlength='8'
      @blur='passwordTouched = true'
      :class="formErrors.password ? 'border-red-500 focus:ring-red-500' : formValid.password ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
      class='w-full border bg-white rounded-lg pl-4 pr-11 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
      @input='validateField("password", $event.target.value)'
    />
    <button
      type='button'
      @click='showPassword = !showPassword'
      :aria-label="showPassword ? 'Sembunyikan password' : 'Tampilkan password'"
      class='absolute inset-y-0 right-0 flex items-center px-3 text-gray-400 hover:text-gray-600 focus:outline-none'
    >
      <i class='far' :class="showPassword ? 'fa-eye' : 'fa-eye-slash'"></i>
    </button>
  </div>

  <!-- Password Requirements -->
  <div class='p-3 bg-gray-50 border border-gray-200 rounded-lg'>
    <p class='text-xs font-semibold text-gray-600 mb-2'>Password harus memenuhi:</p>
    <ul class='space-y-1 text-xs'>
      <li
        class='flex items-center gap-2'
        :class="passwordRules.minLength ? 'text-green-600' : (passwordTouched ? 'text-red-600' : 'text-gray-500')"
      >
        <i
          class='fa-fw w-3 text-center'
          :class="passwordRules.minLength ? 'fa-solid fa-circle-check' : 'fa-regular fa-circle'"
        ></i>
        <span>Minimal 8 karakter</span>
      </li>
      <li
        class='flex items-center gap-2'
        :class="passwordRules.uppercase ? 'text-green-600' : (passwordTouched ? 'text-red-600' : 'text-gray-500')"
      >
        <i
          class='fa-fw w-3 text-center'
          :class="passwordRules.uppercase ? 'fa-solid fa-circle-check' : 'fa-regular fa-circle'"
        ></i>
        <span>Mengandung huruf besar (A-Z)</span>
      </li>
      <li
        class='flex items-center gap-2'
        :class="passwordRules.lowercase ? 'text-green-600' : (passwordTouched ? 'text-red-600' : 'text-gray-500')"
      >
        <i
          class='fa-fw w-3 text-center'
          :class="passwordRules.lowercase ? 'fa-solid fa-circle-check' : 'fa-regular fa-circle'"
        ></i>
        <span>Mengandung huruf kecil (a-z)</span>
      </li>
      <li
        class='flex items-center gap-2'
        :class="passwordRules.number ? 'text-green-600' : (passwordTouched ? 'text-red-600' : 'text-gray-500')"
      >
        <i
          class='fa-fw w-3 text-center'
          :class="passwordRules.number ? 'fa-solid fa-circle-check' : 'fa-regular fa-circle'"
        ></i>
        <span>Mengandung angka (0-9)</span>
      </li>
      <li
        class='flex items-center gap-2'
        :class="passwordRules.special ? 'text-green-600' : (passwordTouched ? 'text-red-600' : 'text-gray-500')"
      >
        <i
          class='fa-fw w-3 text-center'
          :class="passwordRules.special ? 'fa-solid fa-circle-check' : 'fa-regular fa-circle'"
        ></i>
        <span>Mengandung karakter spesial (!@#$...)</span>
      </li>
    </ul>
  </div>

  <!-- Error Message -->
  <template x-if='formErrors.password'>
    <div
      class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
    >
      <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
      <p class='text-xs text-red-700' x-text='formErrors.password'></p>
    </div>
  </template>

  <!-- Success Message -->
  <template x-if='formValid.password && !formErrors.password'>
    <div
      class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
    >
      <i class='fas fa-check-circle text-green-500'></i>
      <p class='text-xs text-green-700'>Valid password</p>
    </div>
  </template>


</div>