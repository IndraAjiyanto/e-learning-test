        <!-- Password -->
        <div class='space-y-2' x-data='{ showPassword: false }'>
          <label
            for='password'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Password</label>
          <div class='relative'>
            <input
              :type="showPassword ? 'text' : 'password'"
              id='password'
              name='password'
              required
              :class="formErrors.password ? 'border-red-500 focus:ring-red-500' : formValid.password ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
              class='w-full border bg-white rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
              @input='validateField("password", $event.target.value)'
            />
            <button
              type='button'
              @click='showPassword = !showPassword'
              class='absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400'
              tabindex='-1'
            >
              <i class='fas' :class="showPassword ? 'fa-eye-slash' : 'fa-eye'"></i>
            </button>
          </div>

          <!-- Password Checklist -->
          <ul class='mt-1 space-y-0.5'>
            <li
              class='text-xs flex items-center gap-1.5'
              :class="formData.password.length >= 8 ? 'text-green-600' : 'text-gray-500'"
            >
              <i class='fas text-[10px]' :class="formData.password.length >= 8 ? 'fa-check-circle' : 'fa-circle'"></i>
              {{t 'test.passwordChecklist.length'}}
            </li>
            <li
              class='text-xs flex items-center gap-1.5'
              :class="/[A-Z]/.test(formData.password) ? 'text-green-600' : 'text-gray-500'"
            >
              <i class='fas text-[10px]' :class="/[A-Z]/.test(formData.password) ? 'fa-check-circle' : 'fa-circle'"></i>
              {{t 'test.passwordChecklist.uppercase'}}
            </li>
            <li
              class='text-xs flex items-center gap-1.5'
              :class="/[a-z]/.test(formData.password) ? 'text-green-600' : 'text-gray-500'"
            >
              <i class='fas text-[10px]' :class="/[a-z]/.test(formData.password) ? 'fa-check-circle' : 'fa-circle'"></i>
              {{t 'test.passwordChecklist.lowercase'}}
            </li>
            <li
              class='text-xs flex items-center gap-1.5'
              :class="/[0-9]/.test(formData.password) ? 'text-green-600' : 'text-gray-500'"
            >
              <i class='fas text-[10px]' :class="/[0-9]/.test(formData.password) ? 'fa-check-circle' : 'fa-circle'"></i>
              {{t 'test.passwordChecklist.number'}}
            </li>
            <li
              class='text-xs flex items-center gap-1.5'
              :class="/[^A-Za-z0-9]/.test(formData.password) ? 'text-green-600' : 'text-gray-500'"
            >
              <i class='fas text-[10px]' :class="/[^A-Za-z0-9]/.test(formData.password) ? 'fa-check-circle' : 'fa-circle'"></i>
              {{t 'test.passwordChecklist.special'}}
            </li>
          </ul>

          <!-- Error Message (required) -->
          <template x-if="formErrors.password === 'Password is required'">
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.password'></p>
            </div>
          </template>
        </div>