        <!-- Role -->
        <div class='space-y-2'>
          <label
            for='role'
            class='block text-sm font-semibold text-gray-700 mb-1'
          >Role</label>
          <select
            id='role'
            name='role'
            required
            :class="formErrors.role ? 'border-red-500 focus:ring-red-500' : formValid.role ? 'border-green-500 focus:ring-green-500 focus:border-green-500' : 'border-gray-300 focus:ring-gray-900'"
            class='w-full border bg-white rounded-lg px-4 py-2 focus:outline-none focus:ring-2 text-gray-700 transition-colors'
            @change='validateField("role", $event.target.value)'
            x-init="$el.value = formData.role"
          >
            <option value='' selected disabled>-- Select Role --</option>
            <option value='admin'>Admin</option>
            <option value='user'>User</option>
            <option value='super_admin'>Super Admin</option>
          </select>

          <!-- Error Message -->
          <template x-if='formErrors.role'>
            <div
              class='flex items-start gap-2 p-2 bg-red-50 border border-red-300 rounded-lg'
            >
              <i class='fas fa-exclamation-circle text-red-500 mt-0.5'></i>
              <p class='text-xs text-red-700' x-text='formErrors.role'></p>
            </div>
          </template>

          <!-- Success Message -->
          <template x-if='formValid.role && !formErrors.role'>
            <div
              class='flex items-center gap-2 p-2 bg-green-50 border border-green-300 rounded-lg'
            >
              <i class='fas fa-check-circle text-green-500'></i>
              <p class='text-xs text-green-700'>Valid role</p>
            </div>
          </template>
        </div>