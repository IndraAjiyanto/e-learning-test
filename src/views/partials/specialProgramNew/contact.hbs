<!-- EXPLORE PROGRAM SECTION (CTA) -->
<section id="explore-program" class="w-full mt-16 mb-24 md:mt-20 md:mb-32 font-montserrat relative">
  <div class="w-full relative min-h-[372px] flex items-center justify-center py-12 px-6">
    
    <!-- Figma Layer Blur 10 Banner Rectangle -->
    <div class="absolute inset-0 z-0 ibg-[#6EB6E5]"
         style="background-image: url('/public/image/dashboard/bgBenefit.png'); background-size: cover; background-position: center;"></div>

    <!-- Content (Crisp & Clear) -->
    <div class="max-w-4xl mx-auto text-center flex flex-col items-center justify-center relative z-10">
      
      <!-- Title -->
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold tracking-tight leading-tight">
        {{{t 'test.special_program.contact.title'}}}
      </h2>

      <!-- Subtitle -->
      <p class="text-black text-sm md:text-base lg:text-2xl font-inter font-normal max-w-full mx-auto mt-7 mb-20 text-center lg:whitespace-nowrap">
        {{t 'test.special_program.contact.description'}}
      </p>

      <!-- Button -->     
      <div>
        <a 
           href="https://wa.me/+{{category.contact}}?text=Halo%20Saya%20tertarik%20dengan%20program%20ini."
           target="_blank"
           rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-[15px] w-full sm:w-[370px] h-[85px] p-[10px] bg-[#003060] hover:bg-[#001f3f] text-white font-semibold text-xl rounded-xl border border-[#003060] transition-all duration-300 shadow-md cursor-pointer"
        >
          <i class="fas fa-phone text-2xl"></i>
          <span>{{t 'test.special_program.contact.contact'}}</span>
        </a>
      </div>

    </div>
  </div>
</section>
