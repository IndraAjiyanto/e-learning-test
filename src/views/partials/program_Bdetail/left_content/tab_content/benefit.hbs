<div>

  <div x-show="loading.benefits" class="flex justify-center py-16">
    <i class="fas fa-spinner fa-spin text-4xl text-[#0B1F3B]"></i>
  </div>

  <div x-show="!loading.benefits && benefits">
    <div class='bg-transparent rounded-xl p-6'>
      <div class="text-center">
        <h3 class=' text-lg border-gray-900 inline-flex px-4 rounded-full font-light mb-6 border bg-[#6EB6E5]/20 '>
          {{t "test.detailProgram.benefitProgram.tittle"}}
        </h3>
      </div>
      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
        <template x-for="item in (benefit?.program_benefit || [])" :key="item.id">
          <div class='bg-gradient-to-br from-gray-50 to-white rounded-xl p-5 border border-gray-200 hover:shadow-md hover:border-gray-300 transition-all'>
            <div class='flex items-start gap-4'>
              <div class='bg-gray-100 p-3 rounded-full ring-1 ring-gray-200 w-12 h-12 flex items-center justify-center'>
                <i :class="item.icon"></i>
              </div>
              <div>
                <h4 class='font-semibold text-gray-900 text-lg mb-2' x-text="getByLang(item.benefit, lang)"></h4>
                <p class='text-gray-700 leading-relaxed' x-text="getByLang(item.description, lang)"></p>
              </div>
            </div>
          </div>
        </template>
      </div>
    </div>
  </div>

</div>