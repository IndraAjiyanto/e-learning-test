<div x-show="activeTab === 'flow'" x-transition>

  <div x-show="loading.flow" class="flex justify-center py-16">
    <i class="fas fa-spinner fa-spin text-4xl text-primary"></i>
  </div>

  <div x-show="!loading.flow && flow">
    <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
      <h3 class='font-montserrat text-3xl font-bold mb-6 bg-gradient-to-r from-gray-700 to-gray-900 bg-clip-text text-transparent'>
        {{t "test.detailProgram.flowProgram.tittle"}}
      </h3>
      <div class='relative'>
        <div class='space-y-10'>
          <template x-for="item in (flow?.alur_kelas || [])" :key="item.id">
            <div class='flex gap-6'>
              <div class='flex flex-col items-center'>
                <div class='w-12 h-12 bg-gradient-to-r from-gray-600 to-gray-800 rounded-full flex items-center justify-center text-white font-bold shadow-lg'
                  x-text="item.sequence">
                </div>
                <div class='flex-1 w-0.5 bg-gradient-to-b from-gray-600 to-gray-800 mt-2'></div>
              </div>
              <div class='flex-1 pb-10'>
                <h4 class='font-montserrat text-xl font-bold text-gray-900 mb-2' x-text="getByLang(item.title, lang)"></h4>
                <p class='text-gray-700 mb-3' x-text="getByLang(item.content, lang)"></p>
              </div>
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>

</div>