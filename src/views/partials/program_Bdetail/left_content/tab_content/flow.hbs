<div>

  <div x-show="loading.learning_flow" class="flex justify-center py-16">
    <i class="fas fa-spinner fa-spin text-4xl text-[#0B1F3B]"></i>
  </div>

  <div>
    <div class='bg-transparent rounded-xl p-6'>
      <div class="text-center mb-8">
        <h3 class='text-lg border-gray-900 inline-flex px-4 rounded-full font-light border bg-[#6EB6E5]/20'>
          {{t "test.detailProgram.flowProgram.tittle"}}
        </h3>
      </div>

      <div class='flex flex-col gap-8'>
        <template x-for="(row, rowIndex) in snakeFlow" :key="rowIndex">
          <div class='grid grid-cols-1 md:grid-cols-6 gap-2'>
            <template x-for="item in row" :key="item.id">
              <div class='flex flex-col gap-2'>
                <div class='font-bold text-gray-900 text-lg px-2 mx-auto pl-2 text-center rounded-full bg-[#6EB6E5]' x-text="item.alur_ke"></div>
                <div class='bg-white shadow-lg rounded-xl p-5 border border-gray-200 hover:shadow-md hover:border-gray-300 transition-all flex-1'>
                  <svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 256 256"
     fill="none" class="h-20 w-20 font-bold mx-auto flex">

    <g stroke="#000"
       stroke-width="8"
       stroke-linecap="round"
       stroke-linejoin="round">

        <!-- Phone -->
        <rect x="40" y="28" width="40" height="64" rx="8"/>
        <line x1="40" y1="72" x2="80" y2="72"/>

        <!-- Monitor -->
        <path d="
            M96 48
            H188
            C192 48 196 52 196 56
            V144
            H108
            C102 144 96 138 96 132
            V112"/>

        <!-- Bottom frame -->
        <line x1="56" y1="144" x2="196" y2="144"/>

        <!-- Stand -->
        <polygon points="122,144 118,172 146,172 142,144"/>

        <!-- Base -->
        <line x1="102" y1="172" x2="162" y2="172"/>

    </g>

</svg>
                  <h4 class='font-semibold text-center text-gray-900 text-lg mb-2' x-text="getByLang(item.judul, lang)"></h4>
                  <p class='text-gray-700 text-center leading-relaxed' x-text="getByLang(item.isi, lang)"></p>
                </div>
              </div>
            </template>
          </div>
        </template>
      </div>
    </div>
  </div>

</div>