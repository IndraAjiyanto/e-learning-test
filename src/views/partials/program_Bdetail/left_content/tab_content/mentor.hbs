<div x-show="activeTab === 'mentor'" x-transition>

  <div x-show="loading.mentor" class="flex justify-center py-16">
    <i class="fas fa-spinner fa-spin text-4xl text-primary"></i>
  </div>

  <div x-show="!loading.mentor && mentor">
    <div class='bg-white rounded-xl p-6 shadow-lg ring-1 ring-gray-200'>
      <h3 class='font-montserrat text-3xl font-bold mb-6 bg-gradient-to-r from-gray-700 to-gray-900 bg-clip-text text-transparent'>
        {{t "test.detailProgram.mentor.tittle"}}
      </h3>
      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
        <template x-for="item in (mentor?.mentor || [])" :key="item.id">
          <div class='bg-gradient-to-br from-gray-50 to-white rounded-xl p-6 border border-gray-200 shadow-sm hover:shadow-md transition-shadow'>
            <div class='flex flex-col sm:flex-row gap-4 items-center sm:items-start'>
              <img :src="item.profile" :alt="item.name"
                class='w-20 h-20 rounded-full object-cover border-4 border-white shadow' />
              <div class='text-center sm:text-left flex-1'>
                <h4 class='font-montserrat font-bold text-gray-800 text-lg' x-text="item.name"></h4>
                <p class='text-gray-600 mb-2' x-text="getByLang(item.position, lang)"></p>
                <div class='flex justify-center sm:justify-start gap-2 mb-3 flex-wrap'>
                  <template x-for="tech in (item.technologies || [])" :key="tech.id">
                    <span class='w-6 h-6' x-html="tech.svg"></span>
                  </template>
                </div>
                <p class='text-gray-700 text-sm' x-text="getByLang(item.description, lang)"></p>
              </div>
            </div>
            <div class='mt-4 flex items-center justify-center sm:justify-start gap-4 text-gray-500'>
              <a :href="item.linkedin" target='_blank' class='hover:text-gray-800 transition-colors'>
                <i class='fab fa-linkedin'></i>
              </a>
            </div>
          </div>
        </template>
      </div>
    </div>
  </div>

</div>