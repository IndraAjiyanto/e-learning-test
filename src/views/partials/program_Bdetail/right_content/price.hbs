<!-- Info Card -->
<div class="space-y-6">
  
  <!-- Learning Date -->
  <div class="flex items-start gap-4">
    <div class="mt-1 text-slate-600">
      <i class="far fa-calendar-alt text-xl"></i>
    </div>
    <div>
      <h3 class="font-semibold text-slate-900 text-base">Learning Date</h3>
      <p class="text-sm text-slate-600 mt-1">
        <span x-text="new Date('{{kelas.tanggal_mulai}}').toLocaleDateString('en-US', {day: 'numeric', month: 'long'})"></span> - 
        <span x-text="new Date('{{kelas.tanggal_selesai}}').toLocaleDateString('en-US', {day: 'numeric', month: 'long', year: 'numeric'})"></span> - 
        <span class="capitalize">{{kelas.metode}}</span>
      </p>
    </div>
  </div>

  <!-- Location -->
  <div class="flex items-start gap-4">
    <div class="mt-1 text-slate-600">
      <i class="fas fa-map-marker-alt text-xl"></i>
    </div>
    <div>
      <h3 class="font-bold text-slate-900 text-base">Location</h3>
      <p class="text-sm text-slate-600 mt-1">
        {{#if kelas.lokasi}}
          <span x-text="getByLang({{json kelas.lokasi}}, lang) || '{{kelas.lokasi.[0]}}'"></span>
        {{else}}
          <span class="capitalize">{{kelas.metode}}</span>
        {{/if}}
      </p>
    </div>
  </div>

  <!-- Capacity -->
  <div class="flex items-start gap-4">
    <div class="mt-1 text-slate-600">
      <i class="fas fa-user-friends text-xl"></i>
    </div>
    <div>
      <h3 class="font-bold text-slate-900 text-base">Capacity</h3>
      <p class="text-sm text-slate-600 mt-1">
        {{kelas.kuota}} Students
      </p>
    </div>
  </div>

 

  <!-- Registration Close Info -->
  <div class="text-center pb-2">
    <p class="text-red-600 font-semibold text-sm">
      Registration is Open Until <span x-text="new Date('{{kelas.tanggal_mulai}}').toLocaleDateString('en-US', {month: 'long', day: 'numeric', year: 'numeric'})"></span>
    </p>
  </div>

</div>
