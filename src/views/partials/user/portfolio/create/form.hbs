<form
  id='portfolioForm'
  method='POST'
  action='/portfolio/create'
  enctype='multipart/form-data'
  x-data='createPortfolioForm()'
  @submit.prevent='handleSubmit($event)'
>
  {{#if isFromCourse}}
    <input type='hidden' name='fromCourse' value='true' />
  {{else}}
    <input type='hidden' name='from' value='portfolio' />
  {{/if}}

  <div class='grid grid-cols-1 lg:grid-cols-2 gap-8'>

    <!-- Kolom Kiri -->
    <div class='space-y-6'>
      <!-- Judul Portfolio -->
      <div>
        <label
          for='title'
          class='block text-base sm:text-lg font-semibold text-[#003060] mb-2 font-inter'
        >{{t 'test.myPortfolio.createPortfolio.portfolioTittle'}}<span class='text-red-500'>*</span></label>
        <input
          type='text'
          id='title'
          name='title'
          x-model='form.title'
          required
          placeholder='{{t 'test.myPortfolio.createPortfolio.placeholderTittle'}}'
          class='w-full h-[44px] px-[14px] bg-white border border-[#D4D4D4] rounded-[8px] font-inter text-base text-[#404040] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-colors shadow-[0px_1px_2px_rgba(0,0,0,0.05)]'
        />
      </div>

      <!-- Deskripsi -->
      <div>
        <label
          for='description'
          class='block text-base sm:text-lg font-semibold text-[#003060] mb-2 font-inter'
        >{{t 'test.myPortfolio.createPortfolio.description'}}<span class='text-red-500'>*</span></label>
        <textarea
          name='description'
          id='description'
          x-model='form.description'
          required
          placeholder='{{t 'test.myPortfolio.createPortfolio.placeholderDescription'}}'
          rows='4'
          class='w-full px-[14px] py-[10px] bg-white border border-[#D4D4D4] rounded-[8px] font-inter text-base text-[#404040] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-colors resize-none shadow-[0px_1px_2px_rgba(0,0,0,0.05)]'
        ></textarea>
      </div>

      <!-- Program -->
      <div>
        <label class='block text-base sm:text-lg font-semibold text-[#003060] mb-2 font-inter'>
          {{t 'test.myPortfolio.detailPortfolio.program'}}<span class='text-red-500'>*</span>
        </label>
        {{#if courseId}}
          <input type='hidden' name='courseId' value='{{courseId}}' />
          <div class='flex h-[44px] items-center rounded-[8px] border border-[#D4D4D4] bg-[#F5F5F5] px-[14px] font-inter text-base text-[#666666]'>
            {{default course.name 'Program'}}
          </div>
          <p class='pt-1 font-inter text-xs text-[#737373]'>
            {{t 'test.myPortfolio.modal.programLockedHint'}}
          </p>
        {{else}}
          <select
            name='courseId'
            x-model='form.courseId'
            required
            class='w-full h-[44px] px-[14px] bg-white border border-[#D4D4D4] rounded-[8px] font-inter text-base text-[#404040] focus:outline-none focus:border-[#003060] transition-colors shadow-[0px_1px_2px_rgba(0,0,0,0.05)] cursor-pointer'
          >
            <option value='' disabled selected>{{t 'test.myPortfolio.selectProgram'}}</option>
            {{#each courses}}
              <option value='{{this.id}}'>{{this.name}}</option>
            {{/each}}
          </select>
        {{/if}}
      </div>

      <!-- Link -->
      <div>
        <label
          for='link'
          class='block text-base sm:text-lg font-semibold text-[#003060] mb-2 font-inter'
        >{{t 'test.myPortfolio.createPortfolio.link'}}<span class='text-red-500'>*</span></label>
        <input
          type='url'
          id='link'
          name='link'
          x-model='form.link'
          required
          placeholder='{{t 'test.myPortfolio.createPortfolio.placeholderLink'}}'
          class='w-full h-[44px] px-[14px] bg-white border border-[#D4D4D4] rounded-[8px] font-inter text-base text-[#404040] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-colors shadow-[0px_1px_2px_rgba(0,0,0,0.05)]'
        />
        <p class='pt-1 font-inter text-xs text-[#737373]'>
          {{t 'test.myPortfolio.createPortfolio.spanLink'}}
        </p>
      </div>
    </div>

    <!-- Kolom Kanan -->
    <div class='space-y-6'>
      <!-- Project Overview -->
      <div>
        <label class='block text-base sm:text-lg font-semibold text-[#003060] mb-2 font-inter'>
          {{t 'test.myPortfolio.createPortfolio.overview'}}
        </label>
        {{> components/ui/admin/form/editor-input
          id="portfolio_create_editor"
          name="content"
          inputId="portfolio_create_content_input"
        }}
      </div>

      <!-- Upload Gambar -->
      <div class='space-y-3'>
        <label class='block text-base sm:text-lg font-semibold text-[#003060] mb-1 font-inter'>
          {{t 'test.myPortfolio.createPortfolio.uploadImages'}}<span class='text-red-500'>*</span>
        </label>
        <p class='font-inter text-xs text-[#737373]'>
          {{t 'test.myPortfolio.createPortfolio.spanUploadImages'}}
        </p>

        <div class='space-y-3 max-h-[220px] overflow-y-auto p-1'>
          <template x-for='(upload, idx) in imageUploads' :key='upload.id'>
            <div class='flex h-[52px] w-full items-center justify-between gap-3 rounded-[8px] border border-[#D4D4D4] bg-white px-3 hover:shadow-sm'>
              <div class='flex min-w-0 items-center gap-3'>
                <label class='flex-shrink-0 cursor-pointer rounded-[6px] bg-[#0B1F3B1A] px-3.5 py-1.5 font-inter text-sm font-medium text-black transition-colors hover:bg-slate-200'>
                  {{t 'test.myPortfolio.modal.chooseFile'}}
                  <input type='file' name='image' class='hidden' accept='image/jpeg,image/jpg,image/png,image/gif' @change='handleFile($event, idx)'>
                </label>
                <span class='truncate font-inter text-xs sm:text-sm text-[#676767]' x-text='upload.name'></span>
              </div>
              <button
                type='button'
                x-show='imageUploads.length > 1'
                @click='imageUploads.splice(idx, 1)'
                class='cursor-pointer px-2 py-1 text-xs text-red-500 transition-colors hover:text-red-700'
                title='{{t 'test.myPortfolio.modal.removeImage'}}'
              >
                <i class='fa-solid fa-trash-can'></i>
              </button>
            </div>
          </template>
        </div>

        <template x-for='upload in imageUploads.filter(u => u.error)' :key="'err-' + upload.id">
          <p class='flex items-start gap-1.5 font-inter text-xs text-[#dc2626]'>
            <i class='fa-solid fa-circle-exclamation mt-0.5'></i>
            <span x-text="upload.name + ': ' + upload.error"></span>
          </p>
        </template>

        <div
          @click='addImageRow()'
          class='mt-2 flex h-[48px] w-full cursor-pointer items-center justify-center gap-2 rounded-[8px] border border-dashed border-[#D4D4D4] font-inter text-sm font-medium text-[#666666] transition-colors hover:bg-[#FAFAFA]'
        >
          <i class='fa-solid fa-plus text-xs'></i>
          <span>{{t 'test.myPortfolio.createPortfolio.addImage'}}</span>
        </div>
      </div>
    </div>

  </div>

  <!-- Action Buttons -->
  <div class='flex items-center gap-4 pt-8 mt-6 border-t border-[#E5E5E5]'>
    <button
      type='submit'
      :disabled='loading || !canSubmit()'
      class='flex h-[44px] flex-1 cursor-pointer items-center justify-center rounded-[8px] bg-[#003060] font-inter text-base font-semibold text-white shadow-md transition-all hover:bg-[#001f3f] disabled:pointer-events-none disabled:opacity-50'
    >
      <span x-show='loading' class='loading loading-spinner loading-sm mr-2'></span>
      <span>{{t 'test.myPortfolio.createPortfolio.createPortfolioButton'}}</span>
    </button>
    <a
      href='{{#if isFromCourse}}/users/profile?tab=course-portfolio&courseId={{courseId}}{{else}}/users/profile?tab=portfolio{{/if}}'
      class='inline-flex h-[44px] flex-1 cursor-pointer items-center justify-center gap-2 rounded-[8px] border border-[#D4D4D4] bg-white font-inter text-base font-semibold text-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#F5F5F5]'
    >
      {{t 'test.myPortfolio.createPortfolio.cancelButton'}}
    </a>
  </div>
</form>

<script>
function createPortfolioForm() {
  return {
    form: {
      title: '',
      description: '',
      link: '',
      courseId: '{{courseId}}'
    },
    imageUploads: [
      { id: 1, file: null, name: '{{t 'test.myPortfolio.modal.noFileChosen'}}', error: '' }
    ],
    loading: false,
    editorInstance: null,

    init() {
      let isInitializing = false;
      const initEditor = () => {
        if (isInitializing) return;
        if (!window.EditorJS || !window.EditorTools) {
          setTimeout(initEditor, 100);
          return;
        }
        isInitializing = true;
        const holder = document.getElementById('portfolio_create_editor');
        if (holder) holder.innerHTML = '';

        if (this.editorInstance && typeof this.editorInstance.destroy === 'function') {
          try { this.editorInstance.destroy(); } catch (e) {}
        }

        try {
          this.editorInstance = new window.EditorJS({
            holder: 'portfolio_create_editor',
            placeholder: 'Enter your content here...',
            tools: {
              header: {
                class: window.EditorTools.Header,
                inlineToolbar: ['link'],
                config: {
                  placeholder: 'Enter a heading...',
                  levels: [1, 2, 3, 4, 5, 6],
                  defaultLevel: 2
                }
              },
              paragraph: {
                class: window.EditorTools.Paragraph,
                inlineToolbar: true
              },
              list: {
                class: window.EditorTools.List,
                inlineToolbar: true
              },
              marker: {
                class: window.EditorTools.Marker,
                shortcut: 'CMD+SHIFT+M'
              },
              image: {
                class: window.EditorTools.ImageTool,
                tunes: {
                  stretched: false,
                  withBorder: false,
                  withBackground: false
                },
                config: {
                  endpoints: {
                    byFile: '/portfolio/upload-image',
                    byUrl: '/program/fetch-image'
                  }
                }
              },
              linkTool: {
                class: window.EditorTools.LinkTool,
                config: { endpoint: '/program/fetch-link' }
              }
            }
          });
        } catch (err) {
          console.error('[Portfolio] Failed to init EditorJS:', err);
        }
      };
      initEditor();
    },

    addImageRow() {
      this.imageUploads.push({
        id: Date.now(),
        file: null,
        name: '{{t 'test.myPortfolio.modal.noFileChosen'}}',
        error: ''
      });
    },

    handleFile(event, idx) {
      const file = event.target.files[0];
      if (!file) return;
      this.imageUploads[idx].file = file;
      this.imageUploads[idx].name = file.name;
      this.imageUploads[idx].error = '';
      this.checkImage(file, idx);
    },

    checkImage(file, idx) {
      const TYPES = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
      const MAX = 5 * 1024 * 1024;
      if (!TYPES.includes(file.type)) {
        this.imageUploads[idx].error = '{{t 'test.myPortfolio.messages.invalidType'}}';
        return;
      }
      if (file.size > MAX) {
        this.imageUploads[idx].error = '{{t 'test.myPortfolio.messages.fileTooLarge'}}';
        return;
      }
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        const okW = img.naturalWidth >= 1900 && img.naturalWidth <= 1920;
        const okH = img.naturalHeight >= 1000 && img.naturalHeight <= 1080;
        this.imageUploads[idx].error = okW && okH
          ? ''
          : `${img.naturalWidth}x${img.naturalHeight} {{t 'test.myPortfolio.messages.dimensionError'}}`;
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        this.imageUploads[idx].error = '{{t 'test.myPortfolio.messages.unreadableImage'}}';
      };
      img.src = url;
    },

    canSubmit() {
      if (!this.form.title.trim() || !this.form.description.trim() || !this.form.link.trim() || !this.form.courseId) return false;
      if (!/^https?:\/\/\S+$/i.test(this.form.link.trim())) return false;
      const validFiles = this.imageUploads.filter(u => u.file && !u.error);
      if (validFiles.length === 0) return false;
      if (this.imageUploads.some(u => u.error)) return false;
      return true;
    },

    async handleSubmit(e) {
      if (!this.canSubmit() || this.loading) return;

      let editorData = null;
      if (this.editorInstance && typeof this.editorInstance.save === 'function') {
        try {
          editorData = await this.editorInstance.save();
        } catch (err) {
          console.error('[Portfolio] EditorJS save error:', err);
        }
      }

      const jsonContent = editorData ? JSON.stringify(editorData) : JSON.stringify({ time: Date.now(), blocks: [] });
      const contentInput = document.getElementById('portfolio_create_content_input') || document.querySelector('input[name="content"]');
      if (contentInput) {
        contentInput.value = jsonContent;
      }

      this.loading = true;
      e.target.submit();
    }
  };
}
</script>