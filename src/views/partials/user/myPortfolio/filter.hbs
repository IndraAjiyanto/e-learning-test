      <div class='lg:col-span-1'>
        <div
          class='bg-white rounded-xl shadow-sm border border-gray-200 p-6 sticky top-6'
        >
          <div class='mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200'>
            <div class='flex items-center justify-between mb-3'>
              <h4 class='text-sm font-semibold text-gray-700 font-inter'>{{t "test.portfolio.filterTittle"}}</h4>
              <button
                @click='resetFilters()'
                class='text-xs text-gray-500 hover:text-gray-700 transition-colors flex items-center'
              >
                <i class='fas fa-undo-alt mr-1 text-xs'></i>
                {{t "test.portfolio.resetFilters"}}
              </button>
            </div>
            <div class='space-y-2'>
              <template
                x-if="selectedKategori === '' && selectedJenisKelas === ''"
              >
                <div
                  class='text-xs text-gray-500 text-center py-2 bg-white rounded border border-gray-200'
                >
                  {{t "test.portfolio.noFilters"}}
                </div>
              </template>

              <template x-if="selectedKategori !== ''">
                <span
                  class='block px-3 py-1 text-xs rounded-full bg-gray-100 text-gray-700 font-medium border'
                >
                  <span x-text='selectedKategori'></span>
                </span>
              </template>

              <template x-if="selectedJenisKelas !== ''">
                <span
                  class='block px-3 py-1 text-xs rounded-full bg-gray-100 text-gray-700 font-medium border'
                >
                  <span x-text='selectedJenisKelas'></span>
                </span>
              </template>
            </div>
          </div>

          <!-- Kategori Filter (Search List Dropdown) -->
          <div class='mb-5'>
            <h3
              class='text-sm font-semibold text-gray-900 mb-2 flex items-center font-inter'
            >
              <i class='fas fa-tags text-gray-500 mr-2'></i>
              {{t "test.portfolio.categoryTittle"}}
            </h3>

            <div
              class='relative'
              x-data='{ open: false, searchCat: "" }'
              @click.outside='open = false; searchCat = ""'
              @keydown.escape.window='open = false; searchCat = ""'
            >
              <button
                type='button'
                @click='open = !open; if (open) $nextTick(() => $refs.myCatSearchInput?.focus())'
                class='w-full flex items-center justify-between px-3.5 py-2.5 bg-white text-xs font-medium text-gray-700 rounded-lg border border-gray-300 transition-all cursor-pointer outline-none focus:border-[#003060] focus:ring-1 focus:ring-[#003060]'
                :class="open && 'border-[#003060] ring-1 ring-[#003060]'"
              >
                <span class='truncate text-left' x-text="selectedKategoriId ? (allKategori.find(k => String(k.id) === String(selectedKategoriId))?.name || '{{t "test.portfolio.allCategory"}}') : '{{t "test.portfolio.allCategory"}}'"></span>
                <i class='fas fa-chevron-down text-xs text-gray-400 transition-transform duration-200 shrink-0 ml-2' :class="open && 'rotate-180'"></i>
              </button>

              <div
                x-cloak
                x-show='open'
                x-transition.opacity.duration.150ms
                class='absolute left-0 z-50 mt-1.5 w-full min-w-[220px] max-h-64 overflow-hidden flex flex-col rounded-xl border border-gray-200 bg-white shadow-lg'
              >
                {{!-- Search Input inside the dropdown --}}
                <div class="p-2 border-b border-gray-100 sticky top-0 bg-white z-10">
                  <div class="relative flex items-center">
                    <i class="fas fa-magnifying-glass absolute left-2.5 text-xs text-gray-400"></i>
                    <input
                      type="text"
                      x-ref="myCatSearchInput"
                      x-model="searchCat"
                      @click.stop
                      placeholder='{{t "test.portfolio.searchCategoryPlaceholder"}}'
                      class="w-full pl-7 pr-7 py-1.5 text-xs font-inter border border-gray-200 rounded-lg focus:outline-none focus:border-[#003060] focus:ring-1 focus:ring-[#003060] text-gray-800 placeholder-gray-400"
                    />
                    <button
                      type="button"
                      x-show="searchCat"
                      x-cloak
                      @click.stop="searchCat = ''; $refs.myCatSearchInput?.focus()"
                      class="absolute right-2 text-xs text-gray-400 hover:text-gray-700"
                      aria-label="Clear search"
                    >
                      <i class="fas fa-times"></i>
                    </button>
                  </div>
                </div>

                {{!-- Options List --}}
                <div class="overflow-y-auto p-1.5 max-h-48 space-y-0.5">
                  <button
                    type='button'
                    x-show="!searchCat || '{{t "test.portfolio.allCategory"}}'.toLowerCase().includes(searchCat.toLowerCase().trim())"
                    @click="selectKategori(''); open = false; searchCat = ''"
                    class='flex w-full items-center justify-between rounded-lg px-3 py-2 text-left font-inter text-xs transition'
                    :class="!selectedKategoriId ? 'bg-[#003060] text-white font-medium' : 'text-gray-700 hover:bg-gray-50'"
                  >
                    <span>{{t "test.portfolio.allCategory"}}</span>
                    <i class='fas fa-check text-xs' x-show='!selectedKategoriId'></i>
                  </button>
                  <template x-for="cat in allKategori.filter(c => !searchCat || (c.name || '').toLowerCase().includes(searchCat.toLowerCase().trim()))" :key="cat.id">
                    <button
                      type='button'
                      @click="selectKategori(cat.id); open = false; searchCat = ''"
                      class='flex w-full items-center justify-between rounded-lg px-3 py-2 text-left font-inter text-xs transition'
                      :class="String(selectedKategoriId) === String(cat.id) ? 'bg-[#003060] text-white font-medium' : 'text-gray-700 hover:bg-gray-50'"
                    >
                      <span class='truncate' x-text="cat.name"></span>
                      <i class='fas fa-check text-xs' x-show="String(selectedKategoriId) === String(cat.id)"></i>
                    </button>
                  </template>
                  <div
                    x-show="allKategori.filter(c => !searchCat || (c.name || '').toLowerCase().includes(searchCat.toLowerCase().trim())).length === 0 && (!searchCat || !'{{t "test.portfolio.allCategory"}}'.toLowerCase().includes(searchCat.toLowerCase().trim()))"
                    class="py-3 px-2 text-center text-xs text-gray-400 font-inter"
                  >
                    {{default (t 'test.home.programSection.noTypesFound') 'Tidak ada data ditemukan'}}
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tipe Kelas / Program Filter (Search List Dropdown) -->
          <div class='mb-6'>
            <h3
              class='text-sm font-semibold text-gray-900 mb-2 flex items-center font-inter'
            >
              <i class='fas fa-graduation-cap text-gray-500 mr-2'></i>
              {{t "test.portfolio.classTypeTittle"}}
            </h3>

            <div
              class='relative'
              x-data='{ open: false, searchType: "" }'
              @click.outside='open = false; searchType = ""'
              @keydown.escape.window='open = false; searchType = ""'
            >
              <button
                type='button'
                @click='open = !open; if (open) $nextTick(() => $refs.myTypeSearchInput?.focus())'
                class='w-full flex items-center justify-between px-3.5 py-2.5 bg-white text-xs font-medium text-gray-700 rounded-lg border border-gray-300 transition-all cursor-pointer outline-none focus:border-[#003060] focus:ring-1 focus:ring-[#003060]'
                :class="open && 'border-[#003060] ring-1 ring-[#003060]'"
              >
                <span class='truncate text-left' x-text="selectedJenisKelasId ? (getByLang(allJenisKelas.find(j => String(j.id) === String(selectedJenisKelasId))?.nameClassesType, lang) || '{{t "test.portfolio.allClassType"}}') : '{{t "test.portfolio.allClassType"}}'"></span>
                <i class='fas fa-chevron-down text-xs text-gray-400 transition-transform duration-200 shrink-0 ml-2' :class="open && 'rotate-180'"></i>
              </button>

              <div
                x-cloak
                x-show='open'
                x-transition.opacity.duration.150ms
                class='absolute left-0 z-50 mt-1.5 w-full min-w-[220px] max-h-64 overflow-hidden flex flex-col rounded-xl border border-gray-200 bg-white shadow-lg'
              >
                {{!-- Search Input inside the dropdown --}}
                <div class="p-2 border-b border-gray-100 sticky top-0 bg-white z-10">
                  <div class="relative flex items-center">
                    <i class="fas fa-magnifying-glass absolute left-2.5 text-xs text-gray-400"></i>
                    <input
                      type="text"
                      x-ref="myTypeSearchInput"
                      x-model="searchType"
                      @click.stop
                      placeholder='{{t "test.portfolio.searchClassTypePlaceholder"}}'
                      class="w-full pl-7 pr-7 py-1.5 text-xs font-inter border border-gray-200 rounded-lg focus:outline-none focus:border-[#003060] focus:ring-1 focus:ring-[#003060] text-gray-800 placeholder-gray-400"
                    />
                    <button
                      type="button"
                      x-show="searchType"
                      x-cloak
                      @click.stop="searchType = ''; $refs.myTypeSearchInput?.focus()"
                      class="absolute right-2 text-xs text-gray-400 hover:text-gray-700"
                      aria-label="Clear search"
                    >
                      <i class="fas fa-times"></i>
                    </button>
                  </div>
                </div>

                {{!-- Options List --}}
                <div class="overflow-y-auto p-1.5 max-h-48 space-y-0.5">
                  <button
                    type='button'
                    x-show="!searchType || '{{t "test.portfolio.allClassType"}}'.toLowerCase().includes(searchType.toLowerCase().trim())"
                    @click="selectJenisKelas(''); open = false; searchType = ''"
                    class='flex w-full items-center justify-between rounded-lg px-3 py-2 text-left font-inter text-xs transition'
                    :class="!selectedJenisKelasId ? 'bg-[#003060] text-white font-medium' : 'text-gray-700 hover:bg-gray-50'"
                  >
                    <span>{{t "test.portfolio.allClassType"}}</span>
                    <i class='fas fa-check text-xs' x-show='!selectedJenisKelasId'></i>
                  </button>
                  <template x-for="jenis in allJenisKelas.filter(j => !searchType || (getByLang(j.nameClassesType, lang) || '').toLowerCase().includes(searchType.toLowerCase().trim()))" :key="jenis.id">
                    <button
                      type='button'
                      @click="selectJenisKelas(jenis.id); open = false; searchType = ''"
                      class='flex w-full items-center justify-between rounded-lg px-3 py-2 text-left font-inter text-xs transition'
                      :class="String(selectedJenisKelasId) === String(jenis.id) ? 'bg-[#003060] text-white font-medium' : 'text-gray-700 hover:bg-gray-50'"
                    >
                      <span class='truncate' x-text="getByLang(jenis.nameClassesType, lang)"></span>
                      <i class='fas fa-check text-xs' x-show="String(selectedJenisKelasId) === String(jenis.id)"></i>
                    </button>
                  </template>
                  <div
                    x-show="allJenisKelas.filter(j => !searchType || (getByLang(j.nameClassesType, lang) || '').toLowerCase().includes(searchType.toLowerCase().trim())).length === 0 && (!searchType || !'{{t "test.portfolio.allClassType"}}'.toLowerCase().includes(searchType.toLowerCase().trim()))"
                    class="py-3 px-2 text-center text-xs text-gray-400 font-inter"
                  >
                    {{default (t 'test.home.programSection.noTypesFound') 'Tidak ada data ditemukan'}}
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class='mt-6 p-4 bg-gray-50 rounded-lg border border-gray-200'>
            <div class='text-center'>
              <div
                class='text-2xl font-bold text-gray-900'
                x-text='totalItems'
              ></div>
              <div class='text-sm text-gray-600'>{{t "test.portfolio.projectAvailable"}}</div>
            </div>
          </div>
        </div>
      </div>
