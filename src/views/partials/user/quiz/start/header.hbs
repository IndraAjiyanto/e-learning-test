{{!--
  Kepala halaman pengerjaan kuis.

  Bentuknya sengaja SAMA dengan kartu kepala di halaman ikhtisar
  (user/quiz/quiz.hbs): ikon, nama, satu kalimat penjelas, lalu sebaris chip.
  Dengan begitu keterangan kuis ikut ke halaman pengerjaan dan student tidak
  perlu kembali ke halaman sebelumnya hanya untuk mengingat nilai minimumnya.
  Idenya dari kartu kepala halaman kuis bisa.ai; token warna dan bentuknya
  milik kita.

  Sebelumnya kepala ini cuma kotak abu berisi judul dengan
  `bg-clip-text text-transparent` di atas latar solid - teksnya kebetulan
  terbaca hanya karena warnanya kebetulan sama.
--}}
<div class="overflow-hidden rounded-xl border border-[#E5E5E5] bg-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]">
  <div class="flex flex-wrap items-start gap-4 p-5 sm:p-6">
    <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-[#E4F1F7] text-[#003060]">
      <i class="fa-solid fa-circle-question text-base"></i>
    </span>

    <div class="min-w-0 flex-1">
      <h1 class="font-montserrat text-xl font-bold leading-snug text-[#003060] sm:text-2xl">
        {{pertanyaan.[0].quiz.quizName}}
      </h1>
      <p class="mt-1 font-inter text-sm text-[#737373]">{{t 'test.quiz.start.chooseTheAnswer'}}</p>

      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[#F5F5F5] px-2.5 py-1 font-inter text-xs font-medium text-[#525252]">
          <i class="fa-solid fa-list-ol text-[0.65rem] text-[#718096]"></i>
          {{pertanyaan.length}} {{t 'test.quiz.questionsCount'}}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[#F5F5F5] px-2.5 py-1 font-inter text-xs font-medium text-[#525252]">
          <i class="fa-solid fa-list-check text-[0.65rem] text-[#718096]"></i>
          {{t 'test.quiz.multipleChoice'}}
        </span>
        {{#if pertanyaan.[0].quiz.minScore}}
          <span class="inline-flex items-center gap-1.5 rounded-full bg-[#F5F5F5] px-2.5 py-1 font-inter text-xs font-medium text-[#525252]">
            <i class="fa-solid fa-bullseye text-[0.65rem] text-[#718096]"></i>
            {{t 'test.quiz.minimumScore'}} {{pertanyaan.[0].quiz.minScore}}
          </span>
        {{/if}}
      </div>
    </div>

    {{!-- Sisa waktu. Dulu berada di dalam kartu Daftar Soal di kolom kiri,
         bersebelahan dengan judul kolom itu, sehingga "Time is over" terbaca
         seakan-akan keterangan daftar soalnya. --}}
    {{#if check}}
      <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-[#FECACA] bg-[#FEF2F2] px-3 py-1.5 font-inter text-xs font-semibold leading-none text-[#B42318]">
        <i class="fa-regular fa-clock text-[0.7rem]"></i>
        {{t 'test.quiz.start.timeIsOver'}}
      </span>
    {{else}}
      <span id="countdownExample" class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-[#E5E5E5] bg-[#FAFAFA] px-3 py-1.5 font-inter text-xs font-semibold leading-none text-[#003060]">
        <i class="fa-regular fa-clock text-[0.7rem] text-[#718096]"></i>
        {{t 'test.quizStart.timeLeft'}}
        <span class="values tabular-nums">--:--:--</span>
      </span>
    {{/if}}
  </div>
</div>
