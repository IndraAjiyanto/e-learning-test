{{!--
  Badan halaman pengerjaan kuis.

  Yang berubah dari versi sebelumnya:
  - Tombol Previous/Next tidak punya padding sama sekali (tidak ada px/py/h),
    jadi keduanya saling menindih di pojok kanan atas. Sekarang tingginya sama
    dengan tombol lain di area student, dan letaknya di BAWAH soal - arah baca
    yang sama dengan halaman kuis bisa.ai.
  - `:class="answeredCount !== N ? 'opacity-40 cursor-not-allowed'"` adalah
    ternary tanpa cabang else; ekspresinya gagal dikompilasi Alpine dan seluruh
    binding tombol Submit mati. Sekarang lengkap, dan alasan tombolnya nonaktif
    ditulis di sebelahnya.
  - Daftar soal berupa tombol memanjang satu per baris diganti kisi nomor
    beserta keterangan warnanya, ditambah kartu cara mengerjakan - keduanya
    ditiru dari bisa.ai.
  - Baris kemajuan ("Soal x dari y" + batang) dipindah ke atas soal, bukan
    terselip di kaki kolom kiri.
--}}
<form method="POST" action="/answer-users/{{quizId}}" x-data="quiz()" x-init="init()" id="formSubmit" class="mt-4">
{{#if check}}
<script>
window.addEventListener("load", function(){
    timeOverSubmit();
});
</script>
{{else}}
<script>
document.addEventListener("DOMContentLoaded", function () {
    const timer = new easytimer.Timer();
    timer.start({ countdown: true, startValues: { seconds: {{default remainingTime 0}} } });

    function updateTimer() {
        const el = document.querySelector('#countdownExample .values');
        if (el) el.innerHTML = timer.getTimeValues().toString();
    }

    updateTimer();
    timer.addEventListener('secondsUpdated', updateTimer);
    timer.addEventListener('targetAchieved', function () {
        prepareAndSubmit();
    });
});
</script>
{{/if}}

  <!-- Kemajuan pengerjaan -->
  <div class="rounded-xl border border-[#E5E5E5] bg-white px-5 py-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:px-6">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <span class="font-inter text-sm text-[#525252]">
        {{t 'test.quiz.start.question'}}
        <span class="font-semibold text-[#171717]" x-text="currentQuestion + 1"></span>
        {{t 'test.quiz.start.of'}}
        <span class="font-semibold text-[#171717]">{{pertanyaan.length}}</span>
      </span>
      <span class="font-inter text-sm text-[#525252]">
        {{t 'test.quizStart.answered'}}
        <span class="font-semibold text-[#171717]" x-text="answeredCount"></span>
        &middot;
        <span class="font-semibold text-[#003060]" x-text="Math.round((answeredCount / {{pertanyaan.length}}) * 100) + '%'"></span>
      </span>
    </div>
    <div class="mt-2.5 h-2 w-full overflow-hidden rounded-full bg-[#F0F0F0]">
      <div
        class="h-full rounded-full bg-[#003060] transition-all duration-300"
        :style="`width: ${(answeredCount / {{pertanyaan.length}}) * 100}%`"
      ></div>
    </div>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-3">

    <!-- Soal dan pilihan jawaban -->
    <div class="lg:col-span-2">
      <div class="overflow-hidden rounded-xl border border-[#E5E5E5] bg-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]">
        {{#each pertanyaan}}
        <div x-show="currentQuestion === {{@index}}" class="p-5 sm:p-6">
          <input type="hidden" name="q-{{id}}" value="">

          <span class="inline-flex items-center gap-1.5 rounded-full bg-[#E4F1F7] px-2.5 py-1 font-inter text-xs font-semibold leading-none text-[#003060]">
            {{t 'test.quiz.start.question'}} {{addOne @index}}
          </span>

          {{#if image}}
            <div class="mt-3 flex justify-center">
              <img src="{{image}}" alt="" class="max-h-64 rounded-xl border border-[#E5E5E5] object-contain" />
            </div>
          {{/if}}

          <p class="mt-3 font-inter text-base font-semibold leading-relaxed text-[#171717]">{{questionText}}</p>

          {{!-- Huruf pilihan (A, B, C, ...) ditiru dari bisa.ai; dipetakan dari
               @index lewat helper array yang sudah ada, bukan helper baru. --}}
          <div class="mt-4 space-y-2.5">
            {{#each answers}}
              <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-[#E5E5E5] bg-white px-4 py-3 transition-colors hover:border-[#D4D4D4] hover:bg-[#FAFAFA] has-[:checked]:border-[#003060] has-[:checked]:bg-[#E4F1F7]">
                <input
                  type="radio"
                  name="q-{{../id}}"
                  value="{{id}}"
                  class="size-4 shrink-0 accent-[#003060]"
                >
                <span class="grid size-6 shrink-0 place-items-center rounded-md bg-[#F5F5F5] font-inter text-xs font-bold text-[#525252]">
                  {{lookup (array 'A' 'B' 'C' 'D' 'E' 'F' 'G' 'H') @index}}
                </span>
                <span class="min-w-0 font-inter text-sm text-[#171717]">{{answer}}</span>
              </label>
            {{/each}}
          </div>
        </div>
        {{/each}}

        <!-- Pindah soal dan kumpulkan -->
        <div class="flex flex-wrap items-center gap-3 border-t border-[#E5E5E5] bg-[#FAFAFA] px-5 py-4 sm:px-6">
          <button
            type="button"
            @click="prevQuestion()"
            :disabled="currentQuestion === 0"
            class="inline-flex h-10 cursor-pointer items-center justify-center gap-2 rounded-[8px] border border-[#D4D4D4] bg-white px-4 font-inter text-sm font-semibold text-[#344054] transition-colors hover:bg-[#F9FAFB] disabled:cursor-not-allowed disabled:opacity-40"
          >
            <i class="fa-solid fa-chevron-left text-xs"></i>
            {{t 'test.quiz.start.previous'}}
          </button>

          <span
            x-show="answeredCount !== {{pertanyaan.length}}"
            class="min-w-0 flex-1 font-inter text-xs text-[#737373]"
          >{{t 'test.quizStart.answerAllFirst'}}</span>
          <span x-show="answeredCount === {{pertanyaan.length}}" class="min-w-0 flex-1"></span>

          <button
            type="button"
            @click="nextQuestion()"
            x-show="currentQuestion < {{pertanyaan.length}} - 1"
            class="inline-flex h-10 cursor-pointer items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-4 font-inter text-sm font-semibold text-white transition-colors hover:bg-[#00254a]"
          >
            {{t 'test.quiz.start.next'}}
            <i class="fa-solid fa-chevron-right text-xs"></i>
          </button>

          <button
            type="button"
            onclick="confirmQuizSubmit()"
            x-show="currentQuestion === {{pertanyaan.length}} - 1"
            :disabled="answeredCount !== {{pertanyaan.length}}"
            class="inline-flex h-10 cursor-pointer items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-4 font-inter text-sm font-semibold text-white transition-colors hover:bg-[#00254a] disabled:cursor-not-allowed disabled:opacity-40"
          >
            {{t 'test.quiz.start.submitAnswers'}}
            <i class="fa-solid fa-arrow-right text-xs"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Kisi nomor soal dan cara mengerjakan -->
    <div class="space-y-4 lg:col-span-1">
      <div class="rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] lg:sticky lg:top-4">
        <h2 class="font-montserrat text-sm font-bold text-[#171717]">{{t 'test.quizStart.questionGrid'}}</h2>

        <div class="mt-3 grid grid-cols-5 gap-2">
          {{#each pertanyaan}}
            <button
              type="button"
              @click="currentQuestion = {{@index}}"
              :aria-current="currentQuestion === {{@index}} ? 'true' : 'false'"
              class="grid h-9 cursor-pointer place-items-center rounded-lg border font-inter text-sm font-semibold transition-colors"
              :class="currentQuestion === {{@index}}
                ? 'border-[#003060] bg-[#003060] text-white'
                : (isAnswered({{@index}})
                  ? 'border-[#BBF7D0] bg-[#F0FDF4] text-[#15803D]'
                  : 'border-[#E5E5E5] bg-white text-[#737373] hover:border-[#D4D4D4]')"
            >{{addOne @index}}</button>
          {{/each}}
        </div>

        <ul class="mt-4 space-y-1.5 border-t border-[#F0F0F0] pt-3">
          <li class="flex items-center gap-2 font-inter text-xs text-[#737373]">
            <span class="size-2.5 shrink-0 rounded-[3px] bg-[#003060]"></span>{{t 'test.quizStart.legendActive'}}
          </li>
          <li class="flex items-center gap-2 font-inter text-xs text-[#737373]">
            <span class="size-2.5 shrink-0 rounded-[3px] border border-[#BBF7D0] bg-[#F0FDF4]"></span>{{t 'test.quizStart.legendAnswered'}}
          </li>
          <li class="flex items-center gap-2 font-inter text-xs text-[#737373]">
            <span class="size-2.5 shrink-0 rounded-[3px] border border-[#E5E5E5] bg-white"></span>{{t 'test.quizStart.legendUnanswered'}}
          </li>
        </ul>
      </div>

      <div class="rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]">
        <h2 class="font-montserrat text-sm font-bold text-[#171717]">{{t 'test.quizStart.instructions'}}</h2>
        <ol class="mt-3 space-y-2.5">
          {{#each (array (t 'test.quizStart.rule1') (t 'test.quizStart.rule2') (t 'test.quizStart.rule3') (t 'test.quizStart.rule4'))}}
            <li class="flex gap-2.5">
              <span class="grid size-5 shrink-0 place-items-center rounded-full bg-[#E4F1F7] font-inter text-[0.65rem] font-bold text-[#003060]">{{addOne @index}}</span>
              <span class="font-inter text-xs leading-relaxed text-[#737373]">{{this}}</span>
            </li>
          {{/each}}
        </ol>
      </div>
    </div>

  </div>
</form>
