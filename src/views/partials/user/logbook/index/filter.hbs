    <!-- Filter & Actions -->
    <div class='bg-white rounded-xl shadow-sm border border-[#E5E5E5] p-6 mb-6'>
      <div class='grid grid-cols-1 lg:grid-cols-2 gap-6'>
        <!-- Left: Search & Filters -->
        <div class='space-y-4'>
          <!-- Search -->
          <div class='relative'>
            <input
              type='text'
              placeholder='{{t "test.logbook.logbookList.placeholderSearch"}}'
              x-model='searchInput'
              @input='debounceSearch()'
              class='w-full border border-[#D4D4D4] bg-white text-gray-900 rounded-lg px-4 py-3 pl-11 focus:outline-none focus:ring-2 focus:ring-slate-600 focus:border-transparent transition-all'
            />
            <i
              class='fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-[#A3A3A3]'
            ></i>
          </div>

        </div>

        <!-- Right: Export Button -->
        <div class='flex items-end justify-end'>
          <button
            type='button'
            @click='exportToExcel()'
            class='box-border w-[122px] shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#16A34A] border border-[#86EFAC] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] rounded-[8px] hover:bg-[#15803D] transition-colors cursor-pointer'
          >
            <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#FFFFFF' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[20px] h-[20px] shrink-0'><path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'/><polyline points='7 10 12 15 17 10'/><line x1='12' x2='12' y1='15' y2='3'/></svg>
            <span class='text-[16px]/[normal] text-[#FFFFFF] font-inter font-semibold whitespace-nowrap'>Export</span>
          </button>
        </div>
      </div>

      <!-- Active Filters Info -->
      <div
        x-show='hasActiveFilters()'
        class='mt-4 pt-4 border-t border-[#E5E5E5]'
        x-transition:enter='transition ease-out duration-200'
        x-transition:enter-start='opacity-0 -translate-y-2'
        x-transition:enter-end='opacity-100 translate-y-0'
      >
        <div class='flex flex-wrap items-center gap-2 text-sm'>
          <div class='flex items-center gap-2 text-[#525252] font-semibold'>
            <i class='fas fa-filter'></i>
            <span>{{t 'test.logbook.logbookList.ActiveFilters'}}</span>
          </div>
          <span
            x-show='search'
            class='px-3 py-1.5 bg-slate-100 border border-[#D4D4D4] rounded-full text-[#404040] font-medium flex items-center gap-1'
          >
            <i class='fas fa-search text-xs'></i>
            <span x-text='search'></span>
          </span>
        </div>
      </div>
    </div>
