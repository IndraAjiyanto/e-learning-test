    <!-- Loading Skeleton -->
    <div
      x-show='false'
      class='bg-white rounded-xl shadow-sm border border-[#E5E5E5] overflow-hidden'
    >
      <div class='overflow-x-auto'>
        <table class='min-w-full divide-y divide-gray-200'>
          <thead class='bg-gray-100'>
            <tr>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-[#404040]'
              >{{t 'test.logbook.logbookList.no'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-[#404040]'
              >{{t 'test.logbook.logbookList.activity'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-[#404040]'
              >{{t 'test.logbook.logbookList.details'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-[#404040]'
              >{{t 'test.logbook.logbookList.issues'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-[#404040]'
              >{{t 'test.logbook.logbookList.documentation'}}
              </th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-[#404040]'
              >{{t 'test.logbook.logbookList.program'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-[#404040]'
              >{{t 'test.logbook.logbookList.status'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-[#404040]'
              >{{t 'test.logbook.logbookList.date'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-[#404040]'
              >{{t 'test.logbook.logbookList.action'}}</th>
            </tr>
          </thead>
          <tbody class='divide-y divide-gray-200'>
            <template x-for='i in itemsPerPage' :key='i'>
              <tr class='animate-pulse'>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-8'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-32'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-48'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-32'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='w-16 h-16 bg-gray-200 rounded'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-24'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-6 bg-gray-200 rounded w-20'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-28'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-16'
                  ></div></td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Data Table -->
    <div
      x-show='true'
      class='bg-white rounded-xl shadow-sm border border-[#E5E5E5] overflow-hidden'
    >

      <div class='overflow-x-auto'>
        <table class='min-w-full divide-y divide-gray-200'>
          <thead class='bg-[#FAFAFA]'>
            <tr>
              <th
                class='px-6 py-3 text-left text-sm font-bold text-[#404040] uppercase tracking-wider'
              >{{t 'test.logbook.logbookList.no'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-bold text-[#404040] uppercase tracking-wider'
              >{{t 'test.logbook.logbookList.activity'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-bold text-[#404040] uppercase tracking-wider'
              >{{t 'test.logbook.logbookList.details'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-bold text-[#404040] uppercase tracking-wider'
              >{{t 'test.logbook.logbookList.issues'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-bold text-[#404040] uppercase tracking-wider'
              >{{t 'test.logbook.logbookList.documentation'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-bold text-[#404040] uppercase tracking-wider'
              >{{t 'test.logbook.logbookList.program'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-bold text-[#404040] uppercase tracking-wider'
              >{{t 'test.logbook.logbookList.status'}}</th>
              <th
                class='px-6 py-3 text-left text-sm font-bold text-[#404040] uppercase tracking-wider'
              >{{t 'test.logbook.logbookList.date'}}</th>
            </tr>
          </thead>
          <tbody class='divide-y divide-gray-200 bg-white'>
            <template
              x-for='(logbook, index) in paginatedLogbooks'
              :key='logbook.id'
            >
              <tr class='hover:bg-[#FAFAFA] transition-colors'>
                <td
                  class='px-6 py-4 text-sm font-medium text-gray-900'
                  x-text='((currentPage - 1) * itemsPerPage) + index + 1'
                ></td>
                <td
                  class='px-6 py-4 text-sm font-semibold text-gray-900'
                  x-text='logbook.activity || "-"'
                ></td>
                <td class='px-6 py-4 text-sm text-[#404040]'>
                  <div
                    class='max-w-xs truncate'
                    :title='logbook.activityDetails'
                    x-text='logbook.activityDetails || "-"'
                  ></div>
                </td>
                <td class='px-6 py-4 text-sm text-[#404040]'>
                  <div
                    class='max-w-xs truncate'
                    :title='logbook.obstacles'
                    x-text='logbook.obstacles || "-"'
                  ></div>
                </td>
                <td class='px-6 py-4'>
                  <img
                    :src='logbook.documentation'
                    alt='Documentation'
                    class='w-16 h-16 object-cover rounded-lg border border-[#E5E5E5] cursor-pointer hover:border-[#D4D4D4] transition-all'
                    @click="window.open(logbook.documentation, '_blank')"
                  />
                </td>
                <td class='px-6 py-4'>
                  <span
                    class='inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-[#404040] border border-[#D4D4D4]'
                  >
                    <i class='fas fa-graduation-cap mr-1 text-sm'></i>
                    <span
                      x-text='logbook.session?.weeks?.course?.name || "-"'
                    ></span>
                  </span>
                </td>
                <td class='px-6 py-4'>
                  <span
                    class='inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide'
                    :class="{
                      'bg-[#f0fdf4] text-[#15803d] border border-[#bbf7d0]': logbook.process === 'approved',
                      'bg-[#FEFCE8] text-[#A16207] border border-[#FEF08A]': logbook.process === 'process',
                      'bg-[#FEF2F2] text-[#B42318] border border-[#FECACA]': logbook.process === 'rejected'
                    }"
                  >
                    <i
                      class='fas mr-1 text-sm'
                      :class="{
                      'fa-check-circle': logbook.process === 'approved',
                      'fa-clock': logbook.process === 'process',
                      'fa-times-circle': logbook.process === 'rejected'
                    }"
                    ></i>
                    <span
                      x-text="logbook.process === 'approved' ? 'Approved' : logbook.process === 'process' ? 'Process' : 'Rejected'"
                    ></span>
                  </span>
                </td>
                <td
                  class='px-6 py-4 text-sm text-[#404040]'
                  x-text='formatDate(logbook.createdAt)'
                ></td>

              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- No Data -->
      <div x-show='filteredLogbooks.length === 0' class='text-center py-16'>
        <div
          class='w-24 h-24 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4'
        >
          <i class='fas fa-clipboard-list text-[#A3A3A3] text-4xl'></i>
        </div>
        <h3 class='text-xl font-bold text-gray-900 mb-2 font-inter'>{{t
            'test.logbook.logbookList.noLogbookFound'
          }}</h3>
        <p class='text-[#525252] mb-6 max-w-md mx-auto'>
          {{t 'test.logbook.logbookList.noLogBookDataMatch'}}
        </p>
        <button
          @click='resetFilters()'
          class='bg-[#003060] hover:bg-[#00254a] text-white px-8 py-3 rounded-lg transition-all shadow-md .5 font-semibold'
        >
          <i class='fas fa-undo-alt mr-2'></i>
          {{t 'test.logbook.logbookList.resetFilters'}}
        </button>
      </div>
    </div>

    <!-- Pagination -->
    <div
      class='flex justify-center items-center gap-4 mt-12'
      x-show='totalPages > 1'
    >
      <button
        @click='currentPage = Math.max(1, currentPage - 1)'
        :disabled='currentPage === 1'
        class='px-5 py-3 bg-white border border-[#D4D4D4] hover:bg-[#FAFAFA] text-[#404040] rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all shadow-sm'
      >
        <i class='fas fa-chevron-left'></i>
      </button>

      <template x-for='page in totalPages' :key='page'>
        <button
          @click='currentPage = page'
          class='w-12 h-12 rounded-xl text-lg font-semibold transition-all border shadow-sm'
          :class="currentPage === page ? 'bg-[#003060] text-white border-[#003060]' : 'bg-white text-[#404040] border-[#D4D4D4] hover:bg-[#FAFAFA]'"
          x-text='page'
        ></button>
      </template>

      <button
        @click='currentPage = Math.min(totalPages, currentPage + 1)'
        :disabled='currentPage === totalPages'
        class='px-5 py-3 bg-white border border-[#D4D4D4] hover:bg-[#FAFAFA] text-[#404040] rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all shadow-sm'
      >
        <i class='fas fa-chevron-right'></i>
      </button>
    </div>