
    <div x-show="mainTab === 'pembayaran'" x-transition>
      {{#if pembayaran.length}}
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
          {{#each pembayaran}}
            <div 
              x-show="statusTab === 'all' 
                || (statusTab === 'acc' && '{{this.proses}}' === 'acc') 
                || (statusTab === 'proces' && '{{this.proses}}' === 'proces') 
                || (statusTab === 'rejected' && '{{this.proses}}' === 'rejected')"
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 transform scale-95"
              x-transition:enter-end="opacity-100 transform scale-100"
              class="group relative rounded-2xl shadow-lg overflow-hidden border transition-all duration-300 transform hover:scale-105 hover:shadow-2xl
                {{#if (roles this.proses 'acc')}} bg-gradient-to-br from-emerald-50 to-emerald-100 border-emerald-200 hover:from-emerald-100 hover:to-emerald-200
                {{else if (roles this.proses 'proces')}} bg-gradient-to-br from-amber-50 to-orange-100 border-amber-200 hover:from-amber-100 hover:to-orange-200
                {{else}} bg-gradient-to-br from-red-50 to-red-100 border-red-200 hover:from-red-100 hover:to-red-200 {{/if}}">

              <div class="absolute top-4 right-4 z-10">
                {{#if (roles this.proses 'acc')}}
                  <div class="bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-2 md:px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1">
                    <i class="fas fa-check"></i>
                    <span class="hidden sm:inline">{{t "test.historyPayment.fullPayment.accepted"}}</span>
                    <span class="sm:hidden">{{ t "test.historyPayment.fullPayment.acc"}}</span>
                  </div>
                {{else if (roles this.proses 'proces')}}
                  <div class="bg-gradient-to-r from-amber-500 to-orange-600 text-white px-2 md:px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1">
                    <i class="fas fa-clock"></i>
                    <span class="hidden sm:inline">{{ t "test.historyPayment.fullPayment.processing"}}</span>
                    <span class="sm:hidden">{{ t "test.historyPayment.fullPayment.proc"}}</span>
                  </div>
                {{else}}
                  <div class="bg-gradient-to-r from-red-500 to-red-600 text-white px-2 md:px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1">
                    <i class="fas fa-times"></i>
                    <span class="hidden sm:inline">{{ t "test.historyPayment.fullPayment.rejected"}}</span>
                    <span class="sm:hidden">{{ t "test.historyPayment.fullPayment.rej"}}</span>
                  </div>
                {{/if}}
              </div>

              <div class="p-4 md:p-6 lg:p-8 space-y-4 md:space-y-6">
                <div class="space-y-2 md:space-y-3">
                  <div class="bg-secondary text-white px-3 py-1 rounded-lg inline-flex items-center gap-2 text-xs font-semibold mb-2">
                    <i class="fas fa-credit-card"></i>
                    <span>{{ t "test.historyPayment.fullPayment.fullPayment"}}</span>
                  </div>
                  
                  <h3 class="text-lg md:text-xl font-bold text-slate-900 group-hover:text-slate-800 transition-colors font-montserrat line-clamp-2">
                    <i class="fas fa-graduation-cap mr-2 text-slate-600 text-sm md:text-base"></i>
                    {{this.kelas.nama_kelas}}
                  </h3>
                  
                  <div class="flex items-center text-slate-600 text-xs md:text-sm ">
                    <i class="fas fa-calendar-alt mr-2"></i>
                    <span class="font-medium">{{ t "test.historyPayment.fullPayment.paymentDate"}}</span>
                    <span class="ml-2">{{formatTanggal this.createdAt lang}} </span>
                  </div>

                  <div class="flex items-center text-xs md:text-sm">
                    <i class="fas fa-info-circle mr-2 text-slate-500"></i>
                    <span class="font-medium text-slate-700">{{ t "test.historyPayment.fullPayment.status"}}</span>
                    {{#if (roles this.proses 'acc')}}
                      <span class="ml-2 text-emerald-700 font-bold">{{ t "test.historyPayment.fullPayment.accepted"}}</span>
                    {{else if (roles this.proses 'proces')}}
                      <span class="ml-2 text-amber-700 font-bold">{{ t "test.historyPayment.fullPayment.processing"}}</span>
                    {{else}}
                      <span class="ml-2 text-red-700 font-bold">{{ t "test.historyPayment.fullPayment.rejected"}}</span>
                    {{/if}}
                  </div>
                </div>

                <!-- WhatsApp Contact for Processing and Rejected -->
                {{#if (roles this.proses 'proces')}}
                  <div class="bg-amber-100 border border-amber-300 rounded-xl p-3 md:p-4 space-y-2">
                    <div class="flex items-center gap-2 text-amber-800 font-semibold text-xs md:text-sm">
                      <i class="fas fa-info-circle"></i>
                      <span>{{ t "test.historyPayment.fullPayment.paymentUnderReview"}}</span>
                    </div>
                    <p class="text-amber-700 text-xs md:text-sm">{{ t "test.historyPayment.fullPayment.spanPaymentUnderReview"}}</p>
                    <a 
                      href="https://wa.me/6281234567890?text=Hi,%20I%20have%20a%20question%20about%20my%20payment%20for%20{{this.kelas.nama_kelas}}" 
                      target="_blank"
                      class="flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white px-3 md:px-4 py-2 rounded-lg font-semibold text-xs md:text-sm transition-all duration-300 transform hover:scale-105 shadow-md w-full justify-center">
                      <i class="fab fa-whatsapp text-base md:text-lg"></i>
                      <span>{{ t "test.historyPayment.fullPayment.contactAdmin"}}</span>
                    </a>
                  </div>
                {{else if (roles this.proses 'rejected')}}
                  <div class="bg-red-100 border border-red-300 rounded-xl p-3 md:p-4 space-y-2">
                    <div class="flex items-center gap-2 text-red-800 font-semibold text-xs md:text-sm">
                      <i class="fas fa-exclamation-triangle"></i>
                      <span>{{ t "test.historyPayment.fullPayment.paymentRejected"}}</span>
                    </div>
                    <p class="text-red-700 text-xs md:text-sm">{{ t "test.historyPayment.fullPayment.spanPaymentRejected"}}</p>
                    <a 
                      href="https://wa.me/6281234567890?text=Hi,%20my%20payment%20for%20{{this.kelas.nama_kelas}}%20was%20rejected.%20I%20need%20help." 
                      target="_blank"
                      class="flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white px-3 md:px-4 py-2 rounded-lg font-semibold text-xs md:text-sm transition-all duration-300 transform hover:scale-105 shadow-md w-full justify-center">
                      <i class="fab fa-whatsapp text-base md:text-lg"></i>
                      <span>{{ t "test.historyPayment.fullPayment.contactAdmin"}}</span>
                    </a>
                  </div>
                {{/if}}

                <div class="flex flex-col sm:flex-row gap-2 md:gap-3 pt-4 md:pt-6">
                  <button 
                    @click="open = true; imageSrc = '{{this.file}}'" 
                    class="flex-1 py-2.5 md:py-3 px-3 md:px-4 rounded-xl bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white font-semibold text-xs md:text-sm transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                    <i class="fas fa-eye"></i>
                    <span>{{t "test.historyPayment.fullPayment.viewProof"}}</span>
                  </button>
                  <a 
                    href="/program/{{this.kelas.id}}" 
                    class="flex-1 py-2.5 md:py-3 px-3 md:px-4 rounded-xl bg-white text-slate-800 border-2 border-slate-200 font-semibold text-xs md:text-sm hover:bg-slate-50 hover:border-slate-300 transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                    <i class="fas fa-external-link-alt"></i>
                    <span>{{t "test.historyPayment.fullPayment.viewProgram"}}</span>
                  </a>
                </div>
              </div>

              <div class="absolute inset-0 bg-gradient-to-t from-black/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="text-center py-12 md:py-16 px-4">
          <div class="p-8 md:p-12 max-w-md mx-auto">
            <i class="fas fa-receipt text-5xl md:text-6xl text-slate-400 mb-4 md:mb-6"></i>
            <h3 class="text-lg md:text-xl font-bold text-slate-700 mb-2 md:mb-3 font-montserrat">{{t "test.historyPayment.fullPayment.noFullPayment"}}</h3>
            <p class="text-sm md:text-base text-slate-600 ">{{t "test.historyPayment.fullPayment.spanNoFullPayment"}}</p>
          </div>
        </div>
      {{/if}}
    </div>