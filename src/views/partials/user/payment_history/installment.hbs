<div x-show="mainTab === 'installments'" x-transition>

  <div x-show="loading.installments" class="flex justify-center py-16">
    <div class="flex flex-col items-center gap-4 text-slate-500">
      <i class="fas fa-spinner fa-spin text-4xl text-blue-600"></i>
      <p class="font-semibold">Loading...</p>
    </div>
  </div>

  <div x-show="!loading.installments">

    <div x-show="installments.length > 0">
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
        <template x-for="item in installments" :key="item.id">
          <div
            x-show="statusTab === 'all'
              || (statusTab === 'acc' && item.process === 'acc')
              || (statusTab === 'proces' && item.process === 'proces')
              || (statusTab === 'rejected' && item.process === 'rejected')"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 transform scale-95"
            x-transition:enter-end="opacity-100 transform scale-100"
            :class="{
              'bg-gradient-to-br from-emerald-50 to-emerald-100 border-emerald-200 hover:from-emerald-100 hover:to-emerald-200': item.process === 'acc',
              'bg-gradient-to-br from-amber-50 to-orange-100 border-amber-200 hover:from-amber-100 hover:to-orange-200': item.process === 'proces',
              'bg-gradient-to-br from-red-50 to-red-100 border-red-200 hover:from-red-100 hover:to-red-200': item.process !== 'acc' && item.process !== 'proces'
            }"
            class="group relative rounded-2xl shadow-lg overflow-hidden border transition-all duration-300 transform hover:scale-105 hover:shadow-2xl">

            <div class="absolute top-4 right-4 z-10">
              <div x-show="item.process === 'acc'"
                class="bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-2 md:px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1">
                <i class="fas fa-check"></i>
                <span class="hidden sm:inline">{{t "test.historyPayment.installment.accepted"}}</span>
                <span class="sm:hidden">{{t "test.historyPayment.installment.acc"}}</span>
              </div>
              <div x-show="item.process === 'proces'"
                class="bg-gradient-to-r from-amber-500 to-orange-600 text-white px-2 md:px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1">
                <i class="fas fa-clock"></i>
                <span class="hidden sm:inline">{{t "test.historyPayment.installment.processing"}}</span>
                <span class="sm:hidden">{{t "test.historyPayment.installment.proc"}}</span>
              </div>
              <div x-show="item.process !== 'acc' && item.process !== 'proces'"
                class="bg-gradient-to-r from-red-500 to-red-600 text-white px-2 md:px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1">
                <i class="fas fa-times"></i>
                <span class="hidden sm:inline">{{t "test.historyPayment.installment.rejected"}}</span>
                <span class="sm:hidden">{{t "test.historyPayment.installment.rej"}}</span>
              </div>
            </div>

            <div class="p-4 md:p-6 lg:p-8 space-y-4 md:space-y-6">
              <div class="space-y-2 md:space-y-3">
                <div class="bg-blue-600 text-white px-3 py-1 rounded-lg inline-flex items-center gap-2 text-xs font-semibold mb-2">
                  <i class="fas fa-calendar-check"></i>
                  <span>{{t "test.historyPayment.installment.installment"}}</span>
                </div>

                <h3 class="text-lg md:text-xl font-bold text-slate-900 group-hover:text-slate-800 transition-colors font-montserrat line-clamp-2">
                  <i class="fas fa-graduation-cap mr-2 text-slate-600 text-sm md:text-base"></i>
                  <span x-text="item.course.name"></span>
                </h3>

                <div class="flex items-center text-slate-600 text-xs md:text-sm">
                  <i class="fas fa-calendar-alt mr-2"></i>
                  <span class="font-medium">{{t "test.historyPayment.installment.paymentDate"}}</span>
                  <span class="ml-2" x-text="new Date(item.createdAt).toLocaleDateString()"></span>
                </div>

                <div class="flex items-center text-xs md:text-sm">
                  <i class="fas fa-money-bill-wave mr-2 text-blue-600"></i>
                  <span class="font-medium text-slate-700">{{t "test.historyPayment.installment.installmentMenu"}}</span>
                  <span class="ml-2 text-blue-700 font-bold" x-text="item.installments.name"></span>
                </div>

                <div class="flex items-center text-xs md:text-sm">
                  <i class="fas fa-info-circle mr-2 text-slate-500"></i>
                  <span class="font-medium text-slate-700">{{t "test.historyPayment.installment.status"}}</span>
                  <span x-show="item.process === 'acc'" class="ml-2 text-emerald-700 font-bold">{{t "test.historyPayment.installment.accepted"}}</span>
                  <span x-show="item.process === 'proces'" class="ml-2 text-amber-700 font-bold">{{t "test.historyPayment.installment.processing"}}</span>
                  <span x-show="item.process !== 'acc' && item.process !== 'proces'" class="ml-2 text-red-700 font-bold">{{t "test.historyPayment.installment.rejected"}}</span>
                </div>
              </div>

              <div x-show="item.process === 'proces'" class="bg-amber-100 border border-amber-300 rounded-xl p-3 md:p-4 space-y-2">
                <div class="flex items-center gap-2 text-amber-800 font-semibold text-xs md:text-sm">
                  <i class="fas fa-info-circle"></i>
                  <span>{{t "test.historyPayment.installment.paymentUnderReview"}}</span>
                </div>
                <p class="text-amber-700 text-xs md:text-sm">{{t "test.historyPayment.installment.spanPaymentUnderReview"}}</p>
                <a :href="`https://wa.me/6281234567890?text=Hi,%20I%20have%20a%20question%20about%20my%20installment%20payment%20for%20${item.course.name}`"
                  target="_blank"
                  class="flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white px-3 md:px-4 py-2 rounded-lg font-semibold text-xs md:text-sm transition-all duration-300 transform hover:scale-105 shadow-md w-full justify-center">
                  <i class="fab fa-whatsapp text-base md:text-lg"></i>
                  <span>{{t "test.historyPayment.installment.contactAdminWhatsApp"}}</span>
                </a>
              </div>

              <div x-show="item.process !== 'acc' && item.process !== 'proces'" class="bg-red-100 border border-red-300 rounded-xl p-3 md:p-4 space-y-2">
                <div class="flex items-center gap-2 text-red-800 font-semibold text-xs md:text-sm">
                  <i class="fas fa-exclamation-triangle"></i>
                  <span>{{t "test.historyPayment.installment.paymentRejected"}}</span>
                </div>
                <p class="text-red-700 text-xs md:text-sm">{{t "test.historyPayment.installment.spanPaymentRejected"}}</p>
                <a :href="`https://wa.me/6281234567890?text=Hi,%20my%20installment%20payment%20for%20${item.course.name}%20was%20rejected.%20I%20need%20help.`"
                  target="_blank"
                  class="flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white px-3 md:px-4 py-2 rounded-lg font-semibold text-xs md:text-sm transition-all duration-300 transform hover:scale-105 shadow-md w-full justify-center">
                  <i class="fab fa-whatsapp text-base md:text-lg"></i>
                  <span>{{t "test.historyPayment.installment.contactAdmin"}}</span>
                </a>
              </div>

              <div class="flex flex-col sm:flex-row gap-2 md:gap-3 pt-4 md:pt-6">
                <button @click="open = true; imageSrc = item.file"
                  class="flex-1 py-2.5 md:py-3 px-3 md:px-4 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-700 text-white font-semibold text-xs md:text-sm hover:from-blue-700 hover:to-indigo-800 transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                  <i class="fas fa-eye"></i>
                  <span>{{t "test.historyPayment.installment.viewProof"}}</span>
                </button>
                <a :href="`/program/${item.course.id}`"
                  class="flex-1 py-2.5 md:py-3 px-3 md:px-4 rounded-xl bg-white text-slate-800 border-2 border-slate-200 font-semibold text-xs md:text-sm hover:bg-slate-50 hover:border-slate-300 transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                  <i class="fas fa-external-link-alt"></i>
                  <span>{{t "test.historyPayment.installment.viewProgram"}}</span>
                </a>
              </div>
            </div>

            <div class="absolute inset-0 bg-gradient-to-t from-black/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
          </div>
        </template>
      </div>
    </div>

    <div x-show="installments.length === 0" class="text-center py-12 md:py-16 px-4">
      <div class="p-8 md:p-12 max-w-md mx-auto">
        <i class="fas fa-calendar-check text-5xl md:text-6xl text-blue-400 mb-4 md:mb-6"></i>
        <h3 class="text-lg md:text-xl font-bold text-slate-700 mb-2 md:mb-3 font-montserrat">{{t "test.historyPayment.installment.noInstallment"}}</h3>
        <p class="text-sm md:text-base text-slate-600">{{t "test.historyPayment.installment.spanNoInstallment"}}</p>
      </div>
    </div>

  </div>
</div>