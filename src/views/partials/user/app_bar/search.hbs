{{!--
  Komponen: Global Search (User area)
  Lokasi: src/views/partials/user/app_bar/search.hbs
  Level: L2 Section Component

  Pencarian personal terisolasi khusus dashboard pengguna yang sedang login:
  Hanya menampilkan program/kelas yang diikuti, materi/sesi belajar, portofolio,
  riwayat pembayaran, dan menu dashboard milik user tersebut.
  Semua teks menggunakan i18n (Indonesian, English, Japanese).
--}}
<div
  x-data="globalSearch()"
  @keydown.escape.window="closeSearch()"
  @click.outside="closeSearch()"
  class="relative flex items-center justify-center ml-auto mr-1 sm:ml-0 sm:mr-0 sm:flex-1 max-w-[420px] transition-all"
  :class="{ 'sm:max-w-[480px] lg:max-w-[540px] z-50': isOpen }"
>
  {{!-- 1. Mobile Search Trigger Button (< sm) --}}
  <button
    type="button"
    @click="openMobileSearch()"
    class="flex size-9 shrink-0 items-center justify-center rounded-lg text-[#003060] hover:bg-[#F4F7FC] sm:hidden"
    aria-label="{{default (t 'test.userSearch.openSearch') 'Open search'}}"
  >
    <i class="fas fa-magnifying-glass text-sm"></i>
  </button>

  {{!-- 2. Mobile Fullscreen / Fixed Top Search Bar Overlay (< sm) --}}
  <div
    x-show="isMobileSearchOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    class="fixed inset-x-0 top-0 z-50 flex h-16 items-center gap-3 border-b border-[#D9D9D9] bg-white px-4 shadow-sm sm:hidden"
    x-cloak
  >
    <button
      type="button"
      @click="closeSearch()"
      class="grid size-9 shrink-0 place-items-center rounded-lg text-[#003060] hover:bg-[#F4F7FC]"
      aria-label="{{default (t 'test.userSearch.back') 'Back'}}"
    >
      <i class="fas fa-arrow-left text-sm"></i>
    </button>

    <div class="relative flex flex-1 items-center gap-2 rounded-full border border-[#003060] bg-[#F4F7FC] px-3.5 py-1.5 ring-2 ring-[#003060]/10">
      <i class="fas fa-magnifying-glass text-xs text-[#003060] shrink-0"></i>
      <input
        x-ref="mobileSearchInput"
        type="text"
        x-model="query"
        @input.debounce.250ms="fetchResults()"
        @keydown.enter.prevent="selectHighlightedOrFirst()"
        @keydown.arrow-down.prevent="navigateHighlight(1)"
        @keydown.arrow-up.prevent="navigateHighlight(-1)"
        placeholder="{{default (t 'test.userSearch.mobilePlaceholder') 'Cari di dashboard Anda...'}}"
        class="w-full bg-transparent font-inter text-xs text-[#1F2937] placeholder:text-[#718096] focus:outline-none"
      />
      <template x-if="isLoading">
        <i class="fas fa-circle-notch fa-spin text-xs text-[#003060] shrink-0"></i>
      </template>
      <button
        type="button"
        x-show="query.length > 0 && !isLoading"
        @click="clearQuery()"
        class="flex size-4 shrink-0 items-center justify-center rounded-full text-[#94A3B8] hover:text-[#475569]"
        aria-label="{{default (t 'test.userSearch.clearSearch') 'Clear search'}}"
      >
        <i class="fas fa-xmark text-[10px]"></i>
      </button>
    </div>
  </div>

  {{!-- 3. Backdrop Overlay --}}
  <div
    x-show="isOpen && (query.trim().length > 0 || hasSearched)"
    x-transition:enter="transition-opacity ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition-opacity ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="closeSearch()"
    class="fixed inset-0 top-16 lg:top-[72px] z-40 bg-black/25 backdrop-blur-[1px]"
    x-cloak
  ></div>

  {{!-- 4. Desktop Input Box (>= sm) --}}
  <div
    class="relative z-50 hidden sm:flex w-full items-center gap-2.5 rounded-full border border-[#D9D9D9] bg-[#F4F7FC] px-4 py-2 transition-all shadow-sm"
    :class="{ 'bg-white border-[#003060] ring-2 ring-[#003060]/10 shadow-md': isOpen }"
  >
    <i class="fas fa-magnifying-glass text-xs text-[#718096] shrink-0" :class="{ 'text-[#003060]': isOpen }"></i>

    <input
      x-ref="searchInput"
      type="text"
      x-model="query"
      @focus="openSearch()"
      @input.debounce.250ms="fetchResults()"
      @keydown.enter.prevent="selectHighlightedOrFirst()"
      @keydown.arrow-down.prevent="navigateHighlight(1)"
      @keydown.arrow-up.prevent="navigateHighlight(-1)"
      placeholder="{{default (t 'test.userSearch.placeholder') 'Cari program, materi, atau aktivitas saya...'}}"
      class="w-full bg-transparent font-inter text-xs text-[#1F2937] placeholder:text-[#718096] focus:outline-none"
    />

    {{!-- Spinner Loading --}}
    <template x-if="isLoading">
      <i class="fas fa-circle-notch fa-spin text-xs text-[#003060] shrink-0"></i>
    </template>

    {{!-- Clear Button --}}
    <button
      type="button"
      x-show="query.length > 0 && !isLoading"
      @click="clearQuery()"
      class="flex size-4 shrink-0 items-center justify-center rounded-full text-[#94A3B8] hover:bg-[#E2E8F0] hover:text-[#475569] transition-colors cursor-pointer"
      aria-label="{{default (t 'test.userSearch.clearSearch') 'Clear search'}}"
      x-cloak
    >
      <i class="fas fa-xmark text-[10px]"></i>
    </button>
  </div>

  {{!-- 5. Sticky Floating Popup Dropdown --}}
  <div
    x-show="isOpen && query.trim().length > 0"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 translate-y-1 scale-[0.99]"
    x-transition:enter-end="opacity-100 translate-y-0 scale-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0 scale-100"
    x-transition:leave-end="opacity-0 translate-y-1 scale-[0.99]"
    class="z-50 rounded-2xl border border-[#E2E8F0] bg-white shadow-[0px_20px_40px_rgba(0,0,0,0.12),0px_1px_3px_rgba(0,0,0,0.05)] overflow-hidden"
    :class="isMobileSearchOpen ? 'fixed inset-x-3 top-[72px] sm:static sm:w-[480px] lg:w-[540px]' : 'absolute left-1/2 -translate-x-1/2 top-full mt-2 w-[calc(100vw-32px)] sm:w-[480px] lg:w-[540px]'"
    x-cloak
  >
    <div class="max-h-[min(520px,calc(100vh-140px))] overflow-y-auto divide-y divide-[#F1F5F9]">

      {{!-- Loading state skeleton --}}
      <template x-if="isLoading && !hasSearched">
        <div class="p-8 flex flex-col items-center justify-center gap-2.5 text-center">
          <i class="fas fa-circle-notch fa-spin text-xl text-[#003060]"></i>
          <p class="font-inter text-xs text-[#64748B]">{{default (t 'test.userSearch.loading') 'Mencari data dashboard...'}}</p>
        </div>
      </template>

      {{!-- EMPTY STATE --}}
      <template x-if="!isLoading && hasSearched && totalResults === 0">
        <div class="py-10 px-6 flex flex-col items-center justify-center text-center">
          <div class="size-12 rounded-full bg-[#E4F1F7] flex items-center justify-center text-[#003060] mb-3">
            <i class="fas fa-magnifying-glass text-lg"></i>
          </div>
          <h4 class="font-inter font-semibold text-sm text-[#1E293B] mb-1">
            {{default (t 'test.userSearch.noResultsTitle') 'Tidak ada data ditemukan untuk'}} "<span class="text-[#003060]" x-text="query"></span>"
          </h4>
          <p class="font-inter text-xs text-[#64748B] max-w-[320px]">
            {{default (t 'test.userSearch.noResultsDesc') 'Hanya menampilkan program, sesi belajar, portofolio, dan transaksi yang terdaftar pada dashboard Anda.'}}
          </p>
        </div>
      </template>

      {{!-- 1. CATEGORY: PROGRAM SAYA --}}
      <template x-if="programs.length > 0">
        <div class="p-3">
          <div class="flex items-center justify-between px-3 py-1.5 mb-1">
            <div class="flex items-center gap-2 text-[#003060]">
              <i class="fa-solid fa-layer-group text-xs"></i>
              <span class="font-inter font-semibold text-xs tracking-wide text-[#003060]">{{default (t 'test.userSearch.categoryPrograms') 'Program Saya'}}</span>
            </div>
            <span class="rounded-full bg-[#E4F1F7] px-2 py-0.5 font-inter text-[11px] font-semibold text-[#003060]" x-text="programs.length"></span>
          </div>

          <div class="space-y-1">
            <template x-for="item in programs" :key="item.id || item.title">
              <a
                :href="item.url"
                @click="onItemClick($event, item)"
                class="group flex items-center gap-3.5 rounded-xl px-3 py-2 transition-colors hover:bg-[#F4F7FC]"
                :class="{ 'bg-[#F4F7FC] ring-1 ring-[#003060]/20': isHighlighted(item) }"
              >
                <div class="size-10 rounded-lg overflow-hidden shrink-0 bg-[#E4F1F7] border border-[#D0E2EC] flex items-center justify-center">
                  <template x-if="item.image">
                    <img
                      :src="item.image"
                      :alt="item.title"
                      class="size-full object-cover"
                      @error="$el.style.display='none'; if ($el.nextElementSibling) $el.nextElementSibling.style.display='flex'"
                    />
                  </template>
                  <div :style="item.image ? 'display: none;' : ''" class="flex size-full items-center justify-center">
                    <i class="fa-solid fa-layer-group text-sm text-[#003060]"></i>
                  </div>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <h5 class="font-inter text-xs sm:text-sm font-semibold text-[#0F172A] group-hover:text-[#003060] truncate transition-colors" x-text="item.title"></h5>
                    <template x-if="item.badge">
                      <span
                        class="text-[10px] font-semibold px-2 py-0.5 rounded-full inline-block shrink-0"
                        :class="item.badge === 'Selesai' ? 'bg-[#DCFCE7] text-[#166534]' : 'bg-[#E0F2FE] text-[#0369A1]'"
                        x-text="translateBadge(item.badge)"
                      ></span>
                    </template>
                  </div>
                  <p class="font-inter text-[11px] text-[#64748B] truncate mt-0.5" x-text="item.subtitle"></p>
                </div>
                <i class="fa-solid fa-chevron-right text-xs text-[#94A3B8] group-hover:text-[#003060] group-hover:translate-x-0.5 transition-all shrink-0"></i>
              </a>
            </template>
          </div>
        </div>
      </template>

      {{!-- 2. CATEGORY: KURSUS / KELAS SAYA --}}
      <template x-if="courses.length > 0">
        <div class="p-3">
          <div class="flex items-center justify-between px-3 py-1.5 mb-1">
            <div class="flex items-center gap-2 text-[#003060]">
              <i class="fa-solid fa-graduation-cap text-xs"></i>
              <span class="font-inter font-semibold text-xs tracking-wide text-[#003060]">{{default (t 'test.userSearch.categoryCourses') 'Kelas Saya'}}</span>
            </div>
            <span class="rounded-full bg-[#E4F1F7] px-2 py-0.5 font-inter text-[11px] font-semibold text-[#003060]" x-text="courses.length"></span>
          </div>

          <div class="space-y-1">
            <template x-for="item in courses" :key="item.id || item.title">
              <a
                :href="item.url"
                @click="onItemClick($event, item)"
                class="group flex items-center gap-3.5 rounded-xl px-3 py-2 transition-colors hover:bg-[#F4F7FC]"
                :class="{ 'bg-[#F4F7FC] ring-1 ring-[#003060]/20': isHighlighted(item) }"
              >
                <div class="size-10 rounded-lg overflow-hidden shrink-0 bg-[#E4F1F7] border border-[#D0E2EC] flex items-center justify-center">
                  <template x-if="item.image">
                    <img
                      :src="item.image"
                      :alt="item.title"
                      class="size-full object-cover"
                      @error="$el.style.display='none'; if ($el.nextElementSibling) $el.nextElementSibling.style.display='flex'"
                    />
                  </template>
                  <div :style="item.image ? 'display: none;' : ''" class="flex size-full items-center justify-center">
                    <i class="fa-solid fa-graduation-cap text-sm text-[#003060]"></i>
                  </div>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <h5 class="font-inter text-xs sm:text-sm font-semibold text-[#0F172A] group-hover:text-[#003060] truncate transition-colors" x-text="item.title"></h5>
                    <template x-if="item.badge">
                      <span
                        class="text-[10px] font-semibold px-2 py-0.5 rounded-full inline-block shrink-0"
                        :class="item.badge === 'Selesai' ? 'bg-[#DCFCE7] text-[#166534]' : 'bg-[#E0F2FE] text-[#0369A1]'"
                        x-text="translateBadge(item.badge)"
                      ></span>
                    </template>
                  </div>
                  <p class="font-inter text-[11px] text-[#64748B] truncate mt-0.5" x-text="item.subtitle"></p>
                </div>
                <i class="fa-solid fa-chevron-right text-xs text-[#94A3B8] group-hover:text-[#003060] group-hover:translate-x-0.5 transition-all shrink-0"></i>
              </a>
            </template>
          </div>
        </div>
      </template>

      {{!-- 3. CATEGORY: MATERI & SESI BELAJAR --}}
      <template x-if="learnings.length > 0">
        <div class="p-3">
          <div class="flex items-center justify-between px-3 py-1.5 mb-1">
            <div class="flex items-center gap-2 text-[#003060]">
              <i class="fa-solid fa-book-open text-xs"></i>
              <span class="font-inter font-semibold text-xs tracking-wide text-[#003060]">{{default (t 'test.userSearch.categoryLearnings') 'Materi & Sesi Belajar'}}</span>
            </div>
            <span class="rounded-full bg-[#E4F1F7] px-2 py-0.5 font-inter text-[11px] font-semibold text-[#003060]" x-text="learnings.length"></span>
          </div>

          <div class="space-y-1">
            <template x-for="item in learnings" :key="item.id || item.title">
              <a
                :href="item.url"
                @click="onItemClick($event, item)"
                class="group flex items-center gap-3.5 rounded-xl px-3 py-2 transition-colors hover:bg-[#F4F7FC]"
                :class="{ 'bg-[#F4F7FC] ring-1 ring-[#003060]/20': isHighlighted(item) }"
              >
                <div class="size-10 rounded-lg overflow-hidden shrink-0 bg-[#E4F1F7] border border-[#D0E2EC] flex items-center justify-center">
                  <template x-if="item.image">
                    <img
                      :src="item.image"
                      :alt="item.title"
                      class="size-full object-cover"
                      @error="$el.style.display='none'; if ($el.nextElementSibling) $el.nextElementSibling.style.display='flex'"
                    />
                  </template>
                  <div :style="item.image ? 'display: none;' : ''" class="flex size-full items-center justify-center">
                    <i class="fa-solid fa-book-open text-sm text-[#003060]"></i>
                  </div>
                </div>
                <div class="min-w-0 flex-1">
                  <h5 class="font-inter text-xs sm:text-sm font-semibold text-[#0F172A] group-hover:text-[#003060] truncate transition-colors" x-text="item.title"></h5>
                  <p class="font-inter text-[11px] text-[#64748B] truncate mt-0.5" x-text="item.subtitle"></p>
                </div>
                <i class="fa-solid fa-chevron-right text-xs text-[#94A3B8] group-hover:text-[#003060] group-hover:translate-x-0.5 transition-all shrink-0"></i>
              </a>
            </template>
          </div>
        </div>
      </template>

      {{!-- 4. CATEGORY: PORTOFOLIO SAYA --}}
      <template x-if="portfolios.length > 0">
        <div class="p-3">
          <div class="flex items-center justify-between px-3 py-1.5 mb-1">
            <div class="flex items-center gap-2 text-[#7C3AED]">
              <i class="fa-solid fa-folder-open text-xs"></i>
              <span class="font-inter font-semibold text-xs tracking-wide text-[#7C3AED]">{{default (t 'test.userSearch.categoryPortfolios') 'Portofolio Saya'}}</span>
            </div>
            <span class="rounded-full bg-[#EDE9FE] px-2 py-0.5 font-inter text-[11px] font-semibold text-[#7C3AED]" x-text="portfolios.length"></span>
          </div>

          <div class="space-y-1">
            <template x-for="item in portfolios" :key="item.id || item.title">
              <a
                :href="item.url"
                @click="onItemClick($event, item)"
                class="group flex items-center gap-3.5 rounded-xl px-3 py-2 transition-colors hover:bg-[#F4F7FC]"
                :class="{ 'bg-[#F4F7FC] ring-1 ring-[#003060]/20': isHighlighted(item) }"
              >
                <div class="size-10 rounded-lg overflow-hidden shrink-0 bg-[#EDE9FE] border border-[#DDD6FE] flex items-center justify-center">
                  <template x-if="item.image">
                    <img
                      :src="item.image"
                      :alt="item.title"
                      class="size-full object-cover"
                      @error="$el.style.display='none'; if ($el.nextElementSibling) $el.nextElementSibling.style.display='flex'"
                    />
                  </template>
                  <div :style="item.image ? 'display: none;' : ''" class="flex size-full items-center justify-center">
                    <i class="fa-solid fa-folder-open text-sm text-[#7C3AED]"></i>
                  </div>
                </div>
                <div class="min-w-0 flex-1">
                  <h5 class="font-inter text-xs sm:text-sm font-semibold text-[#0F172A] group-hover:text-[#003060] truncate transition-colors" x-text="item.title"></h5>
                  <p class="font-inter text-[11px] text-[#64748B] truncate mt-0.5" x-text="item.subtitle"></p>
                </div>
                <i class="fa-solid fa-chevron-right text-xs text-[#94A3B8] group-hover:text-[#003060] group-hover:translate-x-0.5 transition-all shrink-0"></i>
              </a>
            </template>
          </div>
        </div>
      </template>

      {{!-- 5. CATEGORY: RIWAYAT PEMBAYARAN --}}
      <template x-if="payments.length > 0">
        <div class="p-3">
          <div class="flex items-center justify-between px-3 py-1.5 mb-1">
            <div class="flex items-center gap-2 text-[#003060]">
              <i class="fa-solid fa-receipt text-xs"></i>
              <span class="font-inter font-semibold text-xs tracking-wide text-[#003060]">{{default (t 'test.userSearch.categoryPayments') 'Riwayat Pembayaran'}}</span>
            </div>
            <span class="rounded-full bg-[#E4F1F7] px-2 py-0.5 font-inter text-[11px] font-semibold text-[#003060]" x-text="payments.length"></span>
          </div>

          <div class="space-y-1">
            <template x-for="item in payments" :key="item.id || item.title">
              <a
                :href="item.url"
                @click="onItemClick($event, item)"
                class="group flex items-center gap-3.5 rounded-xl px-3 py-2 transition-colors hover:bg-[#F4F7FC]"
                :class="{ 'bg-[#F4F7FC] ring-1 ring-[#003060]/20': isHighlighted(item) }"
              >
                <div class="size-10 rounded-lg shrink-0 bg-[#E4F1F7] border border-[#D0E2EC] flex items-center justify-center">
                  <i class="fa-solid fa-receipt text-sm text-[#003060]"></i>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <h5 class="font-inter text-xs sm:text-sm font-semibold text-[#0F172A] group-hover:text-[#003060] truncate transition-colors" x-text="item.title"></h5>
                    <template x-if="item.badge">
                      <span 
                        class="text-[10px] font-semibold px-2 py-0.5 rounded-full inline-block shrink-0"
                        :class="{
                          'bg-[#DCFCE7] text-[#166534]': item.badge === 'Selesai' || item.badge === 'Paid',
                          'bg-[#FEF9C3] text-[#854D0E]': item.badge === 'Diproses' || item.badge === 'Processing',
                          'bg-[#FEE2E2] text-[#991B1B]': item.badge === 'Gagal' || item.badge === 'Failed'
                        }"
                        x-text="translateBadge(item.badge)"
                      ></span>
                    </template>
                  </div>
                  <p class="font-inter text-[11px] text-[#64748B] truncate mt-0.5" x-text="item.subtitle"></p>
                </div>
                <i class="fa-solid fa-chevron-right text-xs text-[#94A3B8] group-hover:text-[#003060] group-hover:translate-x-0.5 transition-all shrink-0"></i>
              </a>
            </template>
          </div>
        </div>
      </template>

      {{!-- 6. CATEGORY: MENU DASHBOARD --}}
      <template x-if="menus.length > 0">
        <div class="p-3">
          <div class="flex items-center justify-between px-3 py-1.5 mb-1">
            <div class="flex items-center gap-2 text-[#003060]">
              <i class="fa-solid fa-table-cells-large text-xs"></i>
              <span class="font-inter font-semibold text-xs tracking-wide text-[#003060]">{{default (t 'test.userSearch.categoryMenus') 'Menu Dashboard'}}</span>
            </div>
            <span class="rounded-full bg-[#E4F1F7] px-2 py-0.5 font-inter text-[11px] font-semibold text-[#003060]" x-text="menus.length"></span>
          </div>

          <div class="space-y-1">
            <template x-for="item in menus" :key="item.title">
              <a
                :href="item.url"
                @click="onItemClick($event, item)"
                class="group flex items-center gap-3.5 rounded-xl px-3 py-2 transition-colors hover:bg-[#F4F7FC]"
                :class="{ 'bg-[#F4F7FC] ring-1 ring-[#003060]/20': isHighlighted(item) }"
              >
                <div class="size-10 rounded-lg shrink-0 bg-[#E4F1F7] border border-[#D0E2EC] flex items-center justify-center text-[#003060]">
                  <template x-if="item.title === 'Dashboard'">
                    <i class="fa-solid fa-table-cells-large text-sm"></i>
                  </template>
                  <template x-if="item.title === 'Profile'">
                    <i class="fa-solid fa-user text-sm"></i>
                  </template>
                  <template x-if="item.title === 'My Learning'">
                    <i class="fa-solid fa-book-open text-sm"></i>
                  </template>
                  <template x-if="item.title === 'My Portfolio'">
                    <i class="fa-solid fa-folder-open text-sm text-[#7C3AED]"></i>
                  </template>
                  <template x-if="item.title === 'Payment History'">
                    <i class="fa-solid fa-receipt text-sm"></i>
                  </template>
                  <template x-if="!['Dashboard', 'Profile', 'My Learning', 'My Portfolio', 'Payment History'].includes(item.title)">
                    <i class="fa-solid fa-bars text-sm"></i>
                  </template>
                </div>
                <div class="min-w-0 flex-1">
                  <h5 class="font-inter text-xs sm:text-sm font-semibold text-[#0F172A] group-hover:text-[#003060] truncate transition-colors" x-text="item.title"></h5>
                  <p class="font-inter text-[11px] text-[#64748B] truncate mt-0.5" x-text="item.subtitle"></p>
                </div>
                <i class="fa-solid fa-chevron-right text-xs text-[#94A3B8] group-hover:text-[#003060] group-hover:translate-x-0.5 transition-all shrink-0"></i>
              </a>
            </template>
          </div>
        </div>
      </template>

    </div>

    {{!-- FOOTER: Menampilkan Total Hasil Saja --}}
    <template x-if="hasSearched && totalResults > 0">
      <div class="border-t border-[#F1F5F9] bg-[#F8FAFC] px-5 py-2.5 flex items-center justify-between text-xs text-[#64748B]">
        <div class="flex items-center gap-2 truncate">
          <i class="fa-solid fa-magnifying-glass text-[11px] text-[#003060]"></i>
          <span class="font-normal font-inter truncate">
            {{default (t 'test.userSearch.showingResultsPrefix') 'Menampilkan'}}
            <span class="font-semibold text-[#003060]" x-text="totalResults"></span>
            {{default (t 'test.userSearch.showingResultsMiddle') 'hasil pada dashboard untuk'}}
            "<span class="font-medium text-[#0F172A]" x-text="query"></span>"
          </span>
        </div>
        <span class="text-[11px] font-inter text-[#718096] hidden sm:inline shrink-0">
          {{default (t 'test.userSearch.selectItemHint') 'Pilih item untuk membuka'}}
        </span>
      </div>
    </template>
  </div>
</div>

<script>
  function globalSearch() {
    return {
      query: '',
      isOpen: false,
      isMobileSearchOpen: false,
      isLoading: false,
      hasSearched: false,
      courses: [],
      programs: [],
      learnings: [],
      portfolios: [],
      payments: [],
      menus: [],
      totalResults: 0,
      highlightIndex: -1,
      currentRequestId: 0,
      badges: {
        completed: '{{default (t "test.userSearch.statusCompleted") "Selesai"}}',
        inProgress: '{{default (t "test.userSearch.statusInProgress") "Sedang Berjalan"}}',
        paid: '{{default (t "test.userSearch.statusPaid") "Lunas"}}',
        processing: '{{default (t "test.userSearch.statusProcessing") "Diproses"}}',
        failed: '{{default (t "test.userSearch.statusFailed") "Gagal"}}'
      },

      translateBadge(b) {
        if (!b) return '';
        if (b === 'Selesai' || b === 'Completed') return this.badges.completed;
        if (b === 'Sedang Berjalan' || b === 'In Progress') return this.badges.inProgress;
        if (b === 'Paid' || b === 'Lunas') return this.badges.paid;
        if (b === 'Processing' || b === 'Diproses') return this.badges.processing;
        if (b === 'Failed' || b === 'Gagal') return this.badges.failed;
        return b;
      },

      get allItems() {
        return [
          ...this.programs,
          ...this.courses,
          ...this.learnings,
          ...this.portfolios,
          ...this.payments,
          ...this.menus,
        ];
      },

      isHighlighted(item) {
        if (this.highlightIndex < 0 || this.highlightIndex >= this.allItems.length) return false;
        const current = this.allItems[this.highlightIndex];
        return current && ((current.id && current.id === item.id) || (current.title === item.title && current.url === item.url));
      },

      navigateHighlight(direction) {
        const total = this.allItems.length;
        if (total === 0) return;
        if (this.highlightIndex === -1) {
          this.highlightIndex = direction > 0 ? 0 : total - 1;
        } else {
          this.highlightIndex = (this.highlightIndex + direction + total) % total;
        }
      },

      selectHighlightedOrFirst() {
        const items = this.allItems;
        if (items.length === 0) return;
        const target = (this.highlightIndex >= 0 && this.highlightIndex < items.length)
          ? items[this.highlightIndex]
          : items[0];
        if (target) {
          this.onItemClick(null, target);
        }
      },

      openSearch() {
        this.isOpen = true;
        if (this.query.trim().length > 0 && !this.hasSearched) {
          this.fetchResults();
        }
      },

      openMobileSearch() {
        this.isMobileSearchOpen = true;
        this.isOpen = true;
        this.$nextTick(() => {
          if (this.$refs.mobileSearchInput) {
            this.$refs.mobileSearchInput.focus();
          }
        });
      },

      closeSearch() {
        this.isOpen = false;
        this.isMobileSearchOpen = false;
        this.highlightIndex = -1;
      },

      clearQuery() {
        this.query = '';
        this.courses = [];
        this.programs = [];
        this.learnings = [];
        this.portfolios = [];
        this.payments = [];
        this.menus = [];
        this.totalResults = 0;
        this.hasSearched = false;
        this.highlightIndex = -1;
        if (this.isMobileSearchOpen && this.$refs.mobileSearchInput) {
          this.$refs.mobileSearchInput.focus();
        } else if (this.$refs.searchInput) {
          this.$refs.searchInput.focus();
        }
      },

      onItemClick(event, item) {
        this.closeSearch();
        if (!item || !item.url) return;

        // If currently on /users/profile and user clicked a tab menu on /users/profile
        if (window.location.pathname === '/users/profile' && item.url.includes('/users/profile?tab=')) {
          try {
            const urlObj = new URL(item.url, window.location.origin);
            const targetTab = urlObj.searchParams.get('tab');
            if (targetTab) {
              if (event) event.preventDefault();
              window.dispatchEvent(new CustomEvent('navigate-tab', { detail: { section: targetTab } }));
              return;
            }
          } catch (e) {
            // Fall through to normal link navigation
          }
        }

        // Programmatically navigate if called from Enter keypress without direct click event
        if (!event && item.url) {
          window.location.href = item.url;
        }
      },

      async fetchResults() {
        const q = this.query.trim();
        if (!q) {
          this.courses = [];
          this.programs = [];
          this.learnings = [];
          this.portfolios = [];
          this.payments = [];
          this.menus = [];
          this.totalResults = 0;
          this.hasSearched = false;
          this.isLoading = false;
          this.highlightIndex = -1;
          return;
        }

        this.isLoading = true;
        this.isOpen = true;
        const reqId = ++this.currentRequestId;

        try {
          const res = await fetch('/api/search?q=' + encodeURIComponent(q));
          if (reqId !== this.currentRequestId) return; // Discard stale out-of-order response

          const result = await res.json();
          if (reqId !== this.currentRequestId) return;

          if (result.status === 'success' && result.data) {
            this.courses = result.data.courses || [];
            this.programs = result.data.programs || [];
            this.learnings = result.data.learnings || [];
            this.portfolios = result.data.portfolios || [];
            this.payments = result.data.payments || [];
            this.menus = result.data.menus || [];
            this.totalResults = result.total || 0;
            this.hasSearched = true;
            this.highlightIndex = -1;
          }
        } catch (e) {
          if (reqId === this.currentRequestId) {
            console.error('Search error:', e);
          }
        } finally {
          if (reqId === this.currentRequestId) {
            this.isLoading = false;
          }
        }
      }
    };
  }
</script>
