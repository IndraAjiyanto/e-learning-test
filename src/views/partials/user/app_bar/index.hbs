{{!--
  Komponen: Application Bar (User area)
  Lokasi: src/views/partials/user/app_bar/index.hbs
  Level: L2 Section

  Bar atas untuk area yang sudah login (role `user`).
  Sebelumnya markup ini inline di `user/user_profile/index.hbs`; diekstrak supaya
  halaman student standalone (yang dirender dengan `bareShell: true`) memakai bar
  yang sama, bukan navbar marketing publik.

  Gating role ada DI DALAM komponen ini: admin/super_admin memakai chrome CMS
  (`layouts/main.hbs` -> {{> sidebar}}), jadi bar ini tidak boleh dobel untuk mereka.
  Pemanggil tidak perlu membungkusnya dengan {{#unless}} lagi.

  Props:
  - user           : object (wajib) — user yang sedang login
  - sidebarToggle  : boolean (opsional, default false) — tampilkan tombol hamburger.
                     Perilakunya dua cabang sesuai lebar layar:
                     * < 1024px  : buka/tutup drawer menu mobile (di bawah).
                     * >= 1024px : cubit/perlebar sidebar desktop (menulis atribut
                       `data-user-sidebar` pada <html>, sama seperti sebelumnya).
                     Karena drawer hanya terlihat di bawah `lg`, satu tombol bisa
                     melayani kedua kasus tanpa saling mengganggu.
  - mobileNav      : 'tabs' | 'links' (opsional, default 'links')
                     'tabs'  : item drawer memanggil toggleActiveSection(...)
                               milik shell /users/profile - pindah tab tanpa reload.
                     'links' : item drawer berupa tautan biasa ke
                               /users/profile?tab=... (halaman berdiri sendiri).
  - active         : string (opsional, hanya mode 'links') — menandai item yang
                     sedang aktif: 'dashboard' | 'profile' | 'learning' |
                     'portfolio' | 'history-payment'
  - homeHref       : string (opsional, default '/dashboard') — tujuan klik logo.
                      Default-nya dashboard PUBLIK, jadi dari area user student
                      bisa balik ke landing tanpa lewat navbar publik dulu.

  Contoh (shell):
    {{> user/app_bar/index user=user sidebarToggle=true mobileNav='tabs' }}
  Contoh (halaman standalone dengan bareShell):
    {{> user/app_bar/index user=user sidebarToggle=true active=active }}
--}}
{{#unless (or (eq user.role 'admin') (eq user.role 'super_admin'))}}
<div
  x-data="{
    mobileNavOpen: false,
    toggleSidebar() {
      if (window.innerWidth < 1024) {
        this.mobileNavOpen = !this.mobileNavOpen;
        return;
      }
      const el = document.documentElement;
      const next = el.dataset.userSidebar === 'expanded' ? 'collapsed' : 'expanded';
      el.dataset.userSidebar = next;
      this.mobileNavOpen = false;
      try { localStorage.setItem('user-sidebar-open', next === 'expanded'); } catch (e) {}
    }
  }"
  @resize.window="window.innerWidth >= 1024 && mobileNavOpen && (mobileNavOpen = false)"
  class="shrink-0"
>
<header class="sticky top-0 z-40 flex h-16 w-full shrink-0 items-center justify-between border-b border-[#D9D9D9] bg-white px-4 lg:h-[72px] lg:px-8">
  <div class="flex items-center gap-3">
    <a href="{{default homeHref '/dashboard'}}" title="{{t 'test.navbar.home'}}" aria-label="{{t 'test.navbar.home'}}"><img src="/public/image/logo_baru.png" alt="Kesatria Academy" class="h-6 w-auto object-contain lg:h-7" /></a>
    {{#if sidebarToggle}}
    <button
      type="button"
      @click="toggleSidebar()"
      :aria-expanded="mobileNavOpen"
      class="grid size-9 shrink-0 place-items-center rounded-lg text-[#003060] hover:bg-[#F4F7FC]"
      aria-label="Toggle menu"
    >
      <i class="fas fa-bars text-sm" x-show="!mobileNavOpen"></i>
      <i class="fas fa-xmark text-sm" x-show="mobileNavOpen" x-cloak></i>
    </button>
    {{/if}}
  </div>

  {{> user/app_bar/search}}

  <div class="flex items-center gap-3 lg:gap-4">
    {{!-- Fitur Notif masih belum mau ada, masih ditinjau --}}
    {{!-- {{> components/ui/notification/index }} --}}
    {{> components/ui/nav/lang_switcher/index }}
    <div class="hidden items-center gap-2 sm:flex">
      <span class="font-inter text-xs font-semibold text-[#003060]">{{user.username}}</span>
      <span class="grid size-9 shrink-0 place-items-center rounded-full bg-[#F4F7FC] text-[#003060] overflow-hidden">
        {{#if user.profile}}
          <img src="{{user.profile}}" alt="{{user.username}}" class="size-full object-cover" />
        {{else}}
          <i class="fas fa-user text-sm"></i>
        {{/if}}
      </span>
    </div>
  </div>
</header>

{{!-- Drawer menu mobile. Hanya di bawah lg; geometrinya sengaja TIDAK memakai
     class `js-user-sidebar-*` karena lebar item class itu dikendalikan atribut
     `data-user-sidebar` (default 'collapsed') sehingga item drawer ikut menyusut
     jadi ikon 2,5rem. Pola overlay + slide mengikuti sidebar admin. --}}
<div
  x-show="mobileNavOpen"
  x-cloak
  @click="mobileNavOpen = false"
  x-transition:enter="transition-opacity ease-linear duration-300"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition-opacity ease-linear duration-300"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 z-40 bg-black/40 lg:hidden"
  aria-hidden="true"
></div>

<aside
  x-show="mobileNavOpen"
  x-cloak
  x-transition:enter="transition ease-out duration-300 transform"
  x-transition:enter-start="-translate-x-full"
  x-transition:enter-end="translate-x-0"
  x-transition:leave="transition ease-in duration-300 transform"
  x-transition:leave-start="translate-x-0"
  x-transition:leave-end="-translate-x-full"
  class="fixed left-0 top-0 z-50 flex h-full w-64 max-w-[85vw] flex-col border-r border-[#D9D9D9] bg-white lg:hidden"
  aria-label="Menu"
>
  <div class="flex h-16 shrink-0 items-center justify-between border-b border-[#D9D9D9] px-4">
    <img src="/public/image/logo_baru.png" alt="Kesatria Academy" class="h-6 w-auto object-contain" />
    <button
      type="button"
      @click="mobileNavOpen = false"
      class="grid size-9 shrink-0 place-items-center rounded-lg text-[#003060] hover:bg-[#F4F7FC]"
      aria-label="Close menu"
    >
      <i class="fas fa-xmark text-base"></i>
    </button>
  </div>

  <nav class="min-h-0 flex-1 space-y-2 overflow-y-auto p-4">
    {{#if (eq mobileNav 'tabs')}}
    <!-- Dashboard -->
    <button
      type="button"
      @click="toggleActiveSection('dashboard'); mobileNavOpen = false"
      :class="activeSection === 'dashboard' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'"
      class="flex h-11 w-full cursor-pointer items-center gap-3 rounded-lg px-3 text-left font-inter text-sm font-medium leading-none transition-colors duration-150"
    >
      <span class="flex w-5 shrink-0 justify-center"><i class="fas fa-table-cells-large text-base"></i></span>
      <span class="whitespace-nowrap">Dashboard</span>
    </button>

    <!-- Profile -->
    <button
      type="button"
      @click="toggleActiveSection('profile'); mobileNavOpen = false"
      :class="(activeSection === 'profile' || activeSection === 'password') ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'"
      aria-label="{{t 'test.userSidebar.profile'}}"
      class="flex h-11 w-full cursor-pointer items-center gap-3 rounded-lg px-3 text-left font-inter text-sm font-medium leading-none transition-colors duration-150"
    >
      <span class="flex w-5 shrink-0 justify-center">
        <span class="block size-5" :class="(activeSection === 'profile' || activeSection === 'password') ? 'bg-[#003060]' : 'bg-[#718096]'" style="-webkit-mask:url('/public/image/user_profile/profile.svg') center/contain no-repeat;mask:url('/public/image/user_profile/profile.svg') center/contain no-repeat;"></span>
      </span>
      <span class="whitespace-nowrap">{{t 'test.userSidebar.profile'}}</span>
    </button>

    <!-- My Learning -->
    <button
      type="button"
      @click="toggleActiveSection('learning'); mobileNavOpen = false"
      :class="activeSection === 'learning' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'"
      aria-label="{{t 'test.userSidebar.myLearning'}}"
      class="flex h-11 w-full cursor-pointer items-center gap-3 rounded-lg px-3 text-left font-inter text-sm font-medium leading-none transition-colors duration-150"
    >
      <span class="flex w-5 shrink-0 justify-center">
        <span class="block size-5" :class="activeSection === 'learning' ? 'bg-[#003060]' : 'bg-[#718096]'" style="-webkit-mask:url('/public/image/user_profile/myLearning.svg') center/contain no-repeat;mask:url('/public/image/user_profile/myLearning.svg') center/contain no-repeat;"></span>
      </span>
      <span class="whitespace-nowrap">My Learning</span>
    </button>

    <!-- My Portfolio -->
    <button
      type="button"
      @click="toggleActiveSection('portfolio'); mobileNavOpen = false"
      :class="activeSection === 'portfolio' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'"
      aria-label="{{t 'test.startLearning.portfolio'}}"
      class="flex h-11 w-full cursor-pointer items-center gap-3 rounded-lg px-3 text-left font-inter text-sm font-medium leading-none transition-colors duration-150"
    >
      <span class="flex w-5 shrink-0 justify-center">
        <span class="block size-5" :class="activeSection === 'portfolio' ? 'bg-[#003060]' : 'bg-[#718096]'" style="-webkit-mask:url('/public/image/user_profile/myPortofolio.svg') center/contain no-repeat;mask:url('/public/image/user_profile/myPortofolio.svg') center/contain no-repeat;"></span>
      </span>
      <span class="whitespace-nowrap">{{t 'test.startLearning.portfolio'}}</span>
    </button>

    <!-- Payment History -->
    <button
      type="button"
      @click="toggleActiveSection('history-payment'); mobileNavOpen = false"
      :class="activeSection === 'history-payment' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'"
      aria-label="{{t 'test.userSidebar.paymentHistory'}}"
      class="flex h-11 w-full cursor-pointer items-center gap-3 rounded-lg px-3 text-left font-inter text-sm font-medium leading-none transition-colors duration-150"
    >
      <span class="flex w-5 shrink-0 justify-center">
        <span class="block size-5" :class="activeSection === 'history-payment' ? 'bg-[#003060]' : 'bg-[#718096]'" style="-webkit-mask:url('/public/image/user_profile/historyPayment.svg') center/contain no-repeat;mask:url('/public/image/user_profile/historyPayment.svg') center/contain no-repeat;"></span>
      </span>
      <span class="whitespace-nowrap">Payment History</span>
    </button>
    {{else}}
    <!-- Dashboard -->
    <a
      href="/users/profile?tab=dashboard"
      aria-label="{{t 'test.userSidebar.dashboard'}}"
      class="flex h-11 w-full items-center gap-3 rounded-lg px-3 font-inter text-sm font-medium leading-none transition-colors duration-150 {{#if (eq active 'dashboard')}}bg-[#E4F1F7] text-[#003060]{{else}}text-[#718096] hover:bg-[#F4F7FC]{{/if}}"
    >
      <span class="flex w-5 shrink-0 justify-center"><i class="fas fa-table-cells-large text-base"></i></span>
      <span class="whitespace-nowrap">Dashboard</span>
    </a>

    <!-- Profile -->
    <a
      href="/users/profile?tab=profile"
      aria-label="{{t 'test.userSidebar.profile'}}"
      class="flex h-11 w-full items-center gap-3 rounded-lg px-3 font-inter text-sm font-medium leading-none transition-colors duration-150 {{#if (eq active 'profile')}}bg-[#E4F1F7] text-[#003060]{{else}}text-[#718096] hover:bg-[#F4F7FC]{{/if}}"
    >
      <span class="flex w-5 shrink-0 justify-center"><span class="block size-5 {{#if (eq active 'profile')}}bg-[#003060]{{else}}bg-[#718096]{{/if}}" style="-webkit-mask:url('/public/image/user_profile/profile.svg') center/contain no-repeat;mask:url('/public/image/user_profile/profile.svg') center/contain no-repeat;"></span></span>
      <span class="whitespace-nowrap">{{t 'test.userSidebar.profile'}}</span>
    </a>

    <!-- My Learning -->
    <a
      href="/users/profile?tab=learning"
      aria-label="{{t 'test.userSidebar.myLearning'}}"
      class="flex h-11 w-full items-center gap-3 rounded-lg px-3 font-inter text-sm font-medium leading-none transition-colors duration-150 {{#if (eq active 'learning')}}bg-[#E4F1F7] text-[#003060]{{else}}text-[#718096] hover:bg-[#F4F7FC]{{/if}}"
    >
      <span class="flex w-5 shrink-0 justify-center"><span class="block size-5 {{#if (eq active 'learning')}}bg-[#003060]{{else}}bg-[#718096]{{/if}}" style="-webkit-mask:url('/public/image/user_profile/myLearning.svg') center/contain no-repeat;mask:url('/public/image/user_profile/myLearning.svg') center/contain no-repeat;"></span></span>
      <span class="whitespace-nowrap">My Learning</span>
    </a>

    <!-- My Portfolio -->
    <a
      href="/users/profile?tab=portfolio"
      aria-label="{{t 'test.userSidebar.myPortfolio'}}"
      class="flex h-11 w-full items-center gap-3 rounded-lg px-3 font-inter text-sm font-medium leading-none transition-colors duration-150 {{#if (eq active 'portfolio')}}bg-[#E4F1F7] text-[#003060]{{else}}text-[#718096] hover:bg-[#F4F7FC]{{/if}}"
    >
      <span class="flex w-5 shrink-0 justify-center"><span class="block size-5 {{#if (eq active 'portfolio')}}bg-[#003060]{{else}}bg-[#718096]{{/if}}" style="-webkit-mask:url('/public/image/user_profile/myPortofolio.svg') center/contain no-repeat;mask:url('/public/image/user_profile/myPortofolio.svg') center/contain no-repeat;"></span></span>
      <span class="whitespace-nowrap">My Portfolio</span>
    </a>

    <!-- Payment History -->
    <a
      href="/users/profile?tab=history-payment"
      aria-label="{{t 'test.userSidebar.paymentHistory'}}"
      class="flex h-11 w-full items-center gap-3 rounded-lg px-3 font-inter text-sm font-medium leading-none transition-colors duration-150 {{#if (eq active 'history-payment')}}bg-[#E4F1F7] text-[#003060]{{else}}text-[#718096] hover:bg-[#F4F7FC]{{/if}}"
    >
      <span class="flex w-5 shrink-0 justify-center"><span class="block size-5 {{#if (eq active 'history-payment')}}bg-[#003060]{{else}}bg-[#718096]{{/if}}" style="-webkit-mask:url('/public/image/user_profile/historyPayment.svg') center/contain no-repeat;mask:url('/public/image/user_profile/historyPayment.svg') center/contain no-repeat;"></span></span>
      <span class="whitespace-nowrap">Payment History</span>
    </a>
    {{/if}}
  </nav>

  <div class="shrink-0 border-t border-[#D9D9D9] p-4">
    <button
      type="button"
      @click="mobileNavOpen = false; openLogoutModal()"
      class="flex h-10 w-full cursor-pointer items-center justify-center gap-2 rounded-lg border border-[#C0392B] bg-white font-montserrat text-sm font-semibold leading-5 text-[#C0392B] transition-colors hover:bg-[#fef2f2]"
    >
      <i class="fa-solid fa-arrow-right-from-bracket text-[18px]"></i>
      <span>Log Out</span>
    </button>
  </div>
</aside>
</div>
{{/unless}}
