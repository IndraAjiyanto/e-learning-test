{{!--
  Tab: Dashboard (NEW - Figma 830:9155, "Role User: Sudah Ikut Program")
  Lokasi: src/views/partials/user/sidebar_user_profile/dashboard/index.hbs
  Included from src/views/user/user_profile/index.hbs (the Alpine shell) as the
  activeSection === 'dashboard' panel. Shares that file's Alpine scope directly
  (selectCourseSection is defined there), so this partial can stay plain Handlebars.
  Data: user, userWithCourses.userCourses[] ({course, progress}), dashboardStats
  ({ongoingCount, completedCount, certificatesCount}), ongoingCourses[] (users.controller.ts).
  Font: Inter, confirmed via direct Figma node fetch (830:9214 banner text, 830:9226 stat cards
  both come back fontFamily "Inter") - this is deliberately DIFFERENT from the shell's chrome
  (app bar + sidebar nav = Montserrat, confirmed separately via 830:9177/830:9185/830:9211).
  Don't "fix" this to match the shell without re-checking Figma.
--}}
{{#if userWithCourses.userCourses.length}}
  <div class="flex flex-col gap-6 font-inter p-5">

    {{!--
      Welcome banner - recreated from the screenshot the user pasted 2026-09-15,
      not a literal Figma asset export (API still rate-limited, see dashboard partial
      history). The graduation-cap illustration below is a hand-built inline SVG
      stand-in, not the real Figma vector.
    --}}
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#6B84A6] via-[#2E4A73] to-[#0A2647] px-6 py-8 sm:px-10 sm:py-10">
      <span aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 size-64 rounded-full bg-white/10"></span>
      <span aria-hidden="true" class="pointer-events-none absolute -bottom-20 right-10 size-48 rounded-full bg-white/5"></span>
      <div class="relative flex items-center justify-between gap-6">
        <div class="flex flex-col gap-2">
          <span class="text-xs font-bold uppercase tracking-[0.15em] text-[#0B1F3B]">Welcome back,</span>
          <h1 class="text-2xl font-bold text-[#0B1F3B] sm:text-3xl">{{user.username}}</h1>
          <p class="max-w-lg text-sm text-[#0B1F3B]/70">Keep learning, keep growing. Your next achievement is just one step away!</p>
        </div>
        <div class="relative hidden shrink-0 sm:block">
          <span aria-hidden="true" class="grid size-32 place-items-center rounded-full bg-white/15">
            <span class="grid size-16 place-items-center rounded-[10px] bg-white shadow-lg">
              <i class="fas fa-graduation-cap text-2xl text-[#0A2647]"></i>
            </span>
          </span>
        </div>
      </div>
    </div>

    {{!-- Stat cards --}}
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      {{#each (array
        (array "fa-book-open" dashboardStats.ongoingCount "Ongoing Courses" "#E0F2F9" "#0369A1" "learning")
        (array "fa-circle-check" dashboardStats.completedCount "Completed Courses" "#DCFCE7" "#16A34A" "learning")
        (array "fa-folder-open" portfolio.length "Portfolio Published" "#EDE9FE" "#7C3AED" "portfolio")
      )}}
        <button
          type="button"
          @click="toggleActiveSection('{{lookup this 5}}')"
          class="flex items-center gap-4 rounded-xl border border-[#E5E7EB] bg-white p-6 text-left shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] transition hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] cursor-pointer"
        >
          <span class="grid size-12 shrink-0 place-items-center rounded-[10px]" style="background-color:{{lookup this 3}};color:{{lookup this 4}};">
            <i class="fas {{lookup this 0}} text-lg"></i>
          </span>
          <div class="flex flex-1 flex-col min-w-0">
            <span class="text-2xl font-bold text-[#111827]">{{lookup this 1}}</span>
            <span class="text-sm text-[#6B7280]">{{lookup this 2}}</span>
          </div>
          <i class="fas fa-chevron-right shrink-0 text-sm text-[#94A3B8]"></i>
        </button>
      {{/each}}
    </div>

    {{!-- Continue Learning --}}
    <div class="rounded-xl border border-[#E5E7EB] bg-white p-6 sm:p-8 shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition">
      <div class="mb-5 flex items-center justify-between">
        <h2 class="text-lg font-bold text-[#111827]">Continue Learning</h2>
        <button type="button" @click="toggleActiveSection('learning')" class="text-sm font-semibold text-[#0369A1] hover:underline cursor-pointer">View All Programs <i class="fas fa-arrow-right text-xs"></i></button>
      </div>
      {{#if ongoingCourses.length}}
        <div class="flex flex-col divide-y divide-[#E5E7EB]">
          {{#each ongoingCourses}}
            <div class="flex flex-col gap-3 items-center py-4 first:pt-0 last:pb-0 sm:flex-row sm:justify-between">
              <div class="flex items-center gap-3.5 min-w-0 w-full sm:w-auto">
                <span class="grid size-14 shrink-0 place-items-center rounded-[10px] bg-[#E0F2F9] text-[#0369A1]">
                  <i class="fas fa-laptop-code text-2xl"></i>
                </span>
                <div class="flex flex-col gap-0.5 min-w-0">
                  <span class="truncate font-semibold text-[#111827]">{{this.course.name}}</span>
                  {{#if this.course.category.name}}
                    <span class="text-xs font-medium text-[#6B7280]">{{this.course.category.name}}</span>
                  {{/if}}
                </div>
              </div>
              <button
                type="button"
                @click="selectCourseSection('{{this.course.id}}', 'uiux')"
                class="shrink-0 rounded-lg border border-[#0369A1] px-5 py-2 text-sm font-semibold text-[#0369A1] transition hover:bg-[#E0F2F9] cursor-pointer"
              >
                Continue <i class="fas fa-arrow-right text-xs"></i>
              </button>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="text-sm text-[#6B7280]">No courses in progress right now - nice work keeping up, or time to start a new one from "My Learning".</p>
      {{/if}}
    </div>

    {{!-- Activity summary --}}
    <div class="rounded-xl border border-[#E5E7EB] bg-white p-6 sm:p-8 shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition">
      <h2 class="mb-5 text-lg font-bold text-[#111827]">Student Activity Summary</h2>
      <ul class="flex flex-col gap-3 text-sm text-[#374151]">
        <li class="flex items-center gap-2.5"><i class="fas fa-graduation-cap w-4 text-[#003060]"></i>Enrolled in {{userWithCourses.userCourses.length}} program{{#unless (eq userWithCourses.userCourses.length 1)}}s{{/unless}} total</li>
        <li class="flex items-center gap-2.5"><i class="fas fa-clipboard-list w-4 text-[#003060]"></i>{{logbooks.length}} logbook entr{{#if (eq logbooks.length 1)}}y{{else}}ies{{/if}} logged</li>
        <li class="flex items-center gap-2.5"><i class="fas fa-folder-open w-4 text-[#003060]"></i>{{portfolio.length}} portfolio item{{#unless (eq portfolio.length 1)}}s{{/unless}} submitted</li>
      </ul>
    </div>
  </div>
{{else}}
  {{!-- Empty state: hasn't joined any program yet (Figma 830:8544 is a blank frame - built to our standard) --}}
  <div class="flex flex-col items-center gap-4 rounded-xl border border-[#E5E7EB] bg-white py-16 text-center m-5 shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition">
    <span class="grid size-16 place-items-center rounded-full bg-[#E0F2F9] text-[#003060]">
      <i class="fas fa-compass text-2xl"></i>
    </span>
    <div class="flex flex-col gap-1.5">
      <h3 class="text-lg font-bold text-[#111827]">You haven't joined a program yet</h3>
      <p class="max-w-sm text-sm text-[#6B7280]">Browse our programs and pick one that fits your goals - your dashboard fills up as soon as you enroll.</p>
    </div>
    <a href="/dashboard#courses-section" class="mt-2 inline-flex items-center gap-2 rounded-lg bg-[#003060] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#00244a]">
      Browse Programs<i class="fas fa-arrow-right text-xs"></i>
    </a>
  </div>
{{/if}}
