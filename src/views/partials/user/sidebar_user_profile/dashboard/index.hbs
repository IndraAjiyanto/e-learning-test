{{!--
  Tab: Dashboard (NEW - Figma 830:9155, "Role User: Sudah Ikut Program")
  Lokasi: src/views/partials/user/sidebar_user_profile/dashboard/index.hbs
  Included from src/views/user/user_profile/index.hbs (the Alpine shell) as the
  activeSection === 'dashboard' panel. Shares that file's Alpine scope directly
  (selectCourseSection is defined there), so this partial can stay plain Handlebars.
  Data: user, userWithCourses.userCourses[] ({course, progress}), dashboardStats
  ({ongoingCount, completedCount, totalCount, completionPercent,
  certificatesCount}), ongoingCourses[], dan programComposition[]
  ({label, count, percent}) dari UsersService.getDashboardData(), dipakai kedua
  rute yang merender shell. Kartu ketiga menampilkan jumlah portfolio, bukan
  sertifikat; jumlah sertifikat muncul di kartu Learning Progress.
  Font: Inter, confirmed via direct Figma node fetch (830:9214 banner text, 830:9226 stat cards
  both come back fontFamily "Inter") - this is deliberately DIFFERENT from the shell's chrome
  (app bar + sidebar nav = Montserrat, confirmed separately via 830:9177/830:9185/830:9211).
  Don't "fix" this to match the shell without re-checking Figma.
--}}
{{#if userWithCourses.userCourses.length}}
  <div class="flex flex-col gap-6 font-inter px-4 py-4 sm:px-8 sm:py-6">

    {{!--
      Welcome banner - recreated from the screenshot the user pasted 2026-09-15,
      not a literal Figma asset export (API still rate-limited, see dashboard partial
      history). The graduation-cap illustration below is a hand-built inline SVG
      stand-in, not the real Figma vector.
    --}}
    {{!--
      Welcome banner mengikuti frame dashboard: gradien terang di kiri menuju navy
      pekat di kanan, teks navy di atas bagian terang, dan ilustrasi kartu wisuda
      di dalam elips. Sebelumnya gradien mulai dari #6B84A6 sehingga teks navy
      duduk di atas warna menengah dan nyaris tak terbaca.
      Ilustrasinya SVG inline, bukan ekspor aset Figma.
    --}}
    <div class="relative overflow-hidden rounded-xl bg-[linear-gradient(105deg,#EEF2F7_0%,#C7D3E2_22%,#6E88A8_52%,#1E3A5F_80%,#0A2647_100%)] px-6 py-8 sm:px-10 sm:py-10">
      <div class="relative flex items-center justify-between gap-6">
        <div class="flex flex-col gap-2">
          <span class="text-xs font-bold uppercase tracking-[0.15em] text-[#0B1F3B]">Welcome back,</span>
          <h1 class="text-2xl font-bold text-[#0B1F3B] sm:text-3xl">{{user.username}}</h1>
          <p class="max-w-lg text-sm text-[#0B1F3B]/70">Keep learning, keep growing. Your next achievement is just one step away!</p>
        </div>

        {{!-- Ilustrasi: elips lembut, kartu putih miring berisi topi wisuda, dan
             garis pohon tipis di kanan - menirukan susunan pada frame. --}}
        <svg aria-hidden="true" class="pointer-events-none hidden h-[150px] w-[320px] shrink-0 sm:block" viewBox="0 0 320 150" fill="none" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="150" cy="75" rx="150" ry="72" fill="#FFFFFF" fill-opacity="0.13" />
          <g transform="rotate(-7 128 74)">
            <rect x="60" y="28" width="136" height="92" rx="12" fill="#FFFFFF" />
            <rect x="60.75" y="28.75" width="134.5" height="90.5" rx="11.25" stroke="#0A2647" stroke-width="1.5" />
            <path d="M128 58 L160 72 L128 86 L96 72 Z" stroke="#0A2647" stroke-width="3.2" stroke-linejoin="round" fill="none" />
            <path d="M108 78 V92 C108 97 117 101 128 101 C139 101 148 97 148 92 V78" stroke="#0A2647" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            <path d="M160 72 V88" stroke="#0A2647" stroke-width="3.2" stroke-linecap="round" />
          </g>
          <g stroke="#FFFFFF" stroke-opacity="0.45" stroke-width="1.6" fill="none" stroke-linecap="round">
            <path d="M260 124 V74" />
            <path d="M260 92 C244 88 236 74 240 58 C256 60 264 74 260 92 Z" />
            <path d="M260 84 C276 80 284 66 280 50 C264 52 256 66 260 84 Z" />
          </g>
        </svg>
      </div>
    </div>

    {{!-- Stat cards --}}
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      {{#each (array
        (array "fa-book-open" dashboardStats.ongoingCount "Ongoing Courses" "#E0F2F9" "#0369A1" "learning")
        (array "fa-circle-check" dashboardStats.completedCount "Completed Courses" "#DCFCE7" "#16A34A" "learning")
        (array "fa-folder-open" portfolio.length "Portfolio Published" "#EDE9FE" "#7C3AED" "portfolio")
      )}}
        <button
          type="button"
          @click="toggleActiveSection('{{lookup this 5}}')"
          class="flex items-center gap-4 rounded-xl border border-[#E5E7EB] bg-white p-6 text-left shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] transition hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] cursor-pointer"
        >
          {{!-- Frame memakai lingkaran penuh, bukan kotak membulat. --}}
          <span class="grid size-12 shrink-0 place-items-center rounded-full" style="background-color:{{lookup this 3}};color:{{lookup this 4}};">
            <i class="fas {{lookup this 0}} text-lg"></i>
          </span>
          <div class="flex flex-1 flex-col min-w-0">
            <span class="text-2xl font-bold text-[#111827]">{{lookup this 1}}</span>
            <span class="text-sm text-[#6B7280]">{{lookup this 2}}</span>
          </div>
          {{!-- Frame memakai panah biru, bukan chevron abu-abu. --}}
          <i class="fas fa-arrow-right shrink-0 text-sm text-[#0369A1]"></i>
        </button>
      {{/each}}
    </div>

    {{!--
      Continue Learning mengikuti frame: thumbnail pastel besar berisi ikon,
      dua keterangan di bawah judul (kategori + tipe kelas), pemisah antar baris,
      lalu penghitung dan paginasi di kaki kartu.

      Paginasinya di sisi klien: daftar course yang sedang berjalan selalu pendek,
      jadi tidak perlu rute baru. perPage 3 mengikuti jumlah baris pada frame.

      Warna thumbnail berputar tiga langkah seperti pada frame (biru, ungu, hijau);
      itu murni hiasan, tidak menyandikan arti apa pun.
    --}}
    <div
      class="rounded-xl border border-[#E5E7EB] bg-white p-6 sm:p-8 shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition"
      x-data="{ page: 1, perPage: 3, total: {{ongoingCourses.length}},
                get pages() { return Math.max(1, Math.ceil(this.total / this.perPage)); },
                get from() { return this.total === 0 ? 0 : (this.page - 1) * this.perPage + 1; },
                get to() { return Math.min(this.page * this.perPage, this.total); },
                shows(i) { return i > (this.page - 1) * this.perPage && i <= this.page * this.perPage; } }"
    >
      <div class="mb-5 flex items-center justify-between">
        <h2 class="text-lg font-bold text-[#111827]">Continue Learning</h2>
        <button type="button" @click="toggleActiveSection('learning')" class="text-sm font-semibold text-[#0369A1] hover:underline cursor-pointer">View All Programs <i class="fas fa-arrow-right text-xs"></i></button>
      </div>
      {{#if ongoingCourses.length}}
        <div class="flex flex-col divide-y divide-[#E5E7EB]">
          {{#each ongoingCourses}}
            <div x-show="shows({{addOne @index}})" class="flex flex-col gap-3 items-center py-4 first:pt-0 last:pb-0 sm:flex-row sm:justify-between">
              <div class="flex items-center gap-4 min-w-0 w-full sm:w-auto">
                <span class="grid size-20 shrink-0 place-items-center rounded-xl {{#if (eq (mod @index 3) 0)}}bg-[#DBEAFE]{{else if (eq (mod @index 3) 1)}}bg-[#EDE9FE]{{else}}bg-[#DCFCE7]{{/if}}">
                  <span class="grid size-12 place-items-center rounded-lg {{#if (eq (mod @index 3) 0)}}bg-[#60A5FA]{{else if (eq (mod @index 3) 1)}}bg-[#A78BFA]{{else}}bg-[#4ADE80]{{/if}}">
                    <i class="fas {{#if (eq (mod @index 3) 0)}}fa-desktop{{else if (eq (mod @index 3) 1)}}fa-table-columns{{else}}fa-user{{/if}} text-lg text-white"></i>
                  </span>
                </span>
                <div class="flex flex-col gap-1 min-w-0">
                  <span class="truncate font-semibold text-[#111827]">{{this.course.name}}</span>
                  <span class="text-xs font-medium text-[#6B7280]">
                    {{#if this.course.category.name}}{{this.course.category.name}}{{/if}}{{#if this.course.courseType.nameClassesType}}{{#if this.course.category.name}} &middot; {{/if}}{{this.course.courseType.nameClassesType}}{{/if}}
                  </span>
                </div>
              </div>
              <button
                type="button"
                @click="selectCourseSection('{{this.course.id}}', 'uiux')"
                class="shrink-0 rounded-lg border border-[#0369A1] px-5 py-2 text-sm font-semibold text-[#0369A1] transition hover:bg-[#E0F2F9] cursor-pointer"
              >
                Continue <i class="fas fa-arrow-right text-xs"></i>
              </button>
            </div>
          {{/each}}
        </div>

        <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-[#E5E7EB] pt-5">
          <span class="text-sm text-[#6B7280]">
            Showing <span x-text="from"></span>-<span x-text="to"></span> of <span x-text="total"></span> course<template x-if="total !== 1"><span>s</span></template>
          </span>
          <div class="flex items-center gap-2" x-show="pages > 1">
            <template x-for="p in pages" :key="p">
              <button
                type="button"
                @click="page = p"
                x-text="p"
                class="size-9 rounded-lg border text-sm font-semibold transition-colors cursor-pointer"
                :class="page === p ? 'border-[#003060] bg-[#003060] text-white' : 'border-[#E5E7EB] bg-white text-[#475569] hover:bg-[#F4F7FC]'"
              ></button>
            </template>
          </div>
        </div>
      {{else}}
        <p class="text-sm text-[#6B7280]">No courses in progress right now - nice work keeping up, or time to start a new one from "My Learning".</p>
      {{/if}}
    </div>

    {{!--
      Statistik.

      Kartu ringkasan yang lama hanya tiga butir kalimat - jumlah program,
      logbook, portfolio - dan dua di antaranya sudah disebut kartu statistik di
      atas. Bentuknya sekarang meniru ide blok "Statistik" pada dasbor bisa.ai:
      satu kartu kemajuan dengan cincin persentase, satu kartu komposisi. Token
      warna dan tipografinya tetap milik frame dashboard kita, bukan milik
      mereka, dan setiap angkanya berasal dari getDashboardData - tidak ada yang
      dikarang supaya kartunya terlihat penuh.

      Judul "Student Activity Dashboard Summary" dan tautan "View All Courses"
      dipertahankan: keduanya ada pada frame 830:9155 dan dijaga design-check.
    --}}
    <div class="flex flex-col gap-5">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-bold text-[#111827]">Student Activity Dashboard Summary</h2>
        <button type="button" @click="toggleActiveSection('learning')" class="shrink-0 text-sm font-semibold text-[#0369A1] hover:underline cursor-pointer">View All Courses <i class="fas fa-arrow-right text-xs"></i></button>
      </div>

      <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        {{!--
          Kemajuan belajar. Cincinnya SVG biasa dengan stroke-dasharray - teknik
          yang sama dengan ringkasan minggu pada halaman Start Learning, supaya
          kedua layar memakai satu bahasa bentuk. Perannya sebagai progressbar
          ikut ditulis, kalau tidak persentasenya tidak terbaca pembaca layar.
        --}}
        <div class="flex flex-col rounded-xl border border-[#E5E7EB] bg-white p-6 sm:p-8 shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition">
          <div class="flex items-start justify-between gap-4">
            <div class="flex flex-col gap-1">
              <h3 class="text-base font-bold text-[#111827]">Learning Progress</h3>
              <p class="text-sm text-[#6B7280]">How far along you are across every program you joined.</p>
            </div>
            <span aria-hidden="true" class="grid size-10 shrink-0 place-items-center rounded-full bg-[#DCFCE7] text-[#16A34A]">
              <i class="fas fa-chart-line text-sm"></i>
            </span>
          </div>

          <div class="mt-6 flex flex-col items-center gap-6 sm:flex-row sm:items-center">
            <div
              class="relative grid size-28 shrink-0 place-items-center"
              role="progressbar"
              aria-label="Learning progress"
              aria-valuenow="{{dashboardStats.completionPercent}}"
              aria-valuemin="0"
              aria-valuemax="100"
            >
              <svg viewBox="0 0 36 36" class="size-28 -rotate-90" aria-hidden="true">
                <circle cx="18" cy="18" r="15.915" fill="none" stroke="#E5E7EB" stroke-width="3"></circle>
                <circle cx="18" cy="18" r="15.915" fill="none" stroke="#16A34A" stroke-width="3" stroke-linecap="round" stroke-dasharray="{{dashboardStats.completionPercent}} 100"></circle>
              </svg>
              <span class="absolute text-xl font-bold text-[#111827]">{{dashboardStats.completionPercent}}%</span>
            </div>

            <div class="flex min-w-0 flex-1 flex-col gap-4">
              <div class="flex flex-wrap gap-x-10 gap-y-4">
                <div class="flex flex-col gap-1">
                  <span class="text-2xl font-bold text-[#111827]">{{dashboardStats.completedCount}}</span>
                  <span class="inline-flex items-center gap-2 text-xs font-medium text-[#6B7280]">
                    <span aria-hidden="true" class="size-2.5 rounded-sm bg-[#16A34A]"></span>Completed
                  </span>
                </div>
                <div class="flex flex-col gap-1">
                  <span class="text-2xl font-bold text-[#111827]">{{dashboardStats.ongoingCount}}</span>
                  <span class="inline-flex items-center gap-2 text-xs font-medium text-[#6B7280]">
                    <span aria-hidden="true" class="size-2.5 rounded-sm bg-[#9CA3AF]"></span>In progress
                  </span>
                </div>
              </div>
              <p class="text-sm text-[#6B7280]">
                <span class="font-bold text-[#111827]">{{dashboardStats.completionPercent}}%</span>
                of {{dashboardStats.totalCount}} program{{#unless (eq dashboardStats.totalCount 1)}}s{{/unless}} completed.
              </p>
            </div>
          </div>

          {{!-- Dua hitungan yang dulu jadi butir kalimat; sertifikat baru ikut
               di sini - angkanya sudah lama dihitung service tetapi tidak
               pernah ditampilkan di mana pun. --}}
          <div class="mt-auto flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-[#E5E7EB] pt-5 sm:mt-6">
            <span class="inline-flex items-center gap-3">
              <span aria-hidden="true" class="grid size-9 shrink-0 place-items-center rounded-full bg-[#EDE9FE] text-[#7C3AED]"><i class="fas fa-pen-to-square text-xs"></i></span>
              <span class="flex flex-col">
                <span class="text-sm font-bold text-[#111827]">{{logbooks.length}}</span>
                <span class="text-xs text-[#6B7280]">Logbook entries</span>
              </span>
            </span>
            <span class="inline-flex items-center gap-3">
              <span aria-hidden="true" class="grid size-9 shrink-0 place-items-center rounded-full bg-[#FEF3C7] text-[#B45309]"><i class="fas fa-award text-xs"></i></span>
              <span class="flex flex-col">
                <span class="text-sm font-bold text-[#111827]">{{dashboardStats.certificatesCount}}</span>
                <span class="text-xs text-[#6B7280]">Certificates earned</span>
              </span>
            </span>
          </div>
        </div>

        {{!--
          Komposisi program. bisa.ai memakai donat untuk komposisi transaksi;
          di sini yang dipotong adalah program yang benar-benar diikuti, per
          tipe kelas, karena tabel pembayaran tidak dimuat rute ini dan program
          gratis tidak punya transaksi sama sekali. Bentuknya batang, bukan
          donat: dengan tiga tipe kelas atau lebih, batang berlabel jauh lebih
          mudah dibaca daripada potongan lingkaran kecil.
        --}}
        <div class="flex flex-col rounded-xl border border-[#E5E7EB] bg-white p-6 sm:p-8 shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition">
          <div class="flex items-start justify-between gap-4">
            <div class="flex flex-col gap-1">
              <h3 class="text-base font-bold text-[#111827]">Program Composition</h3>
              <p class="text-sm text-[#6B7280]">The class types behind the {{dashboardStats.totalCount}} program{{#unless (eq dashboardStats.totalCount 1)}}s{{/unless}} you joined.</p>
            </div>
            <span aria-hidden="true" class="grid size-10 shrink-0 place-items-center rounded-full bg-[#E0F2F9] text-[#0369A1]">
              <i class="fas fa-chart-pie text-sm"></i>
            </span>
          </div>

          {{#if programComposition.length}}
            <ul class="mt-6 flex flex-col gap-5">
              {{#each programComposition}}
                <li class="flex flex-col gap-2">
                  <div class="flex items-baseline justify-between gap-3">
                    <span class="truncate text-sm font-semibold text-[#111827]">{{this.label}}</span>
                    <span class="shrink-0 text-sm text-[#6B7280]"><span class="font-bold text-[#111827]">{{this.count}}</span> ({{this.percent}}%)</span>
                  </div>
                  {{!-- Batangnya hiasan dari angka di sebelahnya, jadi disembunyikan
                       dari pembaca layar - kalau tidak, jumlah dan persentasenya
                       terbaca dua kali. --}}
                  <div aria-hidden="true" class="h-2 w-full overflow-hidden rounded-full bg-[#F3F4F6]">
                    <div
                      class="h-full min-w-[6px] rounded-full {{#if (eq (mod @index 3) 0)}}bg-[#0369A1]{{else if (eq (mod @index 3) 1)}}bg-[#7C3AED]{{else}}bg-[#16A34A]{{/if}}"
                      style="width:{{this.percent}}%;"
                    ></div>
                  </div>
                </li>
              {{/each}}
            </ul>
          {{else}}
            <p class="mt-6 text-sm text-[#6B7280]">No class type recorded on your programs yet.</p>
          {{/if}}

          {{!-- Kaki kartu menyamakan tingginya dengan kartu kemajuan di
               sebelahnya; angkanya dua hitungan yang tidak disebut batang mana
               pun. --}}
          <div class="mt-auto flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-[#E5E7EB] pt-5 sm:mt-6">
            <span class="inline-flex items-center gap-3">
              <span aria-hidden="true" class="grid size-9 shrink-0 place-items-center rounded-full bg-[#E0F2F9] text-[#0369A1]"><i class="fas fa-layer-group text-xs"></i></span>
              <span class="flex flex-col">
                <span class="text-sm font-bold text-[#111827]">{{programComposition.length}}</span>
                <span class="text-xs text-[#6B7280]">Class type{{#unless (eq programComposition.length 1)}}s{{/unless}}</span>
              </span>
            </span>
            <span class="inline-flex items-center gap-3">
              <span aria-hidden="true" class="grid size-9 shrink-0 place-items-center rounded-full bg-[#DBEAFE] text-[#1D4ED8]"><i class="fas fa-graduation-cap text-xs"></i></span>
              <span class="flex flex-col">
                <span class="text-sm font-bold text-[#111827]">{{dashboardStats.totalCount}}</span>
                <span class="text-xs text-[#6B7280]">Program{{#unless (eq dashboardStats.totalCount 1)}}s{{/unless}} joined</span>
              </span>
            </span>
          </div>
        </div>
      </div>
    </div>

    {{!--
      Menu cepat.

      Ide dari "Menu Cepat" bisa.ai: dasbor sebaiknya juga jadi titik berangkat,
      bukan hanya papan angka. Sebelum ini satu-satunya jalan keluar dari tab
      Dashboard adalah tiga kartu statistik dan tombol Continue.

      Setiap petak menuju tempat yang memang ada. Yang TIDAK diambil: petak
      "Sertifikat" milik mereka - sertifikat kita melekat pada satu program,
      jadi petak tunggal harus menebak program mana yang dimaksud; jalan yang
      benar tetap lewat program itu sendiri.
    --}}
    <div class="flex flex-col gap-5">
      <h2 class="text-lg font-bold text-[#111827]">Quick Menu</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a
          href="/dashboard#courses-section"
          class="flex items-center gap-4 rounded-xl border border-[#E5E7EB] bg-white p-5 text-left shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] transition hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)]"
        >
          <span aria-hidden="true" class="grid size-11 shrink-0 place-items-center rounded-full bg-[#E0F2F9] text-[#0369A1]"><i class="fas fa-compass text-base"></i></span>
          <span class="flex min-w-0 flex-col">
            <span class="text-sm font-bold text-[#111827]">Browse Programs</span>
            <span class="truncate text-xs text-[#6B7280]">Find a new class to join</span>
          </span>
        </a>

        <button
          type="button"
          @click="toggleActiveSection('learning')"
          class="flex items-center gap-4 rounded-xl border border-[#E5E7EB] bg-white p-5 text-left shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] transition hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] cursor-pointer"
        >
          <span aria-hidden="true" class="grid size-11 shrink-0 place-items-center rounded-full bg-[#DBEAFE] text-[#1D4ED8]"><i class="fas fa-book-open text-base"></i></span>
          <span class="flex min-w-0 flex-col">
            <span class="text-sm font-bold text-[#111827]">My Learning</span>
            <span class="truncate text-xs text-[#6B7280]">Open your programs</span>
          </span>
        </button>

        <button
          type="button"
          @click="toggleActiveSection('profile')"
          class="flex items-center gap-4 rounded-xl border border-[#E5E7EB] bg-white p-5 text-left shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] transition hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] cursor-pointer"
        >
          <span aria-hidden="true" class="grid size-11 shrink-0 place-items-center rounded-full bg-[#EDE9FE] text-[#7C3AED]"><i class="fas fa-user text-base"></i></span>
          <span class="flex min-w-0 flex-col">
            <span class="text-sm font-bold text-[#111827]">My Profile</span>
            <span class="truncate text-xs text-[#6B7280]">Update your data and photo</span>
          </span>
        </button>

        <button
          type="button"
          @click="toggleActiveSection('portfolio')"
          class="flex items-center gap-4 rounded-xl border border-[#E5E7EB] bg-white p-5 text-left shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] transition hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] cursor-pointer"
        >
