{{!--
  Tab Portfolio di halaman Start Learning.

  Berbeda dengan tab lain, panel ini menampilkan karya SETIAP student di
  program yang sedang dibuka, bukan hanya karya student itu sendiri. Karena
  itu isinya diambil per program lewat GET /portfolio/fragment
  (lihat sectionFragmentConfig di shell), dan panel ini tidak lagi tahu apa
  pun tentang program lain.

  Data datang sebagai satu pulau JSON di bawah, bukan lewat `window.*`:
  shell menempelkan partial ini dengan `innerHTML`, dan skrip yang disisipkan
  dengan cara itu tidak dieksekusi browser.
--}}
<div
  class="px-4 py-4 sm:px-8 sm:py-6"
  x-data="{
    searchQuery: '',
    scope: 'all',
    sortBy: 'newest',
    createPortofolio: false,
    savingPortfolio: false,
    editingId: null,
    existingImages: [],
    formBaseline: '',
    editorDirty: false,
    deleteTarget: null,
    showDetail: false,
    selectedPortfolio: null,
    currentUserId: '',
    courseId: '',
    programName: '',
    programType: '',
    programCategory: '',
    courseProgramType: '',
    canCreatePortfolio: false,
    imageUploads: [{ id: 1, file: null, name: '{{t 'test.myPortfolio.modal.noFileChosen'}}', error: '' }],
    newForm: {
      title: '',
      description: '',
      link: '',
      overview: '',
      program: '',
      courseId: ''
    },
    overviewEditorInstance: null,
    portfolios: [],

    // Program milik student ini saja, kalau sudah ada. Satu student
    // hanya boleh punya satu portfolio per program, jadi ini juga
    // menentukan apakah tombol Create masih relevan.
    get myPortfolio() {
      return this.portfolios.find((item) => item.isMine) || null;
    },
    get hasActiveFilters() {
      return this.searchQuery.trim() !== '' || this.scope !== 'all' || this.sortBy !== 'newest';
    },
    filteredPortfolios() {
      const search = this.searchQuery.trim().toLowerCase();
      const list = this.portfolios.filter((item) => {
        if (this.scope === 'mine' && !item.isMine) return false;
        if (!search) return true;
        return item.title.toLowerCase().includes(search)
          || item.description.toLowerCase().includes(search)
          || item.author.toLowerCase().includes(search)
          || item.program.toLowerCase().includes(search);
      });

      const byNewest = (a, b) => new Date(b.createdAt || 0) - new Date(a.createdAt || 0);
      const byOldest = (a, b) => new Date(a.createdAt || 0) - new Date(b.createdAt || 0);
      const byTitle = (a, b) => a.title.localeCompare(b.title);

      ///stable: newest dulu mengikuti urutan server, jadi tidak perlu diurutkan
      // ulang setiap render.
      if (this.sortBy === 'oldest') return [...list].sort(byOldest);
      if (this.sortBy === 'title') return [...list].sort(byTitle);
      return list;
    },

    getFirstImage(item) {
      if (!item) return 'https://placehold.co/600x400/003060/FFFFFF?text=Kesatria+Portfolio';
      if (Array.isArray(item.images) && item.images.length > 0) return item.images[0];
      if (Array.isArray(item.image) && item.image.length > 0) return item.image[0];
      if (typeof item.image === 'string' && item.image.trim() !== '') return item.image;
      return 'https://placehold.co/600x400/003060/FFFFFF?text=Kesatria+Portfolio';
    },

    getUserInitial(item) {
      if (item && item.author && item.author.trim() !== '') {
        return item.author.charAt(0).toUpperCase();
      }
      return 'A';
    },

    init() {
      let payload = { currentUserId: '', course: null, items: [] };
      const island = document.getElementById('portfolio-data');
      if (island) {
        try { payload = JSON.parse(island.textContent) || payload; } catch (e) {}
      }

      this.currentUserId = payload.currentUserId || '';
      this.canCreatePortfolio = !!payload.canCreatePortfolio;
      this.courseId = (payload.course && payload.course.id) || '';
      this.programName = (payload.course && payload.course.name) || '';
      this.courseProgramType = (payload.course && payload.course.programType) || 'bootcamp';
      this.programType = (payload.course && payload.course.courseType && payload.course.courseType.name) || '';
      this.programCategory = (payload.course && payload.course.category && payload.course.category.name) || '';

      this.portfolios = (payload.items || []).map((p) => ({
        id: p.id,
        title: p.title || '{{t 'test.myPortfolio.untitledPortfolio'}}',
        description: p.description || '',
        link: p.link || '',
        overview: p.contentHtml || p.content || '',
        // overview dipakai panel detail (HTML siap tampil); contentRaw
        // adalah JSON EditorJS aslinya, yang dibutuhkan mode edit.
        contentRaw: p.content || '',
        createdAt: p.createdAt || '',
        courseId: (p.course && p.course.id) || '',
        program: (p.course && p.course.name) || this.programName,
        isMine: !!(p.user && p.user.id && p.user.id === this.currentUserId),
        // `classType` (tipe program) dan `category` (kategori) tadinya
        // sama-sama dibaca dari `course.category`, jadi filter Program Type
        // tidak pernah offers pilihan yang tidak juga ada di filter Category.
        // Keduanya kini dibaca dari relasinya masing-masing.
        classType: (p.course && p.course.courseType && p.course.courseType.name) || this.programType || '{{t 'test.myPortfolio.gallery.unknownType'}}',
        category: (p.course && p.course.category && p.course.category.name) || this.programCategory || '',
        technologies: (p.course && p.course.technologies) ? p.course.technologies : [],
        author: (p.user && p.user.username) ? p.user.username : 'Author',
        email: (p.user && p.user.email) ? p.user.email : '',
        avatar: (p.user && p.user.profile) ? p.user.profile : '',
        image: p.image && p.image.length > 0 ? p.image : [],
        images: p.image && Array.isArray(p.image) ? p.image : []
      }));

      // Pesan sukses dari aksi sebelum muat ulang (lihat submitPortfolio).
      try {
        const pending = sessionStorage.getItem('portfolioToast');
        if (pending) {
          sessionStorage.removeItem('portfolioToast');
          const detail = JSON.parse(pending);
          setTimeout(() => window.dispatchEvent(new CustomEvent('toast:success', { detail })), 400);
        }
      } catch (e) {}

      // EditorJS hanya hidup selama modal create terbuka. MemasuKKannya
      // ulang tiap kali modal dibuka, dan menghancurkan saat ditutup,
      // supaya tidak ada dua instance yang menulis ke field yang sama.
      this.$watch('createPortofolio', (value) => {
        if (value) {
          setTimeout(() => this.initOverviewEditor(), 300);
        } else if (this.overviewEditorInstance) {
          try {
            this.overviewEditorInstance.destroy();
          } catch (e) {}
          this.overviewEditorInstance = null;
        }
      });
    },

    resetFilters() {
      this.searchQuery = '';
      this.scope = 'all';
      this.sortBy = 'newest';
    },

    // Program di dalam panel ini selalu program yang sedang dibuka, jadi
    // Student tidak pernah memilih: galeri, tombol Create, dan tempat
    // portfolio disimpan semuanya terikat ke program itu.
    openCreatePortfolio() {
      if (this.myPortfolio) return;
      this.editingId = null;
      this.existingImages = [];
      this.newForm = { title: '', description: '', link: '', overview: '', program: this.programName, courseId: this.courseId };
      this.imageUploads = [{ id: 1, file: null, name: '{{t 'test.myPortfolio.modal.noFileChosen'}}', error: '' }];
      this.editorDirty = false;
      this.formBaseline = JSON.stringify(this.portfolioSnapshot());
      this.createPortofolio = true;
    },

    // Hanya bisa dipanggil untuk portfolio milik sendiri; pemanggilannya
    // sudah dijaga x-show='item.isMine', dan server menolaknya lagi.
    // Catatan: jangan pernah menulis tanda kutip ganda di dalam x-data.
    // Atribut HTML diakhiri oleh kutip ganda pertama, sehingga satu saja di
    // sini membuat seluruh JS setelahnya tampil sebagai teks di halaman.
    openEditPortfolio(item) {
      if (!item.isMine) return;
      this.editingId = item.id;
      this.existingImages = [...(item.images || [])];
      this.newForm = {
        title: item.title || '',
        description: item.description || '',
        link: item.link || '',
        overview: item.contentRaw || '',
        program: item.program || this.programName,
        courseId: this.courseId,
      };
      this.imageUploads = [{ id: 1, file: null, name: '{{t 'test.myPortfolio.modal.noFileChosen'}}', error: '' }];
      this.editorDirty = false;
      this.formBaseline = JSON.stringify(this.portfolioSnapshot());
      this.createPortofolio = true;
    },

    closePortfolioModal() {
      this.createPortofolio = false;
      this.editingId = null;
      this.existingImages = [];
      this.editorDirty = false;
    },

    removeExistingImage(url) {
      this.existingImages = this.existingImages.filter((item) => item !== url);
    },

    portfolioSnapshot() {
      const f = this.newForm;
      return {
        title: f.title,
        description: f.description,
        link: f.link,
        images: this.existingImages,
        files: this.imageUploads.filter((u) => u.file).map((u) => u.name),
      };
    },

    portfolioFormTouched() {
      if (this.editorDirty) return true;
      return JSON.stringify(this.portfolioSnapshot()) !== this.formBaseline;
    },

    // Isi awal editor saat menyunting. Yang tersimpan JSON EditorJS; kalau
    // bentuknya bukan itu (mis. baris lama), editor dibiarkan kosong daripada
    // gagal memuat.
    editorInitialData() {
      const raw = this.newForm.overview;
      if (!raw) return undefined;
      try {
        const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;
        return parsed && Array.isArray(parsed.blocks) ? parsed : undefined;
      } catch (e) {
        return undefined;
      }
    },

    askDeletePortfolio(item) {
      if (!item.isMine) return;
      this.deleteTarget = item;
    },

    canSubmitPortfolio() {
      const f = this.newForm;
      if (!f.title.trim() || !f.courseId) return false;
      if (!this.imageUploads.some((u) => u.file) && this.existingImages.length === 0) return false;
      if (this.imageUploads.some((u) => u.error)) return false;
      // Keterangan di bawah field link menjanjikan URL http/https; sebelum
      // ini tidak ada yang memeriksanya.
      if (f.link.trim() && !/^https?:\/\/\S+$/i.test(f.link.trim())) return false;
      return true;
    },

    handleFile(event, idx) {
      const file = event.target.files[0];
      if (!file) return;
      this.imageUploads[idx].file = file;
      this.imageUploads[idx].name = file.name;
      this.imageUploads[idx].error = '';
      this.checkImage(file, idx);
    },

    // Syarat berkas, disalin dari @ValidateImage pada POST /portfolio/create
    // (dimensi) dan dari keterangan di bawah kotak unggah. Diperiksa di sini
    // supaya student tahu sebelum menunggu unggahan gagal.
    checkImage(file, idx) {
      const TYPES = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
      const MAX = 5 * 1024 * 1024;
      if (!TYPES.includes(file.type)) {
        this.imageUploads[idx].error = '{{t 'test.myPortfolio.messages.invalidType'}}';
        return;
      }
      if (file.size > MAX) {
        this.imageUploads[idx].error = '{{t 'test.myPortfolio.messages.fileTooLarge'}}';
        return;
      }
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        const okW = img.naturalWidth >= 1900 && img.naturalWidth <= 1920;
        const okH = img.naturalHeight >= 1000 && img.naturalHeight <= 1080;
        this.imageUploads[idx].error = okW && okH
          ? ''
          : `${img.naturalWidth}x${img.naturalHeight}{{t 'test.myPortfolio.messages.dimensionError'}}`;
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        this.imageUploads[idx].error = '{{t 'test.myPortfolio.messages.unreadableImage'}}';
      };
      img.src = url;
    },

    addImageRow() {
      this.imageUploads.push({ id: Date.now(), file: null, name: '{{t 'test.myPortfolio.modal.noFileChosen'}}', error: '' });
    },

    async initOverviewEditor() {
      // Destroy previous instance if exists (for re-open scenarios)
      if (this.overviewEditorInstance) {
        try { this.overviewEditorInstance.destroy(); } catch(e) {}
        this.overviewEditorInstance = null;
      }

      // Wait for EditorJS library to load
      let libAttempts = 0;
      while (!window.EditorJS || !window.EditorTools) {
        libAttempts++;
        if (libAttempts > 30) {
          console.error('[Portfolio] EditorJS library not loaded after 6s.');
          this.fallbackOverviewTextarea();
          return;
        }
        await new Promise(resolve => setTimeout(resolve, 200));
      }

      // Wait for the holder element to be visible in the DOM
      let domAttempts = 0;
      const waitForVisible = () => new Promise((resolve, reject) => {
        const check = () => {
          domAttempts++;
          const el = document.getElementById('overviewEditor');
          if (el && el.offsetParent !== null) {
            resolve(el);
          } else if (domAttempts > 30) {
            reject(new Error('overviewEditor element not visible after 6s'));
          } else {
            setTimeout(check, 200);
          }
        };
        check();
      });

      try {
        await waitForVisible();
      } catch(e) {
        console.error('[Portfolio]', e.message);
        this.fallbackOverviewTextarea();
        return;
      }

      // Clear holder innerHTML before re-init
      const holder = document.getElementById('overviewEditor');
      if (holder) holder.innerHTML = '';

      try {
        this.overviewEditorInstance = new window.EditorJS({
          holder: 'overviewEditor',
          placeholder: 'Enter your content here...',
          data: this.editorInitialData(),
          onChange: () => { this.editorDirty = true; },
          tools: {
            header: {
              class: window.EditorTools.Header,
              inlineToolbar: ['link']
            },
            paragraph: {
              class: window.EditorTools.Paragraph,
              inlineToolbar: true
            },
            list: {
              class: window.EditorTools.List,
              inlineToolbar: true
            },
            marker: {
              class: window.EditorTools.Marker,
              shortcut: 'CMD+SHIFT+M'
            },
            image: {
              class: window.EditorTools.ImageTool,
              tunes: {
                stretched: false,
                withBorder: false,
                withBackground: false
              },
              config: {
                endpoints: {
                  byFile: '/portfolio/upload-image',
                  byUrl: '/portfolio/fetch-image'
                }
              }
            },
            linkTool: {
              class: window.EditorTools.LinkTool,
              config: {
                endpoint: '/portfolio/fetch-link'
              }
            }
          }
        });
        console.log('[Portfolio] Overview editor initialized successfully');
      } catch (e) {
        console.error('[Portfolio] Failed to initialize EditorJS:', e);
        this.fallbackOverviewTextarea();
      }
    },

    fallbackOverviewTextarea() {
      const holder = document.getElementById('overviewEditor');
      if (!holder) return;
      if (holder.tagName.toLowerCase() === 'textarea') return;

      const ta = document.createElement('textarea');
      ta.id = 'overviewEditor';
      ta.rows = 8;
      ta.placeholder = 'FALLBACK MODE: Enter your content here... (EditorJS failed to load)';
      ta.value = this.newForm.overview || '';
      ta.className = 'w-full min-h-[300px] rounded-[10px] border border-slate-300 p-4 font-inter text-sm sm:text-base text-black bg-white placeholder:text-[#676767] focus:outline-none focus:border-[#003060] transition-colors resize-none hover:shadow-sm';
      const self = this;
      ta.addEventListener('input', function () { self.newForm.overview = ta.value; });
      holder.replaceWith(ta);
    },

    async submitPortfolio() {
      if (this.savingPortfolio) return;
      if (!this.newForm.title.trim()) {
        showErrorToast('{{t 'test.myPortfolio.messages.saveErrorTitle'}}', '{{t 'test.myPortfolio.messages.titleRequired'}}');
        return;
      }

      let overviewData = this.newForm.overview;
      if (this.overviewEditorInstance) {
        try {
          const output = await this.overviewEditorInstance.save();
          overviewData = JSON.stringify(output);
        } catch (e) {
          console.error('Failed to save editor content:', e);
        }
      }

      // Textarea cadangan (dipakai saat EditorJS gagal dimuat) berisi teks
      // biasa, sedangkan server mem-parse `content` sebagai JSON EditorJS.
      // Bungkus teks polos itu menjadi satu blok paragraph supaya tidak
      // menggagalkan penyimpanan.
      if (typeof overviewData === 'string' && overviewData.trim() !== '') {
        let parsed = null;
        try { parsed = JSON.parse(overviewData); } catch (e) { parsed = null; }
        if (!parsed || !Array.isArray(parsed.blocks)) {
          overviewData = JSON.stringify({
            time: Date.now(),
            blocks: [{ type: 'paragraph', data: { text: overviewData } }]
          });
        }
      }

      const isEdit = !!this.editingId;
      const formData = new FormData();
      formData.append('title', this.newForm.title);
      formData.append('description', this.newForm.description || '');
      formData.append('link', this.newForm.link || '');
      formData.append('content', overviewData);

      let hasNewImage = false;
      this.imageUploads.forEach(item => {
        if (item.file) {
          formData.append('image', item.file);
          hasNewImage = true;
        }
      });

      // Gambar lama yang dipertahankan dikirim terpisah dari berkas baru;
      // lihat catatan `keepImages` di portfolios.controller.
      if (isEdit) {
        this.existingImages.forEach((url) => formData.append('keepImages', url));
      }

      if (!hasNewImage && this.existingImages.length === 0) {
        showErrorToast(
          '{{t 'test.myPortfolio.messages.saveErrorTitle'}}',
          isEdit ? '{{t 'test.myPortfolio.messages.imageRequiredEdit'}}' : '{{t 'test.myPortfolio.messages.imageRequiredCreate'}}',
        );
        return;
      }

      const courseId = this.courseId;
      if (!courseId) {
        showErrorToast('{{t 'test.myPortfolio.messages.saveErrorTitle'}}', '{{t 'test.myPortfolio.messages.programRequired'}}');
        return;
      }

      if (!isEdit) formData.append('courseId', courseId);

      this.savingPortfolio = true;
      try {
        const response = await fetch(
          isEdit ? `/portfolio/${this.editingId}/${courseId}` : '/portfolio/create',
          {
            method: isEdit ? 'PATCH' : 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          }
        );

        const result = await response.json().catch(() => ({}));

        if (response.ok) {
          // Halaman dimuat ulang supaya galerinya benar-benar dari server
          // (termasuk karya student lain yang mungkin baru muncul), jadi
          // toast-nya dititipkan dulu dan ditampilkan sesudah muat.
          try {
            sessionStorage.setItem('portfolioToast', JSON.stringify({
              title: isEdit ? '{{t 'test.myPortfolio.messages.updatedTitle'}}' : '{{t 'test.myPortfolio.messages.createdTitle'}}',
              description: isEdit ? '{{t 'test.myPortfolio.messages.updatedDesc'}}' : '{{t 'test.myPortfolio.messages.createdDesc'}}',
            }));
          } catch (e) {}
          window.location.href = window.location.pathname
            + '?tab=portfolio&courseId=' + encodeURIComponent(courseId);
        } else {
          showErrorToast('{{t 'test.myPortfolio.messages.saveErrorTitle'}}', result.message || '{{t 'test.myPortfolio.messages.tryAgain'}}');
        }
      } catch (err) {
        console.error('Error saving portfolio:', err);
        showErrorToast('{{t 'test.myPortfolio.messages.saveErrorTitle'}}', '{{t 'test.myPortfolio.messages.networkError'}}');
      } finally {
        this.savingPortfolio = false;
      }
    },
  }"
>
  {{!-- Satu-satunya jalan data masuk ke panel ini. `jsonSafe`, bukan `json`:
       `contentHtml` portfolio orang lain berisi teks yang bisa memuat
       `</script>`, dan blok script terpotong di situ. --}}
  <script type="application/json" id="portfolio-data">{{{jsonSafe portfolioData}}}</script>

  <!-- LIST PORTOFOLIO VIEW -->
  <div x-show="!showDetail" class="flex flex-col gap-7">

    <!--
      Filter.

      Sempat berupa sidebar 280px di kiri yang disembunyikan begitu program
      dibuka, sehingga di tab yang paling sering dipakai tidak ada filter
      sama sekali. Sekarang jadi satu baris horizontal. Yang tersisa bukan
      filter Category/Program Type: seluruh karya di panel ini berasal dari
      program yang sama, jadi kedua nilainya cuma satu dan dropdown-nya tidak
      pernah menyaring apa pun. Yang bisa membedakan karya satu sama lain
      di dalam program adalah siapa, kapan, dan isinya.
    -->
    <section class="flex flex-col gap-3 rounded-xl border border-[#d9d9d9] bg-white p-4">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center">
        <div class="relative w-full lg:max-w-sm">
          <span class="pointer-events-none absolute left-3.5 top-1/2 flex h-4 w-4 -translate-y-1/2 items-center justify-center text-[#737373]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </span>
          <input
            type="search"
            x-model="searchQuery"
            aria-label="{{t 'test.myPortfolio.search.ariaLabel'}}"
            placeholder="{{t 'test.myPortfolio.search.placeholder'}}"
            class="h-11 w-full rounded-lg border border-[#d4d4d4] bg-white py-2.5 pl-10 pr-3.5 font-inter text-sm leading-6 text-[#171717] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors placeholder:text-[#737373] hover:border-[#a3a3a3] focus:border-[#003060] focus:outline-none focus:ring-2 focus:ring-[#003060]/20"
          >
        </div>

        <label class="sr-only" for="portfolio-scope">{{t 'test.myPortfolio.gallery.scopeLabel'}}</label>
        <select
          id="portfolio-scope"
          x-model="scope"
          class="h-11 w-full cursor-pointer rounded-lg border border-[#d4d4d4] bg-white px-3.5 font-inter text-sm text-[#171717] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#a3a3a3] focus:border-[#003060] focus:outline-none focus:ring-2 focus:ring-[#003060]/20 lg:w-auto"
        >
          <option value="all">{{t 'test.myPortfolio.gallery.scopeAll'}}</option>
          <option value="mine">{{t 'test.myPortfolio.gallery.scopeMine'}}</option>
        </select>

        <label class="sr-only" for="portfolio-sort">{{t 'test.myPortfolio.gallery.sortLabel'}}</label>
        <select
          id="portfolio-sort"
          x-model="sortBy"
          class="h-11 w-full cursor-pointer rounded-lg border border-[#d4d4d4] bg-white px-3.5 font-inter text-sm text-[#171717] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#a3a3a3] focus:border-[#003060] focus:outline-none focus:ring-2 focus:ring-[#003060]/20 lg:w-auto"
        >
          <option value="newest">{{t 'test.myPortfolio.gallery.sortNewest'}}</option>
          <option value="oldest">{{t 'test.myPortfolio.gallery.sortOldest'}}</option>
          <option value="title">{{t 'test.myPortfolio.gallery.sortTitle'}}</option>
        </select>

        <button
          type="button"
          @click="resetFilters()"
          x-show="hasActiveFilters"
          x-cloak
          class="h-11 cursor-pointer rounded-lg border border-[#d4d4d4] bg-white px-3.5 font-inter text-sm font-medium text-[#0369A1] transition-colors hover:border-[#a3a3a3] hover:bg-[#F4F7FC]"
        >
          {{t 'test.myPortfolio.resetFilters'}}
        </button>

        <div class="flex flex-1 flex-col gap-2 sm:flex-row sm:items-center sm:justify-end">
          <span class="font-inter text-sm text-[#666666]">
            <span class="font-semibold text-[#003060]" x-text="filteredPortfolios().length"></span>
            {{t 'test.myPortfolio.gallery.projectCount'}}
          </span>

          {{!-- Student hanya boleh punya satu portfolio per program, jadi
               setelah ada satu, yang tersisa adalah menyuntingnya. Tombol
               Create disembunyikan - bukan hanya dinonaktifkan - karena
              Uoizard yang tidak bisa dipakai adalah jebakan.
               Selain itu, tombol juga disembunyikan sebelum student
               menyelesaikan seluruh week atau syllabus di program ini. --}}
          <button
            type="button"
            x-show="!myPortfolio && canCreatePortfolio"
            @click="openCreatePortfolio()"
            class="h-11 w-full cursor-pointer rounded-lg border border-[#003060] bg-[#003060] px-5 font-inter text-sm font-medium leading-none text-white shadow-md transition-all hover:bg-[#001f3f] sm:w-auto"
          >
            <i class="fa-solid fa-plus text-xs"></i>
            <span>{{t 'test.myPortfolio.createButton'}}</span>
          </button>
        </div>
      </div>

      <div
        x-show="myPortfolio"
        class="flex flex-col gap-3 rounded-lg border border-[#CFE6F5] bg-[#F4F7FC] px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="flex items-start gap-2 font-inter text-sm text-[#003060]">
          <i class="fa-solid fa-circle-check mt-0.5 text-xs text-[#0369A1]"></i>
          <span>{{t 'test.myPortfolio.gallery.mineNotice'}}</span>
        </p>
        <button
          type="button"
          @click="openEditPortfolio(myPortfolio)"
          class="inline-flex h-9 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-lg border border-[#003060] bg-white px-3.5 font-inter text-sm font-medium text-[#003060] transition-colors hover:bg-[#E0F2F9]"
        >
          <i class="fa-regular fa-pen-to-square text-xs"></i>
          <span>{{t 'test.myPortfolio.gallery.editMine'}}</span>
        </button>
      </div>

      {{!-- Keterangan mengapa tombol Create tidak muncul: hanya ditampilkan
           saat student belum menyelesaikan seluruh materi dan belum punya
           portofolio (kalau sudah punya, banner "edit" di atas sudah cukup).
           Pesan berbeda untuk bootcamp/lpk (wajib final assignment juga). --}}
      <div
        x-show="!canCreatePortfolio && !myPortfolio"
        x-cloak
        class="flex items-start gap-3 rounded-lg border border-[#FEF3C7] bg-[#FFFBEB] px-4 py-3"
      >
        <i class="fa-solid fa-lock mt-0.5 shrink-0 text-sm text-[#D97706]"></i>
        <p
          class="font-inter text-sm text-[#92400E]"
          x-text="(courseProgramType === 'bootcamp' || courseProgramType === 'lpk')
            ? '{{t 'test.myPortfolio.emptyStateCourse.lockedNoticeBootcamp'}}'
            : '{{t 'test.myPortfolio.emptyStateCourse.lockedNotice'}}'"
        ></p>
      </div>
    </section>

    <!-- EMPTY STATE: belum ada karya sama sekali di program ini -->
    <div
      x-show="portfolios.length === 0"
      class="flex flex-col items-center justify-center rounded-xl border border-[#E5E7EB] bg-white px-4 py-12 text-center sm:py-16"
    >
      <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-[#E0F2F9]">
        <template x-if="canCreatePortfolio">
          <i class="fa-regular fa-folder-open text-2xl text-[#0369A1]"></i>
        </template>
        <template x-if="!canCreatePortfolio">
          <i class="fa-solid fa-lock text-2xl text-[#D97706]"></i>
        </template>
      </div>

      <h2 class="mb-3 text-center font-inter text-xl font-semibold leading-none text-[#003060] sm:text-2xl">
        {{t 'test.myPortfolio.emptyStateCourse.title'}}
      </h2>

      <p
        class="mb-8 text-center font-inter text-sm font-normal leading-relaxed text-[#666666]"
        x-text="canCreatePortfolio
          ? '{{t 'test.myPortfolio.emptyStateCourse.description'}}'
          : (courseProgramType === 'bootcamp' || courseProgramType === 'lpk')
            ? '{{t 'test.myPortfolio.emptyStateCourse.lockedNoticeBootcamp'}}'
            : '{{t 'test.myPortfolio.emptyStateCourse.lockedNotice'}}'"
      ></p>

      <button
        type="button"
        x-show="!myPortfolio && canCreatePortfolio"
        @click="openCreatePortfolio()"
        class="flex h-11 cursor-pointer items-center justify-center gap-2 rounded-lg bg-[#003060] px-6 font-inter text-sm font-medium leading-none text-white shadow-md transition-all hover:bg-[#001f3f]"
      >
        <i class="fa-solid fa-plus text-sm"></i>
        <span>{{t 'test.myPortfolio.createButton'}}</span>
      </button>
    </div>

    <!-- EMPTY STATE: ada karya, tapi filter yang aktif menyingkirkan semuanya -->
    <div
      x-show="portfolios.length > 0 && filteredPortfolios().length === 0"
      class="flex flex-col items-center justify-center rounded-xl border border-[#E5E7EB] bg-white px-4 py-12 text-center sm:py-16"
    >
      <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-[#E0F2F9]">
        <i class="fa-solid fa-magnifying-glass text-2xl text-[#0369A1]"></i>
      </div>

      <h2 class="mb-3 text-center font-inter text-xl font-semibold leading-none text-[#003060] sm:text-2xl">
        {{t 'test.myPortfolio.projectNotFound'}}
      </h2>

      <p class="mb-8 text-center font-inter text-sm font-normal leading-relaxed text-[#666666]">
        {{t 'test.myPortfolio.tryAdjusting'}}
      </p>

      <button
        type="button"
        @click="resetFilters()"
        class="flex h-11 cursor-pointer items-center justify-center rounded-lg bg-[#003060] px-6 font-inter text-sm font-medium leading-none text-white transition-all hover:bg-[#001f3f]"
      >
        {{t 'test.myPortfolio.resetAllFilters'}}
      </button>
    </div>

    <!-- HAS DATA STATE: Portfolios Grid -->
    <div x-show="filteredPortfolios().length > 0" class="grid w-full grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pb-12">
      <template x-for="item in filteredPortfolios()" :key="item.id">
        {{!-- Pengait untuk pemeriksaan UI: satu kartu, satu id. --}}
        <div
          :data-portfolio-id="item.id"
          class="bg-white rounded-2xl border border-gray-100 shadow-[0_4px_20px_rgba(0,0,0,0.02)] hover:shadow-[0_12px_28px_rgba(0,0,0,0.06)] transition-all duration-300 flex flex-col overflow-hidden group"
        >
          <!-- Image Mockup / Cover -->
          <div class="relative aspect-[16/10] w-full bg-gray-100 overflow-hidden rounded-t-2xl">
            <img
              :src="getFirstImage(item)"
              :alt="item.title"
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='https://placehold.co/600x400/003060/FFFFFF?text=Kesatria+Portfolio'"
            />
          </div>

          <!-- Card Body -->
          <div class="p-5 flex-1 flex flex-col">
            <!-- Badges Row -->
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <!-- Category Badge -->
              <span
                class="inline-flex items-center px-2.5 py-1 text-[11px] font-semibold rounded-md bg-[#EEF2FF] text-[#4F46E5]"
                x-text="item.category || 'General'"
              ></span>
              <!-- Class Type Badge -->
              <span
                class="inline-flex items-center px-2.5 py-1 text-[11px] font-medium rounded-md bg-[#F1F5F9] text-[#64748B]"
                x-text="item.classType || 'Program'"
              ></span>
            </div>

            <!-- Project Title -->
            <h3
              class="font-bold text-[#0B1F3B] text-base leading-snug line-clamp-2 min-h-[44px] group-hover:text-[#003060] transition-colors font-inter"
              x-text="item.title || 'Untitled Project'"
              :title="item.title"
            ></h3>

            <!-- Project Description -->
            <p
              class="text-xs text-[#64748B] font-inter line-clamp-2 leading-relaxed mb-4"
              x-text="item.description || '-'"
              :title="item.description"
            ></p>

            <!-- Author Info Row -->
            <div class="flex items-center gap-2.5 pt-3 border-t border-gray-100 mb-4">
              <div class="size-8 rounded-full bg-[#E2E8F0] text-[#003060] font-bold text-xs flex items-center justify-center overflow-hidden shrink-0 border border-gray-200">
                <template x-if="item.avatar">
                  <img :src="item.avatar" :alt="item.author" class="w-full h-full object-cover">
                </template>
                <template x-if="!item.avatar">
                  <span x-text="getUserInitial(item)"></span>
                </template>
              </div>
              <div class="min-w-0 flex-1">
                <p
                  class="text-xs font-bold text-[#0B1F3B] truncate leading-tight"
                  x-text="item.author || 'Alumni'"
                ></p>
                <p class="text-[11px] text-[#94A3B8] font-normal truncate leading-tight mt-0.5">
                  {{t "test.portfolio.alumniRole"}}
                </p>
              </div>
            </div>

            <!-- Action Button: Detail / Edit / Delete -->
            <div class="mt-auto space-y-2">
              <button
                type="button"
                @click="selectedPortfolio = item; showDetail = true;"
                class="w-full py-2.5 px-4 bg-white border border-gray-200 hover:border-gray-300 hover:bg-gray-50 active:bg-gray-100 text-[#0B1F3B] text-xs font-semibold rounded-xl text-center transition-all block shadow-none cursor-pointer"
              >
                {{t "test.portfolio.detailButton"}}
              </button>
              <div x-show="item.isMine" class="flex items-center gap-2">
                <button
                  type="button"
                  @click="openEditPortfolio(item)"
                  class="flex h-9 flex-1 cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-[#D4D4D4] bg-white font-inter text-xs font-medium text-[#003060] transition-colors hover:border-[#a3a3a3] hover:bg-[#F5F5F5]"
                >
                  <i class="fa-regular fa-pen-to-square text-[11px]"></i>
                  {{t 'test.myPortfolio.editButton'}}
                </button>
                <button
                  type="button"
                  @click="askDeletePortfolio(item)"
                  class="flex h-9 flex-1 cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-[#fca5a5] bg-[#fef2f2] font-inter text-xs font-medium text-[#ef4444] transition-colors hover:bg-[#fee2e2]"
                >
                  <i class="fa-regular fa-trash-can text-[11px]"></i>
                  {{t 'test.myPortfolio.deleteButton'}}
                </button>
              </div>
            </div>
          </div>
        </div>
      </template>
    </div>

  </div>

  <!-- DETAIL PORTOFOLIO VIEW -->
  <div x-show="showDetail" x-cloak style="display: none;" class="!mt-0">
    {{> user/sidebar_user_profile/my_portofolio/detail/index }}
  </div>

  <!-- POP UP CREATE PORTOFOLIO MODAL -->
  <div
    x-cloak
    style="display: none;"
    x-show="createPortofolio"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
    @keydown.escape.window="if (!portfolioFormTouched()) closePortfolioModal()"
  >
    {{!-- Hanya menutup selama isiannya masih kosong: dulu satu klik di luar
         modal membuang formulir yang sudah terisi tanpa bertanya. --}}
    <div
      id="overviewModal"
      @click.away="if (!portfolioFormTouched()) closePortfolioModal()"
      class="relative max-h-[90vh] w-full max-w-4xl overflow-y-auto rounded-[24px] bg-white p-6 font-inter shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-10"
      style="color-scheme: light;"
    >
      <!-- Title Header -->
      <h2
        class="mb-8 font-inter text-2xl font-semibold leading-none text-[#003060] sm:text-4xl"
        x-text="editingId ? '{{t 'test.myPortfolio.modal.editTitle'}}' : '{{t 'test.myPortfolio.createPortfolio.createYourPortfolio'}}'"
      >{{t 'test.myPortfolio.createPortfolio.createYourPortfolio'}}</h2>

      <!-- Form Grid (2 Columns on Desktop) -->
      <form @submit.prevent="submitPortfolio()" class="space-y-8">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">

          <!-- LEFT COLUMN -->
          <div class="space-y-6">
            <!-- Portfolio Title -->
            <div class="space-y-3">
              <label class="block font-inter text-base font-semibold text-[#003060] sm:text-lg md:text-xl">
                {{t 'test.myPortfolio.createPortfolio.portfolioTittle'}}<span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                x-model="newForm.title"
                placeholder="{{t 'test.myPortfolio.createPortfolio.placeholderTittle'}}"
                class="h-[48px] w-full rounded-[10px] border border-[#D4D4D4] bg-white px-4 font-inter text-sm text-black placeholder:text-[#676767] transition-colors hover:shadow-sm focus:border-[#003060] focus:outline-none sm:text-base"
              >
            </div>

            <!-- Description -->
            <div class="space-y-3">
              <label class="block font-inter text-base font-semibold text-[#003060] sm:text-lg md:text-xl">
                {{t 'test.myPortfolio.createPortfolio.description'}}
              </label>
              <textarea
                rows="4"
                x-model="newForm.description"
                placeholder="{{t 'test.myPortfolio.createPortfolio.placeholderDescription'}}"
                class="w-full resize-none rounded-[10px] border border-[#D4D4D4] bg-white p-4 font-inter text-sm text-black placeholder:text-[#676767] transition-colors hover:shadow-sm focus:border-[#003060] focus:outline-none sm:text-base"
              ></textarea>
            </div>

            <!-- Program -->
            {{!-- Tidak pernah jadi dropdown. Panel ini hanya menampilkan
                 program yang sedang dibuka, dan satu student hanya boleh punya
                 satu portfolio per program, jadi "pilih program" di sini
                 hanya menawarkan satu jawaban yang sudah tahu. Ditampilkan
                 terkunci dengan alasannya. --}}
            <div class="space-y-3">
              <label class="block font-inter text-base font-semibold text-[#003060] sm:text-lg md:text-xl">
                {{t 'test.myPortfolio.detailPortfolio.program'}}<span class="text-red-500">*</span>
              </label>
              <div>
                <div class="flex h-[48px] items-center rounded-[10px] border border-[#D4D4D4] bg-[#F5F5F5] px-4 font-inter text-sm text-[#666666] sm:text-base" x-text="newForm.program || '{{t 'test.myPortfolio.detailPortfolio.program'}}'"></div>
                <p class="pt-1 font-inter text-xs font-normal text-[#666666]">
                  {{t 'test.myPortfolio.modal.programLockedHint'}}
                </p>
              </div>
            </div>

            <!-- Link* -->
            <div>
              <label class="mb-3 block font-inter text-base font-semibold text-[#003060] sm:text-lg md:text-xl">
                {{t 'test.myPortfolio.createPortfolio.link'}}
              </label>
              <input
                type="text"
                x-model="newForm.link"
                placeholder="{{t 'test.myPortfolio.createPortfolio.placeholderLink'}}"
                class="h-[48px] w-full rounded-[10px] border border-[#D4D4D4] bg-white px-4 font-inter text-sm text-black placeholder:text-[#676767] transition-colors hover:shadow-sm focus:border-[#003060] focus:outline-none sm:text-base"
              >
              <p class="pt-1 font-inter text-xs font-normal text-[#666666] sm:text-sm">
                {{t 'test.myPortfolio.createPortfolio.spanLink'}}
              </p>
            </div>
          </div>

          <!-- RIGHT COLUMN -->
          <div class="space-y-6">

            <!-- Project Overview -->
            <div class="space-y-3">
              <label class="block font-inter text-base font-semibold text-[#003060] sm:text-lg md:text-xl">
                {{t 'test.myPortfolio.createPortfolio.overview'}}
              </label>
              <div
                id="overviewEditor"
                x-ignore
                class="min-h-[300px] w-full max-w-none rounded-[10px] border border-[#D4D4D4] bg-white p-4 text-left font-inter text-sm text-black transition-colors hover:shadow-sm focus-within:border-[#003060] sm:text-base"
              ></div>
            </div>

            <!-- Upload Images* -->
            <div class="space-y-3">
              <label class="block font-inter text-base font-semibold text-[#003060] sm:text-lg md:text-xl">
                {{t 'test.myPortfolio.createPortfolio.uploadImages'}}<span class="text-red-500">*</span>
              </label>

              {{!-- Gambar yang sudah tersimpan. Yang dibuang di sini ikut
                   hilang begitu disimpan; sisanya dikirim lewat keepImages. --}}
              <template x-if="editingId && existingImages.length > 0">
                <div class="mb-3 space-y-2">
                  <template x-for="url in existingImages" :key="url">
                    <div class="flex items-center gap-3 rounded-[10px] border border-[#D4D4D4] bg-white px-3 py-2">
                      {{!-- Ikon di lapisan bawah, gambar menimpanya. Kalau
                           URL-nya mati, gambarnya dibuang dan ikonnya yang
                           terlihat - bukan kotak kosong. --}}
                      <span class="relative grid h-10 w-16 shrink-0 place-items-center overflow-hidden rounded bg-[#F1F5F9] text-[#94A3B8]">
                        <i class="fa-regular fa-image text-xs"></i>
                        <img :src="url" alt="" class="absolute inset-0 h-full w-full object-cover" onerror="this.remove()">
                      </span>
                      <span class="min-w-0 flex-1 truncate font-inter text-xs text-[#676767]" x-text="url.split('/').pop()"></span>
                      <button
                        type="button"
                        @click="removeExistingImage(url)"
                        class="shrink-0 px-2 py-1 text-xs text-red-500 transition-colors hover:text-red-700"
                        title="{{t 'test.myPortfolio.modal.removeThisImage'}}"
                      >
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </div>
                  </template>
                </div>
              </template>

              <!-- Dynamic File Chooser Rows -->
              <div class="max-h-[185px] space-y-3 overflow-y-auto p-1">
                <template x-for="(upload, idx) in imageUploads" :key="upload.id">
                  <div class="flex h-[52px] w-full items-center justify-between gap-3 rounded-[10px] border border-[#D4D4D4] bg-white px-3 hover:shadow-sm">
                    <div class="flex min-w-0 items-center gap-3">
                      <label class="flex-shrink-0 cursor-pointer rounded-[6px] bg-[#0B1F3B1A] px-4 py-2 font-inter text-sm font-medium text-black transition-colors hover:bg-slate-200">
                        {{t 'test.myPortfolio.modal.chooseFile'}}
                        <input type="file" class="hidden" accept="image/*" @change="handleFile($event, idx)">
                      </label>
                      <span class="truncate font-inter text-sm text-[#676767]" x-text="upload.name"></span>
                    </div>
                    <!-- Remove row button if more than 1 -->
                    <button
                      type="button"
                      x-show="imageUploads.length > 1"
                      @click="imageUploads.splice(idx, 1)"
                      class="cursor-pointer px-2 py-1 text-xs text-red-500 transition-colors hover:text-red-700"
                      title="{{t 'test.myPortfolio.modal.removeImage'}}"
                    >
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  </div>
                </template>
              </div>

              <!-- Allowed format subtitle -->
              <p class="pt-0.5 font-inter text-xs font-normal text-[#666666]">
                {{t 'test.myPortfolio.modal.formatSubtitle'}}
              </p>
              {{!-- Pesan ini muncul begitu berkas dipilih, bukan setelah
                   unggahannya ditolak server. Syaratnya sama persis dengan
                   @ValidateImage pada POST /portfolio/create. --}}
              <template x-for="upload in imageUploads.filter(u => u.error)" :key="'err-' + upload.id">
                <p class="flex items-start gap-1.5 font-inter text-xs text-[#dc2626]">
                  <i class="fa-solid fa-circle-exclamation mt-0.5"></i>
                  <span x-text="upload.name + ': ' + upload.error"></span>
                </p>
              </template>

              <!-- Dotted Add Image Box -->
              <div
                @click="addImageRow()"
                class="mt-3 flex h-[52px] w-full cursor-pointer items-center justify-center gap-2 rounded-[10px] border border-dashed border-[#D4D4D4] font-inter text-sm font-medium text-[#666666] transition-colors hover:bg-[#FAFAFA] sm:text-base"
              >
                <i class="fa-solid fa-plus text-xs"></i>
                <span>{{t 'test.myPortfolio.createPortfolio.addImage'}}</span>
              </div>
            </div>
          </div>

        </div>

        <!-- ACTION BUTTONS ROW (SAVE & CANCEL) -->
        <div class="flex items-center justify-center gap-4 pt-6">
          <button
            type="submit"
            :disabled="!canSubmitPortfolio() || savingPortfolio"
            class="flex h-[48px] w-full max-w-[240px] cursor-pointer items-center justify-center rounded-[8px] bg-[#003060] font-inter text-base font-semibold text-white shadow-md transition-all hover:bg-[#001f3f] disabled:pointer-events-none disabled:opacity-50 sm:text-lg"
          >
            <span x-text="savingPortfolio ? '{{t 'test.myPortfolio.modal.saving'}}' : (editingId ? '{{t 'test.myPortfolio.modal.saveChanges'}}' : '{{t 'test.myPortfolio.modal.save'}}')">{{t 'test.myPortfolio.modal.save'}}</span>
          </button>
          <button
            type="button"
            @click="closePortfolioModal()"
            class="w-full max-w-[240px] cursor-pointer rounded-[8px] border border-[#003060] bg-white font-inter text-base font-semibold text-[#003060] shadow-sm transition-all hover:bg-[#FAFAFA] sm:text-lg"
          >
            {{t 'test.myPortfolio.modal.cancel'}}
          </button>
        </div>
      </form>
    </div>
  </div>

  {{!--
    Konfirmasi hapus.

    Bentuknya mengikuti components/ui/super_admin/modal/delete_confirm, tetapi
    tidak memakainya: komponen itu menahan submit sebuah <form> yang sudah ada
    di halaman, sementara di sini yang dihapus baris dalam daftar Alpine. Yang
    dikirim tetap form sungguhan (POST + _method=DELETE) supaya pesan sukses
    dari server ikut tampil sesudah halaman kembali.
  --}}
  <div
    x-show="deleteTarget"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    class="fixed inset-0 z-50 flex items-center justify-center bg-[#0a0a0a]/70 p-4 backdrop-blur-[8px]"
    @keydown.escape.window="deleteTarget = null"
  >
    <div
      class="w-full max-w-[400px] rounded-xl bg-white p-6 font-inter shadow-[0px_8px_8px_-4px_rgba(0,0,0,0.03),0px_20px_24px_-4px_rgba(0,0,0,0.08)]"
      @click.away="deleteTarget = null"
    >
      <span class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full border-8 border-[#F2E1E1] bg-[#F4DDDD] text-[#c80606]">
        <i class="fa-regular fa-trash-can"></i>
      </span>

      <h3 class="text-center font-inter text-lg font-semibold leading-7 text-[#171717]">{{t 'test.myPortfolio.deleteConfirm.title'}}</h3>
      <p class="mt-2 text-center font-inter text-sm leading-5 text-[#525252]">
        <span class="font-semibold" x-text="deleteTarget ? deleteTarget.title : ''"></span>
        {{t 'test.myPortfolio.deleteConfirm.warningSuffix'}}
      </p>

      <form
