    </div>

        <div x-show="filteredPortfolios().length > 0" class="grid w-full grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pb-12">
      <template x-for="item in filteredPortfolios()" :key="item.id">
        <div
