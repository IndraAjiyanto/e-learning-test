<div
  class="px-4 py-4 sm:px-8 sm:py-6"
  x-data="{
    searchQuery: '',
    scope: 'all',
    sortBy: 'newest',
    createPortofolio: false,
    savingPortfolio: false,
    editingId: null,
    existingImages: [],
    formBaseline: '',
    editorDirty: false,
    deleteTarget: null,
    showDetail: false,
    selectedPortfolio: null,
    currentUserId: '',
    courseId: '',
    programName: '',
    programType: '',
    programCategory: '',
    courseProgramType: '',
    canCreatePortfolio: false,
    imageUploads: [{ id: 1, file: null, name: '{{t 'test.myPortfolio.modal.noFileChosen'}}', error: '' }],
    newForm: {
      title: '',
      description: '',
      link: '',
      overview: '',
      program: '',
      courseId: ''
    },
    overviewEditorInstance: null,
    portfolios: [],

    // Program milik student ini saja, kalau sudah ada. Satu student
    // hanya boleh punya satu portfolio per program, jadi ini juga
    // menentukan apakah tombol Create masih relevan.
    get myPortfolio() {
      return this.portfolios.find((item) => item.isMine) || null;
    },
    get hasActiveFilters() {
      return this.searchQuery.trim() !== '' || this.scope !== 'all' || this.sortBy !== 'newest';
    },
    filteredPortfolios() {
      const search = this.searchQuery.trim().toLowerCase();
      const list = this.portfolios.filter((item) => {
        if (this.scope === 'mine' && !item.isMine) return false;
        if (!search) return true;
        return item.title.toLowerCase().includes(search)
          || item.description.toLowerCase().includes(search)
          || item.author.toLowerCase().includes(search)
          || item.program.toLowerCase().includes(search);
      });

      const byNewest = (a, b) => new Date(b.createdAt || 0) - new Date(a.createdAt || 0);
      const byOldest = (a, b) => new Date(a.createdAt || 0) - new Date(b.createdAt || 0);
      const byTitle = (a, b) => a.title.localeCompare(b.title);

      let sorted = [...list];
      if (this.sortBy === 'oldest') sorted.sort(byOldest);
      else if (this.sortBy === 'title') sorted.sort(byTitle);
      else sorted.sort(byNewest);

      // Pastikan portfolio milik user sendiri selalu berada di paling pertama/kiri
      return sorted.sort((a, b) => {
        if (a.isMine && !b.isMine) return -1;
        if (!a.isMine && b.isMine) return 1;
        return 0;
      });
    },

    getFirstImage(item) {
      if (!item) return 'https://placehold.co/600x400/003060/FFFFFF?text=Kesatria+Portfolio';
      if (Array.isArray(item.images) && item.images.length > 0) return item.images[0];
      if (Array.isArray(item.image) && item.image.length > 0) return item.image[0];
      if (typeof item.image === 'string' && item.image.trim() !== '') return item.image;
      return 'https://placehold.co/600x400/003060/FFFFFF?text=Kesatria+Portfolio';
    },

    getUserInitial(item) {
      if (item && item.author && item.author.trim() !== '') {
        return item.author.charAt(0).toUpperCase();
      }
      return 'A';
    },

    init() {
      let payload = { currentUserId: '', course: null, items: [] };
      const island = document.getElementById('portfolio-data');
      if (island) {
        try { payload = JSON.parse(island.textContent) || payload; } catch (e) {}
      }

      this.currentUserId = payload.currentUserId || '';
      this.canCreatePortfolio = !!payload.canCreatePortfolio;
      this.courseId = (payload.course && payload.course.id) || '';
      this.programName = (payload.course && payload.course.name) || '';
      this.courseProgramType = (payload.course && payload.course.programType) || 'bootcamp';
      this.programType = (payload.course && payload.course.courseType && payload.course.courseType.name) || '';
      this.programCategory = (payload.course && payload.course.category && payload.course.category.name) || '';

      const items = (payload.items && payload.items.length > 0)
        ? payload.items
        : (window.backendPortfolioData || []);

      this.portfolios = (items || []).map((p) => ({
        id: p.id,
        title: p.title || '{{t 'test.myPortfolio.untitledPortfolio'}}',
        description: p.description || '',
        link: p.link || '',
        overview: p.content || p.contentHtml|| '',
        // overview dipakai panel detail (HTML siap tampil); contentRaw
        // adalah JSON EditorJS aslinya, yang dibutuhkan mode edit.
        contentRaw: p.content || p.contentHtml || '',
        createdAt: p.createdAt || '',
        courseId: (p.course && p.course.id) || '',
        program: (p.course && p.course.name) || this.programName,
        isMine: !!(p.user && p.user.id && p.user.id === this.currentUserId),
        // `classType` (tipe program) dan `category` (kategori) tadinya
        // sama-sama dibaca dari `course.category`, jadi filter Program Type
        // tidak pernah offers pilihan yang tidak juga ada di filter Category.
        // Keduanya kini dibaca dari relasinya masing-masing.
        classType: (p.course && p.course.courseType && p.course.courseType.name) || this.programType || '{{t 'test.myPortfolio.gallery.unknownType'}}',
        category: (p.course && p.course.category && p.course.category.name) || this.programCategory || '',
        technologies: (p.course && p.course.technologies) ? p.course.technologies : [],
        author: (p.user && p.user.username) ? p.user.username : 'Author',
        email: (p.user && p.user.email) ? p.user.email : '',
        avatar: (p.user && p.user.profile) ? p.user.profile : '',
        image: p.image && p.image.length > 0 ? p.image : [],
        images: p.image && Array.isArray(p.image) ? p.image : []
      }));

      // Pesan sukses dari aksi sebelum muat ulang (lihat submitPortfolio).
      try {
        const pending = sessionStorage.getItem('portfolioToast');
        if (pending) {
          sessionStorage.removeItem('portfolioToast');
          const detail = JSON.parse(pending);
          setTimeout(() => window.dispatchEvent(new CustomEvent('toast:success', { detail })), 400);
        }
      } catch (e) {}

      // EditorJS hanya hidup selama modal create terbuka. Memasukannya
      // ulang tiap kali modal dibuka, dan menghancurkan saat ditutup,
      // supaya tidak ada dua instance yang menulis ke field yang sama.
      this.$watch('createPortofolio', (value) => {
        const overflowVal = value ? 'hidden' : '';
        document.body.style.overflow = overflowVal;
        document.documentElement.style.overflow = overflowVal;
        if (value) {
          setTimeout(() => this.initOverviewEditor(), 300);
        } else if (this.overviewEditorInstance) {
          try {
            this.overviewEditorInstance.destroy();
          } catch (e) {}
          this.overviewEditorInstance = null;
        }
      });
    },

    resetFilters() {
      this.searchQuery = '';
      this.scope = 'all';
      this.sortBy = 'newest';
    },

    // Program di dalam panel ini selalu program yang sedang dibuka, jadi
    // Student tidak pernah memilih: galeri, tombol Create, dan tempat
    // portfolio disimpan semuanya terikat ke program itu.
    openCreatePortfolio() {
      if (this.myPortfolio) return;
      this.editingId = null;
      this.existingImages = [];
      this.newForm = { title: '', description: '', link: '', overview: '', program: this.programName, courseId: this.courseId };
      this.imageUploads = [{ id: 1, file: null, name: '{{t 'test.myPortfolio.modal.noFileChosen'}}', error: '' }];
      this.editorDirty = false;
      this.formBaseline = JSON.stringify(this.portfolioSnapshot());
      this.createPortofolio = true;
    },

    // Hanya bisa dipanggil untuk portfolio milik sendiri; pemanggilannya
    // sudah dijaga x-show='item.isMine', dan server menolaknya lagi.
    // Catatan: jangan pernah menulis tanda kutip ganda di dalam x-data.
    // Atribut HTML diakhiri oleh kutip ganda pertama, sehingga satu saja di
    // sini membuat seluruh JS setelahnya tampil sebagai teks di halaman.
    openEditPortfolio(item) {
      if (!item.isMine) return;
      this.editingId = item.id;
      this.existingImages = [...(item.images || [])];
      this.newForm = {
        title: item.title || '',
        description: item.description || '',
        link: item.link || '',
        overview: item.contentRaw || '',
        program: item.program || this.programName,
        courseId: this.courseId,
      };
      this.imageUploads = [{ id: 1, file: null, name: '{{t 'test.myPortfolio.modal.noFileChosen'}}', error: '' }];
      this.editorDirty = false;
      this.formBaseline = JSON.stringify(this.portfolioSnapshot());
      this.createPortofolio = true;
    },

    closePortfolioModal() {
      this.createPortofolio = false;
      this.editingId = null;
      this.existingImages = [];
      this.editorDirty = false;
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
    },

    removeExistingImage(url) {
      this.existingImages = this.existingImages.filter((item) => item !== url);
    },

    portfolioSnapshot() {
      const f = this.newForm;
      return {
        title: f.title,
        description: f.description,
        link: f.link,
        images: this.existingImages,
        files: this.imageUploads.filter((u) => u.file).map((u) => u.name),
      };
    },

    portfolioFormTouched() {
      if (this.editorDirty) return true;
      return JSON.stringify(this.portfolioSnapshot()) !== this.formBaseline;
    },

    // Isi awal editor saat menyunting. Mendukung format JSON EditorJS,
    // HTML (mis. hasil render / seed), maupun teks polos.
    editorInitialData() {
      const raw = this.newForm.overview;
      if (!raw) return undefined;

      let parsed = raw;
      if (typeof parsed === 'string') {
        const trimmed = parsed.trim();
        if (!trimmed) return undefined;
        try {
          parsed = JSON.parse(trimmed);
          if (typeof parsed === 'string') {
            try { parsed = JSON.parse(parsed); } catch (e) {}
          }
        } catch (e) {
          parsed = null;
        }
      }

      if (parsed && typeof parsed === 'object' && Array.isArray(parsed.blocks)) {
        return parsed;
      }

      if (typeof raw === 'string' && raw.trim()) {
        const trimmed = raw.trim();

        if (/<[a-z][\s\S]*>/i.test(trimmed)) {
          try {
            const doc = new DOMParser().parseFromString(trimmed, 'text/html');
            const blocks = [];
            const children = Array.from(doc.body.children);
            if (children.length > 0) {
              children.forEach((child) => {
                const tag = child.tagName.toLowerCase();
                if (/^h[1-6]$/.test(tag)) {
                  blocks.push({
                    type: 'header',
                    data: {
                      text: child.innerHTML || child.textContent || '',
                      level: parseInt(tag[1], 10),
                    },
                  });
                } else if (tag === 'ul' || tag === 'ol') {
                  const lis = Array.from(child.querySelectorAll('li')).map(
                    (li) => li.innerHTML || li.textContent || ''
                  );
                  blocks.push({
                    type: 'list',
                    data: {
                      style: tag === 'ol' ? 'ordered' : 'unordered',
                      items: lis,
                    },
                  });
                } else if (tag === 'blockquote') {
                  blocks.push({
                    type: 'quote',
                    data: {
                      text: child.innerHTML || child.textContent || '',
                    },
                  });
                } else {
                  const text = child.innerHTML || child.textContent || '';
                  if (text.trim()) {
                    blocks.push({
                      type: 'paragraph',
                      data: { text },
                    });
                  }
                }
              });
            }
            if (blocks.length > 0) {
              return { time: Date.now(), blocks };
            }
          } catch (e) {}
        }

        const paragraphs = trimmed
          .split(/\n\s*\n/)
          .map((p) => p.trim())
          .filter(Boolean);

        if (paragraphs.length > 0) {
          return {
            time: Date.now(),
            blocks: paragraphs.map((p) => ({
              type: 'paragraph',
              data: { text: p.replace(/\n/g, '<br>') },
            })),
          };
        }

        return {
          time: Date.now(),
          blocks: [{ type: 'paragraph', data: { text: trimmed } }],
        };
      }

      return undefined;
    },

    askDeletePortfolio(item) {
      if (!item.isMine) return;
      this.deleteTarget = item;
    },

    canSubmitPortfolio() {
      const f = this.newForm;
      if (!f.title.trim() || !f.courseId) return false;
      if (!this.imageUploads.some((u) => u.file) && this.existingImages.length === 0) return false;
      if (this.imageUploads.some((u) => u.error)) return false;
      // Keterangan di bawah field link menjanjikan URL http/https; sebelum
      // ini tidak ada yang memeriksanya.
      if (f.link.trim() && !/^https?:\/\/\S+$/i.test(f.link.trim())) return false;
      return true;
    },

    handleFile(event, idx) {
      const file = event.target.files[0];
      if (!file) return;
      this.imageUploads[idx].file = file;
      this.imageUploads[idx].name = file.name;
      this.imageUploads[idx].error = '';
      this.checkImage(file, idx);
    },

    // Syarat berkas, disalin dari @ValidateImage pada POST /portfolio/create
    // (dimensi) dan dari keterangan di bawah kotak unggah. Diperiksa di sini
    // supaya student tahu sebelum menunggu unggahan gagal.
    checkImage(file, idx) {
      const TYPES = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
      const MAX = 5 * 1024 * 1024;
      if (!TYPES.includes(file.type)) {
        this.imageUploads[idx].error = '{{t 'test.myPortfolio.messages.invalidType'}}';
        return;
      }
      if (file.size > MAX) {
        this.imageUploads[idx].error = '{{t 'test.myPortfolio.messages.fileTooLarge'}}';
        return;
      }
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        const okW = img.naturalWidth >= 1900 && img.naturalWidth <= 1920;
        const okH = img.naturalHeight >= 1000 && img.naturalHeight <= 1080;
        this.imageUploads[idx].error = okW && okH
          ? ''
          : `${img.naturalWidth}x${img.naturalHeight}{{t 'test.myPortfolio.messages.dimensionError'}}`;
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        this.imageUploads[idx].error = '{{t 'test.myPortfolio.messages.unreadableImage'}}';
      };
      img.src = url;
    },

    addImageRow() {
      this.imageUploads.push({ id: Date.now(), file: null, name: '{{t 'test.myPortfolio.modal.noFileChosen'}}', error: '' });
    },

    getOverviewHolder() {
      return (this.$root && this.$root.querySelector('#courseOverviewEditor'))
        || document.getElementById('courseOverviewEditor');
    },

    async initOverviewEditor() {
      // Destroy previous instance if exists (for re-open scenarios)
      if (this.overviewEditorInstance) {
        try {
          if (typeof this.overviewEditorInstance.destroy === 'function') {
            await this.overviewEditorInstance.destroy();
          }
        } catch (e) {}
        this.overviewEditorInstance = null;
      }

      if (!this.createPortofolio) return;

      // Ensure holder is a div element in case a previous fallback replaced it with textarea
      let holder = this.getOverviewHolder();
      if (holder && holder.tagName.toLowerCase() === 'textarea') {
        const div = document.createElement('div');
        div.id = 'courseOverviewEditor';
        div.setAttribute('x-ignore', '');
        div.className = 'min-h-[100px] max-h-[140px] overflow-y-auto w-full max-w-none rounded-[10px] border border-[#D4D4D4] bg-white p-4 text-left font-inter text-sm text-black transition-colors hover:shadow-sm focus-within:border-[#003060] sm:text-base';
        holder.replaceWith(div);
      }

      // Wait for EditorJS library to load
      let libAttempts = 0;
      while (!window.EditorJS || !window.EditorTools) {
        libAttempts++;
        if (libAttempts > 30) {
          console.error('[Portfolio] EditorJS library not loaded after 6s.');
          this.fallbackOverviewTextarea();
          return;
        }
        await new Promise(resolve => setTimeout(resolve, 200));
      }

      if (!this.createPortofolio) return;

      // Wait for the holder element to be visible in the DOM
      let domAttempts = 0;
      const waitForVisible = () => new Promise((resolve, reject) => {
        const check = () => {
          domAttempts++;
          const el = this.getOverviewHolder();
          if (el && (el.offsetParent !== null || el.getClientRects().length > 0)) {
            resolve(el);
          } else if (domAttempts > 30) {
            reject(new Error('courseOverviewEditor element not visible after 6s'));
          } else {
            setTimeout(check, 200);
          }
        };
        check();
      });

      try {
        await waitForVisible();
      } catch (e) {
        console.error('[Portfolio]', e.message);
        this.fallbackOverviewTextarea();
        return;
      }

      if (!this.createPortofolio) return;

      // Clear holder innerHTML before re-init
      holder = this.getOverviewHolder();
      if (holder) holder.innerHTML = '';

      try {
        this.overviewEditorInstance = new window.EditorJS({
          holder: holder,
          placeholder: 'Enter your content here...',
          data: this.editorInitialData(),
          minHeight: 0,
          onChange: () => { this.editorDirty = true; },
          tools: {
            header: {
              class: window.EditorTools.Header,
              inlineToolbar: ['link']
            },
            paragraph: {
              class: window.EditorTools.Paragraph,
              inlineToolbar: true
            },
            list: {
              class: window.EditorTools.List,
              inlineToolbar: true
            },
            marker: {
              class: window.EditorTools.Marker,
              shortcut: 'CMD+SHIFT+M'
            },
            image: {
              class: window.EditorTools.ImageTool,
              tunes: {
                stretched: false,
                withBorder: false,
                withBackground: false
              },
              config: {
                endpoints: {
                  byFile: '/portfolio/upload-image',
                  byUrl: '/portfolio/fetch-image'
                }
              }
            },
            linkTool: {
              class: window.EditorTools.LinkTool,
              config: {
                endpoint: '/portfolio/fetch-link'
              }
            }
          }
        });
        console.log('[Portfolio] Course overview editor initialized successfully');
      } catch (e) {
        console.error('[Portfolio] Failed to initialize EditorJS:', e);
        this.fallbackOverviewTextarea();
      }
    },

    getOverviewPlainText() {
      const raw = this.newForm.overview;
      if (!raw) return '';
      if (typeof raw === 'string') {
        const trimmed = raw.trim();
        if (trimmed.startsWith('{')) {
          try {
            const parsed = JSON.parse(trimmed);
            if (parsed && Array.isArray(parsed.blocks)) {
              return parsed.blocks
                .map(b => {
                  if (b.type === 'paragraph' || b.type === 'header') return b.data?.text || '';
                  if (b.type === 'list') return (b.data?.items || []).join('\n');
                  return b.data?.text || '';
                })
                .filter(Boolean)
                .join('\n\n');
            }
          } catch (e) {}
        }
        if (/<[a-z][\s\S]*>/i.test(trimmed)) {
          try {
            const doc = new DOMParser().parseFromString(trimmed, 'text/html');
            return doc.body.textContent || '';
          } catch (e) {}
        }
        return trimmed;
      }
      return '';
    },

    fallbackOverviewTextarea() {
      const holder = this.getOverviewHolder();
      if (!holder) return;
      if (holder.tagName.toLowerCase() === 'textarea') {
        holder.value = this.getOverviewPlainText();
        return;
      }

      const ta = document.createElement('textarea');
      ta.id = 'courseOverviewEditor';
      ta.rows = 8;
      ta.placeholder = 'FALLBACK MODE: Enter your content here... (EditorJS failed to load)';
      ta.value = this.getOverviewPlainText();
      ta.className = 'w-full min-h-[140px] rounded-[10px] border border-slate-300 p-4 font-inter text-sm sm:text-base text-black bg-white placeholder:text-[#676767] focus:outline-none focus:border-[#003060] transition-colors resize-none hover:shadow-sm';
      const self = this;
      ta.addEventListener('input', function () {
        self.newForm.overview = ta.value;
        self.editorDirty = true;
      });
      holder.replaceWith(ta);
    },

    async submitPortfolio() {
      if (this.savingPortfolio) return;
      if (!this.newForm.title.trim()) {
        showErrorToast('{{t 'test.myPortfolio.messages.saveErrorTitle'}}', '{{t 'test.myPortfolio.messages.titleRequired'}}');
        return;
      }

      let overviewData = this.newForm.overview;
      if (this.overviewEditorInstance) {
        try {
          const output = await this.overviewEditorInstance.save();
          overviewData = JSON.stringify(output);
        } catch (e) {
          console.error('Failed to save editor content:', e);
        }
      }

      // Pastikan overviewData selalu JSON EditorJS valid
      if (!overviewData || !overviewData.trim()) {
        overviewData = JSON.stringify({ time: Date.now(), blocks: [] });
      } else {
        let parsed = null;
        try { parsed = JSON.parse(overviewData); } catch (e) { parsed = null; }
        if (!parsed || !Array.isArray(parsed.blocks)) {
          overviewData = JSON.stringify({
            time: Date.now(),
            blocks: [{ type: 'paragraph', data: { text: overviewData } }]
          });
        }
      }

      const isEdit = !!this.editingId;
      const formData = new FormData();
      formData.append('title', this.newForm.title);
      formData.append('description', this.newForm.description || '');
      formData.append('link', this.newForm.link || '');
      formData.append('content', overviewData);

      let hasNewImage = false;
      this.imageUploads.forEach(item => {
        if (item.file) {
          formData.append('image', item.file);
          hasNewImage = true;
        }
      });

      // Gambar lama yang dipertahankan dikirim terpisah dari berkas baru;
      // lihat catatan `keepImages` di portfolios.controller.
      if (isEdit) {
        this.existingImages.forEach((url) => formData.append('keepImages', url));
      }

      if (!hasNewImage && this.existingImages.length === 0) {
        showErrorToast(
          '{{t 'test.myPortfolio.messages.saveErrorTitle'}}',
          isEdit ? '{{t 'test.myPortfolio.messages.imageRequiredEdit'}}' : '{{t 'test.myPortfolio.messages.imageRequiredCreate'}}',
        );
        return;
      }

      const courseId = this.courseId;
      if (!courseId) {
        showErrorToast('{{t 'test.myPortfolio.messages.saveErrorTitle'}}', '{{t 'test.myPortfolio.messages.programRequired'}}');
        return;
      }

      if (!isEdit) formData.append('courseId', courseId);

      this.savingPortfolio = true;
      try {
        const response = await fetch(
          isEdit ? `/portfolio/${this.editingId}/${courseId}` : '/portfolio/create',
          {
            method: isEdit ? 'PATCH' : 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          }
        );

        const result = await response.json().catch(() => ({}));

        if (response.ok) {
          // Halaman dimuat ulang supaya galerinya benar-benar dari server
          // (termasuk karya student lain yang mungkin baru muncul), jadi
          // toast-nya dititipkan dulu dan ditampilkan sesudah muat.
          try {
            sessionStorage.setItem('portfolioToast', JSON.stringify({
              title: isEdit ? '{{t 'test.myPortfolio.messages.updatedTitle'}}' : '{{t 'test.myPortfolio.messages.createdTitle'}}',
              description: isEdit ? '{{t 'test.myPortfolio.messages.updatedDesc'}}' : '{{t 'test.myPortfolio.messages.createdDesc'}}',
            }));
          } catch (e) {}
          window.location.href = window.location.pathname
            + '?tab=portfolio&courseId=' + encodeURIComponent(courseId);
        } else {
          showErrorToast('{{t 'test.myPortfolio.messages.saveErrorTitle'}}', result.message || '{{t 'test.myPortfolio.messages.tryAgain'}}');
        }
      } catch (err) {
        console.error('Error saving portfolio:', err);
        showErrorToast('{{t 'test.myPortfolio.messages.saveErrorTitle'}}', '{{t 'test.myPortfolio.messages.networkError'}}');
      } finally {
        this.savingPortfolio = false;
      }
    },
  }"
>
  <script type="application/json" id="portfolio-data">{{{jsonSafe portfolioData}}}</script>

  <!-- LIST PORTOFOLIO VIEW -->
  <div x-show="!showDetail" class="flex flex-col gap-7">

    <section class="flex flex-col gap-3 rounded-xl border border-[#d9d9d9] bg-white p-4">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center">
