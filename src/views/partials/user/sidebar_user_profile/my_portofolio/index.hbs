      <h3 class="text-center font-inter text-lg font-semibold leading-7 text-[#171717]">{{t 'test.myPortfolio.deleteConfirm.title'}}</h3>
      <p class="mt-2 text-center font-inter text-sm leading-5 text-[#525252]">
        <span class="font-semibold" x-text="deleteTarget ? deleteTarget.title : ''"></span>
        {{t 'test.myPortfolio.deleteConfirm.warningSuffix'}}
      </p>

      <form
        method="POST"
        :action="deleteTarget ? '/portfolio/' + deleteTarget.id + '/' + deleteTarget.courseId + '?_method=DELETE' : ''"
        class="mt-8 flex w-full gap-3"
      >
        <button
          type="button"
          @click="deleteTarget = null"
          class="inline-flex h-11 flex-1 cursor-pointer items-center justify-center rounded-lg border border-[#d4d4d4] bg-white px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-[#404040] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#f5f5f5]"
        >
          {{t 'test.myPortfolio.deleteConfirm.cancel'}}
        </button>
        <button
          type="submit"
          class="inline-flex h-11 flex-1 cursor-pointer items-center justify-center rounded-lg border border-[#e84338] bg-[#e84338] px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#d13328]"
        >
          {{t 'test.myPortfolio.deleteConfirm.delete'}}
        </button>
      </form>
    </div>
  </div>

</div>

