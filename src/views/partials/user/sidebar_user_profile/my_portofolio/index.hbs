            class="inline-flex h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-lg border border-[#003060] bg-[#003060] px-5 font-inter text-sm font-medium leading-none text-white shadow-md transition-all hover:bg-[#001f3f] sm:w-auto"
          >
