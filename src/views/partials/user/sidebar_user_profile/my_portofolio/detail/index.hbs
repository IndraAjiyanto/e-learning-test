<!-- DETAIL PORTOFOLIO PARTIAL -->
<div class="w-full space-y-8 pb-12 font-inter mb-28">
  
  <!-- Back Button -->
  <div>
    <button 
      type="button" 
      @click="showDetail = false"
      class="inline-flex items-center gap-2 font-inter font-medium text-sm sm:text-base text-[#003060] hover:text-[#001f3f] transition-colors cursor-pointer"
    >
      <i class="fa-solid fa-arrow-left text-sm"></i>
      <span>{{t "test.myPortfolio.detailPortfolio.backProgram"}}</span>
    </button>
  </div>

  <!-- HEADER SECTION -->
    <div class="text-center max-w-4xl mx-auto space-y-5">
      {{!-- Judulnya dulu "My Portofolio" dengan kalimat milik galeri publik
           ("koleksi karya alumni bootcamp"), padahal yang dibuka satu karya
           milik student sendiri. Sekarang judulnya karya itu. --}}
      <h1
        class="font-inter font-semibold text-2xl sm:text-3xl text-[#003060] leading-tight mb-2"
        x-text="selectedPortfolio ? selectedPortfolio.title : '{{t 'test.myPortfolio.title'}}'"
      ></h1>
    </div>

  <!-- Hero Image Showcase Carousel -->
  <div class="text-center space-y-6">
    <div 
      class="w-full max-w-[600px] h-[280px] sm:h-[340px] mx-auto rounded-[16px] overflow-hidden bg-slate-200 shadow-md border border-[#E5E5E5]/80 relative group"
      x-data="{ currentDetailImg: 0 }"
      x-effect="if (selectedPortfolio) currentDetailImg = 0"
    >
      <!-- Images -->
      {{!-- Sama seperti di kartu: tanpa gambar, yang muncul keterangan kosong,
           bukan foto stok Unsplash. --}}
      <template x-if="!selectedPortfolio || !selectedPortfolio.images || selectedPortfolio.images.length === 0">
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-[#94A3B8]">
          <i class="fa-regular fa-image text-3xl"></i>
          <span class="font-inter text-sm">{{t "test.myPortfolio.noImage"}}</span>
        </div>
      </template>
      <template x-for="(imgSrc, imgIdx) in (selectedPortfolio && selectedPortfolio.images ? selectedPortfolio.images : [])" :key="imgIdx">
        <img 
          :src="imgSrc" 
          :alt="selectedPortfolio ? selectedPortfolio.title : ''" 
          onerror="this.remove()"
          x-show="currentDetailImg === imgIdx" 
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-100 scale-100"
          class="w-full h-full object-cover absolute inset-0"
        >
      </template>

      <!-- Left/Right Arrow Navigation Controls -->
      <template x-if="selectedPortfolio && selectedPortfolio.images && selectedPortfolio.images.length > 1">
        <div class="absolute inset-0 flex items-center justify-between p-3 opacity-90 group-hover:opacity-100 transition-opacity pointer-events-none z-10">
          <button 
            type="button" 
            @click="currentDetailImg = (currentDetailImg === 0) ? selectedPortfolio.images.length - 1 : currentDetailImg - 1"
            class="w-9 h-9 rounded-full bg-black/60 hover:bg-black text-white flex items-center justify-center pointer-events-auto transition-transform active:scale-95 shadow-md cursor-pointer"
          >
            <i class="fa-solid fa-chevron-left text-sm"></i>
          </button>
          <button 
            type="button" 
            @click="currentDetailImg = (currentDetailImg === selectedPortfolio.images.length - 1) ? 0 : currentDetailImg + 1"
            class="w-9 h-9 rounded-full bg-black/60 hover:bg-black text-white flex items-center justify-center pointer-events-auto transition-transform active:scale-95 shadow-md cursor-pointer"
          >
            <i class="fa-solid fa-chevron-right text-sm"></i>
          </button>
        </div>
      </template>

      <!-- Indicator Dots -->
      <template x-if="selectedPortfolio && selectedPortfolio.images && selectedPortfolio.images.length > 1">
        <div class="absolute bottom-3 left-0 right-0 flex items-center justify-center gap-1.5 z-10 pointer-events-none">
          <template x-for="(imgSrc, imgIdx) in selectedPortfolio.images" :key="imgIdx">
            <button 
              type="button" 
              @click="currentDetailImg = imgIdx"
              class="h-2 rounded-full transition-all pointer-events-auto cursor-pointer"
              :class="currentDetailImg === imgIdx ? 'w-5 bg-white' : 'w-2 bg-white/60 hover:bg-white'"
            ></button>
          </template>
        </div>
      </template>
    </div>

    {{!-- Judul karya sudah menjadi judul halaman di atas; yang tersisa di sini
         hanya penanda tipe kelasnya. --}}
    <!-- Class Type Badge -->
    <div class="text-center">
      <span 
        class="inline-flex items-center justify-center bg-[#0B1F3B1A] text-black font-inter font-medium text-base sm:text-lg px-6 py-2 rounded-[6px]"
        x-text="selectedPortfolio ? selectedPortfolio.classType : 'Short Class'"
      >
        Short Class
      </span>
    </div>
  </div>

  <!-- 2-Column Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start pt-4">
    
    <!-- LEFT COLUMN (Span 7) -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- Project Description Card -->
      <div class="bg-[#FFFFFF] rounded-2xl p-6 sm:p-8 border border-[#D9D9D9]">
        <h2 class="font-inter font-bold text-[18px] leading-[24px] text-[#003060] mb-3 pb-3 border-b border-[#D9D9D9]">
          {{t "test.myPortfolio.detailPortfolio.projectDescription"}}
        </h2>
        <div class="font-inter font-normal text-[16px] leading-[26px] text-[#475569]">
          <p 
            x-show="selectedPortfolio && selectedPortfolio.description"
            x-text="selectedPortfolio ? selectedPortfolio.description : ''"
          ></p>
          <p 
            x-show="!selectedPortfolio || !selectedPortfolio.description"
            class="text-gray-400 italic"
          >
            No description provided.
          </p>
        </div>
      </div>

      <!-- Project Overview Card -->
      <div class="bg-[#FFFFFF] rounded-2xl p-6 sm:p-8 border border-[#D9D9D9]">
        <h2 class="font-inter font-bold text-[18px] leading-[24px] text-[#003060] mb-3 pb-3 border-b border-[#D9D9D9]">
          {{t "test.myPortfolio.detailPortfolio.overview"}}
        </h2>
        <div 
          id="overviewDetail"
          class="font-inter font-normal text-[16px] leading-[26px] text-[#475569] prose prose-sm max-w-none"
          x-html="renderOverview(selectedPortfolio ? selectedPortfolio.overview : '') || '<p class=\'italic text-gray-400\'>{{t 'test.myPortfolio.detailPortfolio.noOverview'}}</p>'"
        ></div>
      </div>

      <!-- Technologies Used Card -->
      <div class="bg-white border border-[#E5E5E5]/80 rounded-[12px] p-6 shadow-sm space-y-4">
        <h3 class="font-inter font-semibold text-lg sm:text-xl text-[#003060] leading-none">
          {{t "test.myPortfolio.detailPortfolio.technologiesUsed"}}
        </h3>
        <div class="flex flex-wrap gap-2">
          <template x-for="tech in (selectedPortfolio && selectedPortfolio.technologies ? selectedPortfolio.technologies : [])" :key="tech.id || tech.name">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#CFE6F5] text-[#003060] rounded-[6px] font-inter font-medium text-sm sm:text-base">
              <template x-if="tech.svg">
                <span x-html="tech.svg" class="w-5 h-5 flex-shrink-0 [&>svg]:w-5 [&>svg]:h-5"></span>
              </template>
              <template x-if="!tech.svg && tech.imgUrl">
                <img :src="tech.imgUrl" :alt="tech.name" class="w-5 h-5 flex-shrink-0 object-contain">
              </template>
              <span x-text="tech.name"></span>
            </span>
          </template>
          <template x-if="!selectedPortfolio || !selectedPortfolio.technologies || selectedPortfolio.technologies.length === 0">
            <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-[#CFE6F5] text-[#003060] rounded-[6px] font-inter font-medium text-sm sm:text-base" x-text="selectedPortfolio ? selectedPortfolio.category : '{{t 'test.myPortfolio.detailPortfolio.program'}}'">{{t 'test.myPortfolio.detailPortfolio.program'}}</span>
          </template>
        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN (Span 5) -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Student Profile Card -->
      <div class="bg-white border border-[#E5E5E5]/80 rounded-[12px] p-6 shadow-sm space-y-6 font-inter">
        <h3 class="font-inter font-semibold text-lg sm:text-xl text-[#003060] leading-none">
          {{t 'test.myPortfolio.detailPortfolio.studentProfile'}}
        </h3>

        <!-- Author Profile Row -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-[#E0F1F9] flex items-center justify-center flex-shrink-0 text-[#003060] font-semibold text-sm overflow-hidden">
            {{!-- Cadangannya dulu sebuah gambar dari CDN Roblox. Sekarang
                 huruf awal nama student, seperti avatar di tempat lain. --}}
            <img 
              x-show="selectedPortfolio && selectedPortfolio.avatar"
              :src="selectedPortfolio ? selectedPortfolio.avatar : ''" 
              alt="" 
              class="w-full h-full object-cover" 
              onerror="this.style.display='none'"
            >
            <span x-show="!selectedPortfolio || !selectedPortfolio.avatar" x-text="selectedPortfolio && selectedPortfolio.author ? selectedPortfolio.author.charAt(0) : '?'">?</span>
          </div>
          <div class="flex flex-col min-w-0">
            <span class="font-inter font-semibold text-base text-black leading-tight truncate" x-text="selectedPortfolio ? selectedPortfolio.author : 'Trisna'">Trisna</span>
            <span class="font-sans font-normal text-xs text-[#666666] truncate" x-text="selectedPortfolio ? selectedPortfolio.email : 'trisna@gmail.com'">trisna@gmail.com</span>
          </div>
        </div>

        <!-- Detail Item 1: Program Completed -->
        <div class="flex items-start gap-3">
          <i class="fa-regular fa-circle-check text-base text-black mt-1 flex-shrink-0"></i>
          <div class="space-y-1">
            <p class="font-inter font-semibold text-sm sm:text-base text-[#003060] leading-none">
              {{t 'test.myPortfolio.detailPortfolio.program'}}
            </p>
            <p
              class="font-inter font-normal text-xs sm:text-sm text-[#666666]"
              x-text="(selectedPortfolio && selectedPortfolio.program) || '{{t 'test.myPortfolio.detailPortfolio.notRecorded'}}'"
            ></p>
          </div>
        </div>

        <!-- Detail Item 2: Completion Date -->
        <div class="flex items-start gap-3">
          <i class="fa-regular fa-calendar text-base text-black mt-1 flex-shrink-0"></i>
          <div class="space-y-1">
            <p class="font-inter font-semibold text-sm sm:text-base text-[#003060] leading-none">
              {{t 'test.myPortfolio.detailPortfolio.submitted'}}
            </p>
            <p
              class="font-inter font-normal text-xs sm:text-sm text-[#666666]"
              x-text="selectedPortfolio && selectedPortfolio.createdAt
                ? new Date(selectedPortfolio.createdAt).toLocaleDateString(undefined, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
                : '{{t 'test.myPortfolio.detailPortfolio.notRecorded'}}'"
            ></p>
          </div>
        </div>

        {{!-- "Project Duration: 0 Months" dihapus: tidak ada kolom lama
             pengerjaan di mana pun, jadi angkanya tidak pernah berasal dari
             portfolio yang sedang dibuka. --}}

      </div>

      {{!-- Hanya muncul kalau portfolio-nya memang punya tautan. Dulu
           href-nya jatuh ke '#', jadi tombolnya tetap ada tetapi tidak
           membawa ke mana pun. --}}
      <a 
        x-show="selectedPortfolio && selectedPortfolio.link"
        x-cloak
        :href="selectedPortfolio ? selectedPortfolio.link : ''" 
        target="_blank"
        rel="noopener"
        class="w-full h-11 rounded-lg bg-[#003060] hover:bg-[#001f3f] text-white font-inter font-semibold text-sm flex items-center justify-center text-center transition-all cursor-pointer shadow-md no-underline"
      >
        {{t "test.myPortfolio.detailPortfolio.visitProject"}}
      </a>

      <!-- Share To Social Media Card (ClickUp z8pbk8xwza) -->
      {{> components/ui/portfolio/share_card }}

    </div>

  </div>

</div>
