<!-- DETAIL PORTOFOLIO PARTIAL -->
<div class="w-full max-w-6xl mx-auto pb-12 font-inter mb-28">

  <!-- Back Button & Breadcrumbs Navigation -->
  <div class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-2">
    <button
      type="button"
      @click="showDetail = false; $dispatch('portfolio-view-detail', false); window.scrollTo({ top: 0, behavior: 'smooth' });"
      class="inline-flex h-9 shrink-0 items-center gap-2 rounded-[8px] border border-[#D4D4D4] bg-white px-3.5 font-inter text-sm font-semibold text-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#F5F5F5] cursor-pointer"
    >
      <i class="fa-solid fa-arrow-left text-xs"></i>
      <span>{{default (t "test.common.back") "Kembali"}}</span>
    </button>

    <nav aria-label="{{t 'test.common.breadcrumb'}}" class="min-w-0">
      <template x-if="activeSection === 'course-portfolio'">
        <ol class="flex flex-wrap items-center gap-2 font-inter text-xs text-[#718096]">
          <li class="flex items-center gap-1.5">
            <button
              type="button"
              @click="toggleActiveSection('dashboard')"
              class="inline-flex items-center gap-1.5 cursor-pointer font-medium text-[#718096] hover:text-[#003060] hover:underline"
            >
              <i class="ph ph-house text-xs text-[#718096]"></i>
              <span>{{t 'test.common.home'}}</span>
            </button>
          </li>
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="text-[#718096]">/</span>
            <button
              type="button"
              @click="toggleActiveSection('learning')"
              class="inline-flex items-center gap-1.5 cursor-pointer font-medium text-[#718096] hover:text-[#003060] hover:underline"
            >
              <i class="ph ph-book-open text-xs text-[#718096]"></i>
              <span>{{t 'test.userSidebar.myLearning'}}</span>
            </button>
          </li>
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="text-[#718096]">/</span>
            <button
              type="button"
              @click="showDetail = false; $dispatch('portfolio-view-detail', false); window.scrollTo({ top: 0, behavior: 'smooth' });"
              class="inline-flex items-center gap-1.5 cursor-pointer font-medium text-[#718096] hover:text-[#003060] hover:underline"
            >
              <i class="ph ph-briefcase text-xs text-[#718096]"></i>
              <span>{{t 'test.startLearning.portfolio'}}</span>
            </button>
          </li>
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="text-[#718096]">/</span>
            <span class="inline-flex items-center gap-1.5 font-semibold text-[#003060]">
              <i class="ph ph-file-text text-xs text-[#003060]"></i>
              <span aria-current="page" class="max-w-[180px] sm:max-w-xs truncate" x-text="selectedPortfolio ? selectedPortfolio.title : '{{default (t 'test.detailPortfolio.pageTitle') 'Detail Portofolio'}}'"></span>
            </span>
          </li>
        </ol>
      </template>

      <template x-if="activeSection !== 'course-portfolio'">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-inter text-sm text-[#737373]">
          <li class="flex items-center gap-1.5">
            <button
              type="button"
              @click="toggleActiveSection('dashboard')"
              class="inline-flex items-center gap-1.5 cursor-pointer text-[#525252] transition-colors hover:text-[#003060] hover:underline"
            >
              <i class="ph ph-house text-sm text-[#737373]"></i>
              <span>{{t 'test.common.home'}}</span>
            </button>
          </li>
          <li class="flex min-w-0 items-center gap-2">
            <span aria-hidden="true" class="text-[#D4D4D4]">/</span>
            <button
              type="button"
              @click="showDetail = false; $dispatch('portfolio-view-detail', false); window.scrollTo({ top: 0, behavior: 'smooth' });"
              class="inline-flex items-center gap-1.5 cursor-pointer text-[#525252] transition-colors hover:text-[#003060] hover:underline"
            >
              <i class="ph ph-briefcase text-sm text-[#737373]"></i>
              <span>{{t 'test.startLearning.portfolio'}}</span>
            </button>
          </li>
          <li class="flex min-w-0 items-center gap-2">
            <span aria-hidden="true" class="text-[#D4D4D4]">/</span>
            <span aria-current="page" class="inline-flex items-center gap-1.5 truncate font-semibold text-[#003060] max-w-[200px] sm:max-w-md">
              <i class="ph ph-file-text text-sm text-[#003060]"></i>
              <span class="truncate" x-text="selectedPortfolio ? selectedPortfolio.title : '{{default (t 'test.detailPortfolio.pageTitle') 'Detail Portofolio'}}'"></span>
            </span>
          </li>
        </ol>
      </template>
    </nav>
  </div>

  <!-- Header -->
  <div class="text-center mb-8">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#E6F7F5] rounded-full text-[#006D77] text-xs font-bold border border-[#B3E8E3] shadow-sm">
      <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-5.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path>
      </svg>
      <span x-text="selectedPortfolio && selectedPortfolio.program ? selectedPortfolio.program : '{{default (t 'test.detailPortfolio.defaultProgram') 'SEMINAR - PORTFOLIO SHOWCASE'}}'"></span>
    </div>

    <h1
      class="text-3xl md:text-5xl font-extrabold text-[#003060] mt-3 mb-2 tracking-tight font-inter"
      x-text="selectedPortfolio ? selectedPortfolio.title : ''"
    ></h1>
  </div>

  <!-- Showcase Image Gallery -->
  <div
    class="mb-12"
    x-data="{
      currentIndex: 0,
      get images() {
        const imgs = (selectedPortfolio && selectedPortfolio.images) ? selectedPortfolio.images : [];
        return imgs.length ? imgs : ['https://placehold.co/1200x700/003060/FFFFFF?text=Kesatria+Portfolio'];
      },
      next() {
        if (this.images.length > 1) {
          this.currentIndex = (this.currentIndex + 1) % this.images.length;
        }
      },
      prev() {
        if (this.images.length > 1) {
          this.currentIndex = (this.currentIndex - 1 + this.images.length) % this.images.length;
        }
      },
      goTo(index) {
        this.currentIndex = index;
      }
    }"
    x-effect="if (selectedPortfolio) currentIndex = 0"
  >
    <div class="relative max-w-4xl mx-auto rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl bg-[#0B1528] border border-gray-800/20 group">
      <div class="relative aspect-[16/10] sm:aspect-[16/9] w-full flex items-center justify-center bg-gray-950">
        <img
          :src="images[currentIndex]"
          :alt="selectedPortfolio ? selectedPortfolio.title : ''"
          class="w-full h-full object-cover transition-all duration-500"
          onerror="this.src='https://placehold.co/1200x700/003060/FFFFFF?text=Kesatria+Portfolio'"
        />

        <template x-if="images.length > 1">
          <div class="absolute inset-0 flex items-center justify-between p-4 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-200">
            <button
              type="button"
              @click.prevent.stop="prev()"
              class="size-10 bg-black/60 hover:bg-black/80 text-white rounded-full flex items-center justify-center backdrop-blur-md pointer-events-auto transition shadow-lg hover:scale-110"
              aria-label="Previous image"
            >
              <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            </button>
            <button
              type="button"
              @click.prevent.stop="next()"
              class="size-10 bg-black/60 hover:bg-black/80 text-white rounded-full flex items-center justify-center backdrop-blur-md pointer-events-auto transition shadow-lg hover:scale-110"
              aria-label="Next image"
            >
              <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </template>

        <template x-if="images.length > 1">
          <div class="absolute top-4 right-4 bg-black/60 text-white text-xs px-3 py-1 rounded-full backdrop-blur-md font-medium">
            <span x-text="currentIndex + 1"></span> / <span x-text="images.length"></span>
          </div>
        </template>
      </div>
    </div>

    <template x-if="images.length > 1">
      <div class="flex items-center justify-center gap-3 mt-4 overflow-x-auto pb-2">
        <template x-for="(image, index) in images" :key="index">
          <button
            type="button"
            @click="goTo(index)"
            class="w-16 h-11 sm:w-20 sm:h-14 rounded-lg overflow-hidden border-2 transition-all duration-200 shrink-0 bg-gray-100"
            :class="currentIndex === index ? 'border-[#006699] ring-2 ring-[#006699]/30 scale-105' : 'border-transparent opacity-60 hover:opacity-100'"
          >
            <img :src="image" alt="Thumbnail" class="w-full h-full object-cover" />
          </button>
        </template>
      </div>
    </template>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left Column: Description & Overview -->
    <div class="lg:col-span-2">
      <div class="space-y-6">
        <!-- Project Description Card -->
        <div class="bg-[#FFFFFF] rounded-2xl p-6 sm:p-8 border border-[#D9D9D9]">
          <h2 class="font-inter font-bold text-[18px] leading-[24px] text-[#003060] mb-3 pb-3 border-b border-[#D9D9D9]">
            {{t "test.detailPortfolio.projectDescription"}}
          </h2>
          <div class="font-inter font-normal text-[16px] leading-[26px] text-[#475569]">
            <p
              x-show="selectedPortfolio && selectedPortfolio.description"
              x-text="selectedPortfolio ? selectedPortfolio.description : ''"
            ></p>
            <p
              x-show="!selectedPortfolio || !selectedPortfolio.description"
              class="text-gray-400 italic"
            >
              {{default (t 'test.detailPortfolio.noDescription') 'No description provided.'}}
            </p>
          </div>
        </div>

        <!-- Project Overview Card -->
        <div class="bg-[#FFFFFF] rounded-2xl p-6 sm:p-8 border border-[#D9D9D9]">
          <h2 class="font-inter font-bold text-[18px] leading-[24px] text-[#003060] mb-3 pb-3 border-b border-[#D9D9D9]">
            {{t "test.detailPortfolio.projectOverview"}}
          </h2>
          <div
            id="overviewDetail"
            class="font-inter font-normal text-[16px] leading-[26px] text-[#475569] prose prose-sm max-w-none"
            x-html="renderOverview(selectedPortfolio ? selectedPortfolio.overview : '') || '<p class=\'italic text-gray-400\'>{{default (t 'test.detailPortfolio.noOverview') 'No detailed overview provided.'}}</p>'"
          ></div>
        </div>
      </div>
    </div>

    <!-- Right Column: Student Profile, Meta Info, Technologies & CTA -->
    <div class="lg:col-span-1">
      <div class="space-y-4">
        <!-- Student Profile & Program Details Card -->
        <div class="bg-[#FFFFFF] rounded-2xl p-6 border border-[#D9D9D9]">
          <div class="flex items-center gap-3.5 pb-5 border-b border-[#D9D9D9]">
            <div class="size-12 rounded-full bg-[#DCEEFB] text-[#006699] font-bold text-lg flex items-center justify-center shrink-0 overflow-hidden">
              <template x-if="selectedPortfolio && selectedPortfolio.avatar">
                <img :src="selectedPortfolio.avatar" :alt="selectedPortfolio.author" class="w-full h-full object-cover" />
              </template>
              <template x-if="!selectedPortfolio || !selectedPortfolio.avatar">
                <span x-text="selectedPortfolio && selectedPortfolio.author ? selectedPortfolio.author.charAt(0).toUpperCase() : 'A'">A</span>
              </template>
            </div>
            <div class="min-w-0 flex-1">
              <h3
                class="text-sm font-bold text-[#0B1F3B] truncate leading-tight"
                x-text="selectedPortfolio ? selectedPortfolio.author : ''"
              ></h3>
              <p
                class="text-xs text-[#94A3B8] truncate leading-tight mt-0.5"
                x-text="selectedPortfolio && selectedPortfolio.email ? selectedPortfolio.email : '-'"
              ></p>
            </div>
          </div>

          <div class="space-y-4 pt-5">
            <!-- Program Completed -->
            <div class="flex items-start gap-3">
              <div class="size-8 rounded-lg bg-[#EBF5FB] text-[#006699] flex items-center justify-center shrink-0 mt-0.5">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-5.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[10px] font-bold tracking-wider text-[#94A3B8] uppercase">
                  {{t "test.detailPortfolio.programCompleted"}}
                </p>
                <p
                  class="font-inter font-medium text-[14px] leading-[20px] text-[#1E293B] mt-0.5"
                  x-text="selectedPortfolio && selectedPortfolio.program ? selectedPortfolio.program : '-'"
                ></p>
              </div>
            </div>

            <!-- Completion Date -->
            <div class="flex items-start gap-3">
              <div class="size-8 rounded-lg bg-[#EBF5FB] text-[#006699] flex items-center justify-center shrink-0 mt-0.5">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[10px] font-bold tracking-wider text-[#94A3B8] uppercase">
                  {{t "test.detailPortfolio.completionDate"}}
                </p>
                <p
                  class="font-inter font-medium text-[14px] leading-[20px] text-[#1E293B] mt-0.5"
                  x-text="selectedPortfolio && (selectedPortfolio.courseStartEnd || selectedPortfolio.createdAt) ? new Date(selectedPortfolio.courseStartEnd || selectedPortfolio.createdAt).toLocaleDateString(undefined, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) : '-'"
                ></p>
              </div>
            </div>

            <!-- Project Duration -->
            <div class="flex items-start gap-3">
              <div class="size-8 rounded-lg bg-[#EBF5FB] text-[#006699] flex items-center justify-center shrink-0 mt-0.5">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[10px] font-bold tracking-wider text-[#94A3B8] uppercase">
                  {{t "test.detailPortfolio.projectDuration"}}
                </p>
                <p
                  class="font-inter font-medium text-[14px] leading-[20px] text-[#1E293B] mt-0.5"
                  x-text="(selectedPortfolio && selectedPortfolio.courseMonth ? selectedPortfolio.courseMonth : 0) + ' {{t 'test.detailPortfolio.months'}}'"
                ></p>
              </div>
            </div>
          </div>
        </div>

        <!-- Technologies Used Card -->
        <div class="bg-[#FFFFFF] rounded-2xl p-6 border border-[#D9D9D9]">
          <h3 class="text-xs font-bold text-[#94A3B8] mb-3 uppercase tracking-wider font-inter">
            {{t "test.detailPortfolio.technologiesUsed"}}
          </h3>
          <div class="flex flex-wrap gap-2">
            <template x-for="tech in (selectedPortfolio && selectedPortfolio.technologies ? selectedPortfolio.technologies : [])" :key="tech.id || tech.name">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#F1F5F9] text-[#334155] text-xs font-semibold rounded-full border border-[#D9D9D9]">
                <template x-if="tech.svg">
                  <span x-html="tech.svg" class="size-3.5 flex items-center justify-center [&>svg]:w-3.5 [&>svg]:h-3.5"></span>
                </template>
                <template x-if="!tech.svg && tech.imgUrl">
                  <img :src="tech.imgUrl" :alt="tech.name" class="size-3.5 object-contain" />
                </template>
                <span x-text="tech.name"></span>
              </span>
            </template>
            <span
              x-show="!selectedPortfolio || !selectedPortfolio.technologies || selectedPortfolio.technologies.length === 0"
              class="inline-flex items-center px-3 py-1 bg-[#F1F5F9] text-[#334155] text-xs font-semibold rounded-full border border-[#D9D9D9]"
            >
              {{default (t 'test.detailPortfolio.defaultWebTech') 'Web Technologies'}}
            </span>
          </div>
        </div>

        <!-- View Portfolio CTA -->
        <div x-show="selectedPortfolio && selectedPortfolio.link" x-cloak>
          <a
            :href="selectedPortfolio ? selectedPortfolio.link : ''"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center rounded-[12px] border border-[#003060] bg-[#003060] px-4 py-3.5 text-xs font-semibold text-white shadow-md transition-all duration-300 hover:bg-[#001f3f] active:scale-95 sm:text-sm"
          >
            {{t 'test.detailPortfolio.buttonViewPortfolio'}}
          </a>
        </div>

        <!-- Share Section -->
        {{> components/ui/portfolio/share_card }}
      </div>
    </div>
  </div>
</div>
