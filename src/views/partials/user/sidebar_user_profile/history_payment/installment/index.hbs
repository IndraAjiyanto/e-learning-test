<!-- INSTALLMENT PAYMENT HISTORY SUB-PARTIAL -->
<div class="pt-2" x-data="{
  transactions: [],
  loading: true,
  showDetail: false,
  selectedTx: null,
  payingMonth: null,
  async init() {
    try {
      const res = await fetch('/payment/api/installment-detail/{{user.id}}');
      const json = await res.json();
      const data = json.data || [];
      this.transactions = data.map(p => ({
        id: p.id,
        program: p.course ? p.course.name : 'Program',
        type: p.course && p.course.category ? p.course.category : 'Program',
        status: p.process === 'approved' ? 'accepted' : (p.process === 'process' ? 'processing' : 'rejected'),
        period: p.course && p.course.startDate ? new Date(p.course.startDate).toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric'}) + ' - ' + new Date(p.course.endDate).toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric'}) : '',
        paymentDate: p.createdAt ? new Date(p.createdAt).toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric'}) : '',
        amount: p.downPayment ? 'Rp ' + Number(p.downPayment).toLocaleString('id-ID') : 'Free',
        full: p
      }));
    } catch(e) {
      console.error('Failed to load installments:', e);
    } finally {
      this.loading = false;
    }
  },
  openDetail(tx) {
    this.selectedTx = tx;
    this.showDetail = true;
  },
  formatRupiah(v) {
    return 'Rp ' + Number(v || 0).toLocaleString('id-ID');
  },
  formatDate(v) {
    if (!v) return '-';
    if (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v)) {
      const [y, m, d] = v.split('-').map(Number);
      return new Date(y, m - 1, d).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
    }
    return new Date(v).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  },
  canPayMonth(month) {
    const monthly = this.selectedTx?.full?.monthly || [];
    for (let i = 0; i < monthly.length; i++) {
      if (monthly[i].month < month && monthly[i].status !== 'paid') {
        return false;
      }
    }
    return true;
  },
  lockedReason(month) {
    const monthly = this.selectedTx?.full?.monthly || [];
    for (let i = 0; i < monthly.length; i++) {
      if (monthly[i].month < month && monthly[i].status !== 'paid') {
        return `Cicilan bulan ${monthly[i].month} belum lunas`;
      }
    }
    return '';
  },
  async payMonth(tx, month) {
    if (this.payingMonth) return;
    this.payingMonth = month;
    try {
      const res = await fetch('/api/payment/installment-month', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ paymentId: tx.id, month })
      });
      const data = await res.json();
      if (res.ok && data.status === 'success') {
        window.location.href = data.redirect_url;
      } else {
        alert(data.message || 'Gagal memproses pembayaran cicilan.');
      }
    } catch(e) {
      console.error(e);
      alert('Terjadi kesalahan koneksi.');
    } finally {
      this.payingMonth = null;
    }
  }
}">

  <!-- LOADING STATE -->
  <div x-show="loading" class="py-12 flex flex-col items-center justify-center text-center">
    <i class="fa-solid fa-spinner fa-spin text-3xl text-[#003060] mb-4"></i>
    <p class="font-montserrat font-medium text-lg text-[#666666]">Loading installments...</p>
  </div>

  <!-- EMPTY STATE (When no installment payments exist) -->
  <div 
    x-show="!loading && transactions.length === 0" 
    class="py-8 px-4 flex flex-col items-center justify-center text-center"
  >
    <div class="mb-12">
      <img src="/public/image/userProfile/receiptDollar.svg" alt="Receipt Dollar" class="w-16 h-16 object-contain mx-auto">
    </div>

    <h3 class="font-montserrat font-semibold text-lg sm:text-xl text-[#003060] mb-2">
      No Installment Payment History
    </h3>

    <p class="font-montserrat font-normal text-sm text-[#666666] mb-8">
      You haven't made any installment payments yet.
    </p>

    <button
      type="button"
      onclick="window.location.href='/free-program'"
      class="w-full max-w-[280px] h-11 rounded-lg gap-2 bg-[#003060] hover:bg-[#001f3f] hover:shadow-sm transition-shadow flex items-center justify-center font-montserrat font-medium text-sm leading-none text-white cursor-pointer"
    >
      Start Learning
    </button>
  </div>

    <!-- Filter Empty Search State -->
    <div
      x-show="transactions.length > 0 && transactions.filter(t => (statusFilter === 'all' || statusFilter === t.status) && t.program.toLowerCase().includes(searchQuery.toLowerCase())).length === 0"
      class="col-span-full py-8 px-4 flex flex-col items-center justify-center text-center"
    >
      <div class="w-16 h-16 rounded-full bg-[#E0F1F9] flex items-center justify-center mx-auto mb-12">
        <i class="fa-solid fa-receipt text-[30px] text-[#003060]"></i>
      </div>
      <h3 class="font-montserrat font-semibold text-lg sm:text-xl text-[#003060] mb-2">
        No Installment Payment History
      </h3>
      <p class="font-montserrat font-normal text-sm text-[#666666]">
        Try adjusting your status filter or search query.
      </p>

      <button
        type="button"
        onclick="window.location.href='/free-program'"
        class="w-full max-w-[280px] h-11 rounded-lg gap-2 bg-[#003060] hover:bg-[#001f3f] hover:shadow-sm transition-shadow flex items-center justify-center font-montserrat font-medium text-sm leading-none text-white cursor-pointer"
      >
        Start Learning
      </button>
    </div>

    <!-- HAS DATA: Transaction List (row layout, matches Figma "Payment History" reference) -->
    <div x-show="!showDetail && transactions.length > 0" class="flex flex-col divide-y divide-[#E5E7EB] bg-white rounded-xl border border-[#E5E7EB] shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)]">
      <template x-for="tx in transactions" :key="tx.id">
        <div
          x-show="(statusFilter === 'all' || statusFilter === tx.status) && tx.program.toLowerCase().includes(searchQuery.toLowerCase())"
          class="w-full flex flex-col sm:flex-row sm:items-center gap-3 p-4 xl:px-5"
        >
          <!-- Icon -->
          <span class="grid size-11 shrink-0 place-items-center rounded-[10px] bg-[#FEEFD6] text-[#FDA40B]">
            <i class="fa-solid fa-calendar-check text-lg"></i>
          </span>

          <!-- Title + Category -->
          <div class="flex-1 min-w-0">
            <h4 class="font-montserrat font-semibold text-sm text-[#003060] truncate" x-text="tx.program">UI/UX Designer</h4>
            <span class="inline-flex items-center rounded-full bg-[#FEEFD6] px-2.5 py-0.5 text-xs font-medium text-[#FDA40B]" x-text="tx.type">Bootcamp</span>
          </div>

          <!-- Installment Progress -->
          <div class="flex items-center gap-1.5 text-xs text-[#6B7280] sm:w-[150px] shrink-0">
            <i class="fa-regular fa-calendar-check text-[#003060]"></i>
            <span x-text="(tx.full.monthly || []).filter(m => m.status === 'paid').length + ' / ' + (tx.full.monthly || []).length + ' months paid'">0 / 0 months paid</span>
          </div>

          <!-- Payment Date -->
          <div class="flex items-center gap-1.5 text-xs text-[#6B7280] sm:w-[130px] shrink-0">
            <i class="fa-regular fa-calendar text-[#003060]"></i>
            <span x-text="tx.paymentDate">25 April 2026</span>
          </div>

          <!-- Status -->
          <span
            class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold capitalize sm:w-[100px] justify-center shrink-0"
            :class="tx.status === 'accepted' ? 'bg-[#F0FBF4] text-[#04B165]' : (tx.status === 'processing' ? 'bg-[#FEEFD6] text-[#FDA40B]' : 'bg-[#FEE7E7] text-[#F13639]')"
            x-text="tx.status"
          >Accepted</span>

          <!-- Actions -->
          <div class="flex items-center gap-2 shrink-0">
            <button
              type="button"
              @click="openDetail(tx)"
              class="rounded-lg bg-[#003060] hover:bg-[#001f3f] px-3 py-2 font-montserrat font-medium text-xs text-white transition cursor-pointer"
            >
              View Detail <i class="fa-solid fa-arrow-right"></i>
            </button>
          </div>
        </div>
      </template>

      <!-- Filter Empty Search State -->
      <div
        x-show="transactions.length > 0 && transactions.filter(t => (statusFilter === 'all' || statusFilter === t.status) && t.program.toLowerCase().includes(searchQuery.toLowerCase())).length === 0"
        class="py-8 px-4 flex flex-col items-center justify-center text-center"
      >
        <div class="w-16 h-16 rounded-full bg-[#E0F1F9] flex items-center justify-center mx-auto mb-12">
          <i class="fa-solid fa-receipt text-[30px] text-[#003060]"></i>
        </div>

        <h3 class="font-montserrat font-semibold text-lg sm:text-xl text-[#003060] mb-2">
          No Transactions Found
        </h3>

        <p class="font-montserrat font-normal text-sm text-[#666666]">
          Try adjusting your status filter or search query.
        </p>
      </div>
    </div>

  <!-- DETAIL VIEW (When showDetail is true) -->
  <div x-show="showDetail">
    {{> user/sidebar_user_profile/history_payment/installment/detail/index }}
  </div>

</div>
