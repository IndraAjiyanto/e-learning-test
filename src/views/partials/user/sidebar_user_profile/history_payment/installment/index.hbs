<!-- INSTALLMENT PAYMENT HISTORY SUB-PARTIAL -->
<div class="pt-2" x-data="{
  transactions: [],
  loading: true,
  showDetail: false,
  selectedTx: null,
  payingMonth: null,
  async init() {
    try {
      const res = await fetch('/payment/api/installment-detail/{{user.id}}');
      const json = await res.json();
      const data = json.data || [];
      this.transactions = data.map(p => ({
        id: p.id,
        program: p.course ? p.course.name : 'Program',
        type: p.course && p.course.category ? p.course.category : 'Program',
        status: p.process === 'approved' ? 'accepted' : (p.process === 'process' ? 'processing' : 'rejected'),
        period: p.course && p.course.startDate ? new Date(p.course.startDate).toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric'}) + ' - ' + new Date(p.course.endDate).toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric'}) : '',
        paymentDate: p.createdAt ? new Date(p.createdAt).toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric'}) : '',
        amount: p.downPayment ? 'Rp ' + Number(p.downPayment).toLocaleString('id-ID') : 'Free',
        full: p
      }));
    } catch(e) {
      console.error('Failed to load installments:', e);
    } finally {
      this.loading = false;
    }
  },
  openDetail(tx) {
    this.selectedTx = tx;
    this.showDetail = true;
  },
  formatRupiah(v) {
    return 'Rp ' + Number(v || 0).toLocaleString('id-ID');
  },
  formatDate(v) {
    if (!v) return '-';
    if (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v)) {
      const [y, m, d] = v.split('-').map(Number);
      return new Date(y, m - 1, d).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
    }
    return new Date(v).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  },
  canPayMonth(month) {
    const monthly = this.selectedTx?.full?.monthly || [];
    for (let i = 0; i < monthly.length; i++) {
      if (monthly[i].month < month && monthly[i].status !== 'paid') {
        return false;
      }
    }
    return true;
  },
  lockedReason(month) {
    const monthly = this.selectedTx?.full?.monthly || [];
    for (let i = 0; i < monthly.length; i++) {
      if (monthly[i].month < month && monthly[i].status !== 'paid') {
        return `Cicilan bulan ${monthly[i].month} belum lunas`;
      }
    }
    return '';
  },
  async payMonth(tx, month) {
    if (this.payingMonth) return;
    this.payingMonth = month;
    try {
      const res = await fetch('/api/payment/installment-month', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ paymentId: tx.id, month })
      });
      const data = await res.json();
      if (res.ok && data.status === 'success') {
        window.location.href = data.redirect_url;
      } else {
        alert(data.message || 'Gagal memproses pembayaran cicilan.');
      }
    } catch(e) {
      console.error(e);
      alert('Terjadi kesalahan koneksi.');
    } finally {
      this.payingMonth = null;
    }
  }
}">

  <!-- LOADING STATE -->
  <div x-show="loading" class="py-12 flex flex-col items-center justify-center text-center">
    <i class="fa-solid fa-spinner fa-spin text-3xl text-[#003060] mb-4"></i>
    <p class="font-montserrat font-medium text-lg text-[#666666]">Loading installments...</p>
  </div>

  <!-- EMPTY STATE (When no installment payments exist) -->
  <div 
    x-show="!loading && transactions.length === 0" 
    class="py-8 px-4 flex flex-col items-center justify-center text-center"
  >
    <div class="mb-12">
      <img src="/public/image/userProfile/receiptDollar.svg" alt="Receipt Dollar" class="w-16 h-16 object-contain mx-auto">
    </div>

    <h3 class="font-montserrat font-semibold text-xl sm:text-2xl xl:text-[30px] text-[#003060] mb-2">
      No Installment Payment History
    </h3>

    <p class="font-sans font-normal text-base sm:text-lg xl:text-[20px] text-[#666666] mb-12">
      You haven't made any installment payments yet.
    </p>

    <button
      type="button"
      onclick="window.location.href='/free-program'"
      class="w-full max-w-[331px] h-[55px] rounded-[12px] p-[10px] gap-[10px] bg-[#003060] hover:bg-[#001f3f] shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)] flex items-center justify-center font-montserrat font-medium text-lg sm:text-[20px] leading-none text-white transition-all duration-200 cursor-pointer"
    >
      Start Learning
    </button>
  </div>

    <!-- Filter Empty Search State -->
    <div
      x-show="transactions.length > 0 && transactions.filter(t => (statusFilter === 'all' || statusFilter === t.status) && t.program.toLowerCase().includes(searchQuery.toLowerCase())).length === 0"
      class="col-span-full py-8 px-4 flex flex-col items-center justify-center text-center"
    >
      <div class="w-16 h-16 rounded-full bg-[#E0F1F9] flex items-center justify-center mx-auto mb-12">
        <i class="fa-solid fa-receipt text-[30px] text-[#003060]"></i>
      </div>
      <h3 class="font-montserrat font-semibold text-xl sm:text-2xl xl:text-[30px] text-[#003060] mb-2">
        No Installment Payment History
      </h3>
      <p class="font-sans font-normal text-base sm:text-lg xl:text-[20px] text-[#666666]">
        Try adjusting your status filter or search query.
      </p>

      <button 
        type="button"
        onclick="window.location.href='/free-program'"
        class="w-full max-w-[331px] h-[55px] rounded-[12px] p-[10px] gap-[10px] bg-[#003060] hover:bg-[#001f3f] shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)] flex items-center justify-center font-montserrat font-medium text-lg sm:text-[20px] leading-none text-white transition-all duration-200 cursor-pointer"
      >
        Start Learning
      </button>
    </div>

    <!-- HAS DATA: Transaction Cards Grid -->
    <div x-show="!showDetail && transactions.length > 0" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 xl:gap-4 2xl:gap-6">
      <template x-for="tx in transactions" :key="tx.id">
        <div
          x-show="(statusFilter === 'all' || statusFilter === tx.status) && tx.program.toLowerCase().includes(searchQuery.toLowerCase())"
          class="w-full max-w-[334px] min-h-[440px] 2xl:w-[334px] 2xl:min-h-[440px] bg-[#FFFFFF80] backdrop-blur-[6.6px] rounded-xl p-4 xl:p-5 flex flex-col justify-between shadow-[0px_0px_8px_0px_rgba(0,0,0,0.5)] border border-white/40"
        >
          <div>
            <!-- Badges Row (Top Right Aligned) -->
            <div class="flex items-center justify-end gap-2 mb-5">
              <span class="h-[24px] px-3 flex items-center justify-center rounded-[6px] border border-[#003060] font-montserrat font-medium text-xs sm:text-[15px] text-[#003060] leading-none" x-text="tx.type">Bootcamp</span>
              <span 
                class="h-[24px] px-3 flex items-center justify-center rounded-[6px] border font-montserrat font-medium text-xs sm:text-[15px] leading-none capitalize" 
                :class="tx.status === 'accepted' ? 'bg-[#F0FBF4] border-[#04B165] text-[#04B165]' : (tx.status === 'processing' ? 'bg-[#FEEFD6] border-[#FDA40B] text-[#FDA40B]' : 'bg-[#FEE7E7] border-[#F13639] text-[#F13639]')"
                x-text="tx.status"
              >Accepted</span>
            </div>

            <!-- Program Title -->
            <h4 class="font-montserrat font-semibold text-[15px] leading-[25px] text-[#003060] mb-5" x-text="tx.program">UI/UX Designer</h4>

            <!-- Meta: Period + Location -->
            <div class="flex flex-col gap-1 mb-9">
              <div class="flex items-center gap-2.5">
                <i class="fa-regular fa-calendar text-[14px] text-[#003060] flex-shrink-0"></i>
                <span class="font-open-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D]" x-text="tx.period">21 April - 21 Juli 2026</span>
              </div>
            </div>

            <!-- Payment Date -->
            <p class="font-open-sans text-[15px] text-black text-center mb-2">
              <span class="font-semibold">Payment Date:</span> <span class="font-normal" x-text="tx.paymentDate">25 April 2026</span>
            </p>

            <!-- Due Dates -->
            <div x-show="(tx.full.installment?.dueDates || []).length > 0" class="border-t border-white/40 pt-2 mt-1">
              <div class="flex items-center gap-2 mb-1">
                <i class="fa-regular fa-calendar-check text-[13px] text-[#003060] flex-shrink-0"></i>
                <span class="font-open-sans font-semibold text-[13px] text-[#2D2D2D]">Due Dates</span>
              </div>
              <div class="space-y-0.5">
                <template x-for="(d, i) in (tx.full.installment?.dueDates || [])" :key="i">
                  <div class="flex items-center justify-between text-[12px]">
                    <span class="text-[#666666]">Payslip <span x-text="i + 1"></span></span>
                    <span class="font-semibold text-[#2D2D2D]" x-text="formatDate(d)"></span>
                  </div>
                </template>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col gap-2.5 mt-2">
            <button 
              type="button" 
              @click="openDetail(tx)"
              class="w-full h-[35px] rounded-[12px] p-[10px] bg-[#003060] hover:bg-[#001f3f] text-white font-montserrat font-medium text-[15px] leading-none flex items-center justify-center transition-all cursor-pointer shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)]"
            >
              View Payment Details
            </button>
            <button type="button" class="w-full h-[35px] rounded-[12px] p-[10px] bg-white/80 hover:bg-white text-[#003060] border border-[#003060] font-montserrat font-medium text-[15px] leading-none flex items-center justify-center transition-all cursor-pointer shadow-[0px_0px_4px_0px_rgba(0,0,0,0.1)]">
              View Program
            </button>
          </div>
        </div>
      </template>

      <!-- Filter Empty Search State -->
      <div
        x-show="transactions.length > 0 && transactions.filter(t => (statusFilter === 'all' || statusFilter === t.status) && t.program.toLowerCase().includes(searchQuery.toLowerCase())).length === 0"
        class="col-span-full py-8 px-4 flex flex-col items-center justify-center text-center"
      >
        <div class="w-16 h-16 rounded-full bg-[#E0F1F9] flex items-center justify-center mx-auto mb-12">
          <i class="fa-solid fa-receipt text-[30px] text-[#003060]"></i>
        </div>

        <h3 class="font-montserrat font-semibold text-xl sm:text-2xl xl:text-[30px] text-[#003060] mb-2">
          No Transactions Found
        </h3>

        <p class="font-sans font-normal text-base sm:text-lg xl:text-[20px] text-[#666666]">
          Try adjusting your status filter or search query.
        </p>
      </div>
    </div>

  <!-- DETAIL VIEW (When showDetail is true) -->
  <div x-show="showDetail">
    {{> user/sidebar_user_profile/history_payment/installment/detail/index }}
  </div>

</div>
