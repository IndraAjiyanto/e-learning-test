<!-- REGISTRATION PAYMENT DETAIL MODAL POP-UP -->
<div 
  x-show="showDetail" 
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 sm:p-6 overflow-y-auto font-montserrat"
  style="display: none;"

>
  <!-- Modal Card -->
  <div 
    @click.away="showDetail = false"
    class="bg-white backdrop-blur-[3.3px] rounded-[12px] p-6 sm:p-8 max-w-4xl w-full relative shadow-[0_0_4px_rgba(0,0,0,0.25)] my-8 border border-slate-100"
  >
    <!-- Close Button (X) -->
    <button 
      type="button" 
      @click="showDetail = false"
      class="absolute top-6 right-6 w-10 h-10 rounded-full flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-all cursor-pointer"
    >
      <i class="fa-solid fa-xmark text-xl"></i>
    </button>

    <!-- Top Badges Row -->
    <div class="flex items-center gap-[13px] mb-4">
      <!-- Status Badge -->
      <span 
        class="px-3.5 py-1 rounded-[3px] font-sans font-medium text-[10px] capitalize border"
        :class="{
          'bg-[#F0FBF4] border-[#04B165] text-[#04B165]': selectedTx?.status === 'accepted',
          'bg-[#FFF9E6] border-[#FDA40B] text-[#FDA40B]': selectedTx?.status === 'processing',
          'bg-[#FEE7E7] border-[#F13639] text-[#F13639]': selectedTx?.status === 'rejected'
        }"
        x-text="selectedTx?.status === 'processing' ? 'Processing' : selectedTx?.status"
      >
        Accepted
      </span>

      <!-- Class Type Badge -->
      <span class="px-3.5 py-1 rounded-[3px] border border-[#003060] text-[#003060] font-sans font-medium text-[10px]" x-text="selectedTx?.type || 'Short Class'">
        Short Class
      </span>
    </div>

    <!-- Title -->
    <h2 class="font-sans font-bold text-[15px] leading-[20px] text-[#2D2D2D] mb-6 sm:mb-8 pr-8" x-text="selectedTx?.program || 'Seminar - Python For Data Analyst - from zero to insight'">
      Seminar - Python For Data Analyst - from zero to insight
    </h2>

    <!-- 2 Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      
      <!-- LEFT COLUMN: Class Info & Description -->
      <div class="space-y-6">
        
        <!-- Metadata 2x2 Grid -->
        <div class="grid grid-cols-2 gap-y-5 gap-x-4 font-montserrat">
          
          <!-- Date -->
          <div class="flex items-start gap-3">
            <i class="fa-regular fa-calendar text-[#003060] text-base sm:text-lg mt-0.5 flex-shrink-0"></i>
            <div>
              <h5 class="font-montserrat font-semibold text-xs text-black">Date</h5>
              <p class="font-normal text-xs text-[#2D2D2D] mt-0.5" x-text="selectedTx?.date || '20 Juni 2026'">20 Juni 2026</p>
            </div>
          </div>

          <!-- Time -->
          <div class="flex items-start gap-3">
            <i class="fa-regular fa-clock text-[#003060] text-base sm:text-lg mt-0.5 flex-shrink-0"></i>
            <div>
              <h5 class="font-montserrat font-semibold text-xs text-black">Time</h5>
              <p class="font-normal text-xs text-[#2D2D2D] mt-0.5" x-text="selectedTx?.timeDetails || '09:00 - 11:00 WIB'">09:00 - 11:00 WIB</p>
            </div>
          </div>

          <!-- Location -->
          <div class="flex items-start gap-3">
            <i class="fa-solid fa-location-dot text-[#003060] text-base sm:text-lg mt-0.5 flex-shrink-0"></i>
            <div>
              <h5 class="font-montserrat font-semibold text-xs text-black">Location</h5>
              <p class="font-normal text-xs text-[#2D2D2D] mt-0.5" x-text="selectedTx?.location || 'Offline (Aula Fakultas Ilmu Komputer Amikom)'">Offline (Aula Fakultas Ilmu Komputer Amikom)</p>
            </div>
          </div>

          <!-- Class Type -->
          <div class="flex items-start gap-3">
            <i class="fa-solid fa-graduation-cap text-[#003060] text-base sm:text-lg mt-0.5 flex-shrink-0"></i>
            <div>
              <h5 class="font-montserrat font-semibold text-xs text-black">Class Type</h5>
              <p class="font-normal text-xs text-[#2D2D2D] mt-0.5" x-text="selectedTx?.classTypeDetails || 'Short Class - Free Class'">Short Class - Free Class</p>
            </div>
          </div>

        </div>

        <!-- Class Description -->
        <div class="pt-2">
          <h5 class="font-montserrat font-semibold text-xs text-black mb-2">Class Description</h5>
          <p class="font-sans font-normal text-xs text-[#2D2D2D] leading-relaxed" x-text="selectedTx?.description || 'a seminar that will explore how data analysts work and think in line with current industry needs.'">
            a seminar that will explore how data analysts work and think in line with current industry needs.
          </p>
        </div>

        <!-- Registration Under Review Box (SHOWN ONLY WHEN status === 'processing') -->
        <div 
          x-show="selectedTx?.status === 'processing'" 
          class="bg-[#FFF9E6] border border-[#FDA40B] rounded-xl p-4 sm:p-5 text-left transition-all"
        >
          <div class="flex items-center gap-2.5 mb-1.5">
            <i class="fa-solid fa-circle-info text-[#FDA40B] text-lg sm:text-xl flex-shrink-0"></i>
            <h5 class="font-montserrat font-bold text-sm sm:text-base text-[#FDA40B]">
              Registration Under Review
            </h5>
          </div>
          
          <p class="font-sans font-normal text-xs sm:text-sm text-[#FDA40B] mb-4">
            Your registration is being verified. If you have questions, contact us:
          </p>

          <a 
            href="https://wa.me/"
            target="_blank"
            class="w-full h-[45px] bg-[#00B165] hover:bg-[#009b58] text-white font-montserrat font-medium text-xs sm:text-sm rounded-[12px] flex items-center justify-center gap-2 transition-all shadow-sm"
          >
            <span>Contact Admin via WhatsApp</span>
          </a>
        </div>

        <!-- Registration Rejected Box (SHOWN ONLY WHEN status === 'rejected') -->
        <div 
          x-show="selectedTx?.status === 'rejected'" 
          class="bg-[#FEE7E7] border border-[#F13639] rounded-xl p-4 sm:p-5 text-left transition-all"
        >
          <div class="flex items-center gap-2.5 mb-1.5">
            <i class="fa-solid fa-circle-xmark text-[#F13639] text-lg sm:text-xl flex-shrink-0"></i>
            <h5 class="font-montserrat font-bold text-sm sm:text-base text-[#F13639]">
              Registration Rejected
            </h5>
          </div>
          
          <p class="font-sans font-normal text-xs sm:text-sm text-[#F13639] mb-4">
            Your registration was rejected. If you have questions or need assistance, contact us:
          </p>

          <a 
            href="https://wa.me/"
            target="_blank"
            class="w-full h-[45px] bg-[#00B165] hover:bg-[#009b58] text-white font-montserrat font-medium text-xs sm:text-sm rounded-[12px] flex items-center justify-center gap-2 transition-all shadow-sm"
          >
            <span>Contact Admin via WhatsApp</span>
          </a>
        </div>

      </div>

      <!-- RIGHT COLUMN: Registration Information -->
      <div class="lg:border-l lg:border-slate-200 lg:pl-8 space-y-4 font-montserrat">
        <h4 class="font-montserrat font-semibold text-[12px] leading-none text-black mb-4">
          Registration Information
        </h4>

        <div class="space-y-3.5 text-xs sm:text-sm">
          
          <!-- Item 1: Full Name -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <i class="fa-regular fa-user text-[#003060] w-4 text-center"></i>
              <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle">Full Name</span>
            </div>
            <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle" x-text="selectedTx?.fullName || 'Trisna'">Trisna</span>
          </div>

          <!-- Item 2: Email -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <i class="fa-regular fa-envelope text-[#003060] w-4 text-center"></i>
              <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle">Email</span>
            </div>
            <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle" x-text="selectedTx?.email || 'trisna@gmail.com'">trisna@gmail.com</span>
          </div>

          <!-- Item 3: WhatsApp Number -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-phone text-[#003060] w-4 text-center"></i>
              <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle">WhatsApp Number</span>
            </div>
            <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle" x-text="selectedTx?.whatsapp || '0812-3456-7890'">0812-3456-7890</span>
          </div>

          <!-- Item 4: Current Status -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-user-graduate text-[#003060] w-4 text-center"></i>
              <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle">Current Status</span>
            </div>
            <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle" x-text="selectedTx?.currentStatus || 'Student'">Student</span>
          </div>

          <!-- Item 5: Referral Source -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-wifi text-[#003060] w-4 text-center"></i>
              <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle">Referral Source</span>
            </div>
            <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle" x-text="selectedTx?.referral || 'Friends'">Friends</span>
          </div>

          <!-- Item 6: Attendance Confirmation -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <i class="fa-regular fa-circle-check text-[#003060] w-4 text-center"></i>
              <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle">Attendance Confirmation</span>
            </div>
            <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle" x-text="selectedTx?.attendance || 'Yes, I will attend'">Yes, I will attend</span>
          </div>

          <!-- Item 7: Receive Seminar Updates -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <i class="fa-regular fa-circle-check text-[#003060] w-4 text-center"></i>
              <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle">Receive Seminar Updates</span>
            </div>
            <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle" x-text="selectedTx?.receiveUpdates || 'Yes, I agree'">Yes, I agree</span>
          </div>

          <!-- Item 8: Registered On -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <i class="fa-regular fa-calendar text-[#003060] w-4 text-center"></i>
              <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle">Registered On</span>
            </div>
            <span class="font-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] align-middle" x-text="selectedTx?.regOn || '15 Juni 2026'">15 Juni 2026</span>
          </div>

        </div>
      </div>

    </div>

  </div>
</div>
