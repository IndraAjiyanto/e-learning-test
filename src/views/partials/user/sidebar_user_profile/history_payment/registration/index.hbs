<!-- REGISTRATION PAYMENT HISTORY SUB-PARTIAL -->
<div class="pt-2" x-data="{
  transactions: [],
  loading: true,
  showDetail: false,
  selectedTx: null,
  showProof: false,
  proofUrl: null,
  async init() {
    try {
      const res = await fetch('/payment/api/registration/{{user.id}}');
      const json = await res.json();
      const data = json.data || [];
      this.transactions = data.map(r => ({
        id: r.id,
        program: r.course ? r.course.name : 'Program',
        type: r.course && r.course.category ? r.course.category.name : 'Program',
        paymentType: 'Registration',
        status: r.process === 'approved' ? 'accepted' : (r.process === 'process' ? 'processing' : 'rejected'),
        period: r.course && r.course.startDate ? new Date(r.course.startDate).toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric'}) + ' - ' + new Date(r.course.endDate).toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric'}) : '',
        location: r.course && r.course.locationLink ? r.course.locationLink : 'Online',
        paymentDate: r.createdAt ? new Date(r.createdAt).toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric'}) : '',
        amount: r.course && r.course.promo > 0 ? 'Rp ' + Number(r.course.promo).toLocaleString('id-ID') : (r.course && r.course.price ? 'Rp ' + Number(r.course.price).toLocaleString('id-ID') : 'Free'),
        courseId: r.course ? r.course.id : null,
        proof: r.file || null
      }));
    } catch(e) {
      console.error('Failed to load registrations:', e);
    } finally {
      this.loading = false;
    }
  }
}">

  <!-- LOADING STATE -->
  <div x-show="loading" class="py-12 flex flex-col items-center justify-center text-center">
    <i class="fa-solid fa-spinner fa-spin text-3xl text-[#003060] mb-4"></i>
    <p class="font-montserrat font-medium text-lg text-[#666666]">Loading registrations...</p>
  </div>

  <!-- EMPTY STATE (When no registration payments exist) -->
  <div 
    x-show="!loading && transactions.length === 0" 
    class="py-8 px-4 flex flex-col items-center justify-center text-center"
  >
    <!-- Receipt Dollar Icon -->
    <div class="mb-12">
      <img src="/public/image/userProfile/receiptDollar.svg" alt="Receipt Dollar" class="w-16 h-16 object-contain mx-auto">
    </div>

    <!-- Heading -->
    <h3 class="font-montserrat font-semibold text-lg sm:text-xl text-[#003060] mb-2">
      No Registration Payment History
    </h3>

    <!-- Subtitle -->
    <p class="font-montserrat font-normal text-sm text-[#666666] mb-8">
      You haven't made any registration payments yet.
    </p>

    <!-- Start Learning Button -->
    <button
      type="button"
      onclick="window.location.href='/free-program'"
      class="w-full max-w-[280px] h-11 rounded-lg gap-2 bg-[#003060] hover:bg-[#001f3f] shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)] flex items-center justify-center font-montserrat font-medium text-sm leading-none text-white transition-all duration-200 cursor-pointer"
    >
      Start Learning
    </button>
  </div>

  <!-- HAS DATA: Transaction List (row layout, matches Figma "Payment History" reference) -->
  <div x-show="!loading && transactions.length > 0" class="flex flex-col divide-y divide-[#E5E7EB] bg-white rounded-xl border border-[#E5E7EB] shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)]">
    <template x-for="tx in transactions" :key="tx.id">
      <div
        x-show="(statusFilter === 'all' || statusFilter === tx.status) && tx.program.toLowerCase().includes(searchQuery.toLowerCase())"
        class="w-full flex flex-col sm:flex-row sm:items-center gap-3 p-4 xl:px-5"
      >
        <!-- Icon -->
        <span class="grid size-11 shrink-0 place-items-center rounded-[10px] bg-[#DCFCE7] text-[#16A34A]">
          <i class="fa-solid fa-clipboard-check text-lg"></i>
        </span>

        <!-- Title + Category -->
        <div class="flex-1 min-w-0">
          <h4 class="font-montserrat font-semibold text-sm text-[#003060] truncate" x-text="tx.program">Program</h4>
          <span class="inline-flex items-center rounded-full bg-[#DCFCE7] px-2.5 py-0.5 text-xs font-medium text-[#16A34A]" x-text="tx.type">Program</span>
        </div>

        <!-- Payment Date -->
        <div class="flex items-center gap-1.5 text-xs text-[#6B7280] sm:w-[140px] shrink-0">
          <i class="fa-regular fa-calendar text-[#003060]"></i>
          <span x-text="tx.paymentDate">-</span>
        </div>

        <!-- Payment Method -->
        <div class="flex items-center gap-1.5 text-xs text-[#6B7280] sm:w-[130px] shrink-0">
          <i class="fa-regular fa-credit-card text-[#003060]"></i>
          <span x-text="tx.paymentType">Registration</span>
        </div>

        <!-- Status -->
        <span
          class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold capitalize sm:w-[100px] justify-center shrink-0"
          :class="tx.status === 'accepted' ? 'bg-[#F0FBF4] text-[#04B165]' : (tx.status === 'processing' ? 'bg-[#FEEFD6] text-[#FDA40B]' : 'bg-[#FEE7E7] text-[#F13639]')"
          x-text="tx.status"
        >Accepted</span>

        <!-- Actions -->
        <div class="flex items-center gap-2 shrink-0">
          <button
            type="button"
            x-show="tx.proof"
            @click="proofUrl = tx.proof; showProof = true"
            class="rounded-lg border border-[#003060] px-3 py-2 font-montserrat font-medium text-xs text-[#003060] hover:bg-[#E0F2F9] transition cursor-pointer"
          >
            <i class="fa-regular fa-file-lines"></i> View proof
          </button>
          <button
            type="button"
            @click="selectedTx = tx; showDetail = true"
            class="rounded-lg bg-[#003060] hover:bg-[#001f3f] px-3 py-2 font-montserrat font-medium text-xs text-white transition cursor-pointer"
          >
            View Detail <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
      </div>
    </template>

    <!-- Filter Empty Search State -->
    <div
      x-show="transactions.length > 0 && transactions.filter(t => (statusFilter === 'all' || statusFilter === t.status) && t.program.toLowerCase().includes(searchQuery.toLowerCase())).length === 0"
      class="py-8 px-4 flex flex-col items-center justify-center text-center"
    >
      <div class="w-16 h-16 rounded-full bg-[#E0F1F9] flex items-center justify-center mx-auto mb-12">
        <i class="fa-solid fa-receipt text-[30px] text-[#003060]"></i>
      </div>
      <h3 class="font-montserrat font-semibold text-lg sm:text-xl text-[#003060] mb-2">
        No Transactions Found
      </h3>
      <p class="font-montserrat font-normal text-sm text-[#666666]">
        Try adjusting your status filter or search query.
      </p>
    </div>
  </div>

  <!-- PAYMENT PROOF MODAL -->
  <div x-show="showProof" x-cloak class="fixed inset-0 z-[100] flex items-center justify-center p-4" style="display:none" @keydown.escape.window="showProof = false">
    <div class="absolute inset-0 bg-black/50" @click="showProof = false"></div>
    <div class="relative w-full max-w-lg bg-white rounded-xl overflow-hidden shadow-xl">
      <div class="flex items-center justify-between bg-[#003060] px-5 py-3.5">
        <span class="font-montserrat font-semibold text-sm text-white"><i class="fa-regular fa-file-lines"></i> Payment Proof</span>
        <button type="button" @click="showProof = false" class="text-white/80 hover:text-white cursor-pointer"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="p-5">
        <div class="flex items-center justify-between mb-2">
          <span class="font-montserrat font-medium text-xs text-[#374151]">Invoice Image</span>
          <a :href="proofUrl" download target="_blank" class="font-montserrat font-medium text-xs text-[#003060] hover:underline"><i class="fa-solid fa-download"></i> Download</a>
        </div>
        <img :src="proofUrl" alt="Payment proof" class="w-full rounded-lg border border-[#E5E7EB] object-contain max-h-[60vh]">
      </div>
    </div>
  </div>

  <!-- REGISTRATION DETAIL MODAL POP-UP -->
  {{> user/sidebar_user_profile/history_payment/registration/detail/index }}

</div>
