<!-- REGISTRATION PAYMENT HISTORY SUB-PARTIAL -->
<div class="pt-2" x-data="{
  transactions: [
    {
      id: 1,
      program: 'Seminar - Python For Data Analyst - from zero to insight',
      type: 'Bootcamp',
      paymentType: 'Registration',
      status: 'accepted',
      period: '10 Mei - 10 Agustus 2026',
      location: 'Offline - Shoutgate Tercinta',
      paymentDate: '20 Mei 2026',
      amount: 'Rp 500.000'
    },
    {
      id: 2,
      program: 'Seminar - Python For Data Analyst - from zero to insight',
      type: 'Bootcamp',
      paymentType: 'Registration',
      status: 'processing',
      period: '01 Juni - 01 September 2026',
      location: 'Offline - Level Up Tercinta',
      paymentDate: '05 Juni 2026',
      amount: 'Rp 500.000'
    },
    {
      id: 3,
      program: 'Seminar - Python For Data Analyst - from zero to insight',
      type: 'Bootcamp',
      paymentType: 'Registration',
      status: 'rejected',
      period: '15 Juli - 15 Oktober 2026',
      location: 'Offline - Level Up Tercinta',
      paymentDate: '18 Juli 2026',
      amount: 'Rp 500.000'
    }
  ]
}">

  <!-- EMPTY STATE (When no registration payments exist) -->
  <div 
    x-show="transactions.length === 0" 
    class="py-8 px-4 flex flex-col items-center justify-center text-center"
  >
    <!-- Receipt Dollar Icon -->
    <div class="mb-12">
      <img src="/public/image/userProfile/receiptDollar.svg" alt="Receipt Dollar" class="w-16 h-16 object-contain mx-auto">
    </div>

    <!-- Heading -->
    <h3 class="font-montserrat font-semibold text-xl sm:text-2xl xl:text-[30px] text-[#003060] mb-2">
      No Registration Payment History
    </h3>

    <!-- Subtitle -->
    <p class="font-sans font-normal text-base sm:text-lg xl:text-[20px] text-[#666666] mb-12">
      You haven't made any registration payments yet.
    </p>

    <!-- Start Learning Button -->
    <button 
      type="button"
      onclick="window.location.href='/free-program'"
      class="w-full max-w-[331px] h-[55px] rounded-[12px] p-[10px] gap-[10px] bg-[#003060] hover:bg-[#001f3f] shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)] flex items-center justify-center font-montserrat font-medium text-lg sm:text-[20px] leading-none text-white transition-all duration-200 cursor-pointer"
    >
      Start Learning
    </button>
  </div>

  <!-- HAS DATA: Transaction Cards Grid -->
  <div x-show="transactions.length > 0" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 xl:gap-[29px]">
    <template x-for="tx in transactions" :key="tx.id">
      <div
        x-show="(statusFilter === 'all' || statusFilter === tx.status) && tx.program.toLowerCase().includes(searchQuery.toLowerCase())"
        class="w-full max-w-[334px] xl:w-[334px] xl:h-[397px] bg-[#FFFFFF80] backdrop-blur-[6.6px] rounded-[12px] p-5 flex flex-col justify-between shadow-[0px_0px_8px_0px_rgba(0,0,0,0.5)] border border-white/40"
      >
        <div>
          <!-- Badges Row (Top Right Aligned) -->
          <div class="flex items-center justify-end gap-2 mb-3">
            <span class="h-[24px] px-3 flex items-center justify-center rounded-[6px] border border-[#003060] font-montserrat font-medium text-xs sm:text-[15px] text-[#003060] leading-none" x-text="tx.type">Bootcamp</span>
            <span 
              class="h-[24px] px-3 flex items-center justify-center rounded-[6px] border font-montserrat font-medium text-xs sm:text-[15px] leading-none" 
              :class="tx.status === 'accepted' ? 'bg-[#F0FBF4] border-[#04B165] text-[#04B165]' : (tx.status === 'processing' ? 'bg-[#FEEFD6] border-[#FDA40B] text-[#FDA40B]' : 'bg-[#FEE7E7] border-[#F13639] text-[#F13639]')"
              x-text="tx.paymentType"
            >Registration</span>
          </div>

          <!-- Program Title -->
          <h4 class="font-montserrat font-semibold text-[15px] leading-[25px] text-[#003060] mb-3" x-text="tx.program">Full Stack Developer</h4>

          <!-- Meta: Period + Location -->
          <div class="flex flex-col gap-1 mb-2">
            <div class="flex items-center gap-2.5">
              <i class="fa-regular fa-calendar text-[14px] text-[#003060] flex-shrink-0"></i>
              <span class="font-open-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D]" x-text="tx.period">21 April - 21 Juli 2026</span>
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-location-dot text-[14px] text-[#003060] flex-shrink-0"></i>
              <span class="font-open-sans font-normal text-[12px] leading-[30px] text-[#2D2D2D] truncate" x-text="tx.location">PT. Wiratek Solusi Asia and Kesatria Academy</span>
            </div>
          </div>

          <!-- Payment Date -->
          <p class="font-open-sans text-[15px] leading-[30px] text-black text-center my-3">
            <span class="font-semibold">Payment Date:</span> <span class="font-normal" x-text="tx.paymentDate">15 Juni 2026</span>
          </p>
        </div>

        <!-- Action Buttons (Height 35px, Font 15px) -->
        <div class="flex flex-col gap-2.5 mt-2">
          <button type="button" class="w-full h-[35px] rounded-[12px] p-[10px] bg-[#003060] hover:bg-[#001f3f] text-white font-montserrat font-medium text-[15px] leading-none flex items-center justify-center transition-all cursor-pointer shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)]">
            View Payment Details
          </button>
          <button type="button" class="w-full h-[35px] rounded-[12px] p-[10px] bg-white/80 hover:bg-white text-[#003060] border border-[#003060] font-montserrat font-medium text-[15px] leading-none flex items-center justify-center transition-all cursor-pointer shadow-[0px_0px_4px_0px_rgba(0,0,0,0.1)]">
            View Program
          </button>
        </div>
      </div>
    </template>

    <!-- Filter Empty Search State -->
    <div
      x-show="transactions.length > 0 && transactions.filter(t => (statusFilter === 'all' || statusFilter === t.status) && t.program.toLowerCase().includes(searchQuery.toLowerCase())).length === 0"
      class="col-span-full py-8 px-4 flex flex-col items-center justify-center text-center"
    >
      <!-- Search Receipt Icon (64x64px size matching) -->
      <div class="w-16 h-16 rounded-full bg-[#E0F1F9] flex items-center justify-center mx-auto mb-12">
        <i class="fa-solid fa-receipt text-[30px] text-[#003060]"></i>
      </div>

      <!-- Heading -->
      <h3 class="font-montserrat font-semibold text-xl sm:text-2xl xl:text-[30px] text-[#003060] mb-2">
        No Transactions Found
      </h3>

      <!-- Subtitle -->
      <p class="font-sans font-normal text-base sm:text-lg xl:text-[20px] text-[#666666]">
        Try adjusting your status filter or search query.
      </p>
    </div>
  </div>

</div>
