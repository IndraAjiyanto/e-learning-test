{{> components/ui/super_admin/table/client_table }}

<script>
  function paymentHistory() {
    const base = clientTable({
      url: '/payment/api/history',
      dataKey: 'data',
      size: 5,
      searchKeys: ['courseName', 'no', 'method'],
    });

    // defineProperties di bawah MENIMPA base.load dengan load() milik extension,
    // jadi referensi aslinya harus dipegang lebih dulu — kalau tidak, load()
    // memanggil dirinya sendiri dan daftar berhenti di keadaan loading.
    const baseLoad = base.load;

    const emptyDraft = () => ({ from: '', to: '', status: '', type: '', program: '' });

    const extension = {
      // Semua baris apa adanya dari server. `items` milik clientTable adalah
      // hasil filter yang sedang aktif, jadi sumbernya harus disimpan terpisah.
      source: [],

      // select_field super admin membaca formData/formErrors dan memanggil
      // validateField/touch. Filter tidak punya validasi, jadi keduanya no-op.
      formData: emptyDraft(),
      formErrors: {},
      validateField() {},
      touch() {},

      // Nilai yang sudah ditekan Apply. Dipisah dari formData supaya memilih
      // dropdown belum langsung mengubah daftar, sesuai tombol Apply di desain.
      applied: emptyDraft(),

      get draft() {
        return this.formData;
      },

      statusOptions: [
        { value: '', label: 'All Status' },
        { value: 'paid', label: 'Paid', dot: 'bg-[#22c55e]' },
        { value: 'processing', label: 'Processing', dot: 'bg-[#f59e0b]' },
        { value: 'failed', label: 'Failed', dot: 'bg-[#ef4444]' },
      ],

      typeOptions: [
        { value: '', label: 'All Types' },
        { value: 'installment', label: 'Installment' },
        { value: 'full', label: 'Full Payment' },
        { value: 'registration', label: 'Registration' },
      ],

      get programOptions() {
        const programs = [...new Set(this.source.map((r) => r.courseName).filter(Boolean))];
        return [{ value: '', label: 'All Programs' }, ...programs.map((p) => ({ value: p, label: p }))];
      },

      get rangeLabel() {
        const total = this.filtered.length;
        if (total === 0) return 'No history';
        const start = (this.currentPage - 1) * this.size + 1;
        const end = Math.min(start + this.size - 1, total);
        return `Showing ${start}-${end} of ${total} history`;
      },

      async load() {
        await baseLoad.call(this);
        this.source = this.items;
        this.applyFilters();
      },

      applyFilters() {
        this.applied = { ...this.formData };
        const { from, to, status, type, program } = this.applied;

        this.items = this.source.filter((row) => {
          if (status && row.status !== status) return false;
          if (type && row.kind !== type) return false;
          if (program && row.courseName !== program) return false;
          if (from && new Date(row.date) < new Date(from)) return false;
          // `to` mencakup seluruh hari itu, bukan berhenti di tengah malamnya.
          if (to && new Date(row.date) > new Date(to + 'T23:59:59')) return false;
          return true;
        });

        this.currentPage = 1;
        this.applySearch(this.searchInput);
      },

      resetFilters() {
        this.formData = emptyDraft();
        this.searchInput = '';
        this.applyFilters();
      },

      formatDate(value) {
        if (!value) return '—';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return '—';
        return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
      },

      formatAmount(value) {
        const number = Number(value);
        if (Number.isNaN(number)) return '—';
        return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(number);
      },

      kindLabel(kind) {
        return kind === 'registration'
          ? 'Registration'
          : kind === 'installment'
            ? 'Installment payment'
            : 'Full payment';
      },
    };

    // defineProperties, bukan spread: spread mengevaluasi getter menjadi nilai
    // statis, sehingga `rows`, `totalPages`, `methodOptions`, dan `programOptions`
    // tidak akan pernah ikut berubah.
    return Object.defineProperties(base, Object.getOwnPropertyDescriptors(extension));
  }

  function installmentAction() {
    return {
      loadingMonth: null,
      async payMonth(paymentId, month) {
        if (this.loadingMonth) return;
        this.loadingMonth = month;
        try {
          const res = await fetch('/api/payment/installment-month', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ paymentId, month }),
          });
          const result = await res.json();
          if (result.status === 'success' && result.redirect_url) {
            window.location.href = result.redirect_url;
          } else {
            alert(result.message || 'Gagal memproses pembayaran cicilan.');
            this.loadingMonth = null;
          }
        } catch (err) {
          console.error('Pay installment error:', err);
          alert('Terjadi kesalahan saat memproses pembayaran.');
          this.loadingMonth = null;
        }
      },
      formatDate(value) {
        if (!value) return '—';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return '—';
        return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
      },
      formatAmount(value) {
        const number = Number(value);
        if (Number.isNaN(number)) return '—';
        return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(number);
      },
    };
  }
</script>
