{{!--
  Halaman: Payment History (tab area student)
  Lokasi: src/views/partials/user/sidebar_user_profile/history_payment/index.hbs
  Level: L3 Tab

  Mengikuti docs/design/user-area/payment-history.png: SATU daftar untuk semua
  jenis transaksi, bukan tiga sub-tab. Sumbernya GET /payment/api/history, yang
  sudah menggabungkan pembayaran lunas, pembayaran cicilan, dan pendaftaran
  menjadi satu bentuk baris (lihat PaymentsService.findPaymentHistory).

  Pencarian dan pagination memakai factory clientTable super admin; lapisan
  filter di atasnya menyaring `source` sebelum diserahkan ke clientTable.

  Semua filter berlaku LANGSUNG saat berubah — tidak ada tombol Apply, jadi
  `formData` sekaligus state filter yang aktif.

  Filter program memakai kotak search: mengetik menyaring daftar program
  (diturunkan dari riwayat transaksi user ini) dan langsung menyaring tabel.

  Status memakai tiga nilai yang memang ada di database: Paid, Processing,
  Failed. Frame desain juga menggambarkan "Pending", tetapi tidak ada padanannya
  di enum ProcessStatus sehingga tidak diada-adakan.
--}}
<div
  class='px-4 py-4 sm:px-8 sm:py-6'
  x-data='paymentHistory()'
  x-init='load()'
>
  <div class='flex flex-col gap-7'>

    <!-- Page Header (Figma token) -->
    <div class="flex flex-col gap-1 w-full">
      <h2 class="font-montserrat font-bold text-[28px] sm:text-[34px] leading-[36px] sm:leading-[42px] text-[#003060]">
        {{t "test.historyPayment.title"}}
      </h2>
      <p class="font-montserrat font-medium text-sm sm:text-[15px] leading-5 sm:leading-[21px] text-[#003060]">
        {{t "test.historyPayment.description"}}
      </p>
    </div>

    <!-- Filter Panel Container (Figma Filter panel) -->
    <div class="w-full bg-white border border-[#D8E6F6] rounded-xl p-[20px_16px_16px] sm:p-[24px_22px_18px_22px] shadow-[0px_3px_12px_rgba(23,59,104,0.0627)] flex flex-col gap-[18px]">
      <!-- Filter controls row (Figma Filter controls) -->
      <div class="flex flex-wrap items-end gap-4 xl:gap-[22px] w-full">
        <!-- 1. Date range -->
        <div class="flex flex-col gap-2 min-w-[200px] flex-1">
          <label class="font-montserrat font-medium text-sm leading-5 text-[#003060]">{{t "test.historyPayment.filter.dateRange"}}</label>
          <div class="relative w-full" x-data="{ openDate: false }" @click.outside="openDate = false" @keydown.escape="openDate = false">
            <button
              type="button"
              @click="openDate = !openDate"
              class="w-full h-[42px] px-4 pr-8 bg-white border border-[#D9D9D9] rounded-lg font-montserrat text-sm text-left flex items-center justify-between transition-colors hover:border-[#A3A3A3] focus:border-[#003060] focus:outline-none focus:ring-1 focus:ring-[#003060]"
              :class="(formData.from || formData.to) ? 'text-[#171717]' : 'text-[#718096]'"
            >
              <span class="truncate" x-text="dateRangeDisplay"></span>
              <span class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-[#718096]">
                <svg class="w-2.5 h-2.5 transition-transform" :class="openDate ? 'rotate-180' : ''" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1L5 5L9 1" stroke="#718096" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>

            <!-- Popover Date Range Picker -->
            <div
              x-show="openDate"
              x-cloak
              x-transition
              class="absolute left-0 top-[calc(100%+6px)] z-30 w-72 p-3 bg-white border border-[#E5E5E5] rounded-xl shadow-[0px_4px_16px_rgba(0,0,0,0.1)] flex flex-col gap-2.5"
            >
              <div class="flex flex-col gap-1">
                <span class="font-montserrat text-xs font-medium text-[#003060]">{{t "test.historyPayment.filter.fromDate"}}</span>
                <input
                  type="date"
                  x-model="formData.from"
                  @change="applyFilters()"
                  class="h-9 px-2.5 border border-[#D9D9D9] rounded-lg font-montserrat text-xs text-[#171717] focus:border-[#003060] focus:outline-none"
                />
              </div>
              <div class="flex flex-col gap-1">
                <span class="font-montserrat text-xs font-medium text-[#003060]">{{t "test.historyPayment.filter.toDate"}}</span>
                <input
                  type="date"
                  x-model="formData.to"
                  @change="applyFilters()"
                  class="h-9 px-2.5 border border-[#D9D9D9] rounded-lg font-montserrat text-xs text-[#171717] focus:border-[#003060] focus:outline-none"
                />
              </div>
              <div class="flex justify-between items-center pt-2 border-t border-[#F0F0F0]">
                <button
                  type="button"
                  @click="formData.from = ''; formData.to = ''; applyFilters()"
                  class="font-inter text-xs text-[#6280A5] hover:underline"
                >
                  {{t "test.historyPayment.filter.clear"}}
                </button>
                <button
                  type="button"
                  @click="openDate = false; applyFilters()"
                  class="px-3 py-1 bg-[#003060] text-white rounded font-montserrat text-xs font-medium hover:bg-[#00254a]"
                >
                  {{t "test.historyPayment.filter.done"}}
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Payment status -->
        <div class="flex flex-col gap-2 min-w-[170px] flex-1">
          <label class="font-montserrat font-medium text-sm leading-5 text-[#003060]">{{t "test.historyPayment.filter.paymentStatus"}}</label>
          <div class="relative w-full">
            <select
              x-model="formData.status"
              @change="applyFilters()"
              class="appearance-none w-full h-[42px] px-4 pr-8 bg-white border border-[#D9D9D9] rounded-lg font-montserrat text-sm transition-colors hover:border-[#A3A3A3] focus:border-[#003060] focus:outline-none focus:ring-1 focus:ring-[#003060]"
              :class="formData.status ? 'text-[#171717]' : 'text-[#718096]'"
            >
              <option value="">{{t "test.historyPayment.allStatus"}}</option>
              <option value="paid">{{t "test.historyPayment.accepted"}}</option>
              <option value="processing">{{t "test.historyPayment.processing"}}</option>
              <option value="failed">{{t "test.historyPayment.rejected"}}</option>
            </select>
            <div class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-[#718096]">
              <svg class="w-2.5 h-2.5" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L5 5L9 1" stroke="#718096" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- 3. Payment method -->
        <div class="flex flex-col gap-2 min-w-[170px] flex-1">
          <label class="font-montserrat font-medium text-sm leading-5 text-[#003060]">{{t "test.historyPayment.filter.paymentMethod"}}</label>
          <div class="relative w-full">
            <select
              x-model="formData.method"
              @change="applyFilters()"
              class="appearance-none w-full h-[42px] px-4 pr-8 bg-white border border-[#D9D9D9] rounded-lg font-montserrat text-sm transition-colors hover:border-[#A3A3A3] focus:border-[#003060] focus:outline-none focus:ring-1 focus:ring-[#003060]"
              :class="formData.method ? 'text-[#171717]' : 'text-[#718096]'"
            >
              <option value="">{{t "test.historyPayment.allMethods"}}</option>
              <option value="manual">Manual</option>
            </select>
            <div class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-[#718096]">
              <svg class="w-2.5 h-2.5" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L5 5L9 1" stroke="#718096" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- 3b. Transaction type -->
        <div class="flex flex-col gap-2 min-w-[170px] flex-1">
          <label class="font-montserrat font-medium text-sm leading-5 text-[#003060]">{{t "test.historyPayment.paymentType"}}</label>
          <div class="relative w-full">
            <select
              x-model="formData.transactionType"
              @change="applyFilters()"
              class="appearance-none w-full h-[42px] px-4 pr-8 bg-white border border-[#D9D9D9] rounded-lg font-montserrat text-sm transition-colors hover:border-[#A3A3A3] focus:border-[#003060] focus:outline-none focus:ring-1 focus:ring-[#003060]"
              :class="formData.transactionType ? 'text-[#171717]' : 'text-[#718096]'"
            >
              <option value="">{{t "test.historyPayment.all"}}</option>
              <option value="registration">{{t "test.historyPayment.kind.registration"}}</option>
              <option value="full payment">{{t "test.historyPayment.kind.full"}}</option>
              <option value="installment">{{t "test.historyPayment.kind.installment"}}</option>
            </select>
            <div class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-[#718096]">
              <svg class="w-2.5 h-2.5" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L5 5L9 1" stroke="#718096" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- 4. Program (pencarian + daftar program) -->
        <div class="flex flex-col gap-2 min-w-[180px] flex-1" @click.outside="programOpen = false">
          <label class="font-montserrat font-medium text-sm leading-5 text-[#003060]">{{t "test.historyPayment.filter.program"}}</label>
          <div class="relative w-full">
            <div class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[#718096]">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="#718096" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.3-4.3"/>
              </svg>
            </div>
            <input
              type="text"
              autocomplete="off"
              x-model="formData.program"
              @focus="programOpen = true"
              @input="programOpen = true; applyFilters()"
              @keydown.escape="programOpen = false"
              placeholder="{{t "test.historyPayment.filter.programPlaceholder"}}"
              class="w-full h-[42px] pl-11 pr-9 bg-white border border-[#D9D9D9] rounded-lg font-montserrat text-sm text-[#171717] placeholder-[#718096] transition-colors hover:border-[#A3A3A3] focus:border-[#003060] focus:outline-none focus:ring-1 focus:ring-[#003060]"
            />
            <button
              type="button"
              x-show="formData.program"
              x-cloak
              @click="clearProgram()"
              aria-label="{{t "test.historyPayment.filter.clear"}}"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-[#718096] hover:text-[#003060] transition-colors focus:outline-none"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"/>
                <path d="m6 6 12 12"/>
              </svg>
            </button>

            <!-- Daftar program yang cocok dengan teks di kotak search -->
            <ul
              x-show="programOpen"
              x-cloak
              x-transition
              class="absolute left-0 top-[calc(100%+6px)] z-30 max-h-[220px] overflow-y-auto overscroll-contain w-full bg-white border border-[#E5E5E5] rounded-xl shadow-[0px_4px_16px_rgba(0,0,0,0.1)] py-1"
            >
              <template x-for="opt in filteredProgramOptions" :key="opt.value">
                <li>
                  <button
                    type="button"
                    @click="selectProgram(opt)"
                    class="w-full px-4 py-2.5 text-left font-montserrat text-sm leading-5 text-[#171717] transition-colors hover:bg-[#F4F7FC] focus:outline-none"
                    x-text="opt.label"
                  ></button>
                </li>
              </template>
              <li
                x-show="!filteredProgramOptions.length"
                class="px-4 py-2.5 font-montserrat text-sm leading-5 text-[#718096]"
              >
                {{t "test.historyPayment.noProgramsFound"}}
              </li>
            </ul>
          </div>
        </div>

        <!-- 5. Reset filter -->
        <div class="flex items-center gap-3.5 pb-0.5 shrink-0">
          <button
            type="button"
            @click="resetFilters()"
            class="inline-flex items-center gap-2 text-[#6280A5] hover:text-[#003060] transition-colors shrink-0 group focus-visible:outline-none"
          >
            <svg class="w-3.5 h-3.5 text-[#6280A5] group-hover:rotate-180 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
              <path d="M3 3v5h5"/>
            </svg>
            <span class="font-inter font-normal text-[11px] leading-[13px] text-[#6280A5] group-hover:text-[#003060]">
              {{t "test.historyPayment.filter.reset"}}
            </span>
          </button>
        </div>
      </div>

          <!-- Search bar removed per request -->
    </div>

    <!-- Transaction list (Frame 2147229710) -->
    <div class="flex flex-col gap-[9px] w-full">
      <!-- Loading State -->
      <template x-if="loading">
        <div class="rounded-xl border border-[#D8E6F6] bg-white p-8 text-center font-montserrat text-sm text-[#718096]">
          {{t "test.historyPayment.loading"}}
        </div>
      </template>

      <!-- Empty State -->
      <template x-if="!loading && filtered.length === 0">
        <div class="flex flex-col items-center gap-3 rounded-xl border border-[#D8E6F6] bg-white p-12 text-center">
          <span class="grid size-14 place-items-center rounded-full bg-[#f4f7fc] text-[#003060]">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
          </span>
          <h3 class="font-montserrat text-xl font-bold text-[#003060]">{{t "test.historyPayment.noTransactions"}}</h3>
          <p class="font-montserrat text-sm text-[#718096]">{{t "test.historyPayment.adjustFilters"}}</p>
          <button
            type="button"
            @click="resetFilters()"
            class="mt-1 inline-flex h-11 items-center rounded-lg bg-[#003060] px-4 font-montserrat text-sm font-semibold text-white transition-colors hover:bg-[#00254a]"
          >
            {{t "test.historyPayment.resetFilters"}}
          </button>
        </div>
      </template>

      <!-- Rows using transaction_card component -->
      <template x-for="row in rows" :key="row.kind + row.id">
        {{> components/ui/card/transaction_card/index }}
      </template>
    </div>

    <!-- Pagination (Figma Pagination with Chevron & Ellipsis) -->
    <template x-if="filtered.length > 0">
      <div class="box-border flex flex-wrap items-center justify-between gap-4 w-full min-h-[56px] px-6 sm:px-8 py-3 bg-white border border-[#D9D9D9] rounded-2xl">
        <span class="font-montserrat font-medium text-sm leading-[17px] text-[#003060]" x-text="rangeLabel"></span>
        <div class="flex items-center gap-2">
          <!-- Chevron Left -->
          <button
            type="button"
            @click="changePage(currentPage - 1)"
            :disabled="currentPage <= 1"
            aria-label="{{t "test.historyPayment.prev"}}"
            class="flex items-center justify-center w-8 h-8 rounded-full border border-[#D9D9D9] bg-white text-[#003060] hover:bg-slate-50 transition-colors focus-visible:outline-none disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>

          <!-- Page Numbers -->
          <template x-for="(page, idx) in visiblePages" :key="idx">
            <div class="flex items-center">
              <template x-if="page === '...'">
                <span class="flex items-center justify-center w-8 h-8 font-montserrat font-semibold text-sm text-[#718096]">...</span>
              </template>
              <template x-if="page !== '...'">
                <button
                  type="button"
                  @click="changePage(page)"
                  :class="page === currentPage
                    ? 'bg-[#003060] text-white border-transparent shadow-sm'
                    : 'bg-white text-[#003060] border border-[#D9D9D9] hover:bg-slate-50'"
                  class="flex flex-col justify-center items-center w-8 h-8 rounded-full font-montserrat font-semibold text-sm leading-[17px] transition-colors focus-visible:outline-none"
                  x-text="page"
                ></button>
              </template>
            </div>
          </template>

          <!-- Chevron Right -->
          <button
            type="button"
            @click="changePage(currentPage + 1)"
            :disabled="currentPage >= totalPages"
            aria-label="{{t "test.historyPayment.next"}}"
            class="flex items-center justify-center w-8 h-8 rounded-full border border-[#D9D9D9] bg-white text-[#003060] hover:bg-slate-50 transition-colors focus-visible:outline-none disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        </div>
      </div>
    </template>

  </div>

  {{!-- View Detail Modal (Figma & Stitch LMS Kesatria UI Viewer design with backdrop blur) --}}
  {{> components/ui/modal/transaction_detail/index user=user }}
</div>

{{> components/ui/super_admin/table/client_table }}

<script>
  function paymentHistory() {
    const base = clientTable({
      url: '/payment/api/history',
      dataKey: 'data',
      size: 5,
      searchKeys: ['courseName', 'no', 'method'],
    });

    // defineProperties di bawah MENIMPA base.load dengan load() milik extension,
    // jadi referensi aslinya harus dipegang lebih dulu — kalau tidak, load()
    // memanggil dirinya sendiri dan daftar berhenti di keadaan loading.
    const baseLoad = base.load;

    const emptyDraft = () => ({ from: '', to: '', status: '', method: '', program: '', transactionType: '' });

    const extension = {
      // Semua baris apa adanya dari server. `items` milik clientTable adalah
      // hasil filter yang sedang aktif, jadi sumbernya harus disimpan terpisah.
      source: [],

      // formData adalah state filter yang aktif: setiap filter langsung
      // berlaku begitu berubah, tanpa tombol Apply.
      formData: emptyDraft(),
      formErrors: {},
      validateField() {},
      touch() {},

      // Buka/tutup daftar program di bawah kotak search program.
      programOpen: false,

      get statusOptions() {
        return [
          { value: '', label: '{{t "test.historyPayment.allStatus"}}' },
          { value: 'paid', label: '{{t "test.historyPayment.accepted"}}' },
          { value: 'processing', label: '{{t "test.historyPayment.processing"}}' },
          { value: 'failed', label: '{{t "test.historyPayment.rejected"}}' },
        ];
      },

      get methodOptions() {
        return [
          { value: '', label: '{{t "test.historyPayment.allMethods"}}' },
          { value: 'manual', label: 'Manual' },
          {{!-- { value: 'xendit', label: 'Xendit' }, --}}
        ];
      },

      // Semua program yang muncul di riwayat transaksi user ini. Opsi "All
      // Programs" (value kosong) berarti tidak ada program yang difilter.
      get programOptions() {
        const programs = [...new Set(this.source.map((r) => r.courseName).filter(Boolean))];
        return [{ value: '', label: '{{t "test.historyPayment.allPrograms"}}' }, ...programs.map((p) => ({ value: p, label: p }))];
      },

      // Program yang cocok dengan teks di kotak search. Opsi "All Programs"
      // disembunyikan begitu ada teks, karena itu bukan program.
      get filteredProgramOptions() {
        const needle = String(this.formData.program || '').trim().toLowerCase();
        if (!needle) return this.programOptions;
        return this.programOptions.filter(
          (opt) => opt.value && opt.label.toLowerCase().includes(needle),
        );
      },

      get dateRangeDisplay() {
        if (this.formData.from && this.formData.to) {
          return this.formatDate(this.formData.from) + ' – ' + this.formatDate(this.formData.to);
        } else if (this.formData.from) {
          return '{{t "test.historyPayment.from"}} ' + this.formatDate(this.formData.from);
        } else if (this.formData.to) {
          return '{{t "test.historyPayment.until"}} ' + this.formatDate(this.formData.to);
        }
        return '{{t "test.historyPayment.selectDateRange"}}';
      },

      get rangeLabel() {
        const total = this.filtered.length;
        if (total === 0) return '{{t "test.historyPayment.noHistory"}}';
        const start = (this.currentPage - 1) * this.size + 1;
        const end = Math.min(start + this.size - 1, total);
        const tpl = '{{t "test.historyPayment.rangeTemplate"}}';
        return tpl.replace('{start}', start).replace('{end}', end).replace('{total}', total);
      },

      async load() {
        await baseLoad.call(this);
        this.source = Array.isArray(this.items) ? [...this.items] : [];
        this.applyFilters();
      },

      get transactionTypeOptions() {
        return [
          { value: '', label: '{{t "test.historyPayment.all"}}' },
          { value: 'registration', label: '{{t "test.historyPayment.kind.registration"}}' },
          { value: 'full payment', label: '{{t "test.historyPayment.kind.full"}}' },
          { value: 'installment', label: '{{t "test.historyPayment.kind.installment"}}' },
        ];
      },

      applyFilters() {
        const { from, to, status, method, program, transactionType } = this.formData;
        const isAll = (v) => {
          if (!v) return true;
          const s = String(v).trim().toLowerCase();
          return s === '' || s === 'all' || s === 'all status' || s === 'semua status' || s === 'all methods' || s === 'semua metode' || s === 'semua';
        };

        this.items = (this.source || []).filter((row) => {
          if (!isAll(status) && String(row.status || '').toLowerCase() !== String(status).toLowerCase()) return false;
          if (!isAll(method)) {
            const ch = row.paymentChannel || row.channel || '';
            if (String(ch).toLowerCase() !== String(method).toLowerCase()) return false;
          }
          if (!isAll(transactionType)) {
            const t = row.transactionType || row.transactionKind || row.type || row.kind;
            if (String(t).toLowerCase() !== String(transactionType).toLowerCase()) return false;
          }
          // Program dicocokkan dengan teks di kotak search: sebagian nama
          // sudah diketik pengguna tetap menyaring baris yang relevan.
          if (program && !isAll(program)) {
            const name = String(row.courseName || '').toLowerCase();
            if (!name.includes(String(program).trim().toLowerCase())) return false;
          }
          if (from && new Date(row.date) < new Date(from)) return false;
          // `to` mencakup seluruh hari itu, bukan berhenti di tengah malamnya.
          if (to && new Date(row.date) > new Date(to + 'T23:59:59')) return false;
          return true;
        });

        this.currentPage = 1;
        if (typeof this.applySearch === 'function') {
          this.applySearch(this.searchInput || '');
        }
      },

      selectProgram(option) {
        this.formData.program = option.value;
        this.programOpen = false;
        this.applyFilters();
      },

      clearProgram() {
        this.formData.program = '';
        this.programOpen = false;
        this.applyFilters();
      },

      resetFilters() {
        this.formData = emptyDraft();
        this.programOpen = false;
        this.searchInput = '';
        this.applyFilters();
      },

      formatDate(value) {
        if (!value) return '—';
        if (typeof value === 'string') {
          const [datePart] = value.split('T');
          const [year, month, day] = datePart.split('-').map(Number);
          if (!year || !month || !day) return '—';
          const date = new Date(year, month - 1, day);
          return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        }
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return '—';
        return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
      },

      formatAmount(value) {
        const number = Number(value);
        if (Number.isNaN(number)) return '—';
        return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(number);
      },

      kindLabel(kind) {
        return kind === 'registration'
          ? '{{t "test.historyPayment.kind.registration"}}'
          : kind === 'installment'
            ? '{{t "test.historyPayment.kind.installment"}}'
            : '{{t "test.historyPayment.kind.full"}}';
      },
    };

    // defineProperties, bukan spread: spread mengevaluasi getter menjadi nilai
    // statis, sehingga `rows`, `totalPages`, `methodOptions`, dan `programOptions`
    // tidak akan pernah ikut berubah.
    return Object.defineProperties(base, Object.getOwnPropertyDescriptors(extension));
  }
</script>
