{{!--
  Halaman: My Logbook (tab area student)
  Lokasi: src/views/partials/user/sidebar_user_profile/logbook/index.hbs
  Level: L3 Tab

  Tidak ada frame Figma untuk layar ini, jadi tokennya mengikuti halaman super
  admin sesuai CONTRIBUTING.md bagian "User area": page_header, description,
  kartu tabel berbingkai, badge status, dan modal detail.

  State-nya milik shell (user_profile/index.hbs): allLogbooks, logbookSearchInput,
  logbookCurrentPage, logbookItemsPerPage, logbookImageErrors, dan getter
  filteredLogbooks / paginatedLogbooks / totalLogbookPages yang sudah memfilter
  per course aktif. Berkas ini hanya merender — jangan memindahkan state itu ke
  sini, shell adalah satu-satunya titik gagal untuk seluruh area login.
--}}
<div class='p-4 sm:px-[34px] sm:py-[42px]'>
  <div class='flex flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        titleTag='h2'
        title='My Logbook'
      }}
      {{> components/ui/super_admin/description/index
        text='View and monitor your submitted logbook entries throughout the program.'
      }}
    </div>

    <div class='flex flex-col gap-3.5'>

      {{!-- Toolbar --}}
      <div class='flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between'>
        <div class='relative w-full sm:max-w-[420px]'>
          <span class='pointer-events-none absolute left-3.5 top-1/2 flex h-4 w-4 -translate-y-1/2 items-center justify-center text-[#737373]'>
            <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-4 w-4'><circle cx='11' cy='11' r='8'/><path d='m21 21-4.3-4.3'/></svg>
          </span>
          <input
            type='search'
            x-model='logbookSearchInput'
            @input='logbookCurrentPage = 1'
            aria-label='Search logbook entries'
            placeholder='Search activities, details, or issues...'
            class='h-11 w-full rounded-lg border border-[#d4d4d4] bg-white py-2.5 pl-10 pr-3.5 font-inter text-base leading-6 text-[#171717] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors placeholder:text-[#737373] hover:border-[#a3a3a3] focus:border-[#003060] focus:outline-none focus:ring-2 focus:ring-[#003060]/20'
          />
        </div>

        {{!-- Tombol ini sebelumnya tidak punya handler sama sekali. Sekarang
             memakai exportRowsToExcel() yang sudah dipakai tab log book super admin. --}}
        <button
          type='button'
          @click="exportRowsToExcel({
            rows: filteredLogbooks,
            columns: [
              { header: 'Date', width: 16, value: (r) => new Date(r.createdAt).toLocaleDateString('en-GB') },
              { header: 'Activity', width: 28, value: (r) => r.activity || '' },
              { header: 'Details', width: 40, value: (r) => r.activityDetails || '' },
              { header: 'Issues', width: 28, value: (r) => r.obstacles || '' },
              { header: 'Program', width: 26, value: (r) => r.session?.weeks?.course?.name || '' },
              { header: 'Status', width: 14, value: (r) => r.process || '' }
            ],
            sheetName: 'Logbook',
            filePrefix: 'my-logbook'
          })"
          class='inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-lg border border-[#d4d4d4] bg-white px-4 font-inter text-sm font-semibold text-[#344054] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#f9fafb]'
        >
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-4 w-4'><path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'/><path d='M7 10l5 5 5-5'/><path d='M12 15V3'/></svg>
          Export Excel
        </button>
      </div>

      {{!-- Kartu tabel --}}
      <div class='flex h-fit w-full flex-col gap-6 rounded-xl border border-[#d9d9d9] bg-white p-5'>
        <div class='-mx-5 -mt-5 overflow-x-auto'>
          <table class='w-full min-w-[900px] border-collapse'>
            <thead>
              <tr class='border-b border-[#e5e5e5] bg-[#fafafa]'>
                <th class='px-5 py-3 text-left font-inter text-xs font-semibold uppercase tracking-wide text-[#737373]'>No</th>
                <th class='px-5 py-3 text-left font-inter text-xs font-semibold uppercase tracking-wide text-[#737373]'>Date</th>
                <th class='px-5 py-3 text-left font-inter text-xs font-semibold uppercase tracking-wide text-[#737373]'>Activity</th>
                <th class='px-5 py-3 text-left font-inter text-xs font-semibold uppercase tracking-wide text-[#737373]'>Details</th>
                <th class='px-5 py-3 text-left font-inter text-xs font-semibold uppercase tracking-wide text-[#737373]'>Issues</th>
                <th class='px-5 py-3 text-left font-inter text-xs font-semibold uppercase tracking-wide text-[#737373]'>Program</th>
                <th class='px-5 py-3 text-left font-inter text-xs font-semibold uppercase tracking-wide text-[#737373]'>Status</th>
                <th class='px-5 py-3 text-right font-inter text-xs font-semibold uppercase tracking-wide text-[#737373]'>Action</th>
              </tr>
            </thead>
            <tbody>
              <template x-for='(logbook, index) in paginatedLogbooks' :key='logbook.id'>
                <tr class='border-b border-[#f0f0f0] transition-colors last:border-0 hover:bg-[#fafafa]'>
                  <td class='px-5 py-4 font-inter text-sm text-[#737373]' x-text='(logbookCurrentPage - 1) * logbookItemsPerPage + index + 1'></td>
                  <td class='whitespace-nowrap px-5 py-4 font-inter text-sm text-[#171717]' x-text="new Date(logbook.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })"></td>
                  <td class='max-w-[200px] px-5 py-4 font-inter text-sm text-[#171717]'>
                    <span class='line-clamp-2' x-text="logbook.activity || '—'"></span>
                  </td>
                  <td class='max-w-[260px] px-5 py-4 font-inter text-sm text-[#737373]'>
                    <span class='line-clamp-2' x-text="logbook.activityDetails || '—'"></span>
                  </td>
                  <td class='max-w-[180px] px-5 py-4 font-inter text-sm text-[#737373]'>
                    <span class='line-clamp-2' x-text="logbook.obstacles || '—'"></span>
                  </td>
                  <td class='px-5 py-4'>
                    {{> components/ui/super_admin/badge/index
                      text="logbook.session?.weeks?.course?.name || '—'"
                      class='bg-[#eef4ff] text-[#3538cd]'
                    }}
                  </td>
                  <td class='px-5 py-4'>
                    {{> components/ui/super_admin/badge/index
                      text="logbook.process === 'approved' ? 'Approved' : (logbook.process === 'process' ? 'In review' : 'Rejected')"
                      dot=true
                      classExpr="logbook.process === 'approved' ? 'bg-[#f0fdf4] text-[#15803d]' : (logbook.process === 'process' ? 'bg-[#fffbeb] text-[#b45309]' : 'bg-[#fef2f2] text-[#b91c1c]')"
                      dotClassExpr="logbook.process === 'approved' ? 'bg-[#22c55e]' : (logbook.process === 'process' ? 'bg-[#f59e0b]' : 'bg-[#ef4444]')"
                    }}
                  </td>
                  <td class='px-5 py-4 text-right'>
                    <button
                      type='button'
                      @click="openDetailModal('logbook', logbook)"
                      class='inline-flex h-9 items-center rounded-lg border border-[#d4d4d4] bg-white px-3 font-inter text-sm font-medium text-[#344054] transition-colors hover:bg-[#f9fafb]'
                    >View</button>
                  </td>
                </tr>
              </template>

              <template x-if='filteredLogbooks.length === 0'>
                <tr>
                  <td colspan='8' class='px-5 py-10 text-center font-inter text-sm text-[#737373]'>
                    No logbook entries found for this program.
                  </td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>

        <div class='flex flex-wrap items-center justify-between gap-4'>
          <span
            class='font-inter text-sm text-[#737373]'
            x-text="`Showing ${paginatedLogbooks.length} of ${filteredLogbooks.length} entries`"
          ></span>

          <div class='flex items-center gap-2' x-show='totalLogbookPages > 1'>
            <button
              type='button'
              @click='if (logbookCurrentPage > 1) logbookCurrentPage--'
              :disabled='logbookCurrentPage === 1'
              class='inline-flex h-9 items-center rounded-lg border border-[#d4d4d4] bg-white px-3 font-inter text-sm font-medium text-[#344054] transition-colors hover:bg-[#f9fafb] disabled:cursor-not-allowed disabled:opacity-50'
            >Previous</button>
            <span class='font-inter text-sm text-[#737373]' x-text='`${logbookCurrentPage} / ${totalLogbookPages}`'></span>
            <button
              type='button'
              @click='if (logbookCurrentPage < totalLogbookPages) logbookCurrentPage++'
              :disabled='logbookCurrentPage === totalLogbookPages'
              class='inline-flex h-9 items-center rounded-lg border border-[#d4d4d4] bg-white px-3 font-inter text-sm font-medium text-[#344054] transition-colors hover:bg-[#f9fafb] disabled:cursor-not-allowed disabled:opacity-50'
            >Next</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  {{> components/ui/super_admin/table/export_excel }}

  {{#> components/ui/super_admin/modal/detail/index name='logbook' title='Logbook Entry' maxWidth='max-w-[640px]'}}
    <div class='flex flex-col gap-5'>
      <dl class='grid grid-cols-1 gap-5 sm:grid-cols-2'>
        <div class='flex flex-col gap-1'>
          <dt class='font-inter text-sm font-medium text-[#737373]'>Date</dt>
          <dd class='font-inter text-sm text-[#171717]' x-text="new Date(row.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })"></dd>
        </div>
        <div class='flex flex-col gap-1'>
          <dt class='font-inter text-sm font-medium text-[#737373]'>Program</dt>
          <dd class='font-inter text-sm text-[#171717]' x-text="row.session?.weeks?.course?.name || '—'"></dd>
        </div>
        <div class='flex flex-col gap-1'>
          <dt class='font-inter text-sm font-medium text-[#737373]'>Session</dt>
          <dd class='font-inter text-sm text-[#171717]' x-text="row.session?.topic || '—'"></dd>
        </div>
        <div class='flex flex-col gap-1'>
          <dt class='font-inter text-sm font-medium text-[#737373]'>Status</dt>
          <dd class='font-inter text-sm text-[#171717]' x-text="row.process === 'approved' ? 'Approved' : (row.process === 'process' ? 'In review' : 'Rejected')"></dd>
        </div>
      </dl>

      <div class='flex flex-col gap-1'>
        <span class='font-inter text-sm font-medium text-[#737373]'>Activity</span>
        <p class='font-inter text-sm text-[#171717]' x-text="row.activity || '—'"></p>
      </div>
      <div class='flex flex-col gap-1'>
        <span class='font-inter text-sm font-medium text-[#737373]'>Details</span>
        <p class='whitespace-pre-line font-inter text-sm text-[#171717]' x-text="row.activityDetails || '—'"></p>
      </div>
      <div class='flex flex-col gap-1'>
        <span class='font-inter text-sm font-medium text-[#737373]'>Issues</span>
        <p class='whitespace-pre-line font-inter text-sm text-[#171717]' x-text="row.obstacles || '—'"></p>
      </div>

      <template x-if="row.documentation && row.documentation !== 'null'">
        <div class='flex flex-col gap-2'>
          <span class='font-inter text-sm font-medium text-[#737373]'>Documentation</span>
          <a :href='row.documentation' target='_blank' rel='noopener' class='overflow-hidden rounded-lg border border-[#e5e5e5]'>
            <img :src='row.documentation' alt='Logbook documentation' class='w-full object-contain' />
          </a>
        </div>
      </template>
    </div>
  {{/components/ui/super_admin/modal/detail/index}}
</div>
