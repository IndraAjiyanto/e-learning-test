<div x-data="{ view: 'list', selectedAssignment: null }" class="w-full">
  
  <!-- ==================== VIEW: LIST (DEFAULT) ==================== -->
  <div x-show="view === 'list'" x-transition class="w-full p-4 sm:px-[34px] sm:py-[42px]">

    <div class="flex flex-col gap-1">
      {{> components/ui/super_admin/page_header/index titleTag='h2' title='Assignment' }}
      {{> components/ui/super_admin/description/index text='Your tasks will be displayed here.' }}
    </div>

    <!-- Week Sections (Dynamic with Alpine.js): one collapsible block per real week -->
    {{#each course.weeks}}
    <div
      class="w-full"
      x-data="{
        openWeek: false,
        sessions: [],
        sessionsLoading: false,
        sessionsError: false,
        loadedWeekId: null,
        async loadSessions(weekId) {
          this.loadedWeekId = weekId;
          this.sessions = [];
          this.sessionsError = false;
          this.sessionsLoading = true;
          try {
            const res = await fetch('/program/session/' + weekId);
            if (!res.ok) throw new Error('Request failed');
            const data = await res.json();
            if (this.loadedWeekId !== weekId) return;
            this.sessions = Array.isArray(data) ? data : [];
          } catch (e) {
            if (this.loadedWeekId !== weekId) return;
            this.sessionsError = true;
          } finally {
            if (this.loadedWeekId === weekId) this.sessionsLoading = false;
          }
        }
      }"
    >

      <!-- Week Header -->
      <div class="w-full flex justify-between items-center mt-8 mb-4 cursor-pointer" @click="openWeek = !openWeek; if (openWeek && loadedWeekId !== '{{id}}') loadSessions('{{id}}')">
        <h3 class="font-inter text-xl font-bold leading-tight text-[#003060]">
          Week {{weekNumber}} : {{description}}
        </h3>
        <div class="w-9 h-9 flex items-center justify-center rounded-full bg-[#003060]/10 text-[#003060] hover:bg-[#003060]/20 transition">
          <i class="fas fa-chevron-up text-sm transition-transform duration-300" :class="openWeek ? '' : 'rotate-180'"></i>
        </div>
      </div>

      <!-- Week Content (Collapsible, sessions fetched from GET /program/session/:weeksId) -->
      <div x-show="openWeek" x-transition class="w-full flex flex-col gap-6">

        <!-- Sessions Loading State -->
        <template x-if="sessionsLoading">
          <div class="w-full max-w-[1232px] bg-white border border-[#E5E7EB] rounded-[12px] shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition p-6 sm:p-8 text-center">
            <div class="w-8 h-8 border-2 border-[#003060] border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
            <p class="font-inter font-medium text-[#003060]">Loading sessions...</p>
          </div>
        </template>

        <!-- Sessions Error State -->
        <template x-if="!sessionsLoading && sessionsError">
          <div class="w-full max-w-[1232px] bg-white border border-[#E5E7EB] rounded-[12px] shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition p-6 sm:p-8 text-center space-y-3">
            <p class="font-inter font-medium text-red-600">Failed to load sessions. Please try again.</p>
            <button type="button" @click="loadSessions('{{id}}')" class="font-inter font-medium text-[#003060] underline cursor-pointer">
              Retry
            </button>
          </div>
        </template>

        <!-- Sessions Empty State -->
        <template x-if="!sessionsLoading && !sessionsError && sessions.length === 0">
          <div class="w-full max-w-[1232px] bg-white border border-[#E5E7EB] rounded-[12px] shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition p-6 sm:p-8 text-center">
            <p class="font-inter font-medium text-[#003060]">No sessions available for this week.</p>
          </div>
        </template>

        <!-- Assignment Card (one per Session) -->
        <template x-for="session in sessions" :key="session.id">
          <div x-data="{
            open: false,
            answer: session.assignments?.[0]?.taskAnswers?.[0] ?? null,
            get status() {
              if (!this.answer) return 'pending';
              return this.answer.process === 'approved' ? 'approved' : 'review';
            },
            get submissionDate() {
              if (!this.answer?.createdAt) return '';
              return new Date(this.answer.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            },
            get submissionTime() {
              if (!this.answer?.createdAt) return '';
              return new Date(this.answer.createdAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
            },
            answerUrl: session.assignments?.[0]?.taskAnswers?.[0]?.file ?? '',
            editing: false,
            submitting: false,
            submitError: '',
            async submitAnswer() {
              const assignmentId = session.assignments?.[0]?.id;
              this.submitting = true;
              this.submitError = '';
              try {
                const res = await fetch(
                  this.answer
                    ? `/answer-assigment/${assignmentId}/${this.answer.id}`
                    : `/answer-assigment/${assignmentId}/${session.id}`,
                  {
                    method: this.answer ? 'PATCH' : 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify({ file: this.answerUrl }),
                  },
                );
                const data = await res.json();
                if (!res.ok || !data.success) throw new Error(data.message || 'Submission failed');
                this.answer = data.answer;
                this.editing = false;
              } catch (e) {
                this.submitError = e.message || 'Submission failed';
              } finally {
                this.submitting = false;
              }
            },
          }" class="relative flex w-full flex-col gap-6 rounded-xl border border-[#d9d9d9] bg-white p-5 sm:p-8">

            <!-- Status Badges: normal flow, not absolute - an absolute top-right badge here used
                 to sit directly on top of the chevron toggle button below, causing a visible overlap. -->
            <div x-show="status === 'review' || status === 'approved'" x-cloak class="flex justify-end">
              {{> components/ui/super_admin/badge/index
                text='status === "approved" ? "Approved" : "Under review"'
                dot=true
                classExpr="status === 'approved' ? 'bg-[#f0fdf4] text-[#15803d]' : 'bg-[#fffbeb] text-[#b45309]'"
                dotClassExpr="status === 'approved' ? 'bg-[#22c55e]' : 'bg-[#f59e0b]'"
              }}
            </div>

            <!-- Header Card (click to expand/collapse this session's assignment) -->
            <div class="flex items-center justify-between gap-4 cursor-pointer" @click="open = !open">
              <h3 class="font-inter font-semibold text-base sm:text-lg leading-snug text-[#003060]" x-text="'Session ' + session.sessionOrder + ' - ' + session.topic"></h3>
              <div class="w-9 h-9 shrink-0 flex items-center justify-center rounded-full bg-[#003060]/10 text-[#003060] hover:bg-[#003060]/20 transition">
                <i class="fas fa-chevron-up text-sm transition-transform duration-300" :class="open ? '' : 'rotate-180'"></i>
              </div>
            </div>

            <!-- Session Content (Collapsible) -->
            <div x-show="open" x-transition class="flex flex-col gap-6">

              {{!-- Tenggat sengaja TIDAK dirender. Sebelumnya di sini ada teks
                   "Due date: Apr, 10 2026" dan "Deadline time: 23:59 WIB" yang
                   dituliskan tetap, padahal entity Assignment maupun Session tidak
                   punya kolom tenggat sama sekali. Menampilkan tanggal karangan
                   pada halaman tugas lebih berbahaya daripada tidak menampilkan
                   apa pun. Munculkan lagi setelah backend menambah kolomnya. --}}

              <!-- Assignment Link -->
              <div class="flex flex-col gap-2" x-show="session.assignments?.[0]?.file">
                <h4 class="font-inter font-semibold text-base sm:text-lg text-[#003060]">
                  Your Assignment here:
                </h4>
                <a :href="session.assignments?.[0]?.file || '#'" @click.prevent="selectedAssignment = session.assignments?.[0]; view = 'detail'" class="font-inter font-medium text-sm sm:text-base text-[#003060] underline hover:text-blue-700" x-text="session.assignments?.[0]?.file"></a>
              </div>

              <!-- Default State: Form Submission -->
              <form x-show="status === 'pending' || editing" @submit.prevent="submitAnswer" class="flex flex-col gap-4">
                <h4 class="font-inter font-semibold text-base sm:text-lg text-[#003060]">
                  Your Answer:
                </h4>
                <p class="font-inter font-medium text-sm text-[#003060]">
                  Enter a GitHub link, Google Drive, or any online file sharing link.
                </p>

                <div class="flex flex-col sm:flex-row items-start sm:items-center gap-[15px] mt-2">
                  <input
                    type="url"
                    x-model="answerUrl"
                    placeholder="https://drive.google.com/..."
                    required
                    title="Enter a valid URL, for example https://drive.google.com"
                    class="h-11 w-full max-w-[504px] rounded-lg border border-[#d4d4d4] bg-white px-3.5 py-2.5 font-inter text-base leading-6 text-[#171717] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors placeholder:text-[#737373] hover:border-[#a3a3a3] focus:border-[#003060] focus:outline-none focus:ring-2 focus:ring-[#003060]/20"
                  >
                </div>

                <p x-show="submitError" x-cloak x-text="submitError" class="font-inter text-xs text-red-600"></p>

                <div class="flex items-center gap-4 mt-6">
                  <button type="submit" :disabled="submitting" class="inline-flex h-11 items-center justify-center rounded-lg border border-[#003060] bg-[#003060] px-[18px] font-inter text-sm font-semibold text-white transition-colors hover:bg-[#00254a] disabled:cursor-not-allowed disabled:opacity-60">
                    <span x-show="!submitting">Submit Answer</span>
                    <span x-show="submitting" x-cloak>Submitting...</span>
                  </button>
                  <button x-show="editing" type="button" @click="editing = false" class="inline-flex h-11 items-center justify-center rounded-lg border border-[#d4d4d4] bg-white px-[18px] font-inter text-sm font-semibold text-[#344054] transition-colors hover:bg-[#f9fafb]">
                    Cancel
                  </button>
                </div>
              </form>

              <!-- Submitted State: Under Review / Approved -->
              <div x-show="(status === 'review' || status === 'approved') && !editing" x-cloak class="flex flex-col gap-4">
                <h4 class="font-inter font-semibold text-base sm:text-lg text-[#003060]">
                  Your Answer:
                </h4>

                <!-- Submission Date & Time Info -->
                <div class="flex flex-col gap-[10px]">
                  <div class="flex items-center gap-[8px] text-[#003060]">
                    <i class="far fa-calendar text-sm"></i>
                    <span class="font-inter font-semibold text-sm leading-relaxed">
                      Submission Date: <span class="text-[#12BD26]" x-text="submissionDate"></span>
                    </span>
                  </div>
                  <div class="flex items-center gap-[8px] text-[#003060]">
                    <i class="far fa-clock text-sm"></i>
                    <span class="font-inter font-semibold text-sm leading-relaxed">
                      Submission Time: <span class="text-[#12BD26]" x-text="submissionTime"></span>
                    </span>
                  </div>
                </div>

                <!-- Submitted URL -->
                <div class="flex items-center mt-2 px-[18px] bg-white h-9 w-fit">
                  <span class="font-inter font-medium text-sm text-black" x-text="answerUrl"></span>
                </div>

                <!-- Action / Result Area -->
                <div class="mt-4">
                  <!-- Button shown only when Under Review -->
                  <button x-show="status === 'review'" type="button" @click="editing = true" class="mt-2 inline-flex h-11 items-center justify-center rounded-lg border border-[#d4d4d4] bg-white px-[18px] font-inter text-sm font-semibold text-[#344054] transition-colors hover:bg-[#f9fafb]">
                    Edit Submission
                  </button>

                  {{!-- Nilai sengaja TIDAK dirender. Sebelumnya setiap tugas yang
                       disetujui menampilkan "Poin: 90/100 Good Job" secara tetap,
                       padahal entity AnswerTask tidak punya kolom nilai. Munculkan
                       lagi setelah backend menambah kolomnya. --}}
                </div>
              </div>

            </div>

          </div>
        </template>

      </div>
    </div>
    {{/each}}

    {{#unless course.weeks.length}}
      <div class="flex w-full flex-col items-center gap-3 rounded-xl border border-[#d9d9d9] bg-white p-12 text-center">
        <span class="grid size-14 place-items-center rounded-full bg-[#f4f7fc] text-[#003060]">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
        </span>
        <h3 class="font-inter text-xl font-bold text-[#003060]">No assignments yet</h3>
        <p class="font-inter text-sm text-[#737373]">
          This program has no weeks or sessions yet. Your mentor will add them soon.
        </p>
      </div>
    {{/unless}}

  </div>

  <!-- ==================== VIEW: DETAIL (PDF PREVIEW) ==================== -->
  <div x-show="view === 'detail'" x-cloak x-transition class="w-full p-4 sm:px-[34px] sm:py-[42px]">

    <div class="flex items-center gap-4">
      <button @click="view = 'list'" aria-label="Back to assignment list" class="grid size-11 shrink-0 place-items-center rounded-lg border border-[#d4d4d4] bg-white text-[#344054] transition-colors hover:bg-[#f9fafb]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      </button>
      <div class="flex flex-col gap-1">
        {{> components/ui/super_admin/page_header/index titleTag='h2' title='Your Assignment Here' }}
        {{> components/ui/super_admin/description/index text='Check your assignment and submit it.' }}
      </div>
    </div>

    <!-- Content Layout -->
    <div class="flex flex-wrap lg:flex-nowrap gap-8 mt-12 w-full">
      
      <!-- Left: PDF Preview Box -->
      <div class="relative flex h-[540px] w-full max-w-[732px] items-center justify-center overflow-hidden rounded-xl border border-[#d9d9d9] bg-white">
        <template x-if="selectedAssignment?.file">
          <iframe :src="selectedAssignment.file" type="application/pdf" class="w-full h-full" title="Assignment PDF"></iframe>
        </template>
        <template x-if="!selectedAssignment?.file">
          <span class="text-slate-400 font-medium text-lg">No file available</span>
        </template>
      </div>

    </div>

  </div>

</div>
