<div x-data="{ view: 'list' }" class="w-full">
  
  <!-- ==================== VIEW: LIST (DEFAULT) ==================== -->
  <div x-show="view === 'list'" x-transition class="w-full flex flex-col items-start p-16 gap-[15px]">
    
    <!-- Assignment Header -->
    <div class="flex flex-col gap-2">
      <h1 class="font-montserrat font-semibold text-[36px] leading-[44px] text-[#003060]">
        Assignment
      </h1>
      <p class="font-open-sans font-normal text-[20px] leading-[27px] text-[#003060]">
        Your tasks will be displayed here.
      </p>
    </div>

    <!-- Week Section Dropdown (Dynamic with Alpine.js) -->
    <div x-data="{ openWeek: true }" class="w-full">
      
      <!-- Week Header -->
      <div class="w-full flex justify-between items-center mt-8 mb-4 cursor-pointer" @click="openWeek = !openWeek">
        <h2 class="font-montserrat font-semibold text-[25px] leading-[30px] text-[#003060]">
          Week 1 : Minggu Pertama
        </h2>
        <div class="w-[35px] h-[35px] flex items-center justify-center rounded-full bg-[#003060]/10 text-[#003060] hover:bg-[#003060]/20 transition">
          <i class="fas fa-chevron-up transition-transform duration-300" :class="openWeek ? '' : 'rotate-180'"></i>
        </div>
      </div>

      <!-- Assignment Card (Collapsible Content) -->
      <div x-data="{ status: 'pending', answerUrl: '' }" x-show="openWeek" x-transition class="relative w-full max-w-[1232px] p-6 sm:p-8 bg-white/50 shadow-[0px_0px_4px_rgba(0,0,0,0.25)] backdrop-blur-[3.3px] rounded-[12px] flex flex-col gap-6">
        
        <!-- Status Badge (Under Review) -->
        <!-- Hint: Click this badge to simulate Admin Approval -->
        <div x-show="status === 'review'" x-cloak @click="status = 'approved'" class="absolute top-6 right-6 sm:top-8 sm:right-8 bg-[#FEEFD6] border border-[#FDA40B] rounded-[12px] px-[14px] py-[1px] flex items-center justify-center cursor-pointer hover:opacity-80" title="Klik untuk simulasi di-Approve Admin">
          <span class="font-open-sans font-normal text-[15px] leading-[20px] text-[#FDA40B]">Under Review</span>
        </div>

        <!-- Status Badge (Approve) -->
        <!-- Hint: Click this badge to reset to pending -->
        <div x-show="status === 'approved'" x-cloak @click="status = 'pending'" class="absolute top-6 right-6 sm:top-8 sm:right-8 bg-[#E5F6D4] border border-[#12BD26] rounded-[12px] px-[14px] py-[1px] flex items-center justify-center cursor-pointer hover:opacity-80" title="Klik untuk reset simulasi">
          <span class="font-open-sans font-normal text-[15px] leading-[20px] text-[#12BD26]">Approve</span>
        </div>

        <!-- Header Card -->
        <div class="flex flex-col gap-4">
          <h3 class="font-montserrat font-semibold text-[20px] leading-[24px] text-[#003060]">
            Session 1 - Introduce UI/UX
          </h3>
          
          <!-- Date & Time Info -->
          <div class="flex flex-col gap-[10px]">
            <div class="flex items-center gap-[8px] text-[#003060]">
              <i class="far fa-calendar text-[20px]"></i>
              <span class="font-open-sans font-semibold text-[18px] sm:text-[20px] leading-[27px]">
                Due date: Apr, 10 2026
              </span>
            </div>
            <div class="flex items-center gap-[8px] text-[#003060]">
              <i class="far fa-clock text-[20px]"></i>
              <span class="font-open-sans font-semibold text-[18px] sm:text-[20px] leading-[27px]">
                Deadline time: 23:59 WIB
              </span>
            </div>
          </div>
        </div>

        <!-- Assignment Link -->
        <div class="flex flex-col gap-2 mt-2">
          <h4 class="font-montserrat font-semibold text-[20px] leading-[24px] text-[#003060]">
            Your Assignment here:
          </h4>
          <a href="#" @click.prevent="view = 'detail'" class="font-montserrat font-medium text-[20px] leading-[24px] text-[#003060] underline hover:text-blue-700">
            Introduce UI/UX.pdf
          </a>
        </div>

        <!-- Default State: Form Submission -->
        <form x-show="status === 'pending'" @submit.prevent="status = 'review'" class="flex flex-col gap-4 mt-4">
          <h4 class="font-montserrat font-semibold text-[20px] leading-[24px] text-[#003060]">
            Your Answer:
          </h4>
          <p class="font-montserrat font-medium text-[16px] sm:text-[20px] leading-[24px] text-[#003060]">
            Enter a GitHub link, Google Drive, or any online file sharing link.
          </p>
          
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-[15px] mt-2">
            <div class="w-full max-w-[504px] h-[60px] bg-white shadow-[0px_0px_5px_rgba(0,0,0,0.5)] rounded-[12px] flex items-center px-[20px] focus-within:ring-2 focus-within:ring-[#003060]">
              <input 
                type="url" 
                x-model="answerUrl"
                placeholder="https://drive.google.com/..." 
                required
                title="Harap masukkan URL yang valid, contoh: https://drive.google.com"
                class="w-full bg-transparent border-none outline-none font-montserrat font-medium text-[18px] leading-[22px] text-slate-700 placeholder:text-black/50"
              >
            </div>
          </div>
          
          <button type="submit" class="w-[214px] h-[45px] mt-6 bg-[#003060] border border-[#003060] shadow-[0px_0px_4px_rgba(0,0,0,0.5)] rounded-[6px] flex items-center justify-center font-montserrat font-medium text-[20px] leading-[24px] text-white hover:bg-[#002244] transition cursor-pointer">
            Submit Answer
          </button>
        </form>

        <!-- Submitted State: Under Review / Approved -->
        <div x-show="status === 'review' || status === 'approved'" x-cloak class="flex flex-col gap-4 mt-4">
          <h4 class="font-montserrat font-semibold text-[20px] leading-[24px] text-[#003060]">
            Your Answer:
          </h4>
          
          <!-- Submission Date & Time Info -->
          <div class="flex flex-col gap-[10px]">
            <div class="flex items-center gap-[8px] text-[#003060]">
              <i class="far fa-calendar text-[20px]"></i>
              <span class="font-open-sans font-semibold text-[18px] sm:text-[20px] leading-[27px]">
                Submission Date: <span class="text-[#12BD26]">Apr, 10 2026</span>
              </span>
            </div>
            <div class="flex items-center gap-[8px] text-[#003060]">
              <i class="far fa-clock text-[20px]"></i>
              <span class="font-open-sans font-semibold text-[18px] sm:text-[20px] leading-[27px]">
                Submission Time: <span class="text-[#12BD26]">14:00 WIB</span>
              </span>
            </div>
          </div>
          
          <!-- Submitted URL -->
          <div class="flex items-center mt-2 px-[18px] bg-white h-[27px] w-fit">
            <span class="font-montserrat font-medium text-[18px] leading-[22px] text-black" x-text="answerUrl"></span>
          </div>
          
          <!-- Action / Result Area -->
          <div class="mt-4">
            <!-- Button shown only when Under Review -->
            <button x-show="status === 'review'" type="button" @click="status = 'pending'" class="w-[214px] h-[45px] mt-2 bg-transparent border border-[#003060] shadow-[0px_0px_4px_rgba(0,0,0,0.5)] rounded-[6px] flex items-center justify-center font-montserrat font-medium text-[20px] leading-[24px] text-[#003060] hover:bg-[#003060]/5 transition cursor-pointer">
              Edit Submission
            </button>

            <!-- Score shown only when Approved -->
            <div x-show="status === 'approved'" class="mt-4">
              <p class="font-montserrat font-medium text-[20px] leading-[30px] text-[#003060]">
                Poin: 90/100 Good Job
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- ==================== VIEW: DETAIL (PDF PREVIEW) ==================== -->
  <div x-show="view === 'detail'" x-cloak x-transition class="w-full flex flex-col items-start p-16 gap-[15px]">
    
    <!-- Detail Header -->
    <div class="flex items-center gap-6">
      <button @click="view = 'list'" class="w-[50px] h-[50px] flex justify-center items-center rounded-full border border-[#003060] shadow-[0px_0px_4px_rgba(0,0,0,0.25)] hover:bg-slate-100 transition cursor-pointer">
        <i class="fas fa-arrow-left text-[#0B1F3B] text-[24px]"></i>
      </button>
      <div class="flex flex-col gap-2">
        <h1 class="font-montserrat font-semibold text-[36px] leading-[44px] text-[#003060]">
          Your Assignment Here
        </h1>
        <p class="font-open-sans font-normal text-[20px] leading-[27px] text-[#003060]">
          Check your assignment and submit it before the deadline
        </p>
      </div>
    </div>

    <!-- Content Layout -->
    <div class="flex flex-wrap lg:flex-nowrap gap-8 mt-12 w-full">
      
      <!-- Left: PDF Preview Box -->
      <div class="w-full max-w-[732px] h-[540px] bg-white rounded-[12px] shadow-[0px_0px_4px_rgba(0,0,0,0.25)] flex items-center justify-center overflow-hidden relative">
        <span class="text-slate-400 font-medium text-lg">PDF Viewer Placeholder</span>
      </div>

      <!-- Right: Sidebar Info -->
      <div class="w-full max-w-[438px] flex flex-col bg-white shadow-[0px_0px_4px_rgba(0,0,0,0.25)] rounded-[12px] pb-[444px]">
        
        <!-- Sidebar Header -->
        <div class="w-full h-[66px] bg-[#6EB6E5] rounded-t-[12px] shadow-[0px_0px_4px_rgba(0,0,0,0.25)] flex items-center px-[30px] gap-4">
          <i class="fas fa-pen-nib text-[#2D2D2D] text-[24px]"></i>
          <h2 class="font-montserrat font-semibold text-[20px] leading-[24px] text-[#2D2D2D]">
            Assignment
          </h2>
        </div>

        <!-- File Row -->
        <div class="w-full h-[50px] border-y border-[#D9D9D9] flex items-center justify-between px-3 cursor-pointer hover:bg-slate-50 transition">
          <span class="font-montserrat font-medium text-[15px] leading-[18px] text-black">
            Assignment.pdf
          </span>
          <i class="fas fa-download text-black text-[20px]"></i>
        </div>

      </div>

    </div>

  </div>

</div>
