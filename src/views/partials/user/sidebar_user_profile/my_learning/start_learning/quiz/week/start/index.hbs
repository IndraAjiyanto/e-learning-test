<form method="POST" action="/answer-users/{{quizId}}" x-data="quiz()" x-init="init()" id="formSubmit">

{{#if check}}
<script>
window.addEventListener("load", function(){
    showTimeOverAlert(
        "#formSubmit",
        "Quiz time is over, submitting your answers.",
        "Time's Up!"
    );
});
</script>
{{/if}}

<div class="px-4 py-4 sm:px-8 sm:py-6">

    <!-- Header -->
    <div class="space-y-2 mb-8">
        <h1 class="font-montserrat font-semibold text-2xl sm:text-3xl text-[#003060]">
            Quiz {{quiz.weeks.description}}
        </h1>

        <p class="font-sans text-xl text-[#003060]">
            Complete the quiz to assess your understanding of the learning material.
        </p>
    </div>


    <!-- MAIN LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,810px)_320px] gap-6 items-start">

        <!-- ================================= -->
        <!-- LEFT : QUESTION & ANSWERS -->
        <!-- ================================= -->
        <div>

            <!-- Question Card -->
            <div class="bg-white border border-[#E5E5E5] shadow-sm overflow-hidden">

                <!-- Question Navigation Header -->
                <div class="flex items-center justify-between px-6 py-4 border-b border-[#E5E5E5] bg-slate-50">

                    <span class="text-sm font-medium text-[#525252]">
                        {{t "test.quiz.start.question"}}
                        <span x-text="currentQuestion + 1"></span>
                        {{t "test.quiz.start.of"}}
                        {{questions.length}}
                    </span>

                </div>


                <!-- Question Content -->
                <div class="p-6">

                    {{#if questions.length}}

                    {{#each questions}}

                    <div x-show="currentQuestion === {{@index}}">

                        <!-- Hidden Input -->
                        <input type="hidden" name="q-{{id}}" value="">

                        <!-- Question -->
                        <div class="flex items-start gap-4 mb-6">

                            <div class="flex-shrink-0 w-8 h-8 bg-secondary text-white rounded-full flex items-center justify-center text-sm font-semibold">
                                {{addOne @index}}
                            </div>

                            <div class="flex-1 space-y-4">

                                <!-- Image -->
                                {{#if image}}
                                <div class="w-full">
                                    <div class="flex justify-center">

                                        <img
                                            src="{{image}}"
                                            alt="Question Image"
                                            class="max-h-64 rounded-xl border border-[#E5E5E5] shadow-sm object-contain"
                                        >

                                    </div>
                                </div>
                                {{/if}}

                                <!-- Question Text -->
                                <p class="font-semibold text-[#171717] text-lg leading-relaxed">
                                    {{questionText}}
                                </p>

                            </div>

                        </div>


                        <!-- Answer Options -->
                        <div class="px-8 space-y-3">

                            {{#each answers}}

                            <label
                                class="flex items-center p-4 border border-[#E5E5E5] rounded-xl cursor-pointer hover:bg-[#FAFAFA] hover:border-[#D4D4D4] transition-all duration-200 group/option"
                            >

                                <input
                                    type="radio"
                                    name="q-{{../id}}"
                                    value="{{id}}"
                                    class="w-5 h-5 radio border-[#D4D4D4] checked:text-[#404040] checked:bg-white"
                                >

                                <span class="ml-4 text-slate-800 font-medium group-hover/option:text-[#171717] transition-colors">
                                    {{answer}}
                                </span>

                            </label>

                            {{/each}}

                        </div>

                    </div>

                    {{/each}}

                    {{else}}

                    {{!-- Cabang ini dulu merender DUA soal palsu lengkap dengan
                         pilihan "Answer A/B/C/D" ketika sebuah quiz belum punya
                         soal. Isinya bercampur dengan formulir yang sungguhan,
                         sehingga student bisa mengirim jawaban atas soal yang
                         tidak ada. Diganti keadaan kosong yang jujur. --}}
                    <div class="flex flex-col items-center gap-3 px-8 py-12 text-center">
                        <span class="grid size-14 place-items-center rounded-full bg-[#f4f7fc] text-[#003060]">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
                        </span>
                        <h3 class="font-montserrat text-xl font-bold text-[#003060]">This quiz has no questions yet</h3>
                        <p class="font-inter text-sm text-[#737373]">
                            Your mentor has not added any questions. Please check back later.
                        </p>
                    </div>

                    {{/if}}

                </div>

            </div>


            <!-- ================================= -->
            <!-- QUESTION BUTTONS -->
            <!-- ================================= -->
            <div class="flex items-center justify-end mt-4">

    {{#if questions.length}}

    <div class="flex items-center gap-2">

        <!-- PREVIOUS -->
        <button
            type="button"
            x-show="currentQuestion > 0"
            @click="prevQuestion()"
            class="bg-secondary text-white rounded-lg hover:bg-slate-700 transition-colors flex items-center gap-2"
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            {{t "test.quiz.start.previous"}}
        </button>

        <!-- NEXT -->
        <button
            type="button"
            x-show="currentQuestion < {{questions.length}} - 1"
            @click="nextQuestion()"
            class="bg-secondary text-white rounded-lg hover:bg-slate-700 transition-colors flex items-center gap-2"
        >
            {{t "test.quiz.start.next"}}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </button>

        <!-- SUBMIT -->
        <button
            type="button"
            x-show="currentQuestion === {{questions.length}} - 1"
            @click="submitQuiz()"
            :disabled="answeredCount !== {{questions.length}}"
            :class="answeredCount !== {{questions.length}} ? 'opacity-40 cursor-not-allowed' : ' '"
            class="bg-[#003060] text-white rounded-xl shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-all duration-300 flex items-center gap-2 font-semibold"
        >
            Submit Answer
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6"></path>
            </svg>
        </button>

    </div>

    {{else}}

    <div class="flex items-center gap-2">

        <button
            type="button"
            x-show="currentQuestion > 0"
            @click="currentQuestion--"
            class="bg-secondary text-white rounded-lg hover:bg-slate-700 transition-colors flex items-center gap-2"
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Previous
        </button>

        <button
            type="button"
            x-show="currentQuestion < 1"
            @click="currentQuestion++"
            class="bg-secondary text-white rounded-lg hover:bg-slate-700 transition-colors flex items-center gap-2"
        >
            Next
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
        </button>

        <button
            type="button"
            x-show="currentQuestion === 1"
            class="bg-[#003060] text-white rounded-xl shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-all duration-300 flex items-center gap-2 font-semibold"
        >
            Submit Answer
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6"></path>
            </svg>
        </button>

    </div>

    {{/if}}

</div>


        </div>


        <!-- ================================= -->
        <!-- RIGHT : QUESTION LIST -->
        <!-- ================================= -->
        <div>

    <!-- ============================= -->
    <!-- QUESTION LIST CARD -->
    <!-- ============================= -->
    <div class="bg-white border border-[#E5E5E5] shadow-sm p-6 sticky top-6">

        <!-- Question List Header -->
        <div class="flex items-center justify-between mb-4">

            <h3 class="text-lg font-semibold text-[#171717] font-montserrat">
                {{t "test.quiz.start.questionList"}}
            </h3>

            <!-- TIMER -->
            {{#if check}}

                <span class="text-red-500 font-semibold">
                    {{t "test.quiz.start.timeIsOver"}}
                </span>

            {{else}}

                <div id="countdownExample">
                    <div class="values font-semibold text-[#404040]"></div>
                </div>

                {{#if remainingTime}}
<script>
                document.addEventListener("DOMContentLoaded", function () {

                    const form = document.querySelector('#formSubmit');
                    const timer = new easytimer.Timer();

                    timer.start({
                        countdown: true,
                        startValues: {
                            seconds: {{default remainingTime 0}}
                        }
                    });

                    function updateTimer() {
                        document.querySelector('#countdownExample .values').innerHTML =
                            timer.getTimeValues().toString();
                    }

                    updateTimer();

                    timer.addEventListener('secondsUpdated', updateTimer);

                    timer.addEventListener('targetAchieved', function () {
                        clearQuizStorage();
                        form.submit();
                    });

                });
                </script>
{{/if}}

            {{/if}}

        </div>


        <!-- Question List -->
        <div class="grid grid-cols-4 gap-3 max-h-[500px] overflow-y-auto">

            {{#if questions.length}}

            {{#each questions}}

            <button
                type="button"
                @click="currentQuestion = {{@index}}"
                class="w-[54px] h-[54px] rounded-xl border flex items-center justify-center transition-all duration-200"
                :class="{
                    'bg-secondary text-white border-secondary shadow-md':
                        currentQuestion === {{@index}},

                    'bg-white text-[#404040] border-[#E5E5E5] hover:border-[#D4D4D4] hover:bg-[#FAFAFA]':
                        currentQuestion !== {{@index}} && !isAnswered({{@index}}),

                    'bg-[#E5F6D4] text-[#003060] border-[#E5E5E5]':
                        currentQuestion !== {{@index}} && isAnswered({{@index}})
                }"
            >

                <span class="text-base font-semibold">
                    {{addOne @index}}
                </span>

            </button>

            {{/each}}

            {{else}}

            <button type="button" class="w-[54px] h-[54px] rounded-xl border flex items-center justify-center bg-secondary text-white">1</button>
            <button type="button" class="w-[54px] h-[54px] rounded-xl border flex items-center justify-center bg-white text-[#404040] border-[#E5E5E5]">2</button>

            {{/if}}

        </div>

    </div>
    <!-- END QUESTION LIST CARD -->


    <!-- ============================= -->
    <!-- PROGRESS CARD -->
    <!-- ============================= -->
    <div class="bg-white border border-[#E5E5E5] shadow-sm p-6 mt-4">

        {{#if questions.length}}

        <div class="flex items-center justify-between mb-3">
            <span class="text-sm font-semibold text-[#404040]">{{t "test.quiz.start.progress"}}</span>
            <span class="text-sm font-semibold text-[#525252]" x-text="`${answeredCount}/{{questions.length}}`"></span>
        </div>
        <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
            <div class="bg-green-600 h-2.5 rounded-full transition-all duration-500" :style="`width: ${(answeredCount / {{questions.length}}) * 100}%`"></div>
        </div>

        {{else}}

        <div class="flex items-center justify-between mb-3">
            <span class="text-sm font-semibold text-[#404040]">Progress</span>
            <span class="text-sm font-semibold text-[#525252]">0/2</span>
        </div>
        <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
            <div class="bg-green-600 h-2.5 rounded-full" style="width: 0%"></div>
        </div>

        {{/if}}

    </div>
    <!-- END PROGRESS CARD -->

</div>


        </div>

    </div>

</form>


<script>
let saveTimeout;

document.addEventListener("change", function(e){

    if(e.target.type === "radio"){

        const radio = e.target;
        const name = radio.name;
        const value = Number(radio.value);

        const questionId = Number(name.replace("q-", ""));

        // simpan ke localStorage dulu
        localStorage.setItem(name, value);

        // hentikan timer sebelumnya
        clearTimeout(saveTimeout);

        // tunggu user berhenti klik
        saveTimeout = setTimeout(async () => {

            try {

                const response = await fetch("/answer-users/chose-answer", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        userId: '{{user.id}}',
                        questionsId: questionId,
                        answersId: value
                    })
                });

                if(!response.ok){
                    throw new Error("Server error");
                }

            } catch(err){

                console.error("Autosave gagal", err);

                // kosongkan pertanyaan
       document.querySelectorAll(`input[name="${name}"]`)
.forEach(r => {
    r.checked = false;
    r.dispatchEvent(new Event('change', { bubbles: true }));
});

                localStorage.removeItem(name);

            }

        }, 700);

    }

});

document.addEventListener("DOMContentLoaded", function(){

    const form = document.querySelector('#formSubmit');
    const radios = document.querySelectorAll("input[type='radio']");

    radios.forEach(radio => {

        const savedValue = localStorage.getItem(radio.name);

        if(savedValue && savedValue === radio.value){
            radio.checked = true;
            radio.dispatchEvent(new Event('change', { bubbles: true }));
        }

    });

    function clearQuizStorage(){
        Object.keys(localStorage)
        .filter(key => key.startsWith("q-"))
        .forEach(key => localStorage.removeItem(key));
    }

    // saat submit biasa
    form.addEventListener("submit", clearQuizStorage);

    // kalau submit via timer
    window.clearQuizStorage = clearQuizStorage;

});
</script>

{{#if questions.length}}
<script>
function quiz() {
    return {
        currentQuestion: 0,

        answeredQuestions: [],


        init() {

            this.$el.addEventListener('change', (e) => {

                if (e.target.type === 'radio') {
                    this.updateAnsweredStatus();
                }

            });

            this.updateAnsweredStatus();

        },


        updateAnsweredStatus() {

            const questionIds = [
                {{#each questions}}
                    {{#unless @first}},{{/unless}}{{id}}
                {{/each}}
            ];

            this.answeredQuestions = questionIds.map((qId, index) => {

                const input = this.$el.querySelector(
                    `input[name="q-${qId}"]:checked`
                );

                return input !== null;

            });

        },


        get answeredCount() {

            return this.answeredQuestions.filter(
                answered => answered
            ).length;

        },


        nextQuestion() {

            if (this.currentQuestion < {{questions.length}} - 1) {
                this.currentQuestion++;
            }

        },


        prevQuestion() {

            if (this.currentQuestion > 0) {
                this.currentQuestion--;
            }

        },


        isAnswered(index) {

            return this.answeredQuestions[index] || false;

        },


        submitQuiz() {

            if (this.answeredCount !== {{questions.length}}) {
                return;
            }

            confirmAction(
                document.querySelector('#formSubmit button[type="button"]'),
                'Are you sure you want to submit your answers?'
            );

        }

    }
}
</script>
{{else}}
<script>
function quiz() {
    return {
        currentQuestion: 0,
        init() {},
        nextQuestion() { if (this.currentQuestion < 1) this.currentQuestion++; },
        prevQuestion() { if (this.currentQuestion > 0) this.currentQuestion--; }
    }
}
</script>
{{/if}}
