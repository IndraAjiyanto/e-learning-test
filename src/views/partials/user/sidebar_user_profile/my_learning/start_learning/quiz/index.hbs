 <!-- Quiz Tab Content -->
        <div x-show="activeSection === 'quiz'" class="px-4 sm:px-8 md:px-14 py-10 space-y-4">
          <h1 class="font-montserrat font-semibold text-2xl sm:text-3xl text-[#003060]">Quiz</h1>
          <p class="font-sans text-[20px] text-[#003060]">Complete the quiz to assess your understanding of the learning material.</p>

          <!-- Quiz List Section -->
          <div class="space-y-3">
            {{#each quizzes}}
            <div class="bg-white border border-[#D9D9D9] rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center justify-between px-5 py-3.5 gap-4">
                <span class="font-montserrat font-semibold text-[25px] text-[#003060] truncate">
                  {{this.weekName}} : {{this.title}}
                </span>
                <a href="/quiz/form/{{this.id}}"
                   class="inline-flex items-center justify-center px-4 py-2 bg-[#003060] text-white rounded-lg font-montserrat font-medium text-[20px] hover:bg-[#001F3F] transition-colors whitespace-nowrap flex-shrink-0">Take Quiz               
                </a>
              </div>
            </div>
            {{/each}}
          </div>
        </div>