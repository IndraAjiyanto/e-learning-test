{{!-- MY LEARNING - PDF MATERIAL PREVIEW VIEW --}}
<div
  class="w-full space-y-8 sm:space-y-10 md:space-y-12"
  x-data="{
    isPlaying: false,
    currentPdf: null,
    selectPdf(item) {
      this.currentPdf = item;
      this.isPlaying = true;
    }
  }"
>
  <!-- Header Row with Back Button -->
  <div class="space-y-12">

    <!-- Back Button -->
    <button
      type="button"
      @click="activeMateri = null"
      class="w-[50px] h-[50px] rounded-full border border-[#003060] bg-white shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)] flex items-center justify-center text-[#003060] hover:bg-[#003060] hover:text-white transition-all duration-200 cursor-pointer group"
      aria-label="Back to Start Learning"
    >
      <i class="fa-solid fa-arrow-left text-lg group-hover:-translate-x-0.5 transition-transform duration-200"></i>
    </button>

    <!-- Page Titles -->
    <div class="space-y-5">
      <h1 class="font-montserrat font-semibold text-2xl sm:text-3xl md:text-[36px] text-[#003060] leading-tight">
        Select a PDF from the list to start reading
      </h1>
      <p class="font-sans font-normal text-base sm:text-lg md:text-[20px] text-[#003060] leading-normal">
        Complete each week to unlock the next
      </p>
    </div>

  </div>

  <!-- PDF Viewer & Course Materials Right Panel Layout -->
  <div class="flex flex-col xl:flex-row items-start gap-6 xl:gap-[30px] w-full">

    <!-- PDF VIEWER -->
    <div class="w-full xl:max-w-[726px] flex-1">
      <div class="w-full h-[240px] sm:h-[320px] md:h-[402px] bg-black rounded-[11px] shadow-[0px_0px_7.44px_0px_rgba(0,0,0,0.25)] relative flex items-center justify-center overflow-hidden group">

        <!-- PDF Playing State -->
        <template x-if="isPlaying && currentPdf && currentPdf.file">
          <iframe
            :src="currentPdf.file"
            class="w-full h-full rounded-[11px] bg-white"
            frameborder="0"
          ></iframe>
        </template>

        <!-- PDF Placeholder Preview State -->
        <div
          x-show="!isPlaying"
          class="w-full h-full flex flex-col items-center justify-center relative"
        >
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
          <i class="fa-solid fa-file-pdf relative z-10 text-5xl text-white/80"></i>
          <p class="relative z-10 mt-4 font-montserrat text-white/80 text-sm sm:text-base px-6 text-center">
            Select a PDF from the list to start reading
          </p>
        </div>

      </div>
    </div>

    <!-- RIGHT PANEL (Course Materials Playlist) -->
    <div class="w-full xl:w-[438px] h-[510px] min-h-[510px] bg-white rounded-[12px] shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)] overflow-hidden flex flex-col border border-slate-100 flex-shrink-0">

      <!-- Header bar -->
      <div class="h-[66px] bg-[#6EB6E5] rounded-t-[12px] px-6 flex items-center justify-start gap-3 flex-shrink-0">
        <i class="fa-solid fa-file-pdf text-2xl"></i>
        <h2 class="font-montserrat font-semibold text-black text-xl leading-none">
          PDF Materials
        </h2>
      </div>

      <!-- List rows (Scrollable inside 510px card) -->
      <div class="flex-1 overflow-y-auto max-h-[444px] my-1">

        <!-- Empty State -->
        <template x-if="!(selectedMaterial && selectedMaterial.materials && selectedMaterial.materials.filter(m => m.fileType === 'pdf').length)">
          <div class="h-full flex items-center justify-center px-6">
            <p class="font-montserrat font-medium text-sm sm:text-base text-slate-400 text-center">
              No PDF material available for this session
            </p>
          </div>
        </template>

        <template x-for="item in (selectedMaterial && selectedMaterial.materials ? selectedMaterial.materials.filter(m => m.fileType === 'pdf') : [])" :key="item.id">
          <div
            @click="selectPdf(item)"
            :class="currentPdf && currentPdf.id === item.id ? 'bg-white' : 'bg-white hover:bg-slate-50'"
            class="h-[60px] flex items-center px-6 border-y border-[#D9D9D9] transition-colors cursor-pointer"
          >
            <span
              :class="currentPdf && currentPdf.id === item.id ? 'font-semibold text-black' : 'font-medium text-black'"
              class="font-montserrat text-base sm:text-[18px] truncate leading-none"
              x-text="item.title"
            ></span>
          </div>
        </template>

      </div>

    </div>

  </div>
</div>
