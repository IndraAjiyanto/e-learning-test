{{!--
  Panel: Join Group (tab "Gabung Grup")
  Lokasi: src/views/partials/user/sidebar_user_profile/my_learning/start_learning/join_group/index.hbs
  Level: L3 Tab

  Tautan grup diambil dari kolom Course.group, yang diisi super admin lewat
  form program. Isinya BEBAS - WhatsApp, Telegram, Discord, LINE, forum, atau
  tautan apa pun. Karena itu panel ini sengaja tidak memakai lambang platform
  tertentu (dulu ada gif WhatsApp): satu tombol yang sama membuka tautan apa
  pun yang dibagikan.

  Tautan dibaca dari activeCourseData (window.userCourses) lewat Alpine,
  bukan hanya {{course.group}} yang dirender server. Alasannya: saat student
  berpindah program lewat selectCourse() halaman tidak dimuat ulang, sehingga
  tautan yang dirender server akan menunjuk grup program sebelumnya.
--}}

<div class="w-full mx-auto min-h-[500px] flex items-center justify-center font-inter p-5"
  x-data="{
    get groupLink() {
      const c = (typeof activeCourseData !== 'undefined') ? activeCourseData : null;
      return (c && c.group) ? c.group : '';
    }
  }"
>
  <div class="w-full mx-auto rounded-[16px] border border-[#E6ECF7] bg-white shadow-[0px_8px_28px_rgba(43,74,122,0.07)] overflow-hidden">

    {{!-- Header: ikon, judul, deskripsi, ringkasan manfaat --}}
    <div class="flex flex-col items-center text-center gap-4 px-6 sm:px-10 pt-9 pb-7">
      <div class="w-16 h-16 rounded-full bg-[#E9F0FF] flex items-center justify-center shrink-0">
        <svg class="w-7 h-7 text-[#6682B5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
        </svg>
      </div>

      <h2 class="font-inter font-semibold text-xl sm:text-2xl leading-tight text-[#003060]">
        {{default (t 'test.joinGroup.title') 'Join Group Class'}}
      </h2>

      <p class="font-sans font-normal text-sm leading-relaxed text-[#64748B] max-w-[560px]">
        {{default (t 'test.joinGroup.description') 'Join your class group to receive important announcements, learning materials, schedules, and communicate with mentors and fellow participants.'}}
      </p>

      {{!-- Manfaatnya ditandai pil, sama seperti tag di kepala program --}}
      <div class="flex flex-wrap items-center justify-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-[#D0E1FD] bg-[#EEF2F6] px-3.5 py-1.5 font-inter text-xs font-semibold text-[#5B7EB1]">
          <svg class="w-3.5 h-3.5 text-[#4D6EF3] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
          {{default (t 'test.joinGroup.benefitAnnouncement') 'Class announcements'}}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-[#D0E1FD] bg-[#EEF2F6] px-3.5 py-1.5 font-inter text-xs font-semibold text-[#5B7EB1]">
          <svg class="w-3.5 h-3.5 text-[#4D6EF3] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          {{default (t 'test.joinGroup.benefitMaterial') 'Learning materials'}}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-[#D0E1FD] bg-[#EEF2F6] px-3.5 py-1.5 font-inter text-xs font-semibold text-[#5B7EB1]">
          <svg class="w-3.5 h-3.5 text-[#4D6EF3] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          {{default (t 'test.joinGroup.benefitSchedule') 'Schedules'}}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-[#D0E1FD] bg-[#EEF2F6] px-3.5 py-1.5 font-inter text-xs font-semibold text-[#5B7EB1]">
          <svg class="w-3.5 h-3.5 text-[#4D6EF3] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            <path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"></path>
          </svg>
          {{default (t 'test.joinGroup.benefitDiscussion') 'Mentor discussion'}}
        </span>
      </div>
    </div>

    {{!-- Area aksi: satu tombol untuk tautan grup apa pun --}}
    <div class="border-t border-[#E6ECF7] bg-[#FAFCFF] px-6 sm:px-10 py-7 flex flex-col items-center gap-3">

      {{!-- Tautan tersedia: satu tombol yang membuka Course.group apa pun isinya --}}
      <div
        x-show="groupLink"
        {{#unless course.group}}style="display:none"{{/unless}}
        class="w-full flex flex-col items-center gap-3"
      >
        <a
          :href="groupLink"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex h-12 items-center justify-center gap-2.5 rounded-[10px] bg-[#1C2D4A] px-8 font-inter text-sm font-bold text-white no-underline shadow-sm transition-colors hover:bg-[#15233a] cursor-pointer"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
          </svg>
          <span>{{default (t 'test.joinGroup.joinNow') 'Join Now'}}</span>
        </a>

        <p class="max-w-[440px] text-center font-inter text-xs leading-[17px] text-[#8091B1]">
          {{default (t 'test.joinGroup.platformHint') 'Works with any group platform — WhatsApp, Telegram, Discord, or any other link shared by your mentor.'}}
        </p>
      </div>

      {{!-- Tautan belum diisi super admin: keadaan kosong, bukan tombol mati --}}
      <div
        x-show="!groupLink"
        {{#if course.group}}style="display:none"{{/if}}
        class="w-full rounded-[12px] border border-[#E6ECF7] bg-[#F8FAFC] px-5 py-4 flex items-start gap-3"
      >
        <span class="w-9 h-9 rounded-lg bg-[#EEF1F8] flex items-center justify-center shrink-0">
          <svg class="w-[18px] h-[18px] text-[#6682B5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </span>
        <div class="flex flex-col gap-1 min-w-0">
          <span class="font-inter font-semibold text-sm leading-[18px] text-[#17345E]">
            {{default (t 'test.joinGroup.emptyTitle') 'Group link not available yet'}}
          </span>
          <span class="font-inter font-normal text-sm leading-[20px] text-[#64748B]">
            {{default (t 'test.joinGroup.linkNotShared') 'The group link has not been shared by your mentor yet.'}}
          </span>
        </div>
      </div>

    </div>

  </div>

</div>
