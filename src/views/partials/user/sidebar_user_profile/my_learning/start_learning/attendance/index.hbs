<!-- ATTENDANCE FORM CONTENT PARTIAL -->
<div class="px-4 sm:px-8 md:px-14 py-10 space-y-4 font-montserrat"
  x-data="{
    courseId: '{{course.id}}',
    currentUserId: '{{user.id}}',
    showEditModal: false,
    showSuccessPopup: false,
    statusDropdownOpen: false,
    editAttendanceId: null,
    editSessionId: null,
    editStatus: '',
    editNotes: '',
    statusLabels: {
      'present': 'Present',
      'sick': 'Sick',
      'permission': 'Permission',
      'absent': 'Absent',
      'no_information': 'No Information'
    },
    openWeek: null,
    sessions: [],
    sessionsLoading: false,
    sessionsError: false,
    loadedWeekId: null,
    sessionsCache: {},
    async loadSessions(weekId) {
      this.loadedWeekId = weekId;
      this.sessionsError = false;

      if (this.sessionsCache[weekId]) {
        this.sessions = this.sessionsCache[weekId];
        this.sessionsLoading = false;
        return;
      }

      this.sessions = [];
      this.sessionsLoading = true;
      try {
        const res = await fetch('/program/session/' + weekId);
        if (!res.ok) throw new Error('Request failed');
        const data = await res.json();
        if (this.loadedWeekId !== weekId) return;
        const list = Array.isArray(data) ? data : [];
        this.sessionsCache[weekId] = list;
        this.sessions = list;
      } catch (e) {
        if (this.loadedWeekId !== weekId) return;
        this.sessionsError = true;
      } finally {
        if (this.loadedWeekId === weekId) this.sessionsLoading = false;
      }
    },
    // Unlock/attendance/logbook status is derived from the single shared
    // helper (Alpine.store('sessionUnlock')) — see PRD-sequential-session-unlock.md.
    // No unlock condition is written here; these are thin delegations.
    isSessionAttended(session) {
      return Alpine.store('sessionUnlock').isAttended(session);
    },
    canOpenNextSession(session) {
      return Alpine.store('sessionUnlock').canOpenNextSession(session);
    },
    isSessionUnlocked(index) {
      return Alpine.store('sessionUnlock').isSessionUnlocked(this.sessions, this.sessions[index]);
    },
    attendanceStatus(index) {
      return Alpine.store('sessionUnlock').getAttendanceStatus(this.sessions, this.sessions[index]);
    },
    sessionLabel(session) {
      return 'Session ' + session.sessionOrder + ' : ' + session.topic;
    },
    attendanceOf(session) {
      return (session.attendances && session.attendances.length)
        ? session.attendances[0]
        : null;
    },
    openEditModalForSession(session) {
      const attendance = this.attendanceOf(session);
      this.openEditModal(
        attendance ? attendance.id : null,
        session.id,
        attendance ? attendance.status : '',
        attendance ? attendance.notes : ''
      );
    },
    openEditModal(attendanceId, sessionId, currentStatus, currentNotes) {
      this.editAttendanceId = attendanceId;
      this.editSessionId = sessionId;
      this.editStatus = currentStatus || '';
      this.editNotes = currentNotes || '';
      this.statusDropdownOpen = false;
      this.showEditModal = true;
    },
    async saveAttendance() {
      if (!this.editStatus) return;
      if (this.editAttendanceId) {
        // No user-role update endpoint exists yet (only an admin-only
        // PATCH /attendance/:attendanceId/:sessionId) — editing an
        // already-submitted attendance record is not wired up.
        alert('Editing an existing attendance record is not available yet.');
        return;
      }
      try {
        // Reuses the existing POST /attendance/:sessionId/:userId/:courseId
        // (the same route the legacy full-page form at
        // src/views/user/attendance/create.hbs already submits to) — the
        // Accept header switches its response from a redirect to JSON.
        const response = await fetch(`/attendance/${this.editSessionId}/${this.currentUserId}/${this.courseId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            status: this.editStatus,
            notes: this.editNotes
          })
        });
        const data = await response.json();
        if (data.success) {
          this.showEditModal = false;
          this.showSuccessPopup = true;
          if (this.loadedWeekId !== null) {
            delete this.sessionsCache[this.loadedWeekId];
            this.loadSessions(this.loadedWeekId);
          }
        } else {
          alert(data.message || 'Failed to update attendance');
        }
      } catch (error) {
        alert('An error occurred while updating attendance');
      }
    }
  }"
>

  <!-- HEADER SECTION -->
  <div class="space-y-[15px]">
    <h1 class="font-montserrat font-semibold text-2xl sm:text-3xl md:text-[36px] text-[#003060] leading-none">
      Attendance Form
    </h1>
    <p class="font-open-sans font-normal text-base sm:text-lg md:text-[20px] text-[#003060] leading-none">
      Record your attendance to access each session's learning materials.
    </p>
  </div>

  {{#if course.weeks.length}}
    {{! The first week is always unlocked; any later week unlocks only when a WeekProgress row exists for it and the current user }}
    {{#each course.weeks}}
    <div class="{{#if @first}}mt-[40px]{{else}}mt-[48px]{{/if}}">

      {{#if (or (weekUnlocked weekProgresses) @first)}}
      <!-- Unlocked Week -->
      <button
        type="button"
        @click="if (openWeek === {{weekNumber}}) { openWeek = null } else { openWeek = {{weekNumber}}; loadSessions('{{id}}') }"
        class="w-full flex items-center justify-between cursor-pointer"
      >
        <h2 class="font-montserrat font-semibold text-xl sm:text-2xl md:text-[25px] text-[#003060] text-left">
          Week {{weekNumber}} : {{description}}
        </h2>
        <div class="w-[35px] h-[35px] flex items-center justify-center flex-shrink-0">
          <i
            class="fa-solid fa-chevron-up text-[#003060] text-lg transition-transform duration-200"
            :class="openWeek === {{weekNumber}} ? '' : 'rotate-180'"
          ></i>
        </div>
      </button>

      <div x-show="openWeek === {{weekNumber}}" x-transition class="mt-[31px] space-y-0" style="display: none;">

        <!-- Sessions Loading State -->
        <template x-if="openWeek === {{weekNumber}} && sessionsLoading">
          <div class="py-[20px] text-center">
            <div class="w-8 h-8 border-2 border-[#003060] border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
            <p class="font-montserrat font-medium text-sm sm:text-base text-[#003060]">Loading sessions...</p>
          </div>
        </template>

        <!-- Sessions Error State -->
        <template x-if="openWeek === {{weekNumber}} && !sessionsLoading && sessionsError">
          <div class="py-[20px] text-center space-y-3">
            <p class="font-montserrat font-medium text-sm sm:text-base text-red-600">Failed to load sessions. Please try again.</p>
            <button type="button" @click="loadSessions('{{id}}')" class="font-montserrat font-medium text-sm sm:text-base text-[#003060] underline cursor-pointer">
              Retry
            </button>
          </div>
        </template>

        <!-- Sessions Empty State -->
        <template x-if="openWeek === {{weekNumber}} && !sessionsLoading && !sessionsError && sessions.length === 0">
          <div class="py-[20px] text-center">
            <p class="font-montserrat font-medium text-sm sm:text-base text-[#003060]">No sessions available for this week.</p>
          </div>
        </template>

        <!-- Session Rows -->
        <template x-for="(session, sIndex) in (openWeek === {{weekNumber}} && !sessionsLoading && !sessionsError ? sessions : [])" :key="session.id">
          <div class="flex flex-col">
            <div class="flex items-center justify-between py-[20px]">
              <span
                class="font-montserrat font-medium text-xl sm:text-2xl md:text-[25px] text-[#003060]"
                x-text="sessionLabel(session)"
              ></span>
              <div class="flex items-center gap-[23px]">
                <!-- Locked: first session is always unlocked; any later session unlocks only once the previous session's session_progresses row has isAttended=true and its logbook is done/approved -->
                <span
                  class="inline-flex items-center h-[22px] px-3 rounded-[12px]"
                  :class="attendanceStatus(sIndex) === 'LOCKED' ? 'bg-[#F3F4F6] border border-[#D1D5DB]' : (attendanceStatus(sIndex) === 'COMPLETED' ? 'bg-[#E5F6D4] border border-[#12BD26]' : 'bg-[#F2DBDB] border border-[#F25151]')"
                >
                  <span
                    class="font-open-sans font-normal text-[15px] leading-none"
                    :class="attendanceStatus(sIndex) === 'LOCKED' ? 'text-[#6B7280]' : (attendanceStatus(sIndex) === 'COMPLETED' ? 'text-[#12BD26]' : 'text-[#F25151]')"
                    x-text="attendanceStatus(sIndex) === 'LOCKED' ? 'Locked' : (attendanceStatus(sIndex) === 'COMPLETED' ? 'Attendance Recorded' : 'Attendance Required')"
                  ></span>
                </span>

                <template x-if="isSessionUnlocked(sIndex)">
                  <button
                    type="button"
                    @click="openEditModalForSession(session)"
                    class="inline-flex items-center gap-[5px] cursor-pointer group"
                  >
                    <i class="fa-solid fa-pen text-[#003060] text-[24px]"></i>
                    <span class="font-montserrat font-medium text-[20px] text-[#003060] underline group-hover:opacity-80 transition-opacity">
                      Edit
                    </span>
                  </button>
                </template>

                <template x-if="!isSessionUnlocked(sIndex)">
                  <span class="ml-2 text-[#F25151] text-sm">
                    <i class="fa-solid fa-lock text-[#F25151] text-[14px]"></i>
                  </span>
                </template>
              </div>
            </div>
            <div class="w-full h-px bg-[#D9D9D9]"></div>
          </div>
        </template>

      </div>
      {{else}}
      <!-- Locked Week -->
      <div class="w-full flex items-center justify-between">
        <h2 class="font-montserrat font-semibold text-xl sm:text-2xl md:text-[25px] text-[#003060]">
          Week {{weekNumber}} : {{description}}
        </h2>
        <div class="w-[35px] h-[35px] flex items-center justify-center flex-shrink-0">
          <i class="fa-solid fa-lock text-[#12BD26] text-[14px]"></i>
        </div>
      </div>
      {{/if}}

    </div>
    {{/each}}
  {{else}}
  <!-- Weeks Empty State -->
  <div class="mt-[40px] py-[20px] text-center">
    <p class="font-montserrat font-medium text-base sm:text-lg text-[#003060]">
      No weeks available for this program yet.
    </p>
  </div>
  {{/if}}

  <!-- Edit Attendance Modal -->
  {{> user/sidebar_user_profile/my_learning/start_learning/attendance/edit_modal }}

</div>
