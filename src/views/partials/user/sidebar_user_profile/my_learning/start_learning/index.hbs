            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <span class="font-inter font-normal text-[13px] leading-4 text-[#92400E]">
            The previous week's quiz must meet the minimum score to unlock this content.
          </span>
        </div>
      </div>
    {{/if}}

    {{!-- Pagination --}}
    <div class="w-full flex flex-row justify-between items-center px-6 sm:px-8 py-3 h-14 bg-white border border-[#D9D9D9] rounded-[16px] mt-2">
      <span class="font-inter font-medium text-sm leading-[17px] text-[#003060]">
        {{#if minggu.length}}
          Showing 1-{{minggu.length}} of {{minggu.length}} weeks
        {{else}}
          Showing 1-5 of 12 weeks
        {{/if}}
      </span>

      <div class="flex flex-row items-center gap-2">
        <button type="button" class="w-8 h-8 rounded-full bg-[#003060] text-white flex items-center justify-center font-inter font-semibold text-sm transition-opacity hover:opacity-90">1</button>
        <button type="button" class="w-8 h-8 rounded-full bg-white border border-[#D9D9D9] text-[#003060] flex items-center justify-center font-inter font-semibold text-sm transition-colors hover:bg-gray-50">2</button>
        <button type="button" class="w-8 h-8 rounded-full bg-white border border-[#D9D9D9] text-[#003060] flex items-center justify-center font-inter font-semibold text-sm transition-colors hover:bg-gray-50">3</button>
      </div>
    </div>

  </div>

  {{#if user_kelas.progress}}
    <div class="mt-6 w-full">
      {{> program_detail/right_content/portfolio}}
    </div>
  {{/if}}
</div>
