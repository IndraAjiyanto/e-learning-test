{{!--
  Panel: Start Learning (tab area student)
  Lokasi: src/views/partials/user/sidebar_user_profile/my_learning/start_learning/index.hbs
  Level: L3 Tab

  Isinya dipindahkan dari halaman landing `kelas/detail.hbs` beserta pohon
  partial `program_detail/*`, atas permintaan pemilik. Versi landing itu yang
  cocok dengan frame desain: kartu sesi dengan badge "Attendance Required",
  tombol Mark Attendance, ubin Materials terkunci, catatan alasan penguncian,
  serta baris Week Quiz. Versi backoffice sebelumnya menghitung ulang status
  buka-kunci di sisi klien dan tidak punya tugas, kuis per minggu, maupun
  portfolio.

  Susunannya mengikuti frame desain, bukan susunan landing: minggu di kolom
  kiri yang lebar, kartu program di kolom kanan. Pada halaman landing posisinya
  terbalik.

  Data dari controller fragment (courses.controller.ts):
  - course     : course yang sedang aktif
  - minggu     : hasil CoursesService.findWeeks(courseId, userId), sudah memuat
                 status buka-kunci per minggu; JANGAN dihitung ulang di template
  - user_kelas : baris user_courses untuk course ini, dipakai menampilkan portfolio
  - portfolio  : portfolio student pada course ini

  Seluruh aksi di dalamnya menuju halaman yang sudah dibungkus chrome backoffice
  (lihat partials/user/shell_frame), jadi student tidak pernah keluar ke layout
  landing. Lihat docs/user-area-learning-consolidation-plan.md.
--}}
<div class="p-4 sm:px-[34px] sm:py-[42px]">

  {{!--
    Kepala panel. Sebelumnya hanya judul dan satu kalimat ajakan, sehingga
    student tidak punya cara tahu sudah sampai mana tanpa membuka satu per satu
    minggu. Sekarang memuat kemajuan program dan satu tombol menuju minggu yang
    sedang berjalan. Angkanya dihitung di controller (lihat myCourseFragment).
  --}}
  <div class="mb-6 rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        {{!-- Judul program sudah tampil di kepala, dan label tab sudah menyebut
             bagian ini; mengulanginya di sini membuat kata yang sama muncul dua
             kali berturut-turut. --}}
        <p class="font-inter text-sm text-[#737373]">
          {{#if progress.allDone}}
            {{t 'test.startLearning.allWeeksDone'}}
          {{else if progress.currentWeekNumber}}
            {{default (t 'test.startLearning.week') 'Week'}} {{progress.currentWeekNumber}} {{t 'test.startLearning.inProgress'}}
          {{else}}
            {{default (t 'test.startLearning.spanStartLearning') 'Complete each week to unlock the next'}}
          {{/if}}
        </p>
      </div>

      {{#if progress.currentWeekId}}
        {{!-- Satu aksi utama: bawa student ke minggu yang sedang berjalan dan
             buka kartunya. Kunci localStorage-nya sama dengan yang dibaca
             x-data tiap minggu, jadi kartunya benar-benar terbuka. --}}
        <button
          type="button"
          @click="localStorage.setItem('open-minggu-{{progress.currentWeekId}}', 'true');
                  const el = document.getElementById('week-{{progress.currentWeekId}}');
                  if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); el.dispatchEvent(new CustomEvent('open-week')); }"
          class="inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-[18px] font-inter text-base font-semibold text-white transition-colors hover:bg-[#00254a]"
        >
          {{t 'test.startLearning.continue'}}
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </button>
      {{/if}}
    </div>

    {{#if progress.totalWeeks}}
      {{!--
        Ringkasan kemajuan. Idenya diambil dari blok ringkasan silabus pada
        halaman belajar bisa.ai - cincin persentase di kiri, hitungan di
        kanannya - tetapi digambar dengan token warna kita sendiri dan memakai
        satuan yang kita punya (minggu). Bukan salinan tampilannya.

        Cincinnya SVG biasa: satu lingkaran latar dan satu lagi yang panjang
        goresannya diatur stroke-dasharray, jadi tidak perlu pustaka tambahan.
      --}}
      <div class="mt-5 flex flex-col gap-5 rounded-lg bg-[#FAFAFA] p-5 sm:flex-row sm:items-center">
        {{!-- Cincin ini menggantikan bar linier, jadi ia juga yang membawa
             peran progressbar-nya - kalau tidak, kemajuannya tidak lagi
             terbaca pembaca layar. --}}
        <div
          class="relative grid size-24 shrink-0 place-items-center"
          role="progressbar"
          aria-label="{{t 'test.startLearning.programProgress'}}"
          aria-valuenow="{{progress.percent}}"
          aria-valuemin="0"
          aria-valuemax="100"
        >
          <svg viewBox="0 0 36 36" class="size-24 -rotate-90" aria-hidden="true">
            <circle cx="18" cy="18" r="15.915" fill="none" stroke="#E5E5E5" stroke-width="3"></circle>
            <circle cx="18" cy="18" r="15.915" fill="none" stroke="#22C55E" stroke-width="3" stroke-linecap="round" stroke-dasharray="{{progress.percent}} 100"></circle>
          </svg>
          <span class="absolute font-montserrat text-lg font-bold text-[#003060]">{{progress.percent}}%</span>
        </div>

        <div class="min-w-0 flex-1">
          <p class="font-montserrat text-base font-bold text-[#171717]">
            {{progress.completedWeeks}} {{t 'test.startLearning.of'}} {{progress.totalWeeks}}
            {{#if (eq progress.totalWeeks 1)}}{{t 'test.startLearning.week'}}{{else}}{{t 'test.startLearning.weeks'}}{{/if}}
            {{t 'test.startLearning.completedLower'}}
          </p>

          <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3">
            <span class="inline-flex items-center gap-2">
              <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-[#E4F1F7] text-[#003060]"><i class="fa-regular fa-calendar text-xs"></i></span>
              <span class="font-inter text-xs text-[#737373]">{{t 'test.startLearning.totalWeeks'}}<span class="block font-montserrat text-sm font-bold text-[#171717]">{{progress.totalWeeks}}</span></span>
            </span>
            <span class="inline-flex items-center gap-2">
              <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-[#f0fdf4] text-[#15803d]"><i class="fa-solid fa-circle-check text-xs"></i></span>
              <span class="font-inter text-xs text-[#737373]">{{t 'test.startLearning.completedCount'}}<span class="block font-montserrat text-sm font-bold text-[#171717]">{{progress.completedWeeks}}</span></span>
            </span>
            <span class="inline-flex items-center gap-2">
              <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-[#FEFCE8] text-[#A16207]"><i class="fa-regular fa-clock text-xs"></i></span>
              <span class="font-inter text-xs text-[#737373]">{{t 'test.startLearning.remaining'}}<span class="block font-montserrat text-sm font-bold text-[#171717]">{{subtract progress.totalWeeks progress.completedWeeks}}</span></span>
            </span>
          </div>
        </div>
      </div>
    {{/if}}
  </div>

  {{!-- Satu kolom penuh: kartu program di kanan sudah dibubarkan. --}}
  <div class="w-full">

    <div class="min-w-0 space-y-4">
        {{#each minggu}}
          {{#if weekProgresses.[0].process}}
            <!-- Week Design (Completed or In Progress) -->
            <div
              x-data="{
                {{!-- Minggu yang sedang berjalan terbuka sendiri pada kunjungan
                     pertama. Sebelumnya semuanya tertutup, sehingga student harus
                     menebak sudah sampai mana. Pilihan manual student tetap
                     menang karena localStorage diperiksa lebih dulu. --}}
                openMinggu: localStorage.getItem(`open-minggu-{{this.id}}`) !== null
                  ? localStorage.getItem(`open-minggu-{{this.id}}`) === 'true'
                  : {{#if (eq ../progress.currentWeekId this.id)}}true{{else}}false{{/if}},
                sessions: localStorage.getItem(`sessions-data-{{this.id}}`) ? JSON.parse(localStorage.getItem(`sessions-data-{{this.id}}`)) : [],
                quizData: localStorage.getItem(`quiz-data-{{this.id}}`) ? JSON.parse(localStorage.getItem(`quiz-data-{{this.id}}`)) : [],
                loading: false,
                error: null,
                dataLoaded: false,

                  async init() {
          const pertemuanResponse = await fetch('/program/session/{{this.id}}');
          const quizResponse = await fetch('/program/quiz/{{this.id}}');

          this.sessions = await pertemuanResponse.json();
      localStorage.setItem(`sessions-data-{{this.id}}`, JSON.stringify(this.sessions));

          this.quizData = await quizResponse.json();
      localStorage.setItem(`quiz-data-{{this.id}}`, JSON.stringify(this.quizData));
          this.dataLoaded = true;
    },
                
                async toggleAndFetch() {
                  this.openMinggu = !this.openMinggu;
                  localStorage.setItem(`open-minggu-{{this.id}}`, this.openMinggu);
                  
                  // Fetch data hanya jika dibuka dan belum pernah di-load
                  if (this.openMinggu && !this.dataLoaded) {
                    await this.fetchData();
                  }
                },
                
                async fetchData() {
                  this.loading = true;
                  this.error = null;
                  
                  try {
                    // Fetch pertemuan dan quiz secara parallel
                    const [pertemuanResponse, quizResponse] = await Promise.all([
                      fetch('/program/session/{{this.id}}'),
                      fetch('/program/quiz/{{this.id}}')
                    ]);
                    
                    if (!pertemuanResponse.ok || !quizResponse.ok) {
                      throw new Error('Failed to fetch data');
                    }
                    
                    this.sessions = await pertemuanResponse.json();
                    this.quizData = await quizResponse.json();
                    localStorage.setItem(`sessions-data-{{this.id}}`, JSON.stringify(this.sessions));
                    localStorage.setItem(`quiz-data-{{this.id}}`, JSON.stringify(this.quizData));
                    this.dataLoaded = true;
                  } catch (err) {
                    this.error = err.message;
                    console.error('Error fetching data:', err);
                  } finally {
                    this.loading = false;
                  }
                }
              }"
              id='week-{{this.id}}'
              @open-week="openMinggu = true; if (!dataLoaded) fetchData()"
              class='overflow-hidden rounded-xl border border-[#E5E5E5] bg-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-shadow hover:shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.10)]'
              x-init='init()'
            >
{{> program_detail/right_content/week/button_week}}

              <div
                x-show='openMinggu'
                x-collapse
                class='px-5 pb-5 bg-gray-50/50'
              >
                <!-- Loading State -->
                <div
                  x-show='loading'
                  class='flex items-center justify-center py-8'
                >
                  <div class='flex items-center space-x-2'>
                    <svg
                      class='animate-spin h-5 w-5 text-[#525252]'
                      xmlns='http://www.w3.org/2000/svg'
                      fill='none'
                      viewBox='0 0 24 24'
                    >
                      <circle
                        class='opacity-25'
                        cx='12'
                        cy='12'
                        r='10'
                        stroke='currentColor'
                        stroke-width='4'
                      ></circle>
                      <path
                        class='opacity-75'
                        fill='currentColor'
                        d='M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z'
                      ></path>
                    </svg>
                    <span class='text-[#525252] text-sm font-medium'>Loading
                      data...</span>
                  </div>
                </div>

                <!-- Error State -->
                <div
                  x-show='error'
                  class='mt-4 p-4 bg-red-50 border border-red-200 rounded-lg'
                >
                  <div class='flex items-center'>
                    <svg
                      class='w-5 h-5 text-red-600 mr-2'
                      fill='none'
                      stroke='currentColor'
                      viewBox='0 0 24 24'
                    >
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='2'
                        d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                      />
                    </svg>
                    <p class='text-sm text-red-800' x-text='error'></p>
                  </div>
                </div>

                <!-- Content State -->
                <div
                  x-show='!loading && !error && dataLoaded'
                  class='space-y-3 mt-4'
                >
                  {{!--
                    Daftar sesi.

                    Sebelumnya tiap sesi adalah akordeon di dalam akordeon
                    minggu: untuk membaca satu tugas, student membuka minggu,
                    lalu membuka sesi, lalu membacanya di ruang selebar setengah
                    layar. Sekarang barisnya menjadi tautan menuju halaman
                    detail sesi (/program/session/detail/:id), dan seluruh isi
                    sesi tinggal di sana.

                    Arti `sessionProgress[0].isAttended` di sini adalah SESI
                    SUDAH TERBUKA, bukan student sudah absen; kehadiran
                    sungguhan ada di `attendances`. Aturan yang sama dipakai
                    server di CoursesService.findSessionDetail.
                  --}}
                  <template x-for='session in sessions' :key='session.id'>
                    <div>
                      {{!-- Sesi terbuka --}}
                      <template x-if='session.sessionProgress.length > 0 && session.sessionProgress[0].isAttended === true'>
                        <a
                          :href='`/program/session/detail/${session.id}`'
                          class='group flex items-center justify-between gap-3 rounded-lg border border-[#E5E5E5] bg-white px-4 py-3 no-underline transition-colors hover:border-[#003060] hover:bg-[#FAFAFA]'
                        >
                          <div class='flex min-w-0 items-center gap-3'>
                            <span
                              class='grid size-8 shrink-0 place-items-center rounded-lg font-inter text-xs font-bold'
                              :class="session.sessionProgress?.[0]?.logbook ? 'bg-[#f0fdf4] text-[#15803d]' : 'bg-[#E4F1F7] text-[#003060]'"
                            >
                              <template x-if='session.sessionProgress?.[0]?.logbook'>
                                <i class='fa-solid fa-check'></i>
                              </template>
                              <template x-if='!session.sessionProgress?.[0]?.logbook'>
                                <span x-text='session.sessionOrder'></span>
                              </template>
                            </span>

                            <div class='min-w-0'>
                              <div class='flex flex-wrap items-center gap-2'>
                                <h4
                                  class='truncate font-montserrat text-sm font-bold text-[#171717]'
                                  x-text='session.topic || `{{t "test.startLearning.session"}} ${session.sessionOrder}`'
                                ></h4>
                                <template x-if='session.sessionProgress?.[0]?.logbook'>
                                  <span class='rounded-full bg-[#f0fdf4] px-2 py-0.5 font-inter text-xs font-semibold text-[#15803d]'>
                                    {{t 'test.startLearning.completed'}}
                                  </span>
                                </template>
                                <template x-if='!session.sessionProgress?.[0]?.logbook && session.attendances.length === 0'>
                                  <span class='rounded-full bg-[#FEFCE8] px-2 py-0.5 font-inter text-xs font-semibold text-[#A16207]'>
                                    {{t 'test.startLearning.attendanceRequired'}}
                                  </span>
                                </template>
                              </div>

                              {{!-- Isi sesi disebut di sini supaya student tahu
                                   ada apa sebelum membukanya. --}}
                              <p class='mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-0.5 font-inter text-xs text-[#737373]'>
                                <template x-if='session.date'>
                                  <span x-text='new Date(session.date).toLocaleDateString()'></span>
                                </template>
                                <template x-if='session.materials?.length'>
                                  <span>
                                    <span x-text='session.materials.length'></span>
                                    {{t 'test.startLearning.materials'}}
                                  </span>
                                </template>
                                <template x-if='session.assignments?.length'>
                                  <span>
                                    <span x-text='session.assignments.length'></span>
                                    {{t 'test.startLearning.assignment'}}
                                  </span>
                                </template>
                              </p>
                            </div>
                          </div>

                          <span class='inline-flex shrink-0 items-center gap-1.5 font-inter text-xs font-semibold text-[#003060]'>
                            <span class='hidden sm:inline'>{{t 'test.startLearning.openSession'}}</span>
                            <i class='fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5'></i>
                          </span>
                        </a>
                      </template>

{{> program_detail/right_content/week/session/locked_session}}
                    </div>
                  </template>

{{> program_detail/right_content/week/quiz}}
                </div>
              </div>
            </div>

          {{else}}
{{> program_detail/right_content/week/locked_week}}
          {{/if}}
        {{/each}}

      {{#unless minggu.length}}
        <div class="flex flex-col items-center gap-3 rounded-xl border border-[#d9d9d9] bg-white p-12 text-center">
          <span class="grid size-14 place-items-center rounded-full bg-[#f4f7fc] text-[#003060]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/></svg>
          </span>
          <h3 class="font-montserrat text-xl font-bold text-[#003060]">No weeks yet</h3>
          <p class="font-inter text-sm text-[#737373]">Your mentor has not added the learning weeks for this program.</p>
        </div>
      {{/unless}}
    </div>

  </div>

  {{#if user_kelas.progress}}
    <div class="mt-6">
      {{> program_detail/right_content/portfolio}}
    </div>
  {{/if}}
</div>
