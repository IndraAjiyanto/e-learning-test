{{!--
  Panel: Start Learning (tab area student - UI/UX)
  Lokasi: src/views/partials/user/sidebar_user_profile/my_learning/start_learning/index.hbs
  Level: L3 Tab
  Referensi Figma: node-id=1496-1317 (Learning workspace & schedule)
--}}

{{!-- Progress summary metadata for test runner & accessibility --}}
{{#if progress.totalWeeks}}
  <div class="sr-only" role="progressbar" aria-valuenow="{{progress.percent}}" aria-valuemin="0" aria-valuemax="100">
    {{progress.completedWeeks}} of {{progress.totalWeeks}} weeks completed ({{progress.percent}}%)
  </div>
{{/if}}

{{!-- Learning workspace --}}
<div
  class="w-full max-w-[1268px] mx-auto flex flex-col items-start mt-8 rounded-2xl gap-[18px] py-5 bg-white font-inter relative"
  x-data="{
    courseId: '{{#if course.id}}{{course.id}}{{else if activeCourse.id}}{{activeCourse.id}}{{/if}}',
    currentUserId: '{{user.id}}',
    showEditModal: false,
    statusDropdownOpen: false,
    editAttendanceId: null,
    editSessionId: null,
    attendanceWeekId: null,
    editStatus: 'present',
    editNotes: '',
    statusLabels: {
      'present': '{{default (t 'test.attendance.present') 'Present'}}',
      'sick': '{{default (t 'test.attendance.sick') 'Sick'}}',
      'permission': '{{default (t 'test.attendance.permission') 'Permission'}}',
      'absent': '{{default (t 'test.attendance.absent') 'Absent'}}',
      'no_information': '{{default (t 'test.attendance.noInformation') 'No Information'}}'
    },
    openEditModal(attendanceId, sessionId, currentStatus, currentNotes, weekId) {
      this.editAttendanceId = attendanceId || null;
      this.editSessionId = sessionId;
      this.attendanceWeekId = weekId || null;
      this.editStatus = currentStatus || 'present';
      this.editNotes = currentNotes || '';
      this.statusDropdownOpen = false;
      this.showEditModal = true;
    },
    async saveAttendance() {
      if (!this.editStatus || !this.editSessionId) return;

      if (this.editAttendanceId) {
        if (typeof showErrorToast === 'function') {
          showErrorToast('Attendance not updated', '{{t 'test.startLearning.editAttendanceUnavailable'}}');
        } else {
          window.dispatchEvent(new CustomEvent('toast:error', {
            detail: {
              title: 'Attendance not updated',
              description: '{{t 'test.startLearning.editAttendanceUnavailable'}}'
            }
          }));
        }
        return;
      }

      if (String(this.editSessionId).startsWith('mock-')) {
        this.showEditModal = false;
        window.dispatchEvent(new CustomEvent('toast:success', {
          detail: {
            title: '{{default (t 'test.attendance.saveAttendance') 'Attendance Recorded'}}',
            description: 'Successfully submitted attendance'
          }
        }));
        window.dispatchEvent(new CustomEvent('attendance-recorded', {
          detail: { sessionId: this.editSessionId, weekId: this.attendanceWeekId, status: this.editStatus }
        }));
        return;
      }

      try {
        const response = await fetch(`/attendance/${this.editSessionId}/${this.currentUserId}/${this.courseId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            status: this.editStatus,
            notes: this.editNotes || '-'
          })
        });

        const data = await response.json();
        if (data.success) {
          this.showEditModal = false;

          window.dispatchEvent(new CustomEvent('toast:success', {
            detail: {
              title: '{{default (t 'test.attendance.saveAttendance') 'Attendance Recorded'}}',
              description: data.message || 'Successfully submitted attendance'
            }
          }));

          window.dispatchEvent(new CustomEvent('attendance-recorded', {
            detail: { sessionId: this.editSessionId, weekId: this.attendanceWeekId, status: this.editStatus }
          }));
        } else {
          if (typeof showErrorToast === 'function') {
            showErrorToast('Attendance not updated', data.message || 'Please try again in a moment.');
          } else {
            window.dispatchEvent(new CustomEvent('toast:error', {
              detail: {
                title: 'Attendance not updated',
                description: data.message || 'Please try again in a moment.'
              }
            }));
          }
        }
      } catch (error) {
        if (typeof showErrorToast === 'function') {
          showErrorToast('Attendance not updated', 'The request did not go through. Check your connection and try again.');
        } else {
          window.dispatchEvent(new CustomEvent('toast:error', {
            detail: {
              title: 'Attendance not updated',
              description: 'The request did not go through. Check your connection and try again.'
            }
          }));
        }
      }
    }
  }"
  @open-attendance-modal.window="openEditModal($event.detail.attendanceId, $event.detail.session?.id || $event.detail.sessionId, $event.detail.currentStatus, $event.detail.currentNotes, $event.detail.weekId)"
>

{{!-- Learning schedule --}}
    <div
      class="w-full flex flex-col items-start gap-6"
      x-data="{
        weekPage: 1,
        perPage: 5,
        get totalWeeks() { return {{minggu.length}}; },
        get totalPages() { return Math.max(1, Math.ceil(this.totalWeeks / this.perPage)); }
      }"
    >

      {{#if minggu.length}}
        {{#each minggu}}
          <template x-if="Math.floor({{@index}} / 5) + 1 === weekPage">
          {{#if (or weekProgresses.[0].process progres_minggu.[0].proses (eq @index 0))}}
          {{!-- Week item (Unlocked & Open) --}}
          <div
            x-data="{
              openMinggu: localStorage.getItem(`open-minggu-{{this.id}}`) !== null
                ? localStorage.getItem(`open-minggu-{{this.id}}`) === 'true'
                : {{#if (eq @index 0)}}true{{else}}false{{/if}},
              sessions: localStorage.getItem(`sessions-data-{{this.id}}`) ? JSON.parse(localStorage.getItem(`sessions-data-{{this.id}}`)) : [],
              quizData: localStorage.getItem(`quiz-data-{{this.id}}`) ? JSON.parse(localStorage.getItem(`quiz-data-{{this.id}}`)) : [],
              loading: false,
              error: null,
              dataLoaded: false,

              async init() {
                this.loading = true;
                try {
                  const [pertemuanResponse, quizResponse] = await Promise.all([
                    fetch('/program/session/{{this.id}}'),
                    fetch('/program/quiz/{{this.id}}')
                  ]);
                  if (pertemuanResponse.ok) {
                    this.sessions = await pertemuanResponse.json();
                    localStorage.setItem(`sessions-data-{{this.id}}`, JSON.stringify(this.sessions));
                  }
                  if (quizResponse.ok) {
                    this.quizData = await quizResponse.json();
                    localStorage.setItem(`quiz-data-{{this.id}}`, JSON.stringify(this.quizData));
                  }
                } catch (e) {
                  console.error('Error fetching week data:', e);
                  this.error = e.message;
                } finally {
                  this.loading = false;
                  this.dataLoaded = true;
                }
              },

              toggle() {
                this.openMinggu = !this.openMinggu;
                localStorage.setItem(`open-minggu-{{this.id}}`, this.openMinggu);
              },

              isSessionUnlocked(session, index) {
                if (index === 0) return true;
                const sp = Array.isArray(session.sessionProgress) ? session.sessionProgress[0] : session.sessionProgress;
                const pp = Array.isArray(session.progres_pertemuan) ? session.progres_pertemuan[0] : session.progres_pertemuan;
                if (sp && (sp.isAttended === true || sp.isAttended === 1)) return true;
                if (pp && (pp.absen === true || pp.absen === 1)) return true;
                if (session.attendances && session.attendances.length > 0) return true;
                if (session.absen && session.absen.length > 0) return true;
                if (this.sessions && index > 0 && this.sessions[index - 1]) {
                  const prev = this.sessions[index - 1];
                  if (this.isSessionCompleted(prev)) return true;
                }
                return false;
              },

              hasAttended(session) {
                return (session.attendances && session.attendances.length > 0) || (session.absen && session.absen.length > 0);
              },

              isSessionCompleted(session) {
                const sp = Array.isArray(session.sessionProgress) ? session.sessionProgress[0] : session.sessionProgress;
                const pp = Array.isArray(session.progres_pertemuan) ? session.progres_pertemuan[0] : session.progres_pertemuan;
                if (sp && sp.logbook === true) return true;
                if (pp && pp.logbook === true) return true;
                const logbooks = session.logbooks || session.logbook;
                if (Array.isArray(logbooks) && logbooks[0] && (logbooks[0].process === 'approved' || logbooks[0].process === 'acc' || logbooks[0].proses === 'acc')) return true;
                return false;
              },

              getAssignments(session) {
                return session.assignments || session.tugas || [];
              },

              getLogbook(session) {
                const lb = session.logbooks || session.logbook;
                return Array.isArray(lb) ? lb[0] : lb;
              },

              isQuizUnlocked(quiz) {
                const qp = quiz.quizProgresses || quiz.progres_quiz;
                return Array.isArray(qp) && qp.length > 0;
              },

              hasQuestions(quiz) {
                const qs = quiz.questions || quiz.pertanyaan;
                return Array.isArray(qs) && qs.length > 0;
              },

              handleAttendanceRecorded(detail) {
                if (this.sessions && this.sessions.length > 0) {
                  const targetSession = this.sessions.find(s => String(s.id) === String(detail.sessionId));
                  if (targetSession) {
                    if (!targetSession.attendances) targetSession.attendances = [];
                    targetSession.attendances.push({
                      id: 'new-' + Date.now(),
                      status: detail.status,
                      attendanceTime: new Date()
                    });
                    localStorage.setItem(`sessions-data-{{this.id}}`, JSON.stringify(this.sessions));
                  }
                }
              }
            }"
            id="week-{{this.id}}"
            @attendance-recorded.window="handleAttendanceRecorded($event.detail)"
            class="w-full bg-white border border-[#E6ECF7] rounded-[14px] shadow-[0px_8px_28px_rgba(43,74,122,0.07)] overflow-hidden transition-all"
          >
            {{!-- Week header --}}
            <button
              type="button"
              @click="toggle()"
              :aria-expanded="openMinggu"
              class="w-full flex flex-row items-center px-6 sm:px-8 py-5 sm:h-[108px] gap-6 text-left cursor-pointer bg-white transition-colors hover:bg-[#F8FAFC]"
            >
              {{!-- Status icon --}}
              <div class="w-12 h-12 rounded-full bg-[#E9F0FF] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#6682B5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                </svg>
              </div>

              {{!-- Week details --}}
              <div class="flex flex-col items-start gap-[7px] flex-1 min-w-0">
                <span class="font-inter font-semibold text-base leading-5 text-[#17345E] truncate">
                  {{#if this.description}}{{this.description}}{{else}}Requirement{{/if}}
                </span>
              </div>

              {{!-- chevron-up / chevron-down --}}
              <div class="w-4 h-4 flex items-center justify-center shrink-0">
                <svg
                  :class="openMinggu ? 'rotate-180' : ''"
                  class="w-4 h-4 text-[#4D6EF3] transition-transform duration-200"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M6 9l6 6 6-6"></path>
                </svg>
              </div>
            </button>

            {{!-- Divider --}}
            <div x-show="openMinggu" class="w-full h-[1px] bg-[#E6ECF7]"></div>

            {{!-- Dropdown content --}}
            <div x-show="openMinggu" x-collapse class="w-full flex flex-col items-start px-6 sm:px-8 pt-6 pb-7 gap-4 bg-white">
              {{!-- Loading State --}}
              <div x-show="loading" class="w-full flex items-center justify-center py-6">
                <div class="flex items-center space-x-2 text-[#525252] text-sm font-medium">
                  <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24" fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <span>Loading data...</span>
                </div>
              </div>

              {{!-- Dynamic Sessions List (Each session is an individual dropdown) --}}
              <template x-for="(session, sessionIndex) in sessions" :key="session.id">
                <div class="w-full">
                  {{!-- Unlocked Session Dropdown --}}
                  <template x-if="isSessionUnlocked(session, sessionIndex)">
                    <div
                      x-data="{
                        openSession: localStorage.getItem(`open-session-${session.id}`) !== null
                          ? localStorage.getItem(`open-session-${session.id}`) === 'true'
                          : (sessionIndex === 0),
                        toggleSession() {
                          this.openSession = !this.openSession;
                          localStorage.setItem(`open-session-${session.id}`, this.openSession);
                        }
                      }"
                      class="w-full bg-white border border-[#E6ECF7] rounded-[12px] shadow-sm overflow-hidden transition-all duration-200"
                    >
                      {{!-- Session Header (Dropdown Trigger) --}}
                      <button
                        type="button"
                        @click="toggleSession()"
                        :aria-expanded="openSession"
                        class="w-full flex flex-row items-center justify-between px-5 py-4 gap-4 text-left cursor-pointer transition-colors hover:bg-[#F8FAFC]"
                      >
                        <div class="flex items-center gap-3.5 flex-1 min-w-0">
                          <div
                            :class="isSessionCompleted(session) ? 'bg-[#EAF7EE] text-[#15803D]' : (hasAttended(session) ? 'bg-[#E9F0FF] text-[#4D6EF3]' : 'bg-[#F1F5F9] text-[#64748B]')"
                            class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 transition-colors"
                          >
                            <template x-if="isSessionCompleted(session)">
                              <svg class="w-5 h-5 text-[#15803D]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                              </svg>
                            </template>
                            <template x-if="!isSessionCompleted(session) && hasAttended(session)">
                              <svg class="w-5 h-5 text-[#4D6EF3]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                              </svg>
                            </template>
                            <template x-if="!isSessionCompleted(session) && !hasAttended(session)">
                              <svg class="w-5 h-5 text-[#64748B]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                              </svg>
                            </template>
                          </div>

                          <div class="flex flex-col items-start gap-1 flex-1 min-w-0">
                            <span
                              class="font-inter font-bold text-[15px] leading-[18px] text-[#17345E] truncate"
                              x-text="(session.topic || session.topik) ? (session.topic || session.topik) : `Session ${session.sessionOrder || session.pertemuan_ke || (sessionIndex + 1)}`"
                            ></span>
                            <div class="flex flex-row items-center gap-1.5 flex-wrap text-[#8091B1]">
                              <svg class="w-3.5 h-3.5 text-[#8091B1] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                              </svg>
                              <span class="font-inter font-normal text-xs leading-4" x-text="(session.date || session.tanggal) ? new Date(session.date || session.tanggal).toLocaleDateString('en-GB') : '24/08/2026'">24/08/2026</span>
                              <span class="text-[#8091B1] mx-0.5">·</span>
                              <svg class="w-3.5 h-3.5 text-[#8091B1] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                              </svg>
                              <span class="font-inter font-normal text-xs leading-4" x-text="((session.startTime || session.waktu_awal) && (session.endTime || session.waktu_akhir)) ? (`${session.startTime || session.waktu_awal} - ${session.endTime || session.waktu_akhir}`) : '09:00 - 16:00'">09:00 - 16:00</span>
                            </div>
                          </div>
                        </div>

                        <div class="flex items-center gap-3 shrink-0">
                          <template x-if="isSessionCompleted(session)">
                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-[#EAF7EE] text-[#15803D] whitespace-nowrap">
                              {{t 'test.startLearning.completed'}}
                            </span>
                          </template>
                          <template x-if="!isSessionCompleted(session) && hasAttended(session)">
                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-[#EAF7EE] text-[#15803D] whitespace-nowrap">
                              {{t 'test.startLearning.attendaceRecorded'}}
                            </span>
                          </template>
                          <template x-if="!hasAttended(session)">
                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-[#FDECEA] text-[#E05A5A] whitespace-nowrap">
                              {{t 'test.startLearning.attendanceRequired'}}
                            </span>
                          </template>

                          <div class="w-5 h-5 flex items-center justify-center">
                            <svg
                              :class="openSession ? 'rotate-180' : ''"
                              class="w-4 h-4 text-[#4D6EF3] transition-transform duration-200"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="M6 9l6 6 6-6"></path>
                            </svg>
                          </div>
                        </div>
                      </button>

                      {{!-- Session Dropdown Body --}}
                      <div x-show="openSession" x-collapse class="w-full border-t border-[#E6ECF7] bg-[#FAFCFF] p-5 sm:p-6 flex flex-col gap-5">
                        {{!-- Attendance Action (Only when attendance is required) --}}
                        <template x-if="!hasAttended(session)">
                          <div class="w-full flex flex-col gap-3">
                            <button
                              type="button"
                              @click="$dispatch('open-attendance-modal', { session: session, weekId: '{{this.id}}' })"
                              class="w-full h-12 flex flex-row justify-center items-center py-3 px-6 gap-2.5 bg-[#1C2D4A] hover:bg-[#15233a] rounded-[10px] text-white font-inter font-bold text-sm leading-[18px] transition-colors cursor-pointer shadow-sm hover:shadow"
                            >
                              <svg class="w-4 h-4 text-white shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                              </svg>
                              <span>{{t 'test.startLearning.markAttendance'}}</span>
                            </button>
                          </div>
                        </template>

                        {{!-- Materials section --}}
                        <div class="w-full flex flex-col items-start gap-3">
                          <div class="w-full flex flex-row items-center gap-2">
                            <template x-if="!hasAttended(session)">
                              <svg class="w-4 h-4 text-[#8091B1] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                              </svg>
                            </template>
                            <template x-if="hasAttended(session)">
                              <svg class="w-4 h-4 text-[#17345E] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                              </svg>
                            </template>
                            <span class="font-inter font-semibold text-sm text-[#17345E]" x-text="!hasAttended(session) ? '{{t 'test.startLearning.materialsLocked'}}' : '{{t 'test.startLearning.materials'}}'"></span>
                          </div>

                          <div class="w-full grid grid-cols-1 sm:grid-cols-3 gap-3" :class="!hasAttended(session) ? 'opacity-50 pointer-events-none' : ''">
                            {{!-- PDF --}}
                            <a
                              :href="hasAttended(session) ? ('/learning-material/pdf/' + session.id) : '#'"
                              class="h-[117px] bg-[#FFFFFF] border border-[#E6ECF7] rounded-[10px] py-4 px-3 flex flex-col justify-center items-center gap-2.5 transition-all duration-200 hover:border-[#1C2D4A] hover:shadow-sm no-underline group"
                            >
                              <div class="w-9 h-9 bg-[#EEF1F8] group-hover:bg-[#E9F0FF] rounded-lg flex items-center justify-center shrink-0 transition-colors">
                                <svg class="w-[18px] h-[18px] text-[#6682B5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                  <polyline points="14 2 14 8 20 8"></polyline>
                                  <line x1="16" y1="13" x2="8" y2="13"></line>
                                  <line x1="16" y1="17" x2="8" y2="17"></line>
                                  <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                              </div>
                              <span class="font-inter font-medium text-xs leading-[15px] text-[#17345E]">{{t 'test.startLearning.pdf'}}</span>
                              <svg class="w-3.5 h-3.5 text-[#15803D]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                              </svg>
                            </a>

                            {{!-- Video --}}
                            <a
                              :href="hasAttended(session) ? ('/learning-material/video/' + session.id) : '#'"
                              class="h-[117px] bg-[#FFFFFF] border border-[#E6ECF7] rounded-[10px] py-4 px-3 flex flex-col justify-center items-center gap-2.5 transition-all duration-200 hover:border-[#1C2D4A] hover:shadow-sm no-underline group"
                            >
                              <div class="w-9 h-9 bg-[#EEF1F8] group-hover:bg-[#E9F0FF] rounded-lg flex items-center justify-center shrink-0 transition-colors">
                                <svg class="w-[18px] h-[18px] text-[#6682B5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                  <polygon points="23 7 16 12 23 17 23 7"></polygon>
                                  <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                                </svg>
                              </div>
                              <span class="font-inter font-medium text-xs leading-[15px] text-[#17345E]">{{t 'test.startLearning.video'}}</span>
                              <svg class="w-3.5 h-3.5 text-[#15803D]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="5 3 19 12 5 21 5 3"></polygon>
                              </svg>
                            </a>

                            {{!-- PPT --}}
                            <a
                              :href="hasAttended(session) ? ('/learning-material/ppt/' + session.id) : '#'"
                              class="h-[117px] bg-[#FFFFFF] border border-[#E6ECF7] rounded-[10px] py-4 px-3 flex flex-col justify-center items-center gap-2.5 transition-all duration-200 hover:border-[#1C2D4A] hover:shadow-sm no-underline group"
                            >
                              <div class="w-9 h-9 bg-[#EEF1F8] group-hover:bg-[#E9F0FF] rounded-lg flex items-center justify-center shrink-0 transition-colors">
                                <svg class="w-[18px] h-[18px] text-[#6682B5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                  <path d="M2 3h20"></path>
                                  <path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"></path>
                                  <path d="m7 21 5-5 5 5"></path>
                                </svg>
                              </div>
                              <span class="font-inter font-medium text-xs leading-[15px] text-[#17345E]">{{t 'test.startLearning.ppt'}}</span>
                              <svg class="w-3.5 h-3.5 text-[#15803D]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                              </svg>
                            </a>
                          </div>
                        </div>

                        {{!-- Assignments Section --}}
                        <template x-if="hasAttended(session) && getAssignments(session).length > 0">
                          <div class="w-full flex flex-col gap-2.5 pt-2 border-t border-[#E6ECF7]">
                            <span class="font-inter font-semibold text-sm text-[#17345E]">{{t 'test.startLearning.assignment'}}</span>
                            <template x-for="(task, taskIndex) in getAssignments(session)" :key="task.id">
                              <div class="w-full">
                                <template x-if="!task.taskAnswers?.length && !task.jawaban_tugas?.length">
                                  <a
                                    :href="'/answer-assigment/' + session.id + '/' + task.id"
                                    class="w-full h-11 flex items-center justify-center gap-2 bg-[#2563EB] hover:bg-[#1D4ED8] rounded-[10px] text-white font-inter font-semibold text-sm transition-all no-underline shadow-sm"
                                  >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                    <span><span x-text="taskIndex + 1"></span> - {{t 'test.startLearning.startAssignment'}}</span>
                                  </a>
                                </template>

                                <template x-if="(task.taskAnswers?.[0]?.process === 'approved' || task.taskAnswers?.[0]?.process === 'acc' || task.jawaban_tugas?.[0]?.proses === 'acc')">
                                  <a
                                    :href="'/answer-assigment/' + session.id + '/' + task.id"
                                    class="w-full h-11 flex items-center justify-center gap-2 bg-[#059669] hover:bg-[#047857] rounded-[10px] text-white font-inter font-semibold text-sm transition-all no-underline shadow-sm"
                                  >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    <span><span x-text="taskIndex + 1"></span> - {{t 'test.startLearning.assignmentCompleted'}}</span>
                                  </a>
                                </template>

                                <template x-if="(task.taskAnswers?.[0]?.process === 'process' || task.taskAnswers?.[0]?.process === 'proces' || task.jawaban_tugas?.[0]?.proses === 'proces')">
                                  <a
                                    :href="'/answer-assigment/' + session.id + '/' + task.id"
                                    class="w-full h-11 flex items-center justify-center gap-2 bg-[#D97706] hover:bg-[#B45309] rounded-[10px] text-white font-inter font-semibold text-sm transition-all no-underline shadow-sm"
                                  >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    <span><span x-text="taskIndex + 1"></span> - {{t 'test.startLearning.assignmentUnderReview'}}</span>
                                  </a>
                                </template>

                                <template x-if="(task.taskAnswers?.[0]?.process === 'rejected' || task.jawaban_tugas?.[0]?.proses === 'rejected')">
                                  <a
                                    :href="'/answer-assigment/' + session.id + '/' + task.id"
                                    class="w-full h-11 flex items-center justify-center gap-2 bg-[#DC2626] hover:bg-[#B91C1C] rounded-[10px] text-white font-inter font-semibold text-sm transition-all no-underline shadow-sm"
                                  >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                                    </svg>
                                    <span><span x-text="taskIndex + 1"></span> - {{t 'test.startLearning.reviseAssignment'}}</span>
                                  </a>
                                </template>
                              </div>
                            </template>
                          </div>
                        </template>

                        {{!-- Logbook Section --}}
                        <template x-if="hasAttended(session)">
                          <div class="w-full flex flex-col gap-2.5 pt-2 border-t border-[#E6ECF7]">
                            <span class="font-inter font-semibold text-sm text-[#17345E]">{{t 'test.startLearning.myLogbook'}}</span>
                            <template x-if="getLogbook(session)?.process === 'approved' || getLogbook(session)?.process === 'acc' || getLogbook(session)?.proses === 'acc'">
                              <a
                                :href="'/logbooks/' + getLogbook(session).id"
                                class="w-full h-11 flex items-center justify-center gap-2 bg-[#059669] hover:bg-[#047857] rounded-[10px] text-white font-inter font-semibold text-sm transition-all no-underline shadow-sm"
                              >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <span>{{t 'test.startLearning.viewApprovedLogBook'}}</span>
                              </a>
                            </template>

                            <template x-if="getLogbook(session)?.process === 'process' || getLogbook(session)?.process === 'proces' || getLogbook(session)?.proses === 'proces'">
                              <a
                                :href="'/logbooks/' + getLogbook(session).id"
                                class="w-full h-11 flex items-center justify-center gap-2 bg-[#D97706] hover:bg-[#B45309] rounded-[10px] text-white font-inter font-semibold text-sm transition-all no-underline shadow-sm"
                              >
                                <svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                </svg>
                                <span>{{t 'test.startLearning.logBookUnderReview'}}</span>
                              </a>
                            </template>

                            <template x-if="getLogbook(session)?.process === 'rejected' || getLogbook(session)?.proses === 'rejected'">
                              <a
                                :href="'/logbooks/formEdit/' + getLogbook(session).id"
                                class="w-full h-11 flex items-center justify-center gap-2 bg-[#DC2626] hover:bg-[#B91C1C] rounded-[10px] text-white font-inter font-semibold text-sm transition-all no-underline shadow-sm"
                              >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                                </svg>
                                <span>{{t 'test.startLearning.updateRejectedLogBook'}}</span>
                              </a>
                            </template>

                            <template x-if="!getLogbook(session) || (!['approved', 'acc', 'process', 'proces', 'rejected'].includes(getLogbook(session)?.process) && !['acc', 'proces', 'rejected'].includes(getLogbook(session)?.proses))">
                              <a
                                :href="'/logbooks/formCreate/' + session.id + '/{{#if course.id}}{{course.id}}{{else if kelas.id}}{{kelas.id}}{{/if}}'"
                                class="w-full h-11 flex items-center justify-center gap-2 bg-[#1C2D4A] hover:bg-[#15233a] rounded-[10px] text-white font-inter font-semibold text-sm transition-all no-underline shadow-sm"
                              >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                                </svg>
                                <span>{{t 'test.startLearning.createLogBook'}}</span>
                              </a>
                            </template>
                          </div>
                        </template>
                      </div>
                    </div>
                  </template>

                  {{!-- Locked Session Card --}}
                  <template x-if="!isSessionUnlocked(session, sessionIndex)">
                    <div class="w-full bg-[#F8FAFC] border border-[#E2E8F0] rounded-[12px] px-5 py-4 flex flex-row items-center justify-between opacity-75">
                      <div class="flex items-center gap-3.5 min-w-0">
                        <div class="w-10 h-10 rounded-xl bg-[#E2E8F0] text-[#94A3B8] flex items-center justify-center shrink-0">
                          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                          </svg>
                        </div>
                        <div class="flex flex-col items-start gap-0.5 min-w-0">
                          <span
                            class="font-inter font-bold text-[15px] leading-[18px] text-[#64748B] truncate"
                            x-text="(session.topic || session.topik) ? (`Session ${session.sessionOrder || session.pertemuan_ke || (sessionIndex + 1)} - ${session.topic || session.topik}`) : `Session ${session.sessionOrder || session.pertemuan_ke || (sessionIndex + 1)}`"
                          ></span>
                          <span class="font-inter font-normal text-xs text-[#94A3B8]">
                            {{t 'test.startLearning.completeThePreviousSession'}}
                          </span>
                        </div>
                      </div>
                      <svg class="w-5 h-5 text-[#94A3B8] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                      </svg>
                    </div>
                  </template>
                </div>
              </template>

              {{!-- Empty State: Belum Ada Session di Week Ini --}}
              <template x-if="dataLoaded && (!sessions || sessions.length === 0)">
                <div class="w-full flex flex-col items-center justify-center p-6 sm:p-8 rounded-[12px] border border-dashed border-[#CBD5E1] bg-[#F8FAFC] text-center my-1">
                  <div class="relative mb-3 flex size-14 sm:size-16 items-center justify-center rounded-2xl bg-white shadow-2xs border border-[#E2E8F0]">
                    <span class="flex size-10 items-center justify-center rounded-xl bg-[#E0F2FE] text-[#003060]">
                      <i class="fa-solid fa-chalkboard-user text-lg sm:text-xl"></i>
                    </span>
                    <span class="absolute -top-1 -right-1 flex size-5 items-center justify-center rounded-full bg-[#F59E0B] text-white text-[9px] shadow-2xs">
                      <i class="fa-solid fa-clock"></i>
                    </span>
                  </div>

                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#EFF6FF] border border-[#BFDBFE] text-[#1D4ED8] text-[11px] font-semibold uppercase tracking-wider mb-2">
                    <span class="size-1.5 rounded-full bg-[#3B82F6] animate-pulse"></span>
                    {{default (t 'test.startLearning.noSessionsInWeekBadge') 'Sesi Belum Tersedia'}}
                  </span>

                  <h4 class="font-inter font-bold text-sm sm:text-base text-[#0B1F3B] mb-1">
                    {{default (t 'test.startLearning.noSessionsInWeekTitle') 'Belum Ada Sesi di Minggu Ini'}}
                  </h4>

                  <p class="font-inter font-normal text-xs sm:text-[13px] leading-relaxed text-[#64748B] max-w-md">
                    {{default (t 'test.startLearning.noSessionsInWeekDesc') 'Materi pertemuan dan jadwal sesi pembelajaran untuk minggu ini belum ditambahkan atau sedang disiapkan oleh mentor.'}}
                  </p>
                </div>
              </template>

              {{!-- Week Quiz Section --}}
              <template x-if="quizData && quizData.length > 0">
                <div class="w-full flex flex-col gap-3 pt-3 border-t border-[#E6ECF7]">
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-[#17345E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                    <span class="font-inter font-bold text-sm text-[#17345E]">{{t 'test.startLearning.weekQuiz'}}</span>
                  </div>

                  <template x-for="quiz in quizData" :key="quiz.id">
                    <div class="w-full">
                      <template x-if="isQuizUnlocked(quiz)">
                        <div>
                          <template x-if="hasQuestions(quiz)">
                            <a
                              :href="'/quiz/form/' + quiz.id"
                              class="w-full h-11 flex items-center justify-center gap-2 bg-[#1C2D4A] hover:bg-[#15233a] rounded-[10px] text-white font-inter font-bold text-sm transition-all no-underline shadow-sm"
                            >
                              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                              </svg>
                              <span>{{t 'test.startLearning.takeQuiz'}}</span>
                            </a>
                          </template>
                          <template x-if="!hasQuestions(quiz)">
                            <div class="w-full flex items-center justify-center p-3 bg-gray-50 border border-gray-200 rounded-[10px]">
                              <span class="font-inter text-xs text-gray-500 font-medium">{{t 'test.startLearning.quizNotAvailable'}}</span>
                            </div>
                          </template>
                        </div>
                      </template>

                      <template x-if="!isQuizUnlocked(quiz)">
                        <div class="w-full flex items-center gap-2.5 p-3.5 bg-[#FEFCE8] border border-[#FDE68A] rounded-[10px]">
                          <svg class="w-4 h-4 text-[#D97706] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                          </svg>
                          <span class="font-inter font-medium text-xs text-[#92400E]">
                            {{t 'test.startLearning.completeAllSessionsToAccessQuiz'}}
                          </span>
                        </div>
                      </template>
                    </div>
                  </template>
                </div>
              </template>
            </div>
          </div>
        {{else}}
          {{!-- Week item locked --}}
          <div class="w-full bg-[#F3F4F6] border border-[#D1D5DB] rounded-[14px] shadow-[0px_4px_12px_rgba(0,0,0,0.05)] overflow-hidden">
            <div class="w-full flex flex-row items-center px-6 sm:px-8 py-5 sm:h-[108px] gap-6">
              {{!-- Status icon --}}
              <div class="w-12 h-12 rounded-full bg-[#E5E7EB] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#9CA3AF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </div>

              {{!-- Week details --}}
              <div class="flex flex-col items-start gap-[7px] flex-1 min-w-0">
                <span class="font-inter font-semibold text-base leading-[19px] text-[#6B7280] truncate">
                  {{t 'test.startLearning.week'}} {{this.weekNumber}}
                </span>
                <span class="font-inter font-normal text-xs leading-[15px] text-[#9CA3AF] truncate">
                  {{#if this.description}}{{this.description}}{{else}}Requirement{{/if}}
                </span>
              </div>

              {{!-- chevron-down --}}
              <div class="w-4 h-4 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-[#9CA3AF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 9l6 6 6-6"></path>
                </svg>
              </div>
            </div>

            {{!-- Warning banner --}}
            <div class="w-full flex flex-row items-center px-6 sm:px-8 py-2.5 gap-2.5 bg-[#FEFCE8] border-t border-[#FDE68A]">
              <svg class="w-4 h-4 text-[#D97706] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
              <span class="font-inter font-normal text-[13px] leading-4 text-[#92400E]">
                {{t 'test.startLearning.previousWeekQuizRequirement'}}
              </span>
            </div>
          </div>
        {{/if}}
          </template>
        {{/each}}

      {{else}}
        {{!-- Empty State: Belum Ada Jadwal / Week --}}
        <div class="w-full flex flex-col items-center justify-center p-8 sm:p-12 md:p-16 rounded-[20px] border border-dashed border-[#CBD5E1] bg-[#F8FAFC] text-center my-2">
          <div class="relative mb-5 flex size-20 sm:size-24 items-center justify-center rounded-2xl bg-white shadow-[0px_8px_24px_rgba(0,48,96,0.08)] border border-[#E2E8F0]">
            <span class="flex size-14 items-center justify-center rounded-xl bg-[#E0F2FE] text-[#003060]">
              <i class="fa-solid fa-calendar-week text-2xl sm:text-3xl"></i>
            </span>
            <span class="absolute -top-1.5 -right-1.5 flex size-6 items-center justify-center rounded-full bg-[#F59E0B] text-white text-[10px] shadow-sm">
              <i class="fa-solid fa-clock"></i>
            </span>
          </div>

          <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#EFF6FF] border border-[#BFDBFE] text-[#1D4ED8] text-xs font-semibold uppercase tracking-wider mb-3">
            <span class="size-1.5 rounded-full bg-[#3B82F6] animate-pulse"></span>
            {{default (t 'test.startLearning.noWeeksBadge') 'Sedang Disiapkan'}}
          </span>

          <h3 class="font-inter font-bold text-lg sm:text-xl md:text-2xl text-[#0B1F3B] mb-2 max-w-md">
            {{default (t 'test.startLearning.noWeeksTitle') 'Jadwal Belajar Belum Tersedia'}}
          </h3>

          <p class="font-inter font-normal text-sm sm:text-base leading-relaxed text-[#64748B] max-w-lg mb-6">
            {{default (t 'test.startLearning.noWeeksDesc') 'Materi dan jadwal pertemuan per minggu untuk program ini sedang disiapkan oleh tim mentor. Silakan periksa kembali secara berkala.'}}
          </p>

          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white border border-[#E2E8F0] shadow-2xs text-xs sm:text-sm text-[#475569]">
            <i class="fa-solid fa-circle-info text-[#003060]"></i>
            <span>{{default (t 'test.startLearning.noWeeksHint') 'Hubungi mentor atau admin jika memerlukan informasi lebih lanjut mengenai jadwal kelas.'}}</span>
          </div>
        </div>
      {{/if}}

      {{#if minggu.length}}
        {{!-- Pagination --}}
        <div class="w-full flex flex-row justify-between items-center px-6 sm:px-8 py-3 h-14 bg-white border border-[#D9D9D9] rounded-[16px] mt-2">
          <span
            class="font-inter font-medium text-sm leading-[17px] text-[#003060]"
            x-text="`Showing ${(weekPage - 1) * 5 + 1}-${Math.min(weekPage * 5, {{minggu.length}})} of {{minggu.length}} weeks`"
          >Showing 1-{{#if (gt minggu.length 5)}}5{{else}}{{minggu.length}}{{/if}} of {{minggu.length}} weeks</span>

          <div class="flex flex-row items-center gap-2">
            <template x-for="page in totalPages" :key="page">
              <button
                type="button"
                @click="weekPage = page"
                :class="weekPage === page
                  ? 'w-8 h-8 rounded-full bg-[#003060] text-white flex items-center justify-center font-inter font-semibold text-sm transition-opacity hover:opacity-90'
                  : 'w-8 h-8 rounded-full bg-white border border-[#D9D9D9] text-[#003060] flex items-center justify-center font-inter font-semibold text-sm transition-colors hover:bg-gray-50'"
                x-text="page"
              ></button>
            </template>
          </div>
        </div>
      {{/if}}
  </div>

  {{#if user_kelas.progress}}
    <div class="mt-6 w-full">
      {{> program_detail/right_content/portfolio}}
    </div>
  {{/if}}

  <!-- Attendance Modal & Success Popup (using existing shared partial) -->
  {{> user/sidebar_user_profile/my_learning/start_learning/attendance/edit_modal }}
</div>
