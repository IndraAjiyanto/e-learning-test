{{!--
  Panel: Start Learning (tab area student)
  Lokasi: src/views/partials/user/sidebar_user_profile/my_learning/start_learning/index.hbs
  Level: L3 Tab

  Isinya dipindahkan dari halaman landing `kelas/detail.hbs` beserta pohon
  partial `program_detail/*`, atas permintaan pemilik. Versi landing itu yang
  cocok dengan frame desain: kartu sesi dengan badge "Attendance Required",
  tombol Mark Attendance, ubin Materials terkunci, catatan alasan penguncian,
  serta baris Week Quiz. Versi backoffice sebelumnya menghitung ulang status
  buka-kunci di sisi klien dan tidak punya tugas, kuis per minggu, maupun
  portfolio.

  Susunannya mengikuti frame desain, bukan susunan landing: minggu di kolom
  kiri yang lebar, kartu program di kolom kanan. Pada halaman landing posisinya
  terbalik.

  Data dari controller fragment (courses.controller.ts):
  - course     : course yang sedang aktif
  - minggu     : hasil CoursesService.findWeeks(courseId, userId), sudah memuat
                 status buka-kunci per minggu; JANGAN dihitung ulang di template
  - user_kelas : baris user_courses untuk course ini, dipakai menampilkan portfolio
  - portfolio  : portfolio student pada course ini

  Seluruh aksi di dalamnya menuju halaman yang sudah dibungkus chrome backoffice
  (lihat partials/user/shell_frame), jadi student tidak pernah keluar ke layout
  landing. Lihat docs/user-area-learning-consolidation-plan.md.
--}}
<div class="p-4 sm:px-[34px] sm:py-[42px]">

  <div class="mb-6 flex flex-col gap-1">
    {{> components/ui/super_admin/page_header/index
      titleTag='h2'
      title=(default (t 'test.startLearning.startLearning') 'Start Learning')
    }}
    {{> components/ui/super_admin/description/index
      text=(default (t 'test.startLearning.spanStartLearning') 'Complete each week to unlock the next')
    }}
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">

    <div class="min-w-0 space-y-4">
        {{#each minggu}}
          {{#if weekProgresses.[0].process}}
            <!-- Week Design (Completed or In Progress) -->
            <div
              x-data="{
                openMinggu: localStorage.getItem(`open-minggu-{{this.id}}`) === 'true',
                sessions: localStorage.getItem(`sessions-data-{{this.id}}`) ? JSON.parse(localStorage.getItem(`sessions-data-{{this.id}}`)) : [],
                quizData: localStorage.getItem(`quiz-data-{{this.id}}`) ? JSON.parse(localStorage.getItem(`quiz-data-{{this.id}}`)) : [],
                loading: false,
                error: null,
                dataLoaded: false,

                  async init() {
          const pertemuanResponse = await fetch('/program/session/{{this.id}}');
          const quizResponse = await fetch('/program/quiz/{{this.id}}');

          this.sessions = await pertemuanResponse.json();
      localStorage.setItem(`sessions-data-{{this.id}}`, JSON.stringify(this.sessions));

          this.quizData = await quizResponse.json();
      localStorage.setItem(`quiz-data-{{this.id}}`, JSON.stringify(this.quizData));
          this.dataLoaded = true;
    },
                
                async toggleAndFetch() {
                  this.openMinggu = !this.openMinggu;
                  localStorage.setItem(`open-minggu-{{this.id}}`, this.openMinggu);
                  
                  // Fetch data hanya jika dibuka dan belum pernah di-load
                  if (this.openMinggu && !this.dataLoaded) {
                    await this.fetchData();
                  }
                },
                
                async fetchData() {
                  this.loading = true;
                  this.error = null;
                  
                  try {
                    // Fetch pertemuan dan quiz secara parallel
                    const [pertemuanResponse, quizResponse] = await Promise.all([
                      fetch('/program/session/{{this.id}}'),
                      fetch('/program/quiz/{{this.id}}')
                    ]);
                    
                    if (!pertemuanResponse.ok || !quizResponse.ok) {
                      throw new Error('Failed to fetch data');
                    }
                    
                    this.sessions = await pertemuanResponse.json();
                    this.quizData = await quizResponse.json();
                    localStorage.setItem(`sessions-data-{{this.id}}`, JSON.stringify(this.sessions));
                    localStorage.setItem(`quiz-data-{{this.id}}`, JSON.stringify(this.quizData));
                    this.dataLoaded = true;
                  } catch (err) {
                    this.error = err.message;
                    console.error('Error fetching data:', err);
                  } finally {
                    this.loading = false;
                  }
                }
              }"
              class='border border-[#E5E5E5] rounded-xl shadow-md bg-white overflow-hidden transition-all duration-300'
              x-init='init()'
            >
{{> program_detail/right_content/week/button_week}}

              <div
                x-show='openMinggu'
                x-collapse
                class='px-5 pb-5 bg-gray-50/50'
              >
                <!-- Loading State -->
                <div
                  x-show='loading'
                  class='flex items-center justify-center py-8'
                >
                  <div class='flex items-center space-x-2'>
                    <svg
                      class='animate-spin h-5 w-5 text-[#525252]'
                      xmlns='http://www.w3.org/2000/svg'
                      fill='none'
                      viewBox='0 0 24 24'
                    >
                      <circle
                        class='opacity-25'
                        cx='12'
                        cy='12'
                        r='10'
                        stroke='currentColor'
                        stroke-width='4'
                      ></circle>
                      <path
                        class='opacity-75'
                        fill='currentColor'
                        d='M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z'
                      ></path>
                    </svg>
                    <span class='text-[#525252] text-sm font-medium'>Loading
                      data...</span>
                  </div>
                </div>

                <!-- Error State -->
                <div
                  x-show='error'
                  class='mt-4 p-4 bg-red-50 border border-red-200 rounded-lg'
                >
                  <div class='flex items-center'>
                    <svg
                      class='w-5 h-5 text-red-600 mr-2'
                      fill='none'
                      stroke='currentColor'
                      viewBox='0 0 24 24'
                    >
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='2'
                        d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                      />
                    </svg>
                    <p class='text-sm text-red-800' x-text='error'></p>
                  </div>
                </div>

                <!-- Content State -->
                <div
                  x-show='!loading && !error && dataLoaded'
                  class='space-y-3 mt-4'
                >
                  <!-- Sessions List -->
                  <template
                    x-for='session in sessions'
                    :key='session.id'
                  >
                    <div>

                      <template
                        x-if='session.sessionProgress.length > 0 && session.sessionProgress[0].isAttended === true'
                      >
                        <div
                          x-data="{
    open: localStorage.getItem(`open-session-${session.id}`) === 'true'
  }"
                          @click.away='open = false; localStorage.setItem(`open-session-${session.id}`, false)'
                          class='border border-[#E5E5E5] rounded-lg shadow-md bg-white overflow-hidden'
                        >

{{> program_detail/right_content/week/session/button_session}}

                          <div
                            x-show='open'
                            x-collapse
                            class='px-4 pb-4 bg-white'
                          >
                            <!-- Attendance Check -->
                            <template x-if='session.attendances.length > 0'>
                              <div>

{{> program_detail/right_content/week/session/attendance_status}}

{{> program_detail/right_content/week/session/materi_section}}

{{> program_detail/right_content/week/session/assigment_section}}

{{> program_detail/right_content/week/session/logbook_section}}
                              </div>
                            </template>

{{> program_detail/right_content/week/session/attendance_noYet}}
                          </div>
                        </div>
                      </template>

                      
{{> program_detail/right_content/week/session/locked_session}}
                    </div>
                  </template>

{{> program_detail/right_content/week/quiz}}
                </div>
              </div>
            </div>

          {{else}}
{{> program_detail/right_content/week/locked_week}}
          {{/if}}
        {{/each}}

      {{#unless minggu.length}}
        <div class="flex flex-col items-center gap-3 rounded-xl border border-[#d9d9d9] bg-white p-12 text-center">
          <span class="grid size-14 place-items-center rounded-full bg-[#f4f7fc] text-[#003060]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/></svg>
          </span>
          <h3 class="font-montserrat text-xl font-bold text-[#003060]">No weeks yet</h3>
          <p class="font-inter text-sm text-[#737373]">Your mentor has not added the learning weeks for this program.</p>
        </div>
      {{/unless}}
    </div>

    <aside class="lg:order-2 mt-8 lg:mt-0 lg:sticky lg:top-[88px] w-full bg-white rounded-xl border border-[#E5E7EB] overflow-hidden shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)]">
        <img
          src="{{course.image}}"
          alt="{{course.name}}"
          class="w-full h-[160px] object-cover"
        >
        <div class="p-5 space-y-3">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="bg-[#CFE6F5] rounded-[6px] font-montserrat font-medium text-xs text-[#003060] px-2.5 py-1 inline-flex items-center leading-none">
              {{course.category.name}}
            </span>
          </div>
          <h2 class="font-montserrat font-semibold text-lg text-[#003060] leading-snug">
            {{course.name}}
          </h2>
          <p class="font-sans font-normal text-xs leading-relaxed text-[#6B7280] line-clamp-4">
            {{getByLang course.description lang}}
          </p>
          {{!-- Titik masuk per-course. Sebelumnya tersebar di pohon sidebar, yang
               tidak ada pada frame desain; kartu inilah tempat navigasi per-course
               menurut desain. Handler-nya sama persis dengan yang dipakai pohon
               lama, jadi logika fragment dan buka-kunci sesi tidak berubah. --}}
          <div class="flex flex-col gap-2 pt-2">
            <button type="button" @click="toggleActiveSection('presentation')" class="w-full h-11 rounded-lg border border-[#d4d4d4] bg-white text-[#344054] hover:bg-[#f9fafb] font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer">
              <i class="fa-solid fa-display"></i> Presentation
            </button>
            <button type="button" @click="toggleActiveSection('assignment')" class="w-full h-11 rounded-lg border border-[#d4d4d4] bg-white text-[#344054] hover:bg-[#f9fafb] font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer">
              <i class="fa-solid fa-list-check"></i> Assignment
            </button>
            <button type="button" @click="toggleActiveSection('quiz')" class="w-full h-11 rounded-lg border border-[#d4d4d4] bg-white text-[#344054] hover:bg-[#f9fafb] font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer">
              <i class="fa-solid fa-circle-question"></i> Quiz
            </button>
            <button type="button" @click="toggleActiveSection('certificate')" class="w-full h-11 rounded-lg border border-[#d4d4d4] bg-white text-[#344054] hover:bg-[#f9fafb] font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer">
              <i class="fa-solid fa-award"></i> Certificate
            </button>
            <button type="button" @click="toggleActiveSection('group-class')" class="w-full h-11 rounded-lg bg-[#7C3AED] hover:bg-[#6D28D9] text-white font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer">
              <i class="fa-solid fa-users"></i> Join Group
            </button>
            <button type="button" @click="toggleActiveSection('logbook')" class="w-full h-11 rounded-lg border border-[#0369A1] text-[#0369A1] hover:bg-[#E0F2F9] font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer">
              <i class="fa-regular fa-clipboard"></i> My Logbook
            </button>
            {{!-- Controller courses dipasang di prefix "program" DAN rutenya sendiri
                 bernama "program/detail/:courseId", jadi path lengkapnya berulang.
                 Tautan lama /program/detail/:id selalu 404. --}}
            <a href="/program/program/detail/{{course.id}}" class="w-full h-11 rounded-lg bg-[#003060] hover:bg-[#001f3f] text-white font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer no-underline">
              <i class="fa-regular fa-file-lines"></i> Detail Program
            </a>
          </div>
        </div>
      </aside>

  </div>

  {{#if user_kelas.progress}}
    <div class="mt-6">
      {{> program_detail/right_content/portfolio}}
    </div>
  {{/if}}
</div>
