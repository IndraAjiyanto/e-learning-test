{{!--
  Panel: Start Learning (tab area student - UI/UX)
  Lokasi: src/views/partials/user/sidebar_user_profile/my_learning/start_learning/index.hbs
  Level: L3 Tab
  Referensi Figma: node-id=1496-1317 (Learning workspace & schedule)
--}}

{{!-- Progress summary metadata for test runner & accessibility --}}
{{#if progress.totalWeeks}}
  <div class="sr-only" role="progressbar" aria-valuenow="{{progress.percent}}" aria-valuemin="0" aria-valuemax="100">
    {{progress.completedWeeks}} of {{progress.totalWeeks}} weeks completed ({{progress.percent}}%)
  </div>
{{/if}}

{{!-- Learning workspace --}}
<div class="w-full max-w-[1268px] mx-auto flex flex-col items-start mt-8 rounded-2xl gap-[18px] py-5 bg-white font-inter">

  {{!-- Learning schedule --}}
  <div class="w-full flex flex-col items-start gap-6">

    {{#if minggu.length}}
      {{#each minggu}}
        {{#if weekProgresses.[0].process}}
          {{!-- Week item (Unlocked & Open) --}}
          <div
            x-data="{
              openMinggu: localStorage.getItem(`open-minggu-{{this.id}}`) !== null
                ? localStorage.getItem(`open-minggu-{{this.id}}`) === 'true'
                : {{#if (eq @index 0)}}true{{else}}false{{/if}},
              sessions: localStorage.getItem(`sessions-data-{{this.id}}`) ? JSON.parse(localStorage.getItem(`sessions-data-{{this.id}}`)) : [],
              quizData: localStorage.getItem(`quiz-data-{{this.id}}`) ? JSON.parse(localStorage.getItem(`quiz-data-{{this.id}}`)) : [],
              loading: false,
              error: null,
              dataLoaded: false,

              async init() {
                this.loading = true;
                try {
                  const [pertemuanResponse, quizResponse] = await Promise.all([
                    fetch('/program/session/{{this.id}}'),
                    fetch('/program/quiz/{{this.id}}')
                  ]);
                  if (pertemuanResponse.ok) {
                    this.sessions = await pertemuanResponse.json();
                    localStorage.setItem(`sessions-data-{{this.id}}`, JSON.stringify(this.sessions));
                  }
                  if (quizResponse.ok) {
                    this.quizData = await quizResponse.json();
                    localStorage.setItem(`quiz-data-{{this.id}}`, JSON.stringify(this.quizData));
                  }
                } catch (e) {
                  console.error('Error fetching week data:', e);
                  this.error = e.message;
                } finally {
                  this.loading = false;
                  this.dataLoaded = true;
                }
              },

              toggle() {
                this.openMinggu = !this.openMinggu;
                localStorage.setItem(`open-minggu-{{this.id}}`, this.openMinggu);
              }
            }"
            id="week-{{this.id}}"
            class="w-full bg-white border border-[#E6ECF7] rounded-[14px] shadow-[0px_8px_28px_rgba(43,74,122,0.07)] overflow-hidden transition-all"
          >
            {{!-- Week header --}}
            <button
              type="button"
              @click="toggle()"
              :aria-expanded="openMinggu"
              class="w-full flex flex-row items-center px-6 sm:px-8 py-5 sm:h-[108px] gap-6 text-left cursor-pointer bg-white transition-colors hover:bg-[#F8FAFC]"
            >
              {{!-- Status icon --}}
              <div class="w-12 h-12 rounded-full bg-[#E9F0FF] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#6682B5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                </svg>
              </div>

              {{!-- Week details --}}
              <div class="flex flex-col items-start gap-[7px] flex-1 min-w-0">
                <span class="font-inter font-semibold text-base leading-5 text-[#17345E] truncate">
                  {{t 'test.startLearning.week'}} {{this.weekNumber}}
                </span>
                <span class="font-inter font-normal text-[13px] leading-4 text-[#8091B1] truncate">
                  {{#if this.description}}{{this.description}}{{else}}Requirement{{/if}}
                </span>
              </div>

              {{!-- chevron-up / chevron-down --}}
              <div class="w-4 h-4 flex items-center justify-center shrink-0">
                <svg
                  :class="openMinggu ? 'rotate-180' : ''"
                  class="w-4 h-4 text-[#4D6EF3] transition-transform duration-200"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M6 9l6 6 6-6"></path>
                </svg>
              </div>
            </button>

            {{!-- Divider --}}
            <div x-show="openMinggu" class="w-full h-[1px] bg-[#E6ECF7]"></div>

            {{!-- Dropdown content --}}
            <div x-show="openMinggu" x-collapse class="w-full flex flex-col items-start px-6 sm:px-8 pt-6 pb-7 gap-5 bg-white">
              {{!-- Loading State --}}
              <div x-show="loading" class="w-full flex items-center justify-center py-6">
                <div class="flex items-center space-x-2 text-[#525252] text-sm font-medium">
                  <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24" fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <span>Loading data...</span>
                </div>
              </div>

              {{!-- Dynamic Sessions List --}}
              <template x-for="session in sessions" :key="session.id">
                <div class="w-full flex flex-col items-start gap-5">
                  {{!-- Session info --}}
                  <div class="w-full flex flex-col items-start gap-2.5">
                    {{!-- Session header --}}
                    <div class="w-full flex flex-row items-center justify-between gap-3">
                      {{!-- Session title --}}
                      <div class="flex flex-col items-start gap-1 flex-1 min-w-0">
                        <a
                          :href="'/program/session/detail/' + session.id"
                          class="font-inter font-bold text-[15px] leading-[18px] text-[#17345E] hover:text-[#003060] transition-colors truncate"
                          x-text="session.topic || ('Session ' + session.sessionOrder + ' - Fundamental of UI/UX')"
                        ></a>
                        <div class="flex flex-row items-center gap-1.5 flex-wrap">
                          <svg class="w-3.5 h-3.5 text-[#8091B1] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                          </svg>
                          <span class="font-inter font-normal text-[13px] leading-4 text-[#8091B1]" x-text="session.date ? new Date(session.date).toLocaleDateString('en-GB') : '24/08/2026'">24/08/2026</span>
                          <span class="text-[#8091B1] mx-1">·</span>
                          <svg class="w-3.5 h-3.5 text-[#8091B1] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                          </svg>
                          <span class="font-inter font-normal text-[13px] leading-4 text-[#8091B1]" x-text="(session.startTime && session.endTime) ? (session.startTime + ' - ' + session.endTime) : '09:00:00 - 16:00:00'">09:00:00 - 16:00:00</span>
                        </div>
                      </div>

                      {{!-- Attendance badge --}}
                      <template x-if="!session.attendances || session.attendances.length === 0">
                        <div class="flex flex-row items-center px-3 py-[5px] h-[25px] bg-[#FDECEA] rounded-full shrink-0">
                          <span class="font-inter font-semibold text-xs leading-[15px] text-[#E05A5A] whitespace-nowrap">
                            Attendance Required
                          </span>
                        </div>
                      </template>
                      <template x-if="session.attendances && session.attendances.length > 0">
                        <div class="flex flex-row items-center px-3 py-[5px] h-[25px] bg-[#EAF7EE] rounded-full shrink-0">
                          <span class="font-inter font-semibold text-xs leading-[15px] text-[#15803D] whitespace-nowrap">
                            Attended
                          </span>
                        </div>
                      </template>
                    </div>

                    {{!-- Mark Attendance button --}}
                    <template x-if="!session.attendances || session.attendances.length === 0">
                      <a
                        :href="'/attendance/form/' + session.id"
                        class="w-full h-12 flex flex-row justify-center items-center py-3.5 px-6 gap-2.5 bg-[#1C2D4A] hover:bg-[#15233a] rounded-[10px] text-white font-inter font-bold text-[15px] leading-[18px] transition-colors no-underline cursor-pointer"
                      >
                        <svg class="w-5 h-5 text-white shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                          <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>Mark Attendance</span>
                      </a>
                    </template>
                    <template x-if="session.attendances && session.attendances.length > 0">
                      <div class="w-full h-12 flex flex-row justify-center items-center py-3.5 px-6 gap-2.5 bg-[#F0FDF4] border border-[#BBF7D0] rounded-[10px] text-[#15803D] font-inter font-bold text-[15px] leading-[18px]">
                        <svg class="w-5 h-5 text-[#15803D] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                          <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>Attendance Recorded</span>
                      </div>
                    </template>

                    {{!-- Materials section --}}
                    <div class="w-full flex flex-col items-start gap-3">
                      <div class="w-full flex flex-row items-center gap-2 h-[17px]">
                        <template x-if="!session.attendances || session.attendances.length === 0">
                          <svg class="w-4 h-4 text-[#8091B1] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                          </svg>
                        </template>
                        <template x-if="session.attendances && session.attendances.length > 0">
                          <svg class="w-4 h-4 text-[#17345E] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                          </svg>
                        </template>
                        <span class="font-inter font-semibold text-sm leading-[17px] text-[#17345E]" x-text="(!session.attendances || session.attendances.length === 0) ? 'Materials (Locked)' : 'Materials'"></span>
                      </div>

                      {{!-- Material items (PDF, Video, PPT) --}}
                      <div class="w-full flex flex-col sm:flex-row items-stretch sm:items-start gap-3">
                        {{!-- PDF --}}
                        <a
                          :href="(session.attendances && session.attendances.length > 0) ? ('/learning-material/pdf/' + session.id) : '#'"
                          :class="(session.attendances && session.attendances.length > 0) ? 'hover:border-[#1C2D4A] hover:bg-[#EEF1F8] cursor-pointer' : 'cursor-default'"
                          class="flex-1 h-[117px] bg-[#F6F8FB] border border-[#E6ECF7] rounded-[10px] py-4 px-3 flex flex-col justify-center items-center gap-2.5 transition-colors no-underline"
                        >
                          <div class="w-9 h-9 bg-[#EEF1F8] rounded-lg flex items-center justify-center shrink-0">
                            <svg class="w-[18px] h-[18px] text-[#8091B1]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                              <polyline points="14 2 14 8 20 8"></polyline>
                              <line x1="16" y1="13" x2="8" y2="13"></line>
                              <line x1="16" y1="17" x2="8" y2="17"></line>
                              <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                          </div>
                          <span class="font-inter font-medium text-xs leading-[15px] text-[#8091B1]">PDF</span>
                          <div class="w-3.5 h-3.5 flex items-center justify-center">
                            <template x-if="!session.attendances || session.attendances.length === 0">
                              <svg class="w-3.5 h-3.5 text-[#B0BDD4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                              </svg>
                            </template>
                            <template x-if="session.attendances && session.attendances.length > 0">
                              <svg class="w-3.5 h-3.5 text-[#15803D]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                              </svg>
                            </template>
                          </div>
                        </a>

                        {{!-- Video --}}
                        <a
                          :href="(session.attendances && session.attendances.length > 0) ? ('/learning-material/video/' + session.id) : '#'"
                          :class="(session.attendances && session.attendances.length > 0) ? 'hover:border-[#1C2D4A] hover:bg-[#EEF1F8] cursor-pointer' : 'cursor-default'"
                          class="flex-1 h-[117px] bg-[#F6F8FB] border border-[#E6ECF7] rounded-[10px] py-4 px-3 flex flex-col justify-center items-center gap-2.5 transition-colors no-underline"
                        >
                          <div class="w-9 h-9 bg-[#EEF1F8] rounded-lg flex items-center justify-center shrink-0">
                            <svg class="w-[18px] h-[18px] text-[#8091B1]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <polygon points="23 7 16 12 23 17 23 7"></polygon>
                              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                            </svg>
                          </div>
                          <span class="font-inter font-medium text-xs leading-[15px] text-[#8091B1]">Video</span>
                          <div class="w-3.5 h-3.5 flex items-center justify-center">
                            <template x-if="!session.attendances || session.attendances.length === 0">
                              <svg class="w-3.5 h-3.5 text-[#B0BDD4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                              </svg>
                            </template>
                            <template x-if="session.attendances && session.attendances.length > 0">
                              <svg class="w-3.5 h-3.5 text-[#15803D]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="5 3 19 12 5 21 5 3"></polygon>
                              </svg>
                            </template>
                          </div>
                        </a>

                        {{!-- PPT --}}
                        <a
                          :href="(session.attendances && session.attendances.length > 0) ? ('/learning-material/ppt/' + session.id) : '#'"
                          :class="(session.attendances && session.attendances.length > 0) ? 'hover:border-[#1C2D4A] hover:bg-[#EEF1F8] cursor-pointer' : 'cursor-default'"
                          class="flex-1 h-[117px] bg-[#F6F8FB] border border-[#E6ECF7] rounded-[10px] py-4 px-3 flex flex-col justify-center items-center gap-2.5 transition-colors no-underline"
                        >
                          <div class="w-9 h-9 bg-[#EEF1F8] rounded-lg flex items-center justify-center shrink-0">
                            <svg class="w-[18px] h-[18px] text-[#8091B1]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M2 3h20"></path>
                              <path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"></path>
                              <path d="m7 21 5-5 5 5"></path>
                            </svg>
                          </div>
                          <span class="font-inter font-medium text-xs leading-[15px] text-[#8091B1]">PPT</span>
                          <div class="w-3.5 h-3.5 flex items-center justify-center">
                            <template x-if="!session.attendances || session.attendances.length === 0">
                              <svg class="w-3.5 h-3.5 text-[#B0BDD4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                              </svg>
                            </template>
                            <template x-if="session.attendances && session.attendances.length > 0">
                              <svg class="w-3.5 h-3.5 text-[#15803D]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                              </svg>
                            </template>
                          </div>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </template>

              {{!-- Explicit Fallback Mockup when sessions empty --}}
              <template x-if="dataLoaded && (!sessions || sessions.length === 0)">
                <div class="w-full flex flex-col items-start gap-5">
                  <div class="w-full flex flex-col items-start gap-2.5">
                    <div class="w-full flex flex-row items-center justify-between gap-3">
                      <div class="flex flex-col items-start gap-1 flex-1 min-w-0">
                        <span class="font-inter font-bold text-[15px] leading-[18px] text-[#17345E] truncate">
                          Session 1 - Fundamental of UI/UX
                        </span>
                        <div class="flex flex-row items-center gap-1.5 flex-wrap">
                          <svg class="w-3.5 h-3.5 text-[#8091B1] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                          </svg>
                          <span class="font-inter font-normal text-[13px] leading-4 text-[#8091B1]">24/08/2026</span>
                          <span class="text-[#8091B1] mx-1">·</span>
                          <svg class="w-3.5 h-3.5 text-[#8091B1] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                          </svg>
                          <span class="font-inter font-normal text-[13px] leading-4 text-[#8091B1]">09:00:00 - 16:00:00</span>
                        </div>
                      </div>
                      <div class="flex flex-row items-center px-3 py-[5px] h-[25px] bg-[#FDECEA] rounded-full shrink-0">
                        <span class="font-inter font-semibold text-xs leading-[15px] text-[#E05A5A] whitespace-nowrap">
                          Attendance Required
                        </span>
                      </div>
                    </div>

                    <button
                      type="button"
                      class="w-full h-12 flex flex-row justify-center items-center py-3.5 px-6 gap-2.5 bg-[#1C2D4A] hover:bg-[#15233a] rounded-[10px] text-white font-inter font-bold text-[15px] leading-[18px] transition-colors cursor-pointer"
                    >
                      <svg class="w-5 h-5 text-white shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                      </svg>
                      <span>Mark Attendance</span>
                    </button>

                    <div class="w-full flex flex-col items-start gap-3">
                      <div class="w-full flex flex-row items-center gap-2 h-[17px]">
                        <svg class="w-4 h-4 text-[#8091B1] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <span class="font-inter font-semibold text-sm leading-[17px] text-[#17345E]">Materials (Locked)</span>
                      </div>
                      <div class="w-full flex flex-col sm:flex-row items-stretch sm:items-start gap-3">
                        <div class="flex-1 h-[117px] bg-[#F6F8FB] border border-[#E6ECF7] rounded-[10px] p-3 flex flex-col justify-center items-center gap-2.5">
                          <div class="w-9 h-9 bg-[#EEF1F8] rounded-lg flex items-center justify-center shrink-0">
                            <svg class="w-[18px] h-[18px] text-[#8091B1]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                              <polyline points="14 2 14 8 20 8"></polyline>
                              <line x1="16" y1="13" x2="8" y2="13"></line>
                              <line x1="16" y1="17" x2="8" y2="17"></line>
                              <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                          </div>
                          <span class="font-inter font-medium text-xs leading-[15px] text-[#8091B1]">PDF</span>
                          <svg class="w-3.5 h-3.5 text-[#B0BDD4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                          </svg>
                        </div>
