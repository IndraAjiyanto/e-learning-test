{{! --- START LEARNING MAIN CONTAINER --- }}
<div 
  class="space-y-8 sm:space-y-10 md:space-y-12 font-montserrat bg-[#FAFAFA] p-5"
  x-data="{
    activeMateri: null,
    openWeek: null,
    selectedMaterial: null,
    showMaterialModal: false,
    showLogbookModal: false,
    logbookSessionId: null,
    logbookForm: {
      title: '',
      notes: '',
      date: new Date().toISOString().split('T')[0]
    },
    sessions: [],
    sessionsLoading: false,
    sessionsError: false,
    loadedWeekId: null,
    async loadSessions(weekId) {
      this.loadedWeekId = weekId;
      this.sessions = [];
      this.sessionsError = false;
      this.sessionsLoading = true;
      try {
        const res = await fetch('/program/session/' + weekId);
        if (!res.ok) throw new Error('Request failed');
        const data = await res.json();
        if (this.loadedWeekId !== weekId) return;
        this.sessions = Array.isArray(data) ? data : [];
      } catch (e) {
        if (this.loadedWeekId !== weekId) return;
        this.sessionsError = true;
      } finally {
        if (this.loadedWeekId === weekId) this.sessionsLoading = false;
      }
    },
    // Unlock/attendance/logbook status is derived from the single shared
    // helper (Alpine.store('sessionUnlock')) — see PRD-sequential-session-unlock.md.
    // No unlock condition is written here; these are thin delegations.
    logbookProcess(session) {
      return Alpine.store('sessionUnlock').logbookProcessOf(session);
    },
    logbookStatusText(session) {
      const process = this.logbookProcess(session);
      if (process === 'process') return 'Logbook is being reviewed';
      if (process === 'rejected') return 'Logbook has been rejected';
      if (process === 'approved') return 'The logbook has been approved';
      return 'Logbook';
    },
    logbookButtonColorClass(session) {
      const process = this.logbookProcess(session);
      if (process === 'process') return 'bg-[#FEEFD6] text-[#FDA40B] border border-[#FDA40B]';
      if (process === 'rejected') return 'bg-[#FEE7E7] border border-red-700 text-red-700';
      if (process === 'approved') return 'bg-[#E5F6D4] border border-[#12BD26] text-[#12BD26]';
      return 'bg-[#003060] hover:bg-[#002244] text-white';
    },
    isSessionAttended(session) {
      return Alpine.store('sessionUnlock').isAttended(session);
    },
    logbookDone(session) {
      return Alpine.store('sessionUnlock').logbookApproved(session);
    },
    canOpenNextSession(session) {
      return Alpine.store('sessionUnlock').canOpenNextSession(session);
    },
    isSessionUnlocked(index) {
      return Alpine.store('sessionUnlock').isSessionUnlocked(this.sessions, this.sessions[index]);
    },
    startLearningStatus(index) {
      return Alpine.store('sessionUnlock').getStartLearningStatus(this.sessions, this.sessions[index]);
    },
    startLearningLockedMessage(index) {
      return this.startLearningStatus(index) === 'WAITING_FOR_ATTENDANCE'
        ? 'Isi Attendance terlebih dahulu.'
        : 'Selesaikan sesi sebelumnya terlebih dahulu.';
    },
    isWeekQuizUnlocked(weekId) {
      if (this.loadedWeekId !== weekId || this.sessionsLoading || this.sessionsError) return false;
      return Alpine.store('sessionUnlock').isWeekQuizUnlocked(this.sessions);
    }
  }"
  x-init="$watch('showLogbookModal', value => document.body.classList.toggle('overflow-hidden', value))"
>

  {{! --- DASHBOARD UTAMA START LEARNING --- }}
  <div x-show="!activeMateri" class="space-y-8 sm:space-y-10 md:space-y-12">

    {{! --- HEADER SECTION --- }}
  <div class="space-y-3">
    {{!-- Breadcrumb sesuai frame desain: My Learning / Start Learning. --}}
    <nav aria-label="Breadcrumb" class="mb-2 flex items-center gap-2 font-inter text-sm text-[#737373]">
      <button type="button" @click="toggleActiveSection('learning')" class="inline-flex items-center gap-1.5 transition-colors hover:text-[#003060]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/></svg>
        My Learning
      </button>
      <span aria-hidden="true">/</span>
      <span class="inline-flex items-center gap-1.5 font-medium text-[#003060]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
        Start Learning
      </span>
    </nav>
    <h1 class="font-montserrat font-semibold text-2xl sm:text-3xl text-[#003060] leading-none">
      Start Learning
    </h1>
    <p class="font-sans font-normal text-sm sm:text-base text-[#003060] leading-none">
      Complete each week to unlock the next
    </p>
  </div>

  {{! --- Two-column layout matching the Figma "View Program" reference:
       week list as the main (left) column, a compact sticky program card on the right
       with the image, badges, description and 3 stacked action buttons. --- }}
  <div class="lg:grid lg:grid-cols-[1fr_320px] lg:gap-8 lg:items-start">

  {{! --- WEEK SECTIONS (looped: the first week is always unlocked; any later week unlocks only when a WeekProgress row exists for it and the current user) --- }}
  <div class="lg:order-1 space-y-6">
  {{#each course.weeks}}
  <div class="space-y-6 {{#unless @first}}pt-2 border-t border-slate-200{{/unless}}">

    <!-- Week Header (flex justify-between, font-montserrat font-semibold text-2xl text-[#003060] + icon 35x35) -->
    <button
      type="button"
      @click="if (openWeek === {{weekNumber}}) { openWeek = null } else { openWeek = {{weekNumber}}; {{#if (or (weekUnlocked weekProgresses) @first)}}loadSessions('{{id}}'){{/if}} }"
      class="w-full flex items-center justify-between text-left cursor-pointer select-none py-2 group focus:outline-none"
    >
      <div class="flex items-center gap-3">
        <h3 class="font-montserrat font-semibold text-lg sm:text-xl text-[#003060] group-hover:text-[#002244] transition-colors">
          Week {{weekNumber}} : {{description}}
        </h3>
        {{#unless (or (weekUnlocked weekProgresses) @first)}}
          <span class="bg-[#F3F4F6] border border-[#D1D5DB] rounded-[12px] px-3 py-0.5 font-sans font-medium text-xs text-[#6B7280]">
            Locked
          </span>
        {{/unless}}
      </div>
      <div class="w-[35px] h-[35px] flex items-center justify-center text-[#003060] transition-transform duration-300 flex-shrink-0" :class="openWeek === {{weekNumber}} ? '' : 'rotate-180'">
        <i class="fa-solid fa-chevron-up text-lg"></i>
      </div>
    </button>

    {{#if (or (weekUnlocked weekProgresses) @first)}}
    <!-- Unlocked Week Collapsible Content -->
    <div x-show="openWeek === {{weekNumber}}" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" class="space-y-4" style="display: none;">

      <!-- SESSION CARDS (fetched from GET /program/session/:weeksId; a session unlocks only when the previous one has sessionProgress.isAttended === true AND sessionProgress.logbook === true for the current user) -->

      <!-- Sessions Loading State -->
      <template x-if="openWeek === {{weekNumber}} && sessionsLoading">
        <div class="w-full bg-white border border-[#E5E7EB] rounded-[12px] p-6 text-center shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition">
          <div class="w-8 h-8 border-2 border-[#003060] border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
          <p class="font-montserrat font-medium text-sm sm:text-base text-[#003060]">Loading sessions...</p>
        </div>
      </template>

      <!-- Sessions Error State -->
      <template x-if="openWeek === {{weekNumber}} && !sessionsLoading && sessionsError">
        <div class="w-full bg-white border border-[#E5E7EB] rounded-[12px] p-6 text-center shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition space-y-3">
          <p class="font-montserrat font-medium text-sm sm:text-base text-red-600">Failed to load sessions. Please try again.</p>
          <button type="button" @click="loadSessions('{{id}}')" class="font-montserrat font-medium text-sm sm:text-base text-[#003060] underline cursor-pointer">
            Retry
          </button>
        </div>
      </template>

      <!-- Sessions Empty State -->
      <template x-if="openWeek === {{weekNumber}} && !sessionsLoading && !sessionsError && sessions.length === 0">
        <div class="w-full bg-white border border-[#E5E7EB] rounded-[12px] p-6 text-center shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition">
          <p class="font-montserrat font-medium text-sm sm:text-base text-[#003060]">No sessions available for this week.</p>
        </div>
      </template>

      <!-- Session Cards -->
      <template x-for="(session, sIndex) in (openWeek === {{weekNumber}} ? sessions : [])" :key="session.id">
        <div>
          <!-- Unlocked Session Card (Active Session with Details & Materials): shown once this session's own attendance is filled (ALLOWED) or fully done (COMPLETED) -->
          <template x-if="startLearningStatus(sIndex) === 'ALLOWED' || startLearningStatus(sIndex) === 'COMPLETED'">
            <div x-data="{ open: false }" class="w-full bg-white border border-[#E5E7EB] rounded-[12px] p-5 sm:p-6 space-y-6 shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition">

              <!-- Session Header: Title + Logbook Button (Top Right) -->
              <div class="flex items-start justify-between gap-4">
                <div class="space-y-7">
                  <!-- Title (Montserrat 600, 20px, #003060, 100% line-height) -->
                  <h4 class="font-montserrat font-semibold text-base text-[#003060] leading-none" x-text="'Session ' + session.sessionOrder + ' : ' + session.topic"></h4>

                  <!-- Date & Time Meta Details (Open Sans 400, 20px, #003060, 100% line-height) -->
                  <div class="space-y-4 pt-1 font-['Open_Sans'] font-normal text-sm text-[#003060] leading-none">
                    <div class="flex items-center gap-2">
                      <i class="fa-regular fa-calendar text-sm"></i>
                      <span x-text="session.date ? new Date(session.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '-'"></span>
                    </div>
                    <div class="flex items-center gap-2">
                      <i class="fa-regular fa-clock text-sm"></i>
                      <span x-text="(session.startTime || '-') + ' - ' + (session.endTime || '-') + ' WIB'"></span>
                    </div>
                  </div>

                  <!-- Attendance Recorded Badge (178x24px, radius 12px, bg #E5F6D4, border 1px #12BD26) -->
                  <div class="pt-1" x-show="isSessionAttended(session)">
                    <span class="w-auto sm:w-[178px] h-[24px] bg-[#E5F6D4] border border-[#12BD26] rounded-[12px] px-3 font-sans font-normal text-xs sm:text-sm text-[#12BD26] inline-flex items-center justify-center leading-none">
                      <span>Attendance Recorded</span>
                    </span>
                  </div>
                </div>

                <div class="flex items-center gap-3 flex-shrink-0">
                  <!-- '+ Logbook' Action Button (Top Right, Montserrat 500, 20px) -->
                  <button
                    type="button"
                    @click="if (logbookProcess(session) === 'approved') { window.location.href = '/logbooks/' + session.logbooks[0].id } else if (logbookProcess(session) === 'process' || logbookProcess(session) === 'rejected') { window.location.href = '/logbooks/formEdit/' + session.logbooks[0].id } else { showLogbookModal = true; logbookSessionId = session.id }"
                    :class="logbookButtonColorClass(session)"
                    class="rounded-[6px] hover:shadow-sm transition-shadow px-4 py-2.5 flex items-center justify-center gap-2 font-montserrat font-medium text-sm leading-none cursor-pointer flex-shrink-0"
                  >
                    <i class="fa-solid fa-plus text-sm sm:text-base" x-show="!logbookProcess(session)"></i>
                    <span x-text="logbookStatusText(session)">Logbook</span>
                  </button>

                  <!-- Session Dropdown Toggle (mirrors the Week header chevron) -->
                  <button
                    type="button"
                    @click="open = !open"
                    class="w-[35px] h-[35px] flex items-center justify-center text-[#003060] transition-transform duration-300 flex-shrink-0 cursor-pointer"
                    :class="open ? '' : 'rotate-180'"
                    aria-label="Toggle session details"
                  >
                    <i class="fa-solid fa-chevron-up text-lg"></i>
                  </button>
                </div>
              </div>

              <!-- Materials Section -->
              <div
                x-show="open"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 -translate-y-2"
                x-transition:enter-end="opacity-100 translate-y-0"
                class="pt-2 space-y-7"
              >
                <!-- Materials Heading (Montserrat 500, 20px, #003060) -->
                <h5 class="font-montserrat font-semibold text-sm text-[#003060] leading-none">
                  Materials
                </h5>

                <div class="space-y-12 pl-1">
                  <!-- Material Item 1: Pdf Material -->
                  <div class="space-y-4">
                    <span class="font-montserrat font-medium text-sm text-[#003060] block leading-none">
                      Click the material for today's session:
                    </span>
                    <template x-if="session.materials && session.materials.find(m => m.fileType === 'pdf')">
                      <a
                        href="javascript:void(0)"
                        @click="selectedMaterial = session; activeMateri = 'pdf'"
                        class="font-montserrat font-normal text-sm text-[#003060] underline hover:text-[#001f3f] transition-colors inline-block cursor-pointer leading-none"
                        x-text="session.materials.find(m => m.fileType === 'pdf').title || ('Materi ' + (session.topic || ('Session ' + session.sessionOrder)))"
                      ></a>
                    </template>
                    <template x-if="!(session.materials && session.materials.find(m => m.fileType === 'pdf'))">
                      <span class="font-montserrat font-normal text-sm text-[#666666] block leading-none">
                        No PDF material available
                      </span>
                    </template>
                  </div>

                  <!-- Material Item 2: Video Lessons -->
                  <div class="space-y-4">
                    <span class="font-montserrat font-medium text-sm text-[#003060] block leading-none">
                      Click the lesson video for today's session:
                    </span>
                    <template x-if="session.materials && session.materials.find(m => m.fileType === 'video')">
                      <a
                        href="javascript:void(0)"
                        @click="selectedMaterial = session; activeMateri = 'video'"
                        class="font-montserrat font-normal text-sm text-[#003060] underline hover:text-[#001f3f] transition-colors inline-block cursor-pointer leading-none"
                        x-text="session.materials.find(m => m.fileType === 'video').title || ('Video ' + (session.topic || ('Session ' + session.sessionOrder)))"
                      ></a>
                    </template>
                    <template x-if="!(session.materials && session.materials.find(m => m.fileType === 'video'))">
                      <span class="font-montserrat font-normal text-sm text-[#666666] block leading-none">
                        No Video material available
                      </span>
                    </template>
                  </div>

                  <!-- Material Item 3: PPT Material -->
                  <div class="space-y-4">
                    <span class="font-montserrat font-medium text-sm text-[#003060] block leading-none">
                      Click the PowerPoint presentation for today's session:
                    </span>
                    <template x-if="session.materials && session.materials.find(m => m.fileType === 'ppt')">
                      <a
                        href="javascript:void(0)"
                        @click="selectedMaterial = session; activeMateri = 'ppt'"
                        class="font-montserrat font-normal text-sm text-[#003060] underline hover:text-[#001f3f] transition-colors inline-block cursor-pointer leading-none"
                        x-text="session.materials.find(m => m.fileType === 'ppt').title || ('PPT ' + (session.topic || ('Session ' + session.sessionOrder)))"
                      ></a>
                    </template>
                    <template x-if="!(session.materials && session.materials.find(m => m.fileType === 'ppt'))">
                      <span class="font-montserrat font-normal text-sm text-[#666666] block leading-none">
                        No PPT material available
                      </span>
                    </template>
                  </div>
                </div>
              </div>

            </div>
          </template>

          <!-- Waiting-for-attendance Session Bar: session is unlocked but this session's own attendance hasn't been filled yet (PRD §5.3/§7.3) -->
          <template x-if="startLearningStatus(sIndex) === 'WAITING_FOR_ATTENDANCE'">
            <div class="w-full min-h-[54px] px-5 sm:px-6 py-3 bg-white rounded-[12px] border border-[#E5E7EB] shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition flex items-center justify-between gap-4">
              <div class="space-y-1">
                <h4 class="font-montserrat font-semibold text-base sm:text-xl text-[#003060] leading-none" x-text="session.topic || ('Session ' + session.sessionOrder)"></h4>
                <p class="font-sans font-normal text-xs sm:text-sm text-[#FDA40B] leading-none" x-text="startLearningLockedMessage(sIndex)"></p>
              </div>
              <div class="text-[#FDA40B] flex items-center justify-center flex-shrink-0" title="Waiting for attendance">
                <i class="fa-regular fa-clock text-xl"></i>
              </div>
            </div>
          </template>

          <!-- Locked Session Bar (Locked Bar Layout Matching Figma) -->
          <template x-if="startLearningStatus(sIndex) === 'LOCKED'">
            <div class="w-full min-h-[54px] px-5 sm:px-6 py-3 bg-white rounded-[12px] border border-[#E5E7EB] shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition flex items-center justify-between gap-4">
              <div class="space-y-1">
                <h4 class="font-montserrat font-semibold text-base sm:text-xl text-[#003060] leading-none" x-text="session.topic || ('Session ' + session.sessionOrder)"></h4>
                <p class="font-sans font-normal text-xs sm:text-sm text-[#6B7280] leading-none" x-text="startLearningLockedMessage(sIndex)"></p>
              </div>
              <div class="text-[#003060] flex items-center justify-center flex-shrink-0" title="Locked">
                <img src="/public/image/user_profile/lock.svg" alt="Locked Session" class="w-6 h-6 object-contain">
              </div>
            </div>
          </template>
        </div>
      </template>

      <!-- QUIZ BOX (centered title + lock icon at the far right edge matching Figma; disabled until every session in this week is attended AND logbook-approved) -->
      <button
        type="button"
        @click="if (isWeekQuizUnlocked('{{id}}')) { window.location.href = '{{#if quiz.[0].id}}/quiz/start/{{quiz.[0].id}}{{else}}#{{/if}}' }"
        :class="isWeekQuizUnlocked('{{id}}') ? 'cursor-pointer' : 'cursor-not-allowed'"
        class="relative w-full h-11 rounded-[12px] px-5 sm:px-6 bg-[#D9D9D980] border-[0.1px] border-[#D9D9D980] backdrop-blur-[6.6px] flex items-center justify-center gap-3 transition-all group mt-4"
      >
        <div class="w-6 h-6 flex items-center justify-center text-[#00000080] flex-shrink-0">
          <i class="fa-solid fa-file-pen text-base"></i>
        </div>
        <span class="font-montserrat font-medium text-sm text-[#00000080]">
          Quiz Week {{weekNumber}}
        </span>
        <div x-show="!isWeekQuizUnlocked('{{id}}')" class="absolute right-5 sm:right-6 text-[#003060] flex items-center justify-center flex-shrink-0" title="Locked">
          <img src="/public/image/user_profile/lock.svg" alt="Locked Session" class="w-6 h-6 object-contain">
        </div>
      </button>

    </div>
    {{else}}
    <!-- Locked Week Collapsible Content -->
    <div x-show="openWeek === {{weekNumber}}" x-transition class="space-y-4" style="display: none;">
      <div class="p-6 bg-white rounded-[12px] border border-[#E5E7EB] shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition text-center space-y-2">
        <div class="w-12 h-12 bg-[#003060]/10 rounded-full flex items-center justify-center mx-auto text-[#003060] mb-2">
          <i class="fa-solid fa-lock text-xl"></i>
        </div>
        <h4 class="font-montserrat font-semibold text-lg text-[#003060]">
          Week {{weekNumber}} is Currently Locked
        </h4>
        <p class="font-sans font-normal text-sm sm:text-base text-slate-600 max-w-md mx-auto">
          Please complete all sessions and submit the previous week's quiz to unlock this week's lessons and materials.
        </p>
      </div>
    </div>
    {{/if}}

  </div>
  {{/each}}
  </div>

  {{! --- PROGRAM SIDEBAR CARD (right column on desktop, matches Figma "View Program" reference) --- }}
  <aside class="lg:order-2 mt-8 lg:mt-0 lg:sticky lg:top-[88px] w-full bg-white rounded-xl border border-[#E5E7EB] overflow-hidden shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)]">
    <img
      src="{{course.image}}"
      alt="{{course.name}}"
      class="w-full h-[160px] object-cover"
    >
    <div class="p-5 space-y-3">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="bg-[#CFE6F5] rounded-[6px] font-montserrat font-medium text-xs text-[#003060] px-2.5 py-1 inline-flex items-center leading-none">
          {{course.category.name}}
        </span>
      </div>
      <h2 class="font-montserrat font-semibold text-lg text-[#003060] leading-snug">
        {{course.name}}
      </h2>
      <p class="font-sans font-normal text-xs leading-relaxed text-[#6B7280] line-clamp-4">
        {{getByLang course.description lang}}
      </p>
      {{!-- Titik masuk per-course. Sebelumnya tersebar di pohon sidebar, yang
           tidak ada pada frame desain; kartu inilah tempat navigasi per-course
           menurut desain. Handler-nya sama persis dengan yang dipakai pohon
           lama, jadi logika fragment dan buka-kunci sesi tidak berubah. --}}
      <div class="flex flex-col gap-2 pt-2">
        <button type="button" @click="toggleActiveSection('presentation')" class="w-full h-11 rounded-lg border border-[#d4d4d4] bg-white text-[#344054] hover:bg-[#f9fafb] font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer">
          <i class="fa-solid fa-display"></i> Presentation
        </button>
        <button type="button" @click="toggleActiveSection('assignment')" class="w-full h-11 rounded-lg border border-[#d4d4d4] bg-white text-[#344054] hover:bg-[#f9fafb] font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer">
          <i class="fa-solid fa-list-check"></i> Assignment
        </button>
        <button type="button" @click="toggleActiveSection('quiz')" class="w-full h-11 rounded-lg border border-[#d4d4d4] bg-white text-[#344054] hover:bg-[#f9fafb] font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer">
          <i class="fa-solid fa-circle-question"></i> Quiz
        </button>
        <button type="button" @click="toggleActiveSection('certificate')" class="w-full h-11 rounded-lg border border-[#d4d4d4] bg-white text-[#344054] hover:bg-[#f9fafb] font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer">
          <i class="fa-solid fa-award"></i> Certificate
        </button>
        <button type="button" @click="toggleActiveSection('group-class')" class="w-full h-11 rounded-lg bg-[#7C3AED] hover:bg-[#6D28D9] text-white font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer">
          <i class="fa-solid fa-users"></i> Join Group
        </button>
        <button type="button" @click="toggleActiveSection('logbook')" class="w-full h-11 rounded-lg border border-[#0369A1] text-[#0369A1] hover:bg-[#E0F2F9] font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer">
          <i class="fa-regular fa-clipboard"></i> My Logbook
        </button>
        {{!-- Controller courses dipasang di prefix "program" DAN rutenya sendiri
             bernama "program/detail/:courseId", jadi path lengkapnya berulang.
             Tautan lama /program/detail/:id selalu 404. --}}
        <a href="/program/program/detail/{{course.id}}" class="w-full h-11 rounded-lg bg-[#003060] hover:bg-[#001f3f] text-white font-montserrat font-medium text-sm flex items-center justify-center gap-2 transition cursor-pointer no-underline">
          <i class="fa-regular fa-file-lines"></i> Detail Program
        </a>
      </div>
    </div>
  </aside>

  </div>
  {{! --- END DASHBOARD UTAMA START LEARNING --- }}

  {{! --- MATERI PDF TAB CONTENT --- }}
  <div x-show="activeMateri === 'pdf'" x-cloak style="display: none;" class="!mt-0">
    {{> user/sidebar_user_profile/my_learning/start_learning/materi/pdf/index }}
  </div>

  {{! --- MATERI VIDEO TAB CONTENT --- }}
  <div x-show="activeMateri === 'video'" x-cloak style="display: none;" class="!mt-0">
    {{> user/sidebar_user_profile/my_learning/start_learning/materi/video/index }}
  </div>

  {{! --- MATERI PPT TAB CONTENT --- }}
  <div x-show="activeMateri === 'ppt'" x-cloak style="display: none;" class="!mt-0">
    {{> user/sidebar_user_profile/my_learning/start_learning/materi/ppt/index }}
  </div>


  {{! --- LOGBOOK FORM POPUP MODAL --- }}
  <div 
    x-cloak
    style="display: none;"
    x-show="showLogbookModal" 
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 sm:p-6 overflow-y-auto"
    @keydown.escape.window="showLogbookModal = false"
  >
    <div 
      @click.away="showLogbookModal = false"
      class="bg-white rounded-[12px] p-6 sm:p-8 md:p-10 max-w-4xl w-full shadow-2xl font-montserrat relative border border-slate-200"
    >
      <!-- Close Button (Top Right) -->
      <button 
        type="button" 
        @click="showLogbookModal = false"
        class="absolute top-6 right-6 w-10 h-10 rounded-full flex items-center justify-center text-slate-500 hover:text-[#003060] hover:bg-slate-100 transition-all cursor-pointer"
        aria-label="Close modal"
      >
        <i class="fa-solid fa-xmark text-2xl"></i>
      </button>

      <!-- Modal Title Header -->
      <h2 class="font-montserrat font-semibold text-2xl sm:text-3xl text-[#003060] leading-none mb-8 text-left">
        Logbook Form
      </h2>

      <!-- Form Content -->
      <form
        :action="'/logbooks/' + logbookSessionId"
        method="POST"
        enctype="multipart/form-data"
        class="space-y-8"
      >
        
        <!-- Two-Column Grid Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
          
          <!-- LEFT COLUMN -->
          <div class="space-y-6">
            
            <!-- Field Group 1: Activity -->
            <div class="space-y-2">
              <label class="block font-montserrat font-medium text-sm sm:text-base text-[#003060] leading-none">
                Activity
              </label>
              <input
                type="text"
                name="activity"
                required
                placeholder="Enter activity description..."
                class="w-full h-[45px] rounded-[6px] px-4 bg-white border border-slate-300 font-montserrat font-medium text-sm sm:text-lg text-slate-800 placeholder:text-black/50 placeholder:font-montserrat placeholder:font-medium placeholder:text-lg focus:outline-none focus:border-[#003060] focus:ring-1 focus:ring-[#003060] transition-colors"
              >
            </div>

            <!-- Field Group 2: Activity Details -->
            <div class="space-y-2">
              <label class="block font-montserrat font-medium text-sm sm:text-base text-[#003060] leading-none">
                Activity Details
              </label>
              <textarea
                rows="6"
                name="activityDetails"
                required
                placeholder="Enter detailed description of your activity..."
                class="w-full h-[180px] rounded-[6px] p-4 bg-white border border-slate-300 font-montserrat font-medium text-sm sm:text-lg text-slate-800 placeholder:text-black/50 placeholder:font-montserrat placeholder:font-medium placeholder:text-lg focus:outline-none focus:border-[#003060] focus:ring-1 focus:ring-[#003060] resize-none transition-colors"
              ></textarea>
            </div>

          </div>

          <!-- RIGHT COLUMN -->
          <div class="space-y-6">
            
            <!-- Field Group 3: Obstacles -->
            <div class="space-y-2">
              <label class="block font-montserrat font-medium text-sm sm:text-base text-[#003060] leading-none">
                Obstacles
              </label>
              <input
                type="text"
                name="obstacles"
                required
                placeholder="Enter any obstacles faced..."
                class="w-full h-[45px] rounded-[6px] px-4 bg-white border border-slate-300 font-montserrat font-medium text-sm sm:text-lg text-slate-800 placeholder:text-black/50 placeholder:font-montserrat placeholder:font-medium placeholder:text-lg focus:outline-none focus:border-[#003060] focus:ring-1 focus:ring-[#003060] transition-colors"
              >
            </div>

            <!-- Field Group 4: Photo Documentation -->
            <div class="space-y-2" x-data="{ fileName: '' }">
              <label class="block font-montserrat font-medium text-sm sm:text-base text-[#003060] leading-none">
                Photo Documentation
              </label>
              <div class="relative w-full h-[45px] bg-white border border-slate-300 rounded-[6px] p-1 flex items-center gap-3">
                <label class="bg-[#E2E8F0] hover:bg-slate-300 text-[#003060] font-montserrat font-medium text-xs sm:text-sm px-3 py-1.5 rounded-[4px] cursor-pointer transition-colors flex-shrink-0 select-none">
                  Choose File
                  <input
                    type="file"
                    name="documentation"
                    accept="image/*"
                    class="hidden"
                    @change="fileName = $event.target.files[0] ? $event.target.files[0].name : ''"
                  >
                </label>
                <span 
                  class="font-montserrat font-medium text-xs sm:text-lg text-black/50 truncate"
                  x-text="fileName || 'No file chosen'"
                ></span>
              </div>
            </div>

            <!-- Field Group 5: Link Documentation -->
            <div class="space-y-2">
              <label class="block font-montserrat font-medium text-sm sm:text-base text-[#003060] leading-none">
                Link Documentation
              </label>
              <input
                type="url"
                name="otherDocumentation"
                required
                placeholder="Enter Link Documentation"
                class="w-full h-[45px] rounded-[6px] px-4 bg-white border border-slate-300 font-montserrat font-medium text-sm sm:text-lg text-slate-800 placeholder:text-black/50 placeholder:font-montserrat placeholder:font-medium placeholder:text-lg focus:outline-none focus:border-[#003060] focus:ring-1 focus:ring-[#003060] transition-colors"
              >
            </div>

          </div>

        </div>

        <!-- BUTTONS ROW -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-6">
          <!-- Save Button -->
          <button 
            type="submit" 
            class="w-full sm:w-auto flex-1 max-w-[280px] h-[50px] bg-[#003060] hover:bg-[#002244] border border-[#003060] rounded-[6px] shadow-[0_0_4px_rgba(0,0,0,0.5)] px-6 font-montserrat font-medium text-sm text-white text-center transition-all cursor-pointer"
          >
            Save
          </button>

          <!-- Cancel Button -->
          <button 
            type="button" 
            @click="showLogbookModal = false"
            class="w-full sm:w-auto flex-1 max-w-[280px] h-[50px] bg-white hover:bg-slate-50 border border-[#003060] rounded-[6px] shadow-[0_0_4px_rgba(0,0,0,0.25)] px-6 font-montserrat font-medium text-sm text-[#003060] text-center transition-all cursor-pointer"
          >
            Cancel
          </button>
        </div>

      </form>
    </div>
  </div>

</div>

{{!-- Penutup untuk <div> pembungkus di baris 2. Sebelumnya tidak ada, sehingga
     seluruh panel tab yang berada SETELAH #start-learning-container di shell
     ikut tersarang di dalamnya saat HTML diurai. Begitu loadCourseFragment
     mengganti isi kontainer itu, panel Presentation, My Logbook, Assignment,
     Quiz, Certificate, dan Join Group Class ikut terhapus, dan setiap sub-menu
     My Learning menampilkan halaman kosong. --}}
</div>
