{{! --- MY LEARNING CONTENT PARTIAL --- }}
{{!--
  Tab: My Learning list (Figma 830:8684). Reskin 2026-09-15: dropped "Recent Activity",
  "Stats", "Completed Learning" and "Learning This Week" sections - none of that existed in
  Figma and all of it was hardcoded fake data (fixed numbers, a fake course, a made-up bar
  chart), not wired to anything real. Kept the header, search+filter bar, and program card
  grid, all of which use real `course`/`category` data from the controller.
--}}
<div class="space-y-14 font-montserrat bg-[#FAFAFA] p-5">

  {{! --- HEADER SECTION --- }}
  <div>
    <h1 class="font-montserrat font-semibold text-2xl sm:text-3xl md:text-4xl text-[#003060] leading-none mb-[15px]">
      My Learning
    </h1>
    <p class="font-montserrat font-normal text-base sm:text-lg md:text-xl text-[#003060] leading-none">
      Continue your learning journey and track your progress.
    </p>
  </div>

  {{! --- SEARCH & FILTER BAR SECTION --- }}
  <div class="flex flex-col md:flex-row items-stretch md:items-center gap-[25px]">

    <!-- Search Input -->
    <div class="w-full md:w-[320px] h-11 bg-white rounded-md flex items-center gap-[15px] px-4 border border-slate-200/80 hover:shadow-sm transition-shadow">
      <i class="fa-solid fa-magnifying-glass text-[#003060] text-sm flex-shrink-0"></i>
      <input
        type="text"
        placeholder="Search learning"
        class="w-full bg-transparent font-montserrat font-medium text-sm text-black placeholder:text-[#676767] focus:outline-none"
      >
    </div>

    <!-- Dropdown All Programs -->
    <div class="relative w-full md:w-[254px]" x-data="{ open: false, selected: 'All Programs', options: ['All Programs'{{#each category}}, '{{this.name}}'{{/each}}] }">
      <input type="hidden" name="program_filter" :value="selected">
      <button
        type="button"
        @click="open = !open"
        @click.outside="open = false"
        class="w-full h-11 bg-white rounded-md flex justify-between items-center px-4 border border-slate-200/80 hover:shadow-sm transition-shadow cursor-pointer"
        :aria-expanded="open"
      >
        <span class="font-montserrat font-medium text-sm text-[#666666] truncate pr-2" x-text="selected"></span>
        <i class="fa-solid fa-chevron-down text-[#003060] text-sm transition-transform duration-200 flex-shrink-0" :class="open ? 'rotate-180' : ''"></i>
      </button>
      <ul
        x-show="open"
        x-transition
        class="absolute left-0 right-0 top-full mt-2 bg-white rounded-xl shadow-lg border border-[#E2E8F0] p-2 z-50 font-montserrat max-h-60 overflow-y-auto"
        style="display: none;"
      >
        <template x-for="option in options" :key="option">
          <li
            @click="selected = option; open = false"
            class="px-4 py-3 rounded-lg text-sm sm:text-base font-medium cursor-pointer transition-colors text-slate-700 hover:bg-[#E0F1F9]/50 hover:text-[#003060] flex items-center justify-between"
            :class="selected === option ? 'text-[#003060] bg-[#003060]/10 font-semibold' : ''"
          >
            <span x-text="option"></span>
            <i x-show="selected === option" class="fa-solid fa-check text-sm text-[#003060]"></i>
          </li>
        </template>
      </ul>
    </div>

    <!-- Dropdown All Method -->
    <div class="relative w-full md:w-[254px]" x-data="{ open: false, selected: 'All Method' }">
      <input type="hidden" name="method_filter" :value="selected">
      <button
        type="button"
        @click="open = !open"
        @click.outside="open = false"
        class="w-full h-11 bg-white rounded-md flex justify-between items-center px-4 border border-slate-200/80 hover:shadow-sm transition-shadow cursor-pointer"
        :aria-expanded="open"
      >
        <span class="font-montserrat font-medium text-sm text-[#666666] truncate pr-2" x-text="selected"></span>
        <i class="fa-solid fa-chevron-down text-[#003060] text-sm transition-transform duration-200 flex-shrink-0" :class="open ? 'rotate-180' : ''"></i>
      </button>
      <ul
        x-show="open"
        x-transition
        class="absolute left-0 right-0 top-full mt-2 bg-white rounded-xl shadow-lg border border-[#E2E8F0] p-2 z-50 font-montserrat max-h-60 overflow-y-auto"
        style="display: none;"
      >
        <template x-for="option in ['All Method', 'Offline', 'Online', 'Hybrid']" :key="option">
          <li
            @click="selected = option; open = false"
            class="px-4 py-3 rounded-lg text-sm sm:text-base font-medium cursor-pointer transition-colors text-slate-700 hover:bg-[#E0F1F9]/50 hover:text-[#003060] flex items-center justify-between"
            :class="selected === option ? 'text-[#003060] bg-[#003060]/10 font-semibold' : ''"
          >
            <span x-text="option"></span>
            <i x-show="selected === option" class="fa-solid fa-check text-sm text-[#003060]"></i>
          </li>
        </template>
      </ul>
    </div>

  </div>

  {{! --- PROGRAM CARDS SECTION --- }}
  <div>
    <div class="mb-5 flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="font-montserrat text-xl font-bold text-[#003060] sm:text-2xl">
        Learning Path
      </h2>
      {{!-- Penghitung program, sesuai frame desain. Angkanya dari jumlah course
           yang benar-benar diikuti, bukan angka tetap. --}}
      <span class="font-inter text-sm text-[#737373]">
        Showing {{course.length}} of {{course.length}} programs available.
      </span>
    </div>

    {{#if course.length}}
      <div class="grid grid-cols-1 sm:grid-cols-2 2xl:grid-cols-3 xl:grid-cols-4 gap-6 xl:gap-[29px]">
        {{#each course}}
        <div class="w-full max-w-[300px] min-h-[386px] bg-[#E0F1F9] rounded-xl shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition p-[13px] flex flex-col justify-between gap-[12px] mx-auto sm:mx-0">
          <div class="flex flex-col gap-[12px]">
            <!-- Badge -->
            <div class="w-fit px-2 h-[23px] bg-[#0B1F3B1A]/10 rounded-md flex items-center justify-center">
              <span class="font-montserrat font-medium text-xs text-[#003060]">{{this.category.name}}</span>
            </div>
            <!-- Image -->
            <img
              src="{{this.image}}"
              alt="{{this.name}}"
              onerror="this.onerror=null;this.src='/public/image/dashboard/bgHeroSection.png'"
              class="w-full h-[138px] rounded-xl object-cover"
            >
            <!-- Course Title -->
            <h3 class="font-montserrat font-semibold text-base text-[#003060]">
              {{this.name}}
            </h3>
            <!-- Tag Row -->
            <div class="flex items-center gap-[6px] flex-wrap">
              {{#if this.method}}
              <span class="bg-[#CFE6F5] rounded-md px-2 py-1 flex items-center gap-1 font-montserrat font-medium text-xs text-[#003060]">
                <i class="fa-solid fa-location-dot text-xs"></i>
                {{this.method}}
              </span>
              {{/if}}
              <span class="bg-[#CFE6F5] rounded-md px-2 py-1 flex items-center gap-1 font-montserrat font-medium text-xs text-[#003060]">
                <i class="fa-solid fa-graduation-cap text-xs"></i>
                {{this.weeks.length}} Weeks
              </span>
            </div>
          </div>
          <!-- Button -->
          <a
            {{!-- Tujuan Start Learning DI DALAM shell, bukan halaman program publik.
                 Sebelumnya /program/{{this.id}}, yang dirender tanpa bareShell sehingga
                 student mendapat navbar dan footer landing di tengah area backoffice.
                 Breadcrumb "My Learning / Start Learning" pada frame desain memang
                 menunjukkan tujuannya tetap di dalam shell. --}}
            href="/program/myProgram/{{../user.id}}?courseId={{this.id}}"
            class="w-full h-[39px] rounded-[12px] p-[10px] gap-[10px] border border-[#003060] bg-transparent flex items-center justify-center font-montserrat font-medium text-[#003060] hover:bg-[#003060] hover:text-white transition-all cursor-pointer"
          >
            <span class="text-sm sm:text-base lg:text-xl sm:leading-none">Continue</span>
            <i class="fa-solid fa-arrow-right text-sm"></i>
          </a>
        </div>
        {{/each}}
      </div>
    {{else}}
      <div class="flex flex-col items-center gap-3 rounded-2xl border border-[#E5E7EB] bg-white py-14 text-center">
        <span class="grid size-14 place-items-center rounded-full bg-[#E0F2F9] text-[#003060]">
          <i class="fa-solid fa-book-open text-xl"></i>
        </span>
        <p class="max-w-sm font-montserrat text-sm text-[#6B7280]">You're not enrolled in any program yet. Browse our programs to get started.</p>
      </div>
    {{/if}}
  </div>

</div>
