<!-- ===================== TAB KELAS ===================== -->
<div x-show="tab === 'kelas'" class='space-y-4'>
  <div class='flex justify-between items-center mb-4'>
    <h3 class='text-lg font-semibold text-gray-800'>Classes in this Category</h3>
    <a
      href='/kelass/formCreate/{{kategori.id}}'
      class='bg-gray-900 text-white px-4 py-2 rounded-lg shadow hover:bg-gray-600 transition'
    >
      Add Class
    </a>
  </div>

  {{#if kategori.kelas}}
    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4'>
      {{#each kategori.kelas}}
        <div
          class='bg-white border border-gray-200 rounded-lg shadow-md overflow-hidden hover:shadow-lg transition'
        >
          <div class='p-4'>
            <div class='flex items-center mb-3'>
              <img
                src='{{this.gambar}}'
                alt='{{this.nama_kelas}}'
                class='w-12 h-12 rounded-lg object-cover mr-3'
              />
              <div>
                <h4
                  class='font-semibold text-gray-800 text-sm'
                >{{this.nama_kelas}}</h4>
                <p
                  class='text-xs text-gray-500'
                >{{this.jenis_kelas.nama_jenis_kelas}}</p>
              </div>
            </div>
            <p
              class='text-xs text-gray-700 mb-3 line-clamp-2'
            >{{this.deskripsi}}</p>
            <div class='flex justify-between items-center'>
              <span class='text-xs text-gray-500'>{{this.metode}}</span>
              <a
                href='/kelass/{{this.id}}'
                class='text-xs text-blue-600 hover:text-blue-800 font-medium'
              >
                View Details →
              </a>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class='text-center py-8'>
      <svg
        class='mx-auto h-12 w-12 text-gray-400'
        fill='none'
        stroke='currentColor'
        viewBox='0 0 24 24'
      >
        <path
          stroke-linecap='round'
          stroke-linejoin='round'
          stroke-width='2'
          d='M12 6v6m0 0v6m0-6h6m-6 0H6'
        ></path>
      </svg>
      <h3 class='mt-2 text-sm font-medium text-gray-900'>No classes</h3>
      <p class='mt-1 text-sm text-gray-500'>Get started by creating a new class.</p>
      <div class='mt-6'>
        <a
          href='/kelass/formCreate?kategori={{kategori.id}}'
          class='inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-gray-900 hover:bg-gray-700'
        >
          <svg
            class='-ml-1 mr-2 h-5 w-5'
            fill='none'
            stroke='currentColor'
            viewBox='0 0 24 24'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M12 6v6m0 0v6m0-6h6m-6 0H6'
            ></path>
          </svg>
          Add Class
        </a>
      </div>
    </div>
  {{/if}}
</div>