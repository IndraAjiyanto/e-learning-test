    <!-- ===================== TAB ALUMNI ===================== -->
<div x-show="tab === 'alumni'" x-data="alumniData()" x-init="fetchAlumni()">

    <!-- Header: Search + Add -->
    <div class="mb-6 flex flex-col md:flex-row md:justify-between md:items-center gap-4">
      <div class="flex items-center gap-3">
        <!-- Search -->
        <div class="relative w-full md:w-64">
          <button
            @click="search = searchInput; pageNumber=0"
            class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-900">
            <svg xmlns="http://www.w3.org/2000/svg"
                 class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1110.5 3a7.5 7.5
                       0 016.15 13.65z" />
            </svg>
          </button>
          <input
            type="text"
            placeholder="Search alumni..."
            x-model="searchInput"
            @input="search = searchInput; pageNumber=0"
            class="border border-gray-300 bg-white text-gray-900 rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-gray-900 w-full"
          />
        </div>


      </div>
    </div>

    <!-- Table -->
    <div x-show="data && data.length > 0" class="overflow-x-auto bg-white shadow-lg rounded-xl">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-100">
          <tr>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">No</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Profile</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Name</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Message</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Alumni Status</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Current Position</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Program</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <template x-for="(alumni,index) in filteredData" :key="alumni.id">
          <tr class="hover:bg-gray-50 transition">
            <td class="px-6 py-4 text-sm text-gray-800" x-text="pageNumber * size + index + 1"></td>
            <td class="px-6 py-4 text-sm text-gray-800">
              <img :src="alumni.foto" :alt="alumni.nama" class="w-10 h-10 rounded-full object-cover">
            </td>
            <td class="px-6 py-4 text-sm text-gray-800">
              <template x-for="nama in alumni.nama" :key="nama">
              <div x-text="nama"></div>
              </template>
            </td>
            <td class="px-6 py-4 text-sm text-gray-800">
              <template x-for="pesan in alumni.pesan" :key="pesan">
              <div x-text="pesan.length > 50 ? pesan.substring(0, 50) + '...' : pesan"></div>
              </template>
            </td>
            <td class="px-6 py-4 text-sm text-gray-800">
              <template x-for="alumniStatus in alumni.alumni" :key="alumniStatus">
                <div x-text="alumniStatus"></div>
                </template>
            </td>
            <td class="px-6 py-4 text-sm text-gray-800">
              <template x-for="posisi in alumni.posisi_sekarang" :key="posisi">
                <div x-text="posisi">
                </div>
              </template>
            </td>
            <td class="px-6 py-4 text-sm text-gray-800" x-text="alumni.kelas.nama_kelas">
            </td>
          </tr>
          </template>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="w-full md:w-1/2 mx-auto py-6 flex justify-center gap-2 items-center"
         x-show="pageCount() > 1">
      <button @click="prevPage" :disabled="pageNumber==0"
        class="px-3 py-1 rounded border border-gray-900 text-gray-900"
        :class="{ 'opacity-50 cursor-not-allowed': pageNumber==0 }">Prev</button>

      <template x-for="(page,index) in pages()" :key="index">
        <button @click="viewPage(index)"
          class="px-3 py-1 rounded"
          :class="{ 'bg-gray-900 text-white font-bold': index===pageNumber }"
          x-text="index+1"></button>
      </template>

      <button @click="nextPage" :disabled="pageNumber >= pageCount()-1"
        class="px-3 py-1 rounded border border-gray-900 text-gray-900"
        :class="{ 'opacity-50 cursor-not-allowed': pageNumber >= pageCount()-1 }">Next</button>
    </div>

</div>

<script>
    function alumniData() {
  return {
    data: JSON.parse(localStorage.getItem('activeData')) || [],
    searchInput: "",
    search: "",
    pageNumber: 0,
    size: 10,
    amount: 0,

        async fetchAlumni() {
      const res = await fetch('/kategoris/alumni/{{kategori.id}}');
      this.data = await res.json();
      localStorage.setItem('activeData', JSON.stringify(this.data));
    },


    get filteredData() {
      let filtered = this.data.filter(a =>
        (`${a.nama} ${a.pesan} ${a.alumni} ${a.posisi_sekarang} ${a.kelas.nama_kelas}`).toLowerCase()
          .includes(this.search.toLowerCase())
      );
      this.amount = filtered.length;

      const start = this.pageNumber * this.size;
      return filtered.slice(start, start + this.size);
    },


    pages() { return Array.from({ length: this.pageCount() }); },
    pageCount() { return Math.ceil(this.amount / this.size); },
    nextPage() { if (this.pageNumber < this.pageCount()-1) this.pageNumber++; },
    prevPage() { if (this.pageNumber > 0) this.pageNumber--; },
    viewPage(index) { this.pageNumber = index; },


  }
}
</script>