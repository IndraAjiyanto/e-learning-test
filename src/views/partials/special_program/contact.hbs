<section class='w-full py-20 bg-[#FAFAFA]'>
  <div class='container mx-auto px-4'>
    
    <div class='max-w-2xl mx-auto text-center'>
      
      <!-- Judul (Diubah menjadi text-3xl md:text-4xl font-semibold) -->
      <h2 class='text-3xl md:text-4xl font-semibold font-montserrat leading-tight'>
        <span style="color: #6EB6E5;">Transform</span> <span style="color: #0B1F3B;">Your Team Today</span>
      </h2>
      
      <!-- Deskripsi -->
      <p class='text-[16px] md:text-[17px] mt-3 mb-10' style="color: #1F2937; font-family: 'Open Sans', sans-serif;">
        Get a customized training proposal for your organization
      </p>
      <!-- Tombol WhatsApp dengan Style Hero -->
      <div class='flex justify-center' 
           x-data="{
               formatWa(nomor) {
                   if (!nomor) return '';
                   nomor = nomor.replace(/\D/g, ''); 
                   if (nomor.startsWith('0')) return '62' + nomor.slice(1);
                   if (nomor.startsWith('8')) return '62' + nomor;
                   if (nomor.startsWith('62')) return nomor;
                   return nomor;
               }
           }">
        
        <a :href="'https://wa.me/' + formatWa('08123456789')" target="_blank"
           class='group inline-flex items-center justify-center gap-3.5 bg-[#093F74] hover:bg-[#06284B] text-white px-24 py-6 rounded-lg font-semibold text-[17px] transition-all duration-300 shadow-md hover:shadow-xl'>
          
          <!-- Icon Telepon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform group-hover:scale-110 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          
          <!-- Teks Tombol -->
          <span>Contact Us</span>
        </a>
      </div>
      
    </div>
  </div>
</section>