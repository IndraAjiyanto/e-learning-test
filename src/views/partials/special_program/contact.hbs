<section class='py-20 bg-gradient-to-br from-primary via-secondary to-gray-800'>
  <div class='container mx-auto px-4'>
    <div class='max-w-4xl mx-auto'>
      <div
        class='bg-white/5 backdrop-blur-lg rounded-3xl p-12 border border-white/20'
      >
        <div class='text-center'>
          <h2
            class='text-4xl font-bold text-white mb-6 font-montserrat'
          >
            {{t "test.specialProgram.contactSection.tittle"}}
          </h2>
          <p class='text-xl text-gray-100 mb-8 '>
            {{t "test.specialProgram.contactSection.description"}}
          </p>

          <div class='flex flex-col sm:flex-row gap-4 justify-center' 
          x-data="{
    formatWa(nomor) {
        if (!nomor) return '';
        nomor = nomor.replace(/\D/g, ''); // hapus selain angka

        if (nomor.startsWith('0')) {
            return '62' + nomor.slice(1);
        }

        if (nomor.startsWith('62')) {
            return nomor;
        }

        return nomor;
    }
}">
           
            <a
              :href="'https://wa.me/' + formatWa('{{kategori.contact}}')" target="_blank"
              class='btn btn-lg border-0 bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white rounded-xl font-semibold text-base hover:shadow-2xl transform hover:-translate-y-1 transition-all'
            >
              {{t "test.specialProgram.contactSection.buttonContactUs"}}
              <i class='fas fa-phone'></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>