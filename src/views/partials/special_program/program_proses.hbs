{{#if flow_category.length}}
<section class='py-20 bg-gray-50'>
  <div class='container mx-auto px-4'>
    <div class='text-center mb-16'>
      <h2 class='text-4xl font-bold text-gray-900 mb-4 font-montserrat'>{{t "test.specialProgram.programProses.title"}}</h2>
      <p class='text-gray-600 text-lg '>{{flow_category.length}} {{t "test.specialProgram.programProses.description"}}</p>
    </div>

    <div class='max-w-5xl mx-auto'>
      <div class='grid md:grid-cols-4 gap-8'>
        {{#each flow_category}}
        <div class='text-center'>
          <div class='w-20 h-20 bg-white border-2 border-slate-800 rounded-full flex items-center justify-center mx-auto mb-4'>
            <span class='text-2xl font-bold text-slate-800'>{{this.number}}</span>
          </div>
          <h3 class='text-xl font-bold text-gray-900 mb-3 font-montserrat'>{{getByLang this.title ../lang}}</h3>
          <p class='text-gray-600 '>{{getByLang this.description ../lang}}</p>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>
{{/if}}