<section class='relative pt-20 pb-48 min-h-screen bg-[linear-gradient(180deg,_#FAFAFA_0%,_#CEE5F6_50%,_#FAFAFA_95%)] overflow-hidden justify-center items-center flex'>
  <div
    class="absolute top-24 inset-x-12 bottom-12 bg-cover bg-center bg-no-repeat rounded-2xl"
    style="background-image: url('/public/image/Frame-1618876030.png'); z-index: 0; background-position: center top;"
  ></div>

  <div class=' w-full relative z-10'>
    <div class='max-w-6xl flex flex-col md:flex-row md:gap-12 items-center justify-between px-2'>

     

      <!-- Text Content (Left) -->
      <div class="px-20 w-full text-center md:text-left">
        <div class="inline-flex items-center gap-3 rounded-full bg-secondary/10 px-5 py-2">
  <i class="fa-solid fa-graduation-cap text-secondary text-2xl"></i>
  <span class="text-secondary text-2xl font-semibold">
    {{t 'test.specialProgram.heroSection.enrollmentOpen'}}
  </span>
</div>
        <h1 class='text-5xl md:text-6xl font-semibold text-white mb-6 mt-8 font-montserrat leading-tight'>
          {{kategori.nama_kategori}}
        </h1>
        <p class='text-5xl md:text-6xl text-secondary font-semibold mb-4'>
          {{getByLang kategori.text lang}}
        </p>
        <p class='text-base text-white max-w-sm'>
          {{getByLang kategori.deskripsi lang}}
        </p>
        <div class="mt-7 flex flex-col md:flex-row items-center md:items-start gap-6">
        <button
          onclick="document.getElementById('programs').scrollIntoView({ behavior: 'smooth', block: 'start' })"
          class='btn border-0 hover:bg-slate-50 inline-block bg-secondary text-white hover:text-slate-900 px-5 py-1 rounded-xl font-light text-lg hover:shadow-2xl transform hover:-translate-y-1 transition-all'
        >
          {{t "test.specialProgram.heroSection.buttonExploreLearningPath"}}
          <i class='fas fa-arrow-down text-xs'></i>
        </button>
         <a
          href="/dashboard/about"
          class='btn text-lg bg-transparent text-white border-2 border-white px-10 py-2 rounded-xl hover:bg-slate-900 hover:text-white transition-all duration-300 transform hover:-translate-y-1 font-bold uppercase tracking-widest text-sm w-full md:w-auto text-center'
        >
        <i class="fa-solid fa-headset"></i>
          {{t 'test.home.heroSection.buttonConsultation'}}
        </a>
        </div>
      </div>

     

    </div>
  </div>

</section>
