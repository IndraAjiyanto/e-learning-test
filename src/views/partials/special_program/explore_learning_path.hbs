<section
  class='py-20 px-6 lg:px-20 bg-transparant relative overflow-hidden'
>
  <!-- Background decorative elements -->
 

  <div class='max-w-7xl mx-auto relative z-10'>
    <div class="flex justify-center">
      <svg 
  xmlns="http://www.w3.org/2000/svg" 
  viewBox="0 0 100 100" 
  fill="currentColor" 
  class="w-16 h-16 text-slate-900"
>
  <defs>
    <!-- Masking untuk memotong elemen belakang agar memiliki "gap" transparan dengan elemen depan -->
    <mask id="front-person-mask">
      <rect width="100" height="100" fill="white" />
      
      <!-- Potongan untuk Kepala Tengah (Radius kepala 12 + Gap 4 = 16) -->
      <circle cx="50" cy="38" r="16" fill="black" />
      
      <!-- Potongan untuk Badan Tengah -->
      <path d="M 27 72 L 27 68 A 23 16 0 0 1 73 68 L 73 72" fill="none" stroke="black" stroke-width="8" stroke-linecap="butt" />
    </mask>
  </defs>

  <!-- LAPISAN BELAKANG: 2 Orang (Kiri & Kanan) - Terpotong otomatis oleh mask -->
  <g mask="url(#front-person-mask)">
    <!-- Kepala -->
    <circle cx="31" cy="46" r="9" />
    <circle cx="69" cy="46" r="9" />
    <!-- Badan (Kurva melengkung ke luar) -->
    <path d="M 10 68 A 20 18 0 0 1 30 50 H 45 V 68 Z" />
    <path d="M 90 68 A 20 18 0 0 0 70 50 H 55 V 68 Z" />
  </g>

  <!-- LAPISAN DEPAN: 1 Orang (Tengah) - Ditampilkan utuh di atas -->
  <!-- Kepala (Bentuk Donat / Berlubang) -->
  <path fill-rule="evenodd" clip-rule="evenodd" d="M 50 26 a 12 12 0 1 0 0 24 a 12 12 0 1 0 0 -24 z m 0 7.5 a 4.5 4.5 0 1 1 0 9 a 4.5 4.5 0 1 1 0 -9 z" />
  <!-- Badan (Melengkung dengan potongan melengkung di bagian bawah) -->
  <path d="M 27 68 A 23 16 0 0 1 73 68 H 59 A 9 6 0 0 0 41 68 Z" />
</svg>
    </div>
    <!-- Header -->
    <div class='text-center mb-16'>
      <h2
        class='text-4xl md:text-4xl font-bold text-gray-900 leading-tight font-montserrat mb-8'
      >
        {{{t 'test.specialProgram.exploreLearningPath.title'}}}
      </h2>
      <p class="text-gray-900">
        {{{t 'test.specialProgram.exploreLearningPath.description'}}}
      </p>
    </div>

   
    <div class='text-center'>
      <a
        href='#programs'
        class='inline-flex items-center gap-3 bg-secondary text-white font-bold px-10 py-4 rounded-lg hover:bg-secondary transition-all duration-300 transform hover:-translate-y-1 shadow-xl text-lg'
      >
        
        {{t 'test.specialProgram.exploreLearningPath.button'}}
        <i class='fas fa-arrow-up'></i>
      </a>
    </div>
  </div>
</section>
