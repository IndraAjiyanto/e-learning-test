<section id="schedule-fees" class="py-16 bg-gray-50/50">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-10">
      <div class="flex items-center justify-center mx-auto rounded-full border border-[#003060] bg-[#6EB6E5]/20 text-[#003060] font-semibold text-lg font-montserrat" style="width: 305px; height: 49px;">
        Schedule & Fees
      </div>
    </div>
    
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden flex flex-col md:flex-row">
      <div class="p-8 md:w-1/2 border-b md:border-b-0 md:border-r border-gray-200">
        <h3 class="text-xl font-bold text-gray-900 mb-4">Program Schedule</h3>
        <ul class="space-y-4">
          <li class="flex items-center text-gray-600">
            <i class="far fa-calendar-alt w-6 text-blue-500"></i> Start: <span class="ml-1" x-text="new Date('{{kelas.tanggal_mulai}}').toLocaleDateString('en-US', {month: 'long', day: 'numeric', year: 'numeric'})"></span>
          </li>
          <li class="flex items-center text-gray-600">
            <i class="far fa-clock w-6 text-blue-500"></i> Duration: {{kelas.bulan}} Months ({{kelas.hari}} Days)
          </li>
          <li class="flex items-center text-gray-600">
            <i class="fas fa-video w-6 text-blue-500"></i> Method: <span class="ml-1 capitalize">{{kelas.metode}}</span>
          </li>
        </ul>
      </div>
      <div class="p-8 md:w-1/2 bg-gray-50 flex flex-col justify-center items-center">
        <p class="text-gray-500 mb-2">Special Price</p>
        <div class="flex items-baseline gap-2 mb-4">
          <span class="text-3xl font-bold text-gray-900">Rp <span x-text="Number({{kelas.harga}}).toLocaleString('id-ID')"></span></span>
          {{#if kelas.promo}}
          <span class="text-sm line-through text-gray-400">Rp <span x-text="Number({{kelas.promo}}).toLocaleString('id-ID')"></span></span>
          {{/if}}
        </div>
        <a href="#payment-section" class="w-full text-center py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition">Register Now</a>
      </div>
    </div>
  </div>
</section>
