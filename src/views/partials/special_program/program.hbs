<section id='programs' class='w-full py-24 bg-gradient-to-b px-4 to-[#FAFAFA]
  {{#if (eq category.name "In House Training")}} from-[#E1E1C8]
  {{else if (eq category.name "WIP")}} from-[#CEE5F6]
  {{else if (eq category.name "Bootcamp")}} from-[#EAC5F8]
  {{else}} from-gray-100
  {{/if}}'>
  <div class='container mx-auto w-full flex flex-col items-center'>
    <div class="w-full flex flex-col items-center">
      
      <!-- Judul -->
      <div class='w-full max-w-4xl text-center mb-10'>
        <h2 class='text-[32px] md:text-[36px] font-semibold text-gray-900 font-montserrat tracking-tight mb-4'>
          <span class="text-[#70B4E3]">{{t "test.specialProgram.benefitSection.tittle"}}</span> {{category.name}}
        </h2>
        <p class='text-black font-normal text-[16px] md:text-[18px] font-["Open_Sans"] '>
          Select the program that aligns with your goals and passion.
        </p>
      </div>
      <!-- Kotak Coming Soon -->
      <div class='w-full max-w-[706px] bg-white border border-gray-200 rounded-xl shadow-sm flex flex-col items-center text-center px-8 py-16 md:py-20'>
        <div class="w-14 h-14 bg-[#003060] rounded-full flex items-center justify-center mb-6 text-white shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class='text-[22px] md:text-[24px] font-bold text-[#003060] font-montserrat mb-6'>
          {{category.name}} Coming Soon
        </h3>
        <div class='text-[14px] md:text-[15px] font-normal text-black font-["Open_Sans"] leading-relaxed space-y-2'>
          <p>We're preparing this program to deliver the best learning experience.</p>
          <p>Stay tuned for updates.</p>
        </div>
      </div>
    </div>
    <!-- 
    KODE FILTER, DAFTAR KELAS, & "PROGRAM NOT FOUND" 
    <div class='w-full mt-20' x-show="loading || kelasItems.length > 0 || searchQuery !== '' || selectedType !== 'all' || selectedMethod !== 'all'">
      
      <div class='text-center mb-16 relative'>
        <h2 class='text-4xl font-extrabold text-gray-900 mb-4 relative z-10 font-montserrat'>
          {{t "test.specialProgram.programSection.tittle"}}
        </h2>
        <p class='text-gray-600 text-lg '>{{t "test.specialProgram.programSection.description"}}</p>
      </div>

      <div class='max-w-6xl mx-auto mb-16 relative z-10 overflow-visionsble'>
        <div class='bg-white backdrop-blur-md border border-gray-200 rounded-2xl p-8 shadow-lg'>
          
          <div class='flex items-center gap-3 mb-6'>
            <div class='w-1 h-8 bg-gradient-to-b from-gray-600 to-gray-700 rounded-full'></div>
            <h3 class='text-2xl font-bold text-gray-900 '>{{t 'test.program.find'}} {{category.name}}</h3>
          </div>

          <div class='grid grid-cols-1 md:grid-cols-3 gap-6 mb-6 relative z-50'>

            <div @click.away='typeDropdownOpen = false' class='group relative'>
              <label class='flex items-center gap-2 text-gray-700 font-semibold mb-3 text-sm tracking-wide'>
                <i class='fas fa-layer-group text-gray-600'></i>
                {{t 'test.program.programType'}}
              </label>

              <button @click='typeDropdownOpen = !typeDropdownOpen' type='button' class='w-full px-5 py-4 pr-12 bg-white backdrop-blur-md border border-gray-300 rounded-2xl text-gray-900 font-medium focus:outline-none focus:ring-2 focus:ring-gray-500 transition-all duration-300 hover:border-gray-400 text-left relative'>
                <div class='flex items-center gap-3'>
                  <i :class='selectedTypeItem.icon' class='fas text-gray-600'></i>
                  <span x-text='selectedTypeItem.title'></span>
                </div>
                <div class='absolute right-4 top-1/2 -translate-y-1/2 transition-transform duration-300' :class="typeDropdownOpen ? 'rotate-180' : ''">
                  <i class='fas fa-chevron-down text-gray-500 text-lg'></i>
                </div>
              </button>

              <div x-show='typeDropdownOpen' x-transition style='z-index: 9999' class='absolute w-full mt-2 bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden max-h-96 overflow-y-auto'>
                <template x-for='type in courseCategoriesData' :key='type.value'>
                  <button type='button' @click='selectedType = type.value; typeDropdownOpen = false' class='w-full px-5 py-4 text-left hover:bg-gray-50 transition-colors duration-200 flex items-start gap-4 group/item' :class="selectedType === type.value ? 'bg-gray-50 border-r-4 border-gray-600' : ''">
                    <div class='w-10 h-10 rounded-full bg-secondary text-white flex items-center justify-center flex-shrink-0 group-hover/item:bg-gray-200 transition-colors' :class="selectedType === type.value ? 'bg-gradient-to-br from-primary via-secondary to-gray-900' : ''">
                      <i :class='type.icon' class='fas'></i>
                    </div>
                    <div class='flex-1'>
                      <h4 class='font-bold text-gray-900 mb-1 font-montserrat' x-text='type.title'></h4>
                      <p class='text-sm text-gray-600 ' x-text='type.desc'></p>
                    </div>
                    <div x-show='selectedType === type.value' class='flex-shrink-0'>
                      <i class='fas fa-check text-gray-600'></i>
                    </div>
                  </button>
                </template>
              </div>
            </div>

            <div @click.away='methodDropdownOpen = false' class='group relative'>
              <label class='flex items-center gap-2 text-gray-700 font-semibold mb-3 text-sm tracking-wide'>
                <i class='fas fa-laptop text-gray-600'></i>
                {{t 'test.program.method'}}
              </label>

              <button @click='methodDropdownOpen = !methodDropdownOpen' type='button' class='w-full px-5 py-4 pr-12 bg-white backdrop-blur-md border border-gray-300 rounded-2xl text-gray-900 font-medium focus:outline-none focus:ring-2 focus:ring-gray-500 transition-all duration-300 hover:border-gray-400 text-left relative'>
                <div class='flex items-center gap-3'>
                  <i :class='selectedMethodItem.icon' class='fas text-gray-600'></i>
                  <span x-text='selectedMethodItem.title'></span>
                </div>
                <div class='absolute right-4 top-1/2 -translate-y-1/2 transition-transform duration-300' :class="methodDropdownOpen ? 'rotate-180' : ''">
                  <i class='fas fa-chevron-down text-gray-500 text-lg'></i>
                </div>
              </button>

              <div x-show='methodDropdownOpen' x-transition style='z-index: 9999' class='absolute w-full mt-2 bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden'>
                <template x-for='method in methodOptions' :key='method.value'>
                  <button type='button' @click='selectedMethod = method.value; methodDropdownOpen = false' class='w-full px-5 py-4 text-left hover:bg-gray-50 transition-colors duration-200 flex items-start gap-4 group/item' :class="selectedMethod === method.value ? 'bg-gray-50 border-r-4 border-gray-600' : ''">
                    <div class='w-10 h-10 rounded-full bg-secondary text-white flex items-center justify-center flex-shrink-0 group-hover/item:bg-gray-200 transition-colors' :class="selectedMethod === method.value ? 'bg-gradient-to-br from-primary via-secondary to-gray-900' : ''">
                      <i :class='method.icon' class='fas'></i>
                    </div>
                    <div class='flex-1'>
                      <h4 class='font-bold text-gray-900 mb-1 font-montserrat' x-text='method.title'></h4>
                      <p class='text-sm text-gray-600 ' x-text='method.desc'></p>
                    </div>
                    <div x-show='selectedMethod === method.value' class='flex-shrink-0'>
                      <i class='fas fa-check text-gray-600'></i>
                    </div>
                  </button>
                </template>
              </div>
            </div>

            <div class='group'>
              <label class='flex items-center gap-2 text-gray-700 font-semibold mb-3 text-sm tracking-wide'>
                <i class='fas fa-search text-gray-600'></i>
                {{t 'test.program.search'}}
              </label>
              <div class='relative'>
                <input type='text' x-model='searchQuery' placeholder='{{t "test.program.placeholderSearch"}}' class='w-full px-5 py-4 pr-12 bg-white backdrop-blur-md border border-gray-300 rounded-2xl text-gray-900 placeholder-gray-400 font-medium focus:outline-none focus:ring-2 focus:ring-gray-500 transition-all duration-300 hover:border-gray-400' />
                <button x-show="searchQuery !== ''" @click="searchQuery = ''" class='absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors duration-200'>
                  <i class='fas fa-times-circle text-xl'></i>
                </button>
              </div>
            </div>
          </div>

          <div class='flex items-center justify-between flex-wrap gap-4' x-show="selectedType !== 'all' || searchQuery !== '' || selectedMethod !== 'all'">
            <div class='flex items-center gap-3 flex-wrap'>
              <span class='text-gray-600 text-sm font-medium'>{{t 'test.program.ActiveFilters'}}</span>
              <span x-show="selectedType !== 'all'" class='px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium border border-gray-300'>
                <i class='fas fa-layer-group mr-2'></i><span x-text='selectedType'></span>
              </span>
              <span x-show="selectedMethod !== 'all'" class='px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium border border-gray-300'>
                <i class="'fas ' + selectedMethodItem.icon + ' mr-2'"></i><span x-text='selectedMethodItem.title'></span>
              </span>
              <span x-show="searchQuery !== ''" class='px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium border border-gray-300'>
                <i class='fas fa-search mr-2'></i>"<span x-text='searchQuery'></span>"
              </span>
            </div>
            <button @click='resetFilters()' class='px-6 py-2.5 bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg font-medium'>
              <i class='fas fa-redo mr-2'></i>{{t 'test.program.resetAll'}}
            </button>
          </div>
        </div>

        <div class='mt-6 text-center'>
          <p class='text-gray-600 '>
            {{t 'test.program.showing'}}
            <span class='text-gray-900 font-bold' x-text='totalItems'></span>
            {{t 'test.program.of'}}
            <span class='text-gray-900 font-bold' x-text='totalItems'></span>
            {{t 'test.program.program'}}
          </p>
        </div>
      </div>

      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto' x-ref='kelasList'>
        <template x-if="!loading">
          <template x-for="course in kelasItems" :key="course.id">
            <div data-animate="scale-up" data-delay="100" class="group card bg-white shadow-2xl border-0 rounded-2xl overflow-hidden transition-all duration-300 transform hover:-translate-y-2 hover:shadow-3xl">
              <img :src="course.image" :alt="course.name" class="h-48 w-full object-cover group-hover:scale-105 transition-transform duration-300 drop-shadow-lg" />

              <div class="card-body p-6">
                <div class="flex gap-2 mb-3">
                  <span class="badge flex justify-center h-fit items-center bg-slate-100 text-slate-700 px-3 py-1 text-xs font-semibold rounded-full" x-text="course.category?.name"></span>
                  <span class="badge flex justify-center h-fit items-center bg-gradient-to-br from-primary via-secondary to-gray-900 text-white px-3 py-1 text-xs font-semibold rounded-full" x-text="course.courseType?.nameClassesType"></span>
                </div>

                <div class="flex flex-wrap gap-2 mb-4 text-sm text-gray-700">
                  <div class="flex items-center gap-2 bg-gray-100 px-3 py-1 rounded-full">
                    <template x-if="course.method === 'online'">
                      <span class="flex items-center gap-2">
                        <i class="fas fa-laptop text-slate-500"></i>
                        <span>{{t "test.home.programSection.online"}}</span>
                      </span>
                    </template>
                    <template x-if="course.method === 'offline'">
                      <span class="flex items-center gap-2">
                        <i class="fas fa-map-marker-alt text-slate-500"></i>
                        <span>{{t "test.home.programSection.offline"}}</span>
                      </span>
                    </template>
                  </div>
                  <div class="flex items-center gap-2 bg-gray-100 px-3 py-1 rounded-full">
                    <i class="fas fa-user-tie text-slate-500"></i>
                    <span x-text="getByLang(course.location, lang)"></span>
                  </div>
                </div>

                <h2 class="card-title text-gray-900 text-xl font-bold mb-3" x-text="course.name"></h2>
                <p class="text-sm text-gray-600 line-clamp-1 mb-4 leading-relaxed" x-text="getByLang(course.description, lang)"></p>

                <div class="bg-gradient-to-br from-slate-50 to-slate-100 rounded-lg p-4 mb-4 border border-slate-200">
                  <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2">
                      <i class="fas fa-users text-slate-600 animate-pulse"></i>
                      <span class="text-sm font-medium text-slate-600">{{t "test.home.programSection.quota"}}</span>
                    </div>
                    <span class="text-sm font-bold text-slate-800 bg-white px-3 py-1 rounded-full shadow-sm">
                      <span x-text="course.userCourses?.length ?? 0"></span> / <span x-text="course.quota"></span> {{t "test.home.programSection.student"}}
                    </span>
                  </div>
                  <div class="w-full bg-slate-200 rounded-full h-2 overflow-hidden mb-2">
                    <div class="h-2 rounded-full bg-gradient-to-r from-green-400 to-green-600 transition-all duration-500 ease-out" :style="`width: ${((course.userCourses?.length ?? 0) / course.quota) * 100}%`"></div>
                  </div>
                </div>

                <div class="card-actions">
                  <a :href="`/program/${course.id}`" class="btn bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white text-base px-8 py-3 w-full border-0 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex justify-center items-center text-center">
                    {{t "test.home.programSection.buttonViewProgram"}}
                  </a>
                </div>
              </div>
            </div>
          </template>
        </template>
      </div>

      <div x-show='kelasItems.length === 0 && !loading' class='text-center py-20' x-transition>
        <div class='bg-gray-100 backdrop-blur-md border border-gray-200 w-32 h-32 mx-auto mb-6 rounded-full flex items-center justify-center'>
          <i class='fas fa-inbox text-5xl text-gray-400'></i>
        </div>
        <h3 class='text-3xl font-bold text-gray-900 mb-3 font-montserrat'>{{t 'test.program.noProgram'}}</h3>
        <p class='text-gray-600 text-lg mb-6 '>{{t 'test.program.spanNoProgram'}}</p>
        <button @click='resetFilters()' class='btn border-0 text-lg  bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white rounded-lg transition-all duration-300 transform font-semibold shadow-xl hover:-translate-y-2 relative overflow-hidden cursor-pointer'>
          <i class='fas fa-redo mr-2'></i>{{t 'test.program.clearFilters'}}
        </button>
      </div>

      <div class='flex justify-center items-center gap-4 mt-12' x-show='totalPages > 1'>
        <button @click='currentPage = Math.max(1, currentPage - 1)' :disabled='currentPage === 1' class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'>
          <i class='fas fa-chevron-left'></i>
        </button>
        <template x-for='page in totalPages' :key='page'>
          <button @click='currentPage = page' class='w-12 h-12 rounded-xl text-lg font-semibold transition-all duration-300 border shadow-sm' :class="currentPage === page ? 'bg-gradient-to-r from-slate-600 to-slate-800 text-white border-slate-700 shadow-md' : 'bg-white text-gray-700 border-gray-300 hover:bg-slate-50'" x-text='page'></button>
        </template>
        <button @click='currentPage = Math.min(totalPages, currentPage + 1)' :disabled='currentPage === totalPages' class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'>
          <i class='fas fa-chevron-right'></i>
        </button>
      </div>
      
    </div>
    
    -->

  </div>
</section>