<section class="py-16 px-6 bg-transparant">
  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="mb-12 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4 font-montserrat">
        {{t 'home.heroSection.capstoneProject'}}
      </h2>
      <div class="w-20 h-1.5 bg-blue-600 mx-auto rounded-full"></div>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {{#each capstoneProjects}}
        <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100 hover:-translate-y-2">

          <!-- Image Container -->
          <div class="relative aspect-video overflow-hidden">
            <img
              src="{{this.dokumentasi}}"
              alt="{{this.title}}"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              onerror="this.src='/src/common/public/image/placeholder.png'"
            >
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
              <span class="text-white text-xs font-medium bg-blue-600 px-2 py-1 rounded">View Project</span>
            </div>
          </div>

          <!-- Content -->
          <div class="p-5">
            <h3 class="text-lg font-bold text-slate-800 mb-2 group-hover:text-blue-600 transition-colors duration-300 line-clamp-1">
              {{this.title}}
            </h3>
            {{#if this.description}}
              <p class="text-slate-600 text-sm leading-relaxed line-clamp-2">
                {{this.description}}
              </p>
            {{/if}}
          </div>
        </div>
      {{else}}
        <!-- Empty State -->
        <div class="col-span-full text-center py-12">
          <div class="text-slate-400 mb-3">
            <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <p class="text-slate-500 italic">Belum ada project capstone yang ditampilkan.</p>
        </div>
      {{/each}}
    </div>
  </div>
</section>
