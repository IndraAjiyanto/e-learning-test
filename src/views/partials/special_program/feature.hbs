{{#if superiority.length}}
<section class='py-20 bg-white'>
  <div class='container mx-auto px-4'>
    <div class='max-w-6xl mx-auto'>
      <div class='grid md:grid-cols-2 gap-12 items-center'>
        <!-- Content -->
        <div>
          <h2 class='text-4xl font-bold text-gray-900 mb-6 font-montserrat'>
            {{t "test.specialProgram.chooseSection.tittle"}}
          </h2>
          <div class='space-y-6'>
            {{#each superiority}}
            <div class='flex gap-4'>
              <div
                class='flex-shrink-0 w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center'
              >
                <i class='fas fa-check text-gray-600 text-xl'></i>
              </div>
              <div>
                <h3
                  class='font-bold text-lg text-gray-900 mb-2 font-montserrat'
                >{{getByLang this.title ../lang}}</h3>
                <p class='text-gray-600 '>{{getByLang this.description ../lang}}</p>
              </div>
            </div>
            {{/each}}
          </div>
        </div>

        <!-- Image/Illustration -->
        <div class='relative'>
          <div
            class='bg-gradient-to-br from-gray-100 to-gray-200 rounded-3xl p-8 transform hover:scale-105 transition-transform duration-300'
          >
            <div class='aspect-square flex items-center justify-center'>
              <i class='fas fa-users-cog text-9xl text-gray-300'></i>
            </div>
          </div>
          <!-- Decorative elements -->
          <div
            class='absolute -top-6 -right-6 w-24 h-24 bg-gray-200 rounded-full opacity-50'
          ></div>
          <div
            class='absolute -bottom-6 -left-6 w-32 h-32 bg-gray-300 rounded-full opacity-50'
          ></div>
        </div>
      </div>
    </div>
  </div>
</section>
{{/if}}