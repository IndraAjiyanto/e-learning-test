<!-- GALLERY SECTION -->
<section id="gallery" class="w-full bg-[#FAFAFA] font-montserrat">
  
  <!-- 1. KONTEN KHUSUS MOBILE (< 640px) -->
  <div class="block sm:hidden w-full py-12 px-5">
    
    <!-- Header Section Mobile -->
    <div class="text-center mb-8">
      <h2 class="font-montserrat font-bold text-[28px] text-center mb-2">
        <span class="text-black">Our</span> <span class="text-[#6EB6E5]">Gallery</span>
      </h2>
      <p class="font-sans font-normal text-sm text-black/80 text-center max-w-[340px] mx-auto">
        Take a look at the key moments and experiences that made this program meaningful.
      </p>
    </div>

    <!-- Mobile Gallery List (Uniform h-[225px] cards, not stretching vertically) -->
    <div class="flex flex-col gap-4 w-full items-center">
      <div class="overflow-hidden rounded-[16px] shadow-xs bg-gray-200 w-full h-[225px]">
        <img src="{{#if gallery.[0]}}{{gallery.[0].filePath}}{{else}}https://upload.wikimedia.org/wikipedia/commons/2/29/Kepala_Badan_Koordinasi_Penanaman_Modal_Bahlil_Lahadalia_%28cropped%29.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled{{/if}}" 
             alt="Gallery 1" class="w-full h-full object-cover" />
      </div>
      <div class="overflow-hidden rounded-[16px] shadow-xs bg-gray-200 w-full h-[225px]">
        <img src="{{#if gallery.[1]}}{{gallery.[1].filePath}}{{else}}https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=600&h=800&fit=crop{{/if}}"
             alt="Gallery 2" class="w-full h-full object-cover" />
      </div>
      <div class="overflow-hidden rounded-[16px] shadow-xs bg-gray-200 w-full h-[225px]">
