        <img src="{{#if gallery.[3]}}{{gallery.[3].filePath}}{{else}}https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=600&h=800&fit=crop{{/if}}"
             alt="Gallery 4" class="w-full h-full object-cover" />
      </div>
      <div class="overflow-hidden rounded-[16px] shadow-xs bg-gray-200 w-full h-[225px]">
        <img src="{{#if gallery.[4]}}{{gallery.[4].filePath}}{{else}}https://images.unsplash.com/photo-1552664730-d307ca884978?q=80&w=600&h=400&fit=crop{{/if}}"
             alt="Gallery 5" class="w-full h-full object-cover" />
      </div>
      <div class="overflow-hidden rounded-[16px] shadow-xs bg-gray-200 w-full h-[225px]">
        <img src="{{#if gallery.[5]}}{{gallery.[5].filePath}}{{else}}https://images.unsplash.com/photo-1515169067868-5387ec356754?q=80&w=600&h=800&fit=crop{{/if}}" 
             alt="Gallery 6" class="w-full h-full object-cover" />
      </div>
    </div>

    <!-- See All Link Mobile -->
    <div class="text-center mt-10">
      <a href="/dashboard/gallery" class="inline-flex items-center gap-2 text-[#0B1F3B] text-sm font-semibold border-b-[1.5px] border-[#0B1F3B] pb-1">
        See All Our Gallery <i class="fa-solid fa-arrow-right-long text-xs"></i>
      </a>
    </div>

  </div>

  <!-- 2. KONTEN KHUSUS DESKTOP (>= 640px / Figma Baseline W1728) -->
