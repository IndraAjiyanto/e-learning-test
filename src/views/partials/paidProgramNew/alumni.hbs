<!-- ALUMNI BOOTCAMP TESTIMONIAL SECTION -->
<section
  id="alumni"
  class="relative overflow-hidden w-full font-montserrat"
  x-data="testimonialCarousel(window.__alumniCarousel)"
>
  <!-- Background Blur Effects -->
  <div class="absolute top-0 right-0 opacity-10 pointer-events-none">
    <div class="w-64 h-64 bg-white rounded-full blur-3xl absolute -top-20 -right-20"></div>
  </div>

  <!-- 1. KONTEN KHUSUS MOBILE (< 640px) -->
  <div 
    class="block sm:hidden w-full py-12 relative z-10"
    style="background: linear-gradient(180deg, rgba(250, 250, 250, 0.941176) 10%, rgba(110, 182, 229, 0.313726) 80%);"
  >
    
    <!-- Title with Animated Stabilo Highlight Sweep -->
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-[#000000] font-montserrat tracking-tight mb-6 flex flex-wrap items-center justify-center gap-2">
      <span>{{t 'test.categoryPaidProgram.alumni.title'}}</span>
      
      <span 
        class="relative inline-flex items-center justify-center overflow-hidden align-middle my-1"
        x-data="{
          isHighlighted: false,
          init() {
            const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  this.isHighlighted = true;
                }
              });
            }, { threshold: 0.4, rootMargin: '0px 0px -50px 0px' });
            observer.observe(this.$el);
          }
        }"
      >
        <!-- Base Transparent Placeholder to Reserve Space -->
        <span class="opacity-0 font-montserrat font-semibold text-2xl sm:text-3xl lg:text-4xl whitespace-nowrap px-3 sm:px-4 py-1 sm:py-1.5">
          {{t 'test.categoryPaidProgram.alumni.title2'}} {{category.name}}
        </span>

        <!-- Blue Stabilo Highlight Layer (Sweeps from Left 0% to 100% Width) -->
        <span 
          class="relative inline-flex items-center justify-center overflow-hidden align-middle my-0.5"
          x-data="{
            isHighlighted: false,
            init() {
              const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                  if (entry.isIntersecting) {
                    this.isHighlighted = true;
                  }
                });
              }, { threshold: 0.4, rootMargin: '0px 0px -50px 0px' });
              observer.observe(this.$el);
            }
          }"
        >
          <span class="font-montserrat font-semibold text-white text-2xl sm:text-3xl lg:text-4xl whitespace-nowrap min-w-max px-3 sm:px-4 py-1 sm:py-1.5">
            {{t 'test.categoryPaidProgram.alumni.title2'}} {{category.name}}
          </span>
        </span>
      </span>
    </h2>
    
    <!-- Subtitle -->
    <p class="text-base md:text-xl text-[#000000]/80 max-w-6xl mx-auto font-sans font-normal">
      {{t 'test.categoryPaidProgram.alumni.description'}}
    </p>
  </div>

          <!-- Blue Stabilo Highlight Layer Mobile -->
          <span 
            class="absolute inset-y-0 left-0 bg-[#003060] rounded-[6px] transition-all duration-[800ms] ease-out overflow-hidden flex items-center justify-center whitespace-nowrap shadow-xs pointer-events-none"
            :class="isHighlighted ? 'w-full' : 'w-0'"
          >
            <span class="font-montserrat font-semibold text-white text-base whitespace-nowrap min-w-max px-2.5 py-1">
              Alumni Bootcamp
            </span>
          </span>
        </span>
      </h2>
      
      <!-- Subtitle Mobile -->
      <p class="font-sans font-normal text-sm leading-[22px] text-center text-[#000000]/80 max-w-full">
        See what our participants have to say about their learning experience and the impact of our bootcamps.
      </p>
    </div>

    <!-- Carousel Viewport Mobile -->
    <div 
      class="relative w-full mx-auto"
      x-data="{ touchStartX: 0 }"
      @touchstart="touchStartX = $event.touches[0].clientX"
      @touchend="
        const diff = touchStartX - $event.changedTouches[0].clientX;
        if (diff > 40 && active < maxIndex) next();
        else if (diff < -40 && active > 0) prev();
      "
    >
      <div class="overflow-hidden py-4 w-full">
        <div
          class="flex gap-4 transition-transform duration-500 ease-in-out"
          :style="`transform: translateX(calc(50vw - ${(active * 356) + 170}px)); width: max-content;`"
        >
          <template x-for="(item, index) in testimonials" :key="item.id || index">
            <div
              class="w-[340px] flex-shrink-0 transition-all duration-500 ease-in-out transform cursor-pointer origin-center"
              :class="isCenter(index) 
                ? 'scale-100 opacity-100 z-10 shadow-[0px_4px_16px_0px_rgba(0,0,0,0.06)]' 
                : 'scale-[0.92] opacity-60 z-0 shadow-[0px_4px_16px_0px_rgba(0,0,0,0.06)]'"
              @click="goTo(index)"
            >
              <div 
                class="w-full h-[420px] p-6 flex flex-col justify-between bg-gradient-to-b from-[#FFFFFF] to-[#E0F2F9] transition-all duration-500 border border-white/60 rounded-[16px] shadow-[0px_4px_16px_0px_rgba(0,0,0,0.06)]"
              >
                <div>
                  <span class="text-[44px] text-[#003060] font-serif leading-none mb-3 block select-none">“</span>
                  <p class="text-[#333333] font-sans font-normal text-sm leading-[24px] overflow-y-auto max-h-[220px]" x-text="item.testimonial"></p>
                </div>
                
                <div>
                  <div class="w-full h-px bg-gray-200/80 mb-4"></div>
                  
                  <div class="flex items-center gap-3.5">
                    <img :src="item.photo" :alt="item.name" class="w-14 h-14 rounded-full object-cover shadow-xs shrink-0"/>
                    <div class="text-left">
                      <p class="font-montserrat font-semibold text-[#003060] text-sm leading-tight mb-1" x-text="item.name"></p>
                      <p class="font-sans font-normal text-[#666666] text-xs leading-snug">
                        <span x-text="item.position"></span>
                        <template x-if="item.company">
                          <span> at <span x-text="item.company"></span></span>
                        </template>
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </template>
        </div>
      </div>

      <!-- Navigation Pagination Dots Mobile -->
      <div class="flex items-center justify-center gap-2.5 mt-6">
        <template x-for="(item, index) in testimonials" :key="'mobile-dot-' + index">
          <button
            class="w-3 h-3 rounded-full transition-all duration-300 cursor-pointer focus:outline-none"
            :class="active === index ? 'bg-[#003060] scale-110' : 'bg-[#003060]/20 hover:bg-[#003060]/40'"
            @click="goTo(index)"
            :aria-label="'Go to slide ' + (index + 1)"
          ></button>
        </template>
      </div>

      <!-- See All Link Mobile -->
      <div class="text-center mt-8">
        <a
          href="/dashboard/alumni"
          class="inline-flex items-center gap-2 text-[#0B1F3B] font-semibold text-sm font-sans hover:underline"
        >
          See all alumni stories
          <i class="fas fa-arrow-right text-xs"></i>
        </a>
      </div>
    </div>

  </div>

  <!-- 2. KONTEN KHUSUS DESKTOP (>= 640px / Figma Baseline W1728) -->
  <div 
    class="hidden sm:block py-20 relative z-10"
    style="background: linear-gradient(214.9deg, rgba(220, 220, 220, 0.5) -25.49%, #6EB6E5 70.97%);"
  >
    
    <!-- Header Section Desktop -->
    <div class="text-center mb-8 px-6 lg:px-20">
      <h2 class="text-3xl lg:text-4xl font-semibold text-[#000000] font-montserrat tracking-tight mb-6 flex flex-wrap items-center justify-center gap-2">
        <span>Stories From</span>
        
        <span 
          class="relative inline-flex items-center justify-center overflow-hidden align-middle my-1"
          x-data="{
            isHighlighted: false,
            init() {
              const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                  if (entry.isIntersecting) {
                    this.isHighlighted = true;
                  }
                });
              }, { threshold: 0.4, rootMargin: '0px 0px -50px 0px' });
              observer.observe(this.$el);
            }
          }"
        >
          <!-- Base Placeholder -->
          <span class="opacity-0 font-montserrat font-semibold text-3xl lg:text-4xl whitespace-nowrap px-4 py-1.5">
            Alumni Bootcamp
          </span>

          <!-- Blue Stabilo Highlight Layer Desktop -->
          <span 
            class="absolute inset-y-0 left-0 bg-[#003060] rounded-[10px] transition-all duration-[800ms] ease-out overflow-hidden flex items-center justify-center whitespace-nowrap shadow-md pointer-events-none"
            :class="isHighlighted ? 'w-full' : 'w-0'"
          >
            <span class="font-montserrat font-semibold text-white text-3xl lg:text-4xl whitespace-nowrap min-w-max px-4 py-1.5">
              Alumni Bootcamp
            </span>
          </span>
        </span>
      </h2>
      
      <!-- Subtitle Desktop -->
      <p class="text-xl text-[#000000]/80 max-w-6xl mx-auto font-sans font-normal">
        See what our participants have to say about their learning experience and the impact of our bootcamps.
      </p>
    </div>

    <!-- Carousel Container Desktop -->
    <div class="relative w-full mx-auto">
      
      <!-- Slide Viewport Desktop -->
      <div class="overflow-visible py-8 w-full">
        <div
          class="flex gap-8 transition-transform duration-500 ease-in-out"
          :style="`transform: translateX(calc(50vw - ${(active * 527.45) + 247.725}px)); width: max-content;`"
        >
          <template x-for="(item, index) in testimonials" :key="item.id || index">
            <div
              class="w-[495.45px] flex-shrink-0 transition-all duration-500 ease-in-out transform cursor-pointer origin-center"
              :class="isCenter(index) 
                ? 'scale-100 opacity-100 z-10 shadow-[0px_0px_4.41px_0px_rgba(0,0,0,0.25)]' 
                : 'scale-[0.906] opacity-60 z-0 shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)] hidden md:block'"
              @click="goTo(index)"
            >
              <div 
                class="w-full h-[559.45px] p-8 flex flex-col bg-gradient-to-b from-[#FFFFFF] to-[#E0F2F9] transition-all duration-500 border border-white/60"
                :class="isCenter(index) ? 'rounded-[13.24px]' : 'rounded-[12px]'"
              >
                <span class="text-[60px] text-[#0B1F3B] font-serif leading-none mb-2 select-none">❝</span>
                <p class="text-[#333333] font-sans font-[400] text-[19.86px] leading-[33.1px] mb-6 flex-1 overflow-y-auto" x-text="item.testimonial"></p>
                
                <div class="w-full h-px bg-gray-300/60 mb-6"></div>
                
                <div class="flex items-center gap-4">
                  <img :src="item.photo" :alt="item.name" class="w-14 h-14 rounded-full object-cover shadow-sm"/>
                  <div>
                    <p class="font-montserrat font-[600] text-[#000000] text-[22.07px] leading-[100%] mb-1" x-text="item.name"></p>
                    <p class="font-sans font-[400] text-[#000000]/80 text-[18px] leading-snug">
                      <span x-text="item.company"></span>
                      <template x-if="item.company">
                        <span> at <span x-text="item.position"></span></span>
                      </template>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </template>
        </div>
      </div>

      <!-- Navigation & Pagination Controls Desktop -->
      <div class="flex justify-center items-center mt-8 gap-4 min-h-[52px]">
        
        <button
          x-show="active > 0"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-75"
          x-transition:enter-end="opacity-100 scale-100"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-75"
          class="w-12 h-12 flex items-center justify-center rounded-full bg-[#003060] text-white shadow-md hover:bg-[#0B1F3B] transition-all hover:scale-105"
          @click="prev()"
          aria-label="Previous Testimonial"
        >
          <i class="fas fa-chevron-left text-lg"></i>
        </button>

        <div class="relative flex items-center gap-4 mx-4 py-2">
          <template x-for="(item, index) in testimonials" :key="'swap-dot-desktop-' + index">
            <div
              class="w-5 h-5 rounded-full transition-all duration-500 ease-in-out transform pointer-events-none"
              :class="getDotClass(index)"
              :style="`transform: translateX(${getDotOffset(index)}px);`"
            ></div>
          </template>

          <div class="absolute inset-0 flex items-center gap-4">
            <template x-for="(item, index) in testimonials" :key="'click-dot-desktop-' + index">
              <button
                class="w-5 h-5 rounded-full cursor-pointer focus:outline-none opacity-0"
                @click="goTo(index)"
                :aria-label="'Go to slide ' + (index + 1)"
              ></button>
            </template>
          </div>
        </div>

        <button
          x-show="active < maxIndex"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-75"
          x-transition:enter-end="opacity-100 scale-100"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-75"
          class="w-12 h-12 flex items-center justify-center rounded-full bg-[#003060] text-white shadow-md hover:bg-[#0B1F3B] transition-all hover:scale-105"
          @click="next()"
          aria-label="Next Testimonial"
        >
          <i class="fas fa-chevron-right text-lg"></i>
        </button>
      </div>

      <!-- See All Link Desktop -->
      <div class="text-center mt-10">
        <p class="text-[#000000]/80 font-sans font-normal text-xl mb-4">
          And many more inspiring stories from our alumni
        </p>
        <a
          href="/dashboard/alumni"
          class="inline-flex items-center gap-2 text-[#0B1F3B] font-normal text-lg font-sans hover:underline"
        >
          See all alumni stories
          <i class="fas fa-arrow-right text-sm"></i>
        </a>
      </div>

    <!-- See All Link -->
    <div class="text-center mt-10">
      <p class="text-[#000000]/80 font-sans font-normal text-base md:text-xl mb-4">
        {{t 'test.categoryPaidProgram.alumni.footer'}}
      </p>
      <a
        href="/dashboard/alumni"
        class="inline-flex items-center gap-2 text-[#0B1F3B] font-normal text-base md:text-lg font-sans hover:underline"
      >
        {{t 'test.categoryPaidProgram.alumni.allStories'}}
        <i class="fas fa-arrow-right text-sm"></i>
      </a>
    </div>

  </div>

</section>

<script>
  // Data alumni dari database untuk carousel testimonial
  // getByLang mengambil teks sesuai bahasa aktif (id/en/ja)
  window.__alumniCarousel = [
    {{#each alumni}}
    {
      id: {{this.id}},
      name: {{{json (getByLang this.name ../lang)}}},
      position: {{{json (getByLang this.currentPosition ../lang)}}},
      company: {{{json (default this.course.name '')}}},
      photo: {{{json (default this.profile '')}}},
      testimonial: {{{json (getByLang this.message ../lang)}}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ];
</script>
