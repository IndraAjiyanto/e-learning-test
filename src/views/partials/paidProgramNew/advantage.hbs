<!-- ADVANTAGE SECTION (CORE KNOWLEDGE FIRST) -->
<section id="advantage" class="py-16 bg-[#FAFAFA] font-montserrat">
  <div class="container mx-auto px-6 lg:px-12 max-w-[1260px]">
    
    <!-- Yellow Advantage Card -->
    <div class="w-full bg-[#FFFBCB] rounded-[24px] px-8 py-12 sm:px-14 sm:py-16 lg:px-16 lg:py-16 min-h-[500px] lg:min-h-[669px] shadow-xs relative overflow-hidden flex flex-col justify-center">
      
      <!-- Header -->
      <div class="flex items-center gap-4 mb-8">
        <div class="w-[65px] h-[65px] rounded-[100px] bg-[#EFF4FE] flex items-center justify-center shrink-0">
          <img src="/public/image/paidProgram/Vector.svg" alt="Core Knowledge" class="w-[40px] h-[40px] object-contain" />
        </div>
        <h3 class="font-montserrat font-semibold text-2xl sm:text-3xl lg:text-[30px] leading-none text-black">
          {{t 'test.categoryPaidProgram.advantage.title'}}
        </h3>
      </div>

      <!-- Content (Indented to align with Core Knowledge First title) -->
      <div class="sm:pl-[82px]">
        
        <!-- Description Subtitle -->
        <p class="font-sans font-normal text-base sm:text-xl lg:text-[25px] text-black/85 mb-10 max-w-4xl leading-relaxed lg:leading-[40px]">
           {{t 'test.categoryPaidProgram.advantage.description'}}
        </p>

        <!-- 4 Advantage List Items -->
        <div class="space-y-6 sm:space-y-7 max-w-4xl">
          
          <!-- Item 1 -->
          <div class="flex items-center gap-4 sm:gap-5">
            <div class="w-10 h-10 rounded-full bg-[#EFF4FE] flex items-center justify-center shrink-0">
              <img src="/public/image/paidProgram/Vector-1.svg" alt="Affordable Investment" class="w-5 h-5 object-contain" />
            </div>
            <p class="font-sans font-semibold text-base sm:text-xl lg:text-[25px] text-black leading-none">
               {{t 'test.categoryPaidProgram.advantage.point1'}}
            </p>
          </div>

          <!-- Item 2 -->
          <div class="flex items-center gap-4 sm:gap-5">
            <div class="w-10 h-10 rounded-full bg-[#EFF4FE] flex items-center justify-center shrink-0">
              <img src="/public/image/paidProgram/Group-1.svg" alt="Expert Mentors" class="w-5 h-5 object-contain" />
            </div>
            <p class="font-sans font-semibold text-base sm:text-xl lg:text-[25px] text-black leading-none">
              {{t 'test.categoryPaidProgram.advantage.point2'}}
            </p>
          </div>

          <!-- Item 3 -->
          <div class="flex items-center gap-4 sm:gap-5">
            <div class="w-10 h-10 rounded-full bg-[#EFF4FE] flex items-center justify-center shrink-0">
              <img src="/public/image/paidProgram/Group.svg" alt="Industry Projects" class="w-5 h-5 object-contain" />
            </div>
            <p class="font-sans font-semibold text-base sm:text-xl lg:text-[25px] text-black leading-none">
              {{t 'test.categoryPaidProgram.advantage.point3'}}
            </p>
          </div>

          <!-- Item 4 -->
          <div class="flex items-center gap-4 sm:gap-5">
            <div class="w-10 h-10 rounded-full bg-[#EFF4FE] flex items-center justify-center shrink-0">
              <img src="/public/image/icons/paid_program/benefit/industry.svg" alt="Portfolio" class="w-5 h-5 object-contain" />
            </div>
            <p class="font-sans font-semibold text-base sm:text-xl lg:text-[25px] text-black leading-none">
              {{t 'test.categoryPaidProgram.advantage.point4'}}
            </p>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
