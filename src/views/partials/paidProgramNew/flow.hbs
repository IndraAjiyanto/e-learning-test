<!-- FINAL CAPSTONE PROJECT SECTION -->
<section id="flow" class="w-full bg-[#FAFAFA] font-montserrat">
  
  <!-- 1. KONTEN KHUSUS MOBILE (< 640px) -->
  <div class="block sm:hidden w-full py-12 px-5">
    
    <!-- Header Mobile -->
    <div class="text-center mb-8">
      <h2 class="font-montserrat font-bold text-[28px] text-[#6EB6E5] leading-none tracking-normal text-center mb-3">
        Final Capstone <span class="text-[#0B1F3B]">Project</span>
      </h2>
      <p class="font-sans font-normal text-[14px] leading-[22px] tracking-normal text-black/80 text-center max-w-[340px] mx-auto">
        Kesatria Academy Portfolio Showcase
      </p>
    </div>

    <!-- Cards Stack for Mobile -->
    <div class="flex flex-col gap-5 w-full items-center">
      {{#each portfolio}}
        <div class="w-full max-w-[358px] h-[360px] bg-[#F5F6F7] rounded-[12px] p-4 pb-14 shadow-[0px_2px_4px_0px_rgba(0,0,0,0.12)] flex flex-col justify-between items-center text-center">
          <!-- Inner Image Box -->
          <div class="w-full aspect-[4/3] rounded-[12px] border border-[#D9D9D9] flex items-center justify-center text-black font-sans text-sm font-normal overflow-hidden mb-4 bg-gray-200">
            {{#if image.[0]}}
              <img src="{{image.[0]}}" alt="{{title}}" class="w-full h-full object-cover" />
            {{else}}
              <span>Gambar Portofolio</span>
            {{/if}}
          </div>
          <!-- Title -->
          <h3 class="w-full font-montserrat font-semibold text-[18px] leading-none tracking-normal text-[#003060] mb-3 text-center">
            {{title}}
          </h3>
          <!-- Centered Pill Badge -->
          <div class="w-full flex justify-center text-center">
            <span class="w-full bg-[#E6F9F6] text-[#0A5D5C] font-sans font-normal text-xs leading-tight text-center py-2 px-3 rounded-[6px]">
              {{course.category.name}}: {{course.name}}
            </span>
          </div>
        </div>
      {{/each}}
    </div>

  </div>

  <!-- 2. KONTEN KHUSUS DESKTOP (>= 640px / Figma Baseline W1728) -->
  <div class="hidden sm:block py-20">
    <div class="container mx-auto px-6 lg:px-12 max-w-[1464px]">
      
      <!-- Header -->
      <div class="text-center mb-12">
        <h2 class="font-montserrat font-semibold sm:text-4xl text-black leading-none text-center mb-4">
          Final Capstone <span class="text-[#6EB6E5]">Project</span>
        </h2>
        <p class="font-sans font-normal sm:text-lg md:text-xl text-black/80 text-center">
          Kesatria Academy Portfolio Showcase
        </p>
      </div>

      <!-- Cards Grid (Max-W: 1464px, Gap: 46px, Card: 468px x 498px, BG: #F5F6F7, Radius: 12px) -->
      <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-[46px] justify-items-center">
        {{#each portfolio}}
        <!-- Card -->
        <div class="w-full max-w-[468px] h-[498px] bg-[#F5F6F7] rounded-[12px] pt-[22px] px-[21px] pb-[20px] shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)] flex flex-col justify-between items-start text-left group hover:shadow-lg transition-all duration-300">
          <div class="w-full flex flex-col items-start">
            <!-- Inner Image Box (W: 427px, H: 351px, Radius: 12px, Border: 1px solid #D9D9D9) -->
            <div class="w-full max-w-[427px] h-[351px] rounded-[12px] border border-[#D9D9D9] flex items-center justify-center text-black font-inter text-xl font-normal overflow-hidden mb-4 mx-auto">
              {{#if image.[0]}}
                <img src="{{image.[0]}}" alt="{{title}}" class="w-full h-full object-cover" />
              {{else}}
                <span class="">Gambar Portofolio</span>
              {{/if}}
            </div>
            <!-- Title (Montserrat 600, 25px, #0B1F3B, Center) -->
            <h3 class="w-full font-montserrat font-semibold sm:text-[25px] leading-none text-[#0B1F3B] mb-8 text-center">
              {{title}}
            </h3>
            <!-- Badge (Open Sans 400, 15px, #0A5D5C, BG: #E6F9F6, Left) -->
            <div class="w-full text-left px-1">
              <span class="inline-block bg-[#E6F9F6] text-[#0A5D5C] font-sans font-normal text-[15px] leading-none text-left px-3.5 py-1.5 rounded-[4px]">
                {{course.category.name}}: {{course.name}}
              </span>
            </div>
          </div>
        </div>
        {{/each}}

      </div>

    </div>
  </div>

</section>
