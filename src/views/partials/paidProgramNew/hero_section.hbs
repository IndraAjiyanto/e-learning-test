<!-- HERO SECTION (PAID PROGRAM / BOOTCAMP) -->
<section id="hero" class="w-full font-montserrat">
  
  <!-- 1. MOBILE HERO CONTAINER (< 640px) -->
  <div 
    class="block sm:hidden w-full px-4 pt-24 pb-8"
    style="background: linear-gradient(180deg, #FAFAFA 0%, #CEE5F6 50%, #FAFAFA 100%);"
  >
    <div class="w-full space-y-5 flex flex-col items-start text-left">
      
      <!-- Top Pill Badge -->
      <div class="self-start inline-flex items-center w-[188px] h-[30px] px-[12px] py-[6px] gap-[8px] rounded-[50px] bg-[#0B1F3B1A] text-[#003060] shadow-2xs">
        <span class="w-[18px] h-[18px] bg-[#003060] transform rotate-45 inline-block shrink-0 opacity-100"></span>
        <span class="font-montserrat font-semibold text-[13px] leading-none tracking-normal">ENROLLMENT OPEN</span>
      </div>

      <!-- Main Title -->
      <h1 class="font-montserrat font-extrabold text-[28px] leading-[36px] text-[#003060] uppercase text-left w-full tracking-normal">
        BOOTCAMP<br />
        BATCH 6.2
      </h1>

      <!-- Subtitle Description -->
      <p class="font-sans font-normal text-[14px] leading-[22px] text-[#000000CC] text-left w-full tracking-normal">
        {{#if category.description}}
          {{getByLang category.description lang}}
        {{else}}
          Join our next cohort and accelerate your career with industry-led learning and real projects.
        {{/if}}
      </p>

      <!-- Student Image Illustration (Center) -->
      <div class="w-full max-w-[358px] mx-auto flex justify-center">
        <img 
          src="public/image/paidProgram/bgMobile.png"
          {{!-- src="{{category.hero_section_image}}" --}}
          alt="Bootcamp Student" 
          class="w-[358px] h-[220px] object-contain opacity-100"
        />
      </div>

      <!-- Key Information List (Bottom) -->
      <div class="flex flex-col gap-3 w-full text-left">
        <!-- Item 1: Registration -->
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[#003060] flex items-center justify-center text-white shrink-0 shadow-xs">
            <i class="fas fa-briefcase text-lg"></i>
          </div>
          <div class="flex flex-col">
            <h4 class="font-sans font-semibold text-[14px] leading-none text-[#003060] tracking-normal">Registration</h4>
            <span class="font-sans font-normal text-[11px] leading-none text-[#666666] mt-1 tracking-normal">05 Mar - 21 Apr 2026</span>
          </div>
        </div>

        <!-- Item 2: Start Learning -->
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[#003060] flex items-center justify-center text-white shrink-0 shadow-xs">
            <i class="fas fa-book-open text-lg"></i>
          </div>
          <div class="flex flex-col">
            <h4 class="font-sans font-semibold text-[14px] leading-none text-[#003060] tracking-normal">Start Learning</h4>
            <span class="font-sans font-normal text-[11px] leading-none text-[#666666] mt-1 tracking-normal">21 Apr - 21 Jul 2026</span>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- 2. DESKTOP HERO CONTAINER (>= 640px / Figma Baseline W1728) -->
  <div 
    class="hidden sm:block w-full py-10 lg:py-14"
    style="background: linear-gradient(180deg, #FAFAFA 0%, #CEE5F6 50%, #FAFAFA 95%);"
    x-data="{
      isVisible: false,
      words: ['NOW OPEN!'],
      wordIndex: 0,
      charIndex: 0,
      currentText: '',
      speed: 300,
      init() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              this.isVisible = true;
              if (this.charIndex === 0 && !this.currentText) {
                this.type();
              }
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        observer.observe(this.$el);
      },
      type() {
        const target = this.words[this.wordIndex];
        if (this.charIndex < target.length) {
          this.charIndex = Math.min(this.charIndex + 2, target.length);
          this.currentText = target.substring(0, this.charIndex);
          setTimeout(() => this.type(), this.speed);
        } else {
          setTimeout(() => {
            this.currentText = '';
            this.charIndex = 0;
            setTimeout(() => this.type(), 500);
          }, 3000);
        }
      }
    }"
  >
    <div class="container mx-auto mt-10 px-6 lg:px-8 max-w-[1541px]">
      <!-- DESKTOP HERO BANNER CARD -->
      <div class="relative w-full bg-[#6EB6E5] rounded-[28px] sm:rounded-[36px] p-6 sm:p-10 lg:p-12 xl:p-16 overflow-hidden min-h-[580px] lg:min-h-[640px] xl:h-[744px] flex items-start justify-between shadow-sm">
        
        <!-- Tech Particles & Person Background Layer (Fade-In & Slide Up from Bottom to Top) -->
        <div 
          class="absolute inset-0 w-full h-full pointer-events-none select-none z-0 transition-all duration-[1900ms] ease-out"
          :class="isVisible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-[100%]'"
        >
          <!-- Background Particles + Person Image -->
          <img 
            src="public/image/paidProgram/bgAnimation.png"
            {{!-- src="{{category.hero_section_image}}" --}}
            alt="Bootcamp Student" 
            class="w-full h-full object-cover object-right-bottom"
          />
        </div>

        <!-- Content Column (Left Side) - Staggered Fade-in & Slide-up Animation -->
        <div 
          class="relative z-10 w-full lg:w-2/3 xl:w-3/5 max-w-3xl text-left transition-all duration-1000 ease-out delay-200"
          :class="isVisible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'"
        >
          
          <!-- Badge -->
          <div class="w-[280px] sm:w-[328px] h-[40px] sm:h-[47px] rounded-[50px] p-[10px] gap-[10px] bg-[#0B1F3B1A] flex items-center justify-center mb-4 lg:mb-6 xl:mb-8 shadow-xs text-[#003060] font-montserrat font-semibold text-xs sm:text-base md:text-xl">
            <i class="fas fa-graduation-cap text-[#003060] text-sm sm:text-base md:text-xl"></i>
            <span>ENROLLMENT OPEN</span>
          </div>

          <!-- Huge Main Title -->
          <h1 class="font-montserrat font-semibold text-[28px] sm:text-[36px] lg:text-[42px] xl:text-[50px] leading-tight lg:leading-[54px] xl:leading-[70px] tracking-normal uppercase mb-4 lg:mb-6 xl:mb-8">
            <span class="text-white block">BOOTCAMP BATCH 6.2</span>
            <span class="text-[#003060] block min-h-[1.2em]">
              <span x-text="currentText">NOW OPEN!</span><span class="text-white font-light">|</span>
            </span>
          </h1>
          <button
            onclick="document.getElementById('programs') ? document.getElementById('programs').scrollIntoView({ behavior: 'smooth' }) : window.scrollTo({ top: 700, behavior: 'smooth' })"
            class="w-full sm:flex-1 sm:max-w-[370px] h-[52px] sm:h-[65px] xl:h-[85px] p-[10px] gap-[10px] rounded-[12px] bg-[#003060] hover:bg-[#001f3f] text-white font-montserrat font-medium text-base sm:text-lg lg:text-xl xl:text-[25px] leading-none tracking-normal inline-flex items-center justify-center transition-all duration-300 shadow-md cursor-pointer hover:scale-[1.02] active:scale-95 whitespace-nowrap"
          >
            <span>{{t 'test.categoryPaidProgram.hero.explore'}}</span>
            <i class="fas fa-arrow-down text-base sm:text-lg xl:text-xl"></i>
          </button>

          <!-- Subtitle -->
          <p class="font-sans font-normal text-base sm:text-lg lg:text-xl xl:text-[30px] leading-relaxed xl:leading-[35px] tracking-normal text-white mb-6 lg:mb-8 xl:mb-12 max-w-xl xl:max-w-2xl">
            {{#if category.description}}
              {{getByLang category.description lang}}
            {{else}}
              Join our next cohort and accelerate your<br />
              career with industry-led learning and real<br />
              projects.
            {{/if}}
          </p>

          <!-- Buttons Row (Slide Up Animation matching Background Layer) -->
          <div 
            class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4 mb-6 xl:mb-14 max-w-full transition-all duration-[1900ms] ease-out"
            :class="isVisible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-[100%]'"
          >
            <button
              onclick="document.getElementById('programs') ? document.getElementById('programs').scrollIntoView({ behavior: 'smooth' }) : window.scrollTo({ top: 700, behavior: 'smooth' })"
              class="w-full sm:flex-1 sm:max-w-[370px] h-[52px] sm:h-[65px] xl:h-[85px] p-[10px] gap-[10px] rounded-[12px] bg-[#003060] hover:bg-[#001f3f] text-white font-montserrat font-medium text-base sm:text-lg lg:text-xl xl:text-[25px] leading-none tracking-normal inline-flex items-center justify-center transition-all duration-300 shadow-md cursor-pointer hover:scale-[1.02] active:scale-95 whitespace-nowrap"
            >
              <span>Explore Learning Path</span>
              <i class="fas fa-arrow-down text-base sm:text-lg xl:text-xl"></i>
            </button>
            <i class="fas fa-headset text-base sm:text-xl xl:text-2xl"></i>
            <span>{{t 'test.categoryPaidProgram.hero.consultation'}}</span>
          </a>
        </div>

            <a
              x-data="{ formatWa(nomor) { if (!nomor) return ''; nomor = nomor.replace(/\D/g, ''); if (nomor.startsWith('0')) return '62' + nomor.slice(1); return nomor; } }"
              :href="'https://wa.me/' + formatWa('{{category.contact}}')"
              target="_blank"
              class="w-full sm:flex-1 sm:max-w-[370px] h-[52px] sm:h-[65px] xl:h-[85px] p-[10px] gap-[10px] rounded-[12px] border border-white bg-transparent text-white font-montserrat font-medium text-base sm:text-lg lg:text-xl xl:text-[25px] leading-none tracking-normal inline-flex items-center justify-center shadow-[0px_0px_4px_0px_rgba(0,0,0,0.5)] transition-all duration-300 hover:bg-white/10 hover:scale-[1.02] active:scale-95 whitespace-nowrap"
            >
              <i class="fas fa-headset text-base sm:text-xl xl:text-2xl"></i>
              <span>Consultation</span>
            </a>
          </div>

        </div>

      </div>
    </div>
  </div>

</section>
