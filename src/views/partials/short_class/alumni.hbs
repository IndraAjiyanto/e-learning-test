<section class='w-full py-20 bg-[#fafafa]'>
    <div class='container mx-auto px-4 lg:px-8 max-w-7xl' 
       x-data="{
          scrollNext() { this.$refs.slider.scrollBy({ left: 380, behavior: 'smooth' }); },
          scrollPrev() { this.$refs.slider.scrollBy({ left: -380, behavior: 'smooth' }); }
       }">
    
    <div class='text-center max-w-3xl mx-auto mb-16 space-y-4'>
      <h2 class='text-3xl md:text-4xl font-semibold font-montserrat leading-tight'>
        <span style="color: #0B1F3B;">Stories From Alumni</span> <span style="color: #6EB6E5;">In House Training</span>
      </h2>
      <p class='max-w-3xl mx-auto text-[16px] md:text-lg leading-relaxed' style="color: rgba(0,0,0,0.6); font-family: 'Open Sans', sans-serif;">
        Hear how our in-house training programs have helped students gain practical skills, industry insights, and greater confidence for their future careers.
      </p>
    </div>
    <!-- Wrapper Slider -->
    <div class="relative w-full">
        
        <div x-ref="slider" class='flex gap-8 overflow-x-auto snap-x snap-mandatory pb-10 pt-4 px-4 scroll-smooth' style='scrollbar-width: none; -ms-overflow-style: none;'>
          <style> div::-webkit-scrollbar { display: none; } </style>
          
          {{#if alumni}}
            {{#each alumni}}
            
            <div class='snap-center flex-shrink-0 flex flex-col justify-between text-left px-8 py-8 transition-transform duration-300 hover:-translate-y-1' 
                 style='width: 360px; height: 420px; border-radius: 12px; background: linear-gradient(180deg, #FFFFFF 0%, #E3F2F9 100%); border: 1px solid #E5E7EB; box-shadow: 0px 4px 15px rgba(0,0,0,0.05);'>
              
              <div>
                <div style="color: #0B1F3B; font-size: 50px; line-height: 0.8; font-family: serif; margin-bottom: 16px;">❝</div>
                <p class='text-[14px] md:text-[15px]' style="color: #4B5563; font-family: 'Open Sans', sans-serif; line-height: 1.8;">
                  {{getByLang message ../lang}}
                </p>
              </div>

              <div>
                <hr class="w-full border-gray-200 mb-5 mt-4" />
                <div class="flex items-center gap-4 h-[72px]">
                  <img src="{{profile}}" alt="Alumni" class="w-14 h-14 rounded-full object-cover shadow-sm" />
                  <div>
                    <h4 class="font-bold text-[15px] md:text-[16px] font-montserrat" style="color: #0B1F3B;">
                      {{getByLang name ../lang}}
                    </h4>
                    <p class="text-[12px] md:text-[13px] mt-1" style="color: #4B5563; font-family: 'Open Sans', sans-serif;">
                      {{getByLang currentPosition ../lang}} <br/>
                      <span class="opacity-75">{{course.name}}</span>
                    </p>
                  </div>
                </div>
              </div>
            </div>
            {{/each}}
          {{else}}
            <p class='w-full text-center py-10 text-gray-500' style="font-family: 'Open Sans', sans-serif;">Belum ada testimoni alumni.</p>
          {{/if}}
        </div>

        <div class="flex items-center justify-center gap-8 mt-4 mb-10" 
             x-data="{ 
                currentPage: 1, 
                totalPages: 5,
                goToPage(page) {
                  this.currentPage = page;
                  this.$refs.slider.scrollTo({ left: (page - 1) * 392, behavior: 'smooth' });
                }
             }">
          
          <!-- Tombol Previous -->
          <button 
            @click="scrollPrev(); currentPage = Math.max(1, currentPage - 1)" 
            class="w-12 h-12 rounded-full flex items-center justify-center text-white shadow-md hover:-translate-y-0.5 hover:bg-[#002244] transition-all duration-300" 
            style="background-color: #0B1F3B;">
            <i class="fas fa-chevron-left"></i>
          </button>
          <!-- Bulir-bulir Titik (Dots) -->
          <div class="flex items-center gap-4">
            <template x-for="page in totalPages" :key="page">
              <button 
                @click="goToPage(page)"
                type="button"
                class="w-2 h-2 rounded-full transition-all duration-300 ease-in-out cursor-pointer"
                :class="currentPage === page ? 'bg-[#0B1F3B] scale-110 shadow-sm' : 'bg-[#D9D9D9] hover:bg-gray-400'"
              ></button>
            </template>
          </div>
          <!-- Tombol Next -->
          <button 
            @click="scrollNext(); currentPage = Math.min(totalPages, currentPage + 1)" 
            class="w-12 h-12 rounded-full flex items-center justify-center text-white shadow-md hover:-translate-y-0.5 hover:bg-[#002244] transition-all duration-300" 
            style="background-color: #0B1F3B;">
            <i class="fas fa-chevron-right"></i>
          </button>
          
        </div>
        <!-- ============================================== -->
        
    </div>
    <!-- Teks Bawah -->
    <div class="text-center">
      <p class="text-[15px] mb-2" style="color: #4B5563; font-family: 'Open Sans', sans-serif;">And many more inspiring stories from our alumni</p>
      <a href="/dashboard/alumni" class="text-[15px] font-semibold underline hover:no-underline transition-all" style="color: #0B1F3B; font-family: 'Open Sans', sans-serif;">
        See all alumni stories &rarr;
      </a>
    </div>
  </div>
</section>