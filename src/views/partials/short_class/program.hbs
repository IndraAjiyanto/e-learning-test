<section id="programs" class="w-full py-20 bg-[#FAFAFA]">
    <div class="mx-auto px-4 lg:px-8 w-full max-w-[1376px]">
    
    <div class="text-center mb-16">
      <h2 class='text-3xl md:text-4xl font-semibold font-montserrat leading-tight mb-4'>
        <span style="color: #6EB6E5;">Short Classes</span> <span style="color: #0B1F3B;">for You</span>
      </h2>
      <p class="text-gray-600 text-[16px] md:text-[17px]" style="font-family: 'Open Sans', sans-serif;">
        Choose the short class that matches your interests and start building practical skills.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      {{#each courses}}
        {{> components/ui/card/category/shortclass/index
            id=this.id
            image=this.image
            name=this.name
            price=this.price
            month=this.month
            method=this.method
            quota=this.quota
        }}
      {{/each}}

      <!-- Placeholder Empty State -->
       {{#unless courses}}
       <div class="col-span-1 md:col-span-2 lg:col-span-3 flex flex-col items-center justify-center py-16 text-center w-full">
        <div class="w-24 h-24 bg-[#EAF4F9] rounded-full flex items-center justify-center mb-6">
          <i class="fa-solid fa-folder-open text-4xl text-[#6EB6E5]"></i>
        </div>
        <h3 class="text-xl font-bold text-[#0B1F3B] mb-2">No Classes Available Yet</h3>
        <p class="text-gray-500 max-w-md">We are currently preparing new exciting short classes. Please check back later!</p>
      </div>
      {{/unless}}

    </div>
  </div>
</section>

