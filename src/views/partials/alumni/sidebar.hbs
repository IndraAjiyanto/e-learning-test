<div class="w-full mx-auto">
  <div class="flex flex-col mb-6 lg:mb-0">
    
    <!-- Sub Filters (Program Dropdown, Search Input, Clear) -->
    <div class="flex flex-col items-stretch w-full gap-3 lg:flex-row lg:items-center lg:gap-6">
      
      <!-- Program Dropdown Group -->
      <div class="flex items-center justify-between shrink-0 w-full gap-2 lg:w-auto lg:justify-start lg:gap-4">
        <h3 class="shrink-0 m-0 font-montserrat font-semibold text-[12px] text-[#0B1F3B] leading-tight lg:text-[25px]">
          {{t 'test.alumni.bootcampProgram'}}
        </h3>
        
        {{! components/common/dropdown }}
        {{> components/alumni/sidebar_program
            items="filteredKelasList"
            selectedValue="selectedKelasId"
            placeholder=(t 'test.alumni.allProgram')
            valueKey="id"
            labelKey="name"
            onSelect="selectKelas"
        }}
      </div>

      <!-- Search Input & Clear Container -->
        <div
          class="flex items-center flex-1 min-w-0 gap-2 lg:gap-4"
          @input.debounce.500ms="currentPage = 1; fetchAlumni()"
        >
          {{> components/alumni/sidebar_search
            value="searchQuery"
            placeholder=(t "test.alumni.searchAlumniPlaceholder")
          }}
        </div>

        <!-- Clear Filter Button -->
        <button
          @click="resetFilters()"
          class="flex items-center justify-center shrink-0 h-auto gap-1.5 px-2 py-2 whitespace-nowrap font-montserrat font-semibold text-[11px] text-[#676767] hover:text-[#0B1F3B] transition-colors lg:h-[60px] lg:gap-3 lg:px-3 lg:py-0 lg:font-medium lg:text-[22px]"
        >
          <i class="fas fa-trash text-xs lg:text-xl"></i>
          <span>{{t 'test.alumni.resetFilters'}}</span>
        </button>

    </div>
  </div>
</div>