<!-- Sidebar Filters -->
<div class='w-full w-full mx-auto'>
  <div
    class='bg-transparent rounded-xl shadow-sm p-6 flex flex-col gap-8'
  >

    <!-- Kelas Filter -->
    <div class='flex-[2] min-w-[300px]'>
      <h3
        class='text-base font-semibold text-gray-900 mb-3 flex items-center font-montserrat'
      >
        {{t 'test.alumni.programTittle'}}
      </h3>

      <div
        class='flex flex-row items-center justify-between gap-2 overflow-x-auto pb-2 no-scrollbar'
      >
        <button
                @click='selectKategori(null), selectKelas(null)'
                :class="!selectedKategoriId ? 'bg-secondary hover:from-primary hover:to-secondary text-white' : 'bg-[#E0F1F9] text-gray-700 hover:bg-gray-50'"
                class='w-auto px-4 py-2.5 rounded-lg font-medium transition-all duration-200 flex-shrink-0 border border-slate-300 shadow-sm'
              ><i class='fas fa-rocket mr-1 text-xl'></i>
                <span class='text-sm whitespace-nowrap'>{{t 'test.alumni.allProgram'}}</span>
              </button>
              <template  x-for="kat in kategoriList" :key="kat.id">
                <button
                
                  @click='selectKategori(kat.id), selectKelas(null)'
                  :class="selectedKategoriId == kat.id ? 'bg-secondary hover:from-primary hover:to-secondary text-white' : 'bg-[#E0F1F9] text-gray-700 hover:bg-gray-50'"
                  class='w-auto px-4 py-2.5 rounded-lg font-medium transition-all duration-200 flex-shrink-0 border border-slate-300 shadow-sm'
                  
                ><i class='fas fa-rocket mr-1 text-xl'></i>
                <span 
          class="text-sm text-left whitespace-nowrap" 
          x-text="getByLang(kat.name, lang) || kat.name || kat.name || 'Kategori ' + kat.id"
        ></span>
                  {{!-- <span
                    class='text-sm text-left'
                    x-text='course.name'
                  ></span> --}}
                </button>
              </template>
      </div>
    </div>

    <!-- Bootcamp Program -->
    <div
      class='flex-[2] min-w-[300px] w-full flex flex-row items-center justify-start gap-4'
    >

      <h3
        class='text-base font-semibold text-gray-900 flex items-center font-montserrat whitespace-nowrap'
      >
        {{t 'test.alumni.bootcampProgram'}}
      </h3>

      <!-- Wrapper Dropdown dengan State Buka/Tutup menggunakan Alpine.js -->
      <div
        class='relative flex-1 max-w-xs'
        x-data='{ open: false }'
        @click.outside='open = false'
      >

        <!-- TOMBOL UTAMA DROPDOWN -->
        <button
          @click='open = !open'
          type='button'
          class='w-full px-4 py-3 bg-[#E0F1F9] text-gray-700 font-medium rounded-lg border border-gray-300 hover:bg-gray-50 transition-all duration-200 flex items-center justify-between shadow-sm focus:outline-none focus:ring-2 focus:ring-gray-400'
        >
          <!-- Menampilkan Teks Program yang Sedang Terpilih secara Dinamis -->
          <span class='text-sm'>
            <template x-if='!selectedKelasId'>
              <span>{{t 'test.alumni.allProgram'}}</span>
            </template>

            <template x-if='selectedKelasId'>
            <span x-text="kelasList.find(k => k.id == selectedKelasId)?.name || ''"></span>
            </template>
          </span>

          <!-- Icon Panah (Indikator Dropdown) yang otomatis berputar saat dibuka -->
          <i
            class='fas fa-chevron-down text-gray-400 transition-transform duration-200'
            :class="open ? 'transform rotate-180' : ''"
          ></i>
        </button>

        <!-- MENU PILIHAN (MENU DROPDOWN) -->
        <div
          x-show='open'
          x-transition:enter='transition ease-out duration-100'
          x-transition:enter-start='transform opacity-0 scale-95'
          x-transition:enter-end='transform opacity-100 scale-100'
          x-transition:leave='transition ease-in duration-75'
          x-transition:leave-start='transform opacity-100 scale-100'
          x-transition:leave-end='transform opacity-0 scale-95'
          class='absolute left-0 mt-2 w-full max-h-60 overflow-y-auto bg-white border border-gray-200 rounded-lg shadow-lg z-50 p-1 space-y-1 focus:outline-none'
          style='display: none;'
        >
          <!-- Pilihan Semua Program -->
          <button
            @click='selectKategori(14);selectKelas(null); open = false'
            :class="!selectedKelasId && selectedKategoriId == 14 ? 'bg-gradient-to-br from-primary via-secondary to-gray-900 text-white' : 'text-gray-700 hover:bg-gray-50'"
            class='w-full px-4 py-2.5 rounded-md text-sm font-medium text-left transition-colors flex items-center justify-between'
          >
            <span>{{t 'test.alumni.allProgram'}}</span>
            <i x-show='!selectedKelasId && selectedKategoriId == KategoriId' class='fas fa-check text-xs'></i>
          </button>

          <!-- Looping List Kelas -->
          <template x-for='course in filteredKelasList' :key='course.id'>
            <button
              @click='selectKategori(course.categoryId);selectKelas(course.id); open = false'
              :class="selectedKelasId == course.id ? 'bg-gradient-to-br from-primary via-secondary to-gray-900 text-white' : 'text-gray-700 hover:bg-gray-50'"
              class='w-full px-4 py-2.5 rounded-md text-sm font-medium text-left transition-colors flex items-center justify-between'
            >
              <span x-text='course.name'></span>
              <i
                x-show='selectedKelasId == course.id'
                class='fas fa-check text-xs'
              ></i>
            </button>
          </template>
        </div>
      </div>

      <!-- Search Alumni -->
      <div class='min-w-[240px] flex flex-row items-center justify-start gap-4'>
        <div class='relative'>
          <input
            type='text'
            x-model='searchQuery'
            @input.debounce.500ms='currentPage = 1; fetchAlumni()'
            placeholder='{{t "test.alumni.searchAlumniPlaceholder"}}'
            class='w-full text-gray-600 px-4 py-3 pl-10 bg-[#E0F1F9] rounded-lg border border-gray-300 focus:border-gray-700 focus:ring-2 focus:ring-gray-700 transition-all duration-200'
          />
          <i
            class='fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400'
          ></i>
        </div>
      </div>

      <!-- Active Filters -->
      <div
        class='text-base font-semibold text-gray-900 h-full self-stretch rounded-lg bg-transparent flex items-center font-montserrat overflow-hidden'
      >
        <button
                @click='resetFilters()'
                class='text-base text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors flex items-center justify-center h-full w-full py-3 px-5 whitespace-nowrap font-medium'
              >
                <i class='fas fa-rocket mr-1 text-xl'></i>
                {{t 'test.alumni.resetFilters'}}
              </button>
            </div>
            <div class='space-y-2'>
              <template x-if="selectedKelas === ''">
                <div
                  class='text-xs text-gray-500 text-center py-2 bg-white rounded border border-gray-200'
                >
                  {{t 'test.alumni.noFilters'}}
                </div>
              </template>

              <template x-if="selectedKelas !== ''">
                <span
                  class='block px-3 py-1 text-xs rounded-full bg-gradient-to-r from-slate-100 to-slate-200 text-gray-700 font-medium border border-gray-300'
                >
                  <span x-text='selectedKelas'></span>
                </span>
              </template>
      </div>
    </div>
</div>
  </div>


</div>