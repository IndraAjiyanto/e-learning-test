<!-- Sidebar Filters Container -->
<div class='w-full mx-auto'>
  <!-- MOBILE SIDEBAR FILTER (< 640px) -->
  <div class="block sm:hidden flex flex-col gap-4 mb-6">
    <!-- Row 1: Program Type Pills -->
    <div class="flex flex-wrap gap-2">
      <!-- Kategori Looping -->
      <template x-for="kat in kategoriList" :key="kat.id">
        <button
          @click="selectKategori(kat.id)"
          :class="selectedKategoriId == kat.id ? 'bg-[#0B1F3B] text-white' : 'bg-[#E0F1F9] text-[#0B1F3B] hover:bg-[#d0e8f5]'"
          class="px-3.5 py-2.5 rounded-[12px] font-montserrat font-semibold text-[12px] transition-all flex items-center gap-2 shadow-2xs"
        >
          <i class="fas fa-graduation-cap text-sm"></i>
          <span x-text="getByLang(kat.name, lang) || kat.name || 'Kategori ' + kat.id"></span>
        </button>
      </template>
    </div>

    <!-- Row 2: Dropdown Program & Search -->
    <div class="flex flex-col gap-3 mt-1">
      <!-- Dropdown Kelas Program -->
      <div class="flex items-center gap-2">
        <span class="font-montserrat font-semibold text-[12px] text-[#0B1F3B] shrink-0">Program:</span>
        <div class="relative flex-1" x-data="{ open: false }" @click.outside="open = false">
          <button
            @click="open = !open"
            type="button"
            class="w-full px-3 py-2 bg-[#E0F1F9] text-[#0B1F3B] font-montserrat font-semibold text-[12px] rounded-[10px] flex items-center justify-between shadow-2xs"
          >
            <span class="truncate text-left flex-1">
              <template x-if="!selectedKelasId">
                <span>{{t 'test.alumni.allProgram'}}</span>
              </template>
              <template x-if="selectedKelasId">
                <span x-text="kelasList.find(k => k.id == selectedKelasId)?.name || ''"></span>
              </template>
            </span>
            <i class="fas fa-chevron-down text-[#003060] text-xs transition-transform" :class="open ? 'rotate-180' : ''"></i>
          </button>

          <!-- Dropdown Options -->
          <div
            x-show="open"
            x-transition
            class="absolute left-0 mt-1 w-full max-h-52 overflow-y-auto bg-white border border-[#E0F1F9] rounded-[10px] shadow-lg z-50 p-1 space-y-0.5"
          >
            <button
              @click="selectKelas(null); open = false"
              :class="!selectedKelasId ? 'bg-[#0B1F3B] text-white' : 'text-gray-700 hover:bg-gray-50'"
              class="w-full px-3 py-2 rounded-md font-montserrat font-medium text-[11px] text-left flex items-center justify-between"
            >
              <span>{{t 'test.alumni.allProgram'}}</span>
              <i x-show="!selectedKelasId" class="fas fa-check"></i>
            </button>

            <template x-for="course in filteredKelasList" :key="course.id">
              <button
                @click="selectKelas(course.id); open = false"
                :class="selectedKelasId == course.id ? 'bg-[#0B1F3B] text-white' : 'text-gray-700 hover:bg-gray-50'"
                class="w-full px-3 py-2 rounded-md font-montserrat font-medium text-[11px] text-left flex items-center justify-between"
              >
                <span x-text="course.name"></span>
                <i x-show="selectedKelasId == course.id" class="fas fa-check"></i>
              </button>
            </template>
          </div>
        </div>
      </div>

      <!-- Search Input & Clear -->
      <div class="flex items-center gap-2">
        <div class="relative flex-1">
          <input
            type="text"
            x-model="searchQuery"
            @input.debounce.500ms="currentPage = 1; fetchAlumni()"
            placeholder='{{t "test.alumni.searchAlumniPlaceholder"}}'
            class="w-full pl-9 pr-3 py-2 bg-[#E0F1F9] text-[#0B1F3B] rounded-[10px] font-montserrat font-medium text-[12px] placeholder-[#676767] focus:outline-none shadow-2xs"
          />
          <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-xs"></i>
        </div>

        <button
          @click="resetFilters()"
          class="font-montserrat font-semibold text-[11px] text-[#676767] hover:text-[#0B1F3B] transition-colors shrink-0 px-2 py-2"
        >
          Clear
        </button>
      </div>
    </div>
  </div>

  <!-- DESKTOP SIDEBAR FILTER (>= 640px) -->
  <div class='hidden sm:block bg-transparent flex flex-col gap-[30px]'>

    <!-- Container for Rows -->
    <div class='flex flex-col gap-[30px]'>
      
      <!-- Row 1: Categories (Gap 16px) -->
      <div class='flex flex-row flex-wrap items-center gap-[16px]'>

        <!-- Kategori Looping -->
        <template x-for="kat in kategoriList" :key="kat.id">
          <button
            @click='selectKategori(kat.id)'
            :class="selectedKategoriId == kat.id ? 'bg-[#0B1F3B] text-white' : 'bg-[#E0F1F9] text-black hover:bg-[#d0e8f5]'"
            class='px-[20px] rounded-[12px] font-montserrat font-medium transition-all duration-200 flex items-center justify-center gap-[10px] flex-shrink-0'
            style="height: 60px; box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.5); font-size: 25px; line-height: 30px; min-width: 243px;"
          >
            <i class='fas fa-graduation-cap' style="font-size: 28px;"></i>
            <span class="text-left whitespace-nowrap" x-text="getByLang(kat.name, lang) || kat.name || 'Kategori ' + kat.id"></span>
          </button>
        </template>
      </div>

      <!-- Row 2: Sub Filters (Inline Single Desktop Row) -->
      <div class='flex flex-row items-center gap-5 lg:gap-6 w-full'>
        
        <!-- Bootcamp Program Title -->
        <h3 class='text-[#0B1F3B] font-montserrat font-semibold m-0 shrink-0 text-xl lg:text-[25px] leading-tight'>
          {{t 'test.alumni.bootcampProgram'}}
        </h3>

        <!-- Dropdown Kelas -->
        <div class='relative w-[260px] lg:w-[340px] shrink-0' x-data='{ open: false }' @click.outside='open = false'>
          <button
            @click='open = !open'
            type='button'
            class='w-full px-[18px] bg-[#E0F1F9] text-black font-montserrat font-medium rounded-[12px] flex items-center justify-between transition-all duration-200 focus:outline-none h-[60px] text-lg lg:text-[22px]'
            style="box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.5);"
          >
            <span class='truncate text-left flex-1'>
              <template x-if='!selectedKelasId'>
                <span>{{t 'test.alumni.allProgram'}}</span>
              </template>
              <template x-if='selectedKelasId'>
                <span x-text="kelasList.find(k => k.id == selectedKelasId)?.name || ''"></span>
              </template>
            </span>
            <i class='fas fa-chevron-down text-[#003060] transition-transform duration-200 ml-2 text-xl' :class="open ? 'transform rotate-180' : ''"></i>
          </button>

          <!-- Dropdown Options -->
          <div
            x-show='open'
            x-transition.opacity.duration.200ms
            class='absolute left-0 mt-2 w-full max-h-60 overflow-y-auto bg-white border border-gray-200 rounded-[12px] shadow-lg z-50 p-2 space-y-1 focus:outline-none'
            style='display: none;'
          >
            <!-- All Program Option -->
            <button
              @click='selectKelas(null); open = false'
              :class="!selectedKelasId ? 'bg-[#0B1F3B] text-white' : 'text-gray-700 hover:bg-gray-50'"
              class='w-full px-4 py-3 rounded-lg font-montserrat font-medium transition-colors flex items-center justify-between text-base lg:text-lg'
            >
              <span>{{t 'test.alumni.allProgram'}}</span>
              <i x-show='!selectedKelasId' class='fas fa-check'></i>
            </button>

            <!-- Looping List Kelas Option -->
            <template x-for='course in filteredKelasList' :key='course.id'>
              <button
                @click='selectKelas(course.id); open = false'
                :class="selectedKelasId == course.id ? 'bg-[#0B1F3B] text-white' : 'text-gray-700 hover:bg-gray-50'"
                class='w-full px-4 py-3 rounded-lg font-montserrat font-medium transition-colors flex items-center justify-between text-base lg:text-lg'
              >
                <span x-text='course.name'></span>
                <i x-show='selectedKelasId == course.id' class='fas fa-check'></i>
              </button>
            </template>
          </div>
        </div>

        <!-- Search Alumni Input -->
        <div class='relative flex-1 min-w-[200px]'>
          <input
            type='text'
            x-model='searchQuery'
            @input.debounce.500ms='currentPage = 1; fetchAlumni()'
            placeholder='{{t "test.alumni.searchAlumniPlaceholder"}}'
            class='w-full text-black pl-[50px] pr-[20px] bg-[#E0F1F9] rounded-[12px] font-montserrat font-medium placeholder-[#676767] focus:outline-none transition-all duration-200 h-[60px] text-lg lg:text-[22px]'
            style="box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.5);"
          />
          <i class='fas fa-search absolute left-[18px] top-1/2 transform -translate-y-1/2 text-black text-xl'></i>
        </div>

        <!-- Clear Filter Button -->
        <button
          @click='resetFilters()'
          class='flex items-center justify-center gap-3 whitespace-nowrap font-montserrat font-medium text-[#676767] hover:text-[#0B1F3B] transition-colors shrink-0 px-3 h-[60px] text-lg lg:text-[22px]'
        >
          <i class='fas fa-trash text-xl'></i>
          <span>{{t 'test.alumni.resetFilters'}}</span>
        </button>

      </div>
    </div>

  </div>
</div>