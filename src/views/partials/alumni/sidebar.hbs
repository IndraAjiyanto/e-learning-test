<!-- Sidebar Filters -->
<div class='w-full mx-auto'>
  <div class='bg-transparent flex flex-col gap-[30px]'>

    <!-- Filter by Program Type Title -->
    <h3 class='text-[#0B1F3B] font-montserrat font-semibold m-0' style="font-size: 25px; line-height: 30px;">
      {{t 'test.alumni.programTittle'}}
    </h3>

    <!-- Container for Rows -->
    <div class='flex flex-col gap-[30px]'>
      
      <!-- Row 1: Categories (Gap 16px) -->
      <div class='flex flex-row flex-wrap items-center gap-[16px]'>
        <!-- All Programs -->
        <button
          @click='selectKategori(null)'
          :class="!selectedKategoriId ? 'bg-[#0B1F3B] text-white' : 'bg-[#E0F1F9] text-black hover:bg-[#d0e8f5]'"
          class='px-[20px] rounded-[12px] font-montserrat font-medium transition-all duration-200 flex items-center justify-center gap-[10px] flex-shrink-0'
          style="height: 60px; box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.5); font-size: 25px; line-height: 30px; min-width: 270px;"
        >
          <i class='fas fa-th-large' style="font-size: 28px;"></i>
          <span class='whitespace-nowrap'>{{t 'test.alumni.allProgram'}}</span>
        </button>

        <!-- Kategori Looping -->
        <template x-for="kat in kategoriList" :key="kat.id">
          <button
            @click='selectKategori(kat.id)'
            :class="selectedKategoriId == kat.id ? 'bg-[#0B1F3B] text-white' : 'bg-[#E0F1F9] text-black hover:bg-[#d0e8f5]'"
            class='px-[20px] rounded-[12px] font-montserrat font-medium transition-all duration-200 flex items-center justify-center gap-[10px] flex-shrink-0'
            style="height: 60px; box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.5); font-size: 25px; line-height: 30px; min-width: 243px;"
          >
            <i class='fas fa-graduation-cap' style="font-size: 28px;"></i>
            <span class="text-left whitespace-nowrap" x-text="getByLang(kat.name, lang) || kat.name || 'Kategori ' + kat.id"></span>
          </button>
        </template>
      </div>

      <!-- Row 2: Sub Filters -->
      <div class='flex flex-row flex-wrap items-center gap-[30px]'>
        
        <!-- Group 1: Title & Dropdown -->
        <div class="flex flex-row items-center gap-[16px]">
          <!-- Bootcamp Program Title -->
          <h3 class='text-[#0B1F3B] font-montserrat font-semibold text-center m-0' style="font-size: 25px; line-height: 30px; min-width: 271px;">
            {{t 'test.alumni.bootcampProgram'}}
          </h3>

          <!-- Dropdown Kelas -->
          <div class='relative flex-shrink-0' x-data='{ open: false }' @click.outside='open = false' style="width: 423px;">
            <button
              @click='open = !open'
              type='button'
              class='w-full px-[20px] bg-[#E0F1F9] text-black font-montserrat font-medium rounded-[12px] flex items-center justify-between transition-all duration-200 focus:outline-none'
              style="height: 60px; box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.5); font-size: 25px; line-height: 30px;"
            >
              <span class='truncate text-left flex-1'>
                <template x-if='!selectedKelasId'>
                  <span>{{t 'test.alumni.allProgram'}}</span>
                </template>
                <template x-if='selectedKelasId'>
                  <span x-text="kelasList.find(k => k.id == selectedKelasId)?.name || ''"></span>
                </template>
              </span>
              <i class='fas fa-chevron-down text-[#003060] transition-transform duration-200' :class="open ? 'transform rotate-180' : ''" style="font-size: 28px;"></i>
            </button>

            <!-- Dropdown Options -->
            <div
              x-show='open'
              x-transition.opacity.duration.200ms
              class='absolute left-0 mt-2 w-full max-h-60 overflow-y-auto bg-white border border-gray-200 rounded-[12px] shadow-lg z-50 p-2 space-y-1 focus:outline-none'
              style='display: none;'
            >
              <!-- All Program Option -->
              <button
                @click='selectKelas(null); open = false'
                :class="!selectedKelasId ? 'bg-[#0B1F3B] text-white' : 'text-gray-700 hover:bg-gray-50'"
                class='w-full px-4 py-3 rounded-lg font-montserrat font-medium transition-colors flex items-center justify-between'
                style="font-size: 20px;"
              >
                <span>{{t 'test.alumni.allProgram'}}</span>
                <i x-show='!selectedKelasId' class='fas fa-check'></i>
              </button>

              <!-- Looping List Kelas Option -->
              <template x-for='course in filteredKelasList' :key='course.id'>
                <button
                  @click='selectKelas(course.id); open = false'
                  :class="selectedKelasId == course.id ? 'bg-[#0B1F3B] text-white' : 'text-gray-700 hover:bg-gray-50'"
                  class='w-full px-4 py-3 rounded-lg font-montserrat font-medium transition-colors flex items-center justify-between'
                  style="font-size: 20px;"
                >
                  <span x-text='course.name'></span>
                  <i x-show='selectedKelasId == course.id' class='fas fa-check'></i>
                </button>
              </template>
            </div>
          </div>
        </div>

        <!-- Group 2: Search & Clear -->
        <div class="flex flex-row items-center gap-[16px]">
          <!-- Search Alumni -->
          <div class='relative flex-shrink-0' style="width: 423px;">
            <input
              type='text'
              x-model='searchQuery'
              @input.debounce.500ms='currentPage = 1; fetchAlumni()'
              placeholder='{{t "test.alumni.searchAlumniPlaceholder"}}'
              class='w-full text-black pl-[50px] pr-[20px] bg-[#E0F1F9] rounded-[12px] font-montserrat font-medium placeholder-[#676767] focus:outline-none transition-all duration-200'
              style="height: 60px; box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.5); font-size: 25px; line-height: 30px;"
            />
            <i class='fas fa-search absolute left-[18px] top-1/2 transform -translate-y-1/2 text-black' style="font-size: 24px;"></i>
          </div>

          <!-- Clear Filter -->
          <button
            @click='resetFilters()'
            class='flex items-center justify-center gap-[15px] whitespace-nowrap font-montserrat font-medium text-[#676767] hover:text-[#0B1F3B] transition-colors flex-shrink-0'
            style="width: 228px; height: 35px; font-size: 25px; line-height: 30px;"
          >
            <i class='fas fa-trash' style="font-size: 28px;"></i>
            {{t 'test.alumni.resetFilters'}}
          </button>
        </div>

      </div>
    </div>

  </div>
</div>