<!-- Alumni Grid -->
<div class='lg:col-span-3 mt-24'>
  <!-- Alumni Cards -->
  <div class='grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6'>
    <template x-for='alumni in alumniItems' :key='alumni.id'>
      <div
        class='flex flex-col mx-auto max-w-xs p-5 bg-[#E0F1F980] rounded-lg sm:rounded-xl transition-all duration-300 shadow-lg hover:-translate-y-1 hover:shadow-xl'
      >
        <!-- Profile Header -->
        <div
          class='bg-[#E0F1F980] p-4'
        >
          <!-- Profile Image -->
          <div class='flex items-center gap-3'>
            <div class='relative flex-shrink-0'>
              <img
                :src="alumni.profile || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + alumni.nama"
                :alt='alumni.nama'
                class='w-12 h-12 rounded-full border-4 border-white shadow-md object-cover'
              />
            </div>
            <div class='flex-1 min-w-0'>
              <h3
                class='font-bold text-gray-900 text-lg truncate'
                x-text='getByLang(alumni.nama, lang)'
              ></h3>
               <p
                  class='text-gray-900 text-sm'
                  x-text='getByLang(alumni.posisi_sekarang, lang)'
                ></p>
             
            </div>
          </div>
        </div>

        <!-- Card Content -->
        <div class='p-4 flex-1 flex flex-col justify-between'>
          <!-- Current Position -->
          {{!-- <div class='bg-gray-50 rounded-lg p-4 border border-gray-200'>
            <div class='flex items-start gap-3'>
              <div
                class='w-10 h-10 bg-gradient-to-br from-primary via-secondary to-gray-900 rounded-lg flex items-center justify-center flex-shrink-0'
              >
                <i class='fas fa-briefcase text-white text-sm'></i>
              </div>
              <div class='flex-1 min-w-0'>
                <p
                  class='text-xs font-semibold text-gray-600 uppercase tracking-wide mb-1'
                >
                  {{t 'test.alumni.program'}}
                </p>
               
                <p
                  class='text-xs text-gray-500 mt-1'
                  x-text="getByLang(alumni.alumni, lang) || 'Unknown'"
                ></p>
              </div>
            </div>
          </div> --}}

          <!-- Testimonial -->
          <div class='flex flex-col items-start gap-2.5'>
            <div
              class='w-6 h-6 bg-gray-900 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5'
            >
              {{!-- <div
                class='w-8 h-8 bg-gradient-to-br from-primary via-secondary to-gray-900 rounded-full flex items-center justify-center flex-shrink-0 mt-1'
              > --}}
                <i class='fas fa-quote-left text-white text-xs'></i>
              </div>
              <div class='flex-1 min-w-0'>
                <p
                  class='text-sm text-gray-700 leading-relaxed'
                  x-text='getByLang(alumni.pesan, lang)'
                ></p>
              </div>
            </div>
          </div>

         <div class="flex">
  <i 
    class='fas fa-rocket mr-1 text-sm'
    :class="getKelasName(alumni).toLowerCase().includes('back') ? 'text-green-600' : (getKelasName(alumni).toLowerCase().includes('front') ? 'text-red-600'  : (getKelasName(alumni).toLowerCase().includes('full') ? 'text-indigo-600' : 'text-gray-600')) " 
  ></i>
  
  <p
    class='text-sm truncate font-medium'
    :class="getKelasName(alumni).toLowerCase().includes('back') ? 'text-green-600' : (getKelasName(alumni).toLowerCase().includes('front') ? 'text-red-600' : (getKelasName(alumni).toLowerCase().includes('full') ? 'text-indigo-600' : 'text-gray-600')) "
    x-text='getKelasName(alumni)'
  ></p>
</div>

           

        </div>
      </div>
    </template>
  </div>

  <!-- No Results Message -->
  <div x-show='alumniItems.length === 0' class='text-center py-12'>
    <div
      class='w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4'
    >
      <i class='fas fa-users text-gray-400 text-2xl'></i>
    </div>
    <h3 class='text-xl font-semibold text-gray-900 mb-2'>{{t
        'test.alumni.noAlumni'
      }}</h3>
    <p class='text-gray-600 mb-6'>{{t 'test.alumni.tryAdjusting'}}</p>
    <button
      @click='resetFilters()'
      class='bg-secondary hover:from-primary hover:to-secondary text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition-all duration-300 border border-gray-700'
    >
      {{t 'test.alumni.resetFilters'}}
    </button>
  </div>

  <!-- Pagination -->
  <div
    class='flex justify-center items-center gap-4 mt-12'
    x-show='totalPages > 1'
  >
    <button
      @click='changePage(Math.max(1, currentPage - 1))'
      :disabled='currentPage === 1'
      class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'
    >
      <i class='fas fa-chevron-left'></i>
    </button>

    <template x-for='page in totalPages' :key='page'>
      <button
        @click='changePage(page)'
        class='w-12 h-12 rounded-xl text-lg font-semibold transition-all duration-300 border shadow-sm'
        :class="currentPage === page ? 'bg-gradient-to-r from-slate-600 to-slate-800 text-white border-slate-700 shadow-md' : 'bg-white text-gray-700 border-gray-300 hover:bg-slate-50'"
        x-text='page'
      ></button>
    </template>

    <button
      @click='changePage(Math.min(totalPages, currentPage + 1))'
      :disabled='currentPage === totalPages'
      class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'
    >
      <i class='fas fa-chevron-right'></i>
    </button>
  </div>


</div>