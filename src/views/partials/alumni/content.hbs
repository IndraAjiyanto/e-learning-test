<div class="w-full mt-6 lg:mt-8 flex flex-col justify-between">
  <!-- UNIFIED ALUMNI CARDS GRID -->
  <div x-show="alumniItems.length > 0" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 min-h-[500px]">
    <template x-for="alumni in alumniItems" :key="alumni.id">
      
      <!-- Unified Responsive Card -->
      <div class="flex flex-col relative w-full p-5 bg-[#E0F1F9]/50 rounded-[12px] shadow-[0px_0px_8px_rgba(0,0,0,0.5)] backdrop-blur-[3.3px] transition-all duration-300 hover:-translate-y-2 lg:min-h-[506px] lg:p-[29px_26px]">
        
        <!-- Kontainer Utama (Profil & Kutipan) -->
        <div class="flex flex-col w-full gap-4 lg:gap-[30px]">
          
          <!-- Wrapper Profil (Gambar + Teks) -->
          <div class="flex flex-row items-center w-full gap-3 lg:gap-[26px]">
            <!-- Foto Profil -->
            <img
              :src="alumni.profile || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + alumni.name"
              :alt="getByLang(alumni.name, lang)"
              class="shrink-0 size-[60px] rounded-full object-cover lg:size-[100px]"
            />
            
            <!-- Nama & Posisi -->
            <div class="flex flex-col items-start overflow-hidden w-full gap-1 lg:gap-[6px]">
              <h3 class="w-full font-sans font-semibold text-base leading-tight text-[#000000] truncate lg:text-[20px] lg:leading-[27px]" x-text="getByLang(alumni.name, lang)"></h3>
              <p class="w-full font-sans font-normal text-xs leading-snug text-[#000000] line-clamp-2 lg:text-[20px] lg:leading-[27px]" x-text="getByLang(alumni.currentPosition, lang)"></p>
            </div>
          </div>

          <!-- Wrapper Kutipan (Icon + Teks) -->
          <div class="flex flex-col items-start w-full gap-2 lg:gap-[13px]">
            <!-- Icon Kutipan -->
            <div class="flex items-center justify-center shrink-0 size-[32px] text-[#0B1F3B] lg:size-[50px]">
              <i class="fas fa-quote-left text-2xl lg:text-[40px]"></i>
            </div>
            <!-- Teks Kutipan -->
            <p class="w-full font-sans font-normal text-xs leading-relaxed text-[#000000] line-clamp-5 lg:text-[20px] lg:leading-[30px]" x-text="getByLang(alumni.message, lang)"></p>
          </div>
        </div>

        <!-- Wrapper Badge Program (Bawah) -->
        <div class="flex flex-row items-center justify-center w-full mt-6 lg:mt-auto">
          <div class="flex flex-row items-center justify-center h-[26px] gap-[10px] px-3.5 bg-[#F1EDFD] rounded-[6px] lg:px-[15px]">
            <span class="max-w-full font-sans font-normal text-xs leading-none text-[#4F2CD7] truncate lg:text-[15px] lg:leading-[20px]" x-text="(alumni.kelas?.kategori?.nama_kategori || alumni.course?.category?.nama_kategori ? (alumni.kelas?.kategori?.nama_kategori || alumni.course?.category?.nama_kategori) + ': ' : '') + getKelasName(alumni)"></span>
          </div>
        </div>

      </div>

    </template>
  </div>

  <!-- No Results Message -->
  {{> components/ui/empty_state/index
  show="alumniItems.length === 0"
  icon="fas fa-users"
  title=(t 'test.alumni.noAlumni')
  description=(t 'test.alumni.tryAdjusting')
  actionText=(t 'test.alumni.resetFilters')
  onAction="resetFilters()"
}}

  <!-- Pagination -->
   {{> components/ui/pagination/index
    currentPage="currentPage"
    totalPages="totalPages"
    onPageChange="changePage"
  }}
</div>