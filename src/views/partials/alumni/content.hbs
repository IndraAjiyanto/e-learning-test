<!-- Alumni Grid -->
<div class='w-full mt-8'>
  <!-- Alumni Cards -->
  <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'>
       <template x-for='alumni in alumniItems' :key='alumni.id'>
      
      <!-- Desain Card (Glassmorphism & Layout presisi dari Figma) -->
      <div 
        class='flex flex-col relative transition-all duration-300 hover:-translate-y-2' 
        style="width: 100%; min-height: 506px; background: rgba(224, 241, 249, 0.5); box-shadow: 0px 0px 8px rgba(0, 0, 0, 0.5); backdrop-filter: blur(3.3px); border-radius: 12px; padding: 29px 26px;"
      >
        <!-- Kontainer Utama (Profil & Kutipan) -> Gap 30px -->
        <div class='flex flex-col w-full' style="gap: 30px;">
          
          <!-- Wrapper Profil (Gambar + Teks) -> Gap 26px (Row layout) -->
          <div class='flex flex-row items-center w-full' style="gap: 26px;">
            <!-- Foto Profil (100x100) -->
            <img
              :src="alumni.profile || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + alumni.name"
              :alt='alumni.name'
              class='rounded-full object-cover flex-shrink-0'
              style="width: 100px; height: 100px;"
            />
            
            <!-- Nama & Posisi (Kolom) -> Gap 6px -->
            <div class='flex flex-col items-start overflow-hidden w-full' style="gap: 6px;">
              <h3 class='truncate w-full m-0 p-0' style="font-family: 'Open Sans'; font-weight: 600; font-size: 20px; line-height: 27px; color: #000000;" x-text='getByLang(alumni.name, lang)'></h3>
              <p class='w-full line-clamp-2 m-0 p-0' style="font-family: 'Open Sans'; font-weight: 400; font-size: 20px; line-height: 27px; color: #000000;" x-text='getByLang(alumni.currentPosition, lang)'></p>
            </div>
          </div>

          <!-- Wrapper Kutipan (Icon + Teks) -> Gap 13px -->
          <div class='flex flex-col items-start w-full' style="gap: 13px;">
            <!-- Icon Kutipan (50x50, Warna #0B1F3B) -->
            <div class='flex justify-center items-center flex-shrink-0 text-[#0B1F3B]' style="width: 50px; height: 50px;">
              <i class='fas fa-quote-left' style="font-size: 40px;"></i>
            </div>
            <!-- Teks Kutipan -->
            <p class='line-clamp-5 m-0 p-0 w-full' style="font-family: 'Open Sans'; font-weight: 400; font-size: 20px; line-height: 30px; color: #000000;" x-text='getByLang(alumni.message, lang)'></p>
          </div>
        </div>

        <!-- Wrapper Badge Program (Bawah) -> Margin atas otomatis agar selalu di bagian paling bawah -->
        <div class='flex flex-row justify-center items-center w-full mt-auto'>
          <!-- Badge Background -> Height 26px, bg #F1EDFD -->
          <div class='flex flex-row justify-center items-center' style="gap: 10px; background: #F1EDFD; border-radius: 6px; height: 26px; padding: 0 15px;">
            <span class='truncate max-w-full m-0 p-0' style="font-family: 'Open Sans'; font-weight: 400; font-size: 15px; line-height: 20px; color: #4F2CD7;" x-text="(alumni.kelas?.kategori?.nama_kategori ? alumni.kelas.kategori.nama_kategori + ': ' : '') + getKelasName(alumni)"></span>
          </div>
        </div>
      </div>

    </template>
  </div>

  <!-- No Results Message -->
  <div x-show='alumniItems.length === 0' class='text-center py-12'>
    <div class='w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4'>
      <i class='fas fa-users text-gray-400 text-2xl'></i>
    </div>
    <h3 class='text-xl font-semibold text-gray-900 mb-2'>{{t 'test.alumni.noAlumni'}}</h3>
    <p class='text-gray-600 mb-6'>{{t 'test.alumni.tryAdjusting'}}</p>
    <button
      @click='resetFilters()'
      class='bg-secondary text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition-all duration-300 border border-gray-700'
    >
      {{t 'test.alumni.resetFilters'}}
    </button>
  </div>

  <!-- Pagination -->
  <div
    class='flex justify-center items-center gap-2 mt-12'
    x-show='totalPages > 1'
  >
    <button
      @click='changePage(Math.max(1, currentPage - 1))'
      :disabled='currentPage === 1'
      class='w-9 h-9 flex items-center justify-center rounded-full bg-white border border-gray-300 text-gray-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed transition shadow-sm'
    >
      <i class='fas fa-chevron-left text-sm'></i>
    </button>

    <template x-for='page in totalPages' :key='page'>
      <button
        @click='changePage(page)'
        class='w-9 h-9 flex items-center justify-center rounded-full text-sm font-semibold border transition shadow-sm'
        :class="currentPage === page ? 'bg-gray-900 text-white border-gray-900' : 'bg-white text-gray-700 border-gray-300 hover:bg-slate-50'"
        x-text='page'
      ></button>
    </template>

    <button
      @click='changePage(Math.min(totalPages, currentPage + 1))'
      :disabled='currentPage === totalPages'
      class='w-9 h-9 flex items-center justify-center rounded-full bg-white border border-gray-300 text-gray-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed transition shadow-sm'
    >
      <i class='fas fa-chevron-right text-sm'></i>
    </button>
  </div>
</div>