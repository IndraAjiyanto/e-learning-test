<!-- SCHEDULE & FEES SECTION -->
<section id="schedule-fees" class="bg-[#FAFAFA] py-20 font-montserrat">
  <div class="container mx-auto px-4 lg:px-12 max-w-[1400px] flex flex-col items-center">
    
    <div class="inline-flex items-center justify-center border border-[#003060] bg-[#6EB6E5]/[20%] text-[#003060] px-14 py-2.5 rounded-[100px] font-[600] text-[16px] mb-8">
      Schedule & Fees
    </div>
    
    <h1 class="text-2xl md:text-4xl font-bold text-[#0F0F0F] mb-10 text-center">Kickstart Your Career Today</h1>
    <div class="w-full max-w-[1000px]" x-data="{ tab: 'full', openInfo: false }">
      
      <!-- Toggles -->
      <div class="flex items-center justify-center mb-10 w-full">
        <div class="flex items-center bg-[#F0F0F0] rounded-[100px] p-1.5 w-full">
          <button @click="tab = 'full'" :class="tab === 'full' ? 'bg-[#003060] text-white shadow-md' : 'text-[#545454] hover:text-[#0F0F0F]'" class="w-1/2 py-2.5 rounded-[100px] text-[16px] md:text-[25px] font-[600] transition-all duration-300">Full Payment</button>
          <button @click="tab = 'cicilan'" :class="tab === 'cicilan' ? 'bg-[#003060] text-white shadow-md' : 'text-[#545454] hover:text-[#0F0F0F]'" class="w-1/2 py-2.5 rounded-[100px] text-[16px] md:text-[25px] font-[600] transition-all duration-300">Cicilan</button>
        </div>
      </div>
      
      <!-- Content Wrapper -->
      <div class="w-full flex flex-col">
        
        <!-- FULL PAYMENT CONTENT -->
        <div x-show="tab === 'full'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" class="w-full">
           <div class="flex items-center gap-4 mb-2">
             <span class="text-[#2D2D2D] text-[24px] md:text-[40px] font-[400] line-through decoration-[1px]">Rp {{course.price}}</span>
             <span class="bg-[#003060] text-white text-[16px] md:text-[25px] font-[500] px-4 md:px-6 py-1 md:py-2 rounded-full">Save Rp {{subtract course.price course.promo}}</span>
           </div>
           <div class="text-[#0F0F0F] text-[32px] md:text-[50px] font-[600] mb-6 tracking-tight">Rp {{course.promo}}</div>
        </div>

        <!-- CICILAN CONTENT -->
        <div x-show="tab === 'cicilan'" style="display: none;" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" class="w-full">
           <div class="text-[#2D2D2D] text-[24px] md:text-[40px] font-[400] mb-2 line-through decoration-[1px]">Rp {{course.price}}</div>
           {{#each installments}}
           <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4 mb-6">
             <div class="text-[#0F0F0F] text-[32px] md:text-[50px] font-[600] leading-none tracking-tight whitespace-nowrap">Rp {{this.downPayment}}</div>
             <div class="text-[#0F0F0F] text-[16px] md:text-[25px] font-[400] whitespace-normal md:whitespace-nowrap text-center md:text-left">Flexible payment plans up to {{this.month}} months</div>
           </div>
           {{/each}}
        </div>

        <!-- Countdown (Shared) -->
        <div class="flex flex-col md:flex-row items-center text-[#0F0F0F] text-[18px] md:text-[35px] font-[500] mb-6">
          <i class="far fa-clock mr-2"></i> 
          <span>Offer Ends In </span>
          <span class="text-[#D32F2F] font-[500] ml-2 tracking-wide">##15 Days &nbsp; 11 : 50 : 05##</span>
        </div>

        <!-- Installment Information Accordion (Only for Cicilan) -->
        <div x-show="tab === 'cicilan'" style="display: none;" class="w-full mb-6">
          <button @click="openInfo = !openInfo" class="w-full flex justify-between items-center text-[#FFED00] font-[400] text-[18px] md:text-[35px] cursor-pointer hover:opacity-80 transition-opacity">
            <div class="flex items-center gap-2">
              <i class="far fa-info-circle"></i> Installment Information
            </div>
            <i class="fas fa-chevron-down text-[#0F0F0F] text-[18px] md:text-[35px] transition-transform duration-300" :class="openInfo ? 'rotate-180' : ''"></i>
          </button>
          
          <div x-show="openInfo"
               x-transition:enter="transition ease-out duration-300"
               x-transition:enter-start="opacity-0 max-h-0"
               x-transition:enter-end="opacity-100 max-h-[200px]"
               x-transition:leave="transition ease-in duration-200"
               x-transition:leave-start="opacity-100 max-h-[200px]"
               x-transition:leave-end="opacity-0 max-h-0"
               class="overflow-hidden" style="display: none;">
               {{#each installments}}
             <div class="pt-4 pb-2 text-[16px] md:text-[25px] text-[#545454] leading-relaxed">
               By selecting installment, you will pay a down payment of Rp {{../course.price}} upfront. The remaining balance can be paid flexibly up to {{this.month}} months. Terms and conditions apply.
             </div>
             {{/each}}
          </div>
        </div>

        <!-- Info Box (Shared) -->
        <div class="w-full bg-[#EAEAEA] rounded-[8px] p-4 md:p-5 mb-8">
          <div class="flex justify-between items-center mb-3">
            <span class="font-[600] text-[#0F0F0F] text-[18px] md:text-[35px]">Registration</span>
            <span class="text-[#0F0F0F] font-[400] text-[18px] md:text-[35px]">{{formatDate course.startDate}}</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="font-[600] text-[#0F0F0F] text-[18px] md:text-[35px]">Start Learning</span>
            <span class="text-[#0F0F0F] font-[400] text-[18px] md:text-[35px]">{{formatDate course.startDate }} - {{formatDate course.startEnd}}</span>
          </div>
        </div>

        <!-- Buttons (Shared) -->
        <div class="flex flex-col gap-4 w-full">
          <button class="w-full bg-[#003060] text-white font-[600] text-[18px] md:text-[35px] py-4 md:py-6 rounded-[8px] hover:bg-[#002244] transition-colors">##Registration Now</button>
          <button class="w-full bg-[#F5F5F5] border border-[#E0E0E0] text-[#003060] font-[600] text-[18px] md:text-[35px] py-4 md:py-6 rounded-[8px] hover:bg-[#EAEAEA] transition-colors">##Free Consultation</button>
        </div>

      </div>
    </div>
  </div>
</section>
