<!-- GALLERY SECTION -->
<section id="gallery" class="w-full py-20 bg-[#FAFAFA] font-montserrat">
  
  <div class="max-w-[1537px] mx-auto px-8 lg:px-16 flex flex-col items-center">
    
    <!-- 1. Header (Badge & Sub-judul) -->
    <!-- Badge Baru dengan bentuk lebar & presisi -->
    <div class="inline-flex items-center justify-center border border-[#003060] bg-[#6EB6E5]/[20%] text-[#003060] px-10 py-2.5 rounded-full font-medium text-[16px] mb-6">
      {{t 'test.paidProgram.title.gallery'}}
    </div>
    
    <!-- Sub-judul -->
    <p class="text-gray-600 text-[16px] mb-14 text-center">
      {{t 'test.paidProgram.gallery.description'}}
    </p>

    <!-- 2. Gallery Grid (3 Kolom) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 justify-items-center w-full max-w-[1200px]">
      
      <!-- KOLOM 1 -->
      <div class="flex flex-col gap-6 lg:gap-8 w-full">
        {{#if course.category.gallery.[0]}}
        <div class="overflow-hidden rounded-[16px] shadow-sm bg-gray-200 transform-gpu w-full h-[225px] md:h-[240px]">
          <img src="{{course.category.gallery.[0].filePath}}" 
               alt="{{course.title}}" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
        </div>
        {{/if}}
        <div class="overflow-hidden rounded-[16px] shadow-sm bg-gray-200 transform-gpu w-full h-[433px] md:h-[460px]">
          <img src="{{#if course.category.gallery.[1]}}{{course.category.gallery.[1].filePath}}{{else}}https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=600&h=800&fit=crop{{/if}}" 
               alt="Gallery 2" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
        </div>

      </div>
      
      <!-- KOLOM 2 -->
      <div class="flex flex-col gap-6 lg:gap-8 w-full">
        <div class="overflow-hidden rounded-[16px] shadow-sm bg-gray-200 transform-gpu w-full h-[433px] md:h-[460px]">
          <img src="{{#if course.category.gallery.[2]}}{{course.category.gallery.[2].filePath}}{{else}}https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=600&h=800&fit=crop{{/if}}" 
               alt="Gallery 3" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
        </div>
        <div class="overflow-hidden rounded-[16px] shadow-sm bg-gray-200 transform-gpu w-full h-[225px] md:h-[240px]">
           <img src="{{#if course.category.gallery.[3]}}{{course.category.gallery.[3].filePath}}{{else}}https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=600&h=800&fit=crop{{/if}}" 
               alt="Gallery 4" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
        </div>
      </div>
      
      <!-- KOLOM 3 -->
      <div class="flex flex-col gap-6 lg:gap-8 w-full">
        <div class="overflow-hidden rounded-[16px] shadow-sm bg-gray-200 transform-gpu w-full h-[225px] md:h-[240px]">
           <img src="{{#if course.category.gallery.[4]}}{{course.category.gallery.[4].filePath}}{{else}}https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=600&h=800&fit=crop{{/if}}" 
               alt="Gallery 5" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
        </div>
        <div class="overflow-hidden rounded-[16px] shadow-sm bg-gray-200 transform-gpu w-full h-[433px] md:h-[460px]">
           <img src="{{#if course.category.gallery.[5]}}{{course.category.gallery.[5].filePath}}{{else}}https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=600&h=800&fit=crop{{/if}}" 
               alt="Gallery 6" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
        </div>
      </div>
      
    </div>

    <!-- 3. Teks Bawah (Tautan) -->
    <div class="mt-16">
      <a href="/dashboard/gallery" class="inline-flex items-center gap-2 text-[#0B1F3B] text-[16px] font-semibold transition-all hover:text-[#7AA3C4] border-b-[1.5px] border-[#0B1F3B] hover:border-[#7AA3C4] pb-1">
        {{t 'test.paidProgram.gallery.seeAllOurGallery'}} <i class="fa-solid fa-arrow-right-long text-[15px]"></i>
      </a>
    </div>

  </div>
</section>