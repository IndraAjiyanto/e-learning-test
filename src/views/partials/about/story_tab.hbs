<!-- Story Section -->
<div x-transition:enter='transition ease-out duration-300' x-transition:enter-start='opacity-0 transform translate-y-4'
  x-transition:enter-end='opacity-100 transform translate-y-0'
  x-data="{ videoUrl: '{{#if social.length}}{{social.[0].videoYoutube}}{{else}}https://youtu.be/Ft3UMrgTDpc?si=SkBf4VNA-qL5PG4S{{/if}}' }">
  
  <!-- Header Title & Subtitle -->
  <div class='mb-6 sm:mb-8'>
    <h1 class='text-xl sm:text-2xl md:text-4xl font-semibold text-[#003060] mb-2 font-montserrat'>
      {{t "test.about.ourStory.tittle"}}
    </h1>
    <h2 class='text-lg sm:text-xl md:text-2xl font-normal text-[#003060] mb-6 font-montserrat'>
      {{t "test.about.ourStory.subTittle"}}
    </h2>
  </div>

  <!-- Story Paragraphs -->
  <div class='space-y-4 sm:space-y-6 text-[#000000] text-base md:text-2xl leading-normal md:leading-[45px] font-sans font-normal text-justify'>
    {{#if paragraphs.length}}
      {{#each paragraphs}}
        <p>{{getByLang this.paragraphs ../lang}}</p>
      {{/each}}
    {{else}}
      <p>
        Kesatria Academy is an educational services institution focused on developing superior digital talent in the information technology sector. Our programs are designed to address real and evolving industry needs, ensuring that every learner is prepared to contribute meaningfully to the ongoing digital transformation happening across various sectors.
      </p>
      <p>
        At Kesatria Academy, we believe that technology education is not solely about theoretical understanding. It is a transformative journey that builds practical capabilities, problem-solving skills, and a strong professional work ethic. Through hands-on learning, real-world projects, and personalized mentoring from industry experts, we prepare participants to become highly competitive and job-ready professionals.
      </p>
      <p>
        We emphasize measurable outcomes and the creation of a globally recognized portfolio as a key indicator of success. With a curriculum aligned to industry standards and a learning environment that encourages collaboration, innovation, and continuous improvement, Kesatria Academy strives to empower future digital talents to excel in both local and international levels.
      </p>
    {{/if}}
  </div>

  <!-- Company Profile YouTube Video Player Card -->
  <div class='mt-10 mb-12 w-full'>
    <div class='w-full'>
      <div class='aspect-video bg-slate-900 rounded-2xl overflow-hidden shadow-xl border border-gray-200 relative w-full'>
        <iframe 
          width='100%' 
          height='100%' 
          x-bind:src="videoUrl.includes('youtube.com/watch?v=') 
            ? videoUrl.replace('watch?v=', 'embed/') 
            : videoUrl.includes('youtu.be/') 
              ? videoUrl.replace('youtu.be/', 'youtube.com/embed/') 
              : videoUrl" 
          title='Kesatria Academy Introduction' 
          frameborder='0'
          allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
          allowfullscreen
          class="w-full h-full"
        ></iframe>
      </div>
    </div>
  </div>

  <!-- Our Commitment Grid -->
  <div class='mt-10'>
    <h3 class='font-montserrat font-semibold text-[#003060] text-2xl md:text-[36px] leading-[100%] tracking-normal text-left mb-8'>
      {{t "test.about.ourStory.commitment"}}
    </h3>
    
    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 justify-items-center md:justify-items-start'>
      {{#each commitment}}
        <div class='w-full max-w-[349px] min-h-[362px] lg:h-[362px] flex flex-col items-center justify-center text-center p-6 bg-[#E0F1F9]/65 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)]'>
          <div class='w-12 h-12 lg:w-14 lg:h-14 rounded-full bg-[#EFF4FE] flex items-center justify-center mb-4 lg:mb-5 shadow-sm flex-shrink-0'>
            <img src="/public/image/about/story/{{this.icon}}" alt="{{getByLang judul ../lang}}" class="w-6 h-6 lg:w-7 lg:h-7 object-contain" onerror="this.onerror=null; this.src='/public/image/about/story/inclusive.svg';" />
          </div>
          <h4 class='font-semibold text-base lg:text-xl text-[#003060] mb-2 lg:mb-3 font-montserrat leading-snug'>
            {{getByLang judul ../lang}}
          </h4>
          <div class='w-12 h-0.5 bg-[#003060] rounded-full mb-3 lg:mb-4'></div>
          <p class='text-[#000000CC] text-xs lg:text-[15px] leading-relaxed lg:leading-[30px] tracking-normal font-sans font-normal text-center'>
            {{getByLang description ../lang}}
          </p>
        </div>
      {{else}}
        <!-- Card 1: Inclusive & Accessible Education -->
        <div class='w-full max-w-[349px] min-h-[362px] lg:h-[362px] flex flex-col items-center justify-center text-center p-6 bg-[#E0F1F9]/65 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)]'>
          <div class='w-12 h-12 lg:w-14 lg:h-14 rounded-full bg-[#EFF4FE] flex items-center justify-center mb-4 lg:mb-5 shadow-sm flex-shrink-0'>
            <img src="/public/image/about/story/inclusive.svg" alt="Inclusive Education" class="w-6 h-6 lg:w-7 lg:h-7 object-contain" />
          </div>
          <h4 class='font-semibold text-base lg:text-xl text-[#003060] mb-2 lg:mb-3 font-montserrat leading-snug'>
            Inclusive & Accessible Education
          </h4>
          <div class='w-12 h-0.5 bg-[#003060] rounded-full mb-3 lg:mb-4'></div>
          <p class='text-[#000000CC] text-xs lg:text-[15px] leading-relaxed lg:leading-[30px] tracking-normal font-sans font-normal text-center'>
            Providing equal opportunities for all learners through flexible and accessible learning experiences.
          </p>
        </div>

        <!-- Card 2: Career Growth & Professional Mentoring -->
        <div class='w-full max-w-[349px] min-h-[362px] lg:h-[362px] flex flex-col items-center justify-center text-center p-6 bg-[#E0F1F9]/65 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)]'>
          <div class='w-12 h-12 lg:w-14 lg:h-14 rounded-full bg-[#EFF4FE] flex items-center justify-center mb-4 lg:mb-5 shadow-sm flex-shrink-0'>
            <img src="/public/image/about/story/career.svg" alt="Career Growth" class="w-6 h-6 lg:w-7 lg:h-7 object-contain" />
          </div>
          <h4 class='font-semibold text-base lg:text-xl text-[#003060] mb-2 lg:mb-3 font-montserrat leading-snug'>
            Career Growth & Professional Mentoring
          </h4>
          <div class='w-12 h-0.5 bg-[#003060] rounded-full mb-3 lg:mb-4'></div>
          <p class='text-[#000000CC] text-xs lg:text-[15px] leading-relaxed lg:leading-[30px] tracking-normal font-sans font-normal text-center'>
            Supporting learners through mentoring, portfolio building, certifications, and career placement pathways.
          </p>
        </div>

        <!-- Card 3: Real-World Industry Experience -->
        <div class='w-full max-w-[349px] min-h-[362px] lg:h-[362px] flex flex-col items-center justify-center text-center p-6 bg-[#E0F1F9]/65 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)]'>
          <div class='w-12 h-12 lg:w-14 lg:h-14 rounded-full bg-[#EFF4FE] flex items-center justify-center mb-4 lg:mb-5 shadow-sm flex-shrink-0'>
            <img src="/public/image/about/story/real-world.svg" alt="Real-World Experience" class="w-6 h-6 lg:w-7 lg:h-7 object-contain" />
          </div>
          <h4 class='font-semibold text-base lg:text-xl text-[#003060] mb-2 lg:mb-3 font-montserrat leading-snug'>
            Real-World Industry Experience
          </h4>
          <div class='w-12 h-0.5 bg-[#003060] rounded-full mb-3 lg:mb-4'></div>
          <p class='text-[#000000CC] text-xs lg:text-[15px] leading-relaxed lg:leading-[30px] tracking-normal font-sans font-normal text-center'>
            Offering hands-on project, case studies, and collaboration with experts to bridge theory and practice.
          </p>
        </div>

        <!-- Card 4: Innovative Technology Adoption -->
        <div class='w-full max-w-[349px] min-h-[362px] lg:h-[362px] flex flex-col items-center justify-center text-center p-6 bg-[#E0F1F9]/65 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)]'>
          <div class='w-12 h-12 lg:w-14 lg:h-14 rounded-full bg-[#EFF4FE] flex items-center justify-center mb-4 lg:mb-5 shadow-sm flex-shrink-0'>
            <img src="/public/image/about/story/innovative.svg" alt="Innovative Technology" class="w-6 h-6 lg:w-7 lg:h-7 object-contain" />
          </div>
          <h4 class='font-semibold text-base lg:text-xl text-[#003060] mb-2 lg:mb-3 font-montserrat leading-snug'>
            Innovative Technology Adoption
          </h4>
          <div class='w-12 h-0.5 bg-[#003060] rounded-full mb-3 lg:mb-4'></div>
          <p class='text-[#000000CC] text-xs lg:text-[15px] leading-relaxed lg:leading-[30px] tracking-normal font-sans font-normal text-center'>
            Continuously integrating modern tech stacks, AI tools, and interactive platforms into learning.
          </p>
        </div>

        <!-- Card 5: Excellence & Industry Relevance -->
        <div class='w-full max-w-[349px] min-h-[362px] lg:h-[362px] flex flex-col items-center justify-center text-center p-6 bg-[#E0F1F9]/65 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)]'>
          <div class='w-12 h-12 lg:w-14 lg:h-14 rounded-full bg-[#EFF4FE] flex items-center justify-center mb-4 lg:mb-5 shadow-sm flex-shrink-0'>
            <img src="/public/image/about/story/excellence.svg" alt="Excellence" class="w-6 h-6 lg:w-7 lg:h-7 object-contain" />
          </div>
          <h4 class='font-semibold text-base lg:text-xl text-[#003060] mb-2 lg:mb-3 font-montserrat leading-snug'>
            Excellence & Industry Relevance
          </h4>
          <div class='w-12 h-0.5 bg-[#003060] rounded-full mb-3 lg:mb-4'></div>
          <p class='text-[#000000CC] text-xs lg:text-[15px] leading-relaxed lg:leading-[30px] tracking-normal font-sans font-normal text-center'>
            Ensuring all curriculum content meets current market standards and expectations of global companies.
          </p>
        </div>

        <!-- Card 6: Empowering Digital Talent -->
        <div class='w-full max-w-[349px] min-h-[362px] lg:h-[362px] flex flex-col items-center justify-center text-center p-6 bg-[#E0F1F9]/65 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)]'>
          <div class='w-12 h-12 lg:w-14 lg:h-14 rounded-full bg-[#EFF4FE] flex items-center justify-center mb-4 lg:mb-5 shadow-sm flex-shrink-0'>
            <img src="/public/image/about/story/empowering.svg" alt="Empowering Talent" class="w-6 h-6 lg:w-7 lg:h-7 object-contain" />
          </div>
          <h4 class='font-semibold text-base lg:text-xl text-[#003060] mb-2 lg:mb-3 font-montserrat leading-snug'>
            Empowering Digital Talent
          </h4>
          <div class='w-12 h-0.5 bg-[#003060] rounded-full mb-3 lg:mb-4'></div>
          <p class='text-[#000000CC] text-xs lg:text-[15px] leading-relaxed lg:leading-[30px] tracking-normal font-sans font-normal text-center'>
            Inspiring and equipping the next generation to build meaningful careers and innovate in technology.
          </p>
        </div>
      {{/each}}
    </div>
  </div>

</div>