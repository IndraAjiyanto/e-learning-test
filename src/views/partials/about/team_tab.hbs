<!-- Team Section -->
<div
  x-transition:enter='transition ease-out duration-300'
  x-transition:enter-start='opacity-0 transform translate-y-4'
  x-transition:enter-end='opacity-100 transform translate-y-0'
>
  {{> components/ui/section_header
      align="text-left"
      wrapperClass="mb-6 sm:mb-8"
      title=(t 'test.about.team.title')
      titleClass="text-3xl sm:text-4xl font-semibold text-[#003060] mb-2 font-montserrat"
      description=(t 'test.about.team.description')
      descClass="text-lg sm:text-xl md:text-2xl text-[#000000CC] font-montserrat font-normal tracking-normal"
      showDivider=false
  }}

  <!-- Featured CEO Card -->
  {{> sub_partials/about/team_tab/team_leader}}

  <!-- Team Members Grid -->
  {{> sub_partials/about/team_tab/team}}

  <!-- Join Our Team Banner -->
  <div class='mt-10 bg-[#E0F1F9]/50 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)] p-6 sm:p-8 text-center'>
    <h3 class='text-[22px] sm:text-4xl font-bold text-[#003060] mb-3 sm:mb-5 font-montserrat leading-none tracking-normal text-center'>
      {{t 'test.about.team.joinOurTeam'}}
    </h3>
    <p class='text-[#000000] text-[14px] sm:text-xl leading-[22px] sm:leading-10 tracking-normal font-montserrat font-normal max-w-xl mx-auto mb-6 sm:mb-7 text-center'>
      {{t 'test.about.team.joinDescription'}}
    </p>
    <div class='flex justify-center'>
      {{> components/ui/btn_action
          href=social.[0].linkForm
          target="_blank"
          variant="primary"
          iconUrl="/public/image/about/team/viewJob.svg"
          text=(t 'test.about.team.buttonJob')
          class="w-full max-w-[332px] h-[54px] sm:h-[70px] space-x-[10px] font-montserrat font-semibold text-[16px] sm:text-2xl rounded-xl border border-[#003060] shadow-md"
      }}
    </div>
  </div>
</div>