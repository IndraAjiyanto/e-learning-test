<!-- Team Section -->
<div
  x-transition:enter='transition ease-out duration-300'
  x-transition:enter-start='opacity-0 transform translate-y-4'
  x-transition:enter-end='opacity-100 transform translate-y-0'
>
  <div class='mb-6 sm:mb-8'>
    <h1 class='text-3xl sm:text-4xl font-semibold text-[#003060] mb-2 font-montserrat'>
      {{t 'test.about.team.tittle'}}
    </h1>
    <p class='text-lg sm:text-xl md:text-2xl text-[#000000CC] font-montserrat font-normal tracking-normal'>
      {{t 'test.about.team.description'}}
    </p>
  </div>

  <!-- Featured CEO Card -->
  {{> sub_partials/about/team_tab/team_leader}}

  <!-- Team Members Grid -->
  {{> sub_partials/about/team_tab/team}}

  <!-- Join Our Team Banner -->
  <div class='mt-10 bg-[#E0F1F9]/50 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)] p-6 sm:p-8 text-center'>
    <h3 class='text-2xl sm:text-4xl font-semibold text-[#003060] mb-5 font-montserrat leading-none tracking-normal'>
      {{t 'test.about.team.joinOurTeam'}}
    </h3>
    <p class='text-[#000000] text-base sm:text-xl leading-10 tracking-normal font-montserrat font-normal max-w-xl mx-auto mb-7'>
      {{t 'test.about.team.joinDescription'}}
    </p>
    <div class='flex justify-center'>
      <a
        href='{{social.[0].linkForm}}' target="_blank"
        class='w-[332px] h-[70px] bg-[#003060] text-white p-2.5 rounded-xl border border-[#003060] shadow-md inline-flex items-center justify-center space-x-[10px]'
      >
        <img src="/public/image/about/team/viewJob.svg" alt="View Job" class="w-[29px] h-5 object-contain" />
        <span class="font-inter font-medium text-base sm:text-2xl">{{t 'test.about.team.buttonJob'}}</span>
      </a>
    </div>
  </div>
</div>