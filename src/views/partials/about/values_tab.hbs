<!-- Values Section Container -->
<div
  x-transition:enter='transition ease-out duration-300'
  x-transition:enter-start='opacity-0 transform translate-y-4'
  x-transition:enter-end='opacity-100 transform translate-y-0'
>
  <!-- MOBILE VALUES TAB (< 640px) -->
  <div class="block sm:hidden w-full relative font-montserrat overflow-hidden">
    <!-- Header Title & Divider -->
    <div class="mb-6">
      <h1 class="font-montserrat font-semibold text-[28px] leading-none text-[#003060]">
        {{t 'test.about.value.title'}}
      </h1>
      <p class="font-montserrat font-normal text-[15px] leading-[20px] text-[#003060] mt-1.5">
        {{t 'test.about.value.description'}}
      </p>
      <div class="w-full h-[2px] bg-[#6EB6E5] mt-3"></div>
    </div>

    <!-- Mobile Values Cards List -->
    <div class="space-y-4">
      {{#each value}}
        <div class="bg-[#E0F1F9]/65 backdrop-blur-[6.6px] border border-[#E0F1F9] rounded-[20px] p-6 shadow-[0px_4px_12px_0px_#00000010]">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 bg-[#003060] rounded-full flex items-center justify-center text-white shrink-0 shadow-sm">
              <img src="/public/image/about/values/{{icon}}" alt="{{getByLang title ../lang}}" class="w-6 h-6 object-contain" onerror="this.onerror=null; this.src='/public/image/about/values/adaptability.svg';" />
            </div>
            <h3 class="font-montserrat font-bold text-[20px] leading-none text-[#0B1F3B]">
              {{getByLang title ../lang}}
            </h3>
          </div>
          <p class="font-sans font-normal text-[14px] leading-[24px] text-[#000000CC]">
            {{getByLang description ../lang}}
          </p>
        </div>
      {{else}}
        <!-- Card 1: Adaptability -->
        <div class="bg-[#E0F1F9]/65 backdrop-blur-[6.6px] border border-[#E0F1F9] rounded-[20px] p-6 shadow-[0px_4px_12px_0px_#00000010]">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 bg-[#003060] rounded-full flex items-center justify-center text-white shrink-0 shadow-sm">
              <img src="/public/image/about/values/adaptability.svg" alt="Adaptability" class="w-6 h-6 object-contain" />
            </div>
            <h3 class="font-montserrat font-bold text-[20px] leading-none text-[#0B1F3B]">
              Adaptability
            </h3>
          </div>
          <p class="font-sans font-normal text-[14px] leading-[24px] text-[#000000CC]">
            We uphold speed and agility in facing technological trend shifts. We encourage continuous skill improvement to adapt effectively.
          </p>
        </div>

        <!-- Card 2: Authenticity -->
        <div class="bg-[#E0F1F9]/65 backdrop-blur-[6.6px] border border-[#E0F1F9] rounded-[20px] p-6 shadow-[0px_4px_12px_0px_#00000010]">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 bg-[#003060] rounded-full flex items-center justify-center text-white shrink-0 shadow-sm">
              <img src="/public/image/about/values/authenticity.svg" alt="Authenticity" class="w-6 h-6 object-contain" />
            </div>
            <h3 class="font-montserrat font-bold text-[20px] leading-none text-[#0B1F3B]">
              Authenticity
            </h3>
          </div>
          <p class="font-sans font-normal text-[14px] leading-[24px] text-[#000000CC]">
            We highly value the uniqueness of every individual and total transparency. We encourage every member to contribute with their true ideas and character.
          </p>
        </div>

        <!-- Card 3: Impact -->
        <div class="bg-[#E0F1F9]/65 backdrop-blur-[6.6px] border border-[#E0F1F9] rounded-[20px] p-6 shadow-[0px_4px_12px_0px_#00000010]">
