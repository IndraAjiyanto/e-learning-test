<!-- Mission Section -->
<div
  x-show="activeSection === 'mission'"
  x-transition:enter='transition ease-out duration-300'
  x-transition:enter-start='opacity-0 transform translate-y-4'
  x-transition:enter-end='opacity-100 transform translate-y-0'
>
  <div class='mb-6 sm:mb-8'>
    <h1
      class='text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-800 mb-3 sm:mb-4 font-montserrat'
    >Mission & Vision</h1>
  </div>

  <!-- Vision Card -->
  <div
    class='bg-gradient-to-br from-slate-50 to-slate-100 p-5 sm:p-6 lg:p-8 rounded-xl sm:rounded-2xl border border-slate-200 transition-all duration-300 hover:shadow-lg mb-6 sm:mb-8'
  >
    <div class='flex items-start gap-4 sm:gap-6'>
      <div
        class='w-12 h-12 sm:w-14 sm:h-14 lg:w-16 lg:h-16 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg sm:rounded-xl flex items-center justify-center flex-shrink-0'
      >
        <i class='fas fa-eye text-white text-lg sm:text-xl lg:text-2xl'></i>
      </div>
      <div class='flex-1'>
        <h3
          class='text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 mb-3 sm:mb-4 font-montserrat'
        >Our Vision</h3>
        <p
          class='text-sm sm:text-base text-slate-700 leading-relaxed font-inter'
        >
          {{#if visi.length}}
            {{visi.[0].visi}}
          {{else}}
            To become a leading digital education institution that nurtures
            outstanding information technology talents job-ready and globally
            competitive to drive Indonesia's digital transformation.
          {{/if}}
        </p>
      </div>
    </div>
  </div>

  <!-- Mission Card -->
  <div
    class='bg-gradient-to-br from-slate-50 to-slate-100 p-5 sm:p-6 lg:p-8 rounded-xl sm:rounded-2xl border border-slate-200 transition-all duration-300 hover:shadow-lg'
  >
    <div class='flex items-start gap-4 sm:gap-6'>
      <div
        class='w-12 h-12 sm:w-14 sm:h-14 lg:w-16 lg:h-16 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg sm:rounded-xl flex items-center justify-center flex-shrink-0'
      >
        <i
          class='fas fa-bullseye text-white text-lg sm:text-xl lg:text-2xl'
        ></i>
      </div>
      <div class='flex-1'>
        <h3
          class='text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 mb-3 sm:mb-4 font-montserrat'
        >Our Mission</h3>
        <ul class='space-y-3 sm:space-y-4'>
          {{#if misi.[0]}}
            {{#each misi}}
              <li class='flex items-start space-x-3'>
                <i
                  class='fas fa-check-circle text-slate-600 mt-1 flex-shrink-0'
                ></i>
                <p
                  class='text-sm sm:text-base text-slate-700 leading-relaxed font-inter'
                >
                  <strong>{{content}}:</strong>
                  {{isi}}
                </p>
              </li>
            {{/each}}

          {{else}}
            <li class='flex items-start space-x-3'>
              <i
                class='fas fa-check-circle text-slate-600 mt-1 flex-shrink-0'
              ></i>
              <p
                class='text-sm sm:text-base text-slate-700 leading-relaxed font-inter'
              >
                <strong>To Become a Leading Provide</strong>
                of digital education that continuously innovates in line with
                advancements in information technology.
              </p>
            </li>
            <li class='flex items-start space-x-3'>
              <i
                class='fas fa-check-circle text-slate-600 mt-1 flex-shrink-0'
              ></i>
              <p
                class='text-sm sm:text-base text-slate-700 leading-relaxed font-inter'
              >
                <strong>To Develop Exceptional Human Resources</strong>
                equipped with both technical expertise and soft skills that meet
                industry demands.
              </p>
            </li>
            <li class='flex items-start space-x-3'>
              <i
                class='fas fa-check-circle text-slate-600 mt-1 flex-shrink-0'
              ></i>
              <p
                class='text-sm sm:text-base text-slate-700 leading-relaxed font-inter'
              >
                <strong>To Prepare Job-Ready Graduates</strong>
                through practical learning programs and professional mentoring.
              </p>
            </li>
            <li class='flex items-start space-x-3'>
              <i
                class='fas fa-check-circle text-slate-600 mt-1 flex-shrink-0'
              ></i>
              <p
                class='text-sm sm:text-base text-slate-700 leading-relaxed font-inter'
              >
                <strong>To Build a Globally Competitive Generation</strong>
                with internationally recognized digital competencies.
              </p>
            </li>
            <li class='flex items-start space-x-3'>
              <i
                class='fas fa-check-circle text-slate-600 mt-1 flex-shrink-0'
              ></i>
              <p
                class='text-sm sm:text-base text-slate-700 leading-relaxed font-inter'
              >
                <strong>To Accelerate Digital Transformation</strong>
                by cultivating impactful and valuable talents.
              </p>
            </li>

          {{/if}}
        </ul>
      </div>
    </div>
  </div>

  <div class='mt-8 sm:mt-10 lg:mt-12'>
    <h3
      class='text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 mb-4 sm:mb-6 font-montserrat'
    >Our Commitment</h3>
    <div class='grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6'>

      {{#each commitment}}
        <div
          class='flex items-start space-x-3 sm:space-x-4 p-4 sm:p-5 lg:p-6 bg-white border border-slate-200 rounded-lg sm:rounded-xl transition-all duration-300 hover:shadow-lg hover:-translate-y-1'
        >
          <div
            class='w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg flex items-center justify-center flex-shrink-0'
          >
            <i class='{{computeIcon icon}} text-white text-sm sm:text-base'></i>
          </div>
          <div>
            <h4
              class='font-semibold text-sm sm:text-base text-slate-800 mb-1 sm:mb-2 font-montserrat'
            >{{judul}}</h4>
            <p
              class='text-slate-600 text-xs sm:text-sm font-inter'
            >{{deskripsi}}</p>
          </div>
        </div>
      {{else}}
        <div
          class='flex items-start space-x-3 sm:space-x-4 p-4 sm:p-5 lg:p-6 bg-white border border-slate-200 rounded-lg sm:rounded-xl transition-all duration-300 hover:shadow-lg hover:-translate-y-1'
        >
          <div
            class='w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg flex items-center justify-center flex-shrink-0'
          >
            <i class='fas fa-star text-white text-sm sm:text-base'></i>
          </div>
          <div>
            <h4
              class='font-semibold text-sm sm:text-base text-slate-800 mb-1 sm:mb-2 font-montserrat'
            >Quality Education</h4>
            <p class='text-slate-600 text-xs sm:text-sm font-inter'>Committed to
              delivering top-notch learning experiences.</p>
          </div>
        </div>
        <div
          class='flex items-start space-x-3 sm:space-x-4 p-4 sm:p-5 lg:p-6 bg-white border border-slate-200 rounded-lg sm:rounded-xl transition-all duration-300 hover:shadow-lg hover:-translate-y-1'
        >
          <div
            class='w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg flex items-center justify-center flex-shrink-0'
          >
            <i class='fas fa-users text-white text-sm sm:text-base'></i>
          </div>
          <div>
            <h4
              class='font-semibold text-sm sm:text-base text-slate-800 mb-1 sm:mb-2 font-montserrat'
            >Community Focus</h4>
            <p class='text-slate-600 text-xs sm:text-sm font-inter'>Building a
              supportive learning community for all.</p>
          </div>
        </div>
        <div
          class='flex items-start space-x-3 sm:space-x-4 p-4 sm:p-5 lg:p-6 bg-white border border-slate-200 rounded-lg sm:rounded-xl transition-all duration-300 hover:shadow-lg hover:-translate-y-1'
        >
          <div
            class='w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg flex items-center justify-center flex-shrink-0'
          >
            <i class='fas fa-lightbulb text-white text-sm sm:text-base'></i>
          </div>
          <div>
            <h4
              class='font-semibold text-sm sm:text-base text-slate-800 mb-1 sm:mb-2 font-montserrat'
            >Innovation</h4>
            <p class='text-slate-600 text-xs sm:text-sm font-inter'>Embracing
              new technologies to enhance learning.</p>
          </div>
        </div>
      {{/each}}
    </div>
  </div>
</div>