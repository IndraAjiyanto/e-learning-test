<!-- Values Section -->
<div
  x-transition:enter='transition ease-out duration-300'
  x-transition:enter-start='opacity-0 transform translate-y-4'
  x-transition:enter-end='opacity-100 transform translate-y-0'
>
  <div class='mb-6 sm:mb-8'>
    <h1
      class='text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-800 mb-3 sm:mb-4 font-montserrat'
    >{{t 'test.about.value.tittle'}}</h1>
    <p
      class='text-base sm:text-lg lg:text-xl text-slate-600 font-inter'
    >{{t 'test.about.value.description'}}</p>
  </div>

  <div class='grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 lg:gap-8'>
    {{#each value}}
      <div
        class='bg-white border border-slate-200 rounded-xl sm:rounded-2xl p-5 sm:p-6 lg:p-8 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 shadow-lg'
      >
        <div
          class='w-12 h-12 sm:w-14 sm:h-14 lg:w-16 lg:h-16 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg sm:rounded-xl flex items-center justify-center mb-4 sm:mb-6'
        >
          <i
            class='{{computeIcon icon}}
              text-white text-lg sm:text-xl lg:text-2xl'
          ></i>
        </div>
        <h3
          class='text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 mb-3 sm:mb-4 font-montserrat'
        >{{getByLang title ../lang}}</h3>
        <p
          class='text-sm sm:text-base text-slate-700 leading-relaxed font-inter'
        >
          {{getByLang description ../lang}}
        </p>
      </div>
    {{else}}
      <div
        class='bg-white border border-slate-200 rounded-xl sm:rounded-2xl p-5 sm:p-6 lg:p-8 transition-all duration-300 hover:shadow-xl hover:-translate-y-1'
      >
        <div
          class='w-12 h-12 sm:w-14 sm:h-14 lg:w-16 lg:h-16 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg sm:rounded-xl flex items-center justify-center mb-4 sm:mb-6'
        >
          <i class='fas fa-heart text-white text-lg sm:text-xl lg:text-2xl'></i>
        </div>
        <h3
          class='text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 mb-3 sm:mb-4 font-montserrat'
        >Integrity</h3>
        <p
          class='text-sm sm:text-base text-slate-700 leading-relaxed font-inter'
        >
          We uphold the highest standards of honesty and transparency in
          everything we do.
        </p>
      </div>
      <div
        class='bg-white border border-slate-200 rounded-xl sm:rounded-2xl p-5 sm:p-6 lg:p-8 transition-all duration-300 hover:shadow-xl hover:-translate-y-1'
      >
        <div
          class='w-12 h-12 sm:w-14 sm:h-14 lg:w-16 lg:h-16 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg sm:rounded-xl flex items-center justify-center mb-4 sm:mb-6'
        >
          <i class='fas fa-users text-white text-lg sm:text-xl lg:text-2xl'></i>
        </div>
        <h3
          class='text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 mb-3 sm:mb-4 font-montserrat'
        >Collaboration</h3>
        <p
          class='text-sm sm:text-base text-slate-700 leading-relaxed font-inter'
        >
          We believe in the power of teamwork and collective achievement.
        </p>
      </div>
    {{/each}}
  </div>
</div>