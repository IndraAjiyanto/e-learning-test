        <!-- Contact Section -->
        <div
          x-show="activeSection === 'contact'"
          x-transition:enter='transition ease-out duration-300'
          x-transition:enter-start='opacity-0 transform translate-y-4'
          x-transition:enter-end='opacity-100 transform translate-y-0'
        >
          <div class='mb-6 sm:mb-8'>
            <h1
              class='text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-800 mb-3 sm:mb-4 font-montserrat'
            >Contact Us</h1>
            <p
              class='text-base sm:text-lg lg:text-xl text-slate-600 font-inter'
            >We're ready to help your technology learning journey</p>
          </div>

          <div class='grid grid-cols-1 gap-6 sm:gap-8 mb-10'>
            <div class='max-w-2xl mx-auto'>

              <div class='grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6'>
                <div
                  class='flex flex-col items-center text-center space-y-3 sm:space-y-4'
                >
                  <div
                    class='w-12 h-12 sm:w-14 sm:h-14 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg flex items-center justify-center'
                  >
                    <i
                      class='fas fa-envelope text-white text-lg sm:text-xl'
                    ></i>
                  </div>
                  <div>
                    <h4
                      class='font-semibold text-sm sm:text-base text-slate-800 mb-1 font-montserrat'
                    >Email</h4>
                    <p
                      class='text-xs sm:text-sm text-slate-600 font-inter'
                    >
                      {{#if social}}
                        {{social.[0].email}}
                      {{else}}
                        info@kesatriaacademy.com
                      {{/if}}
                    </p>
                  </div>
                </div>

                <div
                  class='flex flex-col items-center text-center space-y-3 sm:space-y-4'
                >
                  <div
                    class='w-12 h-12 sm:w-14 sm:h-14 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg flex items-center justify-center'
                  >
                    <i class='fas fa-phone text-white text-lg sm:text-xl'></i>
                  </div>
                  <div>
                    <h4
                      class='font-semibold text-sm sm:text-base text-slate-800 mb-1 font-montserrat'
                    >Phone</h4>
                    <p class='text-xs sm:text-sm text-slate-600 font-inter'>
                      {{#if social}}
                        {{social.[0].nomor}}
                      {{else}}
                        +62 21 1234 5678
                      {{/if}}
                    </p>
                  </div>
                </div>

                <div
                  class='flex flex-col items-center text-center space-y-3 sm:space-y-4'
                >
                  <div
                    class='w-12 h-12 sm:w-14 sm:h-14 bg-gradient-to-br from-slate-600 to-slate-800 rounded-lg flex items-center justify-center'
                  >
                    <i
                      class='fas fa-map-marker-alt text-white text-lg sm:text-xl'
                    ></i>
                  </div>
                  <div>
                    <h4
                      class='font-semibold text-sm sm:text-base text-slate-800 mb-1 font-montserrat'
                    >Address</h4>
                    <p class='text-xs sm:text-sm text-slate-600 font-inter'>
                      {{#if social}}
                        {{social.[0].alamat}}
                      {{else}}
                        Jakarta, Indonesia
                      {{/if}}
                    </p>
                  </div>
                </div>
              </div>

              <div class='mt-8 sm:mt-10 text-center'>
                <h4
                  class='font-semibold text-sm sm:text-base text-slate-800 mb-4 sm:mb-6 font-montserrat'
                >Follow Us on Social Media</h4>
                <div class='flex justify-center space-x-4 sm:space-x-6'>
                  <a
                    href='{{#if social}}{{social.[0].instragram}}{{else}}https://instagram.com/kesatriaacademy{{/if}}' target="_blank"
                    class='w-12 h-12 sm:w-14 sm:h-14 bg-slate-100 rounded-lg flex items-center justify-center hover:bg-slate-200 transition-colors'
                  >
                    <i
                      class='fab fa-instagram text-slate-600 text-xl sm:text-2xl'
                    ></i>
                  </a>
                  <a
                    href='{{#if social}}{{social.[0].linkedin}}{{else}}https://linkedin.com/company/kesatriaacademy{{/if}}' target="_blank"
                    class='w-12 h-12 sm:w-14 sm:h-14 bg-slate-100 rounded-lg flex items-center justify-center hover:bg-slate-200 transition-colors'
                  >
                    <i
                      class='fab fa-linkedin text-slate-600 text-xl sm:text-2xl'
                    ></i>
                  </a>
                  <a
                    href='{{#if social}}{{social.[0].youtube}}{{else}}https://youtube.com/@kesatriaacademy{{/if}}' target="_blank"
                    class='w-12 h-12 sm:w-14 sm:h-14 bg-slate-100 rounded-lg flex items-center justify-center hover:bg-slate-200 transition-colors'
                  >
                    <i
                      class='fab fa-youtube text-slate-600 text-xl sm:text-2xl'
                    ></i>
                  </a>
                </div>
              </div>



            </div>
          </div>

<div class="flex justify-center items-center w-full my-8">
  {{#if social}}{{{social.[0].link_alamat}}}{{else}}
<iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d61845542.24798106!2d48.8567244!3d18.8980653!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f3e945e34b9d%3A0x5371bf0fdad786a2!2sJakarta%2C%20Daerah%20Khusus%20Ibukota%20Jakarta!5e0!3m2!1sid!2sid!4v1763716841810!5m2!1sid!2sid" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
{{/if}}
</div>
        </div>