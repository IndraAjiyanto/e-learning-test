        <script>
          function mapEmbed() {
            return {
              mapLink: '',
              embedUrl: '',
              initMap() {
                this.mapLink = '{{#if social}}{{social.[0].link_alamat}}{{else}}https://maps.app.goo.gl/AcvkL7s4E3r1Dm2D7{{/if}}';
                this.generateEmbed();
              },
              async generateEmbed() {
                if (!this.mapLink.trim()) return;
                // For demo, if it's the known link, set directly
                if (this.mapLink === 'https://maps.app.goo.gl/AcvkL7s4E3r1Dm2D7') {
                  this.embedUrl = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3960.0!2d109.0787029!3d-7.3994413!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e6562322541572f%3A0xa600ccc4b41aa543!2sGreen+Mulia+Hotel+%26+Resort!5e0!3m2!1sen!2sus!4v1733000000!5m2!1sen!2sus';
                  return;
                }
                try {
                  const response = await fetch(this.mapLink, { method: 'HEAD' });
                  const fullUrl = response.url;
                  this.embedUrl = this.convertToEmbed(fullUrl);
                } catch (error) {
                  console.error('Error:', error);
                  this.embedUrl = this.mapLink; // Fallback
                }
              },
              convertToEmbed(url) {
                try {
                  const urlObj = new URL(url);
                  const path = urlObj.pathname;
                  if (path.startsWith('/place/')) {
                    const parts = path.split('/');
                    const coordsZoom = parts[3];
                    const [latStr, lngStr, zoomStr] = coordsZoom.split(',');
                    const lat = latStr.replace('@', '');
                    const lng = lngStr;
                    const zoom = zoomStr.replace('z', '');
                    const data = urlObj.searchParams.get('data');
                    const placeIdMatch = data.match(/!1s([^!]+)/);
                    const placeId = placeIdMatch ? placeIdMatch[1] : '';
                    const name = decodeURIComponent(parts[2]);
                    const pb = `!1m18!1m12!1m3!1d3960.0!2d${lng}!3d${lat}!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s${placeId}!2s${encodeURIComponent(name)}!5e0!3m2!1sen!2sus!4v1733000000!5m2!1sen!2sus`;
                    return `https://www.google.com/maps/embed?pb=${pb}`;
                  }
                  return url;
                } catch (e) {
                  return url;
                }
              }
            };
          }
        </script>

        