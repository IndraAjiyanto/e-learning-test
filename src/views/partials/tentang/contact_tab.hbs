<div class="flex justify-center items-center w-full my-8">
  <iframe x-bind:src="embedUrl" class="w-full" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
