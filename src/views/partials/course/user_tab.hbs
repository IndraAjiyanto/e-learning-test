{{!--
  Tab: User — Table Detail Program - User (slicing.pen: frlMx)
  Path: partials/course/user_tab.hbs
  Dipakai: admin/course/detail.hbs → x-show tab === 'user', x-data="userData()" x-init="fetchUsers()"
  Route data: GET /program/userProgram/:courseId → UserCourse[] { user: { id, username, email, profile } }
  Layout: content gap 12 → search full-width + user-list (gap 6) + pagination
  Komponen: form/search-input (widthClass w-full), program/user-list (→ user-row → user-avatar), table/pagination
--}}
<div class='box-border w-full flex flex-col gap-[12px] justify-start items-stretch'>
  {{> components/ui/admin/form/search-input placeholder='Search user...' name='searchUser' value='searchInput' widthClass='w-full'}}
  {{> components/ui/admin/program/user-list}}

  {{!-- Pagination menyatu: border atas, reuse table/pagination (currentPage 1-based, totalPages, changePage) --}}
  <div x-show='!loading && totalPages > 1' class='w-full [border-width:1px_0px_0px_0px] [border-style:solid] [border-color:#E5E5E5]'>
    {{> components/ui/admin/table/pagination}}
  </div>
</div>

<script>
function userData() {
  const PAGE_SIZE = 10;

  return {
    data: [],
    searchInput: '',
    search: '',
    size: PAGE_SIZE,
    currentPage: 1,
    loading: false,

    async fetchUsers() {
      this.loading = true;
      try {
        const res = await fetch('/program/userProgram/{{course.id}}');
        this.data = await res.json();
      } catch (e) {
        this.data = [];
      } finally {
        this.loading = false;
      }
    },

    handleSearch() {
      this.search = this.searchInput;
      this.currentPage = 1;
    },

    get searchKeyword() {
      return this.search.trim().toLowerCase();
    },

    get filteredAll() {
      if (!this.searchKeyword) return this.data;
      return this.data.filter((item) => this.matchesSearch(item));
    },

    get filteredData() {
      const start = (this.currentPage - 1) * this.size;
      return this.filteredAll.slice(start, start + this.size);
    },

    get amount() {
      return this.filteredAll.length;
    },

    get totalPages() {
      return Math.ceil(this.amount / this.size);
    },

    changePage(page) {
      if (page < 1 || page > this.totalPages) return;
      this.currentPage = page;
    },

    matchesSearch(item) {
      const haystack = `${item.user?.username ?? ''} ${item.user?.email ?? ''}`.toLowerCase();
      return haystack.includes(this.searchKeyword);
    },
  };
}
</script>
