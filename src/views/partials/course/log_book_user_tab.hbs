{{!--
  Tab: Logbook User — Table Detail Program - Logbook User (slicing.pen: wWq5L)
  Path: partials/course/log_book_user_tab.hbs
  Dipakai: admin/course/detail.hbs → x-show tab === 'log_book_user', x-data="logBookUserData()" x-init="fetchLogBookUsers()"
  Route data: GET /program/logbookUser/:courseId → Logbook[] { user, session{ sessionOrder, weeks{ weekNumber, course{ name, category, courseType, mentor } } }, activity, activityDetails, documentation, process, obstacles, otherDocumentation, createdAt }
  Layout: content gap 12 → filter row (search fill + export) + logbook-table + pagination; modal detail frozen
  Komponen: form/search-input (widthClass w-full), program/logbook-export-button,
            program/logbook-table (→ user-avatar, logbook-pill, logbook-detail-button), table/pagination
--}}
<div class='box-border w-full flex flex-col gap-[12px] justify-start items-stretch'>

  {{!-- Filter Row: search fill_container + export --}}
  <div class='box-border w-full flex flex-row gap-[12px] justify-start items-center'>
    <div class='flex-1 min-w-0'>
      {{> components/ui/admin/form/search-input placeholder='Search user..' name='searchLogbookUser' value='searchInput' widthClass='w-full'}}
    </div>
    {{> components/ui/admin/program/logbook-export-button}}
  </div>

  {{> components/ui/admin/program/logbook-table}}

  {{!-- Pagination menyatu: border atas, reuse table/pagination (currentPage 1-based, totalPages, changePage) --}}
  <div x-show='!loading && totalPages > 1' class='w-full [border-width:1px_0px_0px_0px] [border-style:solid] [border-color:#E5E5E5]'>
    {{> components/ui/admin/table/pagination}}
  </div>
</div>

  <!-- Detail Modal (frozen — perilaku dipertahankan 100%) -->
  <div
    x-show="showModal"
    class="fixed inset-0 z-50 overflow-y-auto"
    x-cloak
    @keydown.escape.window="closeModal()"
  >
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
      <div
        x-show="showModal"
        x-transition:enter="ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed inset-0 transition-opacity bg-gray-500 bg-opacity-75"
        @click="closeModal()"
      ></div>

      <span class="hidden sm:inline-block sm:align-middle sm:min-h-screen">&#8203;</span>

      <div
        x-show="showModal"
        x-transition:enter="ease-out duration-300"
        x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
        x-transition:leave="ease-in duration-200"
        x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
        x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        class="inline-block overflow-hidden text-left align-bottom transition-all transform bg-white rounded-xl shadow-xl sm:my-8 sm:align-middle sm:max-w-4xl sm:w-full"
      >
        <div class="bg-white px-6 py-6">
          <div class="flex justify-between items-center mb-6 border-b pb-4">
            <h3 class="text-xl font-bold text-gray-900">Logbook Detail</h3>
            <button @click="closeModal()" class="text-gray-400 hover:text-gray-500">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>

          <template x-if="selectedLogbook">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- User Info Section -->
              <div class="space-y-4">
                <div>
                  <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">User Information</label>
                  <p class="text-sm font-medium text-gray-900" x-text="selectedLogbook.user.username"></p>
                  <p class="text-sm text-gray-600" x-text="selectedLogbook.user.email"></p>
                </div>
                <div>
                  <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Program Details</label>
                  <p class="text-sm text-gray-900"><span class="font-medium">Name:</span> <span x-text="selectedLogbook?.session?.weeks.course.name"></span></p>
                  <p class="text-sm text-gray-900"><span class="font-medium">Type:</span> <span x-text="selectedLogbook?.session?.weeks.course.courseType.nameClassesType"></span></p>
                  <p class="text-sm text-gray-900"><span class="font-medium">Mentor:</span> <span x-text="selectedLogbook?.session?.weeks.course.mentors[0]?.name || '-'"></span></p>
                </div>
                <div>
                  <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Timeline</label>
                  <p class="text-sm text-gray-900">Week <span x-text="selectedLogbook?.session?.weeks.weekNumber"></span>, Meeting <span x-text="selectedLogbook.session.sessionOrder"></span></p>
                  <p class="text-sm text-gray-600" x-text="formatDate(selectedLogbook.createdAt)"></p>
                </div>
              </div>

              <!-- Activity Content Section -->
              <div class="space-y-4">
                <div>
                  <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Activity & Details</label>
                  <p class="text-sm font-bold text-gray-900" x-text="selectedLogbook.activity"></p>
                  <div class="mt-1 p-3 bg-gray-50 rounded-lg text-sm text-gray-700 whitespace-pre-line" x-text="selectedLogbook.activityDetails"></div>
                </div>
                <div>
                  <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Issues (Kendala)</label>
                  <p class="text-sm text-red-600" x-text="selectedLogbook.obstacles || 'None'"></p>
                </div>
                <div>
                  <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</label>
                  <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800" x-text="selectedLogbook.process"></span>
                </div>
              </div>

              <!-- Documentation Section -->
              <div class="md:col-span-2 border-t pt-4">
                <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Documentation Photos</label>
                <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-6">
                  <div class="space-y-2">
                    <p class="text-sm font-medium text-gray-700">Main Documentation:</p>
                    <template x-if="selectedLogbook.documentation">
                      <img :src="selectedLogbook.documentation" class="w-full h-auto max-h-80 object-contain rounded-xl border bg-gray-50 shadow-sm cursor-zoom-in" @click="window.open(selectedLogbook.documentation, '_blank')" alt="Main Doc">
                    </template>
                  </div>
                  <div class="space-y-2">
                    <p class="text-sm font-medium text-gray-700">Additional Documentation:</p>
                    <template x-if="selectedLogbook.otherDocumentation">
                      <a :href="selectedLogbook.otherDocumentation"
                         target="_blank"
                         class="text-blue-600 hover:underline break-all text-sm block"
                         x-text="selectedLogbook.otherDocumentation"></a>
                    </template>
                  </div>
                </div>
              </div>
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>

<!-- SheetJS Library for Excel Export -->
<script
  src='https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js'
></script>

<script>
function logBookUserData() {
  const PAGE_SIZE = 5;

  return {
    data: [],
    searchInput: '',
    search: '',
    size: PAGE_SIZE,
    currentPage: 1,
    loading: false,
    showModal: false,
    selectedLogbook: null,

    async fetchLogBookUsers() {
      this.loading = true;
      try {
        const res = await fetch('/program/logbookUser/{{course.id}}');
        this.data = await res.json();
      } catch (e) {
        this.data = [];
      } finally {
        this.loading = false;
      }
    },

    handleSearch() {
      this.search = this.searchInput;
      this.currentPage = 1;
    },

    get searchKeyword() {
      return this.search.trim().toLowerCase();
    },

    get filteredAll() {
      if (!this.searchKeyword) return this.data;
      return this.data.filter((l) => this.matchesSearch(l));
    },

    get filteredData() {
      const start = (this.currentPage - 1) * this.size;
      return this.filteredAll.slice(start, start + this.size);
    },

    get amount() {
      return this.filteredAll.length;
    },

    get totalPages() {
      return Math.ceil(this.amount / this.size);
    },

    changePage(page) {
      if (page < 1 || page > this.totalPages) return;
      this.currentPage = page;
    },

    matchesSearch(l) {
      const haystack = [
        l.user?.username,
        l.user?.email,
        l.session?.sessionOrder,
        l.session?.weeks?.weekNumber,
        l.session?.weeks?.course?.name,
        l.session?.weeks?.course?.courseType?.nameClassesType,
        l.session?.weeks?.course?.category?.name,
        l.session?.weeks?.course?.mentors?.[0]?.name,
        l.activity,
        l.activityDetails,
        l.documentation,
        l.process,
        l.obstacles,
        l.otherDocumentation,
      ]
        .filter((v) => v !== undefined && v !== null)
        .join(' ')
        .toLowerCase();
      return haystack.includes(this.searchKeyword);
    },

    padOrder(value) {
      if (value === undefined || value === null || value === '') return '-';
      return String(value).padStart(2, '0');
    },

    isActiveStatus(process) {
      return ['active', 'approved'].includes(String(process ?? '').toLowerCase());
    },

    viewDetail(logbook) {
      this.selectedLogbook = logbook;
      this.showModal = true;
    },

    closeModal() {
      this.showModal = false;
      this.selectedLogbook = null;
    },

    formatDate(value) {
      const options = { year: 'numeric', month: 'long', day: 'numeric' };
      return new Date(value).toLocaleDateString('id-ID', options);
    },

    exportToExcel() {
      try {
        const dataToExport = this.filteredData.map((l, index) => ({
          No: index + 1,
          User: l.user.username,
          Email: l.user.email,
          'Created At': new Date(l.createdAt).toLocaleDateString(),
          'Meeting No': l.session.sessionOrder,
          'Week No': l.session?.weeks?.weekNumber,
          'Program Name': l.session?.weeks?.course?.name,
          'Program Type': l.session?.weeks?.course?.courseType?.nameClassesType,
          Category: l.session?.weeks?.course?.category?.name,
          Mentor: l.session.weeks.course.mentors[0]?.name || '',
          Activity: l.activity,
          'Activity Details': l.activityDetails,
          Documentation: l.documentation,
          Status: l.process,
          Issues: l.obstacles,
          'Additional Documentation': l.otherDocumentation,
        }));

        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.json_to_sheet(dataToExport);

        ws['!cols'] = [
          { wch: 5 },
          { wch: 20 },
          { wch: 15 },
          { wch: 10 },
          { wch: 8 },
          { wch: 25 },
          { wch: 15 },
          { wch: 15 },
          { wch: 20 },
          { wch: 30 },
          { wch: 50 },
          { wch: 60 },
          { wch: 12 },
          { wch: 40 },
          { wch: 60 },
        ];

        XLSX.utils.book_append_sheet(wb, ws, 'Log Book User');

        XLSX.writeFile(
          wb,
          `Log_Book_User_${new Date().toISOString().slice(0, 10)}.xlsx`,
        );
      } catch (err) {
        alert('Failed to export data to Excel');
        console.error(err);
      }
    },
  };
}
</script>
