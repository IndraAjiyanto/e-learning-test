{{!--
  Tab: Logbook Mentor — Table Detail Program - Logbook Mentor (mirror frame wWq5L / Logbook User)
  Path: partials/course/log_book_mentor_tab.hbs
  Dipakai: admin/course/detail.hbs → x-show tab === 'log_book_mentor', x-data="logBookMentorData()" x-init="fetchLogBookMentors()"
  Route data: GET /program/logbookMentor/:courseId → MentorLogbook[] { session{ sessionOrder, weeks{ weekNumber, course{ name, category, courseType, mentors } } }, activity, activityDetail, documentation, obstacle, createdAt }
  Layout: content gap 12 → filter row (search fill + export) + logbook-mentor-table + pagination
  Komponen: form/search-input (widthClass w-full), program/logbook-export-button,
            program/logbook-mentor-table (→ logbook-pill), table/pagination
--}}
<div class='box-border w-full flex flex-col gap-[12px] justify-start items-stretch'>

  {{!-- Filter Row: search fill_container + export --}}
  <div class='box-border w-full flex flex-row gap-[12px] justify-start items-center'>
    <div class='flex-1 min-w-0'>
      {{> components/ui/admin/form/search-input placeholder='Search logbook...' name='searchLogbookMentor' value='searchInput' widthClass='w-full'}}
    </div>
    {{> components/ui/admin/program/logbook-export-button}}
  </div>

  {{> components/ui/admin/program/logbook-mentor-table}}

  {{!-- Pagination menyatu: border atas, reuse table/pagination (currentPage 1-based, totalPages, changePage) --}}
  <div x-show='!loading && totalPages > 1' class='w-full [border-width:1px_0px_0px_0px] [border-style:solid] [border-color:#E5E5E5]'>
    {{> components/ui/admin/table/pagination}}
  </div>
</div>

<!-- SheetJS Library for Excel Export -->
<script
  src='https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js'
></script>

<script>
function logBookMentorData() {
  const PAGE_SIZE = 5;

  return {
    data: [],
    searchInput: '',
    search: '',
    size: PAGE_SIZE,
    currentPage: 1,
    loading: false,

    async fetchLogBookMentors() {
      this.loading = true;
      try {
        const res = await fetch('/program/logbookMentor/{{course.id}}');
        this.data = await res.json();
      } catch (e) {
        this.data = [];
      } finally {
        this.loading = false;
      }
    },

    handleSearch() {
      this.search = this.searchInput;
      this.currentPage = 1;
    },

    get searchKeyword() {
      return this.search.trim().toLowerCase();
    },

    get filteredAll() {
      if (!this.searchKeyword) return this.data;
      return this.data.filter((l) => this.matchesSearch(l));
    },

    get filteredData() {
      const start = (this.currentPage - 1) * this.size;
      return this.filteredAll.slice(start, start + this.size);
    },

    get amount() {
      return this.filteredAll.length;
    },

    get totalPages() {
      return Math.ceil(this.amount / this.size);
    },

    changePage(page) {
      if (page < 1 || page > this.totalPages) return;
      this.currentPage = page;
    },

    matchesSearch(l) {
      const haystack = [
        l.user?.username,
        l.user?.email,
        l.session?.weeks?.course?.mentors?.[0]?.name,
        l.session?.sessionOrder,
        l.session?.weeks?.weekNumber,
        l.session?.weeks?.course?.name,
        l.session?.weeks?.course?.courseType?.nameClassesType,
        l.session?.weeks?.course?.category?.name,
        l.activity,
        l.activityDetail,
        l.documentation,
        l.obstacle,
      ]
        .filter((v) => v !== undefined && v !== null)
        .join(' ')
        .toLowerCase();
      return haystack.includes(this.searchKeyword);
    },

    padOrder(value) {
      if (value === undefined || value === null || value === '') return '-';
      return String(value).padStart(2, '0');
    },

    formatDate(value) {
      const options = { year: 'numeric', month: 'long', day: 'numeric' };
      return new Date(value).toLocaleDateString('id-ID', options);
    },

    exportToExcel() {
      try {
        const dataToExport = this.filteredData.map((l, index) => ({
          No: index + 1,
          User: l.user?.username,
          Email: l.user?.email,
          'Date Created': new Date(l.createdAt).toLocaleDateString(),
          'No Meeting': l.session.sessionOrder,
          'No Week': l.session?.weeks?.weekNumber,
          'Program Name': l.session?.weeks?.course?.name,
          Category: l.session?.weeks?.course?.category?.name,
          'Program Type': l.session?.weeks?.course?.courseType?.nameClassesType,
          Mentor: l.session?.weeks?.course?.mentors?.[0]?.name,
          Activity: l.activity,
          'Activity Details': l.activityDetail,
          Documentation: l.documentation,
          Issues: l.obstacle,
        }));

        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.json_to_sheet(dataToExport);

        ws['!cols'] = [
          { wch: 5 },
          { wch: 20 },
          { wch: 20 },
          { wch: 15 },
          { wch: 10 },
          { wch: 8 },
          { wch: 25 },
          { wch: 15 },
          { wch: 15 },
          { wch: 20 },
          { wch: 30 },
          { wch: 50 },
          { wch: 60 },
          { wch: 40 },
        ];

        XLSX.utils.book_append_sheet(wb, ws, 'Log Book Mentor');
        XLSX.writeFile(
          wb,
          `Log_Book_Mentor_${new Date().toISOString().slice(0, 10)}.xlsx`,
        );
      } catch (err) {
        alert('Failed to export data to Excel');
        console.error(err);
      }
    },
  };
}
</script>