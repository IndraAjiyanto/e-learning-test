{{!--
  Tab: Mentor — Table Detail Program - Mentor (Pencil H6vxaE)
  Path: partials/course/mentor_tab.hbs
  Dipakai: admin/course/detail.hbs → x-show tab === 'mentor', x-data="mentorData()" x-init="fetchMentors()"
  Route data: GET /program/mentorProgram/:courseId → Mentors[] { name, position{id,en,ja}, description{id,en,ja}, linkedin, profile, technologies[{name}] }
  Layout (H6vxaE exact): content gap 12 → filter row (search fill + Add Mentor 128) + table 1367 + pagination
  Komponen: form/search-input (widthClass w-full, placeholder Search mentor...), button/primary-button (Add Mentor 128),
            program/mentor-table (→ mentor-avatar, badge/mentor-tech-badge, text/mentor-link, button/mentor-action-buttons),
            table/pagination
--}}
<div class='box-border w-full flex flex-col gap-[12px] justify-start items-stretch'>

  {{!-- Filter Row: H6vxaE exact — search fill + Add Mentor 128 (gap 12) --}}
  <div class='box-border w-full flex flex-row gap-[12px] justify-start items-center'>
    <div class='flex-1 min-w-0'>
      {{> components/ui/admin/form/search-input placeholder='Search mentor...' name='searchMentor' value='searchInput' widthClass='w-full'}}
    </div>
    {{> components/ui/admin/button/primary-button text='Add Mentor' href=(concat '/mentor/formCreate/' course.id) width='128'}}
  </div>

  {{> components/ui/admin/program/mentor-table}}

  {{!-- Pagination menyatu: border atas, reuse table/pagination (currentPage 1-based, totalPages, changePage) --}}
  <div x-show='!loading && totalPages > 1' class='w-full [border-width:1px_0px_0px_0px] [border-style:solid] [border-color:#E5E5E5]'>
    {{> components/ui/admin/table/pagination}}
  </div>
</div>

<script>
function mentorData() {
  const MENTOR_PAGE_SIZE = 10;
  const MENTOR_TECH_TEXT = ['#0284C7', '#6941C6', '#EA580C'];
  const MENTOR_TECH_BG = ['#E0F2FE', '#F4EBFF', '#FFEDD5'];
  const MENTOR_API_URL = '/program/mentorProgram/{{course.id}}';

  return {
    data: [],
    searchInput: '',
    search: '',
    size: MENTOR_PAGE_SIZE,
    currentPage: 1,
    loading: false,

    async fetchMentors() {
      this.loading = true;
      try {
        this.data = await this._fetchJson(MENTOR_API_URL);
      } catch (_e) {
        this.data = [];
      } finally {
        this.loading = false;
      }
    },

    async _fetchJson(url) {
      const res = await fetch(url);
      if (!res.ok) throw new Error('Fetch failed: ' + res.status);
      return res.json();
    },

    handleSearch() {
      this.search = this.searchInput;
      this.currentPage = 1;
    },

    get searchKeyword() {
      return this.search.trim().toLowerCase();
    },

    get filteredAll() {
      if (!this.searchKeyword) return this.data;
      return this.data.filter((m) => this.matchesSearch(m));
    },

    get filteredData() {
      const start = (this.currentPage - 1) * this.size;
      return this.filteredAll.slice(start, start + this.size);
    },

    get amount() {
      return this.filteredAll.length;
    },

    get totalPages() {
      return Math.ceil(this.amount / this.size) || 1;
    },

    changePage(page) {
      if (page < 1 || page > this.totalPages) return;
      this.currentPage = page;
    },

    matchesSearch(m) {
      if (!this.searchKeyword) return true;
      const haystack = this._buildHaystack(m).toLowerCase();
      return haystack.includes(this.searchKeyword);
    },

    _buildHaystack(m) {
      const techNames = (m.technologies ?? []).map((t) => t.name).join(' ');
      return [m.name, this.joinList(m.position), this.joinList(m.description), m.linkedin, techNames]
        .filter((v) => v != null && String(v).trim() !== '' && String(v).trim() !== '-')
        .join(' ');
    },

    joinList(value) {
      if (Array.isArray(value) && value.length > 0) return value.join(', ');
      if (Array.isArray(value)) return '-';
      if (value && typeof value === 'object') {
        return Object.values(value).filter(Boolean).join(', ') || '-';
      }
      return value ?? '-';
    },

    mentorTechColor(index) {
      return MENTOR_TECH_TEXT[index % MENTOR_TECH_TEXT.length];
    },

    mentorTechBg(index) {
      return MENTOR_TECH_BG[index % MENTOR_TECH_BG.length];
    },

    mentorConfirmDelete(buttonEl, mentorName) {
      const name = mentorName ? '"' + mentorName + '"' : 'this mentor';
      if (typeof Swal === 'undefined') {
        if (confirm('Delete ' + name + '?')) buttonEl.closest('form').submit();
        return;
      }
      Swal.fire({
        title: 'Delete Mentor',
        text: 'Are you sure you want to delete ' + name + '?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#DC2626',
        cancelButtonColor: '#525252',
        confirmButtonText: 'Delete',
      }).then((result) => {
        if (result.isConfirmed) buttonEl.closest('form').submit();
      });
    },
  };
}
</script>
