<!-- ===================== TAB SYLABUS ===================== -->
{{!--
  Tab: Sylabus — Non Bootcamp
  Path: partials/course/sylabus_tab.hbs
  Dipakai: admin/course/detail_syllabus.hbs (x-show="tab === 'sylabus'")
--}}

<div class='flex flex-col gap-[10px] w-full'>
  <!-- Header Toolbar (Manage Delete) -->
  <div class='flex flex-col gap-3' x-show='items && items.length > 0'>
    <div class='flex items-center justify-between'>
      <div>
        <span class='font-inter text-sm font-medium text-[#737373]' x-text="'Total ' + items.length + ' Syllabus' + (items.length > 1 ? 'es' : '')"></span>
      </div>
      <div>
        <button
          type='button'
          @click='toggleSelectMode()'
          class='inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-lg border font-inter text-sm font-semibold transition-all shadow-sm cursor-pointer'
          :class="selectMode ? 'bg-[#F5F5F5] border-[#D4D4D4] hover:bg-[#E5E5E5] text-[#404040] w-10 px-0' : 'bg-white border-[#D4D4D4] hover:border-[#DC2626] hover:bg-[#FEF2F2] text-[#404040] hover:text-[#DC2626] px-3.5'"
          :title="selectMode ? 'Close' : 'Manage Delete'"
        >
          <template x-if='!selectMode'>
            <div class='flex items-center gap-1.5'>
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4 text-[#DC2626]'>
                <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
              </svg>
              <span>Manage Delete</span>
            </div>
          </template>
          <template x-if='selectMode'>
            <div class='flex items-center justify-center'>
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4 text-[#525252]'>
                <line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/>
              </svg>
            </div>
          </template>
        </button>
      </div>
    </div>

    {{!-- Bulk Selection Action Bar --}}
    <div
      x-show='selectMode'
      x-cloak
      x-transition:enter='transition ease-out duration-150'
      x-transition:enter-start='opacity-0 -translate-y-2'
      x-transition:enter-end='opacity-100 translate-y-0'
      x-transition:leave='transition ease-in duration-100'
      x-transition:leave-start='opacity-100 translate-y-0'
      x-transition:leave-end='opacity-0 -translate-y-2'
      class='box-border w-full flex flex-col sm:flex-row justify-between items-center px-4 py-2.5 bg-[#FEF2F2] border border-[#FCA5A5] rounded-lg gap-2.5 shadow-sm'
      style='display: none;'
    >
      <div class='flex flex-wrap items-center gap-2 text-[14px] text-[#991B1B] font-inter font-medium'>
        <svg class='w-5 h-5 text-[#DC2626] shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'/>
        </svg>
        <span>
          <strong x-text='selectedIds ? selectedIds.length : 0'></strong> syllabus(es) selected
        </span>

        <span class='text-[#FCA5A5] mx-1'>•</span>

        <button
          type='button'
          @click='toggleSelectAll()'
          class='text-xs text-[#DC2626] hover:underline font-semibold cursor-pointer'
          x-text="isAllSelected() ? 'Deselect All' : 'Select All'"
        ></button>

        <template x-if='selectedIds && selectedIds.length > 0'>
          <button
            type='button'
            @click='clearSelection()'
            class='text-xs text-[#7F1D1D] hover:underline font-normal cursor-pointer ml-1'
          >
            (Clear Selection)
          </button>
        </template>
      </div>

      <div class='flex items-center gap-2 w-full sm:w-auto justify-end'>
        <button
          type='button'
          @click='confirmDeleteSelected()'
          :disabled='!selectedIds || selectedIds.length === 0'
          class='inline-flex h-9 items-center justify-center gap-1.5 rounded-lg border border-[#DC2626] bg-[#DC2626] px-3.5 py-1.5 font-inter text-xs font-semibold text-white shadow-sm transition-colors hover:border-[#B91C1C] hover:bg-[#B91C1C] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#DC2626]/40 active:bg-[#991B1B] disabled:cursor-not-allowed disabled:opacity-50'
        >
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-3.5 h-3.5'>
            <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
          </svg>
          <span>Delete Selected (<span x-text='selectedIds ? selectedIds.length : 0'></span>)</span>
        </button>

        <button
          type='button'
          @click='toggleSelectMode()'
          class='inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[#FCA5A5] bg-white text-[#991B1B] hover:bg-[#FEE2E2] transition-colors'
          title='Close Manage Delete'
        >
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4'>
            <line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <template x-if="items && items.length > 0">
    <div class='flex flex-col gap-[10px] w-full'>
      <template x-for="(item, index) in items" :key="item.id">
        <div
          class='box-border w-full shrink-0 min-h-[68px] h-fit flex flex-row items-center p-[8px_14px] gap-[10px] bg-[#FFFFFF] border border-[#D9D9D9] rounded-[8px] hover:bg-[#FAFAFA] transition-colors'
          :class="selectedIds && selectedIds.includes(item.id) ? 'bg-[#FEF2F2]/60 border-[#FCA5A5]' : ''"
        >

          {{!-- Checkbox saat selectMode --}}
          <template x-if='selectMode'>
            <div class='shrink-0 flex items-center pr-1'>
              <label class='relative flex h-5 w-5 items-center justify-center cursor-pointer'>
                <input
                  type='checkbox'
                  :value='item.id'
                  x-model='selectedIds'
                  :disabled='item.isCompleted'
                  :title="item.isCompleted ? 'Cannot delete syllabus: already completed by a user' : 'Select syllabus'"
                  class='h-4 w-4 rounded border-[#d4d4d4] text-[#003060] focus:ring-[#003060]/20 disabled:opacity-40 disabled:cursor-not-allowed'
                />
              </label>
            </div>
          </template>

          <div class='flex flex-col gap-[2px] flex-1 min-w-0 justify-center items-start'>
            <div class='w-full h-[20px] flex flex-row items-center gap-[8px]'>
              <span class='font-inter font-semibold text-[14px] leading-[20px] text-[#003060] truncate'
                   x-text="item.title || item.topic || ('Pertemuan ' + String(item.orderNumber || (index + 1)).padStart(2, '0'))"
                   :title="item.title || item.topic || ''"></span>
              <template x-if="item.isFinal">
                <span class='box-border h-[20px] bg-[#DCFCE7] rounded-[16px] px-[8px] py-[2px] flex items-center justify-center shrink-0'>
                  <span class='font-inter font-medium text-[11px] leading-[16px] text-[#15803D] whitespace-nowrap'>
                    Final
                  </span>
                </span>
              </template>
            </div>
            <div class='w-full h-[23px] font-inter font-medium text-[14px] leading-[23px] text-[#737373] flex items-center truncate'
                 x-text="item.description || '-'" :title="item.description || ''"></div>
          </div>

          {{!-- Delete --}}
          <template x-if="!item.isCompleted">
            <form :action="item.deleteUrl" method='POST' class='box-border w-[44px] shrink-0 h-[44px] m-0 p-0'>
              <button type='button'
                onclick='openDeleteModal(this)'
                class='box-border w-[44px] h-[44px] flex flex-row justify-center items-center bg-[#FFFFFF] border border-[#D9D9D9] rounded-[8px] hover:bg-[#FEF2F2] transition-colors'
                title='Delete Sylabus' aria-label='Delete Sylabus'>
                <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#C80606' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'>
                  <path d='M3 6h18'/>
                  <path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/>
                  <path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/>
                  <line x1='10' x2='10' y1='11' y2='17'/>
                  <line x1='14' x2='14' y1='11' y2='17'/>
                </svg>
              </button>
            </form>
          </template>

          <template x-if="item.isCompleted">
            <div class='box-border w-[44px] shrink-0 h-[44px] flex items-center justify-center opacity-40 cursor-not-allowed m-0 p-0'
                 title='Cannot delete syllabus: already completed by a user'>
              <button type='button' disabled class='box-border w-[44px] h-[44px] flex items-center justify-center bg-[#F5F5F5] rounded-[8px] border border-[#E5E5E5] cursor-not-allowed text-[#A3A3A3]'>
                <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'>
                  <path d='M3 6h18'/>
                  <path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/>
                  <path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/>
                  <line x1='10' x2='10' y1='11' y2='17'/>
                  <line x1='14' x2='14' y1='11' y2='17'/>
                </svg>
              </button>
            </div>
          </template>

          <a :href="item.detailUrl"
            class='box-border w-[81px] shrink-0 h-[44px] flex flex-row justify-center items-center p-[10px_18px] gap-[8px] bg-[#FFFFFF] border border-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] hover:bg-[#F0F7FF] transition-colors'
            title='Sylabus Detail' aria-label='Sylabus Detail'>
            <span class='w-[45px] h-[24px] font-inter font-semibold text-[16px] leading-[24px] text-[#003060] flex items-center justify-center whitespace-nowrap'>Detail</span>
          </a>

        </div>
      </template>
    </div>
  </template>

  {{#if portfolioGuide}}
    <div class='box-border w-full shrink-0 min-h-[68px] h-fit flex flex-row items-center p-[8px_14px] gap-[6px] bg-[#FFFFFF] border border-[#D9D9D9] rounded-[8px] hover:bg-[#FAFAFA] transition-colors'>
      <div class='flex flex-col gap-[2px] flex-1 min-w-0 justify-center items-start'>
        <div class='w-full h-[20px] flex flex-row items-center gap-[8px]'>
          <span class='font-inter font-semibold text-[14px] leading-[20px] text-[#003060] truncate'>Portfolio Guide</span>
        </div>
      </div>

      {{#unless portfolioGuideLocked}}
        <form action='/program/portfolio-guide/{{course.id}}?_method=DELETE' method='POST' class='box-border w-[44px] shrink-0 h-[44px] m-0 p-0'>
          <button type='button'
            onclick='openDeleteModal(this)'
            class='box-border w-[44px] h-[44px] flex flex-row justify-center items-center bg-[#FFFFFF] border border-[#D9D9D9] rounded-[8px] hover:bg-[#FEF2F2] transition-colors'
            title='Delete Portfolio Guide' aria-label='Delete Portfolio Guide'>
            <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#C80606' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'>
              <path d='M3 6h18'/>
              <path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/>
              <path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/>
              <line x1='10' x2='10' y1='11' y2='17'/>
              <line x1='14' x2='14' y1='11' y2='17'/>
            </svg>
          </button>
        </form>
      {{/unless}}

      <a href='/program/portfolio-guide/detail/{{course.id}}'
        class='box-border w-[81px] shrink-0 h-[44px] flex flex-row justify-center items-center p-[10px_18px] gap-[8px] bg-[#FFFFFF] border border-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] hover:bg-[#F0F7FF] transition-colors'
        title='Portfolio Guide Detail' aria-label='Portfolio Guide Detail'>
        <span class='w-[45px] h-[24px] font-inter font-semibold text-[16px] leading-[24px] text-[#003060] flex items-center justify-center whitespace-nowrap'>Detail</span>
      </a>
    </div>
  {{else}}
    <template x-if="hasFinalSyllabus">
      <a href='/program/portfolio-guide/{{course.id}}'
        class='box-border w-full shrink-0 h-[44px] flex flex-row justify-center items-center p-[10px_18px] gap-[8px] bg-[#FFFFFF] border border-[#3B82F6] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] hover:bg-[#F0F7FF] transition-colors'>
        <i class='fa-solid fa-briefcase text-[#3B82F6]'></i>
        <span class='h-[24px] font-inter font-semibold text-[16px] leading-[24px] text-[#3B82F6] flex items-center justify-center whitespace-nowrap'>Create Portfolio Guide</span>
      </a>
    </template>
  {{/if}}

  <!-- Empty State -->
  <template x-if="!items || items.length === 0">
    <div class='w-full h-[72px] flex items-center justify-center'>
      <span class='font-inter text-sm text-[#A3A3A3]'>No sylabus yet. Click Add Sylabus to create one.</span>
    </div>
  </template>

  <template x-if="!hasFinalSyllabus">
    <a :href="addUrl"
      class='box-border w-full shrink-0 h-[44px] flex flex-row justify-center items-center p-[10px_18px] gap-[8px] bg-[#FFFFFF] border border-[#3B82F6] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] hover:bg-[#F0F7FF] transition-colors'>
      <span class='h-[24px] font-inter font-semibold text-[16px] leading-[24px] text-[#3B82F6] flex items-center justify-center whitespace-nowrap'>Add Sylabus</span>
    </a>
  </template>
</div>

<script>
function sylabusData() {
  return {
    rawSyllabus: [],
    selectMode: false,
    selectedIds: [],

    toggleSelectMode() {
      this.selectMode = !this.selectMode;
      if (!this.selectMode) {
        this.selectedIds = [];
      }
    },

    get hasFinalSyllabus() {
      if (this.rawSyllabus && this.rawSyllabus.length > 0) {
        return this.rawSyllabus.some(s => s.isFinal === true || s.isFinal === 'true' || s.isFinal === 1);
      }
      return false;
    },

    get items() {
      if (this.rawSyllabus && this.rawSyllabus.length > 0) {
        return this.rawSyllabus.map((s, index) => ({
          id: s.id,
          orderNumber: s.syllabusNumber || (index + 1),
          title: s.title || '',
          topic: s.title || '',
          description: s.description || '',
          isFinal: !!s.isFinal,
          isCompleted: !!s.isCompleted,
          detailUrl: '/syllabus/' + s.id,
          deleteUrl: '/syllabus/' + s.id + '/{{course.id}}?_method=DELETE',
        }));
      }
      return [];
    },

    get deletableItems() {
      return this.items.filter(s => !s.isCompleted);
    },

    isAllSelected() {
      const deletable = this.deletableItems;
      if (!deletable || deletable.length === 0) return false;
      return deletable.every(s => this.selectedIds.some(id => String(id) === String(s.id)));
    },

    toggleSelectAll() {
      const deletable = this.deletableItems;
      if (this.isAllSelected()) {
        const delSet = new Set(deletable.map(s => String(s.id)));
        this.selectedIds = this.selectedIds.filter(id => !delSet.has(String(id)));
      } else {
        const currentSet = new Set(this.selectedIds.map(String));
        deletable.forEach(s => {
          if (!currentSet.has(String(s.id))) {
            this.selectedIds.push(s.id);
            currentSet.add(String(s.id));
          }
        });
      }
    },

    clearSelection() {
      this.selectedIds = [];
    },

    confirmDeleteSelected() {
      const count = this.selectedIds.length;
      if (count === 0) return;

      if (typeof openDeleteModal === 'function') {
        openDeleteModal({
          title: `Delete ${count} Selected Syllabus(es)?`,
          description: `Are you sure you want to delete ${count} selected syllabus(es)? Remaining syllabus meetings will be automatically re-sequenced. This action cannot be undone.`,
          confirmLabel: `Delete (${count})`,
          cancelLabel: 'Cancel',
          onConfirm: async () => {
            await this.executeDeleteSelected();
          }
        });
      }
    },

    executeDeleteSelected() {
      submitDeleteForm('/bulk-delete/selected', {
        entity: 'syllabus',
        ids: this.selectedIds,
      });
    },

    get addUrl() {
      return '/program/create-syllabus/{{course.id}}';
    },

    async fetchSylabus() {
      try {
        const res = await fetch('/syllabus/course/{{course.id}}');
        if (res.ok) {
          const data = await res.json();
          if (Array.isArray(data)) {
            this.rawSyllabus = data;
          }
        }
      } catch (e) {
        console.error('Fetch syllabus error:', e);
        this.rawSyllabus = [];
      }
    }
  }
}
</script>
