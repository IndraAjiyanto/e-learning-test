<!-- ===================== TAB WEEK ===================== -->
{{!--
  Row: h68 white, radius 8, stroke #D9D9D9, gap 6, p8 14
  Texts: "Pertemuan NN" Montserrat 14/600 #003060 + description Montserrat 14/500 #737373
  Delete: 44x44 white stroke #D9D9D9, trash-2 16px #C80606 (pen $danger)
  Detail: 81x44 white stroke #003060 + shadow, Inter 16/600 #003060
  Add Week: full-width h44 white, solid 1px #3B82F6 + shadow, Inter 16/600 #3B82F6
  Data: Alpine `data` (weekData().fetchWeeks -> GET /program/week/:courseId)
--}}

<!-- Daftar Week -->
<template x-if="data && data.length > 0">
  <div class='flex flex-col gap-[10px] w-full mb-[10px]'>
    <template x-for="(weeks, index) in data" :key='weeks.id'>
      <div class='box-border w-full shrink-0 min-h-[68px] h-fit flex flex-row gap-[6px] p-[8px_14px] justify-start items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] hover:bg-[#fafafa] transition-colors'>

        {{!-- Texts --}}
        <div class='flex flex-col gap-[2px] flex-1 min-w-0 justify-center items-start'>
          <div class='text-[14px]/[normal] w-full text-[#003060] font-inter font-semibold whitespace-nowrap overflow-hidden text-ellipsis' x-text="'Pertemuan ' + String(weeks.weekNumber).padStart(2, '0')"></div>
          <div class='text-[14px]/[normal] w-full text-[#737373] font-inter font-medium break-words' x-text='weeks.description' :title='weeks.description'></div>
        </div>

        {{!-- Delete --}}
        <form :action="'/week/' + weeks.id + '/{{course.id}}?_method=DELETE'" method='POST' class='box-border w-[44px] shrink-0 h-[44px]'>
          <button type='button'
            onclick='openDeleteModal(this)'
            class='box-border w-[44px] h-[44px] flex flex-row gap-0 justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] hover:bg-[#FEF2F2] transition-colors'
            title='Delete Week' aria-label='Delete Week'>
            <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#C80606' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'>
              <path d='M3 6h18'/>
              <path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/>
              <path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/>
              <line x1='10' x2='10' y1='11' y2='17'/>
              <line x1='14' x2='14' y1='11' y2='17'/>
            </svg>
          </button>
        </form>

        {{!-- Detail --}}
        <a :href="'/week/' + weeks.id"
          class='box-border w-[81px] shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#003060] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#F0F7FF] transition-colors'
          title='Week Detail' aria-label='Week Detail'>
          <span class='text-[16px]/[normal] text-[#003060] font-inter font-semibold whitespace-nowrap'>Detail</span>
        </a>

      </div>
    </template>
  </div>
</template>

<!-- Empty State -->
<template x-if="!data || data.length === 0">
  <div class='w-full h-[72px] flex items-center justify-center mb-[10px]'>
    <span class='font-inter text-sm text-[#A3A3A3]'>No week yet. Click Add Week to create one.</span>
  </div>
</template>

<!-- Tombol Tambah Week -->
{{#if lastWeek}}{{else}}
  <a href='/week/formAdd/{{course.id}}'
    class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#3B82F6] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#F0F7FF] transition-colors'>
    <span class='text-[16px]/[normal] text-[#3B82F6] font-inter font-semibold whitespace-nowrap'>Add Week</span>
  </a>
{{/if}}


<script>
function weekData() {
  return {
    data: JSON.parse(localStorage.getItem('activeData')) || [],

    async fetchWeeks() {
      const res = await fetch('/program/week/{{course.id}}');
      this.data = await res.json();

      localStorage.setItem('activeData', JSON.stringify(this.data));
    }
  }
}
</script>
