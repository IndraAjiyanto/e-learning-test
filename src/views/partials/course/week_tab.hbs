<!-- ===================== TAB WEEK ===================== -->
{{!--
  Row: h68 white, radius 8, stroke #D9D9D9, gap 6, p8 14
  Texts: "Pertemuan NN" Montserrat 14/600 #003060 + description Montserrat 14/500 #737373
  Delete: 44x44 white stroke #D9D9D9, trash-2 16px #C80606 (pen $danger)
  Detail: 81x44 white stroke #003060 + shadow, Inter 16/600 #003060
  Add Week: full-width h44 white, solid 1px #3B82F6 + shadow, Inter 16/600 #3B82F6
  Data: Alpine `data` (weekData().fetchWeeks -> GET /program/week/:courseId)
--}}

<div class='flex flex-col gap-3 w-full'>
  <!-- Header Toolbar (Manage Delete) -->
  <div class='flex flex-col gap-3' x-show='data && data.length > 0'>
    <div class='flex items-center justify-between'>
      <div>
        <span class='font-inter text-sm font-medium text-[#737373]' x-text="'Total ' + data.length + ' Meeting' + (data.length > 1 ? 's' : '')"></span>
      </div>
      <div>
        <button
          type='button'
          @click='toggleSelectMode()'
          class='inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-lg border font-inter text-sm font-semibold transition-all shadow-sm cursor-pointer'
          :class="selectMode ? 'bg-[#F5F5F5] border-[#D4D4D4] hover:bg-[#E5E5E5] text-[#404040] w-10 px-0' : 'bg-white border-[#D4D4D4] hover:border-[#DC2626] hover:bg-[#FEF2F2] text-[#404040] hover:text-[#DC2626] px-3.5'"
          :title="selectMode ? 'Close' : 'Manage Delete'"
        >
          <template x-if='!selectMode'>
            <div class='flex items-center gap-1.5'>
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4 text-[#DC2626]'>
                <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
              </svg>
              <span>Manage Delete</span>
            </div>
          </template>
          <template x-if='selectMode'>
            <div class='flex items-center justify-center'>
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4 text-[#525252]'>
                <line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/>
              </svg>
            </div>
          </template>
        </button>
      </div>
    </div>

    {{!-- Bulk Selection Action Bar --}}
    <div
      x-show='selectMode'
      x-cloak
      x-transition:enter='transition ease-out duration-150'
      x-transition:enter-start='opacity-0 -translate-y-2'
      x-transition:enter-end='opacity-100 translate-y-0'
      x-transition:leave='transition ease-in duration-100'
      x-transition:leave-start='opacity-100 translate-y-0'
      x-transition:leave-end='opacity-0 -translate-y-2'
      class='box-border w-full flex flex-col sm:flex-row justify-between items-center px-4 py-2.5 bg-[#FEF2F2] border border-[#FCA5A5] rounded-lg gap-2.5 shadow-sm'
      style='display: none;'
    >
      <div class='flex flex-wrap items-center gap-2 text-[14px] text-[#991B1B] font-inter font-medium'>
        <svg class='w-5 h-5 text-[#DC2626] shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'/>
        </svg>
        <span>
          <strong x-text='selectedIds ? selectedIds.length : 0'></strong> meeting(s) selected
        </span>

        <span class='text-[#FCA5A5] mx-1'>•</span>

        <button
          type='button'
          @click='toggleSelectAll()'
          class='text-xs text-[#DC2626] hover:underline font-semibold cursor-pointer'
          x-text="isAllSelected() ? 'Deselect All' : 'Select All'"
        ></button>

        <template x-if='selectedIds && selectedIds.length > 0'>
          <button
            type='button'
            @click='clearSelection()'
            class='text-xs text-[#7F1D1D] hover:underline font-normal cursor-pointer ml-1'
          >
            (Clear Selection)
          </button>
        </template>
      </div>

      <div class='flex items-center gap-2 w-full sm:w-auto justify-end'>
        <button
          type='button'
          @click='confirmDeleteSelected()'
          :disabled='!selectedIds || selectedIds.length === 0'
          class='inline-flex h-9 items-center justify-center gap-1.5 rounded-lg border border-[#DC2626] bg-[#DC2626] px-3.5 py-1.5 font-inter text-xs font-semibold text-white shadow-sm transition-colors hover:border-[#B91C1C] hover:bg-[#B91C1C] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#DC2626]/40 active:bg-[#991B1B] disabled:cursor-not-allowed disabled:opacity-50'
        >
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-3.5 h-3.5'>
            <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
          </svg>
          <span>Delete Selected (<span x-text='selectedIds ? selectedIds.length : 0'></span>)</span>
        </button>

        <button
          type='button'
          @click='toggleSelectMode()'
          class='inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[#FCA5A5] bg-white text-[#991B1B] hover:bg-[#FEE2E2] transition-colors'
          title='Close Manage Delete'
        >
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4'>
            <line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Daftar Week -->
  <template x-if="data && data.length > 0">
    <div class='flex flex-col gap-[10px] w-full mb-[10px]'>
      <template x-for="(weeks, index) in data" :key='weeks.id'>
        <div
          class='box-border w-full shrink-0 min-h-[68px] h-fit flex flex-row gap-[10px] p-[8px_14px] justify-start items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] hover:bg-[#fafafa] transition-colors'
          :class="selectedIds && selectedIds.includes(weeks.id) ? 'bg-[#FEF2F2]/60 [outline:1px_solid_#FCA5A5]' : ''"
        >

          {{!-- Checkbox saat selectMode --}}
          <template x-if='selectMode'>
            <div class='shrink-0 flex items-center pr-1'>
              <label class='relative flex h-5 w-5 items-center justify-center cursor-pointer'>
                <input
                  type='checkbox'
                  :value='weeks.id'
                  x-model='selectedIds'
                  :disabled='weeks.hasCompletedUser'
                  :title="weeks.hasCompletedUser ? 'Cannot delete: participants have completed tasks in this meeting' : 'Select meeting'"
                  class='h-4 w-4 rounded border-[#d4d4d4] text-[#003060] focus:ring-[#003060]/20 disabled:opacity-40 disabled:cursor-not-allowed'
                />
              </label>
            </div>
          </template>

          {{!-- Texts --}}
          <div class='flex flex-row items-center gap-[8px] flex-1 min-w-0'>
            <span class='text-[16px]/[normal] text-[#718096] font-inter font-medium text-left truncate' x-text='weeks.description' :title='weeks.description'></span>
            <template x-if="weeks.isFinal === true || weeks.isFinal === 'true' || weeks.isFinal === 1">
              <span class='box-border h-[20px] bg-[#DCFCE7] rounded-[16px] px-[8px] py-[2px] flex items-center justify-center shrink-0'>
                <span class='font-inter font-medium text-[11px] leading-[16px] text-[#15803D] whitespace-nowrap'>
                  Final
                </span>
              </span>
            </template>
          </div>

          {{!-- Delete --}}
          <template x-if="!weeks.hasCompletedUser">
            <form :action="'/week/' + weeks.id + '/{{course.id}}?_method=DELETE'" method='POST' class='box-border w-[44px] shrink-0 h-[44px]'>
              <button type='button'
                onclick='openDeleteModal(this)'
                class='box-border w-[44px] h-[44px] flex flex-row gap-0 justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] hover:bg-[#FEF2F2] transition-colors'
                title='Delete Week' aria-label='Delete Week'>
                <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#C80606' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'>
                  <path d='M3 6h18'/>
                  <path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/>
                  <path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/>
                  <line x1='10' x2='10' y1='11' y2='17'/>
                  <line x1='14' x2='14' y1='11' y2='17'/>
                </svg>
              </button>
            </form>
          </template>

          <template x-if="weeks.hasCompletedUser">
            <div class='box-border w-[44px] shrink-0 h-[44px] flex items-center justify-center opacity-40 cursor-not-allowed'
                 title='Cannot delete week: participants have completed tasks in it'>
              <button type='button' disabled class='box-border w-[44px] h-[44px] flex items-center justify-center bg-[#F5F5F5] rounded-[8px] border border-[#E5E5E5] cursor-not-allowed text-[#A3A3A3]'>
                <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'>
                  <path d='M3 6h18'/>
                  <path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/>
                  <path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/>
                  <line x1='10' x2='10' y1='11' y2='17'/>
                  <line x1='14' x2='14' y1='11' y2='17'/>
                </svg>
              </button>
            </div>
          </template>

          {{!-- Detail --}}
          <a :href="'/week/' + weeks.id"
            class='box-border w-[81px] shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#003060] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#F0F7FF] transition-colors'
            title='Week Detail' aria-label='Week Detail'>
            <span class='text-[16px]/[normal] text-[#003060] font-inter font-semibold whitespace-nowrap'>Detail</span>
          </a>

        </div>
      </template>

      {{#if portfolioGuide}}
        <div class='box-border w-full shrink-0 min-h-[68px] h-fit flex flex-row gap-[6px] p-[8px_14px] justify-start items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] hover:bg-[#fafafa] transition-colors'>
          <div class='text-[16px]/[normal] flex-1 min-w-0 w-full text-[#718096] font-inter font-medium text-left break-words'>Portfolio Guide</div>

          {{#unless portfolioGuideLocked}}
            <form action='/program/portfolio-guide/{{course.id}}?_method=DELETE' method='POST' class='box-border w-[44px] shrink-0 h-[44px]'>
              <button type='button'
                onclick='openDeleteModal(this)'
                class='box-border w-[44px] h-[44px] flex flex-row gap-0 justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] hover:bg-[#FEF2F2] transition-colors'
                title='Delete Portfolio Guide' aria-label='Delete Portfolio Guide'>
                <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#C80606' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'>
                  <path d='M3 6h18'/>
                  <path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/>
                  <path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/>
                  <line x1='10' x2='10' y1='11' y2='17'/>
                  <line x1='14' x2='14' y1='11' y2='17'/>
                </svg>
              </button>
            </form>
          {{/unless}}

          <a href='/program/portfolio-guide/detail/{{course.id}}'
            class='box-border w-[81px] shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#003060] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#F0F7FF] transition-colors'
            title='Portfolio Guide Detail' aria-label='Portfolio Guide Detail'>
            <span class='text-[16px]/[normal] text-[#003060] font-inter font-semibold whitespace-nowrap'>Detail</span>
          </a>
        </div>
      {{else}}
        <template x-if="data.some(week => week.isFinal === true || week.isFinal === 'true' || week.isFinal === 1)">
          <a href='/program/portfolio-guide/{{course.id}}'
            class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#3B82F6] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#F0F7FF] transition-colors'>
            <i class='fa-solid fa-briefcase text-[#3B82F6]'></i>
            <span class='text-[16px]/[normal] text-[#3B82F6] font-inter font-semibold whitespace-nowrap'>Create Portfolio Guide</span>
          </a>
        </template>
      {{/if}}
    </div>
  </template>

  <!-- Empty State -->
  <template x-if="!data || data.length === 0">
    <div class='w-full h-[72px] flex items-center justify-center mb-[10px]'>
      <span class='font-inter text-sm text-[#A3A3A3]'>No week yet. Click Add Week to create one.</span>
    </div>
  </template>

  <!-- Tombol Tambah Week -->
  {{#if lastWeek}}{{else}}
    <a href='/week/formAdd/{{course.id}}'
      class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#3B82F6] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#F0F7FF] transition-colors'>
      <span class='text-[16px]/[normal] text-[#3B82F6] font-inter font-semibold whitespace-nowrap'>Add Week</span>
    </a>
  {{/if}}
</div>

<script>
function weekData() {
  return {
    data: JSON.parse(localStorage.getItem('activeData')) || [],
    selectMode: false,
    selectedIds: [],

    toggleSelectMode() {
      this.selectMode = !this.selectMode;
      if (!this.selectMode) {
        this.selectedIds = [];
      }
    },

    get deletableWeeks() {
      return (this.data || []).filter(w => !w.hasCompletedUser);
    },

    isAllSelected() {
      const deletable = this.deletableWeeks;
      if (!deletable || deletable.length === 0) return false;
      return deletable.every(w => this.selectedIds.some(id => String(id) === String(w.id)));
    },

    toggleSelectAll() {
      const deletable = this.deletableWeeks;
      if (this.isAllSelected()) {
        const delSet = new Set(deletable.map(w => String(w.id)));
        this.selectedIds = this.selectedIds.filter(id => !delSet.has(String(id)));
      } else {
        const currentSet = new Set(this.selectedIds.map(String));
        deletable.forEach(w => {
          if (!currentSet.has(String(w.id))) {
            this.selectedIds.push(w.id);
            currentSet.add(String(w.id));
          }
        });
      }
    },

    clearSelection() {
      this.selectedIds = [];
    },

    confirmDeleteSelected() {
      const count = this.selectedIds.length;
      if (count === 0) return;

      if (typeof openDeleteModal === 'function') {
        openDeleteModal({
          title: `Delete ${count} Selected Meeting(s)?`,
          description: `Are you sure you want to delete ${count} selected meeting(s)? Remaining meetings will be automatically re-sequenced. This action cannot be undone.`,
          confirmLabel: `Delete (${count})`,
          cancelLabel: 'Cancel',
          onConfirm: async () => {
            await this.executeDeleteSelected();
          }
        });
      }
    },

    executeDeleteSelected() {
      submitDeleteForm('/bulk-delete/selected', {
        entity: 'week',
        ids: this.selectedIds,
      });
    },

    async fetchWeeks() {
      const res = await fetch('/program/week/{{course.id}}');
      this.data = await res.json();

      localStorage.setItem('activeData', JSON.stringify(this.data));
    }
  }
}
</script>
