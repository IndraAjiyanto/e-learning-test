    <!-- ===================== TAB FLOW (ALUR KELAS) ===================== -->
    
    <!-- Header: Search + Add -->
    <div class="mb-6 flex flex-col md:flex-row md:justify-between md:items-center gap-4">
      <div class="flex items-center gap-3">
        <!-- Search -->
        <div class="relative w-full md:w-64">
          <button 
            @click="search = searchInput; pageNumber=0"
            class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-900">
            <svg xmlns="http://www.w3.org/2000/svg" 
                 class="h-5 w-5" fill="none" viewBox="0 0 24 24" 
                 stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" 
                    stroke-width="2" 
                    d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1110.5 3a7.5 7.5 
                       0 016.15 13.65z" />
            </svg>
          </button>
          <input 
            type="text" 
            placeholder="Search flow..." 
            x-model="searchInput"
            @input="search = searchInput; pageNumber=0"
            class="border border-gray-300 bg-white text-gray-900 rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-gray-900 w-full"
          />
        </div>

        <!-- Tombol Tambah Flow -->
        <a href="/flow-program/formCreate/{{course.id}}"
           class="bg-gray-900 text-white px-4 py-2 rounded-lg shadow hover:bg-gray-700 transition">
          Add Flow
        </a>
      </div>
    </div>

    <!-- Table -->
    <div x-show="data && data.length > 0" class="overflow-x-auto bg-white shadow-lg rounded-xl">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-100">
          <tr>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">No</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Flow</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Tittle</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Description</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <template x-for="(flow, index) in filteredData" :key="flow.id">
          <tr class="hover:bg-gray-50 transition">
            <td class="px-6 py-4 text-sm text-gray-800" x-text="pageNumber * size + index + 1"></td>
            <td class="px-6 py-4 text-sm text-gray-800" x-text="flow.sequence"></td>
            <td class="px-6 py-4 text-sm text-gray-800">
              <template x-for="title in (flow.title || [])">
                <div class="line-clamp-3" x-text="title"></div>
              </template>
              </td>
            <td class="px-6 py-4 text-sm text-gray-800">
              <template x-for="content in (flow.content || [])">
                <div class="line-clamp-3" x-text="content"></div>
              </template>
              </td>
            <td class="px-6 py-4 text-sm flex items-center gap-3">

              <!-- Edit -->
              <a :href="`/flow-program/formEdit/${flow.id}`"
                 class="p-2 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 hover:text-blue-800 transition"
                 title="Edit">
                <svg xmlns="http://www.w3.org/2000/svg"
                     fill="none" viewBox="0 0 24 24"
                     stroke-width="1.5" stroke="currentColor"
                     class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round"
                        d="M16.862 4.487l1.687-1.688a1.875 1.875 
                           0 112.652 2.652L10.582 16.07a4.5 
                           4.5 0 01-1.897 1.13l-2.685.805.805-2.685
                           a4.5 4.5 0 011.13-1.897l10.927-10.936z" />
                  <path stroke-linecap="round" stroke-linejoin="round"
                        d="M19.5 7.125L16.875 4.5" />
                </svg>
              </a>

              <!-- Delete -->
              <form :action="`/flow-program/${flow.id}/{{course.id}}?_method=DELETE`" method="post" class="inline">
                <button type="button" 
                        onclick="confirmDelete(this)" 
                        class="p-2 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-800 transition"
                        title="Delete">
                  <svg xmlns="http://www.w3.org/2000/svg"
                       fill="none" viewBox="0 0 24 24"
                       stroke-width="1.5" stroke="currentColor"
                       class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                  </svg>
                </button>
              </form>
            </td>
          </tr>
          </template>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="w-full md:w-1/2 mx-auto py-6 flex justify-center gap-2 items-center"
         x-show="pageCount() > 1">
      <button @click="prevPage" :disabled="pageNumber==0"
        class="px-3 py-1 rounded border border-gray-900 text-gray-900"
        :class="{ 'opacity-50 cursor-not-allowed': pageNumber==0 }">Prev</button>

      <template x-for="(page,index) in pages()" :key="index">
        <button @click="viewPage(index)" 
          class="px-3 py-1 rounded"
          :class="{ 'bg-gray-900 text-white font-bold': index===pageNumber }"
          x-text="index+1"></button>
      </template>

      <button @click="nextPage" :disabled="pageNumber >= pageCount()-1"
        class="px-3 py-1 rounded border border-gray-900 text-gray-900"
        :class="{ 'opacity-50 cursor-not-allowed': pageNumber >= pageCount()-1 }">Next</button>
    </div>

<script>
function flowData() {
  return {
    data: JSON.parse(localStorage.getItem('activeData')) || [],
    searchInput: '',
    search: '',
    pageNumber: 0,
    size: 5,
    amount: 0,

    async fetchFlow() {
      const res = await fetch('/program/flow/{{course.id}}');
      this.data = await res.json();
      localStorage.setItem('activeData', JSON.stringify(this.data));
    },

    get filteredData() {
      let filtered = this.data.filter(f => {
          const titleStr = f.title ? Object.values(f.title).join(' ') : '';
          const contentStr = f.content ? Object.values(f.content).join(' ') : '';
          return (`${titleStr} ${contentStr}`).toLowerCase()
          .includes(this.search.toLowerCase())
      });

      this.amount = filtered.length;

      const start = this.pageNumber * this.size;
      return filtered.slice(start, start + this.size);
    },

    pageCount() {
      return Math.ceil(this.amount / this.size);
    },

    pages() {
      return Array.from({ length: this.pageCount() });
    },

    nextPage() {
      if (this.pageNumber < this.pageCount() - 1) this.pageNumber++;
    },

    prevPage() {
      if (this.pageNumber > 0) this.pageNumber--;
    },

    viewPage(i) {
      this.pageNumber = i;
    }
  }
}
</script>