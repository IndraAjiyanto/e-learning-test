<!-- ===================== TAB LOG BOOK USER ===================== -->
<div x-data='logBookUserTable({ logBook: {{json logbookUser}} })'>

  <!-- Header: Search + Export -->
  <div
    class='mb-6 flex flex-col md:flex-row md:justify-between md:items-center gap-4'
  >
    <div class='flex items-center gap-3'>
      <!-- Search -->
      <div class='relative w-full md:w-64'>
        <button
          @click='search = searchInput; pageNumber=0'
          class='absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-900'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            class='h-5 w-5'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M21 21l-4.35-4.35m0 0A7.5 7.5 0 1110.5 3a7.5 7.5
                     0 016.15 13.65z'
            />
          </svg>
        </button>
        <input
          type='text'
          placeholder='Search user logbook...'
          x-model='searchInput'
          @input='search = searchInput; pageNumber=0'
          class='border border-gray-300 bg-white text-gray-900 rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-gray-900 w-full'
        />
      </div>
    </div>

    <!-- Export Button -->

    <button
      @click='exportToExcel()'
      class='flex items-center justify-center gap-2 bg-green-600 text-white px-4 py-2 rounded-lg shadow hover:bg-green-700 transition whitespace-nowrap'
    >
      <svg
        xmlns='http://www.w3.org/2000/svg'
        viewBox='0 0 48 48'
        class='h-5 w-5 rounded shadow'
      >
        <path
          fill='#185C37'
          d='M42 6H14a2 2 0 0 0-2 2v32a2 2 0 0 0 2 2h28a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2z'
        />
        <path fill='#21A366' d='M14 6H8a2 2 0 0 0-2 2v32a2 2 0 0 0 2 2h6V6z' />
        <path fill='#107C41' d='M22 14H8v20h14V14z' />
        <path
          fill='#fff'
          d='M19 31h-2.1l-2.9-5-2.9 5H9l4.2-7-4.1-7h2.1l2.9 5 2.9-5H19l-4.2 7 4.2 7z'
        />
      </svg>
      Export Excel
    </button>

  </div>

  <!-- Table -->
  <div class='overflow-x-auto bg-white shadow-lg rounded-xl'>
    <table class='min-w-full divide-y divide-gray-200'>
      <thead class='bg-gray-100'>
        <tr>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >No</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >User</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Email</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Created At</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Meeting No</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Week No</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Program Name</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Program Type</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Category</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Mentor</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Activity</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Activity Details</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Documentation</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Status</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Issues</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Additional Documentation</th>
        </tr>
      </thead>
      <tbody class='divide-y divide-gray-200'>
        {{#each logbookUser}}
          <tr
            class='hover:bg-gray-50 transition'
            x-show="filteredLogBook.includes('{{id}}')"
          >
            <td class='px-6 py-4 text-sm text-gray-800'>{{addOne @index}}</td>
            <td class='px-6 py-4 text-sm text-gray-800'>{{user.username}}</td>
            <td class='px-6 py-4 text-sm text-gray-800'>{{user.email}}</td>
            <td class='px-6 py-4 text-sm text-gray-800'>{{formatTanggal
                createdAt
              }}</td>
            <td
              class='px-6 py-4 text-sm text-gray-800'
            >{{pertemuan.pertemuan_ke}}</td>
            <td
              class='px-6 py-4 text-sm text-gray-800'
            >{{pertemuan.minggu.minggu_ke}}</td>
            <td
              class='px-6 py-4 text-sm text-gray-800'
            >{{pertemuan.minggu.kelas.nama_kelas}}</td>
            <td
              class='px-6 py-4 text-sm text-gray-800'
            >{{pertemuan.minggu.kelas.jenis_kelas.nama_jenis_kelas}}</td>
            <td
              class='px-6 py-4 text-sm text-gray-800'
            >{{pertemuan.minggu.kelas.kategori.nama_kategori}}</td>
            <td
              class='px-6 py-4 text-sm text-gray-800'
            >{{pertemuan.minggu.kelas.mentor.[0].nama}}</td>
            <td class='px-6 py-4 text-sm text-gray-800'>{{kegiatan}}</td>
            <td
              class='px-6 py-4 text-sm text-gray-800'
            >{{rincian_kegiatan}}</td>
            <td class='px-6 py-4 text-sm text-gray-800'>{{dokumentasi}}</td>
            <td class='px-6 py-4 text-sm text-gray-800'>{{proses}}</td>
            <td class='px-6 py-4 text-sm text-gray-800'>{{kendala}}</td>
            <td
              class='px-6 py-4 text-sm text-gray-800'
            >{{dokumentasi_lain}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <div
    class='w-full md:w-1/2 mx-auto py-6 flex justify-center gap-2 items-center'
    x-show='pageCount() > 1'
  >
    <button
      @click='prevPage'
      :disabled='pageNumber==0'
      class='px-3 py-1 rounded border border-gray-900 text-gray-900'
      :class="{ 'opacity-50 cursor-not-allowed': pageNumber==0 }"
    >
      Prev
    </button>
    <template x-for='(page,index) in pages()' :key='index'>
      <button
        @click='viewPage(index)'
        class='px-3 py-1 rounded'
        :class="{ 'bg-gray-900 text-white font-bold': index===pageNumber }"
        x-text='index+1'
      >
      </button>
    </template>
    <button
      @click='nextPage'
      :disabled='pageNumber >= pageCount()-1'
      class='px-3 py-1 rounded border border-gray-900 text-gray-900'
      :class="{ 'opacity-50 cursor-not-allowed': pageNumber >= pageCount()-1 }"
    >
      Next
    </button>
  </div>
</div>

<!-- SheetJS Library for Excel Export -->
<script
  src='https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js'
></script>

<script>
  function logBookUserTable({ logBook }) {
    return {
      searchInput: "",
      search: "",
      pageNumber: 0,
      size: 5,
      logBook,
      amount: 0,
      filteredData: [],

      get filteredLogBook() {
        const s = this.search.toLowerCase();

        let filtered = this.logBook.filter(l =>
          (
            `${l.user.username}
             ${l.pertemuan.pertemuan_ke}
             ${l.pertemuan.minggu.minggu_ke}
             ${l.pertemuan.minggu.kelas.nama_kelas}
             ${l.pertemuan.minggu.kelas.jenis_kelas.nama_jenis_kelas}
             ${l.pertemuan.minggu.kelas.kategori.nama_kategori}
             ${l.pertemuan.minggu.kelas.mentor[0]?.nama_lengkap || ""}
             ${l.kegiatan}
             ${l.rincian_kegiatan}
             ${l.dokumentasi}
             ${l.proses}
             ${l.kendala}
             ${l.dokumentasi_lain}`
          )
            .toLowerCase()
            .includes(s)
        );

        this.amount = filtered.length;
        this.filteredData = filtered;

        const start = this.pageNumber * this.size;
        const end = start + this.size;

        return filtered.slice(start, end).map(l => l.id.toString());
      },

      pages() {
        return Array.from({ length: this.pageCount() });
      },

      pageCount() {
        return Math.ceil(this.amount / this.size);
      },

      nextPage() {
        if (this.pageNumber < this.pageCount() - 1) {
          this.pageNumber++;
        }
      },

      prevPage() {
        if (this.pageNumber > 0) {
          this.pageNumber--;
        }
      },

      viewPage(index) {
        this.pageNumber = index;
      },

      exportToExcel() {
        try {
          const dataToExport = this.filteredData.map((l, index) => ({
            No: index + 1,
            User: l.user.username,
            Email: l.user.email,
            "Created At": new Date(l.createdAt).toLocaleDateString(),
            "Meeting No": l.pertemuan.pertemuan_ke,
            "Week No": l.pertemuan.minggu.minggu_ke,
            "Program Name": l.pertemuan.minggu.kelas.nama_kelas,
            "Program Type": l.pertemuan.minggu.kelas.jenis_kelas.nama_jenis_kelas,
            Category: l.pertemuan.minggu.kelas.kategori.nama_kategori,
            Mentor: l.pertemuan.minggu.kelas.mentor[0]?.nama || "",
            Activity: l.kegiatan,
            "Activity Details": l.rincian_kegiatan,
            Documentation: l.dokumentasi,
            Status: l.proses,
            Issues: l.kendala,
            "Additional Documentation": l.dokumentasi_lain
          }));

          const wb = XLSX.utils.book_new();
          const ws = XLSX.utils.json_to_sheet(dataToExport);

          ws["!cols"] = [
            { wch: 5 },   // No
            { wch: 20 },  // User
            { wch: 15 },  // Email
            { wch: 10 },  // Created At
            { wch: 8 },   // Meeting No
            { wch: 25 },  // Program Name
            { wch: 15 },  // Program Type
            { wch: 15 },  // Category
            { wch: 20 },  // Mentor
            { wch: 30 },  // Activity
            { wch: 50 },  // Activity Details
            { wch: 60 },  // Documentation
            { wch: 12 },  // Status
            { wch: 40 },  // Issues
            { wch: 60 }   // Additional Documentation
          ];

          XLSX.utils.book_append_sheet(wb, ws, "Log Book User");

          XLSX.writeFile(
            wb,
            `Log_Book_User_${new Date().toISOString().slice(0, 10)}.xlsx`
          );
        } catch (err) {
          alert("Failed to export data to Excel");
          console.error(err);
        }
      }
    };
  }
</script>
