<div class="w-full mx-auto px-6 py-10" 
     x-data="PaymentData()" x-init="init()">

{{> sub_partials/program/payment_tab/payment}}

{{> sub_partials/program/payment_tab/status}}

{{> sub_partials/program/payment_tab/full_payment}}

{{> sub_partials/program/payment_tab/installment}}

{{> sub_partials/program/payment_tab/registration}}

  <div x-show="open" 
       class="fixed inset-0 bg-black bg-opacity-80 flex items-center justify-center z-50 p-4"
       x-transition:enter="transition ease-out duration-300"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-200"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"
       @click.self="open = false">

    <div class="bg-white rounded-3xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden relative"
         x-transition:enter="transition ease-out duration-300 transform"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-200 transform"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95">
      
      <div class="flex items-center justify-between p-6 border-b border-slate-200 bg-gradient-to-r from-slate-50 to-slate-100">
        <h3 class="text-xl font-bold text-slate-900">Payment Proof</h3>
        <button @click="open = false" 
                class="p-2 hover:bg-slate-200 rounded-full transition-colors duration-200 text-slate-600 hover:text-slate-900">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="p-6 max-h-[calc(90vh-120px)] overflow-auto">
        <img :src="imageSrc" alt="Payment Proof" class="rounded-2xl w-full h-auto object-contain shadow-lg border border-slate-200">
      </div>
    </div>
  </div>
</div>



<script>
  function PaymentData() {
  return {
    tab: localStorage.getItem('tabPayment'),
    data: localStorage.getItem('dataPayment') ? JSON.parse(localStorage.getItem('dataPayment')) : [],
    imageSrc: '',
    tabStatus: localStorage.getItem('statusPayment') || 'all',
    open: false,

    async init() {
      const urlMap = {
        payment: '/kelass/payment/{{kelas.id}}',
        installment: '/kelass/paymentInstallment/{{kelas.id}}',
        register: '/kelass/register/{{kelas.id}}'
      }

      await this.toggleFetchMateri(urlMap[this.tab], this.tab);
    },

    async toggleFetchMateri(url, jenis) {
      this.tab = jenis;
      if(this.tabStatus === null){
        this.tabStatus = 'all';
      }
      localStorage.setItem('tabPayment', jenis);
      try{
      const res = await fetch(url);
      this.data = await res.json();
  
      localStorage.setItem('dataPayment', JSON.stringify(this.data));
      } catch (error) {
        console.error('❌ Error:', error);
      }

    },

    async toggleTabStatus(status) {
      this.tabStatus = status;
      localStorage.setItem('statusPayment', status);
    },
        formatTanggal(value) {
      const options = { year: 'numeric', month: 'long', day: 'numeric' };
      return new Date(value).toLocaleDateString('id-ID', options);
    },
  }
}
</script>