  <div x-show="data && data.length > 0" class='overflow-x-auto bg-white shadow-lg rounded-xl'>
    <table class='min-w-full divide-y divide-gray-200'>
      <thead class='bg-gray-100'>
        <tr>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >No</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Activity</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Details</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Obstacle</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Documentation</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Additional Documentation</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Program</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >User</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Status</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Confirm</th>
          <th
            class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
          >Action</th>
        </tr>
      </thead>
      <tbody class='divide-y divide-gray-200'>
        <template x-for="(logbook, index) in filteredData" :key="logbook.id">
          <tr
            class='hover:bg-gray-50 transition'
          >
            <td class='px-6 py-4 text-sm text-gray-800' x-text="pageNumber * size + index + 1"></td>
            <td class='px-6 py-4 text-sm text-gray-800' x-text="logbook.kegiatan"></td>
            <td
              class='px-6 py-4 text-sm text-gray-800' x-text="logbook.rincian_kegiatan"
            ></td>
            <td class='px-6 py-4 text-sm text-gray-800' x-text="logbook.kendala"></td>
            <td class='px-6 py-4 text-sm text-gray-800'>
              <img
                :src='logbook.dokumentasi'
                alt='Dokumentasi'
                class='w-16 h-16 object-cover rounded border'
              />
            </td>
            <td
              class='px-6 py-4 text-sm text-gray-800' x-text="logbook.dokumentasi_lain"
            ></td>
            <td
              class='px-6 py-4 text-sm text-gray-800' x-text="logbook.session.weeks.course.name"
            ></td>
            <td class='px-6 py-4 text-sm text-gray-800' x-text="logbook.user.username"></td>
            <td class='px-6 py-4 text-sm text-gray-800'>
              <template x-if="logbook.proses === 'acc'">
                <span
                  class='px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800'
                >Approved</span>
                </template>
              <template x-if="logbook.proses === 'rejected'">
                <span
                  class='px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800'
                >Rejected</span>
                </template>
                <template x-if="logbook.proses === 'proces'">
                <span
                  class='px-3 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800'
                >Pending</span>
                </template>
            </td>
            <td class='px-6 py-4 text-sm text-gray-800'>
              <div class='flex items-center justify-center gap-2'>
                <!-- ACC Button -->
                <form
                  :action="`/logbook/${logbook.id}/acc?_method=PATCH`"
                  method='post'
                  class='inline'
                >
                  <button
                    type='button'  onclick="confirmAction(this, 'Are you sure approve this logbook?')"
                    class='p-2 rounded-full bg-green-500 text-white hover:bg-green-600 transition'
                  >
                    <!-- Check Icon -->
                    <svg
                      xmlns='http://www.w3.org/2000/svg'
                      class='w-5 h-5'
                      fill='none'
                      viewBox='0 0 24 24'
                      stroke='currentColor'
                    >
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='2'
                        d='M5 13l4 4L19 7'
                      />
                    </svg>
                  </button>
                </form>

                <!-- Reject Button -->
                <form
                  :action="`/logbook/${logbook.id}/rejected?_method=PATCH`"
                  method='post'
                  class='inline'
                >
                  <button
                    type='button'  onclick="confirmAction(this, 'Are you sure reject this logbook?')"
                    class='p-2 rounded-full bg-red-500 text-white hover:bg-red-600 transition'
                  >
                    <!-- X Icon -->
                    <svg
                      xmlns='http://www.w3.org/2000/svg'
                      class='w-5 h-5'
                      fill='none'
                      viewBox='0 0 24 24'
                      stroke='currentColor'
                    >
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='2'
                        d='M6 18L18 6M6 6l12 12'
                      />
                    </svg>
                  </button>
                </form>
              </div>
            </td>
            <td class='px-6 py-4 text-sm text-gray-800'>
              <div class='flex items-center justify-center gap-2'>
                <!-- Detail Button -->
                <button
                  @click="openModal(`${logbook.id}`)"
                  class='p-2 rounded-full bg-indigo-50 text-indigo-600 hover:bg-indigo-100 hover:text-indigo-800 transition'
                  title='View Detail'
                >
                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke-width='1.5'
                    stroke='currentColor'
                    class='w-5 h-5'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M12 6.75c-4.5 0-8.25 2.25-10.5 6 
                 2.25 3.75 6 6 10.5 6s8.25-2.25 
                 10.5-6c-2.25-3.75-6-6-10.5-6z'
                    />
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M12 15a3 3 0 100-6 3 3 0 000 6z'
                    />
                  </svg>
                </button>

                <!-- Edit Button -->
                <a
                  :href="`/logbook/formEdit/${logbook.id}`"
                  class='p-2 rounded-full bg-blue-50 text-blue-600 hover:bg-blue-100 hover:text-blue-800 transition'
                  title='Edit'
                >
                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke-width='2'
                    stroke='currentColor'
                    class='w-5 h-5'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M16.862 4.487l1.687-1.688a1.875 1.875 
               0 112.652 2.652L10.582 16.07a4.5 
               4.5 0 01-1.897 1.13l-2.685.805.805-2.685
               a4.5 4.5 0 011.13-1.897l10.927-10.936z'
                    />
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M19.5 7.125L16.875 4.5'
                    />
                  </svg>
                </a>

                <!-- Delete Button -->
                <form
                  :action="`/logbook/${logbook.session.id}/${logbook.id}?_method=DELETE`"
                  method='post'
                  class='inline'
                >
                  <button
                    type='button'
                    onclick='confirmDelete(this)'
                    class='p-2 rounded-full bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-800 transition'
                    title='Delete'
                  >
                    <svg
                      xmlns='http://www.w3.org/2000/svg'
                      fill='none'
                      viewBox='0 0 24 24'
                      stroke-width='1.5'
                      stroke='currentColor'
                      class='w-5 h-5'
                    >
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        d='M6 18L18 6M6 6l12 12'
                      />
                    </svg>
                  </button>
                </form>
              </div>
            </td>

          </tr>
          </template>
      </tbody>
    </table>
  </div>