<!-- PPT Section -->
<div x-show="tabMateri === 'ppt'">

  <template x-if="dataMateri && dataMateri.length > 0">
    <ul class="space-y-2 mb-6">
      <template x-for="materi in dataMateri" :key="materi.id">
        <li class="flex justify-between items-center bg-gray-50 p-4 rounded-xl shadow-lg hover:bg-gray-100 transition">
          <div class="flex flex-col gap-1">
            <span class="text-gray-800 font-medium" x-text="materi.judul"></span>
            <a :href="materi.file" x-text="materi.file" class="text-blue-600 underline text-sm truncate max-w-xs" target="_blank"></a>
          </div>
          <div class="flex space-x-2">

            <!-- Edit Button -->
            <a :href="`/learning-material/formEdit/ppt/${materi.id}`"
               class="p-2 rounded-lg bg-amber-50 text-amber-600 hover:bg-amber-100 hover:text-amber-800 transition"
               title="Edit">
              <svg xmlns="http://www.w3.org/2000/svg"
                   fill="none" viewBox="0 0 24 24"
                   stroke-width="1.5" stroke="currentColor"
                   class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zM19.5 13.5V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V8.25A2.25 2.25 0 016.75 6h6" />
              </svg>
            </a>

            <!-- Delete -->
            <form :action="`/learning-material/${materi.id}/{{pertemuan.id}}?_method=DELETE`" method="post" class="inline">
              <button type="button" onclick="confirmDelete(this)"
                      class="p-2 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-800 transition"
                      title="Delete">
                <svg xmlns="http://www.w3.org/2000/svg" 
                     fill="none" viewBox="0 0 24 24" 
                     stroke-width="1.5" stroke="currentColor" 
                     class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" 
                        d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </form>

          </div>
        </li>
      </template>
    </ul>
  </template>

  <template x-if="!dataMateri || dataMateri.length === 0">
    <div class="flex flex-col items-center justify-center text-center py-16 bg-gray-50 border-2 border-dashed rounded-xl mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400 mb-4" fill="none"
           viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
      </svg>
      <p class="text-gray-600 font-medium">No PPT available</p>
      <p class="text-gray-500 text-sm mt-1">Click <span class="font-semibold">Create PPT</span> to add new material.</p>
    </div>
  </template>

  <a href="/learning-material/formCreate/ppt/{{pertemuan.id}}" 
     class="flex flex-col items-center justify-center text-center py-12 bg-gray-50 border-2 border-dashed rounded-xl hover:bg-gray-100 transition">
    <svg xmlns="http://www.w3.org/2000/svg" 
         class="h-12 w-12 text-gray-400 mb-3" 
         fill="none" viewBox="0 0 24 24" 
         stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
    </svg>
    <span class="text-gray-600 font-medium">Create PPT</span>
  </a>
</div>