<!-- Installment Content (Super Admin) -->
<div x-show="tab === 'installment'" x-transition class="w-full">
  <div x-show="filteredData && filteredData.length > 0" class="grid grid-cols-1 md:grid-cols-2 gap-3 w-full">
    <template x-for="item in filteredData" :key="item.id">
      {{> components/ui/super_admin/card/payment_detail/index}}
    </template>
  </div>

  <!-- Empty State -->
  <div x-show="!filteredData || filteredData.length === 0" class="text-center py-16 w-full">
    <div class="mx-auto w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mb-4">
      <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
      </svg>
    </div>
    <h3 class="text-base font-semibold text-slate-700 mb-1">No Installment History</h3>
    <p class="text-sm text-slate-500">No installment transactions match the selected filter or search query.</p>
  </div>
</div>