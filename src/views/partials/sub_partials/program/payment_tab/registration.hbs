  <!-- Pendaftaran Content -->
  <div x-show="tab === 'register'" x-transition>
    <div class="p-8 ">
        <div x-show="data && data.length > 0" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          <template x-for="item in data" :key="item.id">
            <div 
              x-show="tabStatus === 'all' 
                || (tabStatus === 'acc' && item.process === 'acc') 
                || (tabStatus === 'proces' && item.process === 'proces') 
                || (tabStatus === 'rejected' && item.process === 'rejected')"
              x-transition
              :class="{
      'rounded-2xl border-2 p-6 relative transition-all duration-300 hover:shadow-xl hover:scale-[1.02] group': true,
      'bg-gradient-to-br from-emerald-50 to-green-50 border-emerald-200 hover:border-emerald-300': item.process === 'acc',
      'bg-gradient-to-br from-amber-50 to-orange-50 border-amber-200 hover:border-amber-300': item.process === 'proces',
      'bg-gradient-to-br from-red-50 to-rose-50 border-red-200 hover:border-red-300': item.process === 'rejected'
    }">

              <div class="absolute -top-3 -right-3">
                <template x-if="item.process === 'acc'">
                  <span class="px-4 py-2 text-xs font-bold rounded-full bg-gradient-to-r from-emerald-500 to-green-600 text-white shadow-lg flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    ACCEPTED
                  </span>
                  </template>
                <template x-if="item.process === 'proces'">
                  <span class="px-4 py-2 text-xs font-bold rounded-full bg-gradient-to-r from-amber-500 to-orange-500 text-white shadow-lg flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    PROCESSING
                  </span>
                  </template>
                <template x-if="item.process === 'rejected'">
                  <span class="px-4 py-2 text-xs font-bold rounded-full bg-gradient-to-r from-red-500 to-rose-600 text-white shadow-lg flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    REJECTED
                  </span>
                </template>
              </div>

              <div class="space-y-3 mb-6">
                <div class="bg-emerald-600 text-white px-3 py-1 rounded-lg inline-flex items-center gap-2 text-xs font-semibold mb-2">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                  </svg>
                  REGISTRATION
                </div>
                
                <div class="space-y-2">
                  
                  <div class="flex items-center gap-2 text-slate-600">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    <span class="text-sm font-medium" x-text="item.user.username"></span>
                  </div>
                  
                  <div class="flex items-center gap-2 text-slate-600">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    <span class="text-sm font-medium" x-text="item.user.email"></span>
                  </div>
                  
                  <div class="flex items-center gap-2 text-slate-600">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3a2 2 0 012-2h4a2 2 0 012 2v4m-6 0V6a2 2 0 012-2h4a2 2 0 012 2v1M8 7h8m-9 4a2 2 0 002 2h6a2 2 0 002-2v-4H7v4z"></path>
                    </svg>
                    <span class="text-sm font-medium" x-text="formatDate(item.createdAt)"></span>
                  </div>
                </div>
              </div>

              <div class="flex flex-col gap-3">
                <button 
                  @click="open = true; imageSrc = item.file" 
                  class="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-600 to-green-700 text-white font-semibold text-sm hover:from-emerald-700 hover:to-green-800 transition-all duration-200 transform hover:scale-105 shadow-lg flex items-center justify-center gap-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  View Registration Proof
                </button>

                <template x-if="item.process === 'proces'">
                  <div class="flex gap-2">
                    <form :action="`/registration/acc/${item.id}?_method=PATCH`" method="post" class="flex-1">
                      <button type="button"
                      onclick="confirmAction(this, 'Are you sure you want to accept this registration?')" 
                        class="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-green-600 text-white font-semibold text-sm hover:from-emerald-600 hover:to-green-700 transition-all duration-200 transform hover:scale-105 shadow-lg flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        Accept
                      </button>
                    </form>
                    <form :action="`/registration/rejected/${item.id}?_method=PATCH`" method="post" class="flex-1">
                      <button type="button"
                      onclick="confirmAction(this, 'Are you sure you want to reject this registration?')"
                        class="w-full py-3 rounded-xl bg-gradient-to-r from-red-500 to-rose-600 text-white font-semibold text-sm hover:from-red-600 hover:to-rose-700 transition-all duration-200 transform hover:scale-105 shadow-lg flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        Reject
                      </button>
                    </form>
                  </div>
                  </template>
                  <template x-if="item.process === 'acc'">
                  <form :action="`/registration/rejected/${item.id}?_method=PATCH`" method="post">
                    <button type="button" onclick="confirmAction(this, 'Are you sure you want to reject this accepted registration?')"
                      class="w-full py-3 rounded-xl bg-gradient-to-r from-red-500 to-rose-600 text-white font-semibold text-sm hover:from-red-600 hover:to-rose-700 transition-all duration-200 transform hover:scale-105 shadow-lg flex items-center justify-center gap-2">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                      </svg>
                      Reject
                    </button>
                  </form>
                  </template>
                <template x-if="item.process === 'rejected'">
                  <form :action="`/registration/acc/${item.id}?_method=PATCH`" method="post">
                    <button type="button" onclick="confirmAction(this, 'Are you sure you want to accept this rejected registration?')"
                      class="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-green-600 text-white font-semibold text-sm hover:from-emerald-600 hover:to-green-700 transition-all duration-200 transform hover:scale-105 shadow-lg flex items-center justify-center gap-2">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      Accept
                    </button>
                  </form>
                  </template>
              </div>
            </div>
            </template>
        </div>
        <div x-show="!data || data.length === 0" class="text-center py-16">
          <div class="mx-auto w-24 h-24 bg-emerald-100 rounded-full flex items-center justify-center mb-6">
            <svg class="w-12 h-12 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-slate-700 mb-2">No Registration History</h3>
          <p class="text-slate-500">Registration transactions will appear here once they are submitted.</p>
        </div>
    </div>
  </div>