<!-- Status Filter Tabs & Search Bar (Super Admin) -->
<div class="flex flex-col gap-4 w-full">
  <!-- Status Tabs -->
  <nav role="tablist" class="flex border-b border-[#D9D9D9] w-full overflow-x-auto">
    <button
      type="button"
      role="tab"
      @click="toggleTabStatus('all')"
      :aria-selected="tabStatus === 'all'"
      :class="tabStatus === 'all'
        ? 'border-[#003060] text-[#003060]'
        : 'border-transparent text-[#737373] hover:border-[#D9D9D9] hover:text-[#003060]'"
      class="-mb-px inline-flex h-10 shrink-0 items-center justify-center border-b-2 px-7 py-2.5 font-montserrat text-sm font-semibold leading-5 transition-colors focus-visible:outline-none"
    >
      All
    </button>

    <button
      type="button"
      role="tab"
      @click="toggleTabStatus('proces')"
      :aria-selected="tabStatus === 'proces' || tabStatus === 'process'"
      :class="(tabStatus === 'proces' || tabStatus === 'process')
        ? 'border-[#003060] text-[#003060]'
        : 'border-transparent text-[#737373] hover:border-[#D9D9D9] hover:text-[#003060]'"
      class="-mb-px inline-flex h-10 shrink-0 items-center justify-center border-b-2 px-7 py-2.5 font-montserrat text-sm font-semibold leading-5 transition-colors focus-visible:outline-none"
    >
      Process
    </button>

    <button
      type="button"
      role="tab"
      @click="toggleTabStatus('acc')"
      :aria-selected="tabStatus === 'acc'"
      :class="tabStatus === 'acc'
        ? 'border-[#003060] text-[#003060]'
        : 'border-transparent text-[#737373] hover:border-[#D9D9D9] hover:text-[#003060]'"
      class="-mb-px inline-flex h-10 shrink-0 items-center justify-center border-b-2 px-7 py-2.5 font-montserrat text-sm font-semibold leading-5 transition-colors focus-visible:outline-none"
    >
      Accepted
    </button>

    <button
      type="button"
      role="tab"
      @click="toggleTabStatus('rejected')"
      :aria-selected="tabStatus === 'rejected'"
      :class="tabStatus === 'rejected'
        ? 'border-[#003060] text-[#003060]'
        : 'border-transparent text-[#737373] hover:border-[#D9D9D9] hover:text-[#003060]'"
      class="-mb-px inline-flex h-10 shrink-0 items-center justify-center border-b-2 px-7 py-2.5 font-montserrat text-sm font-semibold leading-5 transition-colors focus-visible:outline-none"
    >
      Rejected
    </button>
  </nav>

  <!-- Search Input Bar -->
  <div class="w-full">
    {{> components/ui/super_admin/input/search/index
      model="searchQuery"
      placeholder="Search..."
    }}
  </div>
</div>