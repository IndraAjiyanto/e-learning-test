<!-- Main Tabs: Full Payment & Installment (Super Admin) -->
<div class="w-full mb-3">
  {{#if course.checkPaid}}
    {{> components/ui/super_admin/tabs/toggle/index
      tab1Label="Full Payment"
      tab1Value="payment"
      tab1Url=(concat '/program/payment/' course.id)
      tab2Label="Installment"
      tab2Value="installment"
      tab2Url=(concat '/program/paymentInstallment/' course.id)
      state="tab"
    }}
  {{else}}
    <button
      type="button"
      @click="toggleFetchMateri('/program/register/{{course.id}}', 'register');"
      class="w-full flex items-center justify-center h-11 px-4 bg-[#003060] text-white border border-[#003060] rounded-lg font-inter font-semibold text-base leading-6 shadow-[0px_1px_2px_rgba(0,0,0,0.05)] transition-colors"
    >
      Registrations
    </button>
  {{/if}}
</div>