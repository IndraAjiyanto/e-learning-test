<!-- MOBILE TEAM MEMBERS GRID (< 640px) -->
<div class="block sm:hidden grid grid-cols-2 gap-3.5">
  {{#each team}}
    <div class="bg-[#F0F8FF] border border-[#E0F1F9] rounded-[20px] p-4 flex flex-col items-center text-center shadow-xs">
      <div class="w-16 h-16 rounded-full overflow-hidden border-2 border-[#9D9D9D] shrink-0 flex items-center justify-center bg-white shadow-xs">
        <img src="{{#if profile}}{{profile}}{{else}}/public/image/about/orang.png{{/if}}" alt="{{name}}" class="w-[75%] translate-y-[8%]" />
      </div>
      <h4 class="font-montserrat font-semibold text-[12px] leading-none text-[#111111] text-center mt-3 mb-1.5 line-clamp-2 min-h-[28px] flex items-center justify-center tracking-normal">
        {{name}}
      </h4>
      <p class="font-montserrat font-medium text-[10px] leading-none text-[#555555] text-center mb-3 line-clamp-1 tracking-normal">
        {{#if position}}{{getByLang position ../lang}}{{else}}Specialist Mentor{{/if}}
      </p>
      <div class="flex items-center justify-center gap-3 mt-auto">
        <a href="{{#if linkedin}}{{linkedin}}{{else}}#{{/if}}" target="_blank" class="hover:opacity-80 transition-opacity">
          <img src="/public/image/about/team/linkedin.svg" alt="LinkedIn" class="w-3 h-3 object-contain" />
        </a>
        <a href="{{#if instagram}}{{instagram}}{{else}}#{{/if}}" target="_blank" class="hover:opacity-80 transition-opacity">
          <img src="/public/image/about/team/instagram.svg" alt="Instagram" class="w-3 h-3 object-contain" />
        </a>
      </div>
    </div>
  {{else}}
    <!-- Card 1 -->
    <div class="bg-[#F0F8FF] border border-[#E0F1F9] rounded-[20px] p-4 flex flex-col items-center text-center shadow-xs">
      <div class="w-16 h-16 rounded-full overflow-hidden border-2 border-[#9D9D9D] shrink-0 flex items-center justify-center bg-white shadow-xs">
