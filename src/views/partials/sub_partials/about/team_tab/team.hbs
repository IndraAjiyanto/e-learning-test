<!-- DESKTOP TEAM MEMBERS GRID (>= 640px) -->
<div class='hidden sm:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 justify-items-center md:justify-items-start'>
  {{#each team}}
    {{> components/about/card_team 
        isDesktop=true
        profile=(default profile "/public/image/about/orang.png")
        name=name
        position=(getByLang position ../lang)
        description=(getByLang description ../lang)
        linkedin=(default linkedin "#")
        instagram=(default instagram "#")
    }}
  {{else}}
    <!-- Card 1 -->
    {{> components/about/card_team 
        isDesktop=true
        profile="/public/image/about/orang.png"
        name="Rizal Rahadian Ramadhan, S.E"
        position="Chief Finance Officer"
        description="Oversee the company's financial planning, budgeting, and investment strategies. Maintain financial stability and support data-driven decision making."
        linkedin="#"
        instagram="#"
    }}
  {{/each}}
</div>