<!-- DESKTOP TEAM MEMBERS GRID (>= 640px) -->
<div class='hidden sm:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 justify-items-center md:justify-items-start'>
  {{#each team}}
    <div class='w-full max-w-[344px] min-h-[505px] lg:h-[505px] bg-[#E0F1F9]/50 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)] p-4 lg:px-2.5 lg:py-8 flex flex-col items-center text-center justify-between'>
      <div class='w-[100px] h-[100px] lg:w-[120px] lg:h-[120px] rounded-full overflow-hidden border-[4px] lg:border-[5px] border-[#9D9D9D] mb-3 lg:mb-7 flex-shrink-0 flex items-center justify-center'>
        <img
          src="{{#if profile}}{{profile}}{{else}}/public/image/about/orang.png{{/if}}"
          alt="{{name}}"
          class='w-[75%] translate-y-[8%]'
        />
      </div>
      <h3 class='text-base lg:text-xl font-semibold text-[#000000] mb-1.5 lg:mb-2.5 font-montserrat leading-snug'>
        {{name}}
      </h3>
      <p class='text-xs lg:text-xl font-normal text-[#000000] mb-3 lg:mb-7 font-montserrat'>
        {{getByLang position ../lang}}
      </p>
      <p class='text-[#000000CC] text-xs lg:text-base leading-relaxed lg:leading-7 mb-4 lg:mb-7 font-sans font-normal line-clamp-4 flex-1'>
        {{getByLang description ../lang}}
      </p>
      <div class='flex justify-center space-x-3 mt-auto'>
        <a
          href='{{#if linkedin}}{{linkedin}}{{else}}#{{/if}}' target="_blank"
          class='w-10 h-10 lg:w-[60px] lg:h-[60px] bg-white rounded-full flex items-center justify-center shadow-xs'
        >
          <img src="/public/image/about/team/linkedin.svg" alt="LinkedIn" class="w-4 h-4 lg:w-6 lg:h-6 object-contain" />
        </a>
        <a
          href='{{#if instagram}}{{instagram}}{{else}}#{{/if}}' target="_blank"
          class='w-10 h-10 lg:w-[60px] lg:h-[60px] bg-white rounded-full flex items-center justify-center shadow-xs'
        >
          <img src="/public/image/about/team/instagram.svg" alt="Instagram" class="w-4 h-4 lg:w-6 lg:h-6 object-contain" />
        </a>
      </div>
    </div>
  {{else}}
    <!-- Card 1 -->
    <div class='w-full max-w-[344px] min-h-[505px] lg:h-[505px] bg-[#E0F1F9]/50 backdrop-blur-[6.6px] rounded-[12px] shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)] p-4 lg:px-2.5 lg:py-8 flex flex-col items-center text-center justify-between'>
      <div class='w-[100px] h-[100px] lg:w-[120px] lg:h-[120px] rounded-full overflow-hidden border-[4px] lg:border-[5px] border-[#9D9D9D] mb-3 lg:mb-7 flex-shrink-0 flex items-center justify-center'>
        <img src="/public/image/about/orang.png" alt="Rizal" class='w-[75%] translate-y-[8%]' />
      </div>
      <h3 class='text-base lg:text-xl font-semibold text-[#000000] mb-1.5 lg:mb-2.5 font-montserrat leading-snug'>
        Rizal Rahadian Ramadhan, S.E
      </h3>
      <p class='text-xs lg:text-xl font-normal text-[#000000] mb-3 lg:mb-7 font-montserrat'>
        Chief Finance Officer
      </p>
      <p class='text-[#000000CC] text-xs lg:text-base leading-relaxed lg:leading-7 mb-4 lg:mb-7 font-sans font-normal line-clamp-4 flex-1'>
        Oversee the company's financial planning, budgeting, and investment strategies. Maintain financial stability and support data-driven decision making.
      </p>
      <div class='flex justify-center space-x-3 mt-auto'>
        <a href='#' target="_blank" class='w-10 h-10 lg:w-[60px] lg:h-[60px] bg-white rounded-full flex items-center justify-center shadow-xs'>
          <img src="/public/image/about/team/linkedin.svg" alt="LinkedIn" class="w-4 h-4 lg:w-6 lg:h-6 object-contain" />
        </a>
        <a href='#' target="_blank" class='w-10 h-10 lg:w-[60px] lg:h-[60px] bg-white rounded-full flex items-center justify-center shadow-xs'>
          <img src="/public/image/about/team/instagram.svg" alt="Instagram" class="w-4 h-4 lg:w-6 lg:h-6 object-contain" />
        </a>
      </div>
    </div>
  {{/each}}
</div>