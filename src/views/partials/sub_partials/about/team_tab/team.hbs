<!-- MOBILE TEAM MEMBERS GRID (< 640px) -->
<div class="block sm:hidden grid grid-cols-2 gap-3.5">
  {{#each team}}
    {{> components/about/card_team 
        profile=(default profile "/public/image/about/orang.png")
        name=name
        position=(default (getByLang position ../lang) "Specialist Mentor")
        linkedin=(default linkedin "#")
        instagram=(default instagram "#")
    }}
  {{else}}
    <!-- Card 1 -->
    {{> components/about/card_team 
        profile="/public/image/about/orang.png"
        name="Rizal Rahadian Ramadhan, S.E"
        position="Specialist Mentor"
        linkedin="#"
        instagram="#"
    }}

    <!-- Card 2 -->
    {{> components/about/card_team 
        profile="/public/image/about/orang.png"
        name="Adipura Arya Kangsadewa, S.Bns"
