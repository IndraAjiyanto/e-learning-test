<!-- MOBILE PARTNER SECTION (< 640px / Figma Frame "Trusted by Leading Partners") -->
<section class="block sm:hidden py-12 px-5 relative overflow-hidden bg-[#FAFAFA] w-full font-montserrat">
  <!-- Header Section -->
  <div class="text-center mb-6 relative z-10 flex flex-col items-center">
    <!-- Pill badge -->
    <div class="inline-flex items-center justify-center bg-[#6EB6E5]/20 border border-[#003060] text-[#003060] rounded-[50px] px-5 py-2 text-[14px] font-medium font-montserrat mx-auto mb-4 shadow-sm">
      {{{t 'test.home.partnerSection.ourPartners'}}}
    </div>
    
    <!-- Title -->
    <h2 class="font-montserrat font-bold text-2xl text-[#0B1F3B] leading-tight text-center max-w-[350px] mx-auto mb-3">
      {{{t "test.home.partnerSection.title"}}}
    </h2>
    
    <!-- Divider -->
    <div class="w-[68px] h-[5px] bg-[#0B1F3B] mx-auto mb-4 rounded-full"></div>

    <!-- Subtitle -->
    <p class="font-sans font-normal text-[14px] leading-[22px] text-[#2D2D2D] text-center max-w-[340px] mx-auto">
      {{t "test.home.partnerSection.description"}}
    </p>
  </div>

  <div class="w-full relative z-10" x-data="{ activeTab: '{{default categoryPartner.[0].category "Institutions"}}' }">
    <!-- Category Filter Pills -->
    <div class="flex flex-wrap items-center justify-center gap-2 max-w-[340px] mx-auto mb-6">
      {{#each categoryPartner}}
      <button
        @click="activeTab = '{{this.category}}'"
        :class="activeTab === '{{this.category}}' ? 'bg-[#6EB6E5] text-white' : 'bg-[#003060] text-white'"
        class="rounded-[50px] px-4 py-2 text-[13px] font-montserrat font-medium transition-all shadow-sm"
      >
        {{this.category}}
      </button>
      {{/each}}
    </div>

    <!-- Partner Logos 2-Column Grid -->
    <div class="grid grid-cols-2 gap-3 w-full">
      {{#each partners}}
      <div
        x-show="activeTab === '{{this.categoryPartner.category}}'"
        class="w-full h-[90px] bg-white border border-[#D9D9D9] rounded-[16px] flex items-center justify-center p-4 shadow-[0px_4px_12px_0px_#00000010]"
      >
        <img src="{{this.image}}" alt="Partner Logo" class="max-h-[50px] max-w-[80%] object-contain" />
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- DESKTOP PARTNER SECTION (>= 640px / Figma Baseline W1728) -->
<section class='hidden sm:block py-12 sm:py-20 px-5 sm:px-6 lg:px-20 relative overflow-hidden'>
  <!-- Header Section -->
  <div class='text-center mb-8 sm:mb-12 relative z-10'>
    <!-- Pill badge -->
    <div class="flex items-center justify-center bg-[#6EB6E5]/20 border border-[#003060] text-[#003060] rounded-[50px] w-[305px] h-[49px] text-[20px] font-[500] font-montserrat transition-all mx-auto">
      {{{t 'test.home.partnerSection.ourPartners'}}}
    </div>
    
    <!-- Title with Background (Efek Stabilo Highlight Animation) -->
    <div 
      class="relative w-fit h-[52px] mx-auto rounded-[6px] my-6 flex items-center justify-center overflow-hidden"
      x-data="{
        isHighlighted: false,
        init() {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                this.isHighlighted = true;
              }
            });
          }, { threshold: 0.4, rootMargin: '0px 0px -50px 0px' });
          observer.observe(this.$el);
        }
      }"
    >
      <!-- Base Black Text (Initial State before Stabilo) -->
      <h2 class="font-montserrat font-semibold text-[#000000] text-4xl leading-none tracking-normal text-center whitespace-nowrap px-1">
        {{{t "test.home.partnerSection.title"}}}
      </h2>

      <!-- Blue Stabilo Highlight Layer (Sweeps from Left 0% to 100% Width) -->
      <div 
        class="absolute inset-y-0 left-0 bg-[#003060] rounded-[6px] transition-all duration-[800ms] ease-out overflow-hidden flex items-center justify-center whitespace-nowrap shadow-md pointer-events-none"
        :class="isHighlighted ? 'w-full' : 'w-0'"
      >
        <!-- White Text Revealed as Blue Stabilo Sweeps Over -->
        <h2 class="font-montserrat font-semibold text-white text-4xl leading-none tracking-normal text-center whitespace-nowrap px-1 min-w-max">
          {{{t "test.home.partnerSection.title"}}}
        </h2>
      </div>
    </div>
    
    <!-- Divider -->
    <div class="w-[68px] h-[5px] bg-[#0B1F3B] mx-auto mb-8 rounded-full"></div>
    
    <!-- Subtitle -->
    <p class='font-sans font-normal text-xl text-[#000000]/80 leading-[45px] tracking-normal max-w-[1052px] mx-auto text-center'>
      {{t "test.home.partnerSection.description"}}
    </p>
  </div>

  <div class="max-w-[1440px] mx-auto" x-data="{ activeTab: '{{categoryPartner.[0].category}}' }">
    <!-- Category Tabs -->
    <div class="flex justify-center flex-wrap gap-4 mb-14">
      {{#each categoryPartner}}
      <!-- Category Button -->
      <button
        @click="activeTab = '{{this.category}}'"
        :class="activeTab === '{{this.category}}' ? 'bg-[#6EB6E5]' : 'bg-[#003060]'"
        class="w-[428px] h-[62px] rounded-[24px] text-white font-montserrat text-[17px] font-medium transition-all duration-300 shadow-[0px_0px_8px_0px_rgba(0,0,0,0.5)] backdrop-blur-[6.6px] flex items-center justify-center opacity-100 text-center"
      >
        {{this.category}}
      </button>
      {{/each}}
    </div>

    <!-- Logos Grid -->
    <div class="flex flex-wrap justify-center gap-6 justify-items-center">
      {{#each partners}}
        <div x-show="activeTab === '{{this.categoryPartner.category}}'" class="w-[200px] h-[120px] bg-white border border-gray-200 rounded-[12px] flex items-center justify-center p-6 shadow-[0px_0px_8px_0px_rgba(0,0,0,0.08)] hover:shadow-md transition-shadow">
          <img src="{{this.image}}" alt="Partner Logo" class="max-h-full max-w-full object-contain" />
        </div>
      {{/each}}
    </div>
  </div>
</section>
