<section class='bg-transparant py-20 px-6 lg:px-20'>
  <div class='flex flex-col items-center text-center justify-center mb-12'>
    <h1 class='text-l border bg-[#6EB6E533] border-gray-400 w-36 rounded-full -mb-12 text-gray-900 font-montserrat'>{{{t
        'test.home.partnerSection.ourPartners'
      }}}</h1>
  </div>
  <div class='text-center mb-16'>
    <h2 class="text-4xl md:text-5xl font-bold leading-tight font-montserrat text-gray-900">{{{t "test.home.partnerSection.tittle"}}}</h2>
    <div
        class='border border-b-2 border-slate-900 w-24 mx-auto mt-8 my-2 rounded'
      ></div>
    <p class='text-lg text-gray-600 py-6 max-w-2xl mx-auto'>
      {{t "test.home.partnerSection.description"}}
    </p>
  </div>

  <div class='overflow-hidden whitespace-nowrap bg-white rounded-2xl shadow-lg py-8 relative'>
    {{#if collaborations}}
    <div class=' inline-flex animate-scroll-seamless'>
      {{#each collaborations}}
      <img
        src="{{gambar}}"
        alt='Partner Logo'
        class='h-24 w-auto inline-block mx-8 grayscale hover:grayscale-0 transition-all duration-300 flex-shrink-0'
      />
      {{/each}}
    </div>
    {{else}}
    <div class='flex items-center justify-center gap-8 px-8'>
      <div class='text-center text-slate-400 py-4'>
        <i class='fas fa-building text-4xl mb-2'></i>
        <p class='text-sm'>Partner Logo 1</p>
      </div>
      <div class='text-center text-slate-400 py-4'>
        <i class='fas fa-industry text-4xl mb-2'></i>
        <p class='text-sm'>Partner Logo 2</p>
      </div>
      <div class='text-center text-slate-400 py-4'>
        <i class='fas fa-store text-4xl mb-2'></i>
        <p class='text-sm'>Partner Logo 3</p>
      </div>
      <div class='text-center text-slate-400 py-4'>
        <i class='fas fa-landmark text-4xl mb-2'></i>
        <p class='text-sm'>Partner Logo 4</p>
      </div>
      <div class='text-center text-slate-400 py-4'>
        <i class='fas fa-university text-4xl mb-2'></i>
        <p class='text-sm'>Partner Logo 5</p>
      </div>
    </div>
    {{/if}}
  </div>
</section>

<script>
  function partnerFilter({ partners }) {
    return {
      partners,
      // 'all' by default → semua logo tampil saat halaman dibuka / di-refresh
      selected: 'all',

      get categories() {
        const seen = {};
        this.partners.forEach((p) => {
          if (p.categoryPartner) {
            seen[p.categoryPartner.id] = p.categoryPartner.category;
          }
        });
        return Object.keys(seen).map((id) => ({ id, category: seen[id] }));
      },

      get filtered() {
        if (this.selected === 'all') return this.partners;
        return this.partners.filter(
          (p) =>
            p.categoryPartner &&
            String(p.categoryPartner.id) === String(this.selected),
        );
      },
    };
  }
</script>
