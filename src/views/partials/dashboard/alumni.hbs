<section
  class='bg-transparant py-20 px-6 lg:px-20'
  x-data='{
        active: 0,
        perView: 3,
        total: {{#if alumni}}{{alumni.length}}{{else}}0{{/if}},
        get maxIndex() {
            return Math.max(0, this.total - this.perView);
        },
        get pages() {
            return this.maxIndex + 1;
        },
        setPerView() {
            const w = window.innerWidth;
            if (w < 768) this.perView = 1;
            else if (w < 1024) this.perView = 2;
            else this.perView = 3;
            if (this.active > this.maxIndex) this.active = this.maxIndex;
        },
        init() {
            this.setPerView();
            window.addEventListener("resize", () => this.setPerView());
            setInterval(() => {
                this.active = this.active >= this.maxIndex ? 0 : this.active + 1;
            }, 5000);
        }
    }'
>
<div class='flex items-center text-center justify-center'>
    <h1 class='text-l border bg-[#6EB6E533] border-gray-400 w-64 mb-8 py-2 rounded-full text-gray-900 font-montserrat'>{{{t
        'test.home.alumniSection.badge'
      }}}</h1>
  </div>
  <!-- Title -->
  <div class='text-center mb-12'>
    <h2 class='text-4xl md:text-5xl mb-4 font-semibold leading-tight font-montserrat text-gray-900'>
      {{{t "test.home.alumniSection.tittle"}}}
    </h2>
     <div
        class='border border-t-4 border-slate-900 w-24 mx-auto mb-2 rounded'
      ></div>
    <p class='text-lg text-gray-600 py-6 max-w-5xl mx-auto'>
      {{t "test.home.alumniSection.description"}}
    </p>
  </div>

  <!-- Carousel -->
  <div class='relative w-full max-w-6xl mx-auto'>

    {{#if alumni}}
    <!-- Slide Viewport -->
    <div class='overflow-hidden'>
      <!-- Slide Track -->
      <div
        class='flex transition-transform duration-500 ease-in-out'
        :style='`transform: translateX(-${active * (100 / perView)}%);`'
      >
        {{#each alumni}}
          <div
            class='flex-shrink-0 px-3'
            :style='`width: ${100 / perView}%;`'
          >
            <span class='text-6xl text-white/50 font-bold'>❝</span>
            <p class='text-white text-xl leading-relaxed mb-8 italic'>
              {{getByLang pesan ../lang}}
            </p>
            <div class='flex items-center gap-6'>
              <img
                src="{{profile}}"
                alt='Alumni'
                class='w-16 h-16 rounded-full border-4 border-white/20'
              />
              <div>
                <p class='font-bold text-white text-lg'>{{getByLang name ../lang}}</p>
                <p class='text-slate-300'>{{getByLang posisi_sekarang ../lang}}</p>
                <p class='text-slate-400 text-sm'>{{getByLang course.name ../lang}}</p>
              </div>
            </div>
          </div>
        {{/each}}
      </div>
    </div>

    <!-- Prev/Next + Dot Indicators -->
    <div class='flex justify-center items-center mt-10 gap-3'>
      <button
        class='w-9 h-9 flex items-center justify-center rounded-full bg-white text-blue-600 border border-gray-200 shadow-sm hover:bg-blue-50 transition'
        @click='active = active <= 0 ? maxIndex : active - 1'
      >
        <i class='fas fa-chevron-left text-sm'></i>
      </button>

      <template x-for='i in pages' :key='i'>
        <button
          class='h-2.5 rounded-full transition-all duration-300'
          :class="active === (i - 1) ? 'w-6 bg-blue-700' : 'w-2.5 bg-gray-300 hover:bg-gray-400'"
          @click='active = i - 1'
        ></button>
      </template>

      <button
        class='w-9 h-9 flex items-center justify-center rounded-full bg-white text-blue-600 border border-gray-200 shadow-sm hover:bg-blue-50 transition'
        @click='active = active >= maxIndex ? 0 : active + 1'
      >
        <i class='fas fa-chevron-right text-sm'></i>
      </button>
    </div>

    <!-- See all link -->
    <div class='text-center mt-8'>
      <p class='text-gray-500 mb-2'>
        {{t "test.home.alumniSection.moreStories"}}
      </p>
      <a
        href='/dashboard/alumni'
        class='inline-flex items-center gap-2 text-blue-700 font-semibold hover:underline'
      >
        {{t "test.home.alumniSection.seeAll"}}
        <i class='fas fa-arrow-right text-sm'></i>
      </a>
    </div>
    {{else}}
    <!-- Fallback - No Alumni Data -->
    <div class='text-center py-12'>
      <div
        class='bg-sky-50/70 border border-sky-100 rounded-2xl shadow-sm p-8 max-w-md mx-auto text-left'
      >
        <svg class='w-10 h-10 text-blue-600 mb-4' fill='currentColor' viewBox='0 0 24 24'>
          <path d='M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z'></path>
        </svg>
        <p class='text-gray-600 leading-relaxed mb-8'>
          This bootcamp transformed my career completely! The mentors were amazing, and the curriculum was very comprehensive.
        </p>
        <div class='flex items-center gap-4'>
          <img
            src='https://ui-avatars.com/api/?name=John+Doe&background=64748b&color=fff&size=128'
            alt='Alumni'
            class='w-14 h-14 rounded-full border-4 border-white shadow'
          />
          <div>
            <p class='font-bold text-gray-900'>John Doe</p>
            <p class='text-sm text-gray-500'>Senior Software Engineer</p>
            <p class='text-xs text-gray-400'>Full Stack Development Bootcamp</p>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
  </div>
</section>
