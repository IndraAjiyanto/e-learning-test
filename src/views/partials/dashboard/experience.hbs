<div
  data-animate="fade-up" data-delay="100"
  class='bg-gradient-to-br from-primary via-secondary to-gray-900 rounded-t-[8vw] py-20 px-6 lg:px-20'
>
  <!-- Title -->
  <div class='text-center max-w-5xl mx-auto mb-10'>


    <h2
      class='text-4xl md:text-5xl font-bold text-white leading-tight font-montserrat'
    >
  {{t 'test.home.experienceSection.title'}}
    </h2>

    <p
      class='py-6 text-lg text-white leading-relaxed max-w-2xl mx-auto '
    >
      {{t 'test.home.experienceSection.description'}}
    </p>
  </div>

  <!-- Grid Card -->
  <div
    data-stagger-container
    class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 text-center max-w-6xl mx-auto'
  >

  {{#if our_experience.length}}
    {{#each our_experience}}
       <div
      data-stagger-item
      class='group p-6 bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl shadow-xl hover:border-b-slate-800 border-b-8 hover:bg-white/10 transition-all duration-300 transform hover:-translate-y-2'
    >
      <div class='flex justify-center mb-6'>
        <div
          class='w-16 h-16 flex items-center justify-center rounded-full bg-white/5 backdrop-blur-md text-white text-2xl group-hover:from-slate-600 group-hover:to-slate-800 group-hover:text-white transition-all duration-300'
        >
          <i class='fas {{icon}}'></i>
        </div>
      </div>
      <h3 class='text-xl font-bold text-white mb-4'>
        {{getByLang title ../lang}}
      </h3>
      <p class='text-white text-lg leading-relaxed'>
{{getByLang description ../lang}}
      </p>
    </div>
    {{/each}}
{{else}}

    <!-- Card 1 -->
    <div
      data-stagger-item
      class='group p-6 bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl shadow-xl hover:border-b-slate-800 border-b-8 hover:bg-white/10 transition-all duration-300 transform hover:-translate-y-2'
    >
      <div class='flex justify-center mb-6'>
        <div
          class='w-16 h-16 flex items-center justify-center rounded-full bg-white/5 backdrop-blur-md text-white text-2xl group-hover:from-slate-600 group-hover:to-slate-800 group-hover:text-white transition-all duration-300'
        >
          <i class='fas fa-book-open'></i>
        </div>
      </div>
      <h3 class='text-xl font-bold text-white mb-4'>
        Free Class to Discover Potential
      </h3>
      <p class='text-white text-lg leading-relaxed'>
Join our free class to explore your interests and discover your true potential in the IT field. Get hands-on experience with the basics of technology.
      </p>
    </div>

    <!-- Card 2 -->
    <div
      data-stagger-item
      class='group p-6 bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl shadow-xl hover:border-b-slate-800 border-b-8 hover:bg-white/10 transition-all duration-300 transform hover:-translate-y-2'
    >
      <div class='flex justify-center mb-6'>
        <div
          class='w-16 h-16 flex items-center justify-center rounded-full bg-white/5 backdrop-blur-md text-white text-2xl group-hover:from-slate-600 group-hover:to-slate-800 group-hover:text-white transition-all duration-300'
        >
          <i class='fas fa-chalkboard-teacher'></i>
        </div>
      </div>
      <h3 class='text-xl font-bold text-white mb-4'>
        Expert Mentor Guidance
      </h3>
      <p class='text-white text-lg leading-relaxed'>
        Learn directly from experienced industry professionals who have worked in leading tech companies. Gain real-world insights, hands-on knowledge, and personalized.
      </p>
    </div>

    <!-- Card 3 -->
    <div
      data-stagger-item
      class='group p-6 bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl shadow-xl hover:border-b-slate-800 border-b-8 hover:bg-white/10 transition-all duration-300 transform hover:-translate-y-2'
    >
      <div class='flex justify-center mb-6'>
        <div
          class='w-16 h-16 flex items-center justify-center rounded-full bg-white/5 backdrop-blur-md text-white text-2xl group-hover:from-slate-600 group-hover:to-slate-800 group-hover:text-white transition-all duration-300'
        >
          <i class='fas fa-briefcase'></i>
        </div>
      </div>
      <h3 class='text-xl font-bold text-white mb-4'>
        Career Preparation Support
      </h3>
      <p class='text-white text-lg leading-relaxed'>
Get full career support — from crafting your CV and portfolio to preparing for interviews — with guidance from our dedicated talent support team.
      </p>
    </div>
    {{/if}}
  </div>
</div>