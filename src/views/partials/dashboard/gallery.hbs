<!-- MOBILE GALLERY SECTION (< 640px) -->
<section id="gallery-mobile" class="block sm:hidden w-full py-12 px-5 bg-[#FAFAFA] font-montserrat">
  <div class="w-full flex flex-col items-center">
    
    <!-- Header Section -->
    <div class="text-center mb-6 relative z-10 flex flex-col items-center">
      <!-- Badge -->
      <div class="inline-flex items-center justify-center bg-[#6EB6E5]/20 border border-[#003060] text-[#003060] rounded-[50px] px-5 py-2 text-[14px] font-medium font-montserrat mx-auto mb-4 shadow-sm">
        {{t 'test.home.gallery.gallery'}}
      </div>
      
      <!-- Title -->
      <h2 class="font-montserrat font-bold text-2xl text-[#0B1F3B] leading-tight text-center mb-3">
        {{{t 'test.home.gallery.title'}}}
      </h2>
      
      <!-- Divider -->
      <div class="w-[68px] h-[5px] bg-[#0B1F3B] mx-auto mb-4 rounded-full"></div>

      <!-- Subtitle -->
      <p class="font-sans font-normal text-sm leading-[22px] text-[#2D2D2D] text-center max-w-[340px] mx-auto">
        {{t 'test.home.gallery.description'}}
      </p>
    </div>

    <!-- Mobile Gallery Cards Grid -->
    <div class="flex flex-col gap-4 w-full">
      {{#if gallery.length}}
        {{#each gallery}}
        <div class="overflow-hidden rounded-[16px] shadow-[0px_4px_12px_0px_#00000010] bg-gray-200 w-full h-[220px]">
          <img src="{{this.filePath}}" alt="Gallery Image" class="w-full h-full object-cover" />
        </div>
        {{/each}}
      {{else}}
        <!-- Fallback Dummy Images for Preview -->
        <div class="overflow-hidden rounded-[16px] shadow-[0px_4px_12px_0px_#00000010] bg-gray-200 w-full h-[220px]">
          <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=600&h=800&fit=crop" alt="Gallery 1" class="w-full h-full object-cover" />
        </div>
        <div class="overflow-hidden rounded-[16px] shadow-[0px_4px_12px_0px_#00000010] bg-gray-200 w-full h-[220px]">
          <img src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=600&h=800&fit=crop" alt="Gallery 2" class="w-full h-full object-cover" />
        </div>
        <div class="overflow-hidden rounded-[16px] shadow-[0px_4px_12px_0px_#00000010] bg-gray-200 w-full h-[220px]">
          <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?q=80&w=600&h=400&fit=crop" alt="Gallery 3" class="w-full h-full object-cover" />
        </div>
        <div class="overflow-hidden rounded-[16px] shadow-[0px_4px_12px_0px_#00000010] bg-gray-200 w-full h-[220px]">
          <img src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?q=80&w=600&h=400&fit=crop" alt="Gallery 4" class="w-full h-full object-cover" />
        </div>
      {{/if}}
    </div>

    <!-- Tautan Bawah Mobile -->
    <div class="mt-8 text-center">
      <a href="/dashboard/gallery" class="inline-flex items-center gap-2 text-[#0B1F3B] font-bold text-[14px] font-sans hover:underline">
        {{t 'test.home.gallery.chooseGallery'}}
        <i class="fas fa-arrow-right text-xs"></i>
      </a>
    </div>

  </div>
</section>

<!-- DESKTOP GALLERY SECTION (>= 640px / Figma Baseline W1728) -->
<section id="gallery" class="hidden sm:block w-full py-12 sm:py-20 bg-[#FAFAFA] font-montserrat">
  
  <div class="max-w-[1537px] mx-auto px-5 sm:px-8 lg:px-16 flex flex-col items-center">
    
    <!-- 1. Header (Badge & Sub-judul) -->
    <div class="flex items-center justify-center bg-[#6EB6E5]/20 border border-[#003060] text-[#003060] rounded-[50px] w-[305px] h-[49px] text-[20px] font-[500] font-montserrat transition-all mx-auto">
      {{t 'test.home.gallery.gallery'}}
    </div>
    
    <h2 class='text-3xl md:text-4xl lg:text-[42px] my-8 font-[600] text-black font-montserrat tracking-tight text-center'>
      {{{t 'test.home.gallery.title'}}}
    </h2>

    <div class="w-[68px] h-[5px] bg-[#0B1F3B] mx-auto mb-8 rounded-full"></div>

    <!-- Sub-judul -->
    <p class="font-sans font-normal text-[20px] leading-[45px] text-[#000000CC] mb-14 text-center max-w-auto mx-auto">
      {{t 'test.home.gallery.description'}}
    </p>

    <!-- 2. Gallery Grid (3 Kolom) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 justify-items-center w-full max-w-[1200px]">
      
      <!-- KOLOM 1 -->
      <div class="flex flex-col gap-6 lg:gap-8 w-full">
         {{#if gallery.[0]}}
        <div class="overflow-hidden rounded-[16px] shadow-sm bg-gray-200 transform-gpu w-full h-[225px] md:h-[240px]">
          <img src="{{gallery.[0].filePath}}" 
               alt="Gallery 1" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
        </div>
        {{/if}}
        <div class="overflow-hidden rounded-[16px] shadow-sm bg-gray-200 transform-gpu w-full h-[433px] md:h-[460px]">
          <img src="{{#if gallery.[1]}}{{gallery.[1].filePath}}{{else}}https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=600&h=800&fit=crop{{/if}}"
               alt="Gallery 2" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
        </div>
      </div>
      
      <!-- KOLOM 2 -->
      <div class="flex flex-col gap-6 lg:gap-8 w-full">
        <div class="overflow-hidden rounded-[16px] shadow-sm bg-gray-200 transform-gpu w-full h-[433px] md:h-[460px]">
          <img src="{{#if gallery.[2]}}{{gallery.[2].filePath}}{{else}}https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=600&h=800&fit=crop{{/if}}"
               alt="Gallery 3" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
        </div>
        <div class="overflow-hidden rounded-[16px] shadow-sm bg-gray-200 transform-gpu w-full h-[225px] md:h-[240px]">
          <img src="{{#if gallery.[3]}}{{gallery.[3].filePath}}{{else}}https://images.unsplash.com/photo-1552664730-d307ca884978?q=80&w=600&h=400&fit=crop{{/if}}"
               alt="Gallery 4" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
        </div>
      </div>
      
      <!-- KOLOM 3 -->
      <div class="flex flex-col gap-6 lg:gap-8 w-full">
        <div class="overflow-hidden rounded-[16px] shadow-sm bg-gray-200 transform-gpu w-full h-[225px] md:h-[240px]">
          <img src="{{#if gallery.[4]}}{{gallery.[4].filePath}}{{else}}https://images.unsplash.com/photo-1542744173-8e7e53415bb0?q=80&w=600&h=400&fit=crop{{/if}}" 
               alt="Gallery 5" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
        </div>
        <div class="overflow-hidden rounded-[16px] shadow-sm bg-gray-200 transform-gpu w-full h-[433px] md:h-[460px]">
          <img src="{{#if gallery.[5]}}{{gallery.[5].filePath}}{{else}}https://images.unsplash.com/photo-1515169067868-5387ec356754?q=80&w=600&h=800&fit=crop{{/if}}" 
               alt="Gallery 6" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
        </div>
      </div>
      
    </div>

    <!-- 3. Teks Bawah (Tautan) -->
    <div class="mt-16">
      <a href="/dashboard/gallery" class="inline-flex items-center gap-2 text-[#0B1F3B] text-[16px] font-semibold transition-all hover:text-[#7AA3C4] border-b-[1.5px] border-[#0B1F3B] hover:border-[#7AA3C4] pb-1">
        {{t 'test.home.gallery.chooseGallery'}} <i class="fa-solid fa-arrow-right-long text-[15px]"></i>
      </a>
    </div>

  </div>
</section>