<div
  class="w-full px-4 pt-24 lg:pt-[130px] pb-16 bg-[linear-gradient(180deg,_#FAFAFA_-33%,_#CEE5F6_33%,_#FAFAFA_93.51%)] min-h-screen relative flex items-center justify-center font-montserrat"
>
  <div class="relative w-full max-w-[1554px] min-h-[580px] xl:min-h-[665px] rounded-[24px] overflow-hidden flex flex-col items-center justify-center px-6 py-20 shadow-2xl">
    
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img src="{{#if about.[0].image}}{{about.[0].image}}{{else}}/public/image/dashboard/bgHeroSection.png{{/if}}" alt="Hero Background" class="w-full h-full object-cover opacity-50">
      <!-- Dark Overlays to ensure text readability -->
      <div class="absolute inset-0 bg-[#000000]/70"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 w-full max-w-[1312px] text-center text-white flex flex-col items-center font-montserrat">
      
      <!-- Heading -->
      <h1 class="text-3xl md:text-4xl lg:text-5xl xl:text-[50px] font-[700] xl:leading-none">
        {{#if about.[0].title}}
          {{{getByLang about.[0].title lang}}}
        {{else}}
          Empowering Future Di<span 
            class="inline-grid grid-cols-1 grid-rows-1 text-left align-top"
            x-data="{
              words: ['gital Tech Talents'],
              wordIndex: 0,
              charIndex: 0,
              currentText: '',
              speed: 200,
              init() {
                this.type();
              },
              type() {
                const target = this.words[this.wordIndex];
                if (this.charIndex < target.length) {
                  this.charIndex = Math.min(this.charIndex + 2, target.length);
                  this.currentText = target.substring(0, this.charIndex);
                  setTimeout(() => this.type(), this.speed);
                } else {
                  setTimeout(() => {
                    this.currentText = '';
                    this.charIndex = 0;
                    setTimeout(() => this.type(), 300);
                  }, 2000);
                }
              }
            }"
          >
            <!-- Reserved space so title center position never shifts -->
            <span class="invisible col-start-1 row-start-1 select-none pointer-events-none" aria-hidden="true">gital Tech Talents|</span>
            <!-- Typewriter text -->
            <span class="col-start-1 row-start-1 text-white"><span x-text="currentText">gital Tech Talents</span><span class="animate-pulse text-white font-light">|</span></span>
          </span>
        {{/if}}
      </h1>

      <!-- Subheading -->
      <p class="text-base md:text-xl lg:text-[22px] xl:text-3xl font-[500] leading-[1.6] xl:leading-[50px] my-20 max-w-auto mx-auto text-white">
        {{#if about.[0].text}}{{{nl2br (getByLang about.[0].text lang)}}}{{else}}Be part of the next generation of digital talents. Kesatria Academy helps you learn technology in an interactive, relevant and engaging way.{{/if}}
      </p>

      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row items-center gap-4 xl:gap-[15px]">
        <button
          onclick="document.getElementById('courses-section').scrollIntoView({ behavior: 'smooth', block: 'start' })"
          class="flex items-center justify-center gap-[15px] w-full sm:w-[370px] h-[85px] p-[10px] bg-[#003060] hover:bg-[#001f3f] text-white rounded-[12px] border border-[#003060] font-semibold text-lg xl:text-xl transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-1 opacity-100"
        >
          <img src="/public/image/dashboard/hugeicons_start-up-02.svg" alt="Explore" class="w-6 h-6 xl:w-8 xl:h-8">
          <span>{{t 'test.home.heroSection.buttonExplorePrograms'}}</span>
        </button>

        <a 
          href="/dashboard/about" @click="scrollToSection('about-section')"
          class="flex items-center justify-center gap-[15px] w-full sm:w-[370px] h-[85px] p-[10px] bg-transparent hover:bg-white/10 text-white rounded-[12px] font-semibold text-lg xl:text-xl transition-all duration-300 border border-white shadow-lg hover:shadow-xl hover:-translate-y-1 opacity-100"
        >
          <img src="/public/image/dashboard/hugeicons_customer-support.svg" alt="Consultation" class="w-6 h-6 xl:w-8 xl:h-8">
          <span>{{t 'test.home.heroSection.buttonConsultation'}}</span>
        </a>
      </div>

    </div>
  </div>
</div>