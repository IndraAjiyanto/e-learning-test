<!-- MOBILE HERO SECTION (< 640px) -->
<div class="block sm:hidden w-full px-5 pt-28 pb-14 bg-[linear-gradient(180deg,_#FAFAFA_0%,_#CEE5F6_50%,_#FAFAFA_100%)] relative font-montserrat overflow-hidden">
  <!-- Light Classroom Background Image with Light Overlay -->
  <div class="absolute inset-0 z-0">
    <img src="{{#if about.[0].image}}{{about.[0].image}}{{else}}/public/image/dashboard/bgHeroSection.png{{/if}}" alt="Hero Background" class="w-full h-full object-cover opacity-15">
  </div>

  <div class="relative z-10 w-full text-center flex flex-col items-center space-y-6">
    <!-- Title Section -->
    <div class="space-y-3 w-full flex flex-col items-center">
      <h1 class="font-montserrat font-bold text-[32px] text-[#003060] leading-none text-center">
        Empowering Future
      </h1>
      <div class="w-full max-w-[350px] h-[38px] bg-[#003060] text-white rounded-[30px] px-[16px] py-[8px] flex items-center justify-center text-center shadow-md">
        <span class="font-montserrat font-bold text-[18px] leading-none text-center whitespace-nowrap">Digital Tech Talents</span>
      </div>
    </div>

    <!-- Description Subheading -->
    <p class="font-montserrat font-medium text-[15px] text-[#333333] leading-[24px] text-center max-w-[350px]">
      {{#if about.[0].text}}{{{nl2br (getByLang about.[0].text lang)}}}{{else}}Be part of the next generation of digital talents. Kesatria Academy helps you learn technology in an interactive, relevant and engaging way.{{/if}}
    </p>

    <!-- Mobile Buttons Group -->
    <div class="flex flex-col gap-3 w-full max-w-[350px] mx-auto pt-1">
      <!-- Button 1: Explore Programs -->
      <button
        onclick="document.getElementById('courses-section').scrollIntoView({ behavior: 'smooth', block: 'start' })"
        class="flex items-center justify-center gap-[10px] w-full h-[48px] py-[14px] bg-[#003060] hover:bg-[#001f3f] text-white rounded-[12px] font-montserrat font-semibold text-[16px] leading-none transition-all shadow-md cursor-pointer"
      >
        <img src="/public/image/dashboard/hugeicons_start-up-02.svg" alt="Explore" class="w-5 h-5 brightness-0 invert">
        <span class="font-montserrat font-semibold text-[16px] leading-none">{{t 'test.home.heroSection.buttonExplorePrograms'}}</span>
      </button>

      <!-- Button 2: Free Consultation -->
      <a
        x-data="{ formatWa(nomor) { if (!nomor) return ''; nomor = nomor.replace(/\D/g, ''); if (nomor.startsWith('0')) return '62' + nomor.slice(1); if (nomor.startsWith('8')) return '62' + nomor; if (nomor.startsWith('62')) return nomor; return nomor; } }"
        :href="'https://wa.me/' + formatWa('{{social.[0].number}}')"
        target="_blank" rel="noopener noreferrer"
        class="flex items-center justify-center gap-[10px] w-full h-[48px] py-[14px] border-[1.5px] border-[#003060] text-[#003060] hover:bg-slate-50 rounded-[12px] font-montserrat font-semibold text-[16px] leading-none transition-all shadow-sm cursor-pointer"
      >
        <svg class="w-5 h-5 fill-[#003060]" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M2.54647 0.857602C3.79457 -0.450482 5.84978 -0.218053 6.89482 1.25435L8.18906 3.07486C9.04027 4.27267 8.96438 5.94616 7.95421 7.00452L7.71013 7.26181C7.68245 7.36981 7.67964 7.48323 7.70193 7.59261C7.76654 8.03368 8.11625 8.96772 9.58074 10.5028C11.0452 12.0379 11.9375 12.4055 12.362 12.4747C12.469 12.4974 12.5795 12.494 12.6851 12.465L13.1035 12.026C14.0019 11.0855 15.3802 10.9093 16.4919 11.5461L18.4507 12.6704C20.1296 13.6303 20.5531 16.0346 19.1789 17.4757L17.7216 19.0021C17.2621 19.4832 16.6447 19.8843 15.892 19.9589C14.0357 20.1416 9.71098 19.9081 5.16471 15.1438C0.922 10.6963 0.107711 6.81749 0.00412991 4.90618C-0.0471477 3.93971 0.385636 3.12242 0.937383 2.54514L2.54647 0.857602ZM5.66415 2.22623C5.1442 1.49435 4.17608 1.43597 3.63048 2.00785L2.02037 3.69431C1.68193 4.04889 1.5199 4.44024 1.54041 4.81429C1.62245 6.33318 2.27881 9.83257 6.24974 13.9947C10.4155 18.36 14.2624 18.4908 15.7494 18.3438C16.053 18.3146 16.3545 18.1481 16.6365 17.853L18.0928 16.3254C18.6856 15.7049 18.5553 14.5741 17.7164 14.0941L15.7576 12.9709C15.2162 12.6617 14.5824 12.7633 14.1885 13.1763L13.7219 13.666L13.1784 13.0909C13.7219 13.666 13.7209 13.6671 13.7199 13.6671L13.7188 13.6693L13.7158 13.6725L13.7086 13.679L13.6932 13.6941C13.6499 13.7365 13.6033 13.7748 13.5537 13.8087C13.4717 13.866 13.363 13.9298 13.2266 13.9828C12.9497 14.092 12.5825 14.1503 12.1292 14.0768C11.2401 13.933 10.0617 13.2941 8.4957 11.6531C6.93071 10.012 6.31948 8.77746 6.18206 7.84126C6.11129 7.36343 6.1677 6.97641 6.27231 6.68452C6.32988 6.52027 6.41231 6.36694 6.51639 6.23048L6.54921 6.19264L6.56356 6.17642L6.56972 6.16994L6.57279 6.16669L6.57484 6.16453L6.8702 5.85535C7.30914 5.39373 7.37067 4.62942 6.95738 4.04673L5.66415 2.22623Z"/>
        </svg>
        <span class="font-montserrat font-semibold text-[16px] leading-none">{{t 'test.home.heroSection.buttonConsultation'}}</span>
      </a>
    </div>
  </div>
</div>

<!-- DESKTOP HERO SECTION (>= 640px / Figma Baseline W1728) -->
<div
  class="hidden sm:flex w-full px-4 pt-24 lg:pt-[130px] pb-16 bg-[linear-gradient(180deg,_#FAFAFA_-33%,_#CEE5F6_33%,_#FAFAFA_93.51%)] min-h-screen relative items-center justify-center font-montserrat"
>
  <div class="relative w-full max-w-[1554px] min-h-[580px] xl:min-h-[665px] rounded-[24px] overflow-hidden flex flex-col items-center justify-center px-6 py-20 shadow-2xl">
    
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img src="{{#if about.[0].image}}{{about.[0].image}}{{else}}/public/image/dashboard/bgHeroSection.png{{/if}}" alt="Hero Background" class="w-full h-full object-cover opacity-50">
      <!-- Dark Overlays to ensure text readability -->
      <div class="absolute inset-0 bg-[#000000]/70"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 w-full max-w-[1312px] text-center text-white flex flex-col items-center font-montserrat">
      
      <!-- Heading -->
      <h1 class="text-3xl md:text-4xl lg:text-5xl xl:text-[50px] font-[700] xl:leading-none text-center">
        {{#if about.[0].title}}
          {{{getByLang about.[0].title lang}}}
        {{else}}
          Empowering Future Di<span 
            class="inline-grid grid-cols-1 grid-rows-1 text-left align-top"
            x-data="{
              words: ['gital Tech Talents'],
              wordIndex: 0,
              charIndex: 0,
              currentText: '',
              speed: 200,
              init() {
                this.type();
              },
              type() {
                const target = this.words[this.wordIndex];
                if (this.charIndex < target.length) {
                  this.charIndex = Math.min(this.charIndex + 2, target.length);
                  this.currentText = target.substring(0, this.charIndex);
                  setTimeout(() => this.type(), this.speed);
                } else {
                  setTimeout(() => {
                    this.currentText = '';
                    this.charIndex = 0;
                    setTimeout(() => this.type(), 300);
                  }, 2000);
                }
              }
            }"
          >
            <!-- Reserved space so title center position never shifts -->
            <span class="invisible col-start-1 row-start-1 select-none pointer-events-none" aria-hidden="true">gital Tech Talents|</span>
            <!-- Typewriter text -->
            <span class="col-start-1 row-start-1 text-white"><span x-text="currentText">gital Tech Talents</span><span class="animate-pulse text-white font-light">|</span></span>
          </span>
        {{/if}}
      </h1>

      <!-- Subheading -->
      <p class="text-base md:text-xl lg:text-[22px] xl:text-3xl font-[500] leading-[1.6] xl:leading-[50px] my-10 md:my-16 lg:my-20 max-w-auto mx-auto text-white text-center">
        {{#if about.[0].text}}{{{nl2br (getByLang about.[0].text lang)}}}{{else}}Be part of the next generation of digital talents. Kesatria Academy helps you learn technology in an interactive, relevant and engaging way.{{/if}}
      </p>

      <!-- Buttons -->
      <div class="flex flex-row items-center gap-4 xl:gap-[15px]">
        <button
          onclick="document.getElementById('courses-section').scrollIntoView({ behavior: 'smooth', block: 'start' })"
          class="flex items-center justify-center gap-[15px] w-[370px] h-[85px] p-[10px] bg-[#003060] hover:bg-[#001f3f] text-white rounded-[12px] border border-[#003060] font-semibold text-lg xl:text-xl transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-1 opacity-100 cursor-pointer"
        >
          <img src="/public/image/dashboard/hugeicons_start-up-02.svg" alt="Explore" class="w-6 h-6 xl:w-8 xl:h-8">
          <span>{{t 'test.home.heroSection.buttonExplorePrograms'}}</span>
        </button>

        <a
          x-data="{ formatWa(nomor) { if (!nomor) return ''; nomor = nomor.replace(/\D/g, ''); if (nomor.startsWith('0')) return '62' + nomor.slice(1); if (nomor.startsWith('8')) return '62' + nomor; if (nomor.startsWith('62')) return nomor; return nomor; } }"
          :href="'https://wa.me/' + formatWa('{{social.[0].number}}')"
          target="_blank" rel="noopener noreferrer"
          class="flex items-center justify-center gap-[15px] w-[370px] h-[85px] p-[10px] bg-transparent hover:bg-white/10 text-white rounded-[12px] font-semibold text-lg xl:text-xl transition-all duration-300 border border-white shadow-lg hover:shadow-xl hover:-translate-y-1 opacity-100 cursor-pointer"
        >
          <img src="/public/image/dashboard/hugeicons_customer-support.svg" alt="Consultation" class="w-6 h-6 xl:w-8 xl:h-8">
          <span>{{t 'test.home.heroSection.buttonConsultation'}}</span>
        </a>
      </div>

    </div>
  </div>
</div>