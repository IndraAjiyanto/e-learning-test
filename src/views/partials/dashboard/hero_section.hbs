<div
  data-animate="fade-up" data-delay="100"
  class='hero px-4 py-16 bg-gradient-to-br from-white via-slate-50 to-slate-100 min-h-screen relative overflow-hidden'
>

  <div
    class='hero-content flex-col lg:flex-row-reverse gap-12 lg:gap-20 xl:gap-24 max-w-7xl mx-auto relative z-10'
  >

    <div class='relative flex-1 py-8'>
      <!-- Animated Rings Background - Behind Everything -->
      <div
        class='absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] border-2 border-slate-300 rounded-full opacity-10 animate-ping-slow pointer-events-none'
      ></div>
      <div
        class='absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] border-2 border-slate-400 rounded-full opacity-10 animate-ping-slow animation-delay-1000 pointer-events-none'
      ></div>

      <!-- Orbiting Icons - Positioned Outside Image -->
      <div
        class='absolute top-12 -right-4 w-12 h-12 bg-white rounded-full shadow-lg flex items-center justify-center animate-float animation-delay-1000 z-10'
      >
        <i class='fas fa-code text-slate-700 text-lg'></i>
      </div>
      <div
        class='absolute bottom-60 -left-4 w-12 h-12 bg-white rounded-full shadow-lg flex items-center justify-center animate-float animation-delay-2000 z-10'
      >
        <i class='fas fa-laptop-code text-slate-700 text-lg'></i>
      </div>
      <div
        class='absolute top-10 -left-6 w-10 h-10 bg-white rounded-full shadow-lg flex items-center justify-center animate-bounce-subtle animation-delay-3000 z-10'
      >
        <i class='fas fa-graduation-cap text-slate-700'></i>
      </div>
      <div
        class='absolute bottom-1/3 -right-6 w-10 h-10 bg-white rounded-full shadow-lg flex items-center justify-center animate-bounce-subtle z-10'
      >
        <i class='fas fa-rocket text-slate-700'></i>
      </div>



      <!-- Main Image Container -->
      <div class='relative group mx-auto max-w-lg'>
        <!-- Multi-layer Glow -->
        <div
          class='absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-72 sm:w-80 sm:h-80 md:w-96 md:h-96 bg-gradient-to-r from-slate-400 to-slate-600 rounded-2xl blur-2xl opacity-10 group-hover:opacity-20 transition-opacity duration-500 animate-pulse-slow pointer-events-none'
        ></div>

        <!-- Decorative Bottom Wave -->
        <div class='absolute bottom-0 left-0 right-0 h-24 overflow-hidden pointer-events-none z-20'>
          <!-- Wave SVG -->
          <svg class='absolute bottom-0 w-full h-full' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1440 320' preserveAspectRatio='none'>
            <path fill='rgba(241, 245, 249, 0.9)' fill-opacity='1' d='M0,96L48,112C96,128,192,160,288,165.3C384,171,480,149,576,128C672,107,768,85,864,90.7C960,96,1056,128,1152,138.7C1248,149,1344,139,1392,133.3L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z'></path>
          </svg>
          
          <!-- Gradient Overlay -->
          <div class='absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-slate-50 to-transparent'></div>
        </div>

        <!-- Decorative Shapes -->
        <div class='absolute -bottom-4 left-8 w-16 h-16 bg-slate-200/40 rounded-full blur-xl animate-pulse-slow animation-delay-1000 pointer-events-none z-10'></div>
        <div class='absolute -bottom-6 right-12 w-20 h-20 bg-slate-300/30 rounded-full blur-2xl animate-pulse-slow animation-delay-2000 pointer-events-none z-10'></div>
        
        <!-- Abstract Geometric Shapes -->
        <div class='absolute bottom-8 left-4 w-8 h-8 border-2 border-slate-300/50 rounded-lg rotate-45 animate-float animation-delay-1000 pointer-events-none z-10'></div>
        <div class='absolute bottom-12 right-8 w-6 h-6 bg-slate-400/20 rounded-full animate-bounce-subtle animation-delay-2000 pointer-events-none z-10'></div>

        <img
          src='{{#if tentang.[0].gambar}}{{tentang.[0].gambar}}{{else}}/public/image/orang.png{{/if}}'
          class='relative w-full transform transition-transform duration-300 z-10'
        />

      </div>

    </div>

    <div
      class='text-gray-900 text-center h-fit lg:text-left flex-1 max-w-xl mt-16 lg:mt-0 grid-rows-[auto_1fr_auto_auto] gap-4'
    >
      <!-- Badge Above Title -->
      <div
        class='inline-flex  items-center gap-2 bg-gradient-to-r from-slate-100 to-slate-200 text-slate-700 px-5 py-2 rounded-full mb-6 shadow-md'
      >
        <i class='fas fa-award text-slate-600'></i>
        <span class='font-bold text-sm'>{{t 'test.home.heroSection.platform'}}</span>
      </div>
      <!-- Badge Above Title -->

      <h1 class='text-[3.2rem] font-bold leading-tight font-montserrat mb-4'>
        <div 
          class='bg-gradient-to-r from-slate-700 via-slate-800 to-slate-900 bg-clip-text text-transparent'
          data-texttype
          data-texts='["{{getByLang tentang.[0].judul lang }}"]'
        >
          {{#if tentang.[0].judul}}
            {{getByLang tentang.[0].judul lang}}
          {{else}}
            Kesatria Academy Empowering Future Digital Tech Talent's
          {{/if}}
        </div>
      </h1>

      <p class='py-6 text-lg text-gray-700 leading-relaxed  mb-6'>
        {{#if tentang.[0].text}}
          {{{nl2br (getByLang tentang.[0].text lang)}}}
        {{else}}
        Be part of the next generation of digital talents. Kesatria Academy helps you learn technology in an interactive, relevant and engaging way. 
        {{/if}}
      </p>

      <div
        class='flex flex-col sm:flex-row gap-4 justify-center lg:justify-start'
      >
        <button
          onclick="document.getElementById('courses-section').scrollIntoView({ behavior: 'smooth', block: 'start' })"
          class=' btn text-xl bg-gradient-to-br from-primary via-secondary to-gray-900 text-white hover:from-primary hover:to-secondary px-8 sm:px-16 lg:px-20 border-0 shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 relative overflow-hidden cursor-pointer' 
        >
          <span class='relative z-10 flex items-center gap-2'>
            <i class='fas fa-rocket'></i>
            {{t 'test.home.heroSection.buttonStartLearning'}}
          </span>
        </button>
<a 
    href="#" 
    onclick="localStorage.setItem('indra', 'contact'); console.log('hallo', localStorage.getItem('indra')); return false;"
          class=' btn text-xl bg-white hover:bg-slate-50 text-gray-800 hover:text-slate-900 px-8 sm:px-16 lg:px-20 border-2 border-secondary shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2'
        >
          <span class='flex items-center gap-2'>
            <i class='fas fa-comments'></i>
            {{t 'test.home.heroSection.buttonConsultation'}}
          </span>
        </a>
      </div>

      <!-- Trust Indicators -->
      <div
        class='flex items-center justify-center lg:justify-start gap-6 mt-8 flex-wrap'
      >
        <div class='flex items-center gap-2 text-slate-600'>
          <i class='fas fa-shield-alt text-slate-700'></i>
          <span class='text-sm font-semibold'>{{t 'test.home.heroSection.jobPlacment'}}</span>
        </div>
        <div class='flex items-center gap-2 text-slate-600'>
          <i class='fas fa-headset text-slate-700'></i>
          <span class='text-sm font-semibold'>{{t 'test.home.heroSection.support'}}</span>
        </div>
        <div class='flex items-center gap-2 text-slate-600'>
          <i class='fas fa-graduation-cap text-slate-700'></i>
          <span class='text-sm font-semibold'>{{t 'test.home.heroSection.capstoneProject'}}</span>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  @keyframes blob {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes bounce-subtle {
    0%,
    100% {
      transform: translateY(0px) rotate(12deg);
    }
    50% {
      transform: translateY(-10px) rotate(12deg);
    }
  }

  @keyframes pulse-slow {
    0%,
    100% {
      opacity: 0.2;
    }
    50% {
      opacity: 0.3;
    }
  }

  @keyframes ping-slow {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.2;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.1);
      opacity: 0.1;
    }
    100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.2;
    }
  }

  .animate-blob {
    animation: blob 7s infinite;
  }

  .animate-float {
    animation: float 3s ease-in-out infinite;
  }

  .animate-bounce-subtle {
    animation: bounce-subtle 2s ease-in-out infinite;
  }

  .animate-pulse-slow {
    animation: pulse-slow 3s ease-in-out infinite;
  }

  .animate-ping-slow {
    animation: ping-slow 4s ease-in-out infinite;
  }

  .animation-delay-1000 {
    animation-delay: 1s;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-3000 {
    animation-delay: 3s;
  }

  .animation-delay-4000 {
    animation-delay: 4s;
  }
</style>