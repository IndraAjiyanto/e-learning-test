<!-- MOBILE BENEFIT SECTION (< 640px / Figma Frame 6586:4920) -->
<section class="block sm:hidden w-full py-12 px-5 bg-[#6EB6E5] relative z-0 overflow-hidden font-montserrat">
  <div class="w-full flex flex-col gap-[28px] relative z-10 text-center items-center">
    <!-- Header Section -->
    <div 
      x-data="{ shown: false }" 
      x-init="
        const observer = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) { shown = true; observer.disconnect(); }
        }, { threshold: 0.2, rootMargin: '0px 0px -30px 0px' });
        observer.observe($el);
      "
      :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 -translate-y-8'"
      class="transition-all duration-700 ease-out transform text-center flex flex-col items-center w-full"
    >
      <!-- Badge -->
      <div class="inline-flex items-center justify-center bg-[rgba(110,182,229,0.2)] border border-[#003060] rounded-[50px] px-[16px] py-[8px] font-montserrat font-medium text-[14px] text-[#003060] leading-none mx-auto mb-4">
        {{t 'test.home.imagine.whyChooseUs'}}
      </div>
      
      <!-- Title -->
      <h2 class="font-montserrat font-bold text-[24px] text-[#0B1F3B] leading-tight text-center mb-4">
        {{{t 'test.home.imagine.title'}}}
      </h2>
      
      <!-- Divider -->
      <div class="w-[70px] h-[5px] bg-[#0B1F3B] rounded-[6px] mx-auto mb-4"></div>
      
      <!-- Subtitle -->
      <p class="font-sans font-normal text-[14px] leading-[22px] text-[#2D2D2D] text-center max-w-[340px] mx-auto">
        {{t 'test.home.imagine.description'}}
      </p>
    </div>

    <!-- Card container -->
    <div 
      x-data="{ shown: false }" 
      x-init="
        const observer = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) { shown = true; observer.disconnect(); }
        }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });
        observer.observe($el);
      "
      :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-12'"
      class="flex flex-col gap-[16px] transition-all duration-700 ease-out transform w-full"
    >
      {{#each benefits}}
      <div class="w-full bg-[rgba(224,241,249,0.85)] rounded-[16px] p-[24px] shadow-[0_4px_12px_rgba(0,0,0,0.06)] flex flex-col items-start text-left gap-[12px]">
        <!-- Icon Container -->
        <div class="w-[48px] h-[48px] rounded-full bg-[#003060] flex items-center justify-center shrink-0">
          <i class="{{computeIcon icon}} text-xl text-white" aria-hidden="true"></i>
        </div>
        <!-- Card Title -->
        <h3 class="font-montserrat font-semibold text-[18px] text-[#0B1F3B] leading-tight text-left">
          {{getByLang this.title ../lang}}
        </h3>
        <!-- Card Description -->
        <p class="font-sans font-normal text-[13px] leading-[20px] text-[#2D2D2D] text-left">
          {{getByLang description ../lang}}
        </p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- DESKTOP BENEFIT SECTION (>= 640px / Figma Baseline W1728) -->
<section class="hidden sm:block w-full relative pt-16 pb-24 z-0 overflow-hidden bg-[#FAFAFA]">
  
  <!-- Background Image -->
  <div class="absolute inset-0 -z-10">
    <img src="/public/image/dashboard/bgBenefit.png" alt="Benefit Background" class="w-full h-full object-cover">
    <div class="absolute bottom-0 left-0 w-full h-40 bg-gradient-to-b from-transparent to-white"></div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 max-w-[1324px] relative z-10 text-center">
    
    <!-- Header Section -->
    <div 
      x-data="{ shown: false }" 
      x-init="
        const observer = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) { shown = true; observer.disconnect(); }
        }, { threshold: 0.35, rootMargin: '0px 0px -50px 0px' });
        observer.observe($el);
      "
      :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 -translate-y-16'"
      class="transition-all duration-1000 ease-out transform text-center"
    >
      <!-- Pill badge -->
      <div class="flex items-center justify-center bg-[#6EB6E5]/20 border border-[#003060] text-[#003060] rounded-[50px] w-[305px] h-[49px] text-[20px] font-[500] font-montserrat transition-all mx-auto mb-8">
        {{t 'test.home.imagine.whyChooseUs'}}
      </div>
      
      <!-- Title -->
      <h2 class="text-3xl md:text-4xl lg:text-[42px] mb-4 font-[600] text-black font-montserrat tracking-tight text-center">
        {{{t 'test.home.imagine.title'}}}
      </h2>
      
      <!-- Short horizontal line -->
      <div class="w-[68px] h-[5px] bg-[#0B1F3B] mx-auto mb-8 rounded-full"></div>
      
      <!-- Subtitle -->
      <p class="text-base md:text-xl text-[#000000]/80 leading-[45px] max-w-auto mx-auto font-sans font-[400] text-center">
        {{t 'test.home.imagine.description'}}
      </p>
    </div>

    <!-- Div Pembungkus Seluruh Cards Grid -->
    <div 
      x-data="{ shown: false }" 
      x-init="
        const observer = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) { shown = true; observer.disconnect(); }
        }, { threshold: 0.25, rootMargin: '0px 0px -50px 0px' });
        observer.observe($el);
      "
      :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-24'"
      class="flex flex-wrap justify-center gap-6 md:gap-12 mt-8 transition-all duration-1000 ease-out transform w-full"
    >

      <!-- Cards Loop -->
      {{#each benefits}}
      <div class="w-[360px] h-[360px] bg-[#E0F1F9]/50 backdrop-blur-[6.6px] rounded-[12px] px-4 py-6 shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)] flex flex-col items-center justify-center text-center border border-white/60">
        <div class="w-20 h-20 rounded-full bg-[#6EB6E5] flex items-center justify-center mb-6 shadow-sm shrink-0">
          <i class="{{computeIcon icon}} text-4xl text-[#003060]" aria-hidden="true"></i>
        </div>
        <h3 class="font-montserrat font-[600] text-[18px] leading-tight text-[#0B1F3B] mb-4 min-h-[44px] flex items-center justify-center text-center">
          {{getByLang this.title ../lang}}
        </h3>
        <div class="w-[45px] h-[5px] bg-[#0B1F3B] rounded-[6px] mb-4 opacity-90 shrink-0"></div>
        <p class="font-sans font-[400] text-[15px] leading-[35px] text-black/80 text-center min-h-[140px]">
          {{getByLang description ../lang}}
        </p>
      </div>
      {{/each}}
      
    </div>
    
  </div>
</section>
      
    </div>
    
  </div>
</section>
