<section class='bg-transparant py-20 px-6 lg:px-20 relative'>
  <div class='flex flex-col items-center text-center justify-center mb-6'>
    <h1 class='text-l border bg-[#6EB6E533] border-gray-400 w-52 py-2 rounded-full text-gray-900 font-montserrat'>
      {{{t 'test.home.imagine.whyChooseUs'}}}
    </h1>
  </div>
  <div class='text-center mb-16'>
    <h2 class='text-4xl md:text-5xl font-bold text-gray-900 mb-2'>
      {{{t 'test.home.imagine.tittle'}}}
    </h2>
    <div class='border border-b-4 border-slate-900 w-20 mx-auto mb-10 rounded'></div>
    <p class='text-lg text-gray-600 mx-auto'>
      {{t 'test.home.imagine.description'}}
    </p>
  </div>

  <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6 max-w-5xl mx-auto'>
    {{#each benefits}}
      <div
        data-animate='slide-right'
        data-delay='100'
        class='flex flex-col items-center justify-center gap-5 rounded-2xl p-6 bg-white/70 ring-1 ring-slate-200 shadow-lg lg:col-span-2 {{#if (eq @index 0)}}lg:col-start-1{{/if}} {{#if (eq @index 3)}}lg:col-start-2{{/if}}'
      >
        <div class='text-white text-2xl bg-gradient-to-br from-primary via-secondary to-gray-900 p-4 rounded-xl'>
          <div class='relative flex items-start gap-5'>
            <div class='text-white text-2xl bg-emerald-600 p-4 rounded-xl shadow-md'>
              <i class='{{#if icon}}{{computeIcon icon}}{{else}}fas fa-briefcase{{/if}}'></i>
            </div>
            <div>
              <h3 class='text-2xl font-extrabold text-gray-900 mb-2'>
                {{#if title}}{{getByLang title lang}}{{else}}Benefit{{/if}}
              </h3>
              <p class='text-gray-700 text-lg leading-relaxed'>
                {{#if description}}{{getByLang description lang}}{{else}}Description{{/if}}
              </p>
              <span class='sr-only'>{{t 'test.home.imagine.spanMostWanted'}}</span>
            </div>
          </div>
        </div>
      </div>
    {{/each}}
  </div>

  <div class='grid grid-cols-2 gap-6 max-w-5xl mx-auto mt-8'>
    <img
      data-animate='scale-up'
      data-delay='100'
      src='{{#if benefit_images_1.image}}{{benefit_images_1.image}}{{else}}https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800{{/if}}'
      class='rounded-2xl shadow-2xl col-span-2 h-64 object-cover border-4 border-white hover:scale-105 transition-transform duration-300'
      alt='Teamwork'
    />
    <img
      data-animate='scale-up'
      data-delay='100'
      src='{{#if benefit_images_2.image}}{{benefit_images_2.image}}{{else}}https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=800{{/if}}'
      class='rounded-2xl shadow-2xl h-48 object-cover border-4 border-white hover:scale-105 transition-transform duration-300'
      alt='Laptop Work'
    />
    <img
      data-animate='scale-up'
      data-delay='100'
      src='{{#if benefit_images_3.image}}{{benefit_images_3.image}}{{else}}https://images.unsplash.com/photo-1531482615713-2afd69097998?w=800{{/if}}'
      class='rounded-2xl shadow-2xl h-48 object-cover border-4 border-white hover:scale-105 transition-transform duration-300'
      alt='Meeting'
    />
    <img
      data-animate='scale-up'
      data-delay='100'
      src='{{#if benefit_images_4.image}}{{benefit_images_4.image}}{{else}}https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=800{{/if}}'
      class='rounded-2xl shadow-2xl col-span-2 h-60 object-cover border-4 border-white hover:scale-105 transition-transform duration-300'
      alt='Coding'
    />
  </div>
</section>
