<section
  class='bg-transparant  py-20 px-6 lg:px-20 relative'
>
<div class='flex flex-col items-center text-center justify-center mb-6 '>
      <h1 class='text-l border bg-[#6EB6E533] border-gray-400 w-52 py-2 rounded-full text-gray-900 font-montserrat'>{{{t
          'test.home.imagine.whyChooseUs'
        }}}</h1>
      </div>
  <div class='text-center mb-16'>
    <h2 class='text-4xl md:text-5xl font-bold text-gray-900 mb-2'>
      {{{t 'test.home.imagine.tittle'}}}
    </h2>
     <div
        class='border border-b-4 border-slate-900 w-20 mx-auto mb-10 rounded'
      ></div>
    <p class='text-lg text-gray-600  mx-auto'>
      {{t 'test.home.imagine.description'}}
    </p>
  </div>

 <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6 max-w-5xl mx-auto">
  {{#each benefits}}
    <div
      data-animate="slide-right"
      data-delay="100"
      class="
        flex flex-col items-center justify-center gap-5
        rounded-2xl p-6 bg-white/70 ring-1 ring-slate-200 shadow-lg
        lg:col-span-2
        {{#if (eq @index 3)}}lg:col-start-2{{/if}}
      "
    >
      <div
        class="text-white text-2xl bg-gradient-to-br from-primary via-secondary to-gray-900 p-4 rounded-xl"
      >
        <i class="{{#if icon}}{{computeIcon icon}}{{else}}fas fa-star{{/if}}"></i>
      </div>

      <div>
        <h3 class="text-xl font-bold text-gray-900 mb-2 text-center">
          {{getByLang judul ../lang}}
        </h3>

        <div class="border-b-4 border-slate-900 w-10 mx-auto mt-2 mb-4"></div>

        <p class="text-gray-600 leading-relaxed text-center">
          {{getByLang text ../lang}}
        </p>
      </div>
    </div>
  {{/each}}
</div>
</section>
