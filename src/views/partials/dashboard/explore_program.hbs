<!-- EXPLORE PROGRAM SECTION (CTA) -->
<section id="explore-program" class="w-full mt-16 mb-24 md:mt-20 md:mb-32 font-montserrat relative">
  <div class="w-full relative min-h-[372px] flex items-center justify-center py-12 px-6">
    
    <!-- Figma Layer Blur 10 Banner Rectangle -->
    <div class="absolute inset-0 z-0 bg-[#6EB6E5]"
         style="background-image: url('/public/image/dashboard/bgBenefit.png'); background-size: cover; background-position: center;"></div>

    <!-- Content (Crisp & Clear) -->
    <div class="max-w-4xl mx-auto text-center flex flex-col items-center justify-center relative z-10">
      
      <!-- Title -->
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold tracking-tight leading-tight">
        <span class="text-[#000000] font-semibold">{{t 'test.home.exploreProgram.title'}}</span> 
        <span class="text-white font-semibold">{{t 'test.home.exploreProgram.title2'}}</span>
      </h2>

      <!-- Subtitle -->
      <p class="text-[#0B1F3B]/80 text-sm md:text-base lg:text-[18px] font-sans max-w-full mx-auto my-12 leading-relaxed text-center lg:whitespace-nowrap">
        {{t 'test.home.exploreProgram.description'}}
      </p>

      <!-- Button -->
      <div>
        <a
          href="#courses-section"
          class="inline-flex items-center justify-center gap-[15px] w-full sm:w-[370px] h-[85px] p-[10px] bg-[#003060] hover:bg-[#001f3f] text-white font-semibold text-xl rounded-[12px] border border-[#003060] transition-all duration-300 shadow-md opacity-100"
        >
          <i class="fas fa-rocket text-2xl"></i>
          <span>{{t 'test.home.exploreProgram.exploreButton'}}</span>
        </a>
      </div>

    </div>
  </div>
</section>
