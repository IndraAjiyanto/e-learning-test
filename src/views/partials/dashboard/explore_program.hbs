<section
  class='py-20 px-6 lg:px-20 bg-transparant relative overflow-hidden'
>
  <!-- Background decorative elements -->
 

  <div class='max-w-7xl mx-auto relative z-10'>
    <!-- Header -->
    <div class='text-center mb-16'>
      <h2
        class='text-4xl md:text-5xl font-bold text-gray-900 leading-tight font-montserrat mb-8'
      >
        {{{t 'test.home.exploreProgram.tittle'}}}
      </h2>
      <p class="text-gray-900">
        {{{t 'test.home.exploreProgram.description'}}}
      </p>
    </div>

   
    <div class='text-center'>
      <a
        href='#courses-section'
        class='inline-flex items-center gap-3 bg-secondary text-white font-bold px-10 py-4 rounded-lg hover:bg-secondary transition-all duration-300 transform hover:-translate-y-1 shadow-xl text-lg'
      >
        <i class='fas fa-rocket'></i>
        {{t 'test.home.exploreProgram.exploreButton'}}
      </a>
    </div>
  </div>
</section>
