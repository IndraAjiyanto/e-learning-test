<!-- FAQ SECTION -->
<section id="faq" class="bg-[#FAFAFA] py-20 font-montserrat overflow-hidden"
  x-data="{
    isVisible: false,
    init() {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            this.isVisible = true;
          }
        });
      }, { threshold: 0.2, rootMargin: '0px 0px -100px 0px' });
      observer.observe(this.$el);
    }
  }"
>
  <div class="container mx-auto px-4 lg:px-12 max-w-[1400px] flex flex-col lg:flex-row justify-between items-center gap-12 lg:gap-16">
    
    <!-- LEFT COLUMN: Badge, Title, Description (Slides in from Left to Right) -->
    <div 
      class="w-full lg:w-5/12 flex flex-col items-start text-left transition-all duration-1000 ease-out transform"
      :class="isVisible ? 'translate-x-0 opacity-100' : '-translate-x-32 opacity-0'"
    >
      <!-- Pill Badge -->
      <div class="border border-[#003060] text-[#003060] w-[200px] h-[45px] flex items-center justify-center rounded-[50px] text-lg font-medium font-montserrat transition-all bg-[#6EB6E5]/20 mb-8">
        Questions
      </div>

      <!-- Title -->
      <h2 class="font-montserrat font-semibold text-4xl leading-none tracking-normal text-[#0F0F0F]">
        Frequently Asked
      </h2>
      <h2 class="font-montserrat font-semibold text-4xl leading-none tracking-normal text-[#6EB6E5] mt-1">
        Questions
      </h2>
      
      <!-- Underline -->
      <div class="w-[70px] h-[6px] bg-[#0B1F3B] mt-3 mb-6 rounded-full"></div>
      
      <!-- Subtitle / Description -->
      <p class="text-[#545454] text-base leading-relaxed max-w-xs md:max-w-sm font-sans font-normal">
        Browse common questions and get the information you need quickly and easily.
      </p>
    </div>

    <!-- RIGHT COLUMN: Accordion FAQ Container (Slides Up from Bottom to Top) -->
    <div 
      class="w-full lg:w-7/12 transition-all duration-1000 ease-out delay-300 transform"
      :class="isVisible ? 'translate-y-0 opacity-100' : 'translate-y-32 opacity-0'"
      x-data="{
        activeIndex: 0,
        faqs: [
          {{#if faqs.length}}
            {{#each faqs}}
              { question: `{{getByLang pertanyaan ../lang}}`, answer: `{{getByLang answer ../lang}}` }{{#unless @last}},{{/unless}}
            {{/each}}
          {{else if faq.length}}
            {{#each faq}}
              { question: `{{getByLang question ../lang}}`, answer: `{{getByLang answer ../lang}}` }{{#unless @last}},{{/unless}}
            {{/each}}
          {{else}}
            { question: 'What will I learn in this bootcamp?', answer: 'You will learn hands-on industry skills, tools, and methodologies tailored to help you build real-world projects and accelerate your career.' },
            { question: 'Is the bootcamp online or offline?', answer: 'We offer flexible learning options including interactive live online classes and hybrid offline sessions depending on your program.' },
            { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and guide you step-by-step from the basics to advanced concepts.' },
            { question: 'Will I receive a certificate after completing the bootcamp?', answer: 'Yes! Upon successful completion of the coursework and capstone project, you will receive an official certificate of completion.' },
            { question: 'What if I miss a class?', answer: 'All live sessions are recorded and made available on our learning platform so you can catch up anytime.' },
            { question: 'How can I register?', answer: 'You can register directly through our website by choosing your desired program and completing the enrollment form.' },
            { question: 'Is there career support after graduation?', answer: 'Yes, we provide dedicated career support including resume reviews, portfolio building, mock interviews, and hiring partner connections.' }
          {{/if}}
        ],
        toggle(index) {
          this.activeIndex = this.activeIndex === index ? null : index;
        }
      }"
    >
      
      <!-- Wrapper Daftar FAQ -->
      <div class="border-t border-[#E0E0E0]">
        <template x-for="(faq, index) in faqs" :key="index">
          <div class="border-b border-[#E0E0E0]">
            
            <!-- Tombol Pertanyaan -->
            <button
              @click="toggle(index)"
              class="w-full text-left py-5 px-4 focus:outline-none flex items-center justify-between group transition-colors duration-300 hover:bg-[#003060]"
              :class="activeIndex === index ? 'bg-[#003060]' : 'bg-transparent'"
            >
              <div class="flex items-center gap-4">
                <!-- Bullet -->
                <div class="w-1.5 h-1.5 rounded-full flex-shrink-0 transition-colors duration-300 group-hover:bg-white"
                     :class="activeIndex === index ? 'bg-white' : 'bg-[#0B1F3B]'"></div>
                <!-- Vertical Line -->
                <div class="w-[1px] h-5 flex-shrink-0 transition-colors duration-300 group-hover:bg-white/40"
                     :class="activeIndex === index ? 'bg-white/40' : 'bg-gray-300'"></div>
                
                <h3 class="font-montserrat font-semibold text-xl leading-none tracking-normal transition-colors duration-300 group-hover:text-white" 
                    :class="activeIndex === index ? 'text-white' : 'text-[#0F0F0F]'" 
                    x-text="faq.question"></h3>
              </div>
              
              <!-- Icon Chevron -->
              <div class="flex-shrink-0 ml-4">
                <i class="fas fa-chevron-down transition-transform duration-300 group-hover:text-white"
                   :class="activeIndex === index ? 'text-white rotate-180' : 'text-[#8F8F8F]'">
                </i>
              </div>
            </button>
            
            <!-- Jawaban -->
            <div
              x-show="activeIndex === index"
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 max-h-0"
              x-transition:enter-end="opacity-100 max-h-[500px]"
              x-transition:leave="transition ease-in duration-200"
              x-transition:leave-start="opacity-100 max-h-[500px]"
              x-transition:leave-end="opacity-0 max-h-0"
              class="overflow-hidden bg-[#FAFAFA]"
            >
              <div class="pl-12 pr-4 py-6 text-[#545454] text-sm leading-relaxed font-sans">
                <p x-html="faq.answer"></p>
              </div>
            </div>
            
          </div>
        </template>
      </div>
      
    </div>
  </div>
</section>
