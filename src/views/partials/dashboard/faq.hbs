<section class='py-20 bg-transparant'>
  <div class='flex container mx-auto max-w-6xl'>

    <div class='w-full mx-auto space-y-8 flex columns-2' >
      <div class=" flex flex-col">
         <div class='flex flex-col text-center mb-4 justify-center'>
      <h1 class='text-l border flex  items-center justify-center  h-8 bg-[#6EB6E533] border-gray-400 w-52 rounded-full text-gray-900 font-montserrat'>{{{t
          'test.home.faq.question'
        }}}</h1>
      </div>
          <div class="flex flex-col justify-start w-52 mb-2">
          <h2 class="text-2xl md:text-4xl font-semibold leading-tight font-montserrat text-gray-900">{{{t "test.home.faq.tittle"}}}</h2>
      </div> 
      <div class="rounded h-1 bg-gray-900 w-12 mb-4"></div>
      <div class=" max-w-xs">
          <p class="text-sm md:text-5xlfont-bold leading-tight font-montserrat text-gray-900">{{t "test.home.faq.description"}}</p>
      </div>    
      </div>
          
      </div>
    
    
      <div
      class="flex flex-col w-full justify-center"
        x-data="{
          activeIndex: null,
          currentPage: 1,
          itemsPerPage: 5,
          faqs: [
            {{#if faq}}
              {{#each faq}}
                { question: `{{getByLang question ../lang}}` , answer: `{{getByLang answer ../lang}}` },
              {{/each}}
            {{else}}
              { question: 'How long is the bootcamp program?', answer: 'Our bootcamp program typically runs for 4 months with intensive weekend classes. You\'ll learn through hands-on projects and mentorship from industry experts.' },
              { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.' },
              { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.' },
              { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.' },
              { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.' },
              { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.' },
              { question: 'Do I need prior programming experience?', answer: 'No prior experience is required! We welcome beginners and will guide you from the basics to advanced concepts step by step.' },
              { question: 'What is the payment method?', answer: 'We offer flexible payment options including full payment, installments, and early bird discounts. Contact us for more details.' }
            {{/if}}
          ],
          get paginatedFaqs() {
            const start = (this.currentPage - 1) * this.itemsPerPage;
            const end = start + this.itemsPerPage;
            return this.faqs.slice(start, end);
          },
          get totalPages() {
            return Math.ceil(this.faqs.length / this.itemsPerPage);
          },
          toggle(index) {
            this.activeIndex = this.activeIndex === index ? null : index;
          }
        }"
      >
        <!-- FAQ Items -->
        <template x-for="(faq, index) in paginatedFaqs" :key="index">
          <div
            class='group bg-transparant justify-between border-t border-b border-gray-200 hover:shadow-2xl hover:border-slate-300 transition-all duration-300 overflow-hidden'
          >
            <button
              @click="toggle((currentPage - 1) * itemsPerPage + index)"
              class='w-full text-left p-2 justify-between flex items-center focus:outline-none'
            >
            
              <div class='flex items-center gap-4'>
                <svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 10 10"
  class="w-3 h-3 text-gray-900"
  fill="currentColor"
>
  <circle cx="5" cy="5" r="4" />
</svg>
<div class="w-px h-4 bg-gray-300"></div>
                <h3
                  class='text-xl font-semibold text-gray-900 group-hover:text-slate-700 transition-colors duration-300'
                  x-text="faq.question"
                ></h3>               
              </div>

               <div
                  class='w-8 h-8 flex items-center justify-center rounded-full  transition-colors duration-300'
                >
                  <i
                    class='fas fa-chevron-down text-slate-600 transition-transform duration-300'
                    :class="activeIndex === (currentPage - 1) * itemsPerPage + index ? 'rotate-180' : ''"
                  ></i>
                </div>
            </button>
            <div
              x-show="activeIndex === (currentPage - 1) * itemsPerPage + index"
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 max-h-0"
              x-transition:enter-end="opacity-100 max-h-screen"
              x-transition:leave="transition ease-in duration-200"
              x-transition:leave-start="opacity-100 max-h-screen"
              x-transition:leave-end="opacity-0 max-h-0"
              class='overflow-hidden'
            >
              <div class='px-8 pb-8'>
                <p class='text-gray-600 leading-relaxed text-lg' x-text="faq.answer"></p>
              </div>
            </div>
          </div>
        </template>

        <!-- Pagination -->

