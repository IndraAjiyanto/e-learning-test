<!-- MOBILE PROGRAM SECTION (< 640px / Figma Frame "Choose Your Program") -->
<section class="block sm:hidden bg-white py-12 px-5 relative z-10 w-full font-montserrat" id="courses-section-mobile">
  <div class="w-full">

    <!-- Header Section -->
    {{> components/ui/section_header
        wrapperClass="mb-8"
        badge=(t 'test.home.programSection.ourProgram')
        badgeClass="px-5 py-2 text-[14px] mb-4"
        title=(t 'test.home.programSection.title')
        titleClass="font-montserrat font-bold text-[24px] text-[#0B1F3B] mb-3"
        showDivider=true
        dividerClass="w-[68px] bg-[#0B1F3B] mb-4"
        description=(t 'test.home.programSection.description')
        descClass="font-sans font-normal text-[14px] text-[#2D2D2D] max-w-[340px]"
    }}

    <!-- Cards Stack -->
    <div class="flex flex-col gap-6 w-full">
      {{#each category}}
        {{> components/home/card_program
            image=this.icon
            name=this.name
            text=this.text
            lang=../lang
        }}
      {{/each}}
    </div>
  </div>
</section>

<!-- DESKTOP PROGRAM SECTION (>= 640px / Figma Baseline W1728) -->
<section class="hidden sm:block bg-white py-12 sm:py-16 relative z-10 w-full" id="courses-section">
  <div class="container mx-auto px-4 lg:px-8 max-w-[1324px]">

    <!-- Header Section -->
    {{> components/ui/section_header
        wrapperClass="mb-8 sm:mb-12 relative"
        badge=(t 'test.home.programSection.ourProgram')
        badgeClass="w-[305px] h-[49px] text-[20px] mb-0"
        title=(t 'test.home.programSection.title')
        titleClass="text-3xl md:text-4xl lg:text-[42px] my-8 font-[600] text-black font-montserrat tracking-tight"
        showDivider=true
        dividerClass="w-[68px] bg-[#0B1F3B] mb-8"
        description=(t 'test.home.programSection.description')
        descClass="text-base md:text-xl text-[#000000]/80 leading-[45px] max-w-auto font-sans font-[400]"
    }}

    <!-- Classes Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 w-full">
      
      {{#each category}}
        {{> components/home/card_program
            image=this.icon
            name=this.name
            text=this.text
            lang=../lang
            desktop=true
        }}
      {{/each}}

    </div>
  </div>
</section>