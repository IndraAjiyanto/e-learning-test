<section class="bg-white py-16 relative z-10 w-full" id="courses-section">
  <div class="container mx-auto px-4 lg:px-8 max-w-[1324px]">

    <!-- Header Section -->
    <div class="text-center mb-12 relative">
      <!-- Pill badge -->
      <div class="border border-[#003060] text-[#003060] w-[305px] h-[49px] flex items-center justify-center rounded-[50px] text-[20px] font-[500] font-montserrat transition-all mx-auto bg-[#6EB6E5]/20">
        Our Program
      </div>
      
      <!-- Title -->
      <h2 class="text-3xl md:text-4xl lg:text-[42px] my-8 font-[600] text-black font-montserrat tracking-tight">
        <span class="font-[600] text-[#6EB6E5]">Choose</span> Your Program
      </h2>
      
      <!-- Short horizontal line -->
      <div class="w-[68px] h-[5px] bg-[#0B1F3B] mx-auto mb-8 rounded-full"></div>

      <!-- Subtitle -->
      <p class="text-base md:text-xl text-[#000000]/80 leading-[45px] max-w-auto mx-auto font-sans font-[400]">
        Explore our learning programs designed to help you build in-demand skills, gain real experience, and accelerate your career.
      </p>
    </div>

    <!-- Classes Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full">
      
      <!-- Card 1: Bootcamp -->
      {{#each category}}
      <div class="w-full max-w-[433px] min-h-[552px] h-full mx-auto group card bg-[#F5F5F5]/50 backdrop-blur-[6.6px] border-2 border-white/10 rounded-[12px] overflow-hidden shadow-[0px_0px_4px_0px_rgba(0,0,0,0.25)] flex flex-col">
        <img src="{{icon}}" alt="{{this.name}}" class="h-[278px] w-full object-cover" />
        <div class="card-body p-6 flex flex-col flex-1">
          <h3 class="font-montserrat font-[600] text-[35px] text-[#0B1F3B] mb-2">
            {{this.name}}
          </h3>
          <p class="font-sans font-[400] text-base leading-[30px] text-black/80 flex-1 mb-4">
            {{getByLang this.text ../lang}}
          </p>
          <div class="card-actions mt-auto flex justify-end">
            <a href="#" class="w-[50px] h-[50px] rounded-full bg-[#003060] text-white flex items-center justify-center hover:bg-[#003060] transition-colors shadow-md">
              <i class="fas fa-arrow-right text-[18px]"></i>
            </a>
          </div>
        </div>
      </div>
      {{/each}}

    </div>
  </div>
</section>