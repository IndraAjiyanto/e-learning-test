<section class='bg-gradient-to-br from-white via-gray-50 to-white py-20 px-6 lg:px-20'>
  <div class='container mx-auto max-w-7xl'>
    <!-- Header -->
    <div class='text-center mb-16 min-h-42'>

      <h2 class='text-4xl md:text-5xl font-bold text-gray-900 mb-4 font-montserrat'>
        {{t "test.home.specialProgram.tittle"}}
      </h2>
      <p class='text-lg text-gray-600 max-w-2xl mx-auto  mt-3'>
        {{t "test.home.specialProgram.description"}}
      </p>
    </div>

    <!-- Two Cards Grid -->
    <div class='grid md:grid-cols-2 gap-8 max-w-6xl mx-auto'>
      
      <!-- WIP Card -->
{{#each special_program}}
<a href='category/program/{{nama_kategori}}' class='group block h-full' data-animate="slide-right" data-delay="100">
  <div class='relative bg-white rounded-3xl p-8 border-2 border-gray-300 hover:border-secondary shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 overflow-hidden h-full flex flex-col'>
    <!-- Background Pattern -->
    <div class='absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-gray-100/50 to-gray-200/50 rounded-full blur-3xl -z-0'></div>
    
    <div class='relative z-10 flex flex-col h-full'>
      <!-- Icon - Fixed height -->
      <div class='mb-6 flex items-center justify-between flex-shrink-0'>
        <div class='w-20 h-20 bg-gradient-to-br from-primary via-secondary to-gray-900 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300'>
          <img src='{{icon}}' alt='{{nama_kategori}}' class='w-12 h-12'>
        </div>
        <span class='bg-gradient-to-br from-primary via-secondary to-gray-900 text-white px-4 py-2 rounded-full text-sm font-bold whitespace-nowrap'>
          {{getByLang for ../lang}}
        </span>
      </div>

      <!-- Title - Fixed height with line clamp -->
      <h3 class='text-3xl font-bold text-gray-900 mb-4 font-montserrat group-hover:text-gray-700 transition-colors min-h-[4rem] line-clamp-2'>
        {{nama_kategori}}
      </h3>
      
      <!-- Description - Fixed height with line clamp -->
      <p class='text-gray-600 text-lg leading-relaxed mb-6 min-h-[6rem] line-clamp-3'>
        {{getByLang deskripsi ../lang}}
      </p>

      <!-- Features List - Fixed height with scroll if needed -->
      <ul class='space-y-3 mb-8 min-h-[12rem] max-h-[12rem] overflow-y-auto'>
        {{#if (eq ../lang 'id')}}
          {{#each info_id}}
          <li class='flex items-center gap-3 text-gray-700'>
            <div class='w-6 h-6 bg-gray-800 rounded-full flex items-center justify-center flex-shrink-0'>
              <i class='fas fa-check text-white text-xs'></i>
            </div>
            <span class='font-medium line-clamp-1'>{{this}}</span>
          </li>
          {{/each}}
        {{else if (eq ../lang 'en')}}
          {{#each info_en}}
          <li class='flex items-center gap-3 text-gray-700'>
            <div class='w-6 h-6 bg-gray-800 rounded-full flex items-center justify-center flex-shrink-0'>
              <i class='fas fa-check text-white text-xs'></i>
            </div>
            <span class='font-medium line-clamp-1'>{{this}}</span>
          </li>
          {{/each}}
        {{else if (eq ../lang 'ja')}}
          {{#each info_ja}}
          <li class='flex items-center gap-3 text-gray-700'>
            <div class='w-6 h-6 bg-gray-800 rounded-full flex items-center justify-center flex-shrink-0'>
              <i class='fas fa-check text-white text-xs'></i>
            </div>
            <span class='font-medium line-clamp-1'>{{this}}</span>
          </li>
          {{/each}}
        {{/if}}
      </ul>

      <!-- CTA Button - Always at bottom -->
      <div class='flex items-center justify-between pt-6 border-t-2 border-gray-200 mt-auto flex-shrink-0'>
        <span class='text-gray-600 font-semibold whitespace-nowrap'>{{t "test.home.programSection.buttonViewProgram"}}</span>
        <div class='w-12 h-12 bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary rounded-full flex items-center justify-center transition shadow-lg group-hover:scale-110 flex-shrink-0'>
          <i class="fas fa-arrow-right text-white transition-transform group-hover:scale-125"></i>
        </div>
      </div>
    </div>
  </div>
</a>
{{/each}}

    </div>

  </div>
</section>