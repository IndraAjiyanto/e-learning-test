<script>
function sessionData() {
  return {
    data: JSON.parse(localStorage.getItem('activeData')) || [],

    async fetchSessions() {
      const res = await fetch(`/week/session/{{minggu.id}}`);
      this.data = await res.json();

      localStorage.setItem('activeData', JSON.stringify(this.data));
    },

        formatTanggal(value) {
      const options = { year: 'numeric', month: 'long', day: 'numeric' };
      return new Date(value).toLocaleDateString('id-ID', options);
    },

formatTime(value) {
  return value ? value.slice(0, 5) : '';
},
  }
}
</script>