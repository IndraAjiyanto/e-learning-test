  <!-- Session List Section -->
  <template x-if="data && data.length > 0">
    <ul class='space-y-3 mb-6'>
      <template x-for="session in data" :key="session.id">
        <div
          class='bg-gray-50 p-4 rounded-xl shadow-lg hover:bg-gray-100 transition'
        >
          <div class='flex justify-between items-start'>
            <div>
              <p class='font-semibold text-gray-900 mb-1' x-text="'Session ' + session.pertemuan_ke + ': ' + session.topik"></p>
              <div
                class='grid grid-cols-2 gap-x-8 gap-y-1 text-sm text-gray-600'
              >
                <p><span class='font-medium'>Location :</span>
                  <span x-text="session.lokasi"></span></p>
                <p><span class='font-medium'>Time:</span>
                <span x-text="formatTime(session.waktu_awal)"></span>
                  -
                  <span x-text="formatTime(session.waktu_akhir)"></span></p>
                <p><span class='font-medium'>Date:</span>
                  <span x-text="formatTanggal(session.tanggal)"></span></p>
              </div>
            </div>
            <a
              :href="`/session/${session.id}`"
              class='p-2 rounded-full bg-indigo-50 text-indigo-600 hover:bg-indigo-100 hover:text-indigo-800 transition'
            >
              <svg
                xmlns='http://www.w3.org/2000/svg'
                fill='none'
                viewBox='0 0 24 24'
                stroke-width='1.5'
                stroke='currentColor'
                class='w-5 h-5'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M12 6.75c-4.5 0-8.25 2.25-10.5 6
                 2.25 3.75 6 6 10.5 6s8.25-2.25
                 10.5-6c-2.25-3.75-6-6-10.5-6z'
                />
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M12 15a3 3 0 100-6 3 3 0 000 6z'
                />
              </svg>
            </a>
          </div>
        </div>
        </template>
    </ul>
    </template>
    <!-- Empty State -->
    <template x-if="!data || data.length === 0">
