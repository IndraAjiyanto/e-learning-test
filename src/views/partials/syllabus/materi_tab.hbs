{{!--
  Partial: Syllabus Materi Tab (Admin) — mirror dari session/materi_tab.hbs
  Path: partials/syllabus/materi_tab.hbs
  Dipakai: {{> syllabus/materi_tab}} di admin/course/detail_syllabus_item.hbs
           (tab materi), dibungkus x-data="materiData()" + x-init="init()".
  Composes: sub_partials/syllabus/materi_tab/{pdf,video,ppt} (pakai
            material/material-row dengan syllabusId: title + edit/delete/Detail).
  Layout & design identik dengan tab materi halaman detail session
  (sub-tab outline #003060, rows h68, Add Material full-width outline #3B82F6).
  BE: toggleFetchMateri → GET /syllabus/{pdf,video,ppt}/:syllabusId (JSON
      Material[]). CRUD: /learning-material/formCreate/syllabus/:jenis/:id,
      delete /learning-material/syllabus/:id/:syllabusId?_method=DELETE.
      Preview modal via event open-materi-modal.
  Catatan: localStorage key memakai prefix 'syllabus_' agar tidak tabrakan
  dengan tab materi halaman session.
--}}
  <div class='w-full'>

    {{!-- Sub-tab PDF / Video / PPT --}}
    <div class='flex flex-row gap-[12px] w-full mb-[12px]'>
      <button type='button' @click="toggleFetchMateri('/syllabus/pdf/{{syllabus.id}}', 'pdf')"
        :class="tabMateri === 'pdf' ? 'bg-[#003060] [outline:1px_solid_#003060]' : 'bg-[#FFFFFF] [outline:1px_solid_#003060] hover:bg-[#F0F7FF]'"
        class='box-border flex-1 min-w-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center rounded-[8px] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors'>
        <span class='text-[16px]/[normal] font-inter font-semibold whitespace-nowrap'
          :class="tabMateri === 'pdf' ? 'text-[#FFFFFF]' : 'text-[#003060]'">PDF</span>
      </button>
      <button type='button' @click="toggleFetchMateri('/syllabus/video/{{syllabus.id}}', 'video')"
        :class="tabMateri === 'video' ? 'bg-[#003060] [outline:1px_solid_#003060]' : 'bg-[#FFFFFF] [outline:1px_solid_#003060] hover:bg-[#F0F7FF]'"
        class='box-border flex-1 min-w-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center rounded-[8px] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors'>
        <span class='text-[16px]/[normal] font-inter font-semibold whitespace-nowrap'
          :class="tabMateri === 'video' ? 'text-[#FFFFFF]' : 'text-[#003060]'">Video</span>
      </button>
      <button type='button' @click="toggleFetchMateri('/syllabus/ppt/{{syllabus.id}}', 'ppt')"
        :class="tabMateri === 'ppt' ? 'bg-[#003060] [outline:1px_solid_#003060]' : 'bg-[#FFFFFF] [outline:1px_solid_#003060] hover:bg-[#F0F7FF]'"
        class='box-border flex-1 min-w-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center rounded-[8px] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors'>
        <span class='text-[16px]/[normal] font-inter font-semibold whitespace-nowrap'
          :class="tabMateri === 'ppt' ? 'text-[#FFFFFF]' : 'text-[#003060]'">PPT</span>
      </button>
    </div>

    <!-- Header Toolbar (Manage Delete) -->
    <div class='flex flex-col gap-3 w-full mb-3' x-show='dataMateri && dataMateri.length > 0'>
      <div class='flex items-center justify-between'>
        <div>
          <span class='font-inter text-sm font-medium text-[#737373]' x-text="'Total ' + dataMateri.length + ' ' + tabMateri.toUpperCase() + ' Material' + (dataMateri.length > 1 ? 's' : '')"></span>
        </div>
        <div>
          <button
            type='button'
            @click='toggleSelectMode()'
            :disabled='isCompleted'
            class='inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-lg border font-inter text-sm font-semibold transition-all shadow-sm'
            :class="isCompleted ? 'opacity-50 cursor-not-allowed bg-gray-100 text-gray-400 border-gray-200' : (selectMode ? 'bg-[#F5F5F5] border-[#D4D4D4] hover:bg-[#E5E5E5] text-[#404040] w-10 px-0 cursor-pointer' : 'bg-white border-[#D4D4D4] hover:border-[#DC2626] hover:bg-[#FEF2F2] text-[#404040] hover:text-[#DC2626] px-3.5 cursor-pointer')"
            :title="isCompleted ? 'Materials cannot be deleted because this syllabus has already been completed by a participant.' : (selectMode ? 'Close' : 'Manage Delete')"
          >
            <template x-if='!selectMode'>
              <div class='flex items-center gap-1.5'>
                <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4' :class="isCompleted ? 'text-gray-400' : 'text-[#DC2626]'">
                  <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
                </svg>
                <span>Manage Delete</span>
              </div>
            </template>
            <template x-if='selectMode'>
              <div class='flex items-center justify-center'>
                <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4 text-[#525252]'>
                  <line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/>
                </svg>
              </div>
            </template>
          </button>
        </div>
      </div>

      {{!-- Bulk Selection Action Bar --}}
      <div
        x-show='selectMode'
        x-cloak
        x-transition:enter='transition ease-out duration-150'
        x-transition:enter-start='opacity-0 -translate-y-2'
        x-transition:enter-end='opacity-100 translate-y-0'
        x-transition:leave='transition ease-in duration-100'
        x-transition:leave-start='opacity-100 translate-y-0'
        x-transition:leave-end='opacity-0 -translate-y-2'
        class='box-border w-full flex flex-col sm:flex-row justify-between items-center px-4 py-2.5 bg-[#FEF2F2] border border-[#FCA5A5] rounded-lg gap-2.5 shadow-sm'
        style='display: none;'
      >
        <div class='flex flex-wrap items-center gap-2 text-[14px] text-[#991B1B] font-inter font-medium'>
          <svg class='w-5 h-5 text-[#DC2626] shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'/>
          </svg>
          <span>
            <strong x-text='selectedIds ? selectedIds.length : 0'></strong> material(s) selected
          </span>

          <span class='text-[#FCA5A5] mx-1'>•</span>

          <button
            type='button'
            @click='toggleSelectAll()'
            :disabled='isCompleted || !deletableMaterials || deletableMaterials.length === 0'
            :class="(isCompleted || !deletableMaterials || deletableMaterials.length === 0) ? 'opacity-50 cursor-not-allowed hover:no-underline' : 'cursor-pointer hover:underline'"
            class='text-xs text-[#DC2626] font-semibold'
            x-text="isAllSelected() ? 'Deselect All' : 'Select All'"
          ></button>

          <template x-if='selectedIds && selectedIds.length > 0'>
            <button
              type='button'
              @click='clearSelection()'
              class='text-xs text-[#7F1D1D] hover:underline font-normal cursor-pointer ml-1'
            >
              (Clear Selection)
            </button>
          </template>
        </div>

        <div class='flex items-center gap-2 shrink-0'>
          <button
            type='button'
            @click='confirmDeleteSelected()'
            :disabled='isCompleted || !selectedIds || selectedIds.length === 0'
            class='inline-flex h-9 items-center justify-center gap-1.5 rounded-lg bg-[#DC2626] px-3.5 font-inter text-sm font-semibold text-white shadow-sm hover:bg-[#B91C1C] disabled:opacity-50 disabled:cursor-not-allowed transition-colors cursor-pointer'
          >
            <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4'>
              <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
            </svg>
            <span>Delete Selected (<span x-text='selectedIds ? selectedIds.length : 0'></span>)</span>
          </button>

          <button
            type='button'
            @click='toggleSelectMode()'
            class='inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[#FCA5A5] bg-white text-[#991B1B] hover:bg-[#FEE2E2] transition-colors cursor-pointer'
            title='Close Manage Delete'
          >
            <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4'>
              <line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/>
            </svg>
          </button>
        </div>
      </div>
    </div>

{{> sub_partials/syllabus/materi_tab/pdf}}

{{> sub_partials/syllabus/materi_tab/video}}

{{> sub_partials/syllabus/materi_tab/ppt}}

  </div>

<div x-data="materiModal()"
     @open-materi-modal.window="openModal($event.detail)"
     x-show="isOpen"
     x-cloak
     class="fixed inset-0 z-50 overflow-y-auto"
     style="display: none;">

  <!-- Backdrop -->
  <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity z-40"
       @click="closeModal()"></div>

  <!-- Modal Content -->
  <div class="relative flex items-center justify-center min-h-screen p-4 z-50"
       @click="closeModal()">
    <div class="relative bg-white rounded-xl shadow-2xl max-w-6xl w-full max-h-[90vh] overflow-hidden"
         @click.stop>

      <!-- Header (brand blue #003060) -->
      <div class="flex items-center justify-between p-6 bg-[#003060]">
        <div>
          <h2 class="text-2xl font-bold text-white font-inter" x-text="materi.title"></h2>
          <p class="text-sm text-white/70 mt-1 font-inter">
            File Type: <span class="uppercase font-semibold" x-text="materi.fileType"></span>
          </p>
        </div>
        <button @click="closeModal()"
                class="p-2 hover:bg-white/10 rounded-lg transition">
          <svg xmlns="http://www.w3.org/2000/svg"
               class="h-6 w-6 text-white"
               fill="none" viewBox="0 0 24 24"
               stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Content -->
      <div class="p-6 overflow-y-auto bg-white" style="max-height: calc(90vh - 180px);">

        <!-- PDF Viewer -->
        <template x-if="materi.fileType === 'pdf'">
          <div class="w-full h-[600px] bg-white">
            <iframe :src="materi.file"
                    type="application/pdf"
                    class="w-full h-full border rounded-lg bg-white"
                    frameborder="0">
            </iframe>
          </div>
        </template>

        <!-- Video Viewer -->
        <template x-if="materi.fileType === 'video'">
          <div class="w-full aspect-video max-h-[600px] bg-black rounded-lg overflow-hidden flex items-center justify-center">
            <template x-if="isVideoEmbed(materi.file)">
              <iframe :src="getVideoEmbedUrl(materi.file)"
                      class="w-full h-full border-0"
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen>
              </iframe>
            </template>
            <template x-if="!isVideoEmbed(materi.file)">
              <video :src="materi.file"
                     controls
                     autoplay
                     class="w-full h-full object-contain bg-black">
              </video>
            </template>
          </div>
        </template>

        <!-- PPT Viewer -->
        <template x-if="materi.fileType === 'ppt'">
          <div class="w-full h-[600px] bg-[#0F172A] rounded-lg overflow-hidden">
            <iframe :src="getPptEmbedUrl(materi.file)"
                    class="w-full h-full border-0 rounded-lg bg-slate-900"
                    frameborder="0"
                    allowfullscreen="true"
                    mozallowfullscreen="true"
                    webkitallowfullscreen="true">
            </iframe>
          </div>
        </template>

      </div>

      <!-- Footer -->
      <div class="flex items-center justify-between p-6 border-t bg-gray-50">

      </div>

    </div>
  </div>
</div>

<script>
function materiModal() {
  return {
    isOpen: false,
    currentSlide: 0,
    materi: {
      id: null,
      title: '',
      fileType: '',
      file: '',
    },

    isVideoEmbed(url) {
      if (!url) return false;
      return url.includes('youtube.com') || url.includes('youtu.be');
    },

    getVideoEmbedUrl(url) {
      if (!url) return '';
      if (url.includes('youtube.com/watch?v=')) {
        return url.replace('watch?v=', 'embed/');
      }
      if (url.includes('youtu.be/')) {
        return url.replace('youtu.be/', 'youtube.com/embed/');
      }
      return url;
    },

    getPptEmbedUrl(url) {
      if (!url) return '';
      // Support Google Slides published link: replace /pub? with /pubembed?
      return url.replace('/pub?', '/pubembed?');
    },

    get totalSlides() {
      return this.materi.slides ? this.materi.slides.length : 0;
    },

    openModal(data) {

      this.materi = data;

      // Pastikan slides adalah array
      if (data.slides && !Array.isArray(data.slides)) {
        this.materi.slides = [];
      }

      this.currentSlide = 0;
      this.isOpen = true;
      document.body.style.overflow = 'hidden';

    },

    closeModal() {
      this.isOpen = false;
      document.body.style.overflow = 'auto';
    },

    nextSlide() {
      if (this.currentSlide < this.totalSlides - 1) {
        this.currentSlide++;
      }
    },

    prevSlide() {
      if (this.currentSlide > 0) {
        this.currentSlide--;
      }
    }
  }
}

function materiData() {
  return {
    tabMateri: localStorage.getItem('syllabus_tabMateri') || 'pdf',
    dataMateri: localStorage.getItem('syllabus_dataMateri') ? JSON.parse(localStorage.getItem('syllabus_dataMateri')) : [],
    isCompleted: {{#if isCompleted}}true{{else}}false{{/if}},
    selectMode: false,
    selectedIds: [],

    async init() {
      const urlMap = {
        pdf: '/syllabus/pdf/{{syllabus.id}}',
        video: '/syllabus/video/{{syllabus.id}}',
        ppt: '/syllabus/ppt/{{syllabus.id}}'
      }

      await this.toggleFetchMateri(urlMap[this.tabMateri], this.tabMateri);
    },

    async toggleFetchMateri(url, jenis) {
      this.tabMateri = jenis;
      this.selectedIds = [];
      localStorage.setItem('syllabus_tabMateri', jenis);
      try {
        const res = await fetch(url);
        this.dataMateri = await res.json();
        localStorage.setItem('syllabus_dataMateri', JSON.stringify(this.dataMateri));
      } catch (error) {
        console.error('❌ Error:', error);
      }
    },

    toggleSelectMode() {
      if (this.isCompleted) return;
      this.selectMode = !this.selectMode;
      if (!this.selectMode) {
        this.selectedIds = [];
      }
    },

    clearSelection() {
      this.selectedIds = [];
    },

    isMaterialDisabled(materi) {
      return Boolean(this.isCompleted);
    },

    get deletableMaterials() {
      return (this.dataMateri || []).filter(m => !this.isMaterialDisabled(m));
    },

    isAllSelected() {
      const deletable = this.deletableMaterials;
      return deletable.length > 0 && deletable.every(m => this.selectedIds.includes(String(m.id)));
    },

    toggleSelectAll() {
      const deletable = this.deletableMaterials;
      if (this.isAllSelected()) {
        this.selectedIds = [];
      } else {
        this.selectedIds = deletable.map(m => String(m.id));
      }
    },

    confirmDeleteSelected() {
      if (this.isCompleted || !this.selectedIds || this.selectedIds.length === 0) return;
      const count = this.selectedIds.length;
      const title = `Delete ${count} Material${count > 1 ? 's' : ''}?`;
      const description = `Are you sure you want to permanently delete the ${count} selected material${count > 1 ? 's' : ''}? Physical files will also be removed.`;

      const performDelete = () => {
        submitDeleteForm('/bulk-delete/selected', {
          entity: 'material',
          ids: this.selectedIds,
        });
      };

      if (typeof openDeleteModal === 'function') {
        openDeleteModal({
          title,
          description,
          confirmLabel: `Delete (${count})`,
          cancelLabel: 'Cancel',
          onConfirm: performDelete,
        });
      } else if (confirm(`${title}\n\n${description}`)) {
        performDelete();
      }
    }
  }
}
</script>
