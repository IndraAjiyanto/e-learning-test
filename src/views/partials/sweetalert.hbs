<script>
  {{#if success}}
    Swal.fire({
      icon: 'success',
      title: 'Success!',
      text: '{{success}}',
      toast: true,
      position: 'bottom-start',
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true
    });
  {{/if}}

  {{#if info}}
    Swal.fire({
      icon: 'info',
      title: 'Info!',
      text: '{{info}}',
      toast: true,
      position: 'bottom-start',
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true
    });
  {{/if}}

  {{#if error}}
    Swal.fire({
      icon: 'error',
      title: 'Fail!',
      text: '{{error}}',
      toast: true,
      position: 'bottom-start',
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true
    });
  {{/if}}

  function confirmDelete(button) {
    const form = button.closest("form");

    Swal.fire({
      title: "Are you sure?",
      text: "This data will be deleted!",
      icon: "warning",
      showCancelButton: true,
      buttonsStyling: false,
      confirmButtonText: "Yes, delete!",
      cancelButtonText: "Cancel",
      customClass: {
        confirmButton:
          "px-4 py-2 rounded-lg bg-red-600 text-white font-semibold hover:bg-red-700 transition",
        cancelButton:
          "px-4 py-2 rounded-lg bg-gray-200 text-gray-700 font-medium hover:bg-gray-300 transition",
        actions: "flex gap-4 justify-center"
      }
    }).then((result) => {
      if (result.isConfirmed) form.submit();
    });
  }

  function confirmAction(button, message, title = "Confirmation") {
  const form = button.closest("form");

  Swal.fire({
    title: title,
    text: message,
    icon: "info", 
    showCancelButton: true,
    buttonsStyling: false,
    confirmButtonText: "Yes, continue",
    cancelButtonText: "Cancel",
    customClass: {
      confirmButton:
        "px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition", // ✅ warna lebih netral / biru
      cancelButton:
        "px-4 py-2 rounded-lg bg-gray-200 text-gray-700 font-medium hover:bg-gray-300 transition",
      actions: "flex gap-4 justify-center"
    }
  }).then((result) => {
                if (typeof clearQuizStorage === "function") {
                clearQuizStorage();
            }
    if (result.isConfirmed) form.submit();
  });
}

</script>
