<style>
  /* Toast SweetAlert dipasang top-end. Offset-nya disamakan dengan komponen
     toast baru (ui/super_admin/toast/success) supaya dua kanal notifikasi
     muncul di titik yang sama dan tidak menimpa navbar sticky (z-50, ~68px).
     Selector dibatasi ke .swal2-top-end agar dialog konfirmasi (.swal2-center)
     tidak ikut tergeser. */
  .swal2-container.swal2-top-end {
    padding-top: var(--app-toast-top, 5rem);
    padding-right: 1rem;
  }

  @media (min-width: 640px) {
    .swal2-container.swal2-top-end {
      padding-right: 34px;
    }
  }
</style>

<script>
  {{#if success}}
    Swal.fire({
      icon: 'success',
      title: 'Success!',
      text: '{{success}}',
      toast: true,
      position: 'top-end',
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true
    });
  {{/if}}

  {{#if info}}
    Swal.fire({
      icon: 'info',
      title: 'Info!',
      text: '{{info}}',
      toast: true,
      position: 'top-end',
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true
    });
  {{/if}}

  {{#if error}}
    Swal.fire({
      icon: 'error',
      title: 'Fail!',
      text: '{{error}}',
      toast: true,
      position: 'top-end',
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true
    });
  {{/if}}

  function confirmDelete(button) {
    const form = button.closest("form");

    Swal.fire({
      title: "Delete User Account?",
      text: "Are you sure you want to delete this user? This action will permanently remove the user's account and cannot be undone.",
      iconHtml: `<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-8 border-[#F2E1E1] bg-[#F4DDDD]"><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' aria-hidden='true' class='h-6 w-6'><path d='M20.25 4.5H16.5V3.75C16.5 3.15326 16.2629 2.58097 15.841 2.15901C15.419 1.73705 14.8467 1.5 14.25 1.5H9.75C9.15326 1.5 8.58097 1.73705 8.15901 2.15901C7.73705 2.58097 7.5 3.15326 7.5 3.75V4.5H3.75C3.55109 4.5 3.36032 4.57902 3.21967 4.71967C3.07902 4.86032 3 5.05109 3 5.25C3 5.44891 3.07902 5.63968 3.21967 5.78033C3.36032 5.92098 3.55109 6 3.75 6H4.5V19.5C4.5 19.8978 4.65804 20.2794 4.93934 20.5607C5.22064 20.842 5.60218 21 6 21H18C18.3978 21 18.7794 20.842 19.0607 20.5607C19.342 20.2794 19.5 19.8978 19.5 19.5V6H20.25C20.4489 6 20.6397 5.92098 20.7803 5.78033C20.921 5.63968 21 5.44891 21 5.25C21 5.05109 20.921 4.86032 20.7803 4.71967C20.6397 4.57902 20.4489 4.5 20.25 4.5ZM9 3.75C9 3.55109 9.07902 3.36032 9.21967 3.21967C9.36032 3.07902 9.55109 3 9.75 3H14.25C14.4489 3 14.6397 3.07902 14.7803 3.21967C14.921 3.36032 15 3.55109 15 3.75V4.5H9V3.75ZM18 19.5H6V6H18V19.5ZM10.5 9.75V15.75C10.5 15.9489 10.421 16.1397 10.2803 16.2803C10.1397 16.421 9.94891 16.5 9.75 16.5C9.55109 16.5 9.36032 16.421 9.21967 16.2803C9.07902 16.1397 9 15.9489 9 15.75V9.75C9 9.55109 9.07902 9.36032 9.21967 9.21967C9.36032 9.07902 9.55109 9 9.75 9C9.94891 9 10.1397 9.07902 10.2803 9.21967C10.421 9.36032 10.5 9.55109 10.5 9.75ZM15 9.75V15.75C15 15.9489 14.921 16.1397 14.7803 16.2803C14.6397 16.421 14.4489 16.5 14.25 16.5C14.0511 16.5 13.8603 16.421 13.7197 16.2803C13.579 16.1397 13.5 15.9489 13.5 15.75V9.75C13.5 9.55109 13.579 9.36032 13.7197 9.21967C13.8603 9.07902 14.0511 9 14.25 9C14.4489 9 14.6397 9.07902 14.7803 9.21967C14.921 9.36032 15 9.55109 15 9.75Z' fill='#c80606' /></svg></span>`,
      showCancelButton: true,
      buttonsStyling: false,
      confirmButtonText: "Delete",
      cancelButtonText: "Cancel",
      customClass: {
        popup: "w-full max-w-[400px] !rounded-xl !p-6 shadow-[0px_8px_8px_-4px_rgba(0,0,0,0.03),0px_20px_24px_-4px_rgba(0,0,0,0.08)] !bg-white",
        icon: "!border-none !m-0 !w-auto !h-auto !mb-5",
        title: "!text-center !font-inter !text-lg !font-semibold !leading-7 !text-[#171717] !p-0 !m-0 !mb-2",
        htmlContainer: "!text-center !font-inter !text-sm !font-normal !leading-5 !text-[#525252] !m-0 !p-0",
        actions: "flex !w-full !gap-3 !mt-8 !p-0",
        confirmButton: "inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-[#E84338] bg-[#E84338] px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#d13328] hover:bg-[#d13328] active:bg-[#b82c22] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E84338]/40 focus-visible:ring-offset-2 !m-0",
        cancelButton: "inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-[#d4d4d4] bg-white px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-[#404040] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#a3a3a3] hover:bg-[#f5f5f5] active:bg-[#ededed] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#404040]/40 focus-visible:ring-offset-2 !m-0",
        backdrop: "backdrop-blur-[8px] !bg-[#0a0a0a]/70"
      }
    }).then((result) => {
      if (result.isConfirmed) form.submit();
    });
  }

function confirmAction(button, message, title = "Confirmation", value = null) {
    const form = button.closest("form");

    Swal.fire({
        title: title,
        text: message,
        icon: "info",
        showCancelButton: true,
        buttonsStyling: false,
        confirmButtonText: "Yes, continue",
        cancelButtonText: "Cancel",
        customClass: {
            confirmButton: "px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition",
            cancelButton: "px-4 py-2 rounded-lg bg-gray-200 text-gray-700 font-medium hover:bg-gray-300 transition",
            actions: "flex gap-4 justify-center"
        }
    }).then((result) => {
        if (typeof clearQuizStorage === "function") {
            clearQuizStorage();
        }
        if (result.isConfirmed) {
            if (value !== null) {
                form.querySelector('#prosesValue').value = value;
            }
            form.submit();
        }
    });
}

function showTimeOverAlert(query, message, text) {
  const form = document.querySelector(query);
  Swal.fire({
  title: text,
  text: message,
  icon: "info",
  customClass: {
    confirmButton:
      "px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition",
  },
}).then((result) => {
  if (result.isConfirmed) {
        if (typeof window.clearQuizStorage === "function") {
        window.clearQuizStorage();
    }
    form.submit();
  }
});
}
</script>
