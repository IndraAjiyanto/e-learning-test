{{!--
  Partial: Session Assignment Tab (Admin) — Container - Session Assignment (slicing.pen A2pWwW)
  Path: partials/session/tugas_tab.hbs
  Dipakai: {{> session/tugas_tab}} di admin/session/detail.hbs (tab assignment).
  Composes: assignment/assignment-row (title + delete + Detail).
  Design: rows h68 (judul Montserrat 16/600 #003060, delete 44 outline #D9D9D9,
  Detail w81 outline #003060) + Add Assignment full-width h48 outline #3B82F6.
  BE: tugasData().fetchTugas → GET /session/task/:sessionId (Assignment[]).
      Detail GET /answer-assigment/:id; delete POST /task/:id/:sessionId.
  Logika Alpine dipertahankan verbatim dari implementasi lama.
--}}
  <!-- Assignment List Section -->
  <template x-if="data && data.length > 0">
    <div class='flex flex-col gap-[10px] w-full mb-[10px]'>
      <template x-for="assigment in data" :key="assigment.id">
        {{> components/ui/admin/assignment/assignment-row}}
      </template>
    </div>
  </template>
    <!-- Empty State -->
    <template x-if="!data || data.length === 0">
    <div class="flex flex-col items-center justify-center text-center py-16 bg-gray-50 border-2 border-dashed rounded-xl mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14 text-gray-400 mb-4" fill="none"
           viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 
                 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      <p class="text-gray-700 font-medium text-lg">No assignments yet</p>
      <p class="text-gray-500 text-sm mt-1">
        Click <span class="font-semibold">Add Assignment</span> to create a new one.
      </p>
    </div>
    </template>

  <!-- Add Assignment -->
  <a href="/task/formCreate/{{session.id}}"
     class='box-border w-full shrink-0 h-[48px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#3B82F6] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#F0F7FF] transition-colors'>
    <span class='text-[16px]/[normal] text-[#3B82F6] font-inter font-semibold whitespace-nowrap'>Add Assignment</span>
  </a>


  <script>
function tugasData() {
  return {
    data: JSON.parse(localStorage.getItem('activeData')) || [],

    async fetchTugas() {
      const res = await fetch('/session/task/{{session.id}}');
      this.data = await res.json();

      localStorage.setItem('activeData', JSON.stringify(this.data));
    },
  }
}
</script>
