{{!-- Logbook Review — Container - Logbook Review (e85DZk) slice-accurate, prefix logbook- --}}
{{> components/ui/admin/logbook/logbook-table}}

{{> sub_partials/session/logbook_tab/modal_information}}

<script>
  // Alpine.js Component: Logbook Table
  function logbookData() {
    return {
    data: [],
      searchInput: "",
      search: "",
      pageNumber: 0,
      size: 5,
      amount: 0,

      showModal: false,
      selectedLogbook: null,

      async fetchLogBook() {
        const res = await fetch('/session/logbooks/{{session.id}}');
        this.data = await res.json();
      },

      get filteredData() {
        let filtered = this.data.filter(l =>
          (
            `${l.activity} ${l.activityDetails} ${l.obstacles} ${l.otherDocumentation} ${l.user?.username} ${l.user?.email}`
          ).toLowerCase()
          .includes(this.search.toLowerCase())
        );

        this.amount = filtered.length;

        const start = this.pageNumber * this.size;
        return filtered.slice(start, start + this.size);
      },

      // ============================
      // EXPORT EXCEL
      // ============================
      async exportExcel() {
        try {
          const filtered = this.data.filter(l =>
            (
              `${l.activity} ${l.activityDetails} ${l.obstacles} ${l.otherDocumentation} ${l.user?.username} ${l.user?.email}`
            )
              .toLowerCase()
              .includes(this.search.toLowerCase())
          );

          await exportRowsToExcel({
            rows: filtered,
            sheetName: 'Logbook User',
            filePrefix: 'Logbook_User',
            columns: [
              { header: 'No', width: 5, value: (log, index) => index + 1 },
              { header: 'Activity', width: 30, value: (log) => log.activity || '-' },
              { header: 'Details', width: 50, value: (log) => log.activityDetails || '-' },
              { header: 'Obstacle', width: 40, value: (log) => log.obstacles || '-' },
              { header: 'Documentation', width: 28, value: (log) => log.documentation, isImage: true },
              { header: 'Additional Documentation', width: 28, value: (log) => log.otherDocumentation, isImage: true },
              { header: 'Program', width: 25, value: (log) => log.session?.weeks?.course?.name || '-' },
              { header: 'User', width: 20, value: (log) => log.user?.username || '-' },
              { header: 'Email', width: 28, value: (log) => log.user?.email || '-' },
              {
                header: 'Status',
                width: 15,
                value: (log) =>
                  log.process === 'approved'
                    ? 'Approved'
                    : log.process === 'rejected'
                    ? 'Rejected'
                    : 'Under Review',
              },
              { header: 'Date', width: 20, value: (log) => this.formatDate(log.createdAt) },
            ],
          });
        } catch (error) {
          alert('Failed to export data to Excel');
          console.error(error);
        }
      },

      // ============================
      // DATE FORMATTER
      // ============================
      formatDate(date) {
        if (!date) return "-";
        return new Date(date).toLocaleDateString("id-ID", {
          year: "numeric",
          month: "short",
          day: "numeric",
          hour: "2-digit",
          minute: "2-digit"
        });
      },

      // ============================
      // PAGINATION
      // ============================
      pages() {
        return Array.from({ length: this.pageCount() });
      },

      pageCount() {
        return Math.ceil(this.amount / this.size);
      },

      nextPage() {
        if (this.pageNumber < this.pageCount() - 1) {
          this.pageNumber++;
        }
      },

      prevPage() {
        if (this.pageNumber > 0) {
          this.pageNumber--;
        }
      },

      viewPage(index) {
        this.pageNumber = index;
      },

      // ============================
      // MODAL HANDLER
      // ============================
      openModal(id) {
        this.selectedLogbook = this.data.find(l => l.id == id);
        this.showModal = true;
      },

      closeModal() {
        this.showModal = false;
        this.selectedLogbook = null;
      }
    };
  }
</script>
