{{!-- Logbook Mentor — Logbook Mentor in Detail Session (lDvy3) slice-accurate, prefix logbook-mentor- --}}
{{> components/ui/admin/logbook/logbook-mentor-table sessionId=session.id}}

{{> sub_partials/session/logbook_mentor_tab/modal_information}}

<script>
  function logBookMentorData() {
    return {
    data: [],
      searchInput: "",
      search: "",
      pageNumber: 0,
      size: 5,
      amount: 0,

      showModal: false,
      selectedLogbook: null,

      async fetchLogBookMentor() {
      const res = await fetch('/session/logbooks-mentor/{{session.id}}');
      this.data = await res.json();
    },

      get filteredData() {
        const filtered = this.data.filter(l =>
          (
            `${l.activity} ${l.activityDetail} ${l.obstacle} ${l.user?.username} ${l.user?.email} ${l.user?.linkedin || ''} ${l.user?.biodata?.linkedin || ''}`
          ).toLowerCase()
          .includes(this.search.toLowerCase())
        );

        this.amount = filtered.length;

      const start = this.pageNumber * this.size;
      return filtered.slice(start, start + this.size);
      },

      async exportExcel() {
        try {
          const s = this.search.toLowerCase();

          const filtered = this.data.filter(l =>
            (
              `${l.activity} ${l.activityDetail} ${l.obstacle} ${l.user?.username} ${l.user?.email}`
            ).toLowerCase().includes(s)
          );

          await exportRowsToExcel({
            rows: filtered,
            sheetName: 'Logbook Mentor',
            filePrefix: 'Logbook_Mentor',
            columns: [
              { header: 'No', width: 5, value: (log, index) => index + 1 },
              { header: 'Activity', width: 30, value: (log) => log.activity || '-' },
              { header: 'Details', width: 50, value: (log) => log.activityDetail || '-' },
              { header: 'Obstacle', width: 40, value: (log) => log.obstacle || '-' },
              { header: 'Documentation', width: 28, value: (log) => log.documentation, isImage: true },
              { header: 'Program', width: 25, value: (log) => log.session?.weeks?.course?.name || '-' },
              { header: 'User', width: 20, value: (log) => log.user?.username || '-' },
              { header: 'Email', width: 28, value: (log) => log.user?.email || '-' },
              { header: 'Date', width: 20, value: (log) => this.formatDate(log.createdAt) },
            ],
          });
        } catch (error) {
          alert("Failed to export data to Excel");
          console.error(error);
        }
      },

      formatDate(date) {
        if (!date) return "-";
        return new Date(date).toLocaleDateString("id-ID", {
          year: "numeric",
          month: "short",
          day: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        });
      },

      pages() {
        return Array.from({ length: this.pageCount() });
      },

      pageCount() {
        return Math.ceil(this.amount / this.size);
      },

      nextPage() {
        if (this.pageNumber < this.pageCount() - 1) {
          this.pageNumber++;
        }
      },

      prevPage() {
        if (this.pageNumber > 0) {
          this.pageNumber--;
        }
      },

      viewPage(index) {
        this.pageNumber = index;
      },

      openModal(id) {
        this.selectedLogbook = this.data.find(l => l.id == id);
        this.showModal = true;
      },

      closeModal() {
        this.showModal = false;
        this.selectedLogbook = null;
      }
    };
  }
</script>
<style>
  .modal-content::-webkit-scrollbar {
    display: none;
  }
</style>