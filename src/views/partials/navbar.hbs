<div
  class='w-full shadow-lg fixed top-0 left-0 right-0 z-50 bg-gradient-to-br from-primary to-secondary text-white'
  x-data="{
    open: false,
    isDesktop: window.innerWidth >= 768,
    toggleMenu() {
      this.open = !this.open;
      document.body.style.overflow = this.open ? 'hidden' : '';
    },
    init() {
      window.addEventListener('resize', () => {
        this.isDesktop = window.innerWidth >= 768;
        if (this.isDesktop) {
          this.open = false;
          document.body.style.overflow = '';
        }
      });
    }
  }"
>
  <div
    x-data="{
    open: false,
    programOpen: false,
    lang: '{{lang}}',
    userOpen: false,
    active: '/dashboard',
    kategori: [],      // Function untuk set active
      setActive(path) {
        this.active = path;
        this.open = false;
        this.programOpen = false;
        this.userOpen = false;
        
        // Debug: log current active state
        console.log('Active path set to:', path);
      },
      
      // Function untuk check jika path aktif - DIPERBAIKI
      isActive(path) {
        const currentPath = this.active;
        console.log('Checking active:', path, 'vs current:', currentPath);
        
        // Exact match
        if (path === currentPath) {
          console.log('Exact match found');
          return true;
        }
        
        // Partial match untuk kategori program
        if (path.includes('/kategori/') && currentPath.includes('/kategori/')) {
          const pathCategory = path.split('/').pop();
          const currentCategory = currentPath.split('/').pop();
          if (pathCategory === currentCategory) {
            console.log('Category match:', pathCategory);
            return true;
          }
        }
        
        // Untuk user routes - lebih spesifik
        if (path.includes('/users/profile') && currentPath.includes('/users/profile')) return true;
        if (path.includes('/kelass/kelas_saya') && currentPath.includes('/kelass/kelas_saya')) return true;
        if (path.includes('/portfolios/myportfolio') && currentPath.includes('/portfolios/myportfolio')) return true;
        if (path.includes('/pembayarans/riwayat') && currentPath.includes('/pembayarans/riwayat')) return true;
        
        return false;
      },
      
      // Check jika program dropdown aktif - DIPERBAIKI
      isProgramActive() {
        const currentPath = this.active;
        console.log('Checking program active for:', currentPath);
        return currentPath.includes('/kategori/') || 
               currentPath === '/in-house-training' || 
               currentPath === '/wip' ||
               currentPath.includes('/dashboard/kategori/');
      },

    getByLang(obj, lang) {
    if (!obj || typeof obj !== 'object') return '';
    return obj[lang] || obj['id'] || ''; 
  },

  truncate(text, length) {
    if (!text) return '';
    const str = text.toString();
    if (str.length <= length) return str;
    return str.substring(0, length) + '...';
  },
      
      // Check jika user dropdown aktif - DIPERBAIKI
      isUserActive() {
        const currentPath = this.active;
        console.log('Checking user active for:', currentPath);
        return currentPath.includes('/users/') || 
               currentPath.includes('/kelass/kelas_saya') || 
               currentPath.includes('/portfolios/myportfolio') || 
               currentPath.includes('/pembayarans/riwayat');
      },
      
      // Initialize dengan current path - DIPERBAIKI
      async init() {
        // Set active berdasarkan current URL yang sebenarnya
        this.active = window.location.pathname;
        console.log('Initial active path:', this.active);
        
        // Fetch kategori data
        try {
          const response = await fetch('/dashboard/api/kategori');
          this.kategori = await response.json();
          console.log('Kategori loaded:', this.kategori);
        } catch (error) {
          console.error('Error fetching kategori:', error);
        }
        
        // Listen untuk popstate (browser back/forward)
        window.addEventListener('popstate', () => {
          this.active = window.location.pathname;
          console.log('Popstate - new active:', this.active);
        });
        
        // Intercept semua klik link untuk update state
        document.addEventListener('click', (e) => {
          const link = e.target.closest('a');
          if (link && link.href) {
            const url = new URL(link.href);
            if (url.origin === window.location.origin) {
              // Delay sedikit untuk memastikan navigation sudah terjadi
              setTimeout(() => {
                this.active = window.location.pathname;
                console.log('Link click - new active:', this.active);
              }, 100);
            }
          }
        });
      }
    }"
    class='flex flex-col max-w-screen-xl px-4 mx-auto md:items-center md:justify-between md:flex-row md:px-6 lg:px-8 h-16'
  >
    <!-- Logo & Toggle -->
    <div class='flex flex-row items-center justify-between h-16'>
      <a
        href='/dashboard'
        class='inline-block'
        @click="setActive('/dashboard')"
      >
        <img
          src='/public/image/logo_kotak_putih.png'
          alt='Logo'
          class='h-8 w-auto tracking-widest uppercase rounded-lg focus:outline-none focus:shadow-outline'
        />
      </a>

      <button
        class='rounded-lg md:hidden focus:outline-none focus:shadow-outline p-2 hover:bg-gray-800 transition-colors z-50'
        @click='toggleMenu()'
      >
        <svg fill='currentColor' viewBox='0 0 20 20' class='w-6 h-6'>
          <path
            x-show='!open'
            fill-rule='evenodd'
            d='M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM9 15a1 1 0 011-1h6a1 1 0 110 2h-6a1 1 0 01-1-1z'
            clip-rule='evenodd'
          ></path>
          <path
            x-show='open'
            fill-rule='evenodd'
            d='M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z'
            clip-rule='evenodd'
          ></path>
        </svg>
      </button>
    </div>

    <!-- Navbar -->
    <nav
      x-show='open || isDesktop'
      class='fixed inset-0 z-40 md:relative md:inset-auto md:flex md:items-center'
    >
      <!-- Mobile menu backdrop -->
      <div
        x-show='open'
        x-transition:enter='transition-opacity ease-linear duration-300'
        x-transition:enter-start='opacity-0'
        x-transition:enter-end='opacity-100'
        x-transition:leave='transition-opacity ease-linear duration-300'
        x-transition:leave-start='opacity-100'
        x-transition:leave-end='opacity-0'
        class='fixed inset-0 md:hidden'
      ></div>

      <!-- Mobile menu container -->
      <div
        x-show='open || isDesktop'
        x-transition:enter='transition ease-out duration-200 transform'
        x-transition:enter-start='translate-y-[-100%]'
        x-transition:enter-end='translate-y-0'
        x-transition:leave='transition ease-in duration-200 transform'
        x-transition:leave-start='translate-y-0'
        x-transition:leave-end='translate-y-[-100%]'
        class='fixed inset-x-0 top-[64px] p-4 transform-gpu overflow-y-auto bg-gray-900 md:static md:p-0 md:flex md:space-x-4 md:items-center md:justify-end md:bg-transparent md:overflow-visible'
      >
        {{#if (roles user.role 'user')}}
          <!-- Menu untuk user yang login -->
          <a
            href='/dashboard'
            @click="setActive('/dashboard')"
            :class="isActive('/dashboard')
            ? 'bg-white text-gray-900' 
            : 'bg-transparent text-white hover:bg-gray-700 md:hover:bg-gray-200 hover:text-white md:hover:text-gray-900'"
            class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors md:mt-0'
          >{{t 'test.navbar.home'}}</a>

          <a
            href='/dashboard/about'
            @click="setActive('/dashboard/about')"
            :class="isActive('/dashboard/about')
            ? 'bg-white text-gray-900' 
            : 'bg-transparent text-white hover:bg-gray-700 md:hover:bg-gray-200 hover:text-white md:hover:text-gray-900'"
            class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors md:ml-4'
          >{{t 'test.navbar.about'}}</a>

          <!-- Program Dropdown - Mobile & Desktop -->
          <div class='relative md:ml-4'>
            <button
              @click='programOpen = !programOpen'
              @click.away='programOpen = false'
              :class="isProgramActive()
              ? 'bg-white text-gray-900'
              : 'bg-transparent text-white hover:bg-gray-700 md:hover:bg-gray-200 hover:text-white md:hover:text-gray-900'"
              class='flex items-center justify-between w-full px-4 py-2 text-sm font-semibold text-left rounded-lg transition-colors md:w-auto'
            >
              <span>{{t 'test.navbar.program'}}</span>
              <svg
                fill='currentColor'
                viewBox='0 0 20 20'
                :class="{'rotate-180': programOpen, 'rotate-0': !programOpen}"
                class='w-4 h-4 ml-1 transition-transform duration-200'
              >
                <path
                  fill-rule='evenodd'
                  d='M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z'
                  clip-rule='evenodd'
                ></path>
              </svg>
            </button>

            <!-- Mobile Dropdown -->
            <div
              x-show='programOpen'
              x-transition:enter='transition ease-out duration-200'
              x-transition:enter-start='opacity-0 -translate-y-2'
              x-transition:enter-end='opacity-100 translate-y-0'
              class='md:hidden pl-4 mt-2 space-y-2'
            >
              <template x-for='kat in kategori' :key='kat.id'>
                <a
                  :href="'/kategoris/program/' + kat.nama_kategori"
                  @click="setActive('/kategoris/program/' + kat.nama_kategori)"
                  :class="isActive('/kategoris/program/' + kat.nama_kategori) ? 'bg-gray-700' : 'bg-gray-800'"
                  class='flex items-start gap-3 p-3 rounded-lg hover:bg-gray-700 transition-colors'
                >
                  <div
                    class='bg-gradient-to-br from-primary to-secondary text-white rounded-lg p-3 flex-shrink-0'
                  >
                    <img :src='kat.icon' class='w-6 h-6' alt='' />
                  </div>
                  <div class='flex-1'>
                    <p
                      class='font-semibold text-white'
                      x-text='kat.nama_kategori'
                    ></p>
                    <p
                      class='text-xs text-gray-300 mt-0.5'
                                                x-text='truncate(getByLang(kat.deskripsi,lang), 100)'

                    ></p>
                  </div>
                </a>
              </template>
            </div>
            <!-- Desktop Dropdown -->
            <div
              x-show='programOpen'
              @click.away='programOpen = false'
              x-transition:enter='transition ease-out duration-100'
              x-transition:enter-start='transform opacity-0 scale-95'
              x-transition:enter-end='transform opacity-100 scale-100'
              class='hidden md:block absolute right-0 w-full md:max-w-screen-sm md:w-screen mt-2 origin-top-right z-[100]'
            >
              <div class='px-2 pt-2 pb-4 bg-white rounded-md shadow-lg'>
                <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>
                  <template x-for='kat in kategori' :key='kat.id'>
                    <a
                      :href="'/kategoris/program/' + kat.nama_kategori"
                      @click="setActive('/kategoris/program/' + kat.nama_kategori)"
                      :class="isActive('/kategoris/program/' + kat.nama_kategori) ? 'bg-gray-100' : 'bg-transparent'"
                      class='flex items-start rounded-lg p-3 hover:bg-gray-200 transition-colors'
                    >
                      <div
                        class='bg-gradient-to-br from-primary via-secondary to-gray-900 text-white rounded-lg p-3 flex-shrink-0'
                      >
                        <img :src='kat.icon' class='w-6 h-6' alt='' />
                      </div>
                      <div class='ml-3 flex-1'>
                        <p
                          class='font-semibold text-gray-900 font-montserrat'
                          x-text='kat.nama_kategori'
                        ></p>
                        <p
                          class='text-xs text-gray-600 mt-1 font-inter'
                          x-text='truncate(getByLang(kat.deskripsi,lang), 100)'
                        ></p>
                      </div>
                    </a>
                  </template>
                </div>
              </div>
            </div>
          </div>

          <a
            href='/dashboard/portofolio'
            @click="setActive('/dashboard/portofolio')"
            :class="isActive('/dashboard/portofolio') 
            ? 'bg-white text-gray-900' 
            : 'bg-transparent text-white hover:bg-gray-700 md:hover:bg-gray-200 hover:text-white md:hover:text-gray-900'"
            class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors md:ml-4'
          >{{t 'test.navbar.portfolio'}}</a>

          <a
            href='/dashboard/alumni'
            @click="setActive('/dashboard/alumni')"
            :class="isActive('/dashboard/alumni') 
            ? 'bg-white text-gray-900' 
            : 'bg-transparent text-white hover:bg-gray-700 md:hover:bg-gray-200 hover:text-white md:hover:text-gray-900'"
            class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors md:ml-4'
          >{{t 'test.navbar.alumni'}}</a>

          <!-- User Dropdown -->
          <div class='relative'>
            <button
              @click='userOpen = !userOpen'
              :class="isUserActive()
              ? 'bg-white text-gray-900'
              : 'bg-transparent text-white hover:bg-gray-700 md:hover:bg-gray-200 hover:text-white md:hover:text-gray-900'"
              class='flex items-center justify-between w-full px-4 py-2 text-sm font-semibold rounded-lg transition-colors md:w-auto md:ml-4'
            >
              <div class='flex items-center gap-3'>
                <span>{{user.username}}</span>
                <div
                  class='w-7 h-7 rounded-full overflow-hidden border-2 border-gray-600 hover:border-gray-400 transition-colors'
                >
                  {{#if user.profile}}
                    <img
                      src='{{user.profile}}'
                      alt='{{user.username}}'
                      class='w-full h-full object-cover'
                    />
                  {{else}}
                    <div
                      class='w-full h-full bg-gray-600 flex items-center justify-center'
                    >
                      <span class='text-white font-bold text-lg'>{{substring
                          user.username
                          0
                          1
                        }}</span>
                    </div>
                  {{/if}}
                </div>
                <svg
                  fill='currentColor'
                  viewBox='0 0 20 20'
                  :class="{'rotate-180': userOpen, 'rotate-0': !userOpen}"
                  class='w-4 h-4 transition-transform'
                >
                  <path
                    fill-rule='evenodd'
                    d='M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z'
                    clip-rule='evenodd'
                  ></path>
                </svg>
              </div>
            </button>

            <!-- Mobile User Dropdown -->
            <div
              x-show='userOpen'
              @click.away='userOpen = false'
              class='md:hidden pl-4 mt-2 space-y-2'
              x-transition:enter='transition ease-out duration-200'
              x-transition:enter-start='opacity-0 -translate-y-2'
              x-transition:enter-end='opacity-100 translate-y-0'
            >
              <a
                href='/users/profile'
                @click="setActive('/users/profile')"
                :class="isActive('/users/profile') ? 'bg-gray-700' : 'bg-gray-800'"
                class='flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg hover:bg-gray-700 transition-colors'
              >
                <svg
                  class='w-4 h-4'
                  fill='none'
                  stroke='currentColor'
                  viewBox='0 0 24 24'
                ><path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'
                  ></path></svg>
                <span>{{t 'test.navbar.profile'}}</span>
              </a>
              <a
                href='/kelass/kelas_saya/{{user.id}}'
                @click="setActive('/kelass/kelas_saya/{{user.id}}')"
                :class="isActive('/kelass/kelas_saya/{{user.id}}') ? 'bg-gray-700' : 'bg-gray-800'"
                class='flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg hover:bg-gray-700 transition-colors'
              >
                <svg
                  class='w-4 h-4'
                  fill='none'
                  stroke='currentColor'
                  viewBox='0 0 24 24'
                ><path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253'
                  ></path></svg>
                <span>{{t 'test.navbar.myLearning'}}</span>
              </a>
              <a
                href='/portfolios/myportfolio/{{user.id}}'
                @click="setActive('/portfolios/myportfolio/{{user.id}}')"
                :class="isActive('/portfolios/myportfolio/{{user.id}}') ? 'bg-gray-700' : 'bg-gray-800'"
                class='flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg hover:bg-gray-700 transition-colors'
              >
                <svg
                  class='w-4 h-4'
                  fill='none'
                  stroke='currentColor'
                  viewBox='0 0 24 24'
                ><path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
                  ></path></svg>
                <span>{{t 'test.navbar.myPortfolio'}}</span>
              </a>
              <a
                href='/pembayarans/riwayat/{{user.id}}'
                @click="setActive('/pembayarans/riwayat/{{user.id}}')"
                :class="isActive('/pembayarans/riwayat/{{user.id}}') ? 'bg-gray-700' : 'bg-gray-800'"
                class='flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg hover:bg-gray-700 transition-colors'
              >
                <svg
                  class='w-4 h-4'
                  fill='none'
                  stroke='currentColor'
                  viewBox='0 0 24 24'
                ><path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'
                  ></path></svg>
                <span>{{t 'test.navbar.historyPayment'}}</span>
              </a>
              <a
                href='/logout'
                class='flex items-center gap-2 px-4 py-2 text-sm font-semibold text-red-400 rounded-lg bg-gray-800 hover:bg-red-900/20 transition-colors'
              >
                <svg
                  class='w-4 h-4'
                  fill='none'
                  stroke='currentColor'
                  viewBox='0 0 24 24'
                ><path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1'
                  ></path></svg>
                <span>{{t 'test.navbar.logout'}}</span>
              </a>
            </div>

            <!-- Desktop User Dropdown -->
            <div
              x-show='userOpen'
              @click.away='userOpen = false'
              class='hidden md:block absolute right-0 w-48 mt-2 rounded-md shadow-lg z-[100]'
              x-transition:enter='transition ease-out duration-100'
              x-transition:enter-start='transform opacity-0 scale-95'
              x-transition:enter-end='transform opacity-100 scale-100'
            >
              <div class='px-2 py-2 bg-white rounded-md shadow'>
                <a
                  href='/users/profile'
                  @click="setActive('/users/profile')"
                  :class="isActive('/users/profile') ? 'bg-gray-200' : 'hover:bg-gray-200'"
                  class='flex items-center gap-2 px-4 py-2 mt-2 text-sm font-semibold text-gray-900 rounded-lg'
                >
                  <svg
                    class='w-4 h-4'
                    fill='none'
                    stroke='currentColor'
                    viewBox='0 0 24 24'
                  ><path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'
                    ></path></svg>
                  <span>Profile</span>
                </a>
                <a
                  href='/kelass/kelas_saya/{{user.id}}'
                  @click="setActive('/kelass/kelas_saya/{{user.id}}')"
                  :class="isActive('/kelass/kelas_saya/{{user.id}}') ? 'bg-gray-200' : 'hover:bg-gray-200'"
                  class='flex items-center gap-2 px-4 py-2 mt-2 text-sm font-semibold text-gray-900 rounded-lg'
                >
                  <svg
                    class='w-4 h-4'
                    fill='none'
                    stroke='currentColor'
                    viewBox='0 0 24 24'
                  ><path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253'
                    ></path></svg>
                  <span>{{t 'test.navbar.myLearning'}}</span>
                </a>
                <a
                  href='/portfolios/myportfolio/{{user.id}}'
                  @click="setActive('/portfolios/myportfolio/{{user.id}}')"
                  :class="isActive('/portfolios/myportfolio/{{user.id}}') ? 'bg-gray-200' : 'hover:bg-gray-200'"
                  class='flex items-center gap-2 px-4 py-2 mt-2 text-sm font-semibold text-gray-900 rounded-lg'
                >
                  <svg
                    class='w-4 h-4'
                    fill='none'
                    stroke='currentColor'
                    viewBox='0 0 24 24'
                  ><path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
                    ></path></svg>
                  <span>{{t 'test.navbar.myPortfolio'}}</span>
                </a>
                <a
                  href='/pembayarans/riwayat/{{user.id}}'
                  @click="setActive('/pembayarans/riwayat/{{user.id}}')"
                  :class="isActive('/pembayarans/riwayat/{{user.id}}') ? 'bg-gray-200' : 'hover:bg-gray-200'"
                  class='flex items-center gap-2 px-4 py-2 mt-2 text-sm font-semibold text-gray-900 rounded-lg'
                >
                  <svg
                    class='w-4 h-4'
                    fill='none'
                    stroke='currentColor'
                    viewBox='0 0 24 24'
                  ><path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'
                    ></path></svg>
                  <span>{{t 'test.navbar.historyPayment'}}</span>
                </a>
                <a
                  href='/logout'
                  class='flex items-center gap-2 px-4 py-2 mt-2 text-sm font-semibold text-red-400 hover:bg-gray-200 rounded-lg'
                >
                  <svg
                    class='w-4 h-4'
                    fill='none'
                    stroke='currentColor'
                    viewBox='0 0 24 24'
                  ><path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1'
                    ></path></svg>
                  <span>{{t 'test.navbar.logout'}}</span>
                </a>
              </div>
            </div>
          </div>

        {{else}}
          <!-- Guest Navigation -->
          <a
            href='/dashboard'
            @click="setActive('/dashboard')"
            :class="isActive('/dashboard')
            ? 'bg-white text-gray-900' 
            : 'bg-transparent text-white hover:bg-gray-700 md:hover:bg-gray-200 hover:text-white md:hover:text-gray-900'"
            class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors md:mt-0'
          >{{t 'test.navbar.home'}}</a>

          <a
            href='/dashboard/about'
            @click="setActive('/dashboard/about')"
            :class="isActive('/dashboard/about')
            ? 'bg-white text-gray-900' 
            : 'bg-transparent text-white hover:bg-gray-700 md:hover:bg-gray-200 hover:text-white md:hover:text-gray-900'"
            class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors md:ml-4'
          >{{t 'test.navbar.about'}}</a>

          <div class='relative md:ml-4'>
            <button
              @click='programOpen = !programOpen'
              @click.away='programOpen = false'
              :class="isProgramActive()
              ? 'bg-white text-gray-900'
              : 'bg-transparent text-white hover:bg-gray-700 md:hover:bg-gray-200 hover:text-white md:hover:text-gray-900'"
              class='flex items-center justify-between w-full px-4 py-2 text-sm font-semibold text-left rounded-lg transition-colors md:w-auto'
            >
              <span>{{t 'test.navbar.program'}}</span>
              <svg
                fill='currentColor'
                viewBox='0 0 20 20'
                :class="{'rotate-180': programOpen, 'rotate-0': !programOpen}"
                class='w-4 h-4 ml-1 transition-transform duration-200'
              >
                <path
                  fill-rule='evenodd'
                  d='M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z'
                  clip-rule='evenodd'
                ></path>
              </svg>
            </button>

            <!-- Mobile Dropdown -->
            <div
              x-show='programOpen'
              x-transition:enter='transition ease-out duration-200'
              x-transition:enter-start='opacity-0 -translate-y-2'
              x-transition:enter-end='opacity-100 translate-y-0'
              class='md:hidden pl-4 mt-2 space-y-2'
            >
              <template x-for='kat in kategori' :key='kat.id'>
                <a
                  :href="'/kategoris/program/' + kat.nama_kategori"
                  @click="setActive('/kategoris/program/' + kat.nama_kategori)"
                  :class="isActive('/kategoris/program/' + kat.nama_kategori) ? 'bg-gray-700' : 'bg-gray-800'"
                  class='flex items-start gap-3 p-3 rounded-lg hover:bg-gray-700 transition-colors'
                >
                  <div
                    class='bg-white text-gray-900 rounded-lg p-3 flex-shrink-0'
                  >
                    <img :src='kat.icon' class='w-6 h-6' alt='' />
                  </div>
                  <div class='flex-1'>
                    <p
                      class='font-semibold text-white'
                      x-text='kat.nama_kategori'
                    ></p>
                    <p
                      class='text-xs text-gray-300 mt-0.5'
                                                x-text='truncate(getByLang(kat.deskripsi,lang), 100)'

                    ></p>
                  </div>
                </a>
              </template>
            </div>

            <!-- Desktop Dropdown -->
            <div
              x-show='programOpen'
              @click.away='programOpen = false'
              x-transition:enter='transition ease-out duration-100'
              x-transition:enter-start='transform opacity-0 scale-95'
              x-transition:enter-end='transform opacity-100 scale-100'
              class='hidden md:block absolute right-0 w-full md:max-w-screen-sm md:w-screen mt-2 origin-top-right z-[100]'
            >
              <div class='px-2 pt-2 pb-4 bg-white rounded-md shadow-lg'>
                <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>
                  <template x-for='kat in kategori' :key='kat.id'>
                    <a
                      :href="'/kategoris/program/' + kat.nama_kategori"
                      @click="setActive('/kategoris/program/' + kat.nama_kategori)"
                      :class="isActive('/kategoris/program/' + kat.nama_kategori) ? 'bg-gray-100' : 'bg-transparent'"
                      class='flex items-start rounded-lg p-3 hover:bg-gray-200 transition-colors'
                    >
                      <div
                        class='bg-gradient-to-br from-primary via-secondary to-gray-900 text-white rounded-lg p-3 flex-shrink-0'
                      >
                        <img :src='kat.icon' class='w-6 h-6' alt='' />
                      </div>
                      <div class='ml-3 flex-1'>
                        <p
                          class='font-semibold text-gray-900 font-montserrat'
                          x-text='kat.nama_kategori'
                        ></p>
                        <p
                          class='text-xs text-gray-600 mt-1 font-inter'
                          x-text='truncate(getByLang(kat.deskripsi,lang), 100)'
                        ></p>
                      </div>
                    </a>
                  </template>
                </div>
              </div>
            </div>
          </div>

          <a
            href='/dashboard/portofolio'
            @click="setActive('/dashboard/portofolio')"
            :class="isActive('/dashboard/portofolio')
            ? 'bg-white text-gray-900' 
            : 'bg-transparent text-white hover:bg-gray-700 md:hover:bg-gray-200 hover:text-white md:hover:text-gray-900'"
            class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors md:ml-4'
          >{{t 'test.navbar.portfolio'}}</a>

          <a
            href='/dashboard/alumni'
            @click="setActive('/dashboard/alumni')"
            :class="isActive('/dashboard/alumni')
            ? 'bg-white text-gray-900' 
            : 'bg-transparent text-white hover:bg-gray-700 md:hover:bg-gray-200 hover:text-white md:hover:text-gray-900'"
            class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors md:ml-4'
          >{{t 'test.navbar.alumni'}}</a>

          <a
            href='/login'
            @click="setActive('/login')"
            :class="isActive('/login') 
            ? 'bg-white text-gray-900 border-2 border-white' 
            : 'bg-transparent text-white border-2 border-white hover:bg-gray-100 hover:text-gray-900'"
            class='block px-4 py-2 text-sm font-semibold border-2 border-white hover:text-gray-900 hover:bg-gray-100 rounded-lg transition-colors md:ml-4'
          >{{t 'test.navbar.login'}}</a>



        {{/if}}
                  <!-- Language Selector -->
          <div
            class='relative md:ml-4'
            x-data="{ langOpen: false, currentLang: '{{lang}}' }"
          >
            <button
              @click='langOpen = !langOpen'
              @click.away='langOpen = false'
              class='flex items-center gap-2 px-3 py-2 text-sm font-semibold rounded-lg transition-colors bg-transparent text-white hover:bg-white/10'
            >
              <span
                :class="currentLang === 'id' ? 'fi fi-id' : currentLang === 'en' ? 'fi fi-gb' : 'fi fi-jp'"
                class='text-lg'
              ></span>
              <span x-text='currentLang === "id" ? "ID" : currentLang === "en" ? "EN" : "JP"'></span>
              <svg
                fill='currentColor'
                viewBox='0 0 20 20'
                :class="{'rotate-180': langOpen, 'rotate-0': !langOpen}"
                class='w-4 h-4 transition-transform duration-200'
              >
                <path
                  fill-rule='evenodd'
                  d='M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z'
                  clip-rule='evenodd'
                ></path>
              </svg>
            </button>

            <!-- Dropdown -->
            <div
              x-show='langOpen'
              @click.away='langOpen = false'
              x-transition:enter='transition ease-out duration-100'
              x-transition:enter-start='transform opacity-0 scale-95'
              x-transition:enter-end='transform opacity-100 scale-100'
              class='absolute right-0 w-32 mt-2 rounded-lg shadow-lg z-[100] bg-white overflow-hidden'
            >
              <form
                action='/translation'
                method='post'
                @submit='currentLang = "en"; langOpen = false'
              >
                <input type='text' value='en' name='lang' hidden />
                <button
                  type='submit'
                  class='flex items-center gap-3 w-full px-4 py-3 hover:bg-gray-100 transition-colors text-gray-900'
                >
                  <span class='fi fi-gb'></span>
                  <span class='text-sm font-medium'>EN</span>
                </button>
              </form>

              <form
                action='/translation'
                method='post'
                @submit='currentLang = "id"; langOpen = false'
              >
                <input type='text' value='id' name='lang' hidden />
                <button
                  type='submit'
                  class='flex items-center gap-3 w-full px-4 py-3 hover:bg-gray-100 transition-colors text-gray-900'
                >
                  <span class='fi fi-id'></span>
                  <span class='text-sm font-medium'>ID</span>
                </button>
              </form>

              <form
                action='/translation'
                method='post'
                @submit='currentLang = "ja"; langOpen = false'
              >
                <input type='text' value='ja' name='lang' hidden />
                <button
                  type='submit'
                  class='flex items-center gap-3 w-full px-4 py-3 hover:bg-gray-100 transition-colors text-gray-900'
                >
                  <span class='fi fi-jp'></span>
                  <span class='text-sm font-medium'>JP</span>
                </button>
              </form>
            </div>
          </div>
      </div>
    </nav>
  </div>
</div>