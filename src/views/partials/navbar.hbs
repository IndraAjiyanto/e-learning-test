          class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors whitespace-nowrap'
        >{{t 'test.navbar.portfolio'}}</a> --}}

        {{!-- <a
          href='/dashboard/blog'
          @click="setActive('/dashboard/blog')"
          :class="isActive('/dashboard/blog') 
           ? 'bg-gray-200 text-gray-900' 
          : 'bg-transparent text-gray-900 hover:bg-gray-200 hover:text-gray-900 '"
          class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors whitespace-nowrap'
        >{{t 'test.navbar.blog'}}</a> --}}

        <a
          href='/dashboard/alumni'
          @click="setActive('/dashboard/alumni')"
          :class="isActive('/dashboard/alumni') 
           ? 'bg-gray-200 text-gray-900' 
          : 'bg-transparent text-gray-900 hover:bg-gray-200 hover:text-gray-900 '"
          class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors whitespace-nowrap'
        >{{t 'test.navbar.alumni'}}</a>

        <a
          href='/dashboard/gallery'
          @click="setActive('/dashboard/gallery')"
          :class="isActive('/dashboard/gallery') 
           ? 'bg-gray-200 text-gray-900' 
          : 'bg-transparent text-gray-900 hover:bg-gray-200 hover:text-gray-900 '"
          class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors whitespace-nowrap'
        >{{t 'test.navbar.gallery'}}</a>

        <a
          href='/users/profile'
          :class="isUserActive()
            ? 'bg-gray-200 text-gray-900' 
            : 'bg-transparent text-gray-900 hover:bg-gray-200 hover:text-gray-900 '"
          class='flex items-center gap-3 px-4 py-2 text-sm font-semibold rounded-lg transition-colors'
        >
          <span class='truncate w-20 block'>{{user.username}}</span>
          <div
            class='w-7 h-7 rounded-full overflow-hidden border-2 border-gray-600 hover:border-gray-400 transition-colors'
          >
            {{#if user.profile}}
              <img
                src="{{user.profile}}"
