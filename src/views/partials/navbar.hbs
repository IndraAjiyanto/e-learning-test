                    src='{{user.profile}}'
                    alt='{{user.username}}'
                    class='w-full h-full object-cover'
                  />
                {{else}}
                  <div
                    class='w-full h-full bg-white/20 flex items-center justify-center'
                  >
                    <span class='text-white font-bold text-lg'>{{substring
                        user.username
                        0
                        1
                      }}</span>
                  </div>
                {{/if}}
              </div>
<span class="truncate w-20 block">{{user.username}}</span>
            </div>
            <svg
              fill='currentColor'
              viewBox='0 0 20 20'
              :class="{'rotate-180': userOpen, 'rotate-0': !userOpen}"
              class='w-4 h-4 transition-transform'
            >
              <path
                fill-rule='evenodd'
                d='M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z'
                clip-rule='evenodd'
              ></path>
            </svg>
          </button>

          <div
            x-show='userOpen'
            x-collapse
            class='ml-4 mt-2 space-y-2'
          >
            <a
              href='/users/profile'
              @click="setActive('/users/profile')"
              class='flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-lg hover:bg-white/10 transition-colors text-white/80'
            >
              <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'></path>
              </svg>
              <span>{{t 'test.navbar.profile'}}</span>
            </a>
            <a
              href='/program/myProgram/{{user.id}}'
              @click="setActive('/program/myProgram/{{user.id}}')"
              class='flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-lg hover:bg-white/10 transition-colors text-white/80'
            >
              <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253'></path>
              </svg>
              <span>{{t 'test.navbar.myLearning'}}</span>
            </a>
            <a
              href='/portfolio/myportfolio/{{user.id}}'
              @click="setActive('/portfolio/myportfolio/{{user.id}}')"
              class='flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-lg hover:bg-white/10 transition-colors text-white/80'
            >
              <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'></path>
              </svg>
              <span>{{t 'test.navbar.myPortfolio'}}</span>
            </a>
            <a
              href='/payment/history/{{user.id}}'
              @click="setActive('/payment/history/{{user.id}}')"
              class='flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-lg hover:bg-white/10 transition-colors text-white/80'
            >
              <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'></path>
              </svg>
              <span>{{t 'test.navbar.historyPayment'}}</span>
            </a>
            <a
              href='/logout'
              class='flex items-center gap-3 px-4 py-3 text-sm font-semibold text-red-300 rounded-lg hover:bg-red-500/20 transition-colors'
            >
              <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1'></path>
              </svg>
              <span>{{t 'test.navbar.logout'}}</span>
            </a>
          </div>
        </div>

      {{else}}
        <!-- Non-logged in user menu mobile -->
        <a
          href='/dashboard'
          @click="setActive('/dashboard')"
          :class="isActive('/dashboard') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
          class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
        >{{t 'test.navbar.home'}}</a>

        <a
          href='/dashboard/about'
          @click="setActive('/dashboard/about')"
          :class="isActive('/dashboard/about') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
          class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
        >{{t 'test.navbar.about'}}</a>

        <div class='mx-2'>
          <button
            @click='programOpen = !programOpen'
            :class="isProgramActive() ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
            class='flex items-center justify-between w-full px-4 py-3 text-sm font-semibold rounded-lg transition-colors'
          >
            <span>{{t 'test.navbar.program'}}</span>
            <svg
              fill='currentColor'
              viewBox='0 0 20 20'
              :class="{'rotate-180': programOpen, 'rotate-0': !programOpen}"
              class='w-4 h-4 ml-1 transition-transform duration-200'
            >
              <path
                fill-rule='evenodd'
                d='M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z'
                clip-rule='evenodd'
              ></path>
            </svg>
          </button>

          <div
            x-show='programOpen'
            x-collapse
            class='ml-4 mt-2 space-y-2'
          >
            <template x-for='kat in kategori' :key='kat.id'>
              <a
                :href="'/category/program/' + kat.nama_kategori"
                @click="setActive('/category/program/' + kat.nama_kategori)"
                class='flex items-start rounded-lg p-3 hover:bg-white/10 transition-colors'
              >
                <div
                  class='bg-gradient-to-br from-primary via-secondary to-gray-900 text-white rounded-lg p-2 flex-shrink-0'
                >
                  <img :src='kat.icon' class='w-5 h-5' alt='' />
                </div>
                <div class='flex-1 ml-3'>
                  <p class='font-semibold text-sm' x-text='kat.nama_kategori'></p>
                  <p
                    class='text-xs mt-0.5 text-white/70'
                    x-text='truncate(getByLang(kat.deskripsi,lang), 80)'
                  ></p>
                </div>
              </a>
            </template>
          </div>
        </div>

        <a
          href='/dashboard/portofolio'
          @click="setActive('/dashboard/portofolio')"
          :class="isActive('/dashboard/portofolio') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
          class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
        >{{t 'test.navbar.portfolio'}}</a>

        <a
          href='/dashboard/blog'
          @click="setActive('/dashboard/blog')"
          :class="isActive('/dashboard/blog') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
          class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
        >{{t 'test.navbar.blog'}}</a>

        <a
          href='/dashboard/alumni'
          @click="setActive('/dashboard/alumni')"
          :class="isActive('/dashboard/alumni') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
          class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
        >{{t 'test.navbar.alumni'}}</a>

        <a
          href='/login'
          @click="setActive('/login')"
          class='block mx-2 mt-2 px-4 py-3 text-sm font-semibold text-center bg-white text-secondary rounded-lg hover:bg-white/90 transition-colors'
        >{{t 'test.navbar.login'}}</a>
      {{/if}}

      <!-- Language Selector Mobile -->
      <div class='mx-2 mt-4 border-t border-white/20 pt-4' x-data="{ langOpen: false, currentLang: '{{lang}}' }">
        <button
          @click='langOpen = !langOpen'
          class='flex items-center justify-between w-full px-4 py-3 text-sm font-semibold rounded-lg transition-colors text-white/80 hover:bg-white/10'
        >
          <div class='flex items-center gap-2'>
            <span :class="currentLang === 'id' ? 'fi fi-id' : currentLang === 'en' ? 'fi fi-gb' : 'fi fi-jp'" class='text-lg'></span>
            <span x-text='currentLang === "id" ? "Bahasa Indonesia" : currentLang === "en" ? "English" : "日本語"'></span>
          </div>
          <svg
            fill='currentColor'
            viewBox='0 0 20 20'
            :class="{'rotate-180': langOpen, 'rotate-0': !langOpen}"
            class='w-4 h-4 transition-transform duration-200'
          >
            <path
              fill-rule='evenodd'
              d='M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z'
              clip-rule='evenodd'
            ></path>
          </svg>
        </button>

        <div
          x-show='langOpen'
          x-collapse
          class='ml-4 mt-2 space-y-2'
        >
          <form action='/translation' method='post' @submit='currentLang = "en"; langOpen = false'>
            <input type='text' value='en' name='lang' hidden />
            <button type='submit' class='flex items-center gap-3 w-full px-4 py-3 rounded-lg hover:bg-white/10 transition-colors text-white/80'>
              <span class='fi fi-gb'></span>
              <span class='text-sm font-medium'>English (EN)</span>
            </button>
          </form>

          <form action='/translation' method='post' @submit='currentLang = "id"; langOpen = false'>
            <input type='text' value='id' name='lang' hidden />
            <button type='submit' class='flex items-center gap-3 w-full px-4 py-3 rounded-lg hover:bg-white/10 transition-colors text-white/80'>
              <span class='fi fi-id'></span>
              <span class='text-sm font-medium'>Bahasa Indonesia (ID)</span>
            </button>
          </form>

          <form action='/translation' method='post' @submit='currentLang = "ja"; langOpen = false'>
            <input type='text' value='ja' name='lang' hidden />
            <button type='submit' class='flex items-center gap-3 w-full px-4 py-3 rounded-lg hover:bg-white/10 transition-colors text-white/80'>
              <span class='fi fi-jp'></span>
              <span class='text-sm font-medium'>日本語 (JP)</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</nav>

    <nav
      class='hidden md:flex md:items-center md:space-x-4'
      x-show='isDesktop'
    >
      {{#if (roles user.role 'user')}}
        <a
          href='/dashboard'
          @click="setActive('/dashboard')"
          :class="isActive('/dashboard')
          ? 'bg-white text-gray-900' 
          : 'bg-transparent text-white hover:bg-gray-700 md:hover:bg-gray-200 hover:text-white md:hover:text-gray-900'"
          class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors whitespace-nowrap'
        >{{t 'test.navbar.home'}}</a>

        <a
          href='/dashboard/about'
          @click="setActive('/dashboard/about')"
          :class="isActive('/dashboard/about')
