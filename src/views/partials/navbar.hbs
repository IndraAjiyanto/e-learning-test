<div
  class='w-full bg-[#F5F5F5] shadow-sm fixed top-0 left-0 right-0 z-50 text-white'
  x-data="{
    open: false,
    isDesktop: window.innerWidth >= 768,
    toggleMenu() {
      this.open = !this.open;
      document.body.style.overflow = this.open ? 'hidden' : '';
    },
    closeMenu() {
      this.open = false;
      document.body.style.overflow = '';
    },
    init() {
      window.addEventListener('resize', () => {
        this.isDesktop = window.innerWidth >= 768;
        if (this.isDesktop) {
          this.open = false;
          document.body.style.overflow = '';
        }
      });
    }
  }"
>
  <div
    x-data="{
    open: false,
    programOpen: false,
    lang: '{{lang}}',
    userOpen: false,
    active: '/dashboard',
    category: [],      
      setActive(path) {
        this.active = path;
        this.open = false;
        this.programOpen = false;
        this.userOpen = false;
        
      },
      
      isActive(path) {
        const currentPath = this.active;
        
        if (path === currentPath) {
          return true;
        }
        
        if (path.includes('/category/') && currentPath.includes('/category/')) {
          const pathCategory = path.split('/').pop();
          const currentCategory = currentPath.split('/').pop();
          if (pathCategory === currentCategory) {
            return true;
          }
        }
        
        if (path.includes('/users/profile') && currentPath.includes('/users/profile')) return true;
        if (path.includes('/program/myProgram') && currentPath.includes('/program/myProgram')) return true;
        if (path.includes('/portfolio/myportfolio') && currentPath.includes('/portfolio/myportfolio')) return true;
        if (path.includes('/blog/detail') && currentPath.includes('/blog/detail')) return true;
        if (path.includes('/payment/history') && currentPath.includes('/payment/history')) return true;
        
        return false;
      },

isProgramActive() {
  const currentPath = this.active;

  return (
    currentPath.includes('/category/') ||
    currentPath.includes('/dashboard/category/') ||
    (this.category && this.category.length > 0 && this.category.some(kat =>
      currentPath === `/category/${kat.name}`
    ))
  );
},

    getByLang(obj, lang) {
    if (!obj || typeof obj !== 'object') return '';
    return obj[lang] || obj['id'] || ''; 
  },

  truncate(text, length) {
    if (!text) return '';
    const str = text.toString();
    if (str.length <= length) return str;
    return str.substring(0, length) + '...';
  },

  getIcon(name) {
    if (!name) return 'fas fa-graduation-cap';
    const lowerName = name.toLowerCase();
    if (lowerName.includes('bootcamp')) return 'fas fa-user-graduate';
    if (lowerName.includes('short')) return 'fas fa-chalkboard-teacher';
    if (lowerName.includes('house')) return 'fas fa-users';
    if (lowerName.includes('intern')) return 'fas fa-cube';
    if (lowerName.includes('japan')) return 'fas fa-torii-gate';
    return 'fas fa-graduation-cap';
  },
      
      isUserActive() {
        const currentPath = this.active;
        return currentPath.includes('/users/') || 
               currentPath.includes('/program/myProgram') || 
               currentPath.includes('/portfolio/myportfolio') || 
               currentPath.includes('/blog/detail') ||
               currentPath.includes('/payment/history');
      },
      
      async init() {
        this.active = window.location.pathname;
        
        try {
          const response = await fetch('/dashboard/api/category');
          this.category = await response.json();
        } catch (error) {
        }
        
        window.addEventListener('popstate', () => {
          this.active = window.location.pathname;
        });
        
        document.addEventListener('click', (e) => {
          const link = e.target.closest('a');
          if (link && link.href) {
            const url = new URL(link.href);
            if (url.origin === window.location.origin) {
              setTimeout(() => {
                this.active = window.location.pathname;
              }, 100);
            }
          }
        });
      }
    }"
    class='flex max-w-[1728px] px-5 sm:px-8 lg:px-20 items-center justify-between mx-auto h-14 sm:h-16 w-full relative'
  >
    <div class='flex items-center justify-between w-full md:w-auto h-full'>
      <a
        href='/dashboard'
        class='inline-block flex items-center'
        @click="setActive('/dashboard')"
      >
        <img
          src='/public/image/logo_baru.png'
          alt='Logo'
          class='h-6 sm:h-8 md:h-9 w-auto object-contain focus:outline-none focus:shadow-outline'
        />
      </a>

      <!-- Tombol toggle mobile menu (Dark Navy rounded-[14px] button) -->
      <button
        class='w-9 h-9 sm:w-10 sm:h-10 bg-[#003060] rounded-[12px] md:hidden flex items-center justify-center text-white focus:outline-none shadow-md hover:bg-[#001f3f] transition-all z-50 shrink-0'
        @click='toggleMenu()'
        aria-label="Toggle Navigation Menu"
      >
        <svg fill='currentColor' viewBox='0 0 20 20' class='w-5 h-5'>
          <path
            x-show='!open'
            fill-rule='evenodd'
            d='M3 5a1 1 0 011-1h14a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h14a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h14a1 1 0 110 2H4a1 1 0 01-1-1z'
            clip-rule='evenodd'
          ></path>
          <path
            x-show='open'
            fill-rule='evenodd'
            d='M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z'
            clip-rule='evenodd'
          ></path>
        </svg>
      </button>
    </div>

    <!-- Overlay gelap untuk mobile menu -->
    <div
      x-show='open'
      x-transition:enter='transition-opacity ease-linear duration-300'
      x-transition:enter-start='opacity-0'
      x-transition:enter-end='opacity-100'
      x-transition:leave='transition-opacity ease-linear duration-300'
      x-transition:leave-start='opacity-100'
      x-transition:leave-end='opacity-0'
      class='fixed inset-0 bg-black/50 z-40 md:hidden'
      @click='closeMenu()'
    ></div>

    <nav
      x-show='open'
      x-transition:enter='transition ease-out duration-300 transform'
      x-transition:enter-start='translate-x-full'
      x-transition:enter-end='translate-x-0'
      x-transition:leave='transition ease-in duration-300 transform'
      x-transition:leave-start='translate-x-0'
      x-transition:leave-end='translate-x-full'
      class='fixed top-0 right-0 h-full w-80 bg-gradient-to-br from-primary to-secondary shadow-2xl z-50 overflow-y-auto md:hidden'
      @click.away='closeMenu()'
    >
      <div class='flex flex-col h-full'>
        <!-- Mobile Menu Header -->
        <div
          class='flex items-center justify-between p-4 border-b border-white/20'
        >
          <img
            src='/public/image/logo_kotak_putih.png'
            alt='Logo'
            class='h-8 w-auto'
          />
          <button
            @click='closeMenu()'
            class='p-2 rounded-lg hover:bg-white/10 transition-colors'
          >
            <svg fill='currentColor' viewBox='0 0 20 20' class='w-6 h-6'>
              <path
                fill-rule='evenodd'
                d='M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z'
                clip-rule='evenodd'
              ></path>
            </svg>
          </button>
        </div>

        <!-- Mobile Menu Content -->
        <div class='flex-1 py-4'>
          {{#if isAuthenticated}}
            <a
              href='/dashboard'
              @click="setActive('/dashboard')"
              :class="isActive('/dashboard') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
              class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
            >{{t 'test.navbar.home'}}</a>

            <a
              href='/dashboard/about'
              @click="setActive('/dashboard/about')"
              :class="isActive('/dashboard/about') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
              class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
            >{{t 'test.navbar.about'}}</a>

            <!-- Program Menu Mobile -->
            <div class='mx-2'>
              <button
                @click='programOpen = !programOpen'
                :class="isProgramActive() ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
                class='flex items-center justify-between w-full px-4 py-3 text-sm font-semibold rounded-lg transition-colors'
              >
                <span>{{t 'test.navbar.program'}}</span>
                <svg
                  fill='currentColor'
                  viewBox='0 0 20 20'
                  :class="{'rotate-180': programOpen, 'rotate-0': !programOpen}"
                  class='w-4 h-4 ml-1 transition-transform duration-200'
                >
                  <path
                    fill-rule='evenodd'
                    d='M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z'
                    clip-rule='evenodd'
                  ></path>
                </svg>
              </button>

              <div x-show='programOpen' x-collapse class='ml-4 mt-2 space-y-3'>
                <a
                  href='/dashboard/mpp'
                  @click="setActive('/dashboard/mpp')"
                  class='flex items-start rounded-xl p-3 border border-gray-300 hover:border-white/20 hover:bg-white/5 transition-all duration-300'
                >
                  <div
                    class='w-[56px] h-[56px] bg-[#70B8E8] rounded-full flex items-center justify-center flex-shrink-0 shadow-inner'
                  >
                    <i class='fas fa-gopuram text-white text-lg'></i>
                  </div>
                  <div class='flex-1 ml-3'>
                    <p class='font-bold text-sm text-white text-[20px]'>{{t 'test.navbar.mpp'}}</p>
                    <p class="text-white text-[15px]">Program Kemitraan Pemasaran IT Bootcamp untuk Mahasiswa & Fresh Graduate By Kesatria Academy</p>
                  </div>
                </a>
                <template x-for='kat in category' :key='kat.id'>
                  <a
                    :href="'/category/program/' + kat.name"
                    @click="setActive('/category/program/' + kat.name)"
                    class='flex items-start rounded-xl p-3 border border-transparent hover:border-white/20 hover:bg-white/5 transition-all duration-300'
                  >
                    <div
                      class='w-10 h-10 bg-[#70B8E8] rounded-full flex items-center justify-center flex-shrink-0 shadow-inner'
                    >
                      <i :class="getIcon(kat.name)" class='text-gray-900 text-lg'></i>
                    </div>
                    <div class='flex-1 ml-3'>
                      <p
                        class='font-bold text-sm text-white'
                        x-text='kat.name'
                      ></p>
                      <p
                        class='text-xs mt-1 text-white/70 leading-relaxed'
                        x-text='truncate(getByLang(kat.description,lang), 80)'
                      ></p>
                    </div>
                  </a>
                </template>
              </div>
            </div>

            <a
              href='/dashboard/portofolios'
              @click="setActive('/dashboard/portofolios')"
              :class="isActive('/dashboard/portofolios') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
              class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
            >{{t 'test.navbar.portfolio'}}</a>

            <a
              href='/dashboard/blog'
              @click="setActive('/dashboard/blog')"
              :class="isActive('/dashboard/blog') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
              class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
            >{{t 'test.navbar.blog'}}</a>

            <a
              href='/dashboard/alumni'
              @click="setActive('/dashboard/alumni')"
              :class="isActive('/dashboard/alumni') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
              class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
            >{{t 'test.navbar.alumni'}}</a>

            <!-- User Menu Mobile -->
            <div class='mx-2 mt-2 border-t border-white/20 pt-2'>
              <button
                @click='userOpen = !userOpen'
                class='flex items-center justify-between w-full px-4 py-3 text-sm font-semibold rounded-lg transition-colors text-white/80 hover:bg-white/10'
              >
                <div class='flex items-center gap-3'>
                  <div
                    class='w-8 h-8 rounded-full overflow-hidden border-2 border-white/30'
                  >
                    {{#if user.profile}}
                      <img
                        src="{{user.profile}}"
                        alt='{{user.username}}'
                        class='w-full h-full object-cover'
                      />
                    {{else}}
                      <div
                        class='w-full h-full bg-white/20 flex items-center justify-center'
                      >
                        <span class='text-white font-bold text-lg'>{{substring
                            user.username
                            0
                            1
                          }}</span>
                      </div>
                    {{/if}}
                  </div>
                  <span class='truncate w-20 block'>{{user.username}}</span>
                </div>
                <svg
                  fill='currentColor'
                  viewBox='0 0 20 20'
                  :class="{'rotate-180': userOpen, 'rotate-0': !userOpen}"
                  class='w-4 h-4 transition-transform'
                >
                  <path
                    fill-rule='evenodd'
                    d='M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z'
                    clip-rule='evenodd'
                  ></path>
                </svg>
              </button>

              <div x-show='userOpen' x-collapse class='ml-4 mt-2 space-y-2'>
                <a
                  href='/users/profile'
                  @click="setActive('/users/profile')"
                  class='flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-lg hover:bg-white/10 transition-colors text-white/80'
                >
                  <svg
                    class='w-4 h-4'
                    fill='none'
                    stroke='currentColor'
                    viewBox='0 0 24 24'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'
                    ></path>
                  </svg>
                  <span>{{t 'test.navbar.profile'}}</span>
                </a>
                <a
                  href='/program/myProgram/{{user.id}}'
                  @click="setActive('/program/myProgram/{{user.id}}')"
                  class='flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-lg hover:bg-white/10 transition-colors text-white/80'
                >
                  <svg
                    class='w-4 h-4'
                    fill='none'
                    stroke='currentColor'
                    viewBox='0 0 24 24'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253'
                    ></path>
                  </svg>
                  <span>{{t 'test.navbar.myLearning'}}</span>
                </a>
                <a
                  href='/portfolio/myportfolio/{{user.id}}'
                  @click="setActive('/portfolio/myportfolio/{{user.id}}')"
                  class='flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-lg hover:bg-white/10 transition-colors text-white/80'
                >
                  <svg
                    class='w-4 h-4'
                    fill='none'
                    stroke='currentColor'
                    viewBox='0 0 24 24'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
                    ></path>
                  </svg>
                  <span>{{t 'test.navbar.myPortfolio'}}</span>
                </a>
                <a
                  href='/users/profile?tab=history-payment'
                  @click="setActive('/users/profile')"
                  class='flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-lg hover:bg-white/10 transition-colors text-white/80'
                >
                  <svg
                    class='w-4 h-4'
                    fill='none'
                    stroke='currentColor'
                    viewBox='0 0 24 24'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'
                    ></path>
                  </svg>
                  <span>{{t 'test.navbar.historyPayment'}}</span>
                </a>
                <a
                  href='/logout'
                  class='flex items-center gap-3 px-4 py-3 text-sm font-semibold text-red-300 rounded-lg hover:bg-red-500/20 transition-colors'
                >
                  <svg
                    class='w-4 h-4'
                    fill='none'
                    stroke='currentColor'
                    viewBox='0 0 24 24'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1'
                    ></path>
                  </svg>
                  <span>{{t 'test.navbar.logout'}}</span>
                </a>
              </div>
            </div>

          {{else}}
            <!-- Non-logged in user menu mobile -->
            <a
              href='/dashboard'
              @click="setActive('/dashboard')"
              :class="isActive('/dashboard') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
              class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
            >{{t 'test.navbar.home'}}</a>

            <a
              href='/dashboard/about'
              @click="setActive('/dashboard/about')"
              :class="isActive('/dashboard/about') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
              class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
            >{{t 'test.navbar.about'}}</a>

            <div class='mx-2'>
              <button
                @click='programOpen = !programOpen'
                :class="isProgramActive() ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
                class='flex items-center justify-between w-full px-4 py-3 text-sm font-semibold rounded-lg transition-colors'
              >
                <span>{{t 'test.navbar.program'}}</span>
                <svg
                  fill='currentColor'
                  viewBox='0 0 20 20'
                  :class="{'rotate-180': programOpen, 'rotate-0': !programOpen}"
                  class='w-4 h-4 ml-1 transition-transform duration-200'
                >
                  <path
                    fill-rule='evenodd'
                    d='M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z'
                    clip-rule='evenodd'
                  ></path>
                </svg>
              </button>

              <div x-show='programOpen' x-collapse class='ml-4 mt-2 space-y-3'>
                <a
                  href='/dashboard/mpp'
                  @click="setActive('/dashboard/mpp')"
                  class='flex items-start rounded-xl p-3 border border-gray-300 hover:border-gray-400 hover:bg-white/5 transition-all duration-300'
                >
                  <div
                    class='w-[56px] h-[56px] bg-[#70B8E8] rounded-full flex items-center justify-center flex-shrink-0 shadow-inner'
                  >
                    <i class='fas fa-gopuram text-white text-lg'></i>
                  </div>
                  <div class='flex-1 ml-3'>
                    <p class='font-bold text-sm text-white text-[20px]'>{{t 'test.navbar.mpp'}}</p>

                    <p class="text-white text-[15px]">Program Kemitraan Pemasaran IT Bootcamp untuk Mahasiswa & Fresh Graduate By Kesatria Academy</p>
                  </div>
                </a>
                <template x-for='kat in category' :key='kat.id'>
                  <a
                    :href="'/category/program/' + kat.name"
                    @click="setActive('/category/program/' + kat.name)"
                    class='flex items-start rounded-xl p-3 border border-transparent hover:border-white/20 hover:bg-white/5 transition-all duration-300'
                  >
                    <div
                      class='w-10 h-10 bg-[#70B8E8] rounded-full flex items-center justify-center flex-shrink-0 shadow-inner'
                    >
                      <i :class="getIcon(kat.name)" class='text-gray-900 text-lg'></i>
                    </div>
                    <div class='flex-1 ml-3'>
                      <p
                        class='font-bold text-sm text-white'
                        x-text='kat.name'
                      ></p>
                      <p
                        class='text-xs mt-1 text-white/70 leading-relaxed'
                        x-text='truncate(getByLang(kat.description,lang), 80)'
                      ></p>
                    </div>
                  </a>
                </template>
              </div>
            </div>

            <a
              href='/dashboard/portofolios'
              @click="setActive('/dashboard/portofolios')"
              :class="isActive('/dashboard/portofolios') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
              class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
            >{{t 'test.navbar.portfolio'}}</a>

            <a
              href='/dashboard/blog'
              @click="setActive('/dashboard/blog')"
              :class="isActive('/dashboard/blog') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
              class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
            >{{t 'test.navbar.blog'}}</a>

            <a
              href='/dashboard/alumni'
              @click="setActive('/dashboard/alumni')"
              :class="isActive('/dashboard/alumni') ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10'"
              class='block px-4 py-3 text-sm font-semibold transition-colors mx-2 rounded-lg'
            >{{t 'test.navbar.alumni'}}</a>

            <a
              href='/login'
              @click="setActive('/login')"
              class='block px-4 py-2 text-sm font-semibold rounded-lg transition-colors whitespace-nowrap'
            >{{t 'test.navbar.login'}}</a>
          {{/if}}

          <!-- Language Selector Mobile -->
          <div
            class='mx-2 mt-4 border-t border-white/20 pt-4'
            x-data="{ langOpen: false, currentLang: '{{lang}}' }"
          >
            <button
              @click='langOpen = !langOpen'
              class='flex items-center justify-between w-full px-4 py-3 text-sm font-semibold rounded-lg transition-colors text-white/80 hover:bg-white/10'
            >
              <div class='flex items-center gap-2'>
                <span
                  :class="currentLang === 'id' ? 'fi fi-id' : currentLang === 'en' ? 'fi fi-gb' : 'fi fi-jp'"
                  class='text-lg'
                ></span>
                <span
                  x-text='currentLang === "id" ? "Bahasa Indonesia" : currentLang === "en" ? "English" : "日本語"'
                ></span>
              </div>
              <svg
                fill='currentColor'
                viewBox='0 0 20 20'
                :class="{'rotate-180': langOpen, 'rotate-0': !langOpen}"
                class='w-4 h-4 transition-transform duration-200'
