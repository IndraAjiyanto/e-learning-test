          {{/if}}

          <!-- Language Selector Mobile -->
          <div
            class='mx-2 mt-4 border-t border-white/20 pt-4'
            x-data="{ langOpen: false, currentLang: '{{lang}}' }"
          >
            <button
              @click='langOpen = !langOpen'
              class='flex items-center justify-between w-full px-4 py-3 text-sm font-semibold rounded-lg transition-colors text-white/80 hover:bg-white/10'
            >
              <div class='flex items-center gap-2'>
                <span
                  :class="currentLang === 'id' ? 'fi fi-id' : currentLang === 'en' ? 'fi fi-gb' : 'fi fi-jp'"
                  class='text-lg'
                ></span>
                <span
                  x-text='currentLang === "id" ? "Bahasa Indonesia" : currentLang === "en" ? "English" : "日本語"'
                ></span>
              </div>
              <svg
                fill='currentColor'
                viewBox='0 0 20 20'
                :class="{'rotate-180': langOpen, 'rotate-0': !langOpen}"
                class='w-4 h-4 transition-transform duration-200'
              >
                <path
                  fill-rule='evenodd'
                  d='M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z'
                  clip-rule='evenodd'
                ></path>
              </svg>
            </button>

            <div x-show='langOpen' x-collapse class='ml-4 mt-2 space-y-2'>
              <form
                action='/translation'
                method='post'
                @submit='currentLang = "en"; langOpen = false'
              >
                <input type='text' value='en' name='lang' hidden />
                <button
                  type='submit'
                  class='flex items-center gap-3 w-full px-4 py-3 rounded-lg hover:bg-white/10 transition-colors text-white/80'
                >
                  <span class='fi fi-gb'></span>
                  <span class='text-sm font-medium'>English (EN)</span>
                </button>
              </form>

              <form
                action='/translation'
                method='post'
                @submit='currentLang = "id"; langOpen = false'
              >
                <input type='text' value='id' name='lang' hidden />
                <button
                  type='submit'
                  class='flex items-center gap-3 w-full px-4 py-3 rounded-lg hover:bg-white/10 transition-colors text-white/80'
                >
                  <span class='fi fi-id'></span>
                  <span class='text-sm font-medium'>Bahasa Indonesia (ID)</span>
                </button>
              </form>

              <form
                action='/translation'
                method='post'
                @submit='currentLang = "ja"; langOpen = false'
              >
