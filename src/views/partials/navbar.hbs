    <nav  class='hidden md:flex items-center justify-center space-x-8 h-full'
      x-show='isDesktop'>

        <div class='flex justify-end items-center space-x-4 h-full'>

        <a
          href='/login'
          @click="setActive('/login')"
          :class="isActive('/login') 
          ? 'bg-secondary text-white border-2 border-white' 
          : 'bg-secondary text-white border-2 border-white hover:bg-secondary hover:text-gray-900'"
          class='flex items-center gap-2 block px-4 py-2 text-sm font-semibold rounded-lg transition-colors whitespace-nowrap'
        ><svg
            xmlns='http://w3.org'
            viewBox='0 0 16 16'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='w-3 h-3'
          >
            <!-- Kepala -->
            <circle cx='8' cy='4.5' r='2' />
            <!-- Bahu -->
            <path d='M 2,13.5 A 6,5.5 0 0 1 14,13.5 Z' />
          </svg>
          {{t 'test.navbar.login'}}</a>
      {{/if}}

      <!-- Language Selector Desktop -->
      <div
        class='relative'
        x-data="{ langOpen: false, currentLang: '{{lang}}' }"
      >
        <button
          @click='langOpen = !langOpen'
          @click.away='langOpen = false'
          class='flex items-center gap-2 px-3 py-2 text-sm font-semibold rounded-lg transition-colors border-2 bg-[#F5F5F5] text-gray-900 hover:bg-white/10'
        >
          <span
            :class="currentLang === 'id' ? 'fi fi-id' : currentLang === 'en' ? 'fi fi-gb' : 'fi fi-jp'"
            class='text-lg'
          ></span>
          <span
            x-text='currentLang === "id" ? "ID" : currentLang === "en" ? "EN" : "JP"'
          ></span>
          <svg
            fill='currentColor'
            viewBox='0 0 20 20'
            :class="{'rotate-180': langOpen, 'rotate-0': !langOpen}"
            class='w-4 h-4 transition-transform duration-200'
          >
            <path
              fill-rule='evenodd'
              d='M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z'
              clip-rule='evenodd'
            ></path>
          </svg>
        </button>

        <div
          x-show='langOpen'
          @click.away='langOpen = false'
          x-transition:enter='transition ease-out duration-100'
          x-transition:enter-start='transform opacity-0 scale-95'
          x-transition:enter-end='transform opacity-100 scale-100'
          class='absolute right-0 w-32 mt-2 rounded-lg shadow-lg z-[100] bg-white overflow-hidden'
        >
          <form
            action='/translation'
            method='post'
            @submit='currentLang = "en"; langOpen = false'
          >
            <input type='text' value='en' name='lang' hidden />
            <button
              type='submit'
              class='flex items-center gap-3 w-full px-4 py-3 hover:bg-gray-100 transition-colors text-gray-900'
            >
              <span class='fi fi-gb'></span>
              <span class='text-sm font-medium'>EN</span>
            </button>
          </form>

          <form
            action='/translation'
            method='post'
            @submit='currentLang = "id"; langOpen = false'
          >
            <input type='text' value='id' name='lang' hidden />
            <button
              type='submit'
              class='flex items-center gap-3 w-full px-4 py-3 hover:bg-gray-100 transition-colors text-gray-900'
            >
              <span class='fi fi-id'></span>
              <span class='text-sm font-medium'>ID</span>
            </button>
          </form>

          <form
            action='/translation'
            method='post'
            @submit='currentLang = "ja"; langOpen = false'
          >
            <input type='text' value='ja' name='lang' hidden />
            <button
              type='submit'
              class='flex items-center gap-3 w-full px-4 py-3 hover:bg-gray-100 transition-colors text-gray-900'
            >
              <span class='fi fi-jp'></span>
              <span class='text-sm font-medium'>JP</span>
            </button>
          </form>
        </div>
      </div>
      </nav>
    
  </div>


