<header
  class="fixed inset-x-0 top-0 z-50 border-b-[3px] border-[#F3F4F6] bg-white font-montserrat text-[#4A5568] shadow-[0_0_4px_0_rgba(0,0,0,0.25),0_0_6px_0_rgba(0,0,0,0.1)]"
  x-data="{
    open: false,
    isDesktop: window.innerWidth >= 1024,
    menu: null,
    classOpen: false,
    infoOpen: false,
    lang: '{{lang}}',
    active: '/dashboard',
    category: [],
    setActive(path) {
      this.active = path;
      this.open = false;
      this.menu = null;
      this.classOpen = false;
      this.infoOpen = false;
      document.body.style.overflow = '';
    },
    isActive(path) {
      const cur = this.active;
      if (path === cur) return true;
      if (path.includes('/category/') && cur.includes('/category/')) {
        return path.split('/').pop() === cur.split('/').pop();
      }
      return false;
    },
    isClassActive() {
      return this.active.includes('/category/') || this.active.includes('/dashboard/mpp');
    },
    isInfoActive() {
      return ['/dashboard/about', '/dashboard/alumni', '/dashboard/gallery', '/dashboard/portofolios']
        .some(p => this.active.startsWith(p));
    },
    isUserActive() {
      return this.active.includes('/users/') || this.active.includes('/program/myProgram') ||
        this.active.includes('/portfolio/myportfolio') || this.active.includes('/payment/history');
    },
    getByLang(obj, lang) {
      if (!obj || typeof obj !== 'object') return '';
      return obj[lang] || obj['id'] || '';
    },
    truncate(text, len) {
      if (!text) return '';
      const s = text.toString();
      return s.length <= len ? s : s.slice(0, len) + '...';
    },
    toggleMenu() {
      this.open = !this.open;
      document.body.style.overflow = this.open ? 'hidden' : '';
    },
    async init() {
      this.active = window.location.pathname;
      window.addEventListener('resize', () => {
        this.isDesktop = window.innerWidth >= 1024;
        if (this.isDesktop) { this.open = false; document.body.style.overflow = ''; }
      });
      window.addEventListener('popstate', () => { this.active = window.location.pathname; });
      try {
        const res = await fetch('/dashboard/api/category');
        this.category = await res.json();
      } catch (e) {}
    }
  }"
>
  <div class="page-shell relative flex h-16 items-center justify-between lg:h-[76px]">

    {{!-- Logo --}}
    <a href="/dashboard" @click="setActive('/dashboard')" class="flex shrink-0 items-center">
      <img src="/public/image/logo_baru.png" alt="Kesatria Academy" class="h-7 w-auto object-contain sm:h-8 lg:h-[52px]" />
    </a>

    {{!-- Desktop nav links --}}
    <nav class="hidden items-center gap-8 lg:flex xl:gap-14" x-show="isDesktop">
      <a
        href="/dashboard"
        @click="setActive('/dashboard')"
        :class="isActive('/dashboard') ? 'font-bold text-[#003060]' : 'font-medium text-[#4A5568] hover:text-[#003060]'"
        class="text-sm transition-colors"
      >{{t 'test.navbar.home'}}</a>

      {{!-- Class + Corporate Training + Information share one click-away scope so
           switching between the two dropdowns never triggers a close/open race. --}}
      <div class="contents" @click.away="menu = null">

      {{!-- Class dropdown --}}
      <div class="relative">
        <button
          @click="menu = menu === 'class' ? null : 'class'"
          :class="isClassActive() || menu === 'class' ? 'font-bold text-[#003060]' : 'font-medium text-[#4A5568] hover:text-[#003060]'"
          class="flex items-center gap-1.5 text-sm transition-colors"
        >
          {{t 'test.navbar.class'}}
          <i class="fas fa-chevron-down text-[10px] transition-transform" :class="menu === 'class' && 'rotate-180'"></i>
        </button>
        <div
          x-show="menu === 'class'"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          class="fixed left-1/2 top-[68px] z-[100] w-[min(94vw,1080px)] -translate-x-1/2"
          style="display:none"
        >
          <div class="grid gap-10 rounded-3xl border border-[#E5E7EB] bg-white p-8 shadow-[0_0_4px_0_rgba(0,0,0,0.25)] lg:grid-cols-[300px_1fr] lg:gap-12 lg:p-12">
            <div class="flex flex-col gap-4">
              <div class="flex items-center gap-3">
                <svg viewBox="0 0 24 24" fill="none" stroke="#003060" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-8 shrink-0"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                <span class="font-inter text-[28px] font-extrabold leading-tight text-[#003060]">{{t 'test.navbar.class'}}</span>
              </div>
              <p class="font-inter text-sm leading-relaxed text-[#1F2937]">{{t 'test.navbar.classMenuIntro'}}</p>
            </div>
            <div class="grid gap-x-6 gap-y-5 sm:grid-cols-2">
              <div class="flex flex-col gap-5">
                {{#each category}}
                  {{#if (check @index 3)}}
                    {{> components/ui/nav/dropdown_row/index
                        href=(concat '/category/program/' name)
                        icon=(lookup (array 'rocket' 'zap' 'building') @index)
                        title=name
                        desc=(getByLang text ../lang)
                        last=@last }}
                  {{/if}}
                {{/each}}
              </div>
              <div class="flex flex-col gap-5">
                {{#each category}}
                  {{#unless (check @index 3)}}
                    {{> components/ui/nav/dropdown_row/index
                        href=(concat '/category/program/' name)
                        icon="globe"
                        title=name
                        desc=(getByLang text ../lang)
                        last=true }}
                  {{/unless}}
                {{/each}}
                <div class="flex flex-col gap-4 rounded-xl bg-[#1E3E8F] p-5 pt-5">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
                  <div class="flex flex-col gap-2">
                    <p class="font-inter text-base font-bold leading-snug text-white">{{t 'test.navbar.classCtaTitle'}}</p>
                    <p class="font-inter text-[11px] leading-relaxed text-white/70">{{t 'test.navbar.classCtaDesc'}}</p>
                  </div>
                  <a href="{{#if social.length}}https://wa.me/{{social.[0].number}}{{else}}#{{/if}}" target="_blank" rel="noopener" class="rounded-md bg-white py-2.5 text-center font-inter text-xs font-bold text-[#1E3E8F] transition hover:bg-white/90">{{t 'test.navbar.classCtaButton'}}</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <a
        href="/dashboard/corporate-training"
        @click="setActive('/dashboard/corporate-training')"
        :class="isActive('/dashboard/corporate-training') ? 'font-bold text-[#003060]' : 'font-medium text-[#4A5568] hover:text-[#003060]'"
        class="whitespace-nowrap text-sm transition-colors"
      >{{t 'test.navbar.corporateTraining'}}</a>

      {{!-- Information dropdown --}}
      <div class="relative">
        <button
          @click="menu = menu === 'info' ? null : 'info'"
          :class="isInfoActive() || menu === 'info' ? 'font-bold text-[#003060]' : 'font-medium text-[#4A5568] hover:text-[#003060]'"
          class="flex items-center gap-1.5 text-sm transition-colors"
        >
          {{t 'test.navbar.information'}}
          <i class="fas fa-chevron-down text-[10px] transition-transform" :class="menu === 'info' && 'rotate-180'"></i>
        </button>
        <div
          x-show="menu === 'info'"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          class="fixed left-1/2 top-[68px] z-[100] w-[min(94vw,1080px)] -translate-x-1/2"
          style="display:none"
        >
          <div class="grid gap-10 rounded-3xl border border-[#E5E7EB] bg-white p-8 shadow-[0_0_4px_0_rgba(0,0,0,0.25)] lg:grid-cols-[300px_1fr] lg:gap-12 lg:p-12">
            <div class="flex flex-col gap-4">
              <div class="flex items-center gap-3">
                <span class="grid size-8 shrink-0 place-items-center rounded-2xl border-2 border-[#003060] font-inter text-base font-bold text-[#003060]">i</span>
                <span class="font-inter text-[28px] font-extrabold leading-tight text-[#003060]">{{t 'test.navbar.information'}}</span>
              </div>
              <p class="font-inter text-sm leading-relaxed text-[#1F2937]">{{t 'test.navbar.infoMenuIntro'}}</p>
            </div>
            <div class="grid gap-x-6 gap-y-5 sm:grid-cols-2">
              <div class="flex flex-col gap-5">
                {{> components/ui/nav/dropdown_row/index href="/dashboard/about"       icon="info"      title=(t 'test.navbar.about')     desc=(t 'test.navbar.infoAboutDesc') }}
                {{> components/ui/nav/dropdown_row/index href="/dashboard/gallery"     icon="image"     title=(t 'test.navbar.gallery')   desc=(t 'test.navbar.infoGalleryDesc') }}
                {{> components/ui/nav/dropdown_row/index href="/dashboard/portofolios" icon="briefcase" title=(t 'test.navbar.portfolio') desc=(t 'test.navbar.infoPortfolioDesc') last=true }}
              </div>
              <div class="flex flex-col gap-5">
                {{> components/ui/nav/dropdown_row/index href="/dashboard/alumni" icon="cap" title=(t 'test.navbar.alumni') desc=(t 'test.navbar.infoAlumniDesc') last=true }}
                {{#unless isAuthenticated}}
                  <div class="flex items-center justify-between gap-4 rounded-2xl border border-[#E2E8F0] bg-[#F8FAFC] p-4">
                    <div class="flex flex-col gap-1">
                      <p class="font-inter text-sm font-bold text-[#003060]">{{t 'test.navbar.infoLoginCtaTitle'}}</p>
                      <p class="font-inter text-xs leading-[1.5] text-[#555A64]">{{t 'test.navbar.infoLoginCtaDesc'}}</p>
                    </div>
                    <a href="/login" @click="setActive('/login')" class="shrink-0 rounded-xl bg-[#003060] px-5 py-2.5 font-inter text-[13px] font-bold text-white transition hover:bg-[#00244a]">{{t 'test.navbar.login'}}</a>
                  </div>
                {{/unless}}
              </div>
            </div>
          </div>
        </div>
      </div>
      </div>{{!-- /click-away scope --}}
    </nav>

    {{!-- Desktop actions --}}
    <div class="hidden items-center gap-4 lg:flex" x-show="isDesktop">
      {{> components/ui/nav/lang_switcher/index }}

      {{#if isAuthenticated}}
        <a
          href="/users/profile"
          :class="isUserActive() ? 'bg-gray-100' : 'hover:bg-gray-100'"
          class="flex items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm font-semibold text-[#1F2937] transition-colors"
        >
          <span class="block w-24 truncate">{{user.username}}</span>
          <span class="grid size-7 shrink-0 place-items-center overflow-hidden rounded-full border-2 border-gray-300 bg-gray-600 text-white">
            {{#if user.profile}}
              <img src="{{user.profile}}" alt="{{user.username}}" class="size-full object-cover" />
            {{else}}
              <span class="text-xs font-bold">{{substring user.username 0 1}}</span>
            {{/if}}
          </span>
        </a>
      {{else}}
        <a
          href="/login"
          @click="setActive('/login')"
          class="inline-flex items-center gap-2 rounded-lg bg-[#003060] px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-[#00244a]"
        >
          <i class="fas fa-user text-xs"></i>
          {{t 'test.navbar.login'}}
        </a>
      {{/if}}
    </div>

    {{!-- Mobile hamburger --}}
    <button
      class="grid size-9 shrink-0 place-items-center rounded-xl bg-[#003060] text-white shadow-md transition hover:bg-[#00244a] lg:hidden"
      @click="toggleMenu()"
      aria-label="Toggle menu"
    >
      <i class="fas text-base" :class="open ? 'fa-xmark' : 'fa-bars'"></i>
    </button>
  </div>

  {{!-- Mobile drawer --}}
  <div x-show="open" x-transition.opacity class="fixed inset-0 z-40 bg-black/50 lg:hidden" style="display:none" @click="toggleMenu()"></div>
  <nav
    x-show="open"
    x-transition:enter="transition ease-out duration-300 transform"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-200 transform"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    class="fixed right-0 top-0 z-50 flex h-full w-80 max-w-[85vw] flex-col overflow-y-auto bg-[#003060] text-white lg:hidden"
    style="display:none"
  >
    <div class="flex items-center justify-between border-b border-white/15 p-4">
      <img src="/public/image/logo_kotak_putih.png" alt="Kesatria Academy" class="h-8 w-auto" />
      <button @click="toggleMenu()" class="grid size-9 place-items-center rounded-lg hover:bg-white/10"><i class="fas fa-xmark text-lg"></i></button>
    </div>

    <div class="flex flex-1 flex-col gap-1 p-3 text-sm font-semibold">
      <a href="/dashboard" @click="setActive('/dashboard')" class="rounded-lg px-4 py-3 hover:bg-white/10">{{t 'test.navbar.home'}}</a>

      <button @click="classOpen = !classOpen" class="flex items-center justify-between rounded-lg px-4 py-3 hover:bg-white/10">
        {{t 'test.navbar.class'}}
        <i class="fas fa-chevron-down text-xs transition-transform" :class="classOpen && 'rotate-180'"></i>
      </button>
      <div x-show="classOpen" x-collapse class="flex flex-col gap-2 py-1 pl-3" style="display:none">
        {{> components/ui/card/category/mpp/index isMobile=true}}
        <template x-for="kat in category" :key="kat.id">
          {{> components/ui/card/category/dynamic/index isMobile=true}}
        </template>
      </div>

      <a href="/dashboard/corporate-training" @click="setActive('/dashboard/corporate-training')" class="rounded-lg px-4 py-3 hover:bg-white/10">{{t 'test.navbar.corporateTraining'}}</a>

      <button @click="infoOpen = !infoOpen" class="flex items-center justify-between rounded-lg px-4 py-3 hover:bg-white/10">
        {{t 'test.navbar.information'}}
        <i class="fas fa-chevron-down text-xs transition-transform" :class="infoOpen && 'rotate-180'"></i>
      </button>
      <div x-show="infoOpen" x-collapse class="flex flex-col py-1 pl-3" style="display:none">
        <a href="/dashboard/about" @click="setActive('/dashboard/about')" class="rounded-lg px-4 py-2.5 text-white/85 hover:bg-white/10">{{t 'test.navbar.about'}}</a>
        <a href="/dashboard/gallery" @click="setActive('/dashboard/gallery')" class="rounded-lg px-4 py-2.5 text-white/85 hover:bg-white/10">{{t 'test.navbar.gallery'}}</a>
        <a href="/dashboard/portofolios" @click="setActive('/dashboard/portofolios')" class="rounded-lg px-4 py-2.5 text-white/85 hover:bg-white/10">{{t 'test.navbar.portfolio'}}</a>
        <a href="/dashboard/alumni" @click="setActive('/dashboard/alumni')" class="rounded-lg px-4 py-2.5 text-white/85 hover:bg-white/10">{{t 'test.navbar.alumni'}}</a>
      </div>

      {{#if isAuthenticated}}
        <a href="/users/profile" class="mt-2 flex items-center gap-3 border-t border-white/15 px-4 pt-4 hover:text-white/80">
          <span class="grid size-8 shrink-0 place-items-center overflow-hidden rounded-full border-2 border-white/30 bg-white/20">
            {{#if user.profile}}<img src="{{user.profile}}" alt="{{user.username}}" class="size-full object-cover" />{{else}}<span class="font-bold">{{substring user.username 0 1}}</span>{{/if}}
          </span>
          <span class="truncate">{{user.username}}</span>
        </a>
      {{else}}
        <a href="/login" @click="setActive('/login')" class="mt-2 rounded-lg bg-white px-4 py-3 text-center font-semibold text-[#003060]">{{t 'test.navbar.login'}}</a>
      {{/if}}

      <div class="mt-4 border-t border-white/15 pt-4">
        {{> components/ui/nav/lang_switcher/index mobile=true }}
      </div>
    </div>
  </nav>
</header>
