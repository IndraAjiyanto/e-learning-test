<div class='flex-1 min-w-0'>
  <!-- Top Bar: Active Filter Chips & Counter -->
  <div class='flex flex-wrap items-center justify-between gap-3 mb-6 p-4 rounded-[8px] bg-[#FFFFFF] border border-[#D9D9D9]'>
    <div class='flex flex-wrap items-center gap-2'>
      <span class='font-inter font-semibold text-[13px] leading-none text-[#003060]'>
        {{t "test.portfolio.activeFilterPrefix"}}
      </span>
      <!-- Category Filter Chip -->
      <span class='inline-flex items-center px-3 py-1 rounded-full font-inter text-[12px] font-medium leading-none bg-[#F3F3F3] text-gray-700 border border-[#D9D9D9]'>
        <span x-text="appliedCategoryName ? appliedCategoryName : '{{t "test.portfolio.allCategory"}}'"></span>
      </span>
      <!-- Class Type Filter Chip -->
      <span class='inline-flex items-center px-3 py-1 rounded-full font-inter text-[12px] font-medium leading-none bg-[#F3F3F3] text-gray-700 border border-[#D9D9D9]'>
        <span x-text="appliedCourseTypeName ? appliedCourseTypeName : '{{t "test.portfolio.allClassesShort"}}'"></span>
      </span>
      <!-- Search Keyword Chip if active -->
      <template x-if="appliedSearch && appliedSearch.trim() !== ''">
        <span class='inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-inter text-[12px] font-medium leading-none bg-[#F3F3F3] text-[#003060] border border-[#D9D9D9]'>
          <span>"</span><span x-text="appliedSearch.trim()"></span><span>"</span>
          <button @click="removeSearchFilter()" class="hover:text-red-500 ml-0.5">
            <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </span>
      </template>
    </div>

    <!-- Results Counter -->
    <div class='text-xs text-[#94A3B8] font-normal'>
      {{t "test.portfolio.showingResults"}} <span class='font-semibold text-gray-700' x-text='portfolioItems.length'>0</span> {{t "test.portfolio.fromResults"}} <span class='font-semibold text-gray-700' x-text='totalItems'>0</span> {{t "test.portfolio.resultsUnit"}}
    </div>
  </div>

  <!-- Loading Skeleton -->
  <div
    x-show='loading'
    class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'
  >
    <template x-for='i in 6' :key='i'>
      <div class='bg-white border border-gray-100 rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.02)] overflow-hidden animate-pulse flex flex-col'>
        <div class='aspect-[16/10] bg-gray-200 w-full'></div>
        <div class='p-5 space-y-3 flex-1 flex flex-col justify-between'>
          <div>
            <div class='flex gap-2 mb-3'>
              <div class='h-5 bg-gray-200 rounded-md w-20'></div>
              <div class='h-5 bg-gray-200 rounded-md w-24'></div>
            </div>
            <div class='h-5 bg-gray-200 rounded w-5/6 mb-2'></div>
            <div class='h-4 bg-gray-200 rounded w-2/3'></div>
          </div>
          <div class='pt-4 border-t border-gray-100 flex items-center gap-3'>
            <div class='size-8 rounded-full bg-gray-200'></div>
            <div class='space-y-1 flex-1'>
              <div class='h-3.5 bg-gray-200 rounded w-24'></div>
              <div class='h-3 bg-gray-200 rounded w-32'></div>
            </div>
          </div>
          <div class='h-9 bg-gray-200 rounded-xl w-full mt-2'></div>
        </div>
      </div>
    </template>
  </div>

  <!-- Portfolio Cards Grid -->
  <div
    x-show='!loading && portfolioItems.length > 0'
    class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'
  >
    <template
      x-for='item in portfolioItems'
      :key='item.id'
    >
      <div class='bg-white rounded-2xl border border-gray-100 shadow-[0_4px_20px_rgba(0,0,0,0.02)] hover:shadow-[0_12px_28px_rgba(0,0,0,0.06)] transition-all duration-300 flex flex-col overflow-hidden group'>
        <!-- Image Mockup / Cover -->
        <div class='relative aspect-[16/10] w-full bg-gray-100 overflow-hidden rounded-t-2xl'>
          <img
            :src='getFirstImage(item)'
            :alt='item.title'
            loading='lazy'
            class='w-full h-full object-cover group-hover:scale-105 transition-transform duration-500'
            onerror="this.src='https://placehold.co/600x400/003060/FFFFFF?text=Kesatria+Portfolio'"
          />
        </div>

        <!-- Card Body -->
        <div class='p-5 flex-1 flex flex-col'>
          <!-- Badges Row -->
          <div class='flex flex-wrap items-center gap-2 mb-3'>
            <!-- Category Badge -->
            <span
              class='inline-flex items-center px-2.5 py-1 text-[11px] font-semibold rounded-md bg-[#EEF2FF] text-[#4F46E5]'
              x-text="getCategoryName(item) || 'General'"
            ></span>
            <!-- Class Type Badge -->
            <span
              class='inline-flex items-center px-2.5 py-1 text-[11px] font-medium rounded-md bg-[#F1F5F9] text-[#64748B]'
              x-text="getJenisKelasName(item) || 'Program'"
            ></span>
          </div>

          <!-- Project Title -->
          <h3
            class='font-bold text-[#0B1F3B] text-base leading-snug mb-4 line-clamp-2 min-h-[44px] group-hover:text-[#003060] transition-colors font-inter'
            x-text="item.title || 'Untitled Project'"
            :title="item.title"
          ></h3>

          <!-- Author Info Row -->
          <div class='flex items-center gap-2.5 pt-3 border-t border-gray-100 mb-4'>
            <div class='size-8 rounded-full bg-[#E2E8F0] text-[#003060] font-bold text-xs flex items-center justify-center overflow-hidden shrink-0 border border-gray-200'>
              <template x-if="item.user && item.user.profile">
                <img :src="item.user.profile" :alt="item.user.username" class="w-full h-full object-cover">
              </template>
              <template x-if="!item.user || !item.user.profile">
                <span x-text="getUserInitial(item)"></span>
              </template>
            </div>
            <div class='min-w-0 flex-1'>
              <p
                class='text-xs font-bold text-[#0B1F3B] truncate leading-tight'
                x-text="item.user ? item.user.username : 'Alumni'"
              ></p>
              <p class='text-[11px] text-[#94A3B8] font-normal truncate leading-tight mt-0.5'>
                {{t "test.portfolio.alumniRole"}}
              </p>
            </div>
          </div>

          <!-- Action Button: Lihat Detail -->
          <div class='mt-auto'>
            <a
              :href="'/dashboard/portfolio/' + item.id"
              class='w-full py-2.5 px-4 bg-white border border-gray-200 hover:border-gray-300 hover:bg-gray-50 active:bg-gray-100 text-[#0B1F3B] text-xs font-semibold rounded-xl text-center transition-all block shadow-none'
            >
              {{t "test.portfolio.detailButton"}}
            </a>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- Reusable UI Component: Empty State -->
  {{> components/ui/empty_state/index
    show='!loading && portfolioItems.length === 0'
    icon='fas fa-search'
    title=(t 'test.portfolio.projectNotFound')
    description=(t 'test.portfolio.tryAdjusting')
    actionText=(t 'test.portfolio.resetAllFilters')
    onAction='resetFilters()'
  }}

  <!-- Reusable UI Component: Pagination -->
  {{> components/ui/pagination/index
    currentPage='currentPage'
    totalPages='totalPages'
    onPageChange='changePage'
  }}
</div>