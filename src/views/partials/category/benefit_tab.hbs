{{!--
  Tab: Benefit — Detail Category (Super Admin)
  Lokasi: src/views/partials/category/benefit_tab.hbs
  Dipanggil dari: super_admin/category/detail.hbs (butuh state `tab` dari tabData())

  Data diambil dari GET /category/benefit/:categoryId (title, description berupa
  array jsonb) lalu disaring & dipaginasi di client lewat clientTable().

  Tombol delete memakai openDeleteModal (table/row_actions), modalnya sudah dipasang
  di detail.hbs.
--}}
{{> components/ui/super_admin/table/client_table }}

<div
  x-show="tab === 'benefit'"
  x-data='benefitData({{json category.id}})'
  x-init='fetchBenefit()'
  class='flex flex-col gap-4'
>
  {{> components/ui/super_admin/table/toolbar
    placeholder='Search benefit...'
    searchLabel='Search benefit'
    createHref=(concat '/benefit_category/formCreate/' category.id)
    createLabel='Add Benefit'
  }}

  {{#> components/ui/super_admin/table/card tableClass='min-w-[820px]'}}
    <colgroup>
      <col class='w-[66px]' />
      <col class='w-[240px]' />
      <col class='w-[88px]' />
      <col />
      <col class='w-[116px]' />
    </colgroup>
    <thead>
      <tr>
        {{> components/ui/super_admin/table/header_cell label='No' }}
        {{> components/ui/super_admin/table/header_cell label='Title' }}
        {{> components/ui/super_admin/table/header_cell label='Icon' }}
        {{> components/ui/super_admin/table/header_cell label='Description' }}
        {{> components/ui/super_admin/table/header_cell label='Action' }}
      </tr>
    </thead>
    <tbody>
      <template x-for='(benefit, index) in rows' :key='benefit.id'>
        <tr class='transition-colors hover:bg-[#fafafa]'>
          {{> components/ui/super_admin/table/cell
            text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
          }}

          {{#> components/ui/super_admin/table/cell}}
            <template x-for='title in benefit.title'>
              <span class='block truncate font-inter text-sm leading-5 text-[#525252]' x-text='title'></span>
            </template>
          {{/components/ui/super_admin/table/cell}}

          {{#> components/ui/super_admin/table/cell}}
            <i :class='computeIcon(benefit.icon)' class='text-lg text-[#525252]' aria-hidden='true'></i>
          {{/components/ui/super_admin/table/cell}}

          {{#> components/ui/super_admin/table/cell}}
            <template x-for='description in benefit.description'>
              <span class='block truncate font-inter text-sm leading-5 text-[#525252]' x-text='description'></span>
            </template>
          {{/components/ui/super_admin/table/cell}}

          {{#> components/ui/super_admin/table/cell variant='action'}}
            {{> components/ui/super_admin/table/row_actions
              entity='benefit'
              editHref="'/benefit_category/formEdit/' + benefit.id"
              deleteAction="'/benefit_category/' + benefit.id + '/' + categoryId + '?_method=DELETE'"
            }}
          {{/components/ui/super_admin/table/cell}}
        </tr>
      </template>

      {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='5'}}
        <span x-text='searchInput ? "No benefit found." : "No benefit yet."'></span>
      {{/components/ui/super_admin/table/message_row}}
    </tbody>
  {{/components/ui/super_admin/table/card}}
</div>

<script>
  function benefitData(categoryId) {
    // Method ditempel ke objek clientTable, bukan di-spread: spread mengevaluasi
    // getter rows/totalPages sekali dan mematikan reaktivitasnya.
    const state = clientTable({
      searchKeys: ['title', 'description'],
    });

    state.categoryId = categoryId;

    state.computeIcon = (iconValue) => {
      const raw = (iconValue || '').toString().trim();
      if (!raw) return 'fa-solid fa-circle-question';
      if (/^fa-/.test(raw)) return 'fa-solid ' + raw;
      return raw;
    };

    state.fetchBenefit = async function () {
      try {
        const res = await fetch(`/category/benefit/${categoryId}`);
        if (!res.ok) throw new Error('Failed fetch benefit');
        this.items = await res.json();
        localStorage.setItem('activeData', JSON.stringify(this.items));
      } catch (error) {
        console.error('Error fetching benefit:', error);
        this.items = [];
      }
      this.applySearch(this.searchInput);
    };

    return state;
  }
</script>
