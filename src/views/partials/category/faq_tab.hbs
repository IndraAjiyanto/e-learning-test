{{!--
  Tab: FAQ — Detail Category (Super Admin)
  Lokasi: src/views/partials/category/faq_tab.hbs
  Dipanggil dari: super_admin/category/detail.hbs (butuh state `tab` dari tabData())

  Data diambil dari GET /category/faq/:categoryId (question, answer berupa objek
  {id, en, ja}) lalu disaring & dipaginasi di client lewat clientTable().

  Tombol delete memakai openDeleteModal (table/row_actions), modalnya sudah dipasang
  di detail.hbs.
--}}
{{> components/ui/super_admin/table/client_table }}

<div
  x-show="tab === 'faq'"
  x-data='faqData({{json category.id}})'
  x-init='fetchFaq()'
  class='flex flex-col gap-4'
>
  {{> components/ui/super_admin/table/toolbar
    placeholder='Search FAQ...'
    searchLabel='Search FAQ'
    createHref=(concat '/question-general/formCreate/' category.id)
    createLabel='Add FAQ'
  }}

  {{#> components/ui/super_admin/table/card tableClass='min-w-[820px]'}}
    <colgroup>
      <col class='w-[66px]' />
      <col />
      <col />
      <col class='w-[116px]' />
    </colgroup>
    <thead>
      <tr>
        {{> components/ui/super_admin/table/header_cell label='No' }}
        {{> components/ui/super_admin/table/header_cell label='Question' }}
        {{> components/ui/super_admin/table/header_cell label='Answer' }}
        {{> components/ui/super_admin/table/header_cell label='Action' }}
      </tr>
    </thead>
    <tbody>
      <template x-for='(faq, index) in rows' :key='faq.id'>
        <tr class='transition-colors hover:bg-[#fafafa]'>
          {{> components/ui/super_admin/table/cell
            text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
          }}

          {{#> components/ui/super_admin/table/cell}}
            <template x-for='lang in langs'>
              <span class='block truncate font-inter text-sm leading-5 text-[#525252]' x-text='faq.question?.[lang]'></span>
            </template>
          {{/components/ui/super_admin/table/cell}}

          {{#> components/ui/super_admin/table/cell}}
            <template x-for='lang in langs'>
              <span class='block truncate font-inter text-sm leading-5 text-[#525252]' x-text='faq.answer?.[lang]'></span>
            </template>
          {{/components/ui/super_admin/table/cell}}

          {{#> components/ui/super_admin/table/cell variant='action'}}
            {{> components/ui/super_admin/table/row_actions
              entity='FAQ'
              editHref="'/question-general/formEdit/' + faq.id"
              deleteAction="'/question-general/' + faq.id + '/' + categoryId + '?_method=DELETE'"
            }}
          {{/components/ui/super_admin/table/cell}}
        </tr>
      </template>

      {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='4'}}
        <span x-text='searchInput ? "No FAQ found." : "No FAQ yet."'></span>
      {{/components/ui/super_admin/table/message_row}}
    </tbody>
  {{/components/ui/super_admin/table/card}}
</div>

<script>
  function faqData(categoryId) {
    // Method ditempel ke objek clientTable, bukan di-spread: spread mengevaluasi
    // getter rows/totalPages sekali dan mematikan reaktivitasnya.
    const state = clientTable({
      searchKeys: ['question.id', 'question.en', 'question.ja', 'answer.id', 'answer.en', 'answer.ja'],
    });

    state.categoryId = categoryId;
    state.langs = ['id', 'en', 'ja'];

    state.fetchFaq = async function () {
      try {
        const res = await fetch(`/category/faq/${categoryId}`);
        if (!res.ok) throw new Error('Failed fetch FAQ');
        this.items = await res.json();
      } catch (error) {
        console.error('Error fetching FAQ:', error);
        this.items = [];
      }
      this.applySearch(this.searchInput);
    };

    return state;
  }
</script>
