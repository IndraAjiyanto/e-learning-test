{{!--
  Tab: Alumni — Detail Category (Super Admin)
  Lokasi: src/views/partials/category/alumni_tab.hbs
  Dipanggil dari: super_admin/category/detail.hbs (butuh state `tab` dari tabData())

  Data diambil dari GET /category/alumni/:categoryId (name, message, currentPosition
  berupa array jsonb) lalu disaring & dipaginasi di client lewat clientTable().

  Tombol delete memakai openDeleteModal (table/row_actions), modalnya sudah dipasang
  di detail.hbs.
--}}
{{> components/ui/super_admin/table/client_table }}

<div
  x-show="tab === 'alumni'"
  x-data='alumniData({{json category.id}})'
  x-init='fetchAlumni()'
  class='flex flex-col gap-4'
>
  {{> components/ui/super_admin/table/toolbar
    placeholder='Search alumni...'
    searchLabel='Search alumni'
    createHref=(concat '/alumni/category/formCreate/' category.id)
    createLabel='Add Alumni'
  }}

  {{#> components/ui/super_admin/table/card tableClass='min-w-[1010px]'}}
    <colgroup>
      <col class='w-[66px]' />
      <col class='w-[88px]' />
      <col class='w-[160px]' />
      <col />
      <col class='w-[200px]' />
      <col class='w-[160px]' />
      <col class='w-[116px]' />
    </colgroup>
    <thead>
      <tr>
        {{> components/ui/super_admin/table/header_cell label='No' }}
        {{> components/ui/super_admin/table/header_cell label='Profile' }}
        {{> components/ui/super_admin/table/header_cell label='Name' }}
        {{> components/ui/super_admin/table/header_cell label='Message' }}
        {{> components/ui/super_admin/table/header_cell label='Current Position' }}
        {{> components/ui/super_admin/table/header_cell label='Program' }}
        {{> components/ui/super_admin/table/header_cell label='Action' }}
      </tr>
    </thead>
    <tbody>
      <template x-for='(alumni, index) in rows' :key='alumni.id'>
        <tr class='transition-colors hover:bg-[#fafafa]'>
          {{> components/ui/super_admin/table/cell
            text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
          }}

          {{#> components/ui/super_admin/table/cell variant='media'}}
            {{> components/ui/super_admin/table/avatar
              src='alumni.profile'
              name='firstOf(alumni.name)'
            }}
          {{/components/ui/super_admin/table/cell}}

          {{#> components/ui/super_admin/table/cell}}
            <template x-for='name in alumni.name'>
              <span class='block truncate font-inter text-sm leading-5 text-[#525252]' x-text='name'></span>
            </template>
          {{/components/ui/super_admin/table/cell}}

          {{#> components/ui/super_admin/table/cell}}
            <template x-for='message in alumni.message'>
              <span class='block truncate font-inter text-sm leading-5 text-[#525252]' x-text='message'></span>
            </template>
          {{/components/ui/super_admin/table/cell}}

          {{#> components/ui/super_admin/table/cell}}
            <template x-for='position in alumni.currentPosition'>
              <span class='block truncate font-inter text-sm leading-5 text-[#525252]' x-text='position'></span>
            </template>
          {{/components/ui/super_admin/table/cell}}

          {{> components/ui/super_admin/table/cell text='alumni.course?.name || "—"' }}

          {{#> components/ui/super_admin/table/cell variant='action'}}
            {{> components/ui/super_admin/table/row_actions
              entity='alumni'
              editHref="'/alumni/category/formEdit/' + alumni.id"
              deleteAction="'/alumni/category/' + alumni.id + '/' + categoryId + '?_method=DELETE'"
            }}
          {{/components/ui/super_admin/table/cell}}
        </tr>
      </template>

      {{#> components/ui/super_admin/table/message_row show='rows.length === 0' colspan='7'}}
        <span x-text='searchInput ? "No alumni found." : "No alumni yet."'></span>
      {{/components/ui/super_admin/table/message_row}}
    </tbody>
  {{/components/ui/super_admin/table/card}}
</div>

<script>
  function alumniData(categoryId) {
    // Method ditempel ke objek clientTable, bukan di-spread: spread mengevaluasi
    // getter rows/totalPages sekali dan mematikan reaktivitasnya.
    const state = clientTable({
      searchKeys: ['name', 'message', 'currentPosition', 'course.name'],
    });

    state.categoryId = categoryId;

    state.firstOf = (value) => (Array.isArray(value) ? value[0] : value);

    state.fetchAlumni = async function () {
      try {
        const res = await fetch(`/category/alumni/${categoryId}`);
        if (!res.ok) throw new Error('Failed fetch alumni');
        this.items = await res.json();
        localStorage.setItem('activeData', JSON.stringify(this.items));
      } catch (error) {
        console.error('Error fetching alumni:', error);
        this.items = [];
      }
      this.applySearch(this.searchInput);
    };

    return state;
  }
</script>
