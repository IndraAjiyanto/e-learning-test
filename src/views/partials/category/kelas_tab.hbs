              </svg>
            </a>
            <button
              type='button'
              @click.stop='confirmDeleteProgram(kelasItem)'
              class='inline-flex items-center justify-center rounded-lg border border-[#fecaca] bg-white p-1.5 text-[#dc2626] hover:bg-[#fef2f2] transition-colors cursor-pointer'
              title='Delete Program'
              aria-label='Delete Program'
            >
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4'>
                <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
              </svg>
            </button>
            <button
              type='button'
              @click='openDetail(kelasItem)'
              class='inline-flex items-center gap-1.5 rounded-lg border border-[#003060] bg-white px-3 py-1.5 text-xs font-semibold text-[#003060] hover:bg-[#003060] hover:text-white transition-colors cursor-pointer'
            >
              <span>Detail</span>
              <svg class='h-3.5 w-3.5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5l7 7-7 7' />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </template>
  </div>

  {{!-- Empty State --}}
  <div x-show='rows.length === 0' class='rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 py-12 text-center'>
    <svg class='mx-auto h-12 w-12 text-gray-400' fill='none' stroke='currentColor' viewBox='0 0 24 24' aria-hidden='true'>
      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' />
    </svg>
    <h3 class='mt-2 text-sm font-medium text-gray-900' x-text="searchInput || selectedProcess || !isStatusDefault() || selectedMentor ? 'No programs found matching filters' : 'No programs'"></h3>
    <p class='mt-1 text-sm text-gray-500' x-text="searchInput || selectedProcess || !isStatusDefault() || selectedMentor ? 'Try adjusting your search terms or filter criteria' : 'Get started by creating a new program.'"></p>
    <div x-show='selectedProcess || !isStatusDefault() || selectedMentor' class='mt-3'>
      <button
        type='button'
        @click='resetFilters()'
        class='text-xs font-semibold text-[#003060] hover:underline cursor-pointer'
      >
        Clear all filters
      </button>
    </div>
  </div>

  {{!-- Pagination --}}
  {{> components/ui/super_admin/table/pagination }}
</div>

<script>
  function kelasData(categoryId) {
    // Method ditempel ke objek clientTable, bukan di-spread: spread mengevaluasi
    // getter rows/totalPages sekali dan mematikan reaktivitasnya.
    const state = clientTable({
      size: 6,
      searchKeys: ['name', 'courseType.nameClassesType', 'method'],
      entityName: 'programs',
      deleteEntity: 'course',
    });

    state.selectedProcess = '';
    state.selectedStatuses = ['unlaunch', 'launch', 'learning'];
    state.selectedMentor = '';

    state.processOptions = [
      { value: '', label: 'All Status' },
      { value: 'approved', label: 'Approved' },
      { value: 'process', label: 'Pending' },
    ];

    state.statusOptions = [
      { value: 'unlaunch', label: 'Unpublished' },
      { value: 'launch', label: 'Published' },
      { value: 'learning', label: 'Learning in progress' },
      { value: 'done', label: 'Completed' },
    ];

    state.mentorOptions = [
      { value: '', label: 'All Mentor' },
    ];

    state.isStatusDefault = function () {
      if (!this.selectedStatuses || this.selectedStatuses.length !== 3) return false;
      return (
        this.selectedStatuses.includes('unlaunch') &&
        this.selectedStatuses.includes('launch') &&
        this.selectedStatuses.includes('learning')
      );
    };

    state.statusFilterLabel = function () {
      if (!this.selectedStatuses || this.selectedStatuses.length === 0) return 'No Status';
      if (this.selectedStatuses.length === this.statusOptions.length) return 'All Status (4)';
      if (this.isStatusDefault()) return 'Active Programs (3)';
      if (this.selectedStatuses.length === 1) {
        const found = this.statusOptions.find((o) => o.value === this.selectedStatuses[0]);
        return found ? found.label : this.selectedStatuses[0];
      }
      return `${this.selectedStatuses.length} Status Selected`;
    };

    state.toggleStatus = function (val) {
      if (this.selectedStatuses.includes(val)) {
        this.selectedStatuses = this.selectedStatuses.filter((s) => s !== val);
      } else {
        this.selectedStatuses = [...this.selectedStatuses, val];
      }
      this.applyFilter();
    };

    state.toggleAllStatuses = function () {
      if (this.selectedStatuses.length === this.statusOptions.length) {
        this.selectedStatuses = [];
      } else {
        this.selectedStatuses = this.statusOptions.map((o) => o.value);
      }
      this.applyFilter();
    };

    state.resetToDefaultStatuses = function () {
      this.selectedStatuses = ['unlaunch', 'launch', 'learning'];
      this.applyFilter();
    };

    state.getMentorName = function (item) {
      if (!item) return '-';
      if (item.mentorings && item.mentorings.length) {
        const names = item.mentorings
          .map((m) => m.user?.username)
          .filter(Boolean);
        if (names.length) return names.join(', ');
      }
      if (item.mentors && item.mentors.length) {
        const names = item.mentors
          .map((m) => m.name)
          .filter(Boolean);
        if (names.length) return names.join(', ');
      }
      return '-';
    };

    state.getStatusLabel = function (status) {
      const s = status || 'unlaunch';
      switch (s) {
        case 'launch': return 'Published';
        case 'learning': return 'Learning in progress';
        case 'done': return 'Completed';
        default: return 'Unpublished';
      }
    };

    state.getStatusBadgeClass = function (status) {
      const s = status || 'unlaunch';
      switch (s) {
        case 'launch': return 'bg-[#DCFCE7] text-[#15803D]';
        case 'learning': return 'bg-[#DBEAFE] text-[#1D4ED8]';
        case 'done': return 'bg-[#F3E8FF] text-[#7E22CE]';
        default: return 'bg-[#F1F5F9] text-[#475569]';
      }
    };

    state.getStatusDotClass = function (status) {
      const s = status || 'unlaunch';
      switch (s) {
        case 'launch': return 'bg-[#22C55E]';
        case 'learning': return 'bg-[#3B82F6]';
        case 'done': return 'bg-[#A855F7]';
        default: return 'bg-[#94A3B8]';
      }
    };

    state.getStatusTextClass = function (status) {
      const s = status || 'unlaunch';
      switch (s) {
        case 'launch': return 'text-[#15803D]';
        case 'learning': return 'text-[#1D4ED8]';
        case 'done': return 'text-[#7E22CE]';
        default: return 'text-[#475569]';
      }
    };

    state.confirmStatusChange = function (kelasItem, targetStatus) {
      if (!kelasItem) return;
      const configs = {
        launch: {
          title: 'Launch Program?',
          description: `Are you sure you want to launch "${kelasItem.name}"? Program will be visible on the landing page for user registration.`,
          confirmLabel: 'Launch',
        },
        unlaunch: {
          title: 'Rollback to Unlaunch?',
          description: `Are you sure you want to rollback "${kelasItem.name}" to Unlaunch? Program will be hidden from the landing page.`,
          confirmLabel: 'Rollback',
        },
        learning: {
          title: 'Start Learning Phase?',
          description: `Are you sure you want to start learning for "${kelasItem.name}"? Registration on the landing page will be closed and learning sessions will begin.`,
          confirmLabel: 'Start Learning',
        },
        done: {
          title: 'Mark Program as Done?',
          description: `Are you sure you want to mark "${kelasItem.name}" as Done? Participants will have finished learning and portfolios. This is the terminal state.`,
          confirmLabel: 'Mark Done',
        },
      };

      const config = configs[targetStatus] || {
        title: 'Change Program Status?',
        description: `Are you sure you want to change status to "${targetStatus}"?`,
        confirmLabel: 'Confirm',
      };

      openConfirmModal({
        title: config.title,
        description: config.description,
        confirmLabel: config.confirmLabel,
        cancelLabel: 'Cancel',
        onConfirm: () => this.updateStatus(kelasItem, targetStatus),
      });
    };

    state.updateStatus = async function (kelasItem, targetStatus) {
      try {
        const res = await fetch(`/program/${kelasItem.id}/status-json`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ status: targetStatus }),
        });
        const json = await res.json().catch(() => null);

        if (json && json.success) {
          const courseName = kelasItem.name;
          const statusLabel = this.getStatusLabel(json.status);
          window.dispatchEvent(
            new CustomEvent('toast:success', {
              detail: {
                title: 'Status Updated',
                description: courseName
                  ? `Program "${courseName}" status changed to ${statusLabel}.`
                  : `Program status changed to ${statusLabel}.`,
              },
            }),
          );

          // Update item properties locally
          kelasItem.status = json.status;
          kelasItem.launch = json.launch;

          const itemInList = (this.items || []).find((i) => String(i.id) === String(kelasItem.id));
          if (itemInList) {
            itemInList.status = json.status;
            itemInList.launch = json.launch;
          }

          if (json.status === 'done' && (!this.selectedStatuses || !this.selectedStatuses.includes('done'))) {
            this.applyFilter();
          }
        } else {
          window.dispatchEvent(
            new CustomEvent('toast:error', {
              detail: {
                title: 'Failed',
                description: json?.message || 'Failed to update program status',
              },
            }),
          );
        }
      } catch (err) {
        window.dispatchEvent(
          new CustomEvent('toast:error', {
            detail: {
              title: 'Error',
              description: 'Network or server error while updating status',
            },
          }),
        );
      }
    };

    state.applyFilter = function () {
      const needle = String(this.searchInput || '').trim().toLowerCase();

      this.filtered = this.items.filter((row) => {
        // 1. Search keyword
        if (needle) {
          const matchesSearch =
            this.searchKeys.some((path) =>
              this.valueAt(row, path).toLowerCase().includes(needle),
            ) || this.getMentorName(row).toLowerCase().includes(needle);
          if (!matchesSearch) return false;
        }

        // 2. Status (Approval) filter: approved vs pending
        if (this.selectedProcess) {
          if (this.selectedProcess === 'approved') {
            if (row.process !== 'approved') return false;
          } else if (
            this.selectedProcess === 'process' ||
            this.selectedProcess === 'pending'
          ) {
            if (row.process === 'approved') return false;
          }
        }

        // 3. Status Program (Lifecycle) filter
        if (this.selectedStatuses && this.selectedStatuses.length > 0) {
          const rowStatus = row.status || 'unlaunch';
          if (!this.selectedStatuses.includes(rowStatus)) return false;
        } else {
          return false;
        }

        // 4. Mentor filter
        if (this.selectedMentor) {
          const mentorId = String(this.selectedMentor);
          const hasMentor =
            (row.mentorings &&
              row.mentorings.some(
                (m) =>
                  String(m.userId) === mentorId ||
                  String(m.user?.id) === mentorId,
              )) ||
            (row.mentors &&
              row.mentors.some((m) => String(m.id) === mentorId));
          if (!hasMentor) return false;
        }

        return true;
      });

      this.currentPage = 1;
    };

    state.filterProcess = function (val) {
      this.selectedProcess = val || '';
      this.applyFilter();
    };

    state.filterMentor = function (val) {
      this.selectedMentor = val || '';
      this.applyFilter();
    };

    state.resetFilters = function () {
      this.selectedProcess = '';
      this.selectedStatuses = ['unlaunch', 'launch', 'learning'];
      this.selectedMentor = '';
      this.applyFilter();
    };

    state.handleSearch = function () {
      clearTimeout(this.searchTimeout);
      this.searchTimeout = setTimeout(() => {
        this.applyFilter();
      }, 300);
    };

    state.fetchKelas = async function () {
      try {
        const res = await fetch(`/category/admin/program/${categoryId}`);
        if (!res.ok) throw new Error('Failed fetch program');
        this.items = await res.json();
        localStorage.setItem('activeData', JSON.stringify(this.items));

        // Populate mentorOptions from loaded items
        const mentorMap = new Map();
        (this.items || []).forEach((c) => {
          if (Array.isArray(c.mentorings)) {
            c.mentorings.forEach((m) => {
              if (m.user && m.user.id && m.user.username) {
                mentorMap.set(String(m.user.id), m.user.username);
              }
            });
          }
          if (Array.isArray(c.mentors)) {
            c.mentors.forEach((m) => {
              if (m.id && m.name) {
                mentorMap.set(String(m.id), m.name);
              }
            });
          }
        });
        this.mentorOptions = [
          { value: '', label: 'All Mentor' },
          ...Array.from(mentorMap.entries()).map(([value, label]) => ({
            value,
            label,
          })),
        ];
      } catch (error) {
        console.error('Error fetching data:', error);
        this.items = [];
      }
      this.applyFilter();
    };

    state.detailUrl = (item) => `/program/detail/program/admin/${item.id}?categoryId=${categoryId}`;

    state.openDetail = function (item) {
      localStorage.setItem('kelasPrevUrl', window.location.href);
      window.location.href = this.detailUrl(item);
    };

    state.confirmDeleteProgram = function (kelasItem) {
      if (!kelasItem) return;

      openDeleteModal({
        title: 'Delete Program?',
        description: `Are you sure you want to delete program "${kelasItem.name}"? Program data will be permanently deleted.`,
        confirmLabel: 'Delete',
        cancelLabel: 'Cancel',
        onConfirm: async () => {
          await this.executeDeleteProgram(kelasItem.id);
        },
      });
    };

    state.executeDeleteProgram = async function (courseId) {
      try {
        const res = await fetch(`/program/${courseId}/json`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
        });
        const json = await res.json().catch(() => null);

        if (json && json.success) {
          this.selectedIds = this.selectedIds.filter((id) => String(id) !== String(courseId));
          window.dispatchEvent(
            new CustomEvent('toast:success', {
              detail: {
                title: 'Deleted Successfully',
                description: json.message || 'Program has been deleted successfully.',
              },
            }),
          );
          await this.fetchKelas();
        } else {
          window.dispatchEvent(
            new CustomEvent('toast:error', {
              detail: {
                title: 'Failed to Delete',
                description: json?.message || 'Failed to delete program.',
              },
            }),
          );
        }
      } catch (err) {
        window.dispatchEvent(
          new CustomEvent('toast:error', {
            detail: {
              title: 'Error',
              description: 'A network or server error occurred while deleting program.',
            },
          }),
        );
      }
    };

    state.confirmDeleteSelected = function () {
      const count = this.selectedIds.length;
      if (count === 0) return;

      openDeleteModal({
        title: `Delete ${count} Selected Programs?`,
        description: `Are you sure you want to delete ${count} selected programs? This action is permanent and cannot be undone.`,
        confirmLabel: `Delete (${count})`,
        cancelLabel: 'Cancel',
        onConfirm: async () => {
          await this.executeBulkDeletePrograms();
        },
      });
    };

    state.executeBulkDeletePrograms = async function () {
      try {
        const res = await fetch('/program/bulk-delete', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({ ids: this.selectedIds }),
        });
        const json = await res.json().catch(() => null);

        if (json && json.success) {
          this.selectedIds = [];
          window.dispatchEvent(
            new CustomEvent('toast:success', {
              detail: {
                title: 'Deleted Successfully',
                description: json.message || 'Selected programs have been deleted.',
              },
            }),
          );
          await this.fetchKelas();
        } else {
          window.dispatchEvent(
            new CustomEvent('toast:error', {
              detail: {
                title: 'Failed to Delete',
                description: json?.message || 'Failed to delete selected programs.',
              },
            }),
          );
        }
      } catch (err) {
        window.dispatchEvent(
          new CustomEvent('toast:error', {
            detail: {
              title: 'Error',
              description: 'A network or server error occurred while deleting selected programs.',
            },
          }),
        );
      }
    };

    return state;
  }
</script>
