{{!--
  Tab: Program — Detail Category (Super Admin)
  Lokasi: src/views/partials/category/kelas_tab.hbs
  Dipanggil dari: super_admin/category/detail.hbs (butuh state `tab` dari tabData())

  Data diambil dari GET /category/admin/program/:categoryId lalu disaring & dipaginasi
  di client lewat clientTable(), sehingga kontraknya cocok dengan table/toolbar dan
  table/pagination.

  kelasPrevUrl disimpan agar tombol back di admin/course/detail kembali ke halaman ini.
--}}
{{> components/ui/super_admin/table/client_table }}

<div
  x-show="tab === 'course'"
  x-data='kelasData({{json category.id}})'
  x-init='fetchKelas()'
  class='flex flex-col gap-3'
>
  {{!-- Top Row: Search & Actions --}}
  {{> components/ui/super_admin/table/toolbar
    placeholder='Search program...'
    searchLabel='Search program'
    createHref=(concat '/program/formCreate/' category.id)
    createLabel='Add Program'
    fullWidth=false
  }}

  {{!-- Bottom Row: Filters (di bawah search, konsisten dengan halaman Program List) --}}
  <div class='box-border w-full h-fit shrink-0 flex flex-wrap items-center gap-[10px] -mt-1 mb-2'>
    {{!-- Status (Approval) Filter Dropdown: Approved & Pending --}}
    <div class='relative w-full sm:w-[180px] shrink-0' x-data='{ openProcess: false }' @click.outside='openProcess = false'>
      <button
        type='button'
        @click='openProcess = !openProcess'
        class='box-border flex flex-row justify-between items-center px-[16px] py-[10px] w-full h-[42px] bg-[#FFFFFF] border border-[#D9D9D9] rounded-[8px] focus:outline-none transition-colors cursor-pointer text-left shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]'
      >
        <span
          class='flex-1 truncate font-inter text-[14px] leading-[20px] font-normal'
          :class="selectedProcess ? 'text-[#1A202C]' : 'text-[#718096]'"
          x-text="processOptions.find(o => o.value === selectedProcess)?.label || 'All Status'"
        ></span>
        <svg
          class='w-[10px] h-[5px] shrink-0 ml-2 transition-transform duration-200'
          :class="openProcess ? 'rotate-180' : ''"
          viewBox='0 0 10 5'
          fill='none'
          xmlns='http://www.w3.org/2000/svg'
        >
          <path d='M1 1L5 4L9 1' stroke='#718096' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/>
        </svg>
      </button>

      {{!-- Dropdown Menu Options --}}
      <div
        x-show='openProcess'
        x-transition:enter='transition ease-out duration-100'
        x-transition:enter-start='transform opacity-0 scale-95'
        x-transition:enter-end='transform opacity-100 scale-100'
        x-transition:leave='transition ease-in duration-75'
        x-transition:leave-start='transform opacity-100 scale-100'
        x-transition:leave-end='transform opacity-0 scale-95'
        class='absolute left-0 mt-1 w-full bg-white rounded-[8px] border border-[#D9D9D9] shadow-lg py-1 z-50 overflow-hidden'
        style='display: none;'
      >
        <template x-for='option in processOptions' :key='option.value'>
          <button
            type='button'
            @click="filterProcess(option.value); openProcess = false"
            class='w-full px-[16px] py-[10px] text-left font-inter text-[14px] leading-[20px] hover:bg-[#F7FAFC] flex items-center justify-between transition-colors'
            :class="selectedProcess === option.value ? 'bg-[#EDF2F7] text-[#1A202C] font-medium' : 'text-[#4A5568]'"
          >
            <span x-text='option.label'></span>
            <i x-show='selectedProcess === option.value' class='fas fa-check text-xs text-[#2B6CB0]'></i>
          </button>
        </template>
      </div>
    </div>

    {{!-- Status Program (Lifecycle) Filter Checklist Dropdown --}}
    <div class='relative w-full sm:w-[220px] shrink-0' x-data='{ openStatus: false }' @click.outside='openStatus = false'>
      <button
        type='button'
        @click='openStatus = !openStatus'
        class='box-border flex flex-row justify-between items-center px-[16px] py-[10px] w-full h-[42px] bg-[#FFFFFF] border border-[#D9D9D9] rounded-[8px] focus:outline-none transition-colors cursor-pointer text-left shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]'
      >
        <div class='flex items-center gap-1.5 flex-1 min-w-0'>
          <span
            class='truncate font-inter text-[14px] leading-[20px] font-normal text-[#1A202C]'
            x-text='statusFilterLabel()'
          ></span>
        </div>
        <div class='flex items-center gap-1.5 shrink-0 ml-1'>
          <span
            class='px-1.5 py-0.5 text-[11px] font-semibold rounded-full'
            :class="isStatusDefault() ? 'bg-[#F1F5F9] text-[#64748B]' : 'bg-[#EFF6FF] text-[#2563EB]'"
            x-text='selectedStatuses.length'
          ></span>
          <svg
            class='w-[10px] h-[5px] transition-transform duration-200'
            :class="openStatus ? 'rotate-180' : ''"
            viewBox='0 0 10 5'
            fill='none'
            xmlns='http://www.w3.org/2000/svg'
          >
            <path d='M1 1L5 4L9 1' stroke='#718096' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/>
          </svg>
        </div>
      </button>

      {{!-- Dropdown Checklist Menu --}}
      <div
        x-show='openStatus'
        x-cloak
        x-transition:enter='transition ease-out duration-100'
        x-transition:enter-start='transform opacity-0 scale-95'
        x-transition:enter-end='transform opacity-100 scale-100'
        x-transition:leave='transition ease-in duration-75'
        x-transition:leave-start='transform opacity-100 scale-100'
        x-transition:leave-end='transform opacity-0 scale-95'
        class='absolute left-0 mt-1 w-full sm:w-[260px] bg-white rounded-[8px] border border-[#D9D9D9] shadow-lg z-50 overflow-hidden'
        style='display: none;'
      >
        {{!-- Header Action Bar --}}
        <div class='px-3 py-2 border-b border-[#E2E8F0] flex items-center justify-between text-[12px] bg-[#F8FAFC]'>
          <span class='font-medium text-[#475569]'>Filter Status</span>
          <div class='flex items-center gap-1.5 text-[11px]'>
            <button
              type='button'
              @click='resetToDefaultStatuses()'
              class='text-[#2563EB] hover:text-[#1D4ED8] font-medium hover:underline cursor-pointer'
              title='Reset to Unpublished, Published, Learning in progress'
            >
              Default (3)
            </button>
            <span class='text-gray-300'>|</span>
            <button
              type='button'
              @click='toggleAllStatuses()'
              class='text-[#2563EB] hover:text-[#1D4ED8] font-medium hover:underline cursor-pointer'
              x-text="selectedStatuses.length === statusOptions.length ? 'Clear All' : 'Select All'"
            ></button>
          </div>
        </div>

        {{!-- Checklist Options --}}
        <div class='py-1 divide-y divide-[#F8FAFC]'>
          <template x-for='option in statusOptions' :key='option.value'>
            <label
              class='w-full px-3 py-2 hover:bg-[#F8FAFC] flex items-center gap-2.5 cursor-pointer select-none transition-colors'
              :class="selectedStatuses.includes(option.value) ? 'bg-[#F0FDF4]/30' : ''"
            >
              <input
                type='checkbox'
                :value='option.value'
                :checked='selectedStatuses.includes(option.value)'
                @change='toggleStatus(option.value)'
                class='w-4 h-4 rounded border-[#CBD5E1] text-[#2563EB] focus:ring-[#2563EB] cursor-pointer accent-[#2563EB]'
              />
              <div class='flex items-center gap-2 flex-1 min-w-0'>
                <span class='w-2 h-2 rounded-full shrink-0' :class='getStatusDotClass(option.value)'></span>
                <span class='font-inter text-[13px] text-[#1E293B] truncate' x-text='option.label'></span>
              </div>
              <template x-if="option.value === 'done'">
                <span class='text-[10px] font-semibold text-[#7E22CE] bg-[#F3E8FF] px-1.5 py-0.5 rounded shrink-0'>Selesai</span>
              </template>
            </label>
          </template>
        </div>

        {{!-- Tip Footer --}}
        <div class='px-3 py-1.5 bg-[#F8FAFC] border-t border-[#E2E8F0] text-[11px] text-[#64748B] flex items-center gap-1.5'>
          <i class='fas fa-info-circle text-[10px] text-[#94A3B8]'></i>
          <span>Default menyembunyikan <strong>Completed</strong></span>
        </div>
      </div>
    </div>

    {{!-- Mentor Filter Dropdown --}}
    <div class='relative w-full sm:w-[200px] shrink-0' x-data='{ openMentor: false }' @click.outside='openMentor = false'>
      <button
        type='button'
        @click='openMentor = !openMentor'
        class='box-border flex flex-row justify-between items-center px-[16px] py-[10px] w-full h-[42px] bg-[#FFFFFF] border border-[#D9D9D9] rounded-[8px] focus:outline-none transition-colors cursor-pointer text-left shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]'
      >
        <span
          class='flex-1 truncate font-inter text-[14px] leading-[20px] font-normal'
          :class="selectedMentor ? 'text-[#1A202C]' : 'text-[#718096]'"
          x-text="mentorOptions.find(o => o.value === selectedMentor)?.label || 'All Mentor'"
        ></span>
        <svg
          class='w-[10px] h-[5px] shrink-0 ml-2 transition-transform duration-200'
          :class="openMentor ? 'rotate-180' : ''"
          viewBox='0 0 10 5'
          fill='none'
          xmlns='http://www.w3.org/2000/svg'
        >
          <path d='M1 1L5 4L9 1' stroke='#718096' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/>
        </svg>
      </button>

      {{!-- Dropdown Menu Options --}}
      <div
        x-show='openMentor'
        x-transition:enter='transition ease-out duration-100'
        x-transition:enter-start='transform opacity-0 scale-95'
        x-transition:enter-end='transform opacity-100 scale-100'
        x-transition:leave='transition ease-in duration-75'
        x-transition:leave-start='transform opacity-100 scale-100'
        x-transition:leave-end='transform opacity-0 scale-95'
        class='absolute left-0 mt-1 w-full bg-white rounded-[8px] border border-[#D9D9D9] shadow-lg py-1 z-50 overflow-hidden max-h-60 overflow-y-auto'
        style='display: none;'
      >
        <template x-for='option in mentorOptions' :key='option.value'>
          <button
            type='button'
            @click="filterMentor(option.value); openMentor = false"
            class='w-full px-[16px] py-[10px] text-left font-inter text-[14px] leading-[20px] hover:bg-[#F7FAFC] flex items-center justify-between transition-colors'
            :class="selectedMentor === option.value ? 'bg-[#EDF2F7] text-[#1A202C] font-medium' : 'text-[#4A5568]'"
          >
            <span x-text='option.label'></span>
            <i x-show='selectedMentor === option.value' class='fas fa-check text-xs text-[#2B6CB0]'></i>
          </button>
        </template>
      </div>
    </div>

    {{!-- Reset Filters Button --}}
    <button
      type='button'
      x-show='selectedProcess || !isStatusDefault() || selectedMentor'
      x-cloak
      @click='resetFilters()'
      class='h-[42px] px-3.5 flex items-center gap-1.5 text-[13px] text-[#DC2626] bg-white hover:bg-[#FEF2F2] rounded-[8px] border border-[#FCA5A5] transition-colors cursor-pointer font-medium shrink-0 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]'
      title='Reset Filters'
    >
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-3.5 h-3.5'>
        <path d='M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8'/>
        <path d='M3 3v5h5'/>
      </svg>
      <span>Reset Filter</span>
    </button>
  </div>

  {{!-- Program Cards Grid --}}
  <div x-show='rows.length > 0' class='grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3'>
    <template x-for='kelasItem in rows' :key='kelasItem.id'>
      <div
        class='relative flex min-h-[260px] flex-col justify-between gap-5 rounded-xl border border-[#d9d9d9] bg-white p-5 hover:border-[#b0b0b0] transition-colors shadow-[0px_1px_3px_0px_rgba(0,0,0,0.04)]'
        :class="[selectMode && selectedIds.includes(kelasItem.id) ? 'bg-[#FEF2F2]/60 border-[#FCA5A5]' : '', openStatusDropdown ? 'z-30' : 'z-0']"
        x-data='{ openStatusDropdown: false }'
        @click.outside='openStatusDropdown = false'
      >
        {{!-- Checkbox in Select Mode --}}
        <div x-show='selectMode' x-cloak class='absolute top-3 right-3 z-10' style='display: none;'>
          <input
            type='checkbox'
            :value='kelasItem.id'
            x-model='selectedIds'
            @click.stop
            class='h-4 w-4 rounded border-[#d4d4d4] text-[#003060] focus:ring-[#003060] cursor-pointer'
          />
        </div>
        <div class='flex flex-col gap-3.5'>
          <div class='flex items-start justify-between gap-3'>
            <div class='flex flex-col gap-1'>
              <h4
                class='cursor-pointer text-base font-semibold text-[#1f1f1f] hover:text-[#003060] transition-colors line-clamp-2'
                @click='openDetail(kelasItem)'
                x-text='kelasItem.name'
              ></h4>
              <span class='text-xs text-[#595959]' x-text='kelasItem.courseType?.nameClassesType || "Kelas Umum"'></span>
            </div>
            <div class='flex flex-col items-end gap-1 shrink-0'>
              {{!-- Status Approval Badge (Accepted / Pending) --}}
              <template x-if="kelasItem.process === 'approved'">
                <span class='inline-flex items-center gap-1.5 rounded-full bg-[#EBF3FC] px-2.5 py-1 text-xs font-semibold text-[#2B6CB0]'>
                  <span class='h-1.5 w-1.5 rounded-full bg-[#2B6CB0]'></span>
                  Accepted
                </span>
              </template>
              <template x-if="kelasItem.process !== 'approved'">
                <span class='inline-flex items-center gap-1.5 rounded-full bg-[#FEF3C7] px-2.5 py-1 text-xs font-semibold text-[#D97706]'>
                  <span class='h-1.5 w-1.5 rounded-full bg-[#D97706]'></span>
                  Pending
                </span>
              </template>
            </div>
          </div>

          {{!-- Status Program (Dropdown Lifecycle: Unlaunch -> Launch -> Learning -> Done) --}}
          <div class='flex items-center gap-2'>
            {{!-- Program pending (belum approved): read-only badge --}}
            <template x-if="kelasItem.process !== 'approved'">
              <span
                class='inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium'
                :class='getStatusBadgeClass(kelasItem.status)'
              >
                <span class='h-1.5 w-1.5 rounded-full' :class='getStatusDotClass(kelasItem.status)'></span>
                <span :class='getStatusTextClass(kelasItem.status)' x-text='getStatusLabel(kelasItem.status)'></span>
              </span>
            </template>

            {{!-- Jika Status Done (Terminal State): Tampilkan badge terkunci tanpa dropdown --}}
            <template x-if="kelasItem.process === 'approved' && kelasItem.status === 'done'">
              <div class='box-border w-fit shrink-0 h-fit flex flex-row gap-[6px] p-[3px_10px] justify-start items-center rounded-[16px] bg-[#F3E8FF] text-[#7E22CE] border border-[#E9D5FF]'>
                <div class='box-border w-[6px] shrink-0 h-[6px] rounded-full bg-[#A855F7]'></div>
                <span class='text-[12px] font-inter font-medium'>Completed</span>
                <svg class='w-3 h-3 text-[#A855F7] opacity-70 ml-0.5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                  <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z'/>
                </svg>
              </div>
            </template>

            {{!-- Jika Status Belum Done: Tampilkan Dropdown Trigger Button --}}
            <template x-if="kelasItem.process === 'approved' && kelasItem.status !== 'done'">
              <div class='relative'>
                <button
                  type='button'
                  @click.stop='openStatusDropdown = !openStatusDropdown'
                  class='box-border w-fit shrink-0 h-fit flex flex-row gap-[6px] p-[3px_10px] justify-start items-center rounded-[16px] border border-black/5 text-[12px] font-inter font-medium transition-all hover:shadow-sm focus:outline-none cursor-pointer'
                  :class='getStatusBadgeClass(kelasItem.status)'
                  :aria-expanded='openStatusDropdown'
                >
                  <div class='box-border w-[6px] shrink-0 h-[6px] rounded-full' :class='getStatusDotClass(kelasItem.status)'></div>
                  <span :class='getStatusTextClass(kelasItem.status)' x-text='getStatusLabel(kelasItem.status)'></span>
                  <svg class='w-3.5 h-3.5 transition-transform duration-200' :class="openStatusDropdown ? 'rotate-180' : ''" fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                    <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'/>
                  </svg>
                </button>

                {{!-- Floating Dropdown Menu --}}
                <div
                  x-show='openStatusDropdown'
                  x-transition:enter='transition ease-out duration-100'
                  x-transition:enter-start='transform opacity-0 scale-95'
                  x-transition:enter-end='transform opacity-100 scale-100'
                  x-transition:leave='transition ease-in duration-75'
                  x-transition:leave-start='transform opacity-100 scale-100'
                  x-transition:leave-end='transform opacity-0 scale-95'
                  class='absolute left-0 mt-1.5 w-48 rounded-lg bg-white shadow-[0px_4px_16px_rgba(0,0,0,0.12)] border border-[#E5E5E5] py-1 z-50'
                  style='display: none;'
                >
                  <div class='px-3 py-1 text-[10px] font-inter font-semibold text-[#A3A3A3] uppercase tracking-wider border-b border-[#F5F5F5]'>
                    Change Status
                  </div>

                  {{!-- Opsi jika Unlaunch --}}
                  <template x-if="!kelasItem.status || kelasItem.status === 'unlaunch'">
                    <button
                      type='button'
                      @click.stop="openStatusDropdown = false; confirmStatusChange(kelasItem, 'launch')"
                      class='w-full px-3 py-2 text-left text-[12px] font-inter text-[#15803D] hover:bg-[#F0FDF4] flex items-center gap-2 transition-colors cursor-pointer'
                    >
                      <div class='w-2 h-2 rounded-full bg-[#22C55E]'></div>
                      <span>Publish Program</span>
                    </button>
                  </template>

                  {{!-- Opsi jika Launch --}}
                  <template x-if="kelasItem.status === 'launch'">
                    <div>
                      <button
                        type='button'
                        @click.stop="openStatusDropdown = false; confirmStatusChange(kelasItem, 'learning')"
                        class='w-full px-3 py-2 text-left text-[12px] font-inter text-[#1D4ED8] hover:bg-[#EFF6FF] flex items-center gap-2 transition-colors cursor-pointer'
                      >
                        <div class='w-2 h-2 rounded-full bg-[#3B82F6]'></div>
                        <span>Start Learning</span>
                      </button>
                      <button
                        type='button'
                        @click.stop="openStatusDropdown = false; confirmStatusChange(kelasItem, 'unlaunch')"
                        class='w-full px-3 py-2 text-left text-[12px] font-inter text-[#EF4444] hover:bg-[#FEF2F2] flex items-center gap-2 transition-colors cursor-pointer'
                      >
                        <div class='w-2 h-2 rounded-full bg-[#EF4444]'></div>
                        <span>Rollback to Unpublished</span>
                      </button>
                    </div>
                  </template>

                  {{!-- Opsi jika Learning --}}
                  <template x-if="kelasItem.status === 'learning'">
                    <button
                      type='button'
                      @click.stop="openStatusDropdown = false; confirmStatusChange(kelasItem, 'done')"
                      class='w-full px-3 py-2 text-left text-[12px] font-inter text-[#7E22CE] hover:bg-[#FAF5FF] flex items-center gap-2 transition-colors cursor-pointer'
                    >
                      <div class='w-2 h-2 rounded-full bg-[#A855F7]'></div>
                      <span>Mark as Completed</span>
                    </button>
                  </template>
                </div>
              </div>
            </template>
          </div>

          <div class='flex flex-col gap-1.5 text-xs text-[#595959]'>
            <div class='flex items-center gap-2'>
              <svg class='h-4 w-4 text-[#8c8c8c]' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' />
              </svg>
              <span>Mentor: <strong class='text-[#1f1f1f]' x-text='getMentorName(kelasItem)'></strong></span>
            </div>
            <div class='flex items-center gap-2'>
              <svg class='h-4 w-4 text-[#8c8c8c]' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' />
              </svg>
              <span>Method: <strong class='text-[#1f1f1f]' x-text='kelasItem.method || "-"'></strong></span>
            </div>
            <div class='flex items-center gap-2'>
              <svg class='h-4 w-4 text-[#8c8c8c]' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' />
              </svg>
              <span>Price: <strong class='text-[#1f1f1f]' x-text='(kelasItem.checkPaid || (kelasItem.price && Number(kelasItem.price) > 0)) ? "Paid" : "Free"'></strong></span>
            </div>
          </div>
        </div>

        <div class='flex items-center justify-between border-t border-[#f0f0f0] pt-3'>
          <span class='text-xs text-[#8c8c8c]'>
            Quota: <strong class='text-[#1f1f1f]' x-text='kelasItem.quota ?? "-"'></strong>
          </span>
          <div class='flex items-center gap-2'>
            {{!-- Manage Users Button --}}
            <a
              :href="'/program/addUser/' + kelasItem.id"
              x-show="kelasItem.process === 'approved'"
              @click="localStorage.setItem('kelasPrevUrl', window.location.href)"
              class='inline-flex items-center justify-center rounded-lg border border-[#D9D9D9] bg-white p-1.5 text-[#525252] hover:bg-[#F0FDF4] hover:text-[#15803D] hover:border-[#86EFAC] transition-colors cursor-pointer'
              title='Manage Users'
              aria-label='Manage Users'
            >
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 15' class='w-4 h-3 overflow-visible'>
                <path d="M10.97833 10.3c1.01813-0.6636 1.79468-1.63832 2.214-2.779 0.41495-1.13408 0.44726-2.37282 0.092-3.527-0.3591-1.16005-1.08429-2.17258-2.067-2.886-0.99139-0.72042-2.1855-1.1083-3.411-1.108-1.2255-0.0003-2.41961 0.38758-3.411 1.108-0.98271 0.71342-1.7079 1.72595-2.067 2.886-0.35504 1.15387-0.32272 2.39222 0.092 3.526 0.41913 1.14104 1.1957 2.11614 2.214 2.78-1.84215 0.66224-3.42164 1.90087-4.504 3.532-0.11426 0.1661-0.15581 0.37162-0.11504 0.56906 0.04077 0.19744 0.16033 0.36969 0.33104 0.47694 0.35649 0.22762 0.82972 0.12647 1.062-0.227 0.69763-1.0498 1.64541-1.90961 2.758-2.502 1.1206-0.59624 2.37065-0.90772 3.64-0.907 1.2693-0.00031 2.51925 0.31115 3.64 0.907 1.11259 0.59239 2.06037 1.4522 2.758 2.502 0.2376 0.33941 0.70013 0.43192 1.05 0.21 0.16753-0.10525 0.28593-0.27321 0.32877-0.46637 0.04284-0.19315 0.00655-0.39542-0.10077-0.56163-1.0822-1.63151-2.66171-2.8705-4.504-3.533m-7.37-4.677c0-0.815 0.247-1.612 0.708-2.29 0.46551-0.67985 1.1207-1.20775 1.884-1.518 0.76836-0.31217 1.611-0.39383 2.425-0.235 0.81173 0.15632 1.55928 0.54871 2.149 1.128 0.58474 0.57295 0.98457 1.30783 1.148 2.11 0.162 0.8 0.08 1.63-0.239 2.382-0.32012 0.75625-0.85791 1.40022-1.545 1.85-1.66791 1.09272-3.87124 0.87896-5.298-0.514-0.78337-0.76731-1.22672-1.81645-1.231-2.913m20.046 9.246c-0.35304 0.2248-0.82084 0.12823-1.056-0.218-0.69622-1.05128-1.64432-1.91172-2.758-2.503-1.12028-0.59674-2.3707-0.90729-3.64-0.904-0.20188 0.00029-0.3958-0.07871-0.54-0.22-0.14219-0.1397-0.22228-0.33067-0.22228-0.53 0-0.19933 0.08009-0.3903 0.22228-0.53 0.14436-0.14092 0.33826-0.21956 0.54-0.219 0.618 0 1.229-0.135 1.788-0.394 0.55697-0.25823 1.05055-0.63541 1.446-1.105 0.39209-0.46642 0.67529-1.01437 0.829-1.604 0.15288-0.58763 0.17168-1.20212 0.055-1.798-0.1181-0.59747-0.36781-1.16112-0.731-1.65-0.36655-0.49134-0.8362-0.89649-1.376-1.187-1.10113-0.59126-2.40637-0.66914-3.57-0.213-0.28814 0.12218-0.62148 0.05906-0.845-0.16-0.14367-0.14344-0.22305-0.339-0.22-0.542 0.00372-0.20322 0.0908