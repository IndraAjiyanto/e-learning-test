{{!--
  Tab: Program — Detail Category (Super Admin)
  Lokasi: src/views/partials/category/kelas_tab.hbs
  Dipanggil dari: super_admin/category/detail.hbs (butuh state `tab` dari tabData())

  Data diambil dari GET /category/admin/program/:categoryId lalu disaring & dipaginasi
  di client lewat clientTable(), sehingga kontraknya cocok dengan table/toolbar dan
  table/pagination.

  kelasPrevUrl disimpan agar tombol back di admin/course/detail kembali ke halaman ini.
--}}
{{> components/ui/super_admin/table/client_table }}

<div
  x-show="tab === 'course'"
  x-data='kelasData({{json category.id}})'
  x-init='fetchKelas()'
  class='flex flex-col gap-3'
>
  {{!-- Top Row: Search & Actions --}}
  {{> components/ui/super_admin/table/toolbar
    placeholder='Search program...'
    searchLabel='Search program'
    createHref=(concat '/program/formCreate/' category.id)
    createLabel='Add Program'
    hideBulkDelete=true
    fullWidth=false
  }}

  {{!-- Bottom Row: Filters (di bawah search, konsisten dengan halaman Program List) --}}
  <div class='box-border w-full h-fit shrink-0 flex flex-wrap items-center gap-[10px] -mt-1 mb-2'>
    {{!-- Status (Approval) Filter Dropdown: Approved & Pending --}}
    <div class='relative w-full sm:w-[180px] shrink-0' x-data='{ openProcess: false }' @click.outside='openProcess = false'>
      <button
        type='button'
        @click='openProcess = !openProcess'
        class='box-border flex flex-row justify-between items-center px-[16px] py-[10px] w-full h-[42px] bg-[#FFFFFF] border border-[#D9D9D9] rounded-[8px] focus:outline-none transition-colors cursor-pointer text-left shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]'
      >
        <span
          class='flex-1 truncate font-inter text-[14px] leading-[20px] font-normal'
          :class="selectedProcess ? 'text-[#1A202C]' : 'text-[#718096]'"
          x-text="processOptions.find(o => o.value === selectedProcess)?.label || 'All Status'"
        ></span>
        <svg
          class='w-[10px] h-[5px] shrink-0 ml-2 transition-transform duration-200'
          :class="openProcess ? 'rotate-180' : ''"
          viewBox='0 0 10 5'
          fill='none'
          xmlns='http://www.w3.org/2000/svg'
        >
          <path d='M1 1L5 4L9 1' stroke='#718096' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/>
        </svg>
      </button>

      {{!-- Dropdown Menu Options --}}
      <div
        x-show='openProcess'
        x-transition:enter='transition ease-out duration-100'
        x-transition:enter-start='transform opacity-0 scale-95'
        x-transition:enter-end='transform opacity-100 scale-100'
        x-transition:leave='transition ease-in duration-75'
        x-transition:leave-start='transform opacity-100 scale-100'
        x-transition:leave-end='transform opacity-0 scale-95'
        class='absolute left-0 mt-1 w-full bg-white rounded-[8px] border border-[#D9D9D9] shadow-lg py-1 z-50 overflow-hidden'
        style='display: none;'
      >
        <template x-for='option in processOptions' :key='option.value'>
          <button
            type='button'
            @click="filterProcess(option.value); openProcess = false"
            class='w-full px-[16px] py-[10px] text-left font-inter text-[14px] leading-[20px] hover:bg-[#F7FAFC] flex items-center justify-between transition-colors'
            :class="selectedProcess === option.value ? 'bg-[#EDF2F7] text-[#1A202C] font-medium' : 'text-[#4A5568]'"
          >
            <span x-text='option.label'></span>
            <i x-show='selectedProcess === option.value' class='fas fa-check text-xs text-[#2B6CB0]'></i>
          </button>
        </template>
      </div>
    </div>

    {{!-- Status Program (Lifecycle) Filter Dropdown --}}
    <div class='relative w-full sm:w-[210px] shrink-0' x-data='{ openStatus: false }' @click.outside='openStatus = false'>
      <button
        type='button'
        @click='openStatus = !openStatus'
        class='box-border flex flex-row justify-between items-center px-[16px] py-[10px] w-full h-[42px] bg-[#FFFFFF] border border-[#D9D9D9] rounded-[8px] focus:outline-none transition-colors cursor-pointer text-left shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]'
      >
        <span
          class='flex-1 truncate font-inter text-[14px] leading-[20px] font-normal'
          :class="selectedStatus ? 'text-[#1A202C]' : 'text-[#718096]'"
          x-text="statusOptions.find(o => o.value === selectedStatus)?.label || 'All Program Status'"
        ></span>
        <svg
          class='w-[10px] h-[5px] shrink-0 ml-2 transition-transform duration-200'
          :class="openStatus ? 'rotate-180' : ''"
          viewBox='0 0 10 5'
          fill='none'
          xmlns='http://www.w3.org/2000/svg'
        >
          <path d='M1 1L5 4L9 1' stroke='#718096' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/>
        </svg>
      </button>

      {{!-- Dropdown Menu Options --}}
      <div
        x-show='openStatus'
        x-transition:enter='transition ease-out duration-100'
        x-transition:enter-start='transform opacity-0 scale-95'
        x-transition:enter-end='transform opacity-100 scale-100'
        x-transition:leave='transition ease-in duration-75'
        x-transition:leave-start='transform opacity-100 scale-100'
        x-transition:leave-end='transform opacity-0 scale-95'
        class='absolute left-0 mt-1 w-full bg-white rounded-[8px] border border-[#D9D9D9] shadow-lg py-1 z-50 overflow-hidden'
        style='display: none;'
      >
        <template x-for='option in statusOptions' :key='option.value'>
          <button
            type='button'
            @click="filterStatus(option.value); openStatus = false"
            class='w-full px-[16px] py-[10px] text-left font-inter text-[14px] leading-[20px] hover:bg-[#F7FAFC] flex items-center justify-between transition-colors'
            :class="selectedStatus === option.value ? 'bg-[#EDF2F7] text-[#1A202C] font-medium' : 'text-[#4A5568]'"
          >
            <span x-text='option.label'></span>
            <i x-show='selectedStatus === option.value' class='fas fa-check text-xs text-[#2B6CB0]'></i>
          </button>
        </template>
      </div>
    </div>

    {{!-- Mentor Filter Dropdown --}}
    <div class='relative w-full sm:w-[200px] shrink-0' x-data='{ openMentor: false }' @click.outside='openMentor = false'>
      <button
        type='button'
        @click='openMentor = !openMentor'
        class='box-border flex flex-row justify-between items-center px-[16px] py-[10px] w-full h-[42px] bg-[#FFFFFF] border border-[#D9D9D9] rounded-[8px] focus:outline-none transition-colors cursor-pointer text-left shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]'
      >
        <span
          class='flex-1 truncate font-inter text-[14px] leading-[20px] font-normal'
          :class="selectedMentor ? 'text-[#1A202C]' : 'text-[#718096]'"
          x-text="mentorOptions.find(o => o.value === selectedMentor)?.label || 'All Mentor'"
        ></span>
        <svg
          class='w-[10px] h-[5px] shrink-0 ml-2 transition-transform duration-200'
          :class="openMentor ? 'rotate-180' : ''"
          viewBox='0 0 10 5'
          fill='none'
          xmlns='http://www.w3.org/2000/svg'
        >
          <path d='M1 1L5 4L9 1' stroke='#718096' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/>
        </svg>
      </button>

      {{!-- Dropdown Menu Options --}}
      <div
        x-show='openMentor'
        x-transition:enter='transition ease-out duration-100'
        x-transition:enter-start='transform opacity-0 scale-95'
        x-transition:enter-end='transform opacity-100 scale-100'
        x-transition:leave='transition ease-in duration-75'
        x-transition:leave-start='transform opacity-100 scale-100'
        x-transition:leave-end='transform opacity-0 scale-95'
        class='absolute left-0 mt-1 w-full bg-white rounded-[8px] border border-[#D9D9D9] shadow-lg py-1 z-50 overflow-hidden max-h-60 overflow-y-auto'
        style='display: none;'
      >
        <template x-for='option in mentorOptions' :key='option.value'>
          <button
            type='button'
            @click="filterMentor(option.value); openMentor = false"
            class='w-full px-[16px] py-[10px] text-left font-inter text-[14px] leading-[20px] hover:bg-[#F7FAFC] flex items-center justify-between transition-colors'
            :class="selectedMentor === option.value ? 'bg-[#EDF2F7] text-[#1A202C] font-medium' : 'text-[#4A5568]'"
          >
            <span x-text='option.label'></span>
            <i x-show='selectedMentor === option.value' class='fas fa-check text-xs text-[#2B6CB0]'></i>
          </button>
        </template>
      </div>
    </div>

    {{!-- Reset Filters Button --}}
    <button
      type='button'
      x-show='selectedProcess || selectedStatus || selectedMentor'
      x-cloak
      @click='resetFilters()'
      class='h-[42px] px-3.5 flex items-center gap-1.5 text-[13px] text-[#DC2626] bg-white hover:bg-[#FEF2F2] rounded-[8px] border border-[#FCA5A5] transition-colors cursor-pointer font-medium shrink-0 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]'
      title='Reset Filters'
    >
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-3.5 h-3.5'>
        <path d='M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8'/>
        <path d='M3 3v5h5'/>
      </svg>
      <span>Reset Filter</span>
    </button>
  </div>

  {{!-- Program Cards Grid --}}
  <div x-show='rows.length > 0' class='grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3'>
    <template x-for='kelasItem in rows' :key='kelasItem.id'>
      <div class='flex min-h-[260px] flex-col justify-between gap-5 rounded-xl border border-[#d9d9d9] bg-white p-5 hover:border-[#b0b0b0] transition-colors shadow-[0px_1px_3px_0px_rgba(0,0,0,0.04)]'>
        <div class='flex flex-col gap-3.5'>
          {{!-- Header: Image, Title, Course Type --}}
          <div class='flex gap-3'>
            <img
              :src='kelasItem.image'
              :alt='kelasItem.name'
              class='h-12 w-12 shrink-0 overflow-hidden rounded-xl border border-[#e9d7fe] bg-[#f9f5ff] object-cover text-[0px]'
            />
            <div class='flex min-w-0 flex-col'>
              <h4 class='line-clamp-2 font-inter text-sm font-semibold leading-5 text-[#171717]' x-text='kelasItem.name' :title='kelasItem.name'></h4>
              <p class='truncate font-inter text-sm font-medium leading-[22.75px] text-[#737373]' x-text='kelasItem.courseType?.nameClassesType'></p>
            </div>
          </div>

          {{!-- Mentor Information --}}
          <div class='flex items-center gap-1.5 font-inter text-xs text-[#525252] bg-[#F9FAFB] px-2.5 py-1.5 rounded-lg border border-[#F3F4F6]'>
            <svg class='w-3.5 h-3.5 text-[#6B7280] shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
              <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'/>
            </svg>
            <span class='text-[#6B7280] font-normal'>Mentor:</span>
            <span class='font-medium text-[#111827] truncate' x-text='getMentorName(kelasItem)' :title='getMentorName(kelasItem)'></span>
          </div>

          {{!-- Badges: Status (Approval), Status Program (Lifecycle), Method --}}
          <div class='flex flex-wrap items-center gap-1.5'>
            {{!-- Status Badge (Approved / Pending) --}}
            <div
              class='box-border w-fit shrink-0 h-fit flex flex-row gap-[5px] p-[2px_8px] justify-start items-center rounded-[16px]'
              :class="kelasItem.process === 'approved' ? 'bg-[#F0FDF4] text-[#15803D]' : 'bg-[#FEFCE8] text-[#A16207]'"
            >
              <div
                class='w-[6px] h-[6px] rounded-full'
                :class="kelasItem.process === 'approved' ? 'bg-[#22C55E]' : 'bg-[#EAB308]'"
              ></div>
              <span
                class='text-[11px] font-inter font-medium whitespace-nowrap'
                x-text='kelasItem.process === "approved" ? "Approved" : "Pending"'
              ></span>
            </div>

            {{!-- Status Program Badge (Unpublished, Published, Learning in progress, Completed) --}}
            <div
              class='box-border w-fit shrink-0 h-fit flex flex-row gap-[5px] p-[2px_8px] justify-start items-center rounded-[16px]'
              :class="getStatusBadgeClass(kelasItem.status)"
            >
              <div
                class='w-[6px] h-[6px] rounded-full'
                :class="getStatusDotClass(kelasItem.status)"
              ></div>
              <span
                class='text-[11px] font-inter font-medium whitespace-nowrap'
                :class="getStatusTextClass(kelasItem.status)"
                x-text='getStatusLabel(kelasItem.status)'
              ></span>
            </div>

            {{!-- Method Badge --}}
            <span class='inline-flex items-center gap-1 py-0.5 px-2 rounded-[16px] bg-[#F3F4F6] font-inter text-[11px] font-medium text-[#4B5563]'>
              <svg x-show="kelasItem.method === 'online'" xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#333333' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='h-3 w-3'>
                <circle cx='12' cy='12' r='10' />
                <path d='M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20' />
                <path d='M2 12h20' />
              </svg>
              <svg x-show="kelasItem.method !== 'online'" xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#333333' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='h-3 w-3'>
                <rect width='16' height='20' x='4' y='2' rx='2' ry='2' />
                <path d='M9 22v-4h6v4' />
                <path d='M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01' />
              </svg>
              <span x-text="kelasItem.method === 'online' ? 'Online' : ((kelasItem.method === 'hybrid' || kelasItem.method === 'hybird') ? 'Hybrid' : 'Offline')"></span>
            </span>
          </div>
        </div>

        <a
          :href='detailUrl(kelasItem)'
          @click.prevent='openDetail(kelasItem)'
          class='inline-flex h-11 w-full items-center justify-center gap-2 rounded-lg border border-[#d4d4d4] bg-white px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-[#003060] transition-colors hover:border-[#a3a3a3] hover:bg-[#f5f5f5] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40'
        >
          View Details
          {{!-- lucide: move-right --}}
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='h-4 w-4'>
            <path d='M18 8l4 4-4 4' />
            <path d='M2 12h20' />
          </svg>
        </a>
      </div>
    </template>
  </div>

  {{!-- Empty State --}}
  <div x-show='rows.length === 0' class='rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 py-12 text-center'>
    <svg class='mx-auto h-12 w-12 text-gray-400' fill='none' stroke='currentColor' viewBox='0 0 24 24' aria-hidden='true'>
      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' />
    </svg>
    <h3 class='mt-2 text-sm font-medium text-gray-900' x-text="searchInput || selectedProcess || selectedStatus || selectedMentor ? 'No programs found matching filters' : 'No programs'"></h3>
    <p class='mt-1 text-sm text-gray-500' x-text="searchInput || selectedProcess || selectedStatus || selectedMentor ? 'Try adjusting your search terms or filter criteria' : 'Get started by creating a new program.'"></p>
    <div x-show='selectedProcess || selectedStatus || selectedMentor' class='mt-3'>
      <button
        type='button'
        @click='resetFilters()'
        class='text-xs font-semibold text-[#003060] hover:underline cursor-pointer'
      >
        Clear all filters
      </button>
    </div>
  </div>

  {{!-- Pagination --}}
  <div x-show='totalPages > 1' class='border-t border-gray-200'>
    {{> components/ui/super_admin/table/pagination }}
  </div>
</div>

<script>
  function kelasData(categoryId) {
    // Method ditempel ke objek clientTable, bukan di-spread: spread mengevaluasi
    // getter rows/totalPages sekali dan mematikan reaktivitasnya.
    const state = clientTable({
      size: 6,
      searchKeys: ['name', 'courseType.nameClassesType', 'method'],
    });

    state.selectedProcess = '';
    state.selectedStatus = '';
    state.selectedMentor = '';

    state.processOptions = [
      { value: '', label: 'All Status' },
      { value: 'approved', label: 'Approved' },
      { value: 'process', label: 'Pending' },
    ];

    state.statusOptions = [
      { value: '', label: 'All Program Status' },
      { value: 'unlaunch', label: 'Unpublished' },
      { value: 'launch', label: 'Published' },
      { value: 'learning', label: 'Learning in progress' },
      { value: 'done', label: 'Completed' },
    ];

    state.mentorOptions = [
      { value: '', label: 'All Mentor' },
    ];

    state.getMentorName = function (item) {
      if (!item) return '-';
      if (item.mentorings && item.mentorings.length) {
        const names = item.mentorings
          .map((m) => m.user?.username)
          .filter(Boolean);
        if (names.length) return names.join(', ');
      }
      if (item.mentors && item.mentors.length) {
        const names = item.mentors
          .map((m) => m.name)
          .filter(Boolean);
        if (names.length) return names.join(', ');
      }
      return '-';
    };

    state.getStatusLabel = function (status) {
      const s = status || 'unlaunch';
      switch (s) {
        case 'launch': return 'Published';
        case 'learning': return 'Learning in progress';
        case 'done': return 'Completed';
        default: return 'Unpublished';
      }
    };

    state.getStatusBadgeClass = function (status) {
      const s = status || 'unlaunch';
      switch (s) {
        case 'launch': return 'bg-[#DCFCE7] text-[#15803D]';
        case 'learning': return 'bg-[#DBEAFE] text-[#1D4ED8]';
        case 'done': return 'bg-[#F3E8FF] text-[#7E22CE]';
        default: return 'bg-[#F1F5F9] text-[#475569]';
      }
    };

    state.getStatusDotClass = function (status) {
      const s = status || 'unlaunch';
      switch (s) {
        case 'launch': return 'bg-[#22C55E]';
        case 'learning': return 'bg-[#3B82F6]';
        case 'done': return 'bg-[#A855F7]';
        default: return 'bg-[#94A3B8]';
      }
    };

    state.getStatusTextClass = function (status) {
      const s = status || 'unlaunch';
      switch (s) {
        case 'launch': return 'text-[#15803D]';
        case 'learning': return 'text-[#1D4ED8]';
        case 'done': return 'text-[#7E22CE]';
        default: return 'text-[#475569]';
      }
    };

    state.applyFilter = function () {
      const needle = String(this.searchInput || '').trim().toLowerCase();

      this.filtered = this.items.filter((row) => {
        // 1. Search keyword
        if (needle) {
          const matchesSearch =
            this.searchKeys.some((path) =>
              this.valueAt(row, path).toLowerCase().includes(needle),
            ) || this.getMentorName(row).toLowerCase().includes(needle);
          if (!matchesSearch) return false;
        }

        // 2. Status (Approval) filter: approved vs pending
        if (this.selectedProcess) {
          if (this.selectedProcess === 'approved') {
            if (row.process !== 'approved') return false;
          } else if (
            this.selectedProcess === 'process' ||
            this.selectedProcess === 'pending'
          ) {
            if (row.process === 'approved') return false;
          }
        }

        // 3. Status Program (Lifecycle) filter
        if (this.selectedStatus) {
          const rowStatus = row.status || 'unlaunch';
          if (rowStatus !== this.selectedStatus) return false;
        }

        // 4. Mentor filter
        if (this.selectedMentor) {
          const mentorId = String(this.selectedMentor);
          const hasMentor =
            (row.mentorings &&
              row.mentorings.some(
                (m) =>
                  String(m.userId) === mentorId ||
                  String(m.user?.id) === mentorId,
              )) ||
            (row.mentors &&
              row.mentors.some((m) => String(m.id) === mentorId));
          if (!hasMentor) return false;
        }

        return true;
      });

      this.currentPage = 1;
    };

    state.filterProcess = function (val) {
      this.selectedProcess = val || '';
      this.applyFilter();
    };

    state.filterStatus = function (val) {
      this.selectedStatus = val || '';
      this.applyFilter();
    };

    state.filterMentor = function (val) {
      this.selectedMentor = val || '';
      this.applyFilter();
    };

    state.resetFilters = function () {
      this.selectedProcess = '';
      this.selectedStatus = '';
      this.selectedMentor = '';
      this.applyFilter();
    };

    state.handleSearch = function () {
      clearTimeout(this.searchTimeout);
      this.searchTimeout = setTimeout(() => {
        this.applyFilter();
      }, 300);
    };

    state.fetchKelas = async function () {
      try {
        const res = await fetch(`/category/admin/program/${categoryId}`);
        if (!res.ok) throw new Error('Failed fetch program');
        this.items = await res.json();
        localStorage.setItem('activeData', JSON.stringify(this.items));

        // Populate mentorOptions from loaded items
        const mentorMap = new Map();
        (this.items || []).forEach((c) => {
          if (Array.isArray(c.mentorings)) {
            c.mentorings.forEach((m) => {
              if (m.user && m.user.id && m.user.username) {
                mentorMap.set(String(m.user.id), m.user.username);
              }
            });
          }
          if (Array.isArray(c.mentors)) {
            c.mentors.forEach((m) => {
              if (m.id && m.name) {
                mentorMap.set(String(m.id), m.name);
              }
            });
          }
        });
        this.mentorOptions = [
          { value: '', label: 'All Mentor' },
          ...Array.from(mentorMap.entries()).map(([value, label]) => ({
            value,
            label,
          })),
        ];
      } catch (error) {
        console.error('Error fetching data:', error);
        this.items = [];
      }
      this.applyFilter();
    };

    state.detailUrl = (item) => `/program/detail/program/admin/${item.id}?categoryId=${categoryId}`;

    state.openDetail = function (item) {
      localStorage.setItem('kelasPrevUrl', window.location.href);
      window.location.href = this.detailUrl(item);
    };

    return state;
  }
</script>
