{{!--
  Tab: Gallery — Detail Category (Super Admin)
  Lokasi: src/views/partials/category/gallery_tab.hbs
  Dipanggil dari: super_admin/category/detail.hbs (butuh state `tab` dari tabData())

  Data diambil dari GET /gallery/category/:categoryId (filePath, title, description)
  lalu disaring & dipaginasi di client lewat clientTable(). Tampilan kartu mengikuti
  kelas_tab.

  Tombol delete memakai openDeleteModal, modalnya sudah dipasang di detail.hbs.
--}}
{{> components/ui/super_admin/table/client_table }}

<div
  x-show="tab === 'gallery'"
  x-data='galleryData({{json category.id}})'
  x-init='fetchGallery()'
  class='flex flex-col gap-3'
>
  {{> components/ui/super_admin/table/toolbar
    placeholder='Search gallery...'
    searchLabel='Search gallery'
    createHref=(concat '/gallery/formCreate/' category.id)
    createLabel='Add Gallery'
    fullWidth=true
  }}

  <div x-show='rows.length > 0' class='grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3'>
    <template x-for='gallery in rows' :key='gallery.id'>
      <div class='flex flex-col justify-between gap-5 rounded-xl border border-[#d9d9d9] bg-white p-5'>
        <div class='flex flex-col gap-4'>
          <img
            :src='gallery.filePath'
            :alt="gallery.title || 'Gallery image'"
            class='aspect-video w-full overflow-hidden rounded-xl border border-[#e9d7fe] bg-[#f9f5ff] object-cover text-[0px]'
          />
          <div class='flex min-w-0 flex-col'>
            <h4 class='line-clamp-2 font-montserrat text-sm font-semibold leading-5 text-[#171717]' x-text='gallery.title'></h4>
            <p class='line-clamp-2 font-montserrat text-sm font-medium leading-[22.75px] text-[#737373]' x-text="gallery.description || '—'"></p>
          </div>
        </div>

        <div class='flex gap-2'>
          <a
            :href="'/gallery/formEdit/' + gallery.id"
            class='inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-[#d4d4d4] bg-white px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-[#003060] transition-colors hover:border-[#a3a3a3] hover:bg-[#f5f5f5] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40'
          >Edit</a>
          <form :action="'/gallery/' + gallery.id + '?_method=DELETE'" method='post' class='flex-1'>
            <button
              type='button'
              onclick='openDeleteModal(this)'
              class='inline-flex h-11 w-full items-center justify-center rounded-lg border border-[#fecaca] bg-white px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-[#dc2626] transition-colors hover:bg-[#fef2f2] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#dc2626]/40'
            >Delete</button>
          </form>
        </div>
      </div>
    </template>
  </div>

  <div x-show='rows.length === 0' class='rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 py-12 text-center'>
    <h3 class='text-sm font-medium text-gray-900' x-text="searchInput ? 'No gallery found' : 'No gallery'"></h3>
    <p class='mt-1 text-sm text-gray-500' x-text="searchInput ? 'Try adjusting your search terms' : 'Get started by adding a new gallery.'"></p>
  </div>

  <div x-show='totalPages > 1' class='border-t border-gray-200'>
    {{> components/ui/super_admin/table/pagination }}
  </div>
</div>

<script>
  function galleryData(categoryId) {
    // Method ditempel ke objek clientTable, bukan di-spread: spread mengevaluasi
    // getter rows/totalPages sekali dan mematikan reaktivitasnya.
    const state = clientTable({
      size: 6,
      searchKeys: ['title', 'description'],
    });

    state.fetchGallery = async function () {
      try {
        const res = await fetch(`/gallery/category/${categoryId}`);
        if (!res.ok) throw new Error('Failed fetch gallery');
        this.items = await res.json();
      } catch (error) {
        console.error('Error fetching gallery:', error);
        this.items = [];
      }
      this.applySearch(this.searchInput);
    };

    return state;
  }
</script>
