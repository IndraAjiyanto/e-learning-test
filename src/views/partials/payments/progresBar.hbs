<div class="relative flex items-center justify-between mb-16 w-full max-w-5xl mx-auto z-0">
  <!-- Background Line -->
  <div class="absolute left-0 top-1/2 -translate-y-1/2 w-full h-[4px] bg-[#D7E0E7] z-0"></div>
