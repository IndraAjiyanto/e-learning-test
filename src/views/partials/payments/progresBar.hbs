  <div id="progress-line" class="absolute left-0 top-1/2 -translate-y-1/2 h-[4px] bg-[#0B3A68] z-10 transition-all duration-300" style="width: 0%;"></div>

  <!-- Step 1 -->
  <div class="step-indicator flex flex-col items-center relative z-20" data-step="1">
    <div class="w-[50px] h-[50px] rounded-full flex items-center justify-center font-semibold transition-colors duration-300 bg-[#6EB6E5] text-black">
      1
    </div>
  </div>

  <!-- Step 2 -->
  <div class="step-indicator flex flex-col items-center relative z-20" data-step="2">
    <div class="w-[50px] h-[50px] rounded-full flex items-center justify-center font-semibold transition-colors duration-300 bg-white text-black shadow-[0_0_4px_rgba(0,0,0,0.25)]">
      2
    </div>
  </div>

  <!-- Step 3 -->
  <div class="step-indicator flex flex-col items-center relative z-20" data-step="3">
    <div class="w-[50px] h-[50px] rounded-full flex items-center justify-center font-semibold transition-colors duration-300 bg-white text-black shadow-[0_0_4px_rgba(0,0,0,0.25)]">
      3
    </div>
  </div>
</div>
