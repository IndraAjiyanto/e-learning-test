{{!--
  Partial: Payment Method (Step 2)
  Lokasi: src/views/partials/payments/paymentMethod.hbs

  Menampilkan SATU metode pembayaran, sesuai pilihan yang sudah dibuat user di
  kartu harga halaman program (tab Full Payment / Installment). Pilihan itu
  dibawa ke sini lewat query string `?method=full|installment` dan ditetapkan
  server di PaymentsController.registrationPage() menjadi `paymentMethod`;
  controller juga sudah menurunkan ke `Full Payment` bila program tidak punya
  rencana cicilan.

  Karena metodenya sudah pasti, TIDAK ADA lagi toggle Full/Installment di step
  2: user tidak bisa berganti metode di sini, dan view yang tidak dipilih
  tidak dirender sama sekali (bukan disembunyikan dengan x-show). Menyembunyikan
  dengan x-show pernah membuat kedua view tetap terbaca sebagai "ada" saat
  pengujian, jadi ini juga menutup celah verifikasi.

  Props:
  - paymentMethod : 'Full Payment' | 'Installment' (wajib, dari controller)
  - paymentSettings: hasil PaymentSettingsService.effective(). Nilai kanal
    diteruskan apa adanya ke card di bawah - JANGAN dibungkus helper `default`,
    karena `default` memakai `value || fallback` sehingga `false` akan
    berubah jadi nilai cadangan dan kanal yang sengaja dimatikan ikut nyala.
--}}

<div id="step-2-form" class="w-full">
{{#if (eq paymentMethod 'Installment')}}
  <div id="view-installment" class="flex flex-col xl:flex-row items-start gap-[30px] w-full">
    <!-- Left Column: Installment Method Card (Group 6727, width 976px) -->
    <div class="w-full xl:w-[976px] xl:max-w-[976px]">
      {{> components/ui/card/installment_method_card/index
        course=course
      }}
    </div>

    <!-- Right Column: Installment Summary Card (Group 6727, width 480px) -->
    <div class="w-full xl:w-[480px] xl:max-w-[480px] shrink-0">
      {{> components/ui/card/installment_summary_card/index
        courseTitle=(default course.name "Program Course")
        basePrice=course.price
        promoPrice=course.promo
        downPayment=course.installments.[0].downPayment
        month=(default course.installments.[0].month 3)
        pricePerMonth=course.installments.[0].price.[0]
        uid="installment"
        manualActionUrl=(concat '/payment/' user.id '/' course.id '/' course.installments.[0].id)
        gatewayEnabled=paymentSettings.gateway_enabled
        gatewayHidden=paymentSettings.gateway_hidden_because_key_missing
        manualEnabled=paymentSettings.manual_enabled
      }}
    </div>
  </div>
{{else}}
  <div id="view-full-payment" class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start w-full">
    <!-- Left Column: Full Payment Info & Voucher Input -->
    <div class="lg:col-span-5 flex flex-col gap-6 w-full">
      <div class="flex flex-col gap-1.5">
        <h3 class="font-montserrat font-bold text-lg sm:text-xl text-[#1B2559]">
          Full Payment
        </h3>
        <p class="font-montserrat font-normal text-xs sm:text-sm text-[#718096]">
          Select the most convenient payment method for you.
        </p>
      </div>

      <!-- Voucher Input Component (Full Payment) -->
      {{> components/ui/input/voucher_input/index
        id="promo-input"
        removeBtnId="remove-promo-btn"
        messageId="promo-message"
        placeholder="Input Voucher Code"
      }}
    </div>

    <!-- Right Column: Full Payment Summary Card -->
    <div class="lg:col-span-7 flex justify-end w-full">
      {{> components/ui/card/payment_summary_card/index
        courseTitle=(default course.name "Program Course")
        basePrice=course.price
        promoPrice=course.promo
        uid="full"
        manualActionUrl=(concat '/payment/' user.id '/' course.id '/manual')
        gatewayEnabled=paymentSettings.gateway_enabled
        gatewayHidden=paymentSettings.gateway_hidden_because_key_missing
        manualEnabled=paymentSettings.manual_enabled
      }}
    </div>
  </div>
{{/if}}
</div>

<script>
  // Metode sudah ditetapkan server (lihat header partial). Nilai ini yang
  // dikirim ke /api/payment/create; tidak ada lagi yang bisa menggantinya dari
  // sisi klien karena toggle metodenya sudah dihapus.
  const PAYMENT_METHOD = '{{paymentMethod}}';
  const IS_INSTALLMENT = PAYMENT_METHOD === 'Installment';

  // Hanya satu view yang dirender, jadi hanya ada satu pasang elemen voucher,
  // satu pasang elemen nominal, dan satu pasang elemen diskon. Id-nya diambil
  // dari metode supaya tidak perlu menyinkronkan dua form sekaligus.
  const VOUCHER = IS_INSTALLMENT
    ? {
        input: 'promo-input-installment',
        message: 'promo-message-installment',
        removeBtn: 'remove-promo-btn-installment',
        subtotal: 'installment-detail-subtotal',
        voucher: 'installment-detail-voucher',
        total: 'installment-detail-total',
        discountRow: 'installment-discount-row',
        discountCode: 'installment-display-promo',
      }
    : {
        input: 'promo-input',
        message: 'promo-message',
        removeBtn: 'remove-promo-btn',
        subtotal: 'detail-subtotal',
        voucher: 'detail-voucher',
        total: 'detail-total',
        discountRow: 'discount-row',
        discountCode: 'display-promo-code',
      };

  // Dynamic pricing values from Backend Handlebars
  const coursePromo = Number('{{course.promo}}') || 0;
  const courseBasePrice = Number('{{course.price}}') || 0;
  const courseFullPrice = coursePromo > 0 ? coursePromo : courseBasePrice;
  const courseInstallmentDP = Number('{{course.installments.[0].downPayment}}') || 0;

  // Nominal yang divalidasi voucher adalah nominal metode yang sedang
  // dibayar, bukan harga program penuh - sama seperti sebelumnya, hanya kini
  // tidak pernah berubah karena user tidak bisa ganti metode di step 2.
  const currentSubtotal = IS_INSTALLMENT ? courseInstallmentDP : courseFullPrice;

  let activePromo = null;

  // Debounce Utility
  function debounce(func, wait) {
    let timeout;
    return function (...args) {
      clearTimeout(timeout);
      timeout = setTimeout(() => func.apply(this, args), wait);
    };
  }

  function getVoucherInput() {
    return document.getElementById(VOUCHER.input);
  }

  function showPromoMessage(text, type) {
    const msg = document.getElementById(VOUCHER.message);
    if (!msg) return;
    msg.textContent = text;
    msg.classList.remove("hidden");
    if (type === 'success') {
      msg.className = "font-montserrat text-xs mt-1 font-medium block text-green-600";
    } else if (type === 'error') {
      msg.className = "font-montserrat text-xs mt-1 font-medium block text-red-500";
    } else {
      msg.className = "font-montserrat text-xs mt-1 font-medium block text-slate-500";
    }
  }

  const checkPromo = debounce(async () => {
    const promoInput = getVoucherInput();
    if (!promoInput) return;
    const code = promoInput.value.trim().toUpperCase();

    if (!code) {
      removePromo();
      return;
    }

    showPromoMessage("Mengecek kode voucher...", "neutral");

    try {
      const courseId = '{{course.id}}';

      const response = await fetch('/api/voucher/validate', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify({
          code: code,
          courseId: courseId,
          subtotal: currentSubtotal
        })
      });

      if (!response.ok && response.status === 404) {
        throw new Error("Endpoint API tidak ditemukan (404).");
      }

      const result = await response.json();

      if (response.ok && result.status === "success") {
        const { discount_amount, final_total, promo_code } = result.data;

        activePromo = promo_code;
        const input = getVoucherInput();
        if (input) {
          input.disabled = true;
          input.classList.add("bg-green-50", "border-green-300");
        }
        const removeBtn = document.getElementById(VOUCHER.removeBtn);
        if (removeBtn) removeBtn.classList.remove("hidden");

        updatePricingUI(discount_amount, final_total);
        showPromoMessage(result.message || "Kode promo berhasil diterapkan!", "success");
      } else {
        activePromo = null;
        updatePricingUI(0, currentSubtotal);
        showPromoMessage(result.message || "Kode promo tidak valid atau kadaluarsa.", "error");
      }
    } catch (error) {
      console.error("Promo check error:", error);
      activePromo = null;
      updatePricingUI(0, currentSubtotal);
      showPromoMessage(error.message === "Endpoint API tidak ditemukan (404)." ? "Sistem sedang diperbarui, API tidak ditemukan." : "Terjadi kesalahan saat mengecek kode promo.", "error");
    }
  }, 800);

  function handlePromoInput() {
    const input = getVoucherInput();
    if (!input) return;
    input.classList.remove("bg-green-50", "border-green-300");

    if (input.value.trim() === "") {
      removePromo();
    } else {
      showPromoMessage("Mengetik...", "neutral");
      checkPromo();
    }
  }

  function removePromo() {
    activePromo = null;

    const input = getVoucherInput();
    if (input) {
      input.value = "";
      input.disabled = false;
      input.classList.remove("bg-green-50", "border-green-300");
    }

    const removeBtn = document.getElementById(VOUCHER.removeBtn);
    if (removeBtn) removeBtn.classList.add("hidden");

    const msg = document.getElementById(VOUCHER.message);
    if (msg) msg.classList.add("hidden");

    updatePricingUI(0, currentSubtotal);
  }

  function updatePricingUI(disc, total) {
    const elSub = document.getElementById(VOUCHER.subtotal);
    const elVoucher = document.getElementById(VOUCHER.voucher);
    const elTotal = document.getElementById(VOUCHER.total);
    const discRow = document.getElementById(VOUCHER.discountRow);
    const discDivider = document.getElementById("discount-divider");
    const displayPromo = document.getElementById(VOUCHER.discountCode);

    if (elSub) elSub.textContent = `Rp${currentSubtotal.toLocaleString('id-ID')}`;
    if (elVoucher) elVoucher.textContent = `- Rp${disc.toLocaleString('id-ID')}`;
    if (elTotal) elTotal.textContent = `Rp${total.toLocaleString('id-ID')}`;

    if (disc > 0) {
      if (displayPromo) displayPromo.textContent = activePromo;
      if (discRow) {
        discRow.classList.remove("hidden");
        discRow.classList.add("flex");
      }
      if (discDivider) discDivider.classList.remove("hidden");
    } else {
      if (discRow) {
        discRow.classList.add("hidden");
        discRow.classList.remove("flex");
      }
      if (discDivider) discDivider.classList.add("hidden");
    }
  }

  async function proceedToPayment() {
    const btn = document.getElementById(IS_INSTALLMENT ? "btn-pay-now-installment" : "btn-pay-now");
    const text = document.getElementById(IS_INSTALLMENT ? "btn-pay-now-installment-text" : "btn-pay-now-text");
    const spinner = document.getElementById(IS_INSTALLMENT ? "btn-pay-now-installment-spinner" : "btn-pay-now-spinner");

    const resetButton = () => {
      if (btn) btn.disabled = false;
      if (text) text.classList.remove("hidden");
      if (spinner) spinner.classList.add("hidden");
    };

    if (btn) btn.disabled = true;
    if (text) text.classList.add("hidden");
    if (spinner) spinner.classList.remove("hidden");

    try {
      const courseId = '{{course.id}}';
      const storageKey =
        typeof window.getPaymentProgressStorageKey === 'function'
          ? window.getPaymentProgressStorageKey()
          : null;

      let formData = null;
      if (storageKey) {
        const raw = localStorage.getItem(storageKey);
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            formData = parsed.forms && parsed.forms.form1 ? parsed.forms.form1 : null;
          } catch (e) {}
        }
      }

      const response = await fetch('/api/payment/create', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        credentials: 'same-origin',
        body: JSON.stringify({
          courseId: courseId,
          paymentMethod: PAYMENT_METHOD,
          promoCode: activePromo ? activePromo : null,
          formData: formData
        }),
      });

      const data = await response.json();

      if (response.ok && data.status === 'success') {
        window.location.href = data.redirect_url;
      } else {
        // Toast global dari layouts/main.hbs, bukan alert() bawaan browser:
        // alert memblokir seluruh halaman dan terlihat berbeda dari semua
        // notifikasi lain di sistem ini.
        showErrorToast('Pembayaran gagal', data.message || 'Terjadi kesalahan saat memproses pembayaran.');
        resetButton();
      }
    } catch (error) {
      console.error('Payment Error:', error);
      showErrorToast('Pembayaran gagal', 'Terjadi kesalahan koneksi saat menghubungi server pembayaran.');
      resetButton();
    }
  }
</script>

<script>
  (function initPaymentMethodDraftStorage() {
    const userId = '{{user.id}}';
    const courseId = '{{course.id}}';
    if (!userId || !courseId) return;

    const storageKey =
      typeof window.getPaymentProgressStorageKey === 'function'
        ? window.getPaymentProgressStorageKey()
        : `payment-${userId}-${courseId}-form`;

    const readDraft = () => {
      const raw = localStorage.getItem(storageKey);
      if (!raw) return null;

      try {
        return JSON.parse(raw);
      } catch (error) {
        return null;
      }
    };

    let lastSavedPayload = null;

    // Draft hanya menyimpan voucher. paymentMethod sengaja ikut ditulis
    // sebagai catatan, tapi tidak pernah dibaca kembali untuk mengganti
    // metode, karena metodenya milik query string dan sudah ditetapkan server.
    const collectForm2 = () => ({
      paymentMethod: PAYMENT_METHOD,
      voucherDiscount: (getVoucherInput()?.value || '').trim().toUpperCase(),
    });

    const saveForm2IfChanged = () => {
      const existingDraft = readDraft() || {};
      const payload = {
        ...existingDraft,
        userId,
        courseId,
        form: Number(existingDraft.form) || Number(sessionStorage.getItem('currentPaymentStep') || 1),
        forms: {
          ...(existingDraft.forms || {}),
          form2: collectForm2(),
        },
      };

      const payloadString = JSON.stringify(payload);
      if (payloadString === lastSavedPayload) return;

      const existingRaw = localStorage.getItem(storageKey);
      if (existingRaw === payloadString) {
        lastSavedPayload = payloadString;
        return;
      }

      localStorage.setItem(storageKey, payloadString);
      lastSavedPayload = payloadString;
    };

    const bootstrap = () => {
      // Pulihkan voucher dari draft. Metode tidak dipulihkan: sudah ditetapkan
      // server dan tidak bisa diganti di step 2.
      const existingDraft = readDraft();
      const savedVoucher = existingDraft?.forms?.form2?.voucherDiscount;
      const input = getVoucherInput();
      if (savedVoucher && input) {
        input.value = savedVoucher;
        handlePromoInput();
      }

      if (input) {
        input.addEventListener('input', saveForm2IfChanged);
        input.addEventListener('change', saveForm2IfChanged);
      }

      document.addEventListener('payment:step-changed', (e) => {
        if (e.detail?.step === 2) saveForm2IfChanged();
      });

      // Nominal awal mengikuti metode terpilih, supaya tidak sempat tampil
      // memakai harga program penuh saat metode yang dipilih adalah cicilan.
      updatePricingUI(0, currentSubtotal);

      saveForm2IfChanged();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap);
    } else {
      bootstrap();
    }
  })();
</script>
