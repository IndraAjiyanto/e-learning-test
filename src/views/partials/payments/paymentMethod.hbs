{{!--
  Partial: Payment Method (Step 2)
  Lokasi: src/views/partials/payments/paymentMethod.hbs
  Mendukung: Full Payment & Installment Payment (Figma Group 6727)
--}}

<form id="step-2-form" class="w-full">
  <!-- Hidden input for payment method (Full Payment | Installment) -->
  <input type="hidden" id="payment-method-select" name="paymentMethod" value="Full Payment" />

  <!-- Payment Method Selection Toggle -->
  <div class="w-full max-w-[420px] mb-8 select-none">
    <div class="flex w-full items-center rounded-full bg-[#F1F5F9] p-1">
      <button
        type="button"
        id="toggle-btn-full"
        onclick="switchPaymentMethod('Full Payment')"
        class="flex flex-1 items-center justify-center py-2.5 rounded-full text-[13px] font-semibold transition-all duration-200 cursor-pointer bg-[#003060] text-white shadow-xs"
      >
        Full Payment
      </button>
      {{#if course.installments.length}}
      <button
        type="button"
        id="toggle-btn-installment"
        onclick="switchPaymentMethod('Installment')"
        class="flex flex-1 items-center justify-center py-2.5 rounded-full text-[13px] font-semibold transition-all duration-200 cursor-pointer text-[#64748B] hover:text-[#0B1F3B]"
      >
        Installment
      </button>
      {{/if}}
    </div>
  </div>

  <!-- 1. FULL PAYMENT VIEW -->
  <div id="view-full-payment" class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start w-full">
    <!-- Left Column: Full Payment Info & Voucher Input -->
    <div class="lg:col-span-5 flex flex-col gap-6 w-full">
      <div class="flex flex-col gap-1.5">
        <h3 class="font-montserrat font-bold text-lg sm:text-xl text-[#1B2559]">
          Full Payment
        </h3>
        <p class="font-montserrat font-normal text-xs sm:text-sm text-[#718096]">
          Select the most convenient payment method for you.
        </p>
      </div>

      <!-- Voucher Input Component (Full Payment) -->
      {{> components/ui/input/voucher_input/index
        id="promo-input"
        removeBtnId="remove-promo-btn"
        messageId="promo-message"
        placeholder="Input Voucher Code"
      }}
    </div>

    <!-- Right Column: Full Payment Summary Card -->
    <div class="lg:col-span-7 flex justify-end w-full">
      {{> components/ui/card/payment_summary_card/index
        courseTitle=(default course.name "Program Course")
        basePrice=course.price
        promoPrice=course.promo
      }}
    </div>
  </div>

  <!-- 2. INSTALLMENT PAYMENT VIEW (Group 6727 / Frame 2147229714) -->
  <div id="view-installment" class="flex flex-col xl:flex-row items-start gap-[30px] w-full hidden">
    <!-- Left Column: Installment Method Card (Group 6727, width 976px) -->
    <div class="w-full xl:w-[976px] xl:max-w-[976px]">
      {{> components/ui/card/installment_method_card/index
        course=course
      }}
    </div>

    <!-- Right Column: Installment Summary Card (Group 6727, width 480px) -->
    <div class="w-full xl:w-[480px] xl:max-w-[480px] shrink-0">
      {{> components/ui/card/installment_summary_card/index
        courseTitle=(default course.name "Program Course")
        basePrice=course.price
        promoPrice=course.promo
        downPayment=course.installments.[0].downPayment
        month=(default course.installments.[0].month 3)
        pricePerMonth=course.installments.[0].price.[0]
      }}
    </div>
  </div>

</form>

<script>
  // Dynamic pricing values from Backend Handlebars
  const coursePromo = Number('{{course.promo}}') || 0;
  const courseBasePrice = Number('{{course.price}}') || 0;
  const courseFullPrice = coursePromo > 0 ? coursePromo : courseBasePrice;
  const courseInstallmentDP = Number('{{course.installments.[0].downPayment}}') || 0;
  const hasInstallments = Boolean({{ternary course.installments.length 'true' 'false'}} && courseInstallmentDP > 0);

  let currentMethod = 'Full Payment';
  let currentSubtotal = courseFullPrice;
  let activePromo = null;
  let currentDiscountAmount = 0;

  // Debounce Utility
  function debounce(func, wait) {
    let timeout;
    return function (...args) {
      clearTimeout(timeout);
      timeout = setTimeout(() => func.apply(this, args), wait);
    };
  }

  function getActivePromoInput() {
    if (currentMethod === 'Installment') {
      return document.getElementById("promo-input-installment") || document.getElementById("promo-input");
    }
    return document.getElementById("promo-input") || document.getElementById("promo-input-installment");
  }

  function showPromoMessage(text, type) {
    const msgIds = ['promo-message', 'promo-message-installment'];
    msgIds.forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      el.textContent = text;
      el.classList.remove("hidden");
      if (type === 'success') {
        el.className = "font-montserrat text-xs mt-1 font-medium block text-green-600";
      } else if (type === 'error') {
        el.className = "font-montserrat text-xs mt-1 font-medium block text-red-500";
      } else {
        el.className = "font-montserrat text-xs mt-1 font-medium block text-slate-500";
      }
    });
  }

  const checkPromo = debounce(async () => {
    const promoInput = getActivePromoInput();
    if (!promoInput) return;
    const code = promoInput.value.trim().toUpperCase();

    // Sync input values
    const otherInput = document.getElementById(currentMethod === 'Installment' ? "promo-input" : "promo-input-installment");
    if (otherInput) otherInput.value = code;

    if (!code) {
      removePromo();
      return;
    }

    showPromoMessage("Mengecek kode voucher...", "neutral");

    const currentCode = promoInput.value.trim().toUpperCase();
    if (currentCode !== code) return;

    try {
      const courseId = '{{course.id}}';

      const response = await fetch('/api/voucher/validate', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify({
          code: code,
          courseId: courseId,
          subtotal: currentSubtotal
        })
      });

      if (!response.ok && response.status === 404) {
        throw new Error("Endpoint API tidak ditemukan (404).");
      }

      const result = await response.json();

      if (response.ok && result.status === "success") {
        const { discount_amount, final_total, promo_code } = result.data;

        activePromo = promo_code;
        currentDiscountAmount = discount_amount;
        updatePricingUI(currentSubtotal, discount_amount, final_total);

        ['promo-input', 'promo-input-installment'].forEach(id => {
          const el = document.getElementById(id);
          if (el) {
            el.disabled = true;
            el.classList.add("bg-green-50", "border-green-300");
          }
        });

        ['remove-promo-btn', 'remove-promo-btn-installment'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.classList.remove("hidden");
        });

        showPromoMessage(result.message || "Kode promo berhasil diterapkan!", "success");
      } else {
        activePromo = null;
        currentDiscountAmount = 0;
        updatePricingUI(currentSubtotal, 0, currentSubtotal);
        showPromoMessage(result.message || "Kode promo tidak valid atau kadaluarsa.", "error");
      }
    } catch (error) {
      console.error("Promo check error:", error);
      activePromo = null;
      currentDiscountAmount = 0;
      updatePricingUI(currentSubtotal, 0, currentSubtotal);
      showPromoMessage(error.message === "Endpoint API tidak ditemukan (404)." ? "Sistem sedang diperbarui, API tidak ditemukan." : "Terjadi kesalahan saat mengecek kode promo.", "error");
    }
  }, 800);

  function handlePromoInput() {
    const input = getActivePromoInput();
    if (!input) return;
    input.classList.remove("bg-green-50", "border-green-300");

    const otherInput = document.getElementById(currentMethod === 'Installment' ? "promo-input" : "promo-input-installment");
    if (otherInput) {
      otherInput.value = input.value;
      otherInput.classList.remove("bg-green-50", "border-green-300");
    }

    if (input.value.trim() === "") {
      removePromo();
    } else {
      showPromoMessage("Mengetik...", "neutral");
      checkPromo();
    }
  }

  function removePromo() {
    activePromo = null;
    currentDiscountAmount = 0;

    ['promo-input', 'promo-input-installment'].forEach(id => {
      const input = document.getElementById(id);
      if (input) {
        input.value = "";
        input.disabled = false;
        input.classList.remove("bg-green-50", "border-green-300");
      }
    });

    ['remove-promo-btn', 'remove-promo-btn-installment'].forEach(id => {
      const btn = document.getElementById(id);
      if (btn) btn.classList.add("hidden");
    });

    updatePricingUI(currentSubtotal, 0, currentSubtotal);

    ['promo-message', 'promo-message-installment'].forEach(id => {
      const msg = document.getElementById(id);
      if (msg) msg.classList.add("hidden");
    });
  }

  function updatePricingUI(sub, disc, total) {
    // 1. Full Payment Summary Elements
    const elSub = document.getElementById("detail-subtotal") || document.getElementById("detail-price");
    const elVoucher = document.getElementById("detail-voucher");
    const elTotal = document.getElementById("detail-total");
    const discRow = document.getElementById("discount-row");
    const discDivider = document.getElementById("discount-divider");
    const displayPromo = document.getElementById("display-promo-code");

    if (elSub) elSub.textContent = `Rp${sub.toLocaleString('id-ID')}`;
    if (elVoucher) elVoucher.textContent = `- Rp${disc.toLocaleString('id-ID')}`;
    if (elTotal) elTotal.textContent = `Rp${total.toLocaleString('id-ID')}`;

    if (disc > 0) {
      if (displayPromo) displayPromo.textContent = activePromo;
      if (discRow) {
        discRow.classList.remove("hidden");
        discRow.classList.add("flex");
      }
      if (discDivider) discDivider.classList.remove("hidden");
    } else {
      if (discRow) {
        discRow.classList.add("hidden");
        discRow.classList.remove("flex");
      }
      if (discDivider) discDivider.classList.add("hidden");
    }

    // 2. Installment Summary Elements (Group 6727)
    const instFee = document.getElementById("installment-detail-fee");
    const instSub = document.getElementById("installment-detail-subtotal");
    const instVoucher = document.getElementById("installment-detail-voucher");
    const instTotal = document.getElementById("installment-detail-total");
    const instDiscRow = document.getElementById("installment-discount-row");
    const instDisplayPromo = document.getElementById("installment-display-promo");

    if (instFee) instFee.textContent = `Rp${courseInstallmentDP.toLocaleString('id-ID')}`;
    if (instSub) instSub.textContent = `Rp${courseInstallmentDP.toLocaleString('id-ID')}`;
    if (instVoucher) instVoucher.textContent = `- Rp${disc.toLocaleString('id-ID')}`;
    if (instTotal) instTotal.textContent = `Rp${total.toLocaleString('id-ID')}`;

    if (disc > 0) {
      if (instDisplayPromo) instDisplayPromo.textContent = activePromo;
      if (instDiscRow) {
        instDiscRow.classList.remove("hidden");
        instDiscRow.classList.add("flex");
      }
    } else {
      if (instDiscRow) {
        instDiscRow.classList.add("hidden");
        instDiscRow.classList.remove("flex");
      }
    }
  }

  function switchPaymentMethod(method) {
    currentMethod = method;
    const select = document.getElementById('payment-method-select');
    if (select) select.value = method;

    const viewFull = document.getElementById('view-full-payment');
    const viewInst = document.getElementById('view-installment');
    const btnFull = document.getElementById('toggle-btn-full');
    const btnInst = document.getElementById('toggle-btn-installment');

    const activeClasses = "flex flex-1 items-center justify-center py-2.5 rounded-full text-[13px] font-semibold transition-all duration-200 cursor-pointer bg-[#003060] text-white shadow-xs";
    const inactiveClasses = "flex flex-1 items-center justify-center py-2.5 rounded-full text-[13px] font-semibold transition-all duration-200 cursor-pointer text-[#64748B] hover:text-[#0B1F3B]";

    if (method === 'Installment') {
      if (viewFull) viewFull.classList.add('hidden');
      if (viewInst) viewInst.classList.remove('hidden');
      currentSubtotal = courseInstallmentDP;

      if (btnFull) btnFull.className = inactiveClasses;
      if (btnInst) btnInst.className = activeClasses;
    } else {
      if (viewFull) viewFull.classList.remove('hidden');
      if (viewInst) viewInst.classList.add('hidden');
      currentSubtotal = courseFullPrice;

      if (btnFull) btnFull.className = activeClasses;
      if (btnInst) btnInst.className = inactiveClasses;
    }

    // Recalculate voucher against the new currentSubtotal
    if (activePromo) {
      checkPromo();
    } else {
      updatePricingUI(currentSubtotal, 0, currentSubtotal);
    }
  }

  async function proceedToPayment() {
    const isInst = currentMethod === 'Installment';
    const btn = document.getElementById(isInst ? "btn-pay-now-installment" : "btn-pay-now");
    const text = document.getElementById(isInst ? "btn-pay-now-installment-text" : "btn-pay-now-text");
    const spinner = document.getElementById(isInst ? "btn-pay-now-installment-spinner" : "btn-pay-now-spinner");

    if (btn) btn.disabled = true;
    if (text) text.classList.add("hidden");
    if (spinner) spinner.classList.remove("hidden");

    try {
      const userId = '{{user.id}}';
      const courseId = '{{course.id}}';
      const storageKey =
        typeof window.getPaymentProgressStorageKey === 'function'
          ? window.getPaymentProgressStorageKey()
          : `payment-${userId}-${courseId}-form`;

      let formData = null;
      if (storageKey) {
        const raw = localStorage.getItem(storageKey);
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            formData = parsed.forms && parsed.forms.form1 ? parsed.forms.form1 : null;
          } catch (e) {}
        }
      }

      const response = await fetch('/api/payment/create', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        credentials: 'same-origin',
        body: JSON.stringify({
          courseId: courseId,
          paymentMethod: currentMethod,
          promoCode: activePromo ? activePromo : null,
          formData: formData
        }),
      });

      const data = await response.json();

      if (response.ok && data.status === 'success') {
        window.location.href = data.redirect_url;
      } else {
        alert('Gagal memproses pembayaran: ' + (data.message || 'Unknown error'));
        if (btn) btn.disabled = false;
        if (text) text.classList.remove("hidden");
        if (spinner) spinner.classList.add("hidden");
      }
    } catch (error) {
      console.error('Payment Error:', error);
      alert('Terjadi kesalahan koneksi saat menghubungi server pembayaran.');
      if (btn) btn.disabled = false;
      if (text) text.classList.remove("hidden");
      if (spinner) spinner.classList.add("hidden");
    }
  }
</script>

<script>
  (function initPaymentMethodDraftStorage() {
    const userId = '{{user.id}}';
    const courseId = '{{course.id}}';
    if (!userId || !courseId) return;

    const storageKey =
      typeof window.getPaymentProgressStorageKey === 'function'
        ? window.getPaymentProgressStorageKey()
        : `payment-${userId}-${courseId}-form`;

    const paymentMethodSelect = document.getElementById('payment-method-select');
    const promoInput = document.getElementById('promo-input');
    const promoInputInst = document.getElementById('promo-input-installment');

    const readDraft = () => {
      const raw = localStorage.getItem(storageKey);
      if (!raw) return null;

      try {
        return JSON.parse(raw);
      } catch (error) {
        return null;
      }
    };

    let lastSavedPayload = null;

    const collectForm2 = () => ({
      paymentMethod: paymentMethodSelect ? paymentMethodSelect.value : currentMethod,
      voucherDiscount: (getActivePromoInput()?.value || '').trim().toUpperCase(),
    });

    const saveForm2IfChanged = () => {
      const existingDraft = readDraft() || {};
      const payload = {
        ...existingDraft,
        userId,
        courseId,
        form: Number(existingDraft.form) || Number(sessionStorage.getItem('currentPaymentStep') || 1),
        forms: {
          ...(existingDraft.forms || {}),
          form2: collectForm2(),
        },
      };

      const payloadString = JSON.stringify(payload);
      if (payloadString === lastSavedPayload) return;

      const existingRaw = localStorage.getItem(storageKey);
      if (existingRaw === payloadString) {
        lastSavedPayload = payloadString;
        return;
      }

      localStorage.setItem(storageKey, payloadString);
      lastSavedPayload = payloadString;
    };

    const applyForm2 = (form2) => {
      if (!form2) return;

      if (form2.paymentMethod && hasInstallments) {
        switchPaymentMethod(form2.paymentMethod);
      }

      if (form2.voucherDiscount) {
        if (promoInput) promoInput.value = form2.voucherDiscount;
        if (promoInputInst) promoInputInst.value = form2.voucherDiscount;
        handlePromoInput();
      }
    };

    const bootstrap = () => {
      // 1. Tentukan tampilan aktif: jika URL menentukan method atau fallback ke ketersediaan installment
      const urlMethod = new URLSearchParams(window.location.search).get('method');
      if (urlMethod && urlMethod.toLowerCase() === 'full') {
        switchPaymentMethod('Full Payment');
      } else if (urlMethod && urlMethod.toLowerCase() === 'installment' && hasInstallments) {
        switchPaymentMethod('Installment');
      } else if (hasInstallments) {
        switchPaymentMethod('Installment');
      } else {
        switchPaymentMethod('Full Payment');
      }

      // 2. Cek voucher draft dari localStorage jika ada
      const existingDraft = readDraft();
      if (existingDraft?.forms?.form2?.voucherDiscount) {
        if (promoInput) promoInput.value = existingDraft.forms.form2.voucherDiscount;
        if (promoInputInst) promoInputInst.value = existingDraft.forms.form2.voucherDiscount;
        handlePromoInput();
      }

      if (promoInput) {
        promoInput.addEventListener('input', saveForm2IfChanged);
        promoInput.addEventListener('change', saveForm2IfChanged);
      }
      if (promoInputInst) {
        promoInputInst.addEventListener('input', saveForm2IfChanged);
        promoInputInst.addEventListener('change', saveForm2IfChanged);
      }
      document.addEventListener('payment:step-changed', (e) => {
        if (e.detail?.step === 2) {
          const m = new URLSearchParams(window.location.search).get('method');
          if (m && m.toLowerCase() === 'full') {
            switchPaymentMethod('Full Payment');
          } else if (m && m.toLowerCase() === 'installment' && hasInstallments) {
            switchPaymentMethod('Installment');
          } else if (hasInstallments) {
            switchPaymentMethod(currentMethod || 'Installment');
          } else {
            switchPaymentMethod('Full Payment');
          }
        }
        saveForm2IfChanged();
      });

      saveForm2IfChanged();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap);
    } else {
      bootstrap();
    }
  })();
</script>
