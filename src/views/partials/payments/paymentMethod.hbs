{{!--
  Partial: Payment Method (Step 2)
  Lokasi: src/views/partials/payments/paymentMethod.hbs
  Fokus: Full Payment (tanpa pemilihan cicilan/installment)
--}}

<form id="step-2-form" class="w-full">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start w-full">

    <!-- Left Column: Payment Method Info & Voucher Input (Figma: Voucher Input Section) -->
    <div class="lg:col-span-5 flex flex-col gap-6 w-full">
      <!-- Section Header -->
      <div class="flex flex-col gap-1.5">
        <h3 class="font-montserrat font-bold text-lg sm:text-xl text-[#1B2559]">
          Full Payment
        </h3>
        <p class="font-montserrat font-normal text-xs sm:text-sm text-[#718096]">
          Select the most convenient payment method for you.
        </p>
      </div>

      <!-- Hidden input for payment method (always Full Payment) -->
      <input type="hidden" id="payment-method-select" name="paymentMethod" value="Full Payment" />

      <!-- Voucher Input Component -->
      {{> components/ui/input/voucher_input/index
        id="promo-input"
        placeholder="Input Voucher Code"
      }}
    </div>

    <!-- Right Column: Payment Details Card (Figma: payment-details-card) -->
    <div class="lg:col-span-7 flex justify-end w-full">
      {{> components/ui/card/payment_summary_card/index
        courseTitle=(default course.name "Program Course")
        basePrice=course.price
        promoPrice=course.promo
      }}
    </div>

  </div>
</form>

<script>
  // Dynamic pricing values from Backend Handlebars
  const coursePromo = Number('{{course.promo}}') || 0;
  const courseBasePrice = Number('{{course.price}}') || 0;
  const courseFullPrice = coursePromo > 0 ? coursePromo : courseBasePrice;

  let currentSubtotal = courseFullPrice;
  let activePromo = null;
  let currentDiscountAmount = 0;

  // Debounce Utility
  function debounce(func, wait) {
    let timeout;
    return function (...args) {
      clearTimeout(timeout);
      timeout = setTimeout(() => func.apply(this, args), wait);
    };
  }

  function showPromoMessage(text, type) {
    const el = document.getElementById("promo-message");
    if (!el) return;
    el.textContent = text;
    el.classList.remove("hidden");
    if (type === 'success') {
      el.className = "font-montserrat text-xs mt-1 font-medium block text-green-600";
    } else if (type === 'error') {
      el.className = "font-montserrat text-xs mt-1 font-medium block text-red-500";
    } else {
      el.className = "font-montserrat text-xs mt-1 font-medium block text-slate-500";
    }
  }

  const checkPromo = debounce(async () => {
    const promoInput = document.getElementById("promo-input");
    if (!promoInput) return;
    const code = promoInput.value.trim().toUpperCase();

    if (!code) {
      removePromo();
      return;
    }

    showPromoMessage("Mengecek kode voucher...", "neutral");

    const currentCode = promoInput.value.trim().toUpperCase();
    if (currentCode !== code) return;

    try {
      const courseId = '{{course.id}}';

      const response = await fetch('/api/voucher/validate', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify({
          code: code,
          courseId: courseId,
          subtotal: currentSubtotal
        })
      });

      if (!response.ok && response.status === 404) {
        throw new Error("Endpoint API tidak ditemukan (404).");
      }

      const result = await response.json();

      if (response.ok && result.status === "success") {
        const { discount_amount, final_total, promo_code } = result.data;

        activePromo = promo_code;
        currentDiscountAmount = discount_amount;
        updatePricingUI(currentSubtotal, discount_amount, final_total);

        promoInput.disabled = true;
        promoInput.classList.add("bg-green-50", "border-green-300");
        const removeBtn = document.getElementById("remove-promo-btn");
        if (removeBtn) removeBtn.classList.remove("hidden");

        showPromoMessage(result.message || "Kode promo berhasil diterapkan!", "success");
      } else {
        activePromo = null;
        currentDiscountAmount = 0;
        updatePricingUI(currentSubtotal, 0, currentSubtotal);
        showPromoMessage(result.message || "Kode promo tidak valid atau kadaluarsa.", "error");
      }
    } catch (error) {
      console.error("Promo check error:", error);
      activePromo = null;
      currentDiscountAmount = 0;
      updatePricingUI(currentSubtotal, 0, currentSubtotal);
      showPromoMessage(error.message === "Endpoint API tidak ditemukan (404)." ? "Sistem sedang diperbarui, API tidak ditemukan." : "Terjadi kesalahan saat mengecek kode promo.", "error");
    }
  }, 800);

  function handlePromoInput() {
    const input = document.getElementById("promo-input");
    if (!input) return;
    input.classList.remove("bg-green-50", "border-green-300");

    if (input.value.trim() === "") {
      removePromo();
    } else {
      showPromoMessage("Mengetik...", "neutral");
      checkPromo();
    }
  }

  function removePromo() {
    activePromo = null;
    currentDiscountAmount = 0;
    const input = document.getElementById("promo-input");
    if (input) {
      input.value = "";
      input.disabled = false;
      input.classList.remove("bg-green-50", "border-green-300");
    }

    const removeBtn = document.getElementById("remove-promo-btn");
    if (removeBtn) removeBtn.classList.add("hidden");

    updatePricingUI(currentSubtotal, 0, currentSubtotal);
    const promoMsg = document.getElementById("promo-message");
    if (promoMsg) promoMsg.classList.add("hidden");
  }

  function updatePricingUI(sub, disc, total) {
    const elSub = document.getElementById("detail-subtotal");
    const elVoucher = document.getElementById("detail-voucher");
    const elTotal = document.getElementById("detail-total");

    if (elSub) elSub.textContent = `Rp${sub.toLocaleString('id-ID')}`;
    if (elVoucher) elVoucher.textContent = `- Rp${disc.toLocaleString('id-ID')}`;
    if (elTotal) elTotal.textContent = `Rp${total.toLocaleString('id-ID')}`;

    const discRow = document.getElementById("discount-row");
    const discDivider = document.getElementById("discount-divider");
    const displayPromo = document.getElementById("display-promo-code");

    if (disc > 0) {
      if (displayPromo) displayPromo.textContent = activePromo;
      if (discRow) {
        discRow.classList.remove("hidden");
        discRow.classList.add("flex");
      }
      if (discDivider) discDivider.classList.remove("hidden");
    } else {
      if (discRow) {
        discRow.classList.add("hidden");
        discRow.classList.remove("flex");
      }
      if (discDivider) discDivider.classList.add("hidden");
    }
  }

  async function proceedToPayment() {
    const btn = document.getElementById("btn-pay-now");
    const text = document.getElementById("btn-pay-now-text");
    const spinner = document.getElementById("btn-pay-now-spinner");

    if (btn) btn.disabled = true;
    if (text) text.classList.add("hidden");
    if (spinner) spinner.classList.remove("hidden");

    try {
      const userId = '{{user.id}}';
      const courseId = '{{course.id}}';
      const storageKey =
        typeof window.getPaymentProgressStorageKey === 'function'
          ? window.getPaymentProgressStorageKey()
          : `payment-${userId}-${courseId}-form`;

      let formData = null;
      if (storageKey) {
        const raw = localStorage.getItem(storageKey);
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            formData = parsed.forms && parsed.forms.form1 ? parsed.forms.form1 : null;
          } catch (e) {}
        }
      }

      const response = await fetch('/api/payment/create', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        credentials: 'same-origin',
        body: JSON.stringify({
          courseId: courseId,
          paymentMethod: 'Full Payment',
          promoCode: activePromo ? activePromo : null,
          formData: formData
        }),
      });

      const data = await response.json();

      if (response.ok && data.status === 'success') {
        window.location.href = data.redirect_url;
      } else {
        alert('Gagal memproses pembayaran: ' + (data.message || 'Unknown error'));
        if (btn) btn.disabled = false;
        if (text) text.classList.remove("hidden");
        if (spinner) spinner.classList.add("hidden");
      }
    } catch (error) {
      console.error('Payment Error:', error);
      alert('Terjadi kesalahan koneksi saat menghubungi server pembayaran.');
      if (btn) btn.disabled = false;
      if (text) text.classList.remove("hidden");
      if (spinner) spinner.classList.add("hidden");
    }
  }
</script>

<script>
  (function initPaymentMethodDraftStorage() {
    const userId = '{{user.id}}';
    const courseId = '{{course.id}}';
    if (!userId || !courseId) return;

    const storageKey =
      typeof window.getPaymentProgressStorageKey === 'function'
        ? window.getPaymentProgressStorageKey()
        : `payment-${userId}-${courseId}-form`;

    const promoInput = document.getElementById('promo-input');
    if (!promoInput) return;

    const readDraft = () => {
      const raw = localStorage.getItem(storageKey);
      if (!raw) return null;

      try {
        return JSON.parse(raw);
      } catch (error) {
        return null;
      }
    };

    let lastSavedPayload = null;

    const collectForm2 = () => ({
      paymentMethod: 'Full Payment',
      voucherDiscount: (promoInput.value || '').trim().toUpperCase(),
    });

    const saveForm2IfChanged = () => {
      const existingDraft = readDraft() || {};
      const payload = {
        ...existingDraft,
        userId,
        courseId,
        form: Number(existingDraft.form) || Number(sessionStorage.getItem('currentPaymentStep') || 1),
        forms: {
          ...(existingDraft.forms || {}),
          form2: collectForm2(),
        },
      };

      const payloadString = JSON.stringify(payload);
      if (payloadString === lastSavedPayload) return;

      const existingRaw = localStorage.getItem(storageKey);
      if (existingRaw === payloadString) {
        lastSavedPayload = payloadString;
        return;
      }

      localStorage.setItem(storageKey, payloadString);
      lastSavedPayload = payloadString;
    };

    const applyForm2 = (form2) => {
      if (!form2) return;

      if (form2.voucherDiscount) {
        promoInput.value = form2.voucherDiscount;
        handlePromoInput();
      }
    };

    const bootstrap = () => {
      const existingDraft = readDraft();
      if (existingDraft?.forms?.form2) {
        applyForm2(existingDraft.forms.form2);
        lastSavedPayload = JSON.stringify(existingDraft);
      }

      promoInput.addEventListener('input', saveForm2IfChanged);
      promoInput.addEventListener('change', saveForm2IfChanged);
      document.addEventListener('payment:step-changed', saveForm2IfChanged);

      saveForm2IfChanged();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap);
    } else {
      bootstrap();
    }
  })();
</script>
