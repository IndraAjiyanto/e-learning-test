{{!--
  Partial: Registration Form (Step 1)
  Lokasi: src/views/partials/payments/registration.hbs
  Menggunakan komponen atomic & molekul dari components/ui
--}}

<form id="step-1-form" class="space-y-6 md:space-y-8 w-full">

  <!-- Program Batch Info -->
  {{> components/ui/input/static_field/index
    label="Program Batch"
    required=true
    value=(concat course.group " : " course.name)
  }}

  <!-- Full Name Field -->
  {{> components/ui/input/text/index
    name="fullName"
    id="fullName"
    type="text"
    label="Full Name"
    required=true
    value=user.username
    placeholder="Input Your Full Name"
  }}

  <!-- Email Field -->
  {{> components/ui/input/text/index
    name="email"
    id="email"
    type="email"
    label="Email"
    required=true
    value=user.email
    placeholder="Input Your Email"
  }}

  <!-- WhatsApp Number (Accent Variant with Chat Icon) -->
  {{> components/ui/input/text/index
    name="whatsappNumber"
    id="whatsappNumber"
    type="tel"
    label="WhatsApp Number"
    required=true
    value=user.no_telp
    placeholder="Input Your WhatsApp Number"
    icon="fa-regular fa-comment-dots"
    variant="accent"
  }}

  <!-- Referral Source Dropdown -->
  {{#> components/ui/dropdown/select/index
    name="source"
    id="source-input"
    label="How did you know About the Kesatria Academy Program?"
    required=true
    placeholder="Select How Did You Know"
  }}
    <option value="Friends">Friends</option>
    <option value="Social Media">Social Media</option>
    <option value="Website">Website</option>
    <option value="Other">Other</option>
  {{/components/ui/dropdown/select/index}}

  <!-- Agreement Box -->
  {{> components/ui/input/agreement_box/index
    name="agreement"
    id="agreement"
    required=true
    label="I agree to participate in the program until its completion"
    terms="By checking this box, you confirm your commitment to follow all learning sessions according to the scheduled curriculum."
  }}

  <!-- Next / Save Changes Button -->
  <div class="pt-4 w-full">
    {{> components/ui/button/btn_action/index
      text="Save Changes"
      type="button"
      variant="primary"
      class="w-full h-14 sm:h-[64px] rounded-[10px]"
      textClass="font-montserrat font-semibold text-base sm:text-xl text-white"
      icon="fa-solid fa-arrow-right text-lg ml-2"
      iconPosition="right"
      onClick="goToStep(2)"
    }}
  </div>

</form>

<script>
  (function initRegistrationDraftStorage() {
    const userId = '{{user.id}}';
    const courseId = '{{course.id}}';
    if (!userId || !courseId) return;

    const storageKey =
      typeof window.getPaymentProgressStorageKey === 'function'
        ? window.getPaymentProgressStorageKey()
        : `payment-${userId}-${courseId}-form`;
    const form = document.getElementById('step-1-form');
    if (!form) return;

    const readDraft = () => {
      const raw = localStorage.getItem(storageKey);
      if (!raw) return null;

      try {
        return JSON.parse(raw);
      } catch (error) {
        return null;
      }
    };

    const getCurrentProgress = () => {
      const fromSession = Number(sessionStorage.getItem('currentPaymentStep') || 1);
      const draft = readDraft();
      return Number(draft?.form) || fromSession || 1;
    };

    const collectFormData = () => {
      const fullName = form.querySelector('input[name="fullName"]')?.value?.trim() || '';
      const email = form.querySelector('input[name="email"]')?.value?.trim() || '';
      const whatsappNumber = form.querySelector('input[name="whatsappNumber"]')?.value?.trim() || '';
      const sourceInput = form.querySelector('input[name="source"], select[name="source"]');
      const source = sourceInput?.value || '';
      const agreement = Boolean(form.querySelector('input[name="agreement"]')?.checked);

      return {
        fullName,
        email,
        whatsappNumber,
        source,
        agreement,
      };
    };

    const applySourceValue = (sourceValue) => {
      if (!sourceValue) return;
      const selectElement = form.querySelector('select[name="source"]');
      if (selectElement) {
        selectElement.value = sourceValue;
        return;
      }
      const sourceContainer = document.getElementById('dropdown-source');
      if (!sourceContainer || typeof sourceContainer.__selectOptionByValue !== 'function') return;
      sourceContainer.__selectOptionByValue(sourceValue);
    };

    const applyDraft = (draft) => {
      if (!draft) return;

      const form1 = draft.forms?.form1 || draft.formData;
      if (!form1) return;

      const { fullName, email, whatsappNumber, source, agreement } = form1;

      const fullNameInput = form.querySelector('input[name="fullName"]');
      const emailInput = form.querySelector('input[name="email"]');
      const whatsappInput = form.querySelector('input[name="whatsappNumber"]');
      const agreementInput = form.querySelector('input[name="agreement"]');

      if (fullNameInput && fullName) fullNameInput.value = fullName;
      if (emailInput && email) emailInput.value = email;
      if (whatsappInput && whatsappNumber) whatsappInput.value = whatsappNumber;
      if (agreementInput) agreementInput.checked = Boolean(agreement);
      applySourceValue(source);
    };

    let lastSavedPayload = null;

    const saveDraftIfChanged = () => {
      const existingDraft = readDraft() || {};
      const payload = {
        ...existingDraft,
        userId,
        courseId,
        form: getCurrentProgress(),
        forms: {
          ...(existingDraft.forms || {}),
          form1: collectFormData(),
        },
      };
      const payloadString = JSON.stringify(payload);
      if (payloadString === lastSavedPayload) return;

      const existingRaw = localStorage.getItem(storageKey);
      if (existingRaw === payloadString) {
        lastSavedPayload = payloadString;
        return;
      }

      localStorage.setItem(storageKey, payloadString);
      lastSavedPayload = payloadString;
    };

    const bootstrap = () => {
      const existingDraft = readDraft();
      if (existingDraft) {
        applyDraft(existingDraft);
        lastSavedPayload = JSON.stringify(existingDraft);
      }

      form.addEventListener('input', saveDraftIfChanged);
      form.addEventListener('change', saveDraftIfChanged);
      document.addEventListener('payment:step-changed', saveDraftIfChanged);

      saveDraftIfChanged();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap);
    } else {
      bootstrap();
    }
  })();
</script>
