<form id="step-1-form" class="space-y-6">
  
  <!-- Your Program -->
  <div>
    <label class="block text-2xl md:text-3xl text-[#003060] font-montserrat font-semibold mb-7">
      Your Program<span class="text-red-500">*</span>
    </label>
    <span class="font-montserrat font-medium text-base sm:text-xl text-black mb-7">
      {{course.group}} : {{course.name}}</span>
  </div>

  <!-- Full Name -->
  <div>
    <label class="block text-2xl md:text-3xl text-[#003060] font-montserrat font-semibold mb-7">
      Full Name<span class="text-red-500">*</span>
    </label>
    <input type="text" name="fullName" required placeholder="Input Your Full Name" class="w-full max-w-[760px] h-[60px] rounded-[6px] p-[10px] mb-4 bg-white shadow-[0_0_5px_rgba(0,0,0,0.5)] focus:outline-none focus:ring-1 focus:ring-[#0B3A68] text-slate-700 placeholder:text-slate-400" value="{{user.username}}">
  </div>

  <!-- Email -->
  <div>
    <label class="block text-2xl md:text-3xl text-[#003060] font-montserrat font-semibold mb-7">
      Email<span class="text-red-500">*</span>
    </label>
    <input type="email" name="email" required placeholder="Input Your Email" class="w-full max-w-[760px] h-[60px] rounded-[6px] p-[10px] mb-4 bg-white shadow-[0_0_5px_rgba(0,0,0,0.5)] focus:outline-none focus:ring-1 focus:ring-[#0B3A68] text-slate-700 placeholder:text-slate-400" value="{{user.email}}">
  </div>

  <!-- WhatsApp Number -->
  <div>
    <label class="block text-2xl md:text-3xl text-[#003060] font-montserrat font-semibold mb-7">
      WhatsApp Number<span class="text-red-500">*</span>
    </label>
    <input type="tel" required placeholder="Input Your WhatsApp Number" class="w-full max-w-[760px] h-[60px] rounded-[6px] p-[10px] mb-4 bg-white shadow-[0_0_5px_rgba(0,0,0,0.5)] focus:outline-none focus:ring-1 focus:ring-[#0B3A68] text-slate-700 placeholder:text-slate-400" value="{{user.no_telp}}">
  </div>

  <!-- How did you know -->
  <div>
    <label class="block text-2xl md:text-3xl text-[#003060] font-montserrat font-semibold mb-7">
      How did you know About the Kesatria Academy Program?<span class="text-red-500">*</span>
    </label>
    
    <div class="relative w-full max-w-[760px] mb-4 custom-dropdown" id="dropdown-source">
      <input type="hidden" id="source-input" name="source" required value="">
      
      <button 
        type="button" 
        class="dropdown-trigger w-full max-w-[760px] h-[60px] rounded-[12px] p-[10px] px-6 bg-white shadow-[0_0_5px_rgba(0,0,0,0.5)] focus:outline-none focus:ring-2 focus:ring-[#003060] flex items-center justify-between cursor-pointer transition-all duration-200"
        aria-expanded="false"
        aria-haspopup="listbox"
      >
        <span class="dropdown-label font-montserrat font-medium text-xl text-[#676767] truncate pr-4">
          Select How Did You Know
        </span>
        <div class="size-[35px] flex items-center justify-center flex-shrink-0">
          <i class="dropdown-chevron text-xl text-[#003060] fa-solid fa-chevron-down transition-transform duration-200 ease-out"></i>
        </div>
      </button>

      <ul 
        class="dropdown-menu absolute left-0 right-0 top-full mt-2 bg-white rounded-[12px] shadow-lg border border-[#E2E8F0] p-2 z-50 invisible opacity-0 -translate-y-2 scale-95 transition-all duration-200 ease-out origin-top font-montserrat max-h-60 overflow-y-auto"
        role="listbox"
      >
        <li role="option" aria-selected="false" data-value="Friends" class="dropdown-option px-4 py-3 rounded-lg text-base sm:text-xl font-medium cursor-pointer transition-colors text-slate-700 hover:bg-[#E0F1F9]/50 hover:text-[#003060] flex items-center justify-between">
          <span>Friends</span>
        </li>
        <li role="option" aria-selected="false" data-value="Social Media" class="dropdown-option px-4 py-3 rounded-lg text-base sm:text-xl font-medium cursor-pointer transition-colors text-slate-700 hover:bg-[#E0F1F9]/50 hover:text-[#003060] flex items-center justify-between">
          <span>Social Media</span>
        </li>
        <li role="option" aria-selected="false" data-value="Website" class="dropdown-option px-4 py-3 rounded-lg text-base sm:text-xl font-medium cursor-pointer transition-colors text-slate-700 hover:bg-[#E0F1F9]/50 hover:text-[#003060] flex items-center justify-between">
          <span>Website</span>
        </li>
        <li role="option" aria-selected="false" data-value="Other" class="dropdown-option px-4 py-3 rounded-lg text-base sm:text-xl font-medium cursor-pointer transition-colors text-slate-700 hover:bg-[#E0F1F9]/50 hover:text-[#003060] flex items-center justify-between">
          <span>Other</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Agreement -->
  <div class="pt-4 pb-2">
    <label class="block text-2xl md:text-3xl text-[#003060] font-montserrat font-semibold mb-7">
      I agree to participate in the program until its completion
    </label>
    <label class="flex items-center gap-3 cursor-pointer group w-fit">
      <div class="relative flex items-center justify-center">
        <input type="checkbox" required class="peer appearance-none w-5 h-5 border border-slate-300 rounded-sm bg-white checked:bg-[#0B3A68] checked:border-[#0B3A68] transition-all cursor-pointer">
        <i class="fa-solid fa-check w-3.5 h-3.5 flex items-center justify-center text-white absolute opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity"></i>
      </div>
      <span class="text-slate-700 group-hover:text-[#0B3A68] transition-colors font-montserrat font-medium text-base sm:text-2xl">Yes, I agree</span>
    </label>
  </div>

  <!-- Next Button -->
  <div class="pt-4 max-w-[760px]">
    <button type="button" onclick="goToStep(2)" class="w-full h-[56px] bg-[#003060] hover:bg-[#082a4d] text-white text-lg rounded-[12px] border border-[#003060] shadow-[0_0_4px_rgba(0,0,0,0.5)] flex items-center justify-center gap-[20px] font-semibold transition-colors">
      <span>Next</span>
      <i class="fa-solid fa-arrow-right text-xl pt-0.5"></i>
    </button>
  </div>
</form>

<script>
  (function initCustomDropdowns() {
    function setupDropdowns() {
      const dropdownContainers = document.querySelectorAll('.custom-dropdown');

      dropdownContainers.forEach(container => {
        const trigger = container.querySelector('.dropdown-trigger');
        const menu = container.querySelector('.dropdown-menu');
        const chevron = container.querySelector('.dropdown-chevron');
        const label = container.querySelector('.dropdown-label');
        const hiddenInput = container.querySelector('input[type="hidden"]');
        const options = container.querySelectorAll('.dropdown-option');

        if (!trigger || !menu) return;

        let isOpen = false;
        let highlightedIndex = -1;

        function toggleDropdown(forceState) {
          isOpen = forceState !== undefined ? forceState : !isOpen;

          trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

          if (isOpen) {
            dropdownContainers.forEach(otherContainer => {
              if (otherContainer !== container) {
                const otherTrigger = otherContainer.querySelector('.dropdown-trigger');
                const otherMenu = otherContainer.querySelector('.dropdown-menu');
                const otherChevron = otherContainer.querySelector('.dropdown-chevron');
                if (otherMenu && !otherMenu.classList.contains('invisible')) {
                  otherMenu.classList.add('invisible', 'opacity-0', '-translate-y-2', 'scale-95');
                  otherMenu.classList.remove('visible', 'opacity-100', 'translate-y-0', 'scale-100');
                  if (otherChevron) otherChevron.classList.remove('rotate-180');
                  if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
                }
              }
            });

            menu.classList.remove('invisible', 'opacity-0', '-translate-y-2', 'scale-95');
            menu.classList.add('visible', 'opacity-100', 'translate-y-0', 'scale-100');
            if (chevron) chevron.classList.add('rotate-180');

            highlightedIndex = Array.from(options).findIndex(opt => opt.getAttribute('aria-selected') === 'true');
            if (highlightedIndex >= 0) {
              updateFocusedOption(highlightedIndex);
            }
          } else {
            menu.classList.add('invisible', 'opacity-0', '-translate-y-2', 'scale-95');
            menu.classList.remove('visible', 'opacity-100', 'translate-y-0', 'scale-100');
            if (chevron) chevron.classList.remove('rotate-180');
            highlightedIndex = -1;
          }
        }

        function updateFocusedOption(index) {
          options.forEach((opt, idx) => {
            if (idx === index) {
              opt.classList.add('ring-2', 'ring-[#003060]');
              opt.scrollIntoView({ block: 'nearest' });
            } else {
              opt.classList.remove('ring-2', 'ring-[#003060]');
            }
          });
        }

        function selectOption(option) {
          const selectedValue = option.getAttribute('data-value');
          
          if (hiddenInput) {
            hiddenInput.value = selectedValue;
          }

          if (label) {
            label.textContent = selectedValue;
            label.classList.remove('text-[#676767]', 'text-slate-400');
            label.classList.add('text-black');
          }

          options.forEach(opt => {
            const isSelected = opt === option;
            opt.setAttribute('aria-selected', isSelected ? 'true' : 'false');

            const checkIcon = opt.querySelector('.fa-check');
            if (isSelected) {
              opt.className = 'dropdown-option px-4 py-3 rounded-lg text-base sm:text-xl font-medium cursor-pointer transition-colors text-[#003060] bg-[#003060]/10 font-semibold flex items-center justify-between';
              if (!checkIcon) {
                opt.insertAdjacentHTML('beforeend', '<i class="fa-solid fa-check text-sm text-[#003060]"></i>');
              }
            } else {
              opt.className = 'dropdown-option px-4 py-3 rounded-lg text-base sm:text-xl font-medium cursor-pointer transition-colors text-slate-700 hover:bg-[#E0F1F9]/50 hover:text-[#003060] flex items-center justify-between';
              if (checkIcon) {
                checkIcon.remove();
              }
            }
          });

          toggleDropdown(false);
          trigger.focus();
        }

        trigger.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          toggleDropdown();
        });

        options.forEach(option => {
          option.addEventListener('click', function (e) {
            e.stopPropagation();
            selectOption(option);
          });
        });

        trigger.addEventListener('keydown', function (e) {
          if (['Enter', ' ', 'ArrowDown', 'ArrowUp', 'Escape'].includes(e.key)) {
            e.preventDefault();
          }

          if (e.key === 'Enter' || e.key === ' ') {
            if (!isOpen) {
              toggleDropdown(true);
            } else if (highlightedIndex >= 0 && options[highlightedIndex]) {
              selectOption(options[highlightedIndex]);
            }
          } else if (e.key === 'Escape') {
            toggleDropdown(false);
          } else if (e.key === 'ArrowDown') {
            if (!isOpen) {
              toggleDropdown(true);
            } else {
              highlightedIndex = (highlightedIndex + 1) % options.length;
              updateFocusedOption(highlightedIndex);
            }
          } else if (e.key === 'ArrowUp') {
            if (!isOpen) {
              toggleDropdown(true);
            } else {
              highlightedIndex = (highlightedIndex - 1 + options.length) % options.length;
              updateFocusedOption(highlightedIndex);
            }
          }
        });

        document.addEventListener('click', function (e) {
          if (!container.contains(e.target) && isOpen) {
            toggleDropdown(false);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupDropdowns);
    } else {
      setupDropdowns();
    }
  })();
</script>
