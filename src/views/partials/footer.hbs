<footer class="bg-[#003060] font-montserrat text-white">
  <div class="page-shell py-14 lg:py-16">

    <div class="mb-10 flex justify-center lg:mb-12">
      <img src="/public/image/logo_kotak_putih.png" alt="Kesatria Academy" class="h-16 w-auto object-contain lg:h-20" />
    </div>

    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1.2fr] lg:gap-12">

      {{!-- Address --}}
      <div class="flex flex-col gap-4">
        <h3 class="flex items-center gap-2 {{sizeClass 'h3'}} font-bold uppercase tracking-wide">
          <i class="fas fa-location-dot text-[#6EB6E5]"></i>{{t 'test.footer.address'}}
        </h3>
        <ul class="flex flex-col gap-3 {{sizeClass 'body-sm'}} font-open-sans text-white/90">
          <li class="flex items-start gap-3">
            <i class="fas fa-building mt-1 shrink-0 text-white/70"></i>
            <span>{{#if footerData.address}}{{footerData.address}}{{else}}Jl. S. Parman No.62, Karangbawang, Purwokerto Kulon, Kec. Purwokerto Sel., Kabupaten Banyumas, Jawa Tengah 53141{{/if}}</span>
          </li>
          <li class="flex items-center gap-3">
            <i class="fas fa-envelope shrink-0 text-white/70"></i>
            <a href="mailto:{{default footerData.email 'kesatriaacademy@gmail.com'}}" class="transition hover:text-white">{{default footerData.email 'kesatriaacademy@gmail.com'}}</a>
          </li>
          <li class="flex items-center gap-3">
            <i class="fas fa-phone shrink-0 text-white/70"></i>
            <span>{{default footerData.number '+62 896 4683 4607'}}</span>
          </li>
        </ul>
      </div>

      {{!-- Quick links --}}
      <div class="flex flex-col gap-4">
        <h3 class="{{sizeClass 'h3'}} font-bold uppercase tracking-wide">{{t 'test.footer.quickLinks'}}</h3>
        <ul class="flex flex-col gap-3 {{sizeClass 'body-sm'}} font-open-sans text-white/90">
          <li><a href="/dashboard" class="transition hover:text-white">{{t 'test.footer.home'}}</a></li>
          <li><a href="/dashboard/about" class="transition hover:text-white">{{t 'test.footer.aboutUs'}}</a></li>
          <li><a href="/dashboard#programs-section" class="transition hover:text-white">{{t 'test.footer.program'}}</a></li>
          <li><a href="/dashboard/alumni" class="transition hover:text-white">{{t 'test.footer.alumni'}}</a></li>
          <li><a href="/dashboard/gallery" class="transition hover:text-white">{{t 'test.footer.gallery'}}</a></li>
        </ul>
      </div>

      {{!-- Our program --}}
      <div class="flex flex-col gap-4">
        <h3 class="{{sizeClass 'h3'}} font-bold uppercase tracking-wide">{{t 'test.footer.ourProgram'}}</h3>
        <ul class="flex flex-col gap-3 {{sizeClass 'body-sm'}} font-open-sans text-white/90">
          {{#if footerCategories.length}}
            {{#each footerCategories}}
              <li><a href="/category/program/{{this.name}}" class="transition hover:text-white">{{this.name}}</a></li>
            {{/each}}
          {{else}}
            <li><a href="/category/program/Bootcamp" class="transition hover:text-white">Bootcamp</a></li>
            <li><a href="/category/program/Short%20Class" class="transition hover:text-white">Short Class</a></li>
            <li><a href="/dashboard/corporate-training" class="transition hover:text-white">In House Training</a></li>
            <li><a href="/dashboard/mpp" class="transition hover:text-white">Wiratek Internship Program</a></li>
          {{/if}}
        </ul>
      </div>
    </div>

    {{!-- Follow us --}}
    <div class="mt-12 flex flex-col items-center gap-5 border-t border-white/15 pt-10">
      <div class="flex items-center gap-8">
        <span class="{{sizeClass 'h3'}} font-bold uppercase tracking-wide">{{t 'test.footer.followUs'}}</span>
        <div class="flex items-center gap-6">
          <a href="{{default footerData.linkedin '#'}}" target="_blank" rel="noopener" class="text-2xl transition hover:opacity-80" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>
          <a href="{{default footerData.instagram '#'}}" target="_blank" rel="noopener" class="text-2xl transition hover:opacity-80" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
          <a href="{{default footerData.youtube '#'}}" target="_blank" rel="noopener" class="text-2xl transition hover:opacity-80" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/15 py-5">
    <p class="page-shell text-center {{sizeClass 'body-sm'}} text-white/80">
      {{{t 'test.footer.copyright'}}}
    </p>
  </div>
</footer>
