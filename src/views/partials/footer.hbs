<footer
  class='bg-gradient-to-tr from-primary via-secondary to-gray-800 text-white py-12'
>
  <div class='max-w-7xl mx-auto px-6'>
    <div class='text-center'>

        <div class='rounded-lg flex items-center justify-center mb-5'>
          <img src='/public/image/logo_kotak_putih.png' class="w-auto h-10" alt='Kesatria Academy Logo' />

      </div>
      <p class='text-white mb-6 font-inter text-lg'>
        {{t 'test.footer.description'}}
      </p>
      <div class='flex justify-center space-x-6'>
        <a href='#' class='text-white hover:text-white transition-colors'>{{t
            'test.footer.privacyPolicy'
          }}</a>
        <a href='#' class='text-white hover:text-white transition-colors'>{{t
            'test.footer.termsOfService'
          }}</a>
        <a href='#' class='text-white hover:text-white transition-colors'>{{t
            'test.footer.faq'
          }}</a>
      </div>
      <div class='mt-8 pt-8 border-t border-textSecondary/30'>
        <p class='text-white'>{{t 'test.footer.copyright'}}</p>
      </div>
    </div>
  </div>
</footer>