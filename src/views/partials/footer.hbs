<footer class='bg-secondary text-white py-12'>
  <div class='max-w-7xl mx-auto px-6'>
    <div class='text-white'>

      <div class='rounded-lg flex items-center justify-center mb-5'>
        <img
          src='/public/image/logo_kotak_putih.png'
          class='w-auto h-20'
          alt='Kesatria Academy Logo'
        />

      </div>

      <div class='flex justify-between space-x-6'>
        <div class='md:col-span-6 lg:col-span-5'>
          <h3 class='text-lg font-bold mb-6 flex items-center gap-2 uppercase'>
            <svg
              class='w-5 h-5'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z'
              ></path>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M15 11a3 3 0 11-6 0 3 3 0 016 0z'
              ></path>
            </svg>
            {{t 'test.footer.address'}}
          </h3>
          <ul class='space-y-4 max-w-xl text-white-300'>
            <li class='flex items-start gap-3'>
              <svg
                class='w-5 h-5 flex-shrink-0'
                fill='none'
                stroke='currentColor'
                viewBox='0 0 24 24'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
              >
                <!-- Gedung Tinggi di Belakang -->
                <path d='M9 21V6a2 2 0 012-2h4a2 2 0 012 2v6' />

                <!-- Jendela-jendela Kecil Bulat pada Gedung Belakang -->
                <circle cx='12' cy='7' r='0.5' fill='currentColor' />
                <circle cx='14' cy='7' r='0.5' fill='currentColor' />
                <circle cx='12' cy='10' r='0.5' fill='currentColor' />
                <circle cx='14' cy='10' r='0.5' fill='currentColor' />
                <circle cx='12' cy='13' r='0.5' fill='currentColor' />
                <circle cx='14' cy='13' r='0.5' fill='currentColor' />

                <!-- Rumah di Bagian Depan (Menimpa Gedung) -->
                <!-- Menggunakan latar belakang gelap (fill) tipis agar struktur gedung di belakangnya tertutup rapi -->
                <path
                  d='M12 14l5-4 5 4v6a2 2 0 01-2 2h-6a2 2 0 01-2-2v-6z'
                  fill='#0b2240'
                />
                <path d='M12 14l5-4 5 4v6a2 2 0 01-2 2h-6a2 2 0 01-2-2v-6z' />

                <!-- Pintu Melengkung pada Rumah Depan -->
                <path d='M15 22v-3a2 2 0 014 0v3' />
              </svg>

              <p>Jl. S. Parman No.62, Karangbawang, Purwokerto Kulon, Kec. Purwokerto Sel., Kabupaten Banyumas, Jawa Tengah 53141</p>
            </li>
            <li class='flex items-center gap-3'>
              <svg
                class='w-5 h-5 flex-shrink-0'
                fill='none'
                stroke='currentColor'
                viewBox='0 0 24 24'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
              >
                <!-- Kotak Luar Amplop dengan Sudut Melengkung -->
                <rect x='2' y='4' width='20' height='16' rx='4' ry='4'></rect>
                <!-- Garis Lipatan Amplop (Bentuk V) -->
                <path d='M22 6l-10 7L2 6'></path>
              </svg>
              <a
                href='mailto:kesatriaacademy@gmail.com'
                class='hover:text-white transition-colors'
              >kesatriaacademy@gmail.com</a>
            </li>
            <li class='flex items-center gap-3'>
              <svg
                class='w-5 h-5 flex-shrink-0'
                fill='none'
                stroke='currentColor'
                viewBox='0 0 24 24'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
              >
                <!-- Jalur Garis Gagang Telepon Miring -->
                <path
                  d='M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z'
                ></path>
              </svg>

              <p>+62 895 6184 52602</p>
            </li>
          </ul>
        </div>

        {{! PUNYA QUICK LINK }}
        <div class='md:col-span-3 lg:col-span-4'>
          <h3 class='text-lg font-bold mb-6 flex items-center gap-2 uppercase'>

            Quick Links
          </h3>
          <ul class='space-y-3 text-gray-300'>
            <li><a
                href='/dashboard'
                class='flex items-center gap-2 hover:text-white transition-colors'
              >{{t 'test.footer.home'}}</a></li>
            <li><a
                href='/dashboard/about'
                class='flex items-center gap-2 hover:text-white transition-colors'
              >{{t 'test.footer.aboutUs'}}</a></li>
            <li><a
                href='/dashboard/#courses-section'
                class='flex items-center gap-2 hover:text-white transition-colors'
              >{{t 'test.footer.program'}}</a></li>
            <li><a
                href='/dashboard/alumni'
                class='flex items-center gap-2 hover:text-white transition-colors'
              >{{t 'test.footer.alumni'}}</a></li>
            <li><a
                href='/dashboard/gallery'
                class='flex items-center gap-2 hover:text-white transition-colors'
              >{{t 'test.footer.gallery'}}</a></li>
          </ul>
        </div>

        {{! PUNYA OUR PROGRAM }}
        <div class='md:col-span-3 lg:col-span-4'>
          <h3 class='text-lg font-bold mb-6 flex items-center gap-2 uppercase'>
            Our Program
          </h3>
          <ul class='space-y-3 text-gray-300'>
            {{#each footerCategories}}
            <li><a
                href='/category/program/{{this.name}}'
                class='flex items-center gap-2 hover:text-white transition-colors'
              >{{this.name}}</a></li>
            {{/each}}
          </ul>
        </div>
      </div>

      <div class='mt-8 pt-8 flex flex-col md:flex-row justify-between'></div>
      <div class='md:col-span-3 lg:col-span-3 flex justify-center'>
        <h3
          class='text-lg font-bold mb-6 flex justify-center items-center gap-8 uppercase'
        >
          <svg
            class='w-5 h-5'
            fill='none'
            stroke='currentColor'
            viewBox='0 0 24 24'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z'
            >
            </path>
          </svg>
          FOLLOW US

          {{! LOGO LINKEDIN }}
          <a
            href='{{footerData.linkedin}}'
            class='rounded hover:opacity-80 transition'
          ><svg
              class='w-5 h-5'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'
            >
              <!-- Kotak Utama LinkedIn -->
              <rect
                x='2'
                y='2'
                width='20'
                height='20'
                rx='0'
                ry='0'
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
              ></rect>
              <!-- Huruf 'i' (Garis bawah dan titik atas) -->
              <line
                x1='8'
                y1='11'
                x2='8'
                y2='17'
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
              >
              </line>
              <line
                x1='8'
                y1='7'
                x2='8.01'
                y2='7'
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
              >
              </line>
              <!-- Huruf 'n' (Garis melengkung) -->
              <path
                d='M12 11c0-1.1-.9-2-2-2s-2 .9-2 2v6'
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                class='hidden'
              ></path>
              <path
                d='M12 17v-6a3 3 0 016 0v6'
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
              ></path>
            </svg>
          </a>

          {{! LOGO INSTAGRAM }}
          <a
            href='{{footerData.instagram}}'
            class='rounded hover:opacity-80 transition'
          >
            <svg
              class='w-5 h-5'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'
            >
              <!-- Kotak Utama Instagram -->
              <rect
                x='2'
                y='2'
                width='20'
                height='20'
                rx='5'
                ry='5'
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
              ></rect>
              <!-- Lingkaran Lensa Tengah -->
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z'
              ></path>
              <!-- Titik Flash Kamera -->
              <line
                x1='17.5'
                y1='6.5'
                x2='17.51'
                y2='6.5'
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
              ></line>
            </svg>
          </a>

          {{! LOGO YOUTUBE }}
          <a
            href='{{footerData.youtube}}'
            class='rounded hover:opacity-80 transition'
          ><svg
              class='w-5 h-5'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'
            >
              <!-- Kotak Luar/Layar YouTube -->
              <rect
                x='2'
                y='4'
                width='20'
                height='16'
                rx='5'
                ry='5'
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
              ></rect>
              <!-- Segitiga Play di Tengah -->
              <path
                d='M10 9l5 3-5 3V9z'
                fill='currentColor'
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
              ></path>
            </svg>
          </a>
        </h3>
      </div>

      {{! <div class='mt-8 pt-8 border-t border-textSecondary/30 flex flex-col md:flex-row justify-between'> }}

      <div class='flex items-center justify-center space-x-4'>
        <p class='mb-4 md:mb-0'>{{{t 'test.footer.copyright'}}}</p>
        {{!-- <a href='#' class='text-white hover:text-white transition-colors'>{{t
            'test.footer.privacyPolicy'
            }}</a>
          <span class="text-gray-600">|</span> <a href='#' class='hover:text-white transition-colors'>{{t
            'test.footer.termsOfService'}}</a> --}}
      </div>
      {{!
      </div> }}

    </div>
  </div>


</footer>