  <!-- Session List Section -->
  {{!--
    Design: slicing.pen "Container - Meeting Detail" Rows
    Row: min-h68 h-fit white, radius 8, stroke #D9D9D9, gap 6, p8 14
    Texts: topic Montserrat 14/600 #003060 + meta (timer/map-pin/calendar 16px #718096, Montserrat 14 #718096)
    Delete: 44x44 white stroke #D9D9D9, trash-2 16px #C80606
    Detail: 81x44 white stroke #003060 + shadow, Inter 16/600 #003060
    Add Session: full-width h44 white, solid 1px #3B82F6 + shadow, Inter 16/600 #3B82F6
    Data: Alpine `data` (sessionData().fetchSessions -> GET /week/session/:weeksId)
  --}}
  <template x-if="data && data.length > 0">
    <div class='flex flex-col gap-[10px] w-full mb-[10px]'>
      <template x-for="session in data" :key="session.id">
        <div class='box-border w-full shrink-0 min-h-[68px] h-fit flex flex-row gap-[6px] p-[8px_14px] justify-start items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] hover:bg-[#fafafa] transition-colors'>

          {{!-- Texts + Meta --}}
          <div class='flex flex-col gap-[6px] flex-1 min-w-0 justify-center items-start'>
            <div class='text-[14px]/[normal] w-full text-[#003060] font-montserrat font-semibold whitespace-nowrap overflow-hidden text-ellipsis' x-text='session.topic' :title='session.topic'></div>
            <div class='flex flex-row flex-wrap gap-x-[16px] gap-y-[4px] w-full justify-start items-center'>
              <div class='flex flex-row gap-[4px] justify-start items-center'>
                <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#718096' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px] shrink-0'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg>
                <span class='text-[14px]/[normal] text-[#718096] font-montserrat font-normal whitespace-nowrap' x-text="formatTime(session.startTime) + ' - ' + formatTime(session.endTime)"></span>
              </div>
              <div class='flex flex-row gap-[4px] justify-start items-center'>
                <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#718096' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px] shrink-0'><path d='M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z'/><circle cx='12' cy='10' r='3'/></svg>
                <span class='text-[14px]/[normal] text-[#718096] font-montserrat font-normal whitespace-nowrap overflow-hidden text-ellipsis' x-text='session.location' :title='session.location'></span>
              </div>
              <div class='flex flex-row gap-[4px] justify-start items-center'>
                <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#718096' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px] shrink-0'><rect width='18' height='18' x='3' y='4' rx='2' ry='2'/><line x1='16' x2='16' y1='2' y2='6'/><line x1='8' x2='8' y1='2' y2='6'/><line x1='3' x2='21' y1='10' y2='10'/></svg>
                <span class='text-[14px]/[normal] text-[#718096] font-montserrat font-normal whitespace-nowrap' x-text='formatDate(session.date)'></span>
              </div>
            </div>
          </div>

          {{!-- Delete --}}
          <form :action="'/session/' + session.id + '/{{weeks.id}}?_method=DELETE'" method='POST' class='box-border w-[44px] shrink-0 h-[44px]'>
            <button type='button'
              @click='confirmSessionDelete($el)'
              class='box-border w-[44px] h-[44px] flex flex-row gap-0 justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] hover:bg-[#FEF2F2] transition-colors'
              title='Delete Session' aria-label='Delete Session'>
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#C80606' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'>
                <path d='M3 6h18'/>
                <path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/>
                <path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/>
                <line x1='10' x2='10' y1='11' y2='17'/>
                <line x1='14' x2='14' y1='11' y2='17'/>
              </svg>
            </button>
          </form>

          {{!-- Detail --}}
          <a :href="'/session/' + session.id"
            class='box-border w-[81px] shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#003060] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#F0F7FF] transition-colors'
            title='Session Detail' aria-label='Session Detail'>
            <span class='text-[16px]/[normal] text-[#003060] font-inter font-semibold whitespace-nowrap'>Detail</span>
          </a>

        </div>
      </template>
    </div>
  </template>

  <!-- Empty State -->
  <template x-if="!data || data.length === 0">
    <div class='w-full h-[72px] flex items-center justify-center mb-[10px]'>
      <span class='font-inter text-sm text-[#A3A3A3]'>No session yet. Click Add Session to create one.</span>
    </div>
  </template>

{{#if lastSession}}
{{else}}
  <a href='/session/formCreate/{{weeks.id}}'
    class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#3B82F6] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#F0F7FF] transition-colors'>
    <span class='text-[16px]/[normal] text-[#3B82F6] font-inter font-semibold whitespace-nowrap'>Add Session</span>
  </a>
{{/if}}

<script>
function confirmSessionDelete(el) {
  Swal.fire({
    title: 'Delete Session',
    text: 'Are you sure you want to delete this session?',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#C80606',
    cancelButtonColor: '#525252',
    confirmButtonText: 'Delete'
  }).then((result) => {
    if (result.isConfirmed) {
      el.closest('form').submit();
    }
  });
}

function sessionData() {
  return {
    data: JSON.parse(localStorage.getItem('activeData')) || [],

    async fetchSessions() {
      const res = await fetch(`/week/session/{{weeks.id}}`);
      this.data = await res.json();

      localStorage.setItem('activeData', JSON.stringify(this.data));
    },

        formatDate(value) {
      const options = { year: 'numeric', month: 'long', day: 'numeric' };
      return new Date(value).toLocaleDateString('id-ID', options);
    },

formatTime(value) {
  return value ? value.slice(0, 5) : '';
},
  }
}
</script>
