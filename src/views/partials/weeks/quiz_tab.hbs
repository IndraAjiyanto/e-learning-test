    <!-- Empty State -->
    <template x-if="!data || data.length === 0">
    <div
      class='flex flex-col items-center justify-center text-center py-16 bg-gray-50 border border-dashed rounded-lg mb-6'
    >
      <svg
        xmlns='http://www.w3.org/2000/svg'
        class='h-12 w-12 text-gray-400 mb-4'
        fill='none'
        viewBox='0 0 24 24'
        stroke='currentColor'
