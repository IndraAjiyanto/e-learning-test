<!-- ===================== TAB QUIZ ===================== -->
{{!--
  Rows: quiz-card component (min-h68, white, radius 8, stroke #D9D9D9)
  Meta: timer + duration, award + min score
  Delete: 44x44 trash-2 #C80606 with confirm
  Detail: 81x44 brand outline -> /quiz/:id
  Add Quiz: full-width h44 white, solid 1px #3B82F6 + shadow
  Data: Alpine `data` (quizData().fetchQuizzes -> GET /week/quiz/:weeksId)
--}}

<!-- Quiz List -->
<template x-if="data && data.length > 0">
  <div class='flex flex-col gap-[10px] w-full mb-[10px]'>
    <template x-for="quiz in data" :key="quiz.id">
      {{> components/ui/admin/quiz/quiz-card
        deleteAction="confirmQuizDelete($el)"
        deleteFormAction=(concat "'/quiz/' + quiz.id + '/" weeks.id "?_method=DELETE'")
        detailHref="'/quiz/' + quiz.id"
      }}
    </template>
  </div>
</template>

<!-- Empty State -->
<template x-if="!data || data.length === 0">
  <div class='w-full h-[72px] flex items-center justify-center mb-[10px]'>
    <span class='font-inter text-sm text-[#A3A3A3]'>No quiz yet. Click Add Quiz to create one.</span>
  </div>
</template>

<!-- Add Quiz Button -->
{{#if weeks.id}}
<a href='/quiz/formCreate/{{weeks.id}}'
  class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FFFFFF] rounded-[8px] [outline:1px_solid_#3B82F6] [outline-offset:-0.5px] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#F0F7FF] transition-colors'>
  <span class='text-[16px]/[normal] text-[#3B82F6] font-inter font-semibold whitespace-nowrap'>Add Quiz</span>
</a>
{{/if}}

<script>
function confirmQuizDelete(el) {
  Swal.fire({
    title: 'Delete Quiz',
    text: 'Are you sure you want to delete this quiz? Questions and scores will be removed too.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#C80606',
    cancelButtonColor: '#525252',
    confirmButtonText: 'Delete'
  }).then((result) => {
    if (result.isConfirmed) {
      el.closest('form').submit();
    }
  });
}

function quizData() {
  return {
    data: JSON.parse(localStorage.getItem('activeData')) || [],

    async fetchQuizzes() {
      const res = await fetch('/week/quiz/{{weeks.id}}');
      this.data = await res.json();

      localStorage.setItem('activeData', JSON.stringify(this.data));
    }
  }
}
</script>
