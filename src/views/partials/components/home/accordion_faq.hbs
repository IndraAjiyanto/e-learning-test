{{!-- 
  Komponen: Accordion FAQ (Khusus Halaman Home)
  Lokasi: src/views/partials/components/home/accordion_faq.hbs
  
  Props:
  - desktop : boolean (true untuk styling desktop)
  
  Catatan: Komponen ini bergantung pada Alpine.js `x-for="(faq, index) in faqs"`.
  Oleh karena itu, variabel `faq.question`, `faq.answer`, dan fungsi `toggle(index)` berasal dari Alpine state.
--}}

{{#if desktop}}
  <div class="border-b border-[#E0E0E0] overflow-hidden transition-all">
    <!-- Tombol Pertanyaan -->
    <button
      @click="toggle(index)"
      class="w-full text-left py-5 px-4 focus:outline-none flex items-center justify-between group transition-colors duration-300 hover:bg-[#003060]"
      :class="activeIndex === index ? 'bg-[#003060]' : 'bg-transparent'"
    >
      <div class="flex items-center gap-4">
        <!-- Bullet -->
        <div class="w-1.5 h-1.5 rounded-full flex-shrink-0 transition-colors duration-300 group-hover:bg-white"
             :class="activeIndex === index ? 'bg-white' : 'bg-[#0B1F3B]'"></div>
        <!-- Vertical Line -->
        <div class="w-[1px] h-5 flex-shrink-0 transition-colors duration-300 group-hover:bg-white/40"
             :class="activeIndex === index ? 'bg-white/40' : 'bg-gray-300'"></div>
        
        <h3 class="font-montserrat font-semibold text-xl leading-none tracking-normal transition-colors duration-300 group-hover:text-white" 
            :class="activeIndex === index ? 'text-white' : 'text-[#0F0F0F]'" 
            x-text="faq.question"></h3>
      </div>
      
      <!-- Icon Chevron -->
      <div class="flex-shrink-0 ml-4">
        <i class="fas fa-chevron-down text-base transition-transform duration-300 group-hover:text-white"
           :class="activeIndex === index ? 'text-white rotate-180' : 'text-[#8F8F8F]'">
        </i>
      </div>
    </button>
    
    <!-- Jawaban -->
    <div
      x-show="activeIndex === index"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 max-h-0"
      x-transition:enter-end="opacity-100 max-h-[500px]"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 max-h-[500px]"
      x-transition:leave-end="opacity-0 max-h-0"
      class="overflow-hidden bg-[#FAFAFA]"
    >
      <div class="p-6 pl-[42px]">
        <p class="font-sans font-[400] text-base leading-relaxed text-[#2D2D2D]" x-html="faq.answer"></p>
      </div>
    </div>
  </div>
{{else}}
  <div class="bg-white border border-[#D9D9D9] rounded-[16px] overflow-hidden shadow-[0px_4px_12px_0px_#00000010]">
    <!-- Button -->
    <button
      @click="toggle(index)"
      class="w-full text-left p-4 focus:outline-none flex items-center justify-between transition-colors duration-300"
      :class="activeIndex === index ? 'bg-[#003060] text-white' : 'bg-white text-[#0B1F3B]'"
    >
      <div class="flex items-center gap-3">
        <div class="w-1.5 h-1.5 rounded-full shrink-0"
             :class="activeIndex === index ? 'bg-white' : 'bg-[#0B1F3B]'"></div>
        <h3 class="font-montserrat font-semibold text-[15px] leading-snug" 
            :class="activeIndex === index ? 'text-white' : 'text-[#0B1F3B]'" 
            x-text="faq.question"></h3>
      </div>
      
      <div class="shrink-0 ml-3">
        <i class="fas fa-chevron-down text-sm transition-transform duration-300"
           :class="activeIndex === index ? 'text-white rotate-180' : 'text-[#8F8F8F]'">
        </i>
      </div>
    </button>
    
    <!-- Answer Panel -->
    <div 
      x-show="activeIndex === index" 
      x-collapse 
      class="bg-[#F8F9FA] px-4 py-4 border-t border-[#EAEAEA]"
    >
      <p class="font-sans font-normal text-[13px] leading-[20px] text-[#2D2D2D]" x-html="faq.answer"></p>
    </div>
  </div>
{{/if}}
