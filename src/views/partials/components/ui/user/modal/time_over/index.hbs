{{!--
  Komponen: Time Over Modal (User / Quiz)
  Lokasi: src/views/partials/components/ui/user/modal/time_over/index.hbs
  Standar desain: Modal dialog Alpine.js native konsisten dengan design system
  (backdrop-blur 16px, container max-w-[400px], border-8 circular badge, Inter font,
  dan tombol aksi full-width).

  Cara pakai:
  1. Render di template:
     {{> components/ui/user/modal/time_over/index}}
  2. Panggil:
     openTimeOverModal({ onConfirm: () => prepareAndSubmit() })
     atau langsung via timeOverSubmit()
--}}
<div
  x-data='timeOverModal()'
  x-show='open'
  x-cloak
  @time-over:open.window='show($event.detail)'
  @keydown.escape.window='confirm()'
  class='fixed inset-0 z-50 flex items-center justify-center bg-[#0a0a0a]/70 p-4 backdrop-blur-[16px]'
  @click.self='confirm()'
>
  <div
    role='dialog'
    aria-modal='true'
    aria-labelledby='time-over-modal-title'
    aria-describedby='time-over-modal-description'
    @keydown.tab.prevent='cycleFocus($event)'
    class='flex w-full max-w-[400px] flex-col gap-8 rounded-xl bg-white p-6 shadow-[0px_8px_8px_-4px_rgba(0,0,0,0.03),0px_20px_24px_-4px_rgba(0,0,0,0.08)]'
  >
    <div class='flex flex-col items-center gap-5'>
      <span
        class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-8 border-[#FEF2F2] bg-[#FEE2E2] text-[#B42318]'
      >
        <i class="fa-regular fa-clock text-[20px]"></i>
      </span>

      <div class='flex flex-col items-center gap-2'>
        <h2
          id='time-over-modal-title'
          class='text-center font-inter text-lg font-semibold leading-7 text-[#171717]'
          x-text='title'
        >{{default title "Time's Up!"}}</h2>

        <p
          id='time-over-modal-description'
          class='text-center font-inter text-sm font-normal leading-5 text-[#525252]'
          x-text='description'
        >{{default description 'Quiz time is over, submitting your answers.'}}</p>
      </div>
    </div>

    <div class='flex items-start'>
      <button
        type='button'
        x-ref='confirmButton'
        @click='confirm()'
        :disabled='submitting'
        class='inline-flex h-11 w-full cursor-pointer items-center justify-center rounded-lg border border-[#003060] bg-[#003060] px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#00254a] hover:bg-[#00254a] active:bg-[#001b36] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-80'
        x-text='confirmLabel'
      >{{default confirmLabel 'Submit Answers'}}</button>
    </div>
  </div>
</div>

<script>
  function openTimeOverModal(options = {}) {
    window.dispatchEvent(
      new CustomEvent('time-over:open', { detail: options || {} }),
    );
  }

  function timeOverModal() {
    return {
      open: false,
      title: "Time's Up!",
      description: 'Quiz time is over, submitting your answers.',
      confirmLabel: 'Submit Answers',
      onConfirmCallback: null,
      submitting: false,
      autoSubmitTimer: null,

      show(options = {}) {
        const opts = options || {};
        this.title = opts.title || "Time's Up!";
        this.description = opts.description || 'Quiz time is over, submitting your answers.';
        this.confirmLabel = opts.confirmLabel || 'Submit Answers';
        this.onConfirmCallback = typeof opts.onConfirm === 'function' ? opts.onConfirm : null;
        this.submitting = false;
        this.open = true;
        document.body.classList.add('overflow-hidden');

        this.$nextTick(() => requestAnimationFrame(() => this.$refs.confirmButton?.focus()));

        if (this.autoSubmitTimer) {
          clearTimeout(this.autoSubmitTimer);
        }
        // Auto-submit setelah 5 detik agar jawaban tetap terkirim meskipun pengguna tidak mengklik
        this.autoSubmitTimer = setTimeout(() => {
          if (this.open && !this.submitting) {
            this.confirm();
          }
        }, 5000);
      },

      confirm() {
        if (this.submitting) return;

        if (this.autoSubmitTimer) {
          clearTimeout(this.autoSubmitTimer);
          this.autoSubmitTimer = null;
        }

        this.submitting = true;
        const callback = this.onConfirmCallback;
        this.open = false;
        this.onConfirmCallback = null;
        document.body.classList.remove('overflow-hidden');

        if (typeof callback === 'function') {
          callback();
        } else if (typeof prepareAndSubmit === 'function') {
          prepareAndSubmit();
        }
      },

      cycleFocus(event) {
        this.$refs.confirmButton?.focus();
      },
    };
  }
</script>

