{{!--
  Component: Content Preview Container (HTML & EditorJS Blocks)
  Path: components/ui/content-preview/index.hbs
  Props: {{content}} (HTML string or EditorJS blocks JSON/object),
         {{emptyMessage}} (optional fallback text),
         {{class}} (optional extra classes)
--}}
<div
  data-empty-message='{{default emptyMessage "Belum ada konten."}}'
  x-data='{
    renderedHtml: "",
    init() {
      const render = () => {
        const scriptEl = this.$el.querySelector("script[type=\"application/json\"]");
        const raw = scriptEl ? scriptEl.textContent : "";
        const fallback = this.$el.dataset.emptyMessage || "Belum ada konten.";
        if (window.QuillEditor && window.QuillEditor.renderToHtml) {
          this.renderedHtml = window.QuillEditor.renderToHtml(raw, fallback);
        } else {
          setTimeout(render, 50);
        }
      };
      render();
    }
  }'
  class='content-preview-container final-assignment-content w-full font-inter text-[14px] leading-[22px] text-[#171717] {{class}}'
>
  <script type="application/json">{{{jsonSafe content}}}</script>
  <div x-html='renderedHtml'></div>
</div>

