{{!--
  Component: Mentor Action Buttons (Admin) — molecular, prefix mentor-action-
  Path: components/ui/admin/button/mentor-action-buttons.hbs
  Dipakai: {{> components/ui/admin/button/mentor-action-buttons}} di dalam x-for `mentor`
  Menggabungkan icon-button-edit + icon-button-delete versi Alpine dinamis,
  supaya mentor-table.hbs tidak menduplikasi SVG panjang.
  Slicing H6vxaE Col Action 116: gap 4, p16, Edit #525252 + Delete #DC2626, 40x40 radius 8.
   BE: Edit → GET /mentor/formEdit/:mentorId, Delete → DELETE /mentor/:courseId/:mentorId
--}}
<div class='box-border w-[116px] shrink-0 h-full flex flex-row gap-[4px] p-[16px_12px] justify-center items-center'>
  {{!-- Edit --}}
  <a :href="'/mentor/formEdit/' + mentor.id"
     class='box-border w-[40px] shrink-0 h-[40px] flex flex-row gap-0 justify-center items-center bg-[#FFFFFF] rounded-[8px] hover:bg-[#f5f5f5] transition-colors'
     title='Edit' aria-label='Edit'>
    <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#525252' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[20px] h-[20px]'>
      <path d='M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z'/>
      <path d='m15 5 4 4'/>
    </svg>
  </a>
  {{!-- Delete --}}
  <form :action="'/mentor/{{course.id}}/' + mentor.id + '?_method=DELETE'" method='POST' class='box-border w-[40px] shrink-0 h-[40px]'>
    <button type='button'
      @click='mentorConfirmDelete($el, mentor.name)'
      class='box-border w-[40px] h-[40px] flex flex-row gap-0 justify-center items-center bg-[#FFFFFF] rounded-[8px] hover:bg-[#FEF2F2] transition-colors'
      title='Delete' aria-label='Delete'>
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#C80606' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[20px] h-[20px]'>
        <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
      </svg>
    </button>
  </form>
</div>
