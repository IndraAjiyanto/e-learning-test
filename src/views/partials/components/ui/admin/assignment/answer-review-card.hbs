{{!--
  Component: Answer Review Card (Admin) — molecule, prefix assignment-
  Path: components/ui/admin/assignment/answer-review-card.hbs
  Source: slicing.pen (Container - Logbook Detail 1022, iLK5a -> Button Wrapper klUCl)
  Dipakai: {{> components/ui/admin/assignment/answer-review-card assignmentId=assignment.id}}
           di dalam {{#each assignment_answer}} pada admin/answers-assignments/index.hbs.
  Konteks each: AnswerTask { id, file, process, createdAt, user, comment[] }.
  Props: {{assignmentId}} (required, untuk form approve/reject).
  Design: card r8 stroke #D9D9D9; header h64 #FAFAFA bottom-border (avatar 40 + nama Inter 14/600
          #404040 + email 12/400 #525252 + badge pill r16 dot 8 + chevron 20 #525252);
          body p14 gap20 (Form link #2563EB, Submitted Date, Leave a Comment textarea,
          Approve #003060 text white + Reject #FEF2F2 text #B91C1C stroke #FCA5A5, Comment History).
  BE: PATCH /answer-assigment/:assignmentId/:answerId { process, comment }
--}}
<div data-status='{{this.process}}' x-data='cardData()' class='box-border w-full bg-white rounded-[8px] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] overflow-hidden'>

  {{!-- Header (h64 #FAFAFA p8 14 gap6) --}}
  <div @click='isOpen = !isOpen; $dispatch("review-select", { userId: "{{this.user.id}}", username: "{{this.user.username}}", file: "{{this.file}}" })'
    class='box-border w-full h-[64px] flex flex-row gap-[6px] p-[8px_14px] justify-between items-center bg-[#FAFAFA] [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#D9D9D9] cursor-pointer hover:bg-[#F5F5F5] transition-colors'>
    
    {{!-- Avatar label group (Uz9Uh) --}}
    <div class='flex-1 min-w-0 flex flex-row gap-[10px] justify-start items-center'>
      <div class='box-border w-[36px] shrink-0 h-[36px] flex flex-row justify-center items-center bg-[#F9F5FF] rounded-full overflow-hidden border border-[#E9D7FE]'>
        <svg xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#7F56D9' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='shrink-0'><path d='M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2' /><circle cx='12' cy='7' r='4' /></svg>
      </div>
      <div class='flex-1 min-w-0 flex flex-col gap-0 justify-center items-start'>
        <div class='text-[14px]/[1.43] w-full overflow-hidden text-ellipsis whitespace-nowrap text-[#404040] font-inter font-semibold text-left'>{{this.user.username}}</div>
        <div class='text-[12px]/[normal] w-full overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-normal text-left'>{{this.user.email}}</div>
      </div>
    </div>

    {{!-- BadgeWrap (ecfM7) + Toggle Chevron --}}
    <div class='flex flex-row gap-[10px] justify-end items-center shrink-0'>
      {{#if (eq this.process 'approved')}}
      <div class='box-border w-fit h-fit flex flex-row gap-[6px] p-[2px_8px_2px_6px] justify-start items-center bg-[#F0FDF4] border border-[#BBF7D0] rounded-[16px]'>
        <div class='box-border w-[8px] h-[8px] rounded-full bg-[#22C55E]'></div>
        <div class='text-[12px]/[normal] font-inter font-medium text-[#15803D] whitespace-nowrap'>Approved</div>
      </div>
      {{else if (eq this.process 'rejected')}}
      <div class='box-border w-fit h-fit flex flex-row gap-[6px] p-[2px_8px_2px_6px] justify-start items-center bg-[#FEF2F2] border border-[#FECACA] rounded-[16px]'>
        <div class='box-border w-[8px] h-[8px] rounded-full bg-[#EF4444]'></div>
        <div class='text-[12px]/[normal] font-inter font-medium text-[#B91C1C] whitespace-nowrap'>Rejected</div>
      </div>
      {{else}}
      <div class='box-border w-fit h-fit flex flex-row gap-[6px] p-[2px_8px_2px_6px] justify-start items-center bg-[#FEFCE8] border border-[#FEF08A] rounded-[16px]'>
        <div class='box-border w-[8px] h-[8px] rounded-full bg-[#EAB308]'></div>
        <div class='text-[12px]/[normal] font-inter font-medium text-[#A16207] whitespace-nowrap'>Under Review</div>
      </div>
      {{/if}}
      <svg :class="isOpen ? 'rotate-90' : ''" xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='#525252' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='shrink-0 transition-transform'><path d='m9 18 6-6-6-6'/></svg>
    </div>
  </div>

  {{!-- Body (hVeFz: p14 gap20) --}}
  <div x-show='isOpen' x-transition class='flex flex-col gap-[20px] p-[16px] w-full'>

    {{!-- Container Form link (x0qXjB) --}}
    <div class='flex flex-col gap-[4px] w-full'>
      <div class='text-[14px]/[normal] w-full text-[#171717] font-inter font-medium'>Form link</div>
      <a href='{{this.file}}' target='_blank' rel='noopener noreferrer'
        class='text-[14px]/[1.21] w-full text-[#2563EB] font-montserrat font-medium break-all hover:underline'>{{this.file}}</a>
    </div>

    {{!-- Preview Frame Mini (jika preview di card ingin ditampilkan) --}}
    <div class='w-full h-[280px] bg-[#282828] border border-[#3A3A3A] rounded-[8px] overflow-hidden flex flex-col'
      x-data="{ embedUrl: '', raw: '' }" x-init="raw = $el.dataset.raw; embedUrl = previewEmbedUrl(raw)" data-raw='{{this.file}}'>
      <template x-if='embedUrl'>
        <iframe :src='embedUrl' class='w-full h-full bg-white' frameborder='0' title='Submission preview'></iframe>
      </template>
      <template x-if='!embedUrl'>
        <div class='flex-1 flex flex-col items-center justify-center gap-[8px] p-[16px] text-center'>
          <svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 24 24' fill='none' stroke='#A3A3A3' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2 2h4'/></svg>
          <p class='text-[13px]/[normal] text-[#A3A3A3] font-inter'>Preview ringkas tidak dapat dimuat di iframe.</p>
          <a :href='raw' target='_blank' rel='noopener noreferrer'
            class='text-[13px]/[normal] text-[#60A5FA] font-inter font-medium hover:underline'>Buka berkas di tab baru</a>
        </div>
      </template>
    </div>

    {{!-- Container Submited Date (fZ9sL) --}}
    <div class='flex flex-col gap-[4px] w-full'>
      <div class='text-[14px]/[normal] w-full text-[#171717] font-inter font-medium'>Submited Date</div>
      <div class='text-[14px]/[1.62] w-full text-[#737373] font-montserrat font-medium'>{{formatDate this.createdAt}}</div>
    </div>

    {{!-- Container Leave a Comment (Cz9fL) + Approve/Reject (KOxfP) --}}
    <form action='/answer-assigment/{{assignmentId}}/{{this.id}}?_method=PATCH' method='POST' class='flex flex-col gap-[12px] w-full'>
      <input type='hidden' name='process' id='prosesValue'>
      <div class='text-[14px]/[normal] w-full text-[#404040] font-inter font-medium'>Leave a Comment</div>
      {{> components/ui/admin/form/textarea-input id=(concat 'comment-' this.id) name="comment" rows="3" placeholder="Leave a feedback for this answer..."}}
      
      {{!-- Action Buttons (Frame 2147229614: Approve #003060, Reject #FEF2F2 text #B91C1C) --}}
      <div class='flex flex-row gap-[12px] w-full items-center h-[44px] pt-1'>
        <button type='button' onclick="confirmAction(this, 'Are you sure approve this answer?', 'Confirmation', 'approved')"
          class='box-border flex-1 min-w-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#003060] [outline:1px_solid_#003060] [outline-offset:-0.5px] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] hover:bg-[#002040] transition-colors cursor-pointer'>
          <span class='text-[16px]/[normal] text-[#FFFFFF] font-inter font-semibold whitespace-nowrap'>Approve</span>
        </button>
        <button type='button' onclick="confirmAction(this, 'Are you sure reject this answer?', 'Confirmation', 'rejected')"
          class='box-border flex-1 min-w-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FEF2F2] border border-[#FCA5A5] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] hover:bg-[#FEE2E2] transition-colors cursor-pointer'>
          <span class='text-[16px]/[normal] text-[#B91C1C] font-inter font-semibold whitespace-nowrap'>Reject</span>
        </button>
      </div>
    </form>

    {{!-- Container Comment History (Q0VTy8: gap 8, Frame 2147229622 cards) --}}
    {{#if this.comment}}
    <div class='flex flex-col gap-[8px] w-full pt-1'>
      <div class='text-[14px]/[normal] w-full text-[#404040] font-inter font-medium'>Comment History</div>
      <div class='flex flex-col gap-[10px] w-full'>
        {{#each this.comment}}
        <div class='box-border w-full p-[12px_14px] bg-[#FAFAFA] border border-[#D4D4D4] rounded-[8px] shadow-[0px_1px_2px_rgba(0,0,0,0.05)]'>
          <p class='text-[16px]/[1.25] text-[#171717] font-inter font-normal break-words'>{{this.comment}}</p>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

  </div>
</div>
