{{!--
  Komponen: Delete Confirmation Modal (Admin)
  Lokasi: src/views/partials/components/ui/admin/modal/delete_confirm/index.hbs
  Level: L1 Atomik (scoped admin)

  Props:
  - title       : string (default 'Delete Item?')
  - cancelLabel : string (default 'Cancel')
  - confirmLabel: string (default 'Delete')
--}}
<div
  x-data='deleteConfirmModal()'
  x-show='open'
  x-cloak
  @delete-confirm:open.window='show($event.detail)'
  @keydown.escape.window='close()'
  class='fixed inset-0 z-50 flex items-center justify-center bg-[#0a0a0a]/70 p-4 backdrop-blur-[16px]'
  @click.self='close()'
>
  <div
    role='dialog'
    aria-modal='true'
    aria-labelledby='delete-confirm-modal-title'
    aria-describedby='delete-confirm-modal-description'
    @keydown.tab.prevent='cycleFocus($event)'
    class='flex w-full max-w-[400px] flex-col gap-8 rounded-xl bg-white p-6 shadow-[0px_8px_8px_-4px_rgba(0,0,0,0.03),0px_20px_24px_-4px_rgba(0,0,0,0.08)]'
  >
    <div class='flex flex-col items-center gap-5'>
      <span
        class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-8 border-[#FEF2F2] bg-[#FEE2E2]'
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </span>

      <div class='flex flex-col items-center gap-2'>
        <h2
          id='delete-confirm-modal-title'
          class='text-center font-inter text-lg font-semibold leading-7 text-[#171717]'
          x-text='title'
        >{{default title 'Delete Item?'}}</h2>

        <p
          id='delete-confirm-modal-description'
          class='text-center font-inter text-sm font-normal leading-5 text-[#525252]'
          x-text='description'
        >{{default description "Are you sure you want to delete this item? This action will permanently remove it and cannot be undone."}}</p>
      </div>
    </div>

    <div class='flex items-start gap-3'>
      <button
        type='button'
        x-ref='cancelButton'
        @click='close()'
        :disabled='submitting'
        class='inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-[#d4d4d4] bg-white px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-[#404040] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#a3a3a3] hover:bg-[#f5f5f5] active:bg-[#ededed] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#404040]/40 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60'
        x-text='cancelLabel'
      >{{default cancelLabel 'Cancel'}}</button>

      <button
        type='button'
        x-ref='confirmButton'
        @click='confirm()'
        :disabled='submitting'
        class='inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-[#dc2626] bg-[#dc2626] px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#b91c1c] hover:bg-[#b91c1c] active:bg-[#991b1b] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#dc2626]/40 focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-80'
      >
        <span x-show='!submitting' x-text='confirmLabel'>{{default confirmLabel 'Delete'}}</span>
        <span x-show='submitting' class='inline-flex items-center gap-2'>
          <svg class='h-4 w-4 animate-spin text-white' fill='none' viewBox='0 0 24 24'>
            <circle class='opacity-25' cx='12' cy='12' r='10' stroke='currentColor' stroke-width='4'></circle>
            <path class='opacity-75' fill='currentColor' d='M4 12a8 8 0 018-8v8H4z'></path>
          </svg>
          <span>Deleting...</span>
        </span>
      </button>
    </div>
  </div>
</div>

<script>
  function openDeleteModal(target, title, description, onConfirm) {
    if (typeof target === 'object' && target !== null && !(target instanceof HTMLElement)) {
      window.dispatchEvent(
        new CustomEvent('delete-confirm:open', { detail: target }),
      );
      return;
    }
    if (typeof target === 'function') {
      window.dispatchEvent(
        new CustomEvent('delete-confirm:open', {
          detail: { onConfirm: target, title, description },
        }),
      );
      return;
    }
    const button = target;
    const form = button?.form ?? button?.closest('form');
    window.dispatchEvent(
      new CustomEvent('delete-confirm:open', {
        detail: { form, trigger: button, title, description, onConfirm },
      }),
    );
  }

  function deleteConfirmModal() {
    const defaultTitle = `{{default title 'Delete Item?'}}`;
    const defaultDesc = `{{default description 'Are you sure you want to delete this item? This action cannot be undone.'}}`;
    const defaultCancel = `{{default cancelLabel 'Cancel'}}`;
    const defaultConfirm = `{{default confirmLabel 'Delete'}}`;

    return {
      open: false,
      title: defaultTitle,
      description: defaultDesc,
      cancelLabel: defaultCancel,
      confirmLabel: defaultConfirm,
      pendingForm: null,
      onConfirmCallback: null,
      lastTrigger: null,
      submitting: false,

      show(detail) {
        let form, trigger, title, description, onConfirm, confirmLabel, cancelLabel;
        if (detail && typeof detail === 'object' && !(detail instanceof HTMLElement)) {
          form = detail.form;
          trigger = detail.trigger;
          title = detail.title;
          description = detail.description;
          onConfirm = detail.onConfirm;
          confirmLabel = detail.confirmLabel;
          cancelLabel = detail.cancelLabel;
        } else {
          form = arguments[0];
          trigger = arguments[1];
          title = arguments[2];
          description = arguments[3];
          onConfirm = arguments[4];
        }

        if (!form && typeof onConfirm !== 'function') return;

        this.pendingForm = form || null;
        this.onConfirmCallback = typeof onConfirm === 'function' ? onConfirm : null;
        this.lastTrigger = trigger || null;
        this.title = title || defaultTitle;
        this.description = description || defaultDesc;
        this.cancelLabel = cancelLabel || defaultCancel;
        this.confirmLabel = confirmLabel || defaultConfirm;
        this.submitting = false;
        this.open = true;
        document.body.classList.add('overflow-hidden');

        this.$nextTick(() => requestAnimationFrame(() => this.$refs.cancelButton?.focus()));
      },

      close() {
        if (!this.open) return;
        if (this.submitting) return;

        this.open = false;
        this.pendingForm = null;
        this.onConfirmCallback = null;
        document.body.classList.remove('overflow-hidden');
        this.lastTrigger?.focus();
        this.lastTrigger = null;
      },

      async confirm() {
        if (this.submitting) return;

        if (typeof this.onConfirmCallback === 'function') {
          this.submitting = true;
          try {
            await this.onConfirmCallback();
          } catch (err) {
            console.error('Delete action failed:', err);
          } finally {
            this.submitting = false;
            this.open = false;
            this.pendingForm = null;
            this.onConfirmCallback = null;
            document.body.classList.remove('overflow-hidden');
            this.lastTrigger?.focus();
            this.lastTrigger = null;
          }
          return;
        }

        if (this.pendingForm) {
          this.submitting = true;
          this.pendingForm.submit();
        }
      },

      cycleFocus(event) {
        const order = [this.$refs.cancelButton, this.$refs.confirmButton];
        const current = order.indexOf(document.activeElement);
        const step = event.shiftKey ? -1 : 1;
        order[(current + step + order.length) % order.length]?.focus();
      },
    };
  }
</script>
