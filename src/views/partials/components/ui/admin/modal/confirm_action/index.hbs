{{!--
  Komponen: Confirm Action Modal (Admin) — generic, non-destruktif
  Lokasi: src/views/partials/components/ui/admin/modal/confirm_action/index.hbs

  Sama tampilannya dengan modal/delete_confirm (overlay blur #0a0a0a/70, card putih
  radius-xl, dua tombol full-width) tapi TIDAK terikat ke <form> delete. Modal ini
  menahan sebuah callback JS (bukan submit form) sampai user menekan tombol confirm —
  cocok dipakai untuk aksi non-destruktif seperti toggle launch program.

  Cara pakai: render sekali per halaman (di luar x-data lain), lalu panggil
  `openConfirmModal({ title, description, confirmLabel, cancelLabel, onConfirm, onCancel })`
  dari mana saja. `onConfirm` dipanggil saat user menekan tombol confirm;
  `onCancel` (opsional) dipanggil saat modal ditutup tanpa konfirmasi (Cancel/Escape/klik luar).
--}}
<div
  x-data='confirmActionModal()'
  x-show='open'
  x-cloak
  @confirm-action:open.window='show($event.detail)'
  @keydown.escape.window='close()'
  class='fixed inset-0 z-50 flex items-center justify-center bg-[#0a0a0a]/70 p-4 backdrop-blur'
  @click.self='close()'
>
  <div
    role='dialog'
    aria-modal='true'
    aria-labelledby='confirm-action-modal-title'
    aria-describedby='confirm-action-modal-description'
    @keydown.tab.prevent='cycleFocus($event)'
    class='flex w-full max-w-[400px] flex-col gap-8 rounded-xl bg-white p-6 shadow-[0px_8px_8px_-4px_rgba(0,0,0,0.03),0px_20px_24px_-4px_rgba(0,0,0,0.08)]'
  >

    <div class='flex flex-col items-center gap-5'>

      <span
        class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-8 border-[#EFF6FF] bg-[#DBEAFE]'
      >
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#003060' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-6 w-6'>
          <circle cx='12' cy='12' r='10'></circle>
          <path d='M12 16v-4'></path>
          <path d='M12 8h.01'></path>
        </svg>
      </span>

      <div class='flex flex-col items-center gap-2'>
        <h2
          id='confirm-action-modal-title'
          class='text-center font-inter text-lg font-semibold leading-7 text-[#171717]'
          x-text='title'
        ></h2>

        <p
          id='confirm-action-modal-description'
          class='text-center font-inter text-sm font-normal leading-5 text-[#525252]'
          x-text='description'
        ></p>
      </div>
    </div>

    <div class='flex items-start gap-3'>
      <button
        type='button'
        x-ref='cancelButton'
        @click='close()'
        :disabled='submitting'
        class='inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-[#d4d4d4] bg-white px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-[#404040] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#a3a3a3] hover:bg-[#f5f5f5] active:bg-[#ededed] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#404040]/40 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60'
        x-text='cancelLabel'
      ></button>

      <button
        type='button'
        x-ref='confirmButton'
        @click='confirm()'
        :disabled='submitting'
        class='inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-[#003060] bg-[#003060] px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#00254a] hover:bg-[#00254a] active:bg-[#001b36] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-80'
        x-text='confirmLabel'
      ></button>
    </div>
  </div>
</div>

<script>
  // Dipanggil dari mana saja: openConfirmModal({ title, description, onConfirm, onCancel }).
  function openConfirmModal(options) {
    if (!options || typeof options.onConfirm !== 'function') return;

    window.dispatchEvent(
      new CustomEvent('confirm-action:open', { detail: options }),
    );
  }

  function confirmActionModal() {
    return {
      open: false,
      title: 'Are you sure?',
      description: '',
      confirmLabel: 'Confirm',
      cancelLabel: 'Cancel',
      // Callback yang dibawa saat modal dibuka. Null saat tertutup, sehingga
      // confirm() tidak mungkin memanggil callback milik pemicu sebelumnya.
      onConfirmCallback: null,
      onCancelCallback: null,
      lastTrigger: null,
      submitting: false,

      show(options) {
        this.title = options.title || 'Are you sure?';
        this.description = options.description || '';
        this.confirmLabel = options.confirmLabel || 'Confirm';
        this.cancelLabel = options.cancelLabel || 'Cancel';
        this.onConfirmCallback = options.onConfirm;
        this.onCancelCallback = options.onCancel || null;
        this.lastTrigger = document.activeElement;
        this.submitting = false;
        this.open = true;
        document.body.classList.add('overflow-hidden');

        this.$nextTick(() => requestAnimationFrame(() => this.$refs.cancelButton?.focus()));
      },

      close() {
        if (!this.open) return;
        if (this.submitting) return;

        const onCancel = this.onCancelCallback;
        this.open = false;
        this.onConfirmCallback = null;
        this.onCancelCallback = null;
        document.body.classList.remove('overflow-hidden');
        this.lastTrigger?.focus?.();
        this.lastTrigger = null;

        onCancel?.();
      },

      confirm() {
        if (!this.onConfirmCallback || this.submitting) return;

        this.submitting = true;
        const callback = this.onConfirmCallback;
        this.open = false;
        this.onConfirmCallback = null;
        this.onCancelCallback = null;
        document.body.classList.remove('overflow-hidden');
        this.lastTrigger = null;
        this.submitting = false;

        callback();
      },

      cycleFocus(event) {
        const order = [this.$refs.cancelButton, this.$refs.confirmButton];
        const current = order.indexOf(document.activeElement);
        const step = event.shiftKey ? -1 : 1;
        order[(current + step + order.length) % order.length]?.focus();
      },
    };
  }
</script>
