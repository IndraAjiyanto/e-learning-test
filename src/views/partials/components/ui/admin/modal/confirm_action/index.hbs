{{!--
  Komponen: Confirm Action Modal (Admin) — generic, non-destruktif
  Lokasi: src/views/partials/components/ui/admin/modal/confirm_action/index.hbs

  Modal ini menahan sebuah callback JS sampai user menekan tombol confirm.
  Cocok dipakai untuk aksi seperti approve/reject submission, toggle launch, dsb.

  Cara pakai: render sekali per halaman (di luar x-data lain), lalu panggil
  `openConfirmModal({ title, description, confirmLabel, cancelLabel, onConfirm, onCancel })`
  dari mana saja. `onConfirm` dipanggil saat user menekan tombol confirm;
  `onCancel` (opsional) dipanggil saat modal ditutup tanpa konfirmasi.

  Ada juga helper `openConfirmDiscard(isDirty, href)` untuk tombol Cancel form.
--}}
<div
  x-data='confirmActionModal()'
  x-show='open'
  x-cloak
  @confirm-action:open.window='show($event.detail)'
  @keydown.escape.window='close()'
  class='fixed inset-0 z-[110] flex items-center justify-center bg-[#0a0a0a]/70 p-4 backdrop-blur'
  @click.self='close()'
>
  <div
    role='dialog'
    aria-modal='true'
    aria-labelledby='confirm-action-modal-title'
    aria-describedby='confirm-action-modal-description'
    @keydown.tab.prevent='cycleFocus($event)'
    class='flex w-full max-w-[400px] flex-col gap-[32px] rounded-[16px] bg-white px-[24px] py-[28px] shadow-[0px_8px_8px_-4px_rgba(0,0,0,0.03),0px_20px_24px_-4px_rgba(0,0,0,0.08)]'
  >

    {{!-- Icon + Title + Description --}}
    <div class='flex flex-col items-center gap-[16px]'>

      {{!-- Info icon --}}
      <span class='flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full border-[7px] border-[#DBEAFE] bg-[#EFF6FF]'>
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#003060' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-[22px] w-[22px]'>
          <circle cx='12' cy='12' r='10'></circle>
          <path d='M12 16v-4'></path>
          <path d='M12 8h.01'></path>
        </svg>
      </span>

      <div class='flex flex-col items-center gap-[6px]'>
        <h2
          id='confirm-action-modal-title'
          class='text-center font-inter font-bold text-[18px] leading-[26px] text-[#171717]'
          x-text='title'
        ></h2>

        <p
          id='confirm-action-modal-description'
          class='text-center font-inter font-normal text-[14px] leading-[20px] text-[#525252]'
          x-text='description'
        ></p>
      </div>
    </div>

    {{!-- Action Buttons --}}
    <div class='flex items-center gap-[12px]'>
      <button
        type='button'
        x-ref='cancelButton'
        @click='close()'
        :disabled='submitting'
        class='inline-flex h-[44px] flex-1 items-center justify-center rounded-[8px] border border-[#D4D4D4] bg-white px-[18px] font-inter font-semibold text-[15px] leading-[22px] text-[#404040] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#F5F5F5] active:bg-[#EDEDED] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/30 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60'
        x-text='cancelLabel'
      ></button>

      <button
        type='button'
        x-ref='confirmButton'
        @click='confirm()'
        :disabled='submitting'
        class='inline-flex h-[44px] flex-1 items-center justify-center rounded-[8px] border border-[#003060] bg-[#003060] px-[18px] font-inter font-semibold text-[15px] leading-[22px] text-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#00254A] active:bg-[#001B36] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-80'
        x-text='confirmLabel'
      ></button>
    </div>
  </div>
</div>

<script>
  // Dipanggil dari mana saja:
  // openConfirmModal({ title, description, confirmLabel, cancelLabel, onConfirm, onCancel })
  function openConfirmModal(options) {
    if (!options || typeof options.onConfirm !== 'function') return;

    window.dispatchEvent(
      new CustomEvent('confirm-action:open', { detail: options }),
    );
  }

  function openConfirmDiscard(isDirty, href) {
    if (!isDirty) {
      window.location.href = href;
      return;
    }

    openConfirmModal({
      title: 'Discard changes?',
      description:
        'You have unsaved data in this form. Are you sure you want to leave? Your changes will not be saved.',
      confirmLabel: 'Yes, Discard',
      cancelLabel: 'Keep Editing',
      onConfirm: () => {
        window.location.href = href;
      },
    });
  }

  function confirmActionModal() {
    return {
      open: false,
      title: 'Are you sure?',
      description: '',
      confirmLabel: 'Confirm',
      cancelLabel: 'Cancel',
      onConfirmCallback: null,
      onCancelCallback: null,
      lastTrigger: null,
      submitting: false,

      show(options) {
        this.title = options.title || 'Are you sure?';
        this.description = options.description || '';
        this.confirmLabel = options.confirmLabel || 'Confirm';
        this.cancelLabel = options.cancelLabel || 'Cancel';
        this.onConfirmCallback = options.onConfirm;
        this.onCancelCallback = options.onCancel || null;
        this.lastTrigger = document.activeElement;
        this.submitting = false;
        this.open = true;
        document.body.classList.add('overflow-hidden');

        this.$nextTick(() => requestAnimationFrame(() => this.$refs.cancelButton?.focus()));
      },

      close() {
        if (!this.open) return;
        if (this.submitting) return;

        const onCancel = this.onCancelCallback;
        this.open = false;
        this.onConfirmCallback = null;
        this.onCancelCallback = null;
        document.body.classList.remove('overflow-hidden');
        this.lastTrigger?.focus?.();
        this.lastTrigger = null;

        onCancel?.();
      },

      confirm() {
        if (!this.onConfirmCallback || this.submitting) return;

        this.submitting = true;
        const callback = this.onConfirmCallback;
        this.open = false;
        this.onConfirmCallback = null;
        this.onCancelCallback = null;
        document.body.classList.remove('overflow-hidden');
        this.lastTrigger = null;
        this.submitting = false;

        callback();
      },

      cycleFocus(event) {
        const order = [this.$refs.cancelButton, this.$refs.confirmButton].filter(Boolean);
        const current = order.indexOf(document.activeElement);
        const step = event.shiftKey ? -1 : 1;
        order[(current + step + order.length) % order.length]?.focus();
      },
    };
  }
</script>
