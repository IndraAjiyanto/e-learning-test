{{!--
  Component: Mentor Table (Admin) — SINGLE table component, prefix mentor-
  Path: components/ui/admin/program/mentor-table.hbs
  Dipakai: {{> components/ui/admin/program/mentor-table}} di dalam scope mentorData()
  Composes: program/mentor-avatar, badge/mentor-tech-badge, text/mentor-link, button/mentor-action-buttons

  card white, outline 1px #E5E5E5 offset -0.5px, radius 12, overflow hidden, shadow.
  Header h44 bg #FAFAFA + border-bottom, text Inter 12/500 #525252, p12 24 (exact slicing).
  Row h72 + border-bottom, text Inter 14/normal #404040, p16 24 (exact slicing).
  Kolom (entity Mentors): Mentor(268: avatar + nama) Position(240) Description(240)
         Tech(300)
         LinkedIn(200: link #3B82F6) Action(116: Edit #525252 + Delete #DC2626).
  Position/Description: DB jsonb menyimpan object {id,en,ja} — joinList() di
  parent scope mengonversi ke string untuk display. Fallback "-" bila kosong.
  Catatan: frame tampil email di bawah nama, tapi entity Mentors TIDAK ada field email — hanya nama.
  Anti-rusak: shrink-0 per kolom + truncate + min-w-0 di flex-1 + :title tooltip.

  Alpine (parent scope): loading, filteredData, joinList(), mentorTechBg(), mentorTechColor(), mentorConfirmDelete()
--}}
<style>
  .mentor-scroll::-webkit-scrollbar { height: 6px; }
  .mentor-scroll::-webkit-scrollbar-track { background: transparent; }
  .mentor-scroll::-webkit-scrollbar-thumb { background: #D4D4D4; border-radius: 999px; }
  .mentor-scroll::-webkit-scrollbar-thumb:hover { background: #A3A3A3; }
</style>
<div class='box-border w-full h-fit shrink-0 flex flex-col gap-0 justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#E5E5E5] [outline-offset:-0.5px] rounded-[12px] overflow-hidden shadow-[0px_1px_2px_0px_rgba(0,0,0,0.06)]'>

  {{!-- Loading --}}
  <div x-show='loading' class='w-full py-16 text-center font-inter text-sm text-[#A3A3A3]'>
    <i class='fas fa-spinner fa-spin text-xl'></i>
  </div>

  <div x-show='!loading && filteredData.length > 0' class='mentor-scroll w-full overflow-x-auto overflow-y-hidden [scrollbar-width:thin] [scrollbar-color:#D4D4D4_transparent]'>

    {{!-- Header Row — H6vxaE exact: min-w 1367, h44, bg #FAFAFA, p12_24, border bottom --}}
    <div class='w-full min-w-[1367px] h-[44px] shrink-0 flex flex-row gap-0 justify-start items-start bg-[#FAFAFA] [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#E5E5E5] [margin:0px_0px_-0.5px_0px]'>
      <div class='box-border w-[268px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>Name</div></div>
      <div class='box-border w-[240px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>Position</div></div>
      <div class='box-border w-[240px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>Description</div></div>
      <div class='box-border w-[300px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>Tech</div></div>
      <div class='box-border w-[200px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>LinkedIn</div></div>
      <div class='box-border w-[116px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-center items-center'><div class='text-[12px]/[normal] text-[#525252] font-inter font-medium text-center whitespace-nowrap'>Action</div></div>
    </div>

    {{!-- Body Rows --}}
    <template x-for='(mentor, index) in filteredData' :key='mentor.id'>
      <div class='w-full min-w-[1367px] h-[72px] shrink-0 flex flex-row gap-0 justify-start items-start bg-[#FFFFFF] [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#E5E5E5] [margin:0px_0px_-0.5px_0px] hover:bg-[#fafafa] transition-colors'>

        {{!-- Mentor: avatar + nama — p16 24 exact slicing --}}
        <div class='box-border w-[268px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          <div class='box-border flex-1 min-w-0 flex flex-row gap-[10px] justify-start items-center'>
            {{> components/ui/admin/program/mentor-avatar}}
            <div class='text-[14px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#404040] font-inter font-semibold text-left' x-text="mentor.name ?? '-'" :title="mentor.name ?? ''"></div>
          </div>
        </div>

        {{!-- Position / Description (jsonb object {id,en,ja} → joinList) --}}
        <div class='box-border w-[240px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          <div class='text-[14px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#404040] font-inter font-normal text-left' x-text="joinList(mentor.position)" :title="joinList(mentor.position)"></div>
        </div>
        <div class='box-border w-[240px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          <div class='text-[14px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#404040] font-inter font-normal text-left' x-text="joinList(mentor.description)" :title="joinList(mentor.description)"></div>
        </div>

        {{!-- Tech: pill badges (mentor-tech-badge) --}}
        <div class='box-border w-[300px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          <div class='flex-1 min-w-0 flex flex-row flex-wrap gap-[4px] justify-start items-center'>
            {{> components/ui/admin/badge/mentor-tech-badge}}
          </div>
        </div>

        {{!-- LinkedIn: link biru (mentor-link) --}}
        <div class='box-border w-[200px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          {{> components/ui/admin/text/mentor-link}}
        </div>

        {{!-- Action: Edit + Delete — reuse mentor-action-buttons component (DRY) --}}
        {{> components/ui/admin/button/mentor-action-buttons}}

      </div>
    </template>
  </div>

  {{!-- Empty State --}}
  <div x-show='!loading && filteredData.length === 0' class='w-full h-[72px] flex items-center justify-center'>
    <span class='font-inter text-sm text-[#A3A3A3]'>No mentors found.</span>
  </div>

</div>
