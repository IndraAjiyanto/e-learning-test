              </svg>
            </button>
          </form>
        </div>
      </div>
    </template>

    {{!-- Empty State --}}
    <div x-show='!loading && kelasList.length === 0' class='w-full h-[72px] flex items-center justify-center'>
      <span class='font-inter text-sm text-[#A3A3A3]'>No program found.</span>
    </div>
  </div>

  {{!-- Pagination menyatu dengan card: border atas, radius bawah ikut parent overflow-hidden --}}
  <div x-show='!loading && totalPages > 1' class='w-full [border-width:1px_0px_0px_0px] [border-style:solid] [border-color:#E5E5E5]'>
    {{> components/ui/admin/table/pagination}}
  </div>

</div>
