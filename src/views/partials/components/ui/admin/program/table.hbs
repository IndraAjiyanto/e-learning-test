0.39597 0.241-0.533 0.07533-0.06788 0.16289-0.12082 0.258-0.156 1.3157-0.51463 2.77368-0.53311 4.102-0.052 1.32016 0.47613 2.41827 1.42256 3.084 2.658 0.65752 1.22583 0.82891 2.65443 0.48 4.001-0.35308 1.35337-1.19813 2.52646-2.37 3.29 1.84252 0.66205 3.42239 1.9007 4.505 3.532 0.11077 0.16618 0.14967 0.37007 0.10787 0.56535-0.04181 0.19529-0.16077 0.36538-0.32987 0.47165" fill="#525252"/>
            </svg>
          </a>
          {{!-- Delete Button --}}
          <form :action="'/program/' + course.id + '?_method=DELETE'" method='POST' class='box-border w-[40px] shrink-0 h-[40px]'>
            <button type='button'
              @click='confirmDelete($el, course.name)'
              class='box-border w-[40px] h-[40px] flex flex-row gap-0 justify-center items-center bg-[#FFFFFF] rounded-[8px] hover:bg-[#FEF2F2] transition-colors'
              title='Delete' aria-label='Delete'>
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 13.99993896484375 14' preserveAspectRatio='xMidYMid meet' class='box-border w-[20px] shrink-0 h-[20px]'>
