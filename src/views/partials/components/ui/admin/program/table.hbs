{{!--
  Component: Program Table (Admin) — SINGLE table component
  Path: components/ui/admin/program/table.hbs
  Dipakai: {{> components/ui/admin/program/table}}

  Pencil: card bg #FFFFFF, outline 1px #E5E5E5 offset -0.5px, radius 12, overflow hidden
          header h43.5 bg #FAFAFA + border-bottom #E5E5E5
          row h71.5 + border-bottom #E5E5E5
          kolom 10: No(60) Cover(110) Program(210) Group(130) Category(140)
                      Status(120) Quota(86) Student(86) Launch(86) Action(110)
          anti-rusak: shrink-0 per kolom + truncate + min-w-0 di flex-1 + :title tooltip

  Alpine (parent scope): kelasList, loading, currentPage, size, totalPages, changePage(), toggleLaunch()
  Action: Edit (link) + View Detail (link) + Delete (form + confirm)
  Pagination: menyatu di dalam card (border-top), tanpa gap
--}}
<style>
  .table-scroll::-webkit-scrollbar { height: 6px; }
  .table-scroll::-webkit-scrollbar-track { background: transparent; }
  .table-scroll::-webkit-scrollbar-thumb { background: #D4D4D4; border-radius: 999px; }
  .table-scroll::-webkit-scrollbar-thumb:hover { background: #A3A3A3; }
</style>
<div class='box-border w-full h-fit shrink-0 flex flex-col gap-0 justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#E5E5E5] [outline-offset:-0.5px] rounded-[12px] overflow-hidden'>

  {{!-- Loading --}}
  <div x-show='loading' class='w-full py-16 text-center font-inter text-sm text-[#A3A3A3]'>
    <i class='fas fa-spinner fa-spin text-xl'></i>
  </div>

  <div x-show='!loading' class='table-scroll w-full overflow-x-auto overflow-y-hidden [scrollbar-width:thin] [scrollbar-color:#D4D4D4_transparent]'>

    {{!-- Header Row --}}
    <div class='w-full min-w-[1168px] h-[43.5px] shrink-0 flex flex-row gap-0 justify-start items-start bg-[#FAFAFA] [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#E5E5E5] [margin:0px_0px_-0.5px_0px]'>
      <div class='box-border w-[5%] min-w-[60px] shrink-0 h-full flex flex-row gap-0 p-[12px] justify-center items-center'>
        <div class='text-[12px]/[normal] text-[#525252] font-inter font-medium text-center whitespace-nowrap'>No</div>
      </div>
      <div class='box-border w-[9.5%] min-w-[110px] shrink-0 h-full flex flex-row gap-0 p-[12px] justify-start items-center'>
        <div class='text-[12px]/[normal] flex-1 text-[#525252] font-inter font-medium text-left'>Cover</div>
      </div>
      <div class='box-border w-[14%] min-w-[180px] flex-1 max-w-[210px] h-full flex flex-row gap-0 p-[12px] justify-start items-center'>
        <div class='text-[12px]/[normal] flex-1 text-[#525252] font-inter font-medium text-left'>Program Name</div>
      </div>
      <div class='box-border w-[11.5%] min-w-[130px] shrink-0 h-full flex flex-row gap-0 p-[12px] justify-start items-center'>
        <div class='text-[12px]/[normal] flex-1 text-[#525252] font-inter font-medium text-left'>Group</div>
      </div>
      <div class='box-border w-[12%] min-w-[140px] shrink-0 h-full flex flex-row gap-0 p-[12px] justify-start items-center'>
        <div class='text-[12px]/[normal] flex-1 text-[#525252] font-inter font-medium text-left'>Category</div>
      </div>
      <div class='box-border w-[10.5%] min-w-[120px] shrink-0 h-full flex flex-row gap-0 p-[12px] justify-start items-center'>
        <div class='text-[12px]/[normal] flex-1 text-[#525252] font-inter font-medium text-left'>Status</div>
      </div>
      <div class='box-border w-[7.5%] min-w-[86px] shrink-0 h-full flex flex-row gap-0 p-[12px] justify-start items-center'>
        <div class='text-[12px]/[normal] flex-1 text-[#525252] font-inter font-medium text-left'>Quota</div>
      </div>
      <div class='box-border w-[7.5%] min-w-[86px] shrink-0 h-full flex flex-row gap-0 p-[12px] justify-start items-center'>
        <div class='text-[12px]/[normal] flex-1 text-[#525252] font-inter font-medium text-left'>Student</div>
      </div>
      <div class='box-border w-[7.5%] min-w-[86px] shrink-0 h-full flex flex-row gap-0 p-[12px] justify-start items-center'>
        <div class='text-[12px]/[normal] flex-1 text-[#525252] font-inter font-medium text-left'>Launch</div>
      </div>
      <div class='box-border w-[10%] min-w-[110px] shrink-0 h-full flex flex-row gap-0 p-[12px] justify-start items-center'>
        <div class='text-[12px]/[normal] flex-1 text-[#525252] font-inter font-medium text-left'>Action</div>
      </div>
    </div>

    {{!-- Body Rows --}}
    <template x-for='(course, index) in kelasList' :key='course.id'>
      <div class='w-full min-w-[1168px] h-[71.5px] shrink-0 flex flex-row gap-0 justify-start items-start bg-[#FFFFFF] [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#E5E5E5] [margin:0px_0px_-0.5px_0px] hover:bg-[#fafafa] transition-colors'>

        {{!-- No --}}
        <div class='box-border w-[5%] min-w-[60px] shrink-0 h-full flex flex-row gap-0 p-[16px_12px] justify-center items-center'>
          <div class='text-[14px]/[normal] text-[#525252] font-inter font-normal text-center whitespace-nowrap' x-text='(currentPage - 1) * size + index + 1'></div>
        </div>

        {{!-- Cover: 90x52 thumbnail, fallback initials --}}
        <div class='box-border w-[9.5%] min-w-[110px] shrink-0 h-full flex flex-row gap-0 p-[10px] justify-start items-center'>
          <div class='box-border w-[90px] shrink-0 h-[52px] flex flex-row gap-0 justify-center items-center bg-[#F9F5FF] [outline:1px_solid_#E9D7FE] [outline-offset:-0.5px] rounded-[12px] overflow-hidden'>
            <template x-if='course.image'>
              <img :src='course.image' :alt='course.name' class='h-full w-full object-cover' />
            </template>
            <template x-if='!course.image'>
              <span class='text-[14px]/[normal] text-[#6941C6] font-inter font-semibold whitespace-nowrap' x-text='course.name?.substring(0,2).toUpperCase()'></span>
            </template>
          </div>
        </div>

        {{!-- Program Name (flex-1, truncate + tooltip) --}}
        <div class='box-border w-[14%] min-w-[180px] flex-1 max-w-[210px] h-full flex flex-row gap-0 p-[16px_12px] justify-start items-center'>
          <div class='text-[14px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-normal text-left' x-text='course.name' :title='course.name'></div>
        </div>

        {{!-- Group (blue, truncate + tooltip) --}}
        <div class='box-border w-[11.5%] min-w-[130px] shrink-0 h-full flex flex-row gap-0 p-[16px_12px] justify-start items-center'>
          <div class='text-[13px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#3B82F6] font-inter font-normal text-left' x-text='course.group' :title='course.group'></div>
        </div>

        {{!-- Category (truncate + tooltip) --}}
        <div class='box-border w-[12%] min-w-[140px] shrink-0 h-full flex flex-row gap-0 p-[16px_12px] justify-start items-center'>
          <div class='text-[13px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-normal text-left' x-text='course.category?.name' :title='course.category?.name'></div>
        </div>

        {{!-- Status Badge (Approved/Pending dari course.process) --}}
        <div class='box-border w-[10.5%] min-w-[120px] shrink-0 h-full flex flex-row gap-0 p-[16px_12px] justify-start items-center'>
          <div class='box-border w-fit shrink-0 h-fit flex flex-row gap-[6px] p-[2px_8px] justify-start items-center rounded-[16px]'
            :class="course.process === 'approved' ? 'bg-[#F0FDF4]' : 'bg-[#FEFCE8]'">
            <div class='box-border w-[6px] shrink-0 h-[6px] rounded-full'
              :class="course.process === 'approved' ? 'bg-[#22C55E]' : 'bg-[#EAB308]'"></div>
            <div class='text-[12px]/[normal] font-inter font-medium whitespace-nowrap'
              :class="course.process === 'approved' ? 'text-[#15803D]' : 'text-[#A16207]'"
              x-text='course.process === "approved" ? "Approved" : "Pending"'></div>
          </div>
        </div>

        {{!-- Quota pill --}}
        <div class='box-border w-[7.5%] min-w-[86px] shrink-0 h-full flex flex-row gap-0 p-[16px_8px] justify-start items-center'>
          <div class='box-border w-fit shrink-0 h-fit flex flex-row gap-0 p-[2px_8px] justify-center items-center bg-[#F9F5FF] rounded-[16px]'>
            <div class='text-[12px]/[normal] text-[#6941C6] font-inter font-medium text-center whitespace-nowrap' x-text='course.quota ?? "-"'></div>
          </div>
        </div>

        {{!-- Student pill --}}
        <div class='box-border w-[7.5%] min-w-[86px] shrink-0 h-full flex flex-row gap-0 p-[16px_8px] justify-start items-center'>
          <div class='box-border w-fit shrink-0 h-fit flex flex-row gap-0 p-[2px_8px] justify-center items-center bg-[#F9F5FF] rounded-[16px]'>
            <div class='text-[12px]/[normal] text-[#6941C6] font-inter font-medium text-center whitespace-nowrap' x-text='course.userCourses?.length ?? 0'></div>
          </div>
        </div>

        {{!-- Launch Toggle Switch --}}
        <div class='box-border w-[7.5%] min-w-[86px] shrink-0 h-full flex flex-row gap-0 p-[16px_12px] justify-start items-center'>
          <label class='relative inline-flex h-6 w-11 cursor-pointer items-center'>
            <input
              type='checkbox'
              class='peer sr-only'
              :checked='course.launch'
              @change='toggleLaunch(course.id, index)'
            />
            <span class='block h-6 w-11 rounded-full bg-[#E5E5E5] transition-colors peer-checked:bg-[#22C55E]'></span>
            <span class='absolute left-0.5 top-0.5 block h-5 w-5 rounded-full bg-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.06)] transition-transform peer-checked:translate-x-5'></span>
          </label>
        </div>

        {{!-- Action: Edit + View Detail + Delete --}}
        <div class='box-border w-[10%] min-w-[110px] shrink-0 h-full flex flex-row gap-[4px] p-[16px_8px] justify-start items-center'>
          {{!-- Edit Button --}}
          <a :href="'/program/edit/' + course.id"
             class='box-border w-[40px] shrink-0 h-[40px] flex flex-row gap-0 justify-center items-center bg-[#FFFFFF] rounded-[8px] hover:bg-[#f5f5f5] transition-colors'
             title='Edit' aria-label='Edit'>
            <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 13.99993896484375 14' preserveAspectRatio='xMidYMid meet' class='box-border w-[20px] shrink-0 h-[20px]'>
