    <path fill='#107C41' d='M22 14H8v20h14V14z' />
    <path fill='#fff' d='M19 31h-2.1l-2.9-5-2.9 5H9l4.2-7-4.1-7h2.1l2.9 5 2.9-5H19l-4.2 7 4.2 7z' />
