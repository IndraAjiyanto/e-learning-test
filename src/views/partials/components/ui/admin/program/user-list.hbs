{{!--
  Component: User List (Admin) — organism, prefix user-
  Path: components/ui/admin/program/user-list.hbs
  Dipakai: {{> components/ui/admin/program/user-list}} di dalam scope userData()
  Composes: components/ui/admin/program/user-row (x-for filteredData)

  Pencil (Table Detail Program - User / User List): vertical, gap 6.
  Alpine (parent scope): loading, filteredData.
  Loading + empty state menyatu di dalam list agar card tidak kosong.
--}}
<div x-show='loading' class='w-full py-16 text-center font-inter text-sm text-[#A3A3A3]'>
  <i class='fas fa-spinner fa-spin text-xl'></i>
</div>

<div x-show='!loading' class='box-border w-full flex flex-col gap-[6px] justify-start items-stretch'>
  <template x-for='(item, index) in filteredData' :key='item.user?.id ?? index'>
    {{> components/ui/admin/program/user-row}}
  </template>
  <div x-show='filteredData.length === 0' class='box-border w-full h-[72px] flex flex-row gap-0 justify-center items-center bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[8px]'>
    <span class='font-inter text-sm text-[#A3A3A3]'>No users found.</span>
  </div>
</div>
