{{!--
  Component: Session Hero (Admin) — molecule, prefix session-
  Path: components/ui/admin/session/session-hero.hbs
  Dipakai: {{> components/ui/admin/session/session-hero}} di admin/session/detail.hbs
  Server scope: `session` (Session + weeks + weeks.course),
  Composes: session/session-info-item (4x), button/primary-button (Edit Session w132).

  Pencil (Container - Session Detail → Feature Card 1):
  card white r12 stroke #D9D9D9 p20 gap14.
  Back: chevron-left 16 #718096 + Back Montserrat 16/500 #718096 → /week/:weeksId.
  Title Montserrat 34/700 #003060 tracking -0.85 + badge Mentoring Batch
  (bg #F5F5F5 r16 p2 8, Inter 12/500 #404040).
  Delete w87 h44 bg #FEF2F2 stroke #FCA5A5 text #EF4444 Inter 16/600 (POST
  /session/:id/:weeksId?_method=DELETE, confirmDelete — sama perilaku lama).
  Edit Session w132 → GET /session/formEdit/:id.
  Info grid 2x2 gap14/12: Location, Topic, Date, Time (server helpers
  formatDate/formatTime — sama seperti detail lama).
--}}
<div class='box-border w-full h-fit shrink-0 flex flex-col gap-[14px] p-[20px] justify-start items-stretch bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px]'>

  {{!-- Back --}}
  <div class='flex flex-row justify-between items-center w-full'>
    <a href='/week/{{session.weeks.id}}' class='flex flex-row gap-[4px] justify-start items-center hover:opacity-70 transition-opacity' title='Back' aria-label='Back'>
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#718096' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px] shrink-0'><path d='m15 18-6-6 6-6'/></svg>
      <span class='text-[16px]/[normal] text-[#718096] font-montserrat font-medium'>Back</span>
    </a>
  </div>

  {{!-- Title + actions --}}
  <div class='flex flex-col sm:flex-row gap-[12px] justify-between items-stretch sm:items-start w-full'>
    <div class='flex flex-col gap-[10px] justify-start items-start min-w-0'>
      <div class='text-[34px]/[1.12] w-full text-[#003060] font-montserrat font-bold tracking-[-0.85px]'>Session {{session.sessionOrder}}</div>
      <div class='box-border w-fit shrink-0 h-[22px] flex flex-row gap-[8px] p-[2px_8px] justify-center items-center bg-[#F5F5F5] rounded-[16px]'>
        <span class='text-[12px]/[normal] text-[#404040] font-inter font-medium whitespace-nowrap'>Mentoring Batch #{{session.weeks.weekNumber}}</span>
      </div>
    </div>
    <div class='flex flex-col sm:flex-row gap-[12px] justify-start sm:justify-end items-stretch sm:items-center w-full sm:w-auto shrink-0'>
      <form action='/session/{{session.id}}/{{session.weeks.id}}?_method=DELETE' method='post' class='w-full sm:w-auto'>
        <button type='button'
          onclick='confirmDelete(this)'
          class='box-border w-full sm:w-[87px] shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FEF2F2] border border-[#FCA5A5] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] hover:bg-[#FEE2E2] transition-colors'
          title='Delete Session' aria-label='Delete Session'>
          <span class='text-[16px]/[24px] text-[#EF4444] font-inter font-semibold whitespace-nowrap'>Delete</span>
        </button>
      </form>
      {{> components/ui/admin/button/primary-button text='Edit Session' href=(concat '/session/formEdit/' session.id) width='132'}}
    </div>
  </div>

  {{!-- Info grid --}}
  <div class='flex flex-col gap-[12px] w-full'>
    <div class='flex flex-col sm:flex-row gap-[12px] sm:gap-[14px] w-full'>
      <div class='flex-1 min-w-0'>
        {{> components/ui/admin/session/session-info-item label='Location' value=session.location}}
      </div>
      <div class='flex-1 min-w-0'>
        {{> components/ui/admin/session/session-info-item label='Topic' value=session.topic}}
      </div>
    </div>
    <div class='flex flex-col sm:flex-row gap-[12px] sm:gap-[14px] w-full'>
      <div class='flex-1 min-w-0'>
        {{> components/ui/admin/session/session-info-item label='Date' value=(formatDate session.date)}}
      </div>
      <div class='flex-1 min-w-0'>
        {{> components/ui/admin/session/session-info-item label='Time' value=(concat (formatTime session.startTime) ' - ' (formatTime session.endTime))}}
      </div>
    </div>
  </div>

</div>
