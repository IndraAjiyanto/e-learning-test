{{!--
  Component: Session Attendance Table (Admin) — organism, prefix session-
  Path: components/ui/admin/session/session-attendance-table.hbs
  Dipakai: {{> components/ui/admin/session/session-attendance-table}} di dalam
           scope absenData() pada admin/session/detail.hbs (tab attendance).
  Server scope: `session` (untuk URL create attendance).
  Composes: program/user-avatar (userObj peserta), session/session-status-badge,
            button/primary-button (Add Attendance w162).

  card white r12 stroke #E5E5E5 shadow, header h44 bg #FAFAFA Inter 12/500
  #525252 p12 24, row h72 Inter 14 p16 24 + border-bottom, avatar 32 bg
  #F9F5FF + user icon 20 #7F56D9, nama Inter 14/600 #404040, email Inter 12
  #525252, badge pill r16 dot 8 Inter 12/500, action edit square-pen 20
  #525252 + delete trash-2 20 #C80606 (40x40 r8).
  Kolom: Name(662: avatar + username + email) Status(200) Action(148: edit #525252 + delete
  #C80606) — total min-w 1010px.
  Perilaku dipertahankan dari partials/session/absen_tab.hbs: search
  (searchInput/search/pageNumber), edit GET /attendance/formEdit/:id,
  delete POST /attendance/:id/:sessionId?_method=DELETE + confirmDelete,
  pagination pageNumber/size.
  BE: GET /session/attendance/:sessionId → User[] + absent[] (Attendance).
--}}
<style>
  .session-attendance-scroll::-webkit-scrollbar { height: 6px; }
  .session-attendance-scroll::-webkit-scrollbar-track { background: transparent; }
  .session-attendance-scroll::-webkit-scrollbar-thumb { background: #D4D4D4; border-radius: 999px; }
  .session-attendance-scroll::-webkit-scrollbar-thumb:hover { background: #A3A3A3; }
</style>

{{!-- Toolbar: search + Manage Delete + Add Attendance --}}
<div class='flex flex-col sm:flex-row gap-[12px] w-full items-stretch sm:items-center'>
  <div class='box-border flex-1 min-w-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] border border-[#D4D4D4] rounded-[8px]'>
    <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#A3A3A3' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[20px] h-[20px] shrink-0'><circle cx='11' cy='11' r='8'/><path d='m21 21-4.3-4.3'/></svg>
    <input type='text' placeholder='Search name or email...'
      x-model='searchInput' @input='search = searchInput; pageNumber=0'
      class='text-[16px]/[24px] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]' />
  </div>

  {{!-- Manage Delete Toggle Button --}}
  <button
    type='button'
    @click='toggleSelectMode()'
    x-show='data && data.length > 0'
    class='inline-flex h-[44px] shrink-0 items-center justify-center gap-2 rounded-lg border font-inter text-sm font-semibold transition-all shadow-sm cursor-pointer'
    :class="selectMode ? 'bg-[#F5F5F5] border-[#D4D4D4] hover:bg-[#E5E5E5] text-[#404040] w-[44px] px-0' : 'bg-white border-[#D4D4D4] hover:border-[#DC2626] hover:bg-[#FEF2F2] text-[#404040] hover:text-[#DC2626] px-3.5'"
    :title="selectMode ? 'Close' : 'Manage Delete'"
  >
    <template x-if='!selectMode'>
      <div class='flex items-center gap-1.5'>
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4 text-[#DC2626]'>
          <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
        </svg>
        <span>Manage Delete</span>
      </div>
    </template>
    <template x-if='selectMode'>
      <div class='flex items-center justify-center'>
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4 text-[#525252]'>
          <line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/>
        </svg>
      </div>
    </template>
  </button>

  {{> components/ui/admin/button/primary-button text='Add Attendance' href=(concat '/attendance/create/' session.id) width='162'}}
</div>

{{!-- Bulk Selection Action Bar --}}
<div
  x-show='selectMode'
  x-cloak
  x-transition:enter='transition ease-out duration-150'
  x-transition:enter-start='opacity-0 -translate-y-2'
  x-transition:enter-end='opacity-100 translate-y-0'
  x-transition:leave='transition ease-in duration-100'
  x-transition:leave-start='opacity-100 translate-y-0'
  x-transition:leave-end='opacity-0 -translate-y-2'
  class='mt-3 box-border w-full flex flex-col sm:flex-row justify-between items-center px-4 py-2.5 bg-[#FEF2F2] border border-[#FCA5A5] rounded-lg gap-2.5 shadow-sm'
  style='display: none;'
>
  <div class='flex flex-wrap items-center gap-2 text-[14px] text-[#991B1B] font-inter font-medium'>
    <svg class='w-5 h-5 text-[#DC2626] shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
      <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'/>
    </svg>
    <span>
      <strong x-text='selectedIds ? selectedIds.length : 0'></strong> attendance(s) selected
    </span>

    <span class='text-[#FCA5A5] mx-1'>•</span>

    <button
      type='button'
      @click='toggleSelectAll()'
      :disabled='!deletableAttendances || deletableAttendances.length === 0'
      :class="(!deletableAttendances || deletableAttendances.length === 0) ? 'opacity-50 cursor-not-allowed hover:no-underline' : 'cursor-pointer hover:underline'"
      class='text-xs text-[#DC2626] font-semibold'
      x-text="isAllSelected() ? 'Deselect All' : 'Select All'"
    ></button>

    <template x-if='selectedIds && selectedIds.length > 0'>
      <button
        type='button'
        @click='clearSelection()'
        class='text-xs text-[#7F1D1D] hover:underline font-normal cursor-pointer ml-1'
      >
        (Clear Selection)
      </button>
    </template>
  </div>

  <div class='flex items-center gap-2 shrink-0'>
    <button
      type='button'
      @click='confirmDeleteSelected()'
      :disabled='!selectedIds || selectedIds.length === 0'
      class='inline-flex h-9 items-center justify-center gap-1.5 rounded-lg bg-[#DC2626] px-3.5 font-inter text-sm font-semibold text-white shadow-sm hover:bg-[#B91C1C] disabled:opacity-50 disabled:cursor-not-allowed transition-colors cursor-pointer'
    >
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4'>
        <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
      </svg>
      <span>Delete Selected (<span x-text='selectedIds ? selectedIds.length : 0'></span>)</span>
    </button>

    <button
      type='button'
      @click='toggleSelectMode()'
      class='inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[#FCA5A5] bg-white text-[#991B1B] hover:bg-[#FEE2E2] transition-colors cursor-pointer'
      title='Close Manage Delete'
    >
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-4 h-4'>
        <line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/>
      </svg>
    </button>
  </div>
</div>

<div class='mt-4 box-border w-full h-fit shrink-0 flex flex-col gap-0 justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#E5E5E5] [outline-offset:-0.5px] rounded-[12px] overflow-hidden shadow-[0px_1px_2px_0px_rgba(0,0,0,0.06)]'>

  {{!-- Table --}}
  <div x-show='filteredData && filteredData.length > 0' class='session-attendance-scroll w-full overflow-x-auto overflow-y-hidden [scrollbar-width:thin] [scrollbar-color:#D4D4D4_transparent]'>

    {{!-- Header --}}
    <div class='w-full min-w-[1010px] h-[44px] shrink-0 flex flex-row gap-0 justify-start items-start bg-[#FAFAFA] [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#E5E5E5] [margin:0px_0px_-0.5px_0px]'>
      <div x-show='selectMode' x-cloak class='box-border w-[48px] shrink-0 h-full flex flex-row p-[12px] justify-center items-center'>
        <input type='checkbox'
          :checked='isAllSelected()'
          @click='toggleSelectAll()'
          :disabled='!deletableAttendances || deletableAttendances.length === 0'
          class='h-4 w-4 rounded border-[#d4d4d4] text-[#003060] focus:ring-[#003060] cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed'
          :title="(!deletableAttendances || deletableAttendances.length === 0) ? 'No deletable attendance records' : 'Select all deletable'" />
      </div>
      <div class='box-border shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'
        :class="selectMode ? 'w-[614px]' : 'w-[662px]'">
        <div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>Name</div>
      </div>
      <div class='box-border w-[200px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>Status</div></div>
      <div class='box-border w-[148px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-center items-center'><div class='text-[12px]/[normal] text-[#525252] font-inter font-medium text-center whitespace-nowrap'>Action</div></div>
    </div>

    {{!-- Body --}}
    <template x-for='(peserta, index) in filteredData' :key='peserta.id'>
      <div class='w-full min-w-[1010px] h-[72px] shrink-0 flex flex-row gap-0 justify-start items-start bg-[#FFFFFF] [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#E5E5E5] [margin:0px_0px_-0.5px_0px] hover:bg-[#fafafa] transition-colors'
        :class="selectMode && (peserta.attendance ?? peserta.absent ?? []).some(a => selectedIds.includes(String(a.id))) ? 'bg-[#FEF2F2]/60' : ''">

        {{!-- Checkbox column in Select Mode --}}
        <div x-show='selectMode' x-cloak class='box-border w-[48px] shrink-0 h-full flex flex-row p-[16px] justify-center items-center'>
          <template x-for='pesertaAbsen in (peserta.attendance ?? peserta.absent ?? [])' :key='pesertaAbsen.id'>
            <input type='checkbox'
              :value='String(pesertaAbsen.id)'
              x-model='selectedIds'
              :disabled='isAttendanceDisabled(pesertaAbsen, peserta)'
              :title="isAttendanceDisabled(pesertaAbsen, peserta) ? 'Attendance cannot be deleted because user has approved logbook for this session.' : 'Select attendance'"
              class='h-4 w-4 rounded border-[#d4d4d4] text-[#003060] focus:ring-[#003060] cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed' />
          </template>
        </div>

        {{!-- Name: avatar + username + email --}}
        <div class='box-border shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'
          :class="selectMode ? 'w-[614px]' : 'w-[662px]'">
          <div class='box-border flex-1 min-w-0 flex flex-row gap-[10px] justify-start items-center'>
            {{> components/ui/admin/program/user-avatar userObj='peserta'}}
            <div class='flex-1 min-w-0 flex flex-col gap-0 justify-center items-start'>
              <div class='text-[14px]/[normal] w-full overflow-hidden text-ellipsis whitespace-nowrap text-[#404040] font-inter font-semibold text-left' x-text="peserta.username ?? '-'" :title="peserta.username ?? ''"></div>
              <div class='text-[12px]/[normal] w-full overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-normal text-left' x-text="peserta.email ?? '-'" :title="peserta.email ?? ''"></div>
            </div>
          </div>
        </div>

        {{!-- Status --}}
        <div class='box-border w-[200px] shrink-0 h-full flex flex-row gap-[4px] p-[16px_24px] justify-start items-center flex-wrap'>
          <template x-for='pesertaAbsen in (peserta.attendance ?? peserta.absent ?? [])' :key='pesertaAbsen.id'>
            {{> components/ui/admin/session/session-status-badge statusVar='pesertaAbsen.status'}}
          </template>
        </div>

        {{!-- Action: edit + delete --}}
        <div class='box-border w-[148px] shrink-0 h-full flex flex-row gap-[4px] p-[16px] justify-center items-center'>
          <template x-for='pesertaAbsen in (peserta.attendance ?? peserta.absent ?? [])' :key='pesertaAbsen.id'>
            <div class='flex flex-row gap-[4px] justify-center items-center'>
              <form :action="'/attendance/formEdit/' + pesertaAbsen.id" method='get'>
                <button type='submit'
                  class='box-border w-[40px] h-[40px] flex flex-row gap-0 justify-center items-center bg-[#FFFFFF] rounded-[8px] hover:bg-[#f5f5f5] transition-colors cursor-pointer'
                  title='Edit' aria-label='Edit'>
                  <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#525252' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[20px] h-[20px]'>
                    <path d='M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z'/>
                    <path d='m15 5 4 4'/>
                  </svg>
                </button>
              </form>
              <template x-if="pesertaAbsen.canDelete !== false && peserta.canDelete !== false">
                <form :action="'/attendance/' + pesertaAbsen.id + '/{{session.id}}?_method=DELETE'" method='post'>
                  <button type='button'
                    onclick="openDeleteModal(this, 'Delete Attendance?', 'Are you sure you want to delete this attendance record?')"
                    class='box-border w-[40px] h-[40px] flex flex-row gap-0 justify-center items-center bg-[#FFFFFF] rounded-[8px] hover:bg-[#FEF2F2] transition-colors cursor-pointer'
                    title='Delete' aria-label='Delete'>
                    <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#C80606' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[20px] h-[20px]'>
                      <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
                    </svg>
                  </button>
                </form>
              </template>
              <template x-if="pesertaAbsen.canDelete === false || peserta.canDelete === false">
                <button type='button' disabled
                  class='box-border w-[40px] h-[40px] flex flex-row gap-0 justify-center items-center bg-[#F5F5F5] border border-[#E5E5E5] rounded-[8px] opacity-60 cursor-not-allowed'
                  title='Attendance cannot be deleted because user has approved logbook for this session.'
                  aria-label='Cannot delete attendance'>
                  <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#A3A3A3' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[20px] h-[20px]'>
                    <path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/>
                  </svg>
                </button>
              </template>
            </div>
          </template>
        </div>

      </div>
    </template>
  </div>

  {{!-- Empty state --}}
  <div x-show='!filteredData || filteredData.length === 0' class='w-full h-[72px] flex items-center justify-center'>
    <span class='font-inter text-sm text-[#A3A3A3]'>No attendance found.</span>
  </div>

  {{!-- Pagination (perilaku lama: pageNumber/size) --}}
  <div class='w-full flex justify-center gap-2 items-center py-4' x-show='pageCount() > 1'>
    <button @click='prevPage' :disabled='pageNumber==0'
      class='px-3 py-1 rounded border border-gray-900 text-gray-900'
      :class="{ 'opacity-50 cursor-not-allowed': pageNumber==0 }">Prev</button>
    <template x-for='(page,index) in pages()' :key='index'>
      <button @click='viewPage(index)'
        class='px-3 py-1 rounded'
        :class="{ 'bg-gray-900 text-white font-bold': index===pageNumber }"
        x-text='index+1'></button>
    </template>
    <button @click='nextPage' :disabled='pageNumber >= pageCount()-1'
      class='px-3 py-1 rounded border border-gray-900 text-gray-900'
      :class="{ 'opacity-50 cursor-not-allowed': pageNumber >= pageCount()-1 }">Next</button>
  </div>

</div>
