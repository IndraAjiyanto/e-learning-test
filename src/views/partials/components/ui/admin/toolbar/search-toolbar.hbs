{{!--
  Component: Search + Action Toolbar (Admin) — atomic wrapper
  Path: components/ui/admin/toolbar/search-toolbar.hbs
  Props: {{searchPlaceholder}}, {{buttonText}}, {{buttonHref}}

  Pencil: w-full h44, flex row gap 12, space-between, items-center
  Note: jika ada halaman yang tidak butuh search/button spesifik, inline di page
--}}
<div class='box-border w-full h-[44px] shrink-0 flex flex-row gap-[12px] justify-between items-center'>
  {{> components/ui/admin/form/search-input placeholder=searchPlaceholder value="searchInput"}}
  {{> components/ui/admin/button/primary-button text=buttonText href=buttonHref}}
</div>
