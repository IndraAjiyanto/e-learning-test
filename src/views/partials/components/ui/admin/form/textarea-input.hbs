{{!--
  Component: Textarea Input (Admin) — atomic
  Path: components/ui/admin/form/textarea-input.hbs
  Props: {{id}}, {{name}}, {{placeholder}}, {{xModel}} (optional Alpine),
         {{rows}} (default 4), {{class}} (optional), {{onBlur}} (optional Alpine expression),
         {{validateKey}} (optional, key for parent borderClass() validation outline),
         {{value}} (optional, pre-filled value for edit forms)
         {{required}} (optional, renders HTML required — dipakai gating tombol submit)

  Design: w fill_container, h128, p10 14, gap 8, bg white,
  outline 1px #D4D4D4, radius 8, text Inter 16/normal #404040
--}}
<div class='box-border w-full shrink-0 flex flex-row gap-[8px] p-[10px_14px] justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px] {{class}}'
  {{#if validateKey}}:class="borderClass('{{validateKey}}')"{{/if}}>
  <textarea
    id='{{id}}'
    name='{{default name id}}'
    rows='{{default rows 4}}'
    class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3] resize-none'
    placeholder='{{default placeholder ""}}'
    {{#if xModel}}x-model='{{xModel}}'{{/if}}
    {{#if onBlur}}@blur='{{onBlur}}'{{/if}}
    {{#if required}}required{{/if}}
  >{{default value ""}}</textarea>
</div>
