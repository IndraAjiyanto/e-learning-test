{{!--
  Component: Form Card (Admin) — atomic
  Path: components/ui/admin/form/form-card.hbs
  Props: {{num}} (optional when noNumber), {{title}} (optional when noNumber),
         {{class}} (optional), {{id}} (optional),
         {{noNumber}} (optional boolean — renders a plain white card without numbered badge header)

  Design (no number): bg white, stroke 1px #D9D9D9, radius 12, padding 20, gap 20
  Design (numbered): bg white, stroke 1px #D9D9D9, radius 12, padding 20, gap 24
  Header (numbered): flex row, gap 8, items center
  Num badge: 32x32 circle, bg #003060, text Montserrat 16 white center
  Title: Montserrat 16, #003060, semibold
--}}
{{#if noNumber}}
<div {{#if id}}id='{{id}}'{{/if}} class='box-border w-full h-fit shrink-0 flex flex-col gap-[20px] p-[20px] justify-start items-stretch bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px] {{class}}'>
  {{> @partial-block}}
</div>
{{else}}
<div {{#if id}}id='{{id}}'{{/if}} class='box-border w-full h-fit shrink-0 flex flex-col gap-[24px] p-[20px] justify-start items-stretch bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px] {{class}}'>
  <div class='flex flex-row gap-[8px] justify-start items-center'>
    <div class='box-border w-[32px] shrink-0 h-[32px] flex flex-row gap-0 justify-center items-center bg-[#003060] rounded-full'>
      <span class='text-[16px]/[normal] text-[#FFFFFF] font-inter font-semibold'>{{num}}</span>
    </div>
    <span class='text-[16px]/[normal] text-[#003060] font-inter font-semibold'>{{title}}</span>
  </div>
  {{> @partial-block}}
</div>
{{/if}}
