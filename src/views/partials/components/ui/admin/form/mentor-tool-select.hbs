{{!--
  Component: Mentor Tool Select (Admin) — organism, prefix mentor-
  Path: components/ui/admin/form/mentor-tool-select.hbs
  Dipakai: {{> components/ui/admin/form/mentor-tool-select availableJson=(json technologies)}}
           {{> components/ui/admin/form/mentor-tool-select availableJson=(json technologies) selectedJson=(json mentor.technologies)}}
  Props: {{availableJson}} (wajib, raw JSON array Technology { id, name, svg, imgUrl }),
         {{selectedJson}} (optional, raw JSON preselect — edit mode),
         {{inputName}} (optional, default 'technologyId[]'),
         {{label}} (optional, default 'Tools*'),
         {{placeholder}} (optional, default 'Search or select tools...')
  Composes: form/form-field, form/tool-icon, form/badge-chip (existing — reuse dulu).
  Design (Container - Mentor Form): search h44 + dropdown + badge-chip wrap.
  PENTING: input search ditulis inline (TIDAK pakai form/search-input) karena
  search-input mengikat @input='handleSearch()' yang tidak ada di scope x-data
  terisolasi ini — memakai search-input di sini menimbulkan Alpine error.
  Hidden input mengikuti DTO: technologyId[] (UUID).
  Dibuat terpisah karena blok ±40 baris ini diduplikasi di create + edit.
--}}
<div x-data="{
  search: '',
  selectedTools: ({{default selectedJson '[]'}}) || [],
  showDropdown: false,
  availableTools: ({{availableJson}}) || [],
  get filteredTools() {
    return this.availableTools.filter(t =>
      String(t.name || '').toLowerCase().includes(this.search.toLowerCase()) &&
      !this.selectedTools.find(s => s.id === t.id)
    );
  },
  selectTool(tool) { this.selectedTools.push(tool); this.search = ''; this.showDropdown = false; },
  removeTool(index) { this.selectedTools.splice(index, 1); }
}" @click.away='showDropdown = false'>
  {{#> components/ui/admin/form/form-field label=(default label 'Tools*') for="tools"}}
    <div class='relative'>
      <div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'>
        <input type='text' x-model='search' @focus='showDropdown = true' @input='showDropdown = true'
          placeholder='{{default placeholder 'Search or select tools'}}'
          class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]' />
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#737373' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[20px] h-[20px] shrink-0'><circle cx='11' cy='11' r='8'/><path d='m21 21-4.3-4.3'/></svg>
      </div>
      <div x-show='showDropdown && filteredTools.length > 0'
        class='absolute z-10 w-full mt-1 bg-white [outline:1px_solid_#D4D4D4] rounded-[8px] shadow-lg max-h-[200px] overflow-y-auto'>
        <template x-for='tool in filteredTools' :key='tool.id'>
          <button type='button' @click='selectTool(tool)'
            class='w-full flex items-center gap-[10px] px-[14px] py-[10px] hover:bg-[#F5F5F5] transition text-left border-b border-[#F5F5F5] last:border-0'>
            {{> components/ui/admin/form/tool-icon svg="tool.svg" img="tool.imgUrl" alt="tool.name" boxClass="w-[24px] h-[24px]"}}
            <span class='text-[14px]/[normal] font-inter text-[#404040]' x-text='tool.name'></span>
          </button>
        </template>
      </div>
    </div>
  {{/components/ui/admin/form/form-field}}

  {{!-- Selected Tool Badges --}}
  <div class='flex flex-row flex-wrap gap-[8px] mt-[8px]'>
    <template x-for='(tool, index) in selectedTools' :key='tool.id'>
      {{> components/ui/admin/form/badge-chip xLabel="tool.name" removeClick="removeTool(index)" inputName=(default inputName 'technologyId[]') inputValueBind="tool.id" iconSvg="tool.svg" iconImg="tool.imgUrl" iconAlt="tool.name"}}
    </template>
  </div>
</div>
