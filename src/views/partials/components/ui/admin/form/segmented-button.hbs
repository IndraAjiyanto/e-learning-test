{{!--
  Component: Segmented Button (Admin) — atomic
  Path: components/ui/admin/form/segmented-button.hbs
  Props: {{name}}, {{options}} (array of {label, value[, active][, onClick][, activeIf]}),
         {{alpineVar}} (optional, Alpine variable holding current value for reactive mode)

  Static mode (default): active segment from each option's {{active}} boolean.
  Alpine mode: pass {{alpineVar}} (e.g. "paidClass" or "methodOnline") — each button
  gets @click from its option's {{onClick}} (e.g. "paidClass = true"), and active
  state reacts to {{alpineVar}} === option value. If an option has no {{onClick}},
  falls back to "{{alpineVar}} = '<value>'".
  Boolean-state mode: an option may carry {{activeIf}} (raw Alpine expression,
  e.g. "paidClass" / "!paidClass") — used for the active-state :class instead of
  the string === comparison. Required when the Alpine variable is boolean.

  Each segment: flex-1, h fill, center, text Inter 16/normal
  Active segment: bg #003060, text white
  Inactive: text #404040
--}}
<div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-0 justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px] overflow-hidden'>
  {{#each options}}
  <button type='button'
    class='flex-1 h-full flex flex-row justify-center items-center transition-colors {{#if ../alpineVar}}{{else}}{{#if active}}bg-[#003060]{{else}}bg-transparent hover:bg-[#F5F5F5]{{/if}}{{/if}}'
    {{#if ../alpineVar}}@click="{{#if onClick}}{{{onClick}}}{{else}}{{../alpineVar}} = '{{value}}'{{/if}}" :class="({{#if activeIf}}{{{activeIf}}}{{else}}{{../alpineVar}} === '{{value}}'{{/if}}) ? 'bg-[#003060]' : 'bg-transparent hover:bg-[#F5F5F5]'"{{else}}@click=''{{/if}}
  >
    <span class='text-[16px]/[normal] font-inter font-medium {{#if ../alpineVar}}{{else}}{{#if active}}text-[#FFFFFF]{{else}}text-[#404040]{{/if}}{{/if}}'
      {{#if ../alpineVar}}:class="({{#if activeIf}}{{{activeIf}}}{{else}}{{../alpineVar}} === '{{value}}'{{/if}}) ? 'text-[#FFFFFF]' : 'text-[#404040]'"{{/if}}>{{label}}</span>
  </button>
  {{/each}}
</div>
