{{!--
  Component: Language Tabs (Admin) — atomic
  Path: components/ui/admin/form/language-tabs.hbs
  Props: {{activeTab}} (optional, default "id"), {{alpineVar}} (optional, Alpine variable name for reactive mode),
         {{variant}} (optional, "full" default | "compact" | "mini" | "underline"), {{class}} (optional),
         {{errId}} {{errEn}} {{errJa}} (optional, fieldStatus keys for per-tab
         required hint — e.g. "description_id". When fieldStatus[key] === 'error',
         that tab gets a red border/bar + "Wajib diisi" title. Requires the
         parent Alpine scope to expose `fieldStatus`.)

  Static mode (default): active tab from {{activeTab}} data.
  Alpine mode: pass {{alpineVar}} (e.g. "descTab") — buttons get @click to set it
  and :class bindings react to it.

  Variants:
  - full (default): w128 tabs with flag + full language names (Indonesia/English/Japanese)
  - compact: w100 tabs with flag + short labels (ID/EN/JP)
  - mini: w80 tabs, no flag, short labels (ID/EN/JP)
  - underline (slicing.pen Feature Card): full-width bar with bottom border #D9D9D9,
    tabs ID 97 / EN 101 / JP 98 x h40, flag 20 circle + Montserrat 14 semibold #003060 label,
    active tab = 2px bottom accent #055C90 (box-shadow, no layout shift)

  Design: flex row, gap 8
  Tab: h40, p0 12, gap 8, radius 8, bg transparent
  Active: outline 1px #003060, text #003060
  Inactive: text #525252
  Flag: 20x20 circle, flagcdn image
--}}
{{#if (eq variant "underline")}}
<div class='flex flex-row w-full [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#D9D9D9] {{class}}'>
  <button type='button'
    {{#if alpineVar}}@click="{{alpineVar}} = 'id'" :class="{{#if errId}}(fieldStatus['{{errId}}'] === 'error' ? '[box-shadow:0px_2px_0px_0px_#DC2626]' : ({{alpineVar}} === 'id' ? '[box-shadow:0px_2px_0px_0px_#055C90]' : '[box-shadow:0px_2px_0px_0px_transparent]'))" :title="fieldStatus['{{errId}}'] === 'error' ? 'Wajib diisi' : ''"{{else}}{{alpineVar}} === 'id' ? '[box-shadow:0px_2px_0px_0px_#055C90]' : '[box-shadow:0px_2px_0px_0px_transparent]'"{{/if}}{{/if}}
    class='box-border w-[97px] shrink-0 h-[40px] flex flex-row gap-[4px] p-[10px_28px] justify-center items-center {{#unless alpineVar}}{{#if (eq activeTab "id")}}[box-shadow:0px_2px_0px_0px_#055C90]{{else}}[box-shadow:0px_2px_0px_0px_transparent]{{/if}}{{/unless}}'>
    <div class='w-[20px] h-[20px] rounded-full overflow-hidden bg-cover bg-center shrink-0' style="background-image: url('https://flagcdn.com/w320/id.png')"></div>
    <span class='text-[14px]/[normal] font-montserrat font-semibold text-[#003060]'>ID</span>
  </button>
  <button type='button'
    {{#if alpineVar}}@click="{{alpineVar}} = 'en'" :class="{{#if errEn}}(fieldStatus['{{errEn}}'] === 'error' ? '[box-shadow:0px_2px_0px_0px_#DC2626]' : ({{alpineVar}} === 'en' ? '[box-shadow:0px_2px_0px_0px_#055C90]' : '[box-shadow:0px_2px_0px_0px_transparent]'))" :title="fieldStatus['{{errEn}}'] === 'error' ? 'Wajib diisi' : ''"{{else}}{{alpineVar}} === 'en' ? '[box-shadow:0px_2px_0px_0px_#055C90]' : '[box-shadow:0px_2px_0px_0px_transparent]'"{{/if}}{{/if}}
    class='box-border w-[101px] shrink-0 h-[40px] flex flex-row gap-[4px] p-[10px_28px] justify-center items-center {{#unless alpineVar}}{{#if (eq activeTab "en")}}[box-shadow:0px_2px_0px_0px_#055C90]{{else}}[box-shadow:0px_2px_0px_0px_transparent]{{/if}}{{/unless}}'>
    <div class='w-[20px] h-[20px] rounded-full overflow-hidden bg-cover bg-center shrink-0' style="background-image: url('https://flagcdn.com/w320/gb.png')"></div>
    <span class='text-[14px]/[normal] font-montserrat font-semibold text-[#003060]'>EN</span>
  </button>
  <button type='button'
    {{#if alpineVar}}@click="{{alpineVar}} = 'ja'" :class="{{#if errJa}}(fieldStatus['{{errJa}}'] === 'error' ? '[box-shadow:0px_2px_0px_0px_#DC2626]' : ({{alpineVar}} === 'ja' ? '[box-shadow:0px_2px_0px_0px_#055C90]' : '[box-shadow:0px_2px_0px_0px_transparent]'))" :title="fieldStatus['{{errJa}}'] === 'error' ? 'Wajib diisi' : ''"{{else}}{{alpineVar}} === 'ja' ? '[box-shadow:0px_2px_0px_0px_#055C90]' : '[box-shadow:0px_2px_0px_0px_transparent]'"{{/if}}{{/if}}
    class='box-border w-[98px] shrink-0 h-[40px] flex flex-row gap-[4px] p-[10px_28px] justify-center items-center {{#unless alpineVar}}{{#if (eq activeTab "ja")}}[box-shadow:0px_2px_0px_0px_#055C90]{{else}}[box-shadow:0px_2px_0px_0px_transparent]{{/if}}{{/unless}}'>
    <div class='w-[20px] h-[20px] rounded-full overflow-hidden bg-cover bg-center shrink-0' style="background-image: url('https://flagcdn.com/w320/jp.png')"></div>
    <span class='text-[14px]/[normal] font-montserrat font-semibold text-[#003060]'>JP</span>
  </button>
</div>
{{else}}
<div class='flex flex-row gap-[8px] {{class}}'>
  <button type='button'
    {{#if alpineVar}}@click="{{alpineVar}} = 'id'" :class="{{#if errId}}(fieldStatus['{{errId}}'] === 'error' ? '[outline:1px_solid_#DC2626]' : ({{alpineVar}} === 'id' ? '[outline:1px_solid_#003060]' : 'bg-transparent'))" :title="fieldStatus['{{errId}}'] === 'error' ? 'Wajib diisi' : ''"{{else}}{{alpineVar}} === 'id' ? '[outline:1px_solid_#003060]' : 'bg-transparent'"{{/if}}{{/if}}
    class='box-border {{#if (eq variant "mini")}}w-[80px]{{else}}{{#if (eq variant "compact")}}w-[100px]{{else}}w-[128px]{{/if}}{{/if}} shrink-0 h-[40px] flex flex-row gap-[8px] p-[0px_12px] justify-center items-center rounded-[8px] {{#unless alpineVar}}{{#if (eq activeTab "id")}}[outline:1px_solid_#003060]{{else}}bg-transparent{{/if}}{{/unless}}'>
    {{#unless (eq variant "mini")}}<div class='w-[20px] h-[20px] rounded-full overflow-hidden bg-cover bg-center' style="background-image: url('https://flagcdn.com/w320/id.png')"></div>{{/unless}}
    <span class='text-[14px]/[normal] font-inter font-medium {{#unless alpineVar}}{{#if (eq activeTab "id")}}text-[#003060]{{else}}text-[#525252]{{/if}}{{/unless}}'
      {{#if alpineVar}}:class="{{alpineVar}} === 'id' ? 'text-[#003060]' : 'text-[#525252]'"{{/if}}>{{#if (or (eq variant "compact") (eq variant "mini"))}}ID{{else}}Indonesia{{/if}}</span>
  </button>
  <button type='button'
    {{#if alpineVar}}@click="{{alpineVar}} = 'en'" :class="{{#if errEn}}(fieldStatus['{{errEn}}'] === 'error' ? '[outline:1px_solid_#DC2626]' : ({{alpineVar}} === 'en' ? '[outline:1px_solid_#003060]' : 'bg-transparent'))" :title="fieldStatus['{{errEn}}'] === 'error' ? 'Wajib diisi' : ''"{{else}}{{alpineVar}} === 'en' ? '[outline:1px_solid_#003060]' : 'bg-transparent'"{{/if}}{{/if}}
    class='box-border {{#if (eq variant "mini")}}w-[80px]{{else}}{{#if (eq variant "compact")}}w-[100px]{{else}}w-[128px]{{/if}}{{/if}} shrink-0 h-[40px] flex flex-row gap-[8px] p-[0px_12px] justify-center items-center rounded-[8px] {{#unless alpineVar}}{{#if (eq activeTab "en")}}[outline:1px_solid_#003060]{{else}}bg-transparent{{/if}}{{/unless}}'>
    {{#unless (eq variant "mini")}}<div class='w-[20px] h-[20px] rounded-full overflow-hidden bg-cover bg-center' style="background-image: url('https://flagcdn.com/w320/gb.png')"></div>{{/unless}}
    <span class='text-[14px]/[normal] font-inter font-medium {{#unless alpineVar}}{{#if (eq activeTab "en")}}text-[#003060]{{else}}text-[#525252]{{/if}}{{/unless}}'
      {{#if alpineVar}}:class="{{alpineVar}} === 'en' ? 'text-[#003060]' : 'text-[#525252]'"{{/if}}>{{#if (or (eq variant "compact") (eq variant "mini"))}}EN{{else}}English{{/if}}</span>
  </button>
  <button type='button'
    {{#if alpineVar}}@click="{{alpineVar}} = 'ja'" :class="{{#if errJa}}(fieldStatus['{{errJa}}'] === 'error' ? '[outline:1px_solid_#DC2626]' : ({{alpineVar}} === 'ja' ? '[outline:1px_solid_#003060]' : 'bg-transparent'))" :title="fieldStatus['{{errJa}}'] === 'error' ? 'Wajib diisi' : ''"{{else}}{{alpineVar}} === 'ja' ? '[outline:1px_solid_#003060]' : 'bg-transparent'"{{/if}}{{/if}}
    class='box-border {{#if (eq variant "mini")}}w-[80px]{{else}}{{#if (eq variant "compact")}}w-[100px]{{else}}w-[128px]{{/if}}{{/if}} shrink-0 h-[40px] flex flex-row gap-[8px] p-[0px_12px] justify-center items-center rounded-[8px] {{#unless alpineVar}}{{#if (eq activeTab "ja")}}[outline:1px_solid_#003060]{{else}}bg-transparent{{/if}}{{/unless}}'>
    {{#unless (eq variant "mini")}}<div class='w-[20px] h-[20px] rounded-full overflow-hidden bg-cover bg-center' style="background-image: url('https://flagcdn.com/w320/jp.png')"></div>{{/unless}}
    <span class='text-[14px]/[normal] font-inter font-medium {{#unless alpineVar}}{{#if (eq activeTab "ja")}}text-[#003060]{{else}}text-[#525252]{{/if}}{{/unless}}'
      {{#if alpineVar}}:class="{{alpineVar}} === 'ja' ? 'text-[#003060]' : 'text-[#525252]'"{{/if}}>{{#if (or (eq variant "compact") (eq variant "mini"))}}JP{{else}}Japanese{{/if}}</span>
  </button>
</div>
{{/if}}
