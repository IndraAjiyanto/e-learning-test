{{!--
  Component: Toggle Switch (Admin)
  Path: components/ui/admin/form/toggle-switch.hbs
  Props: {{checked}}, {{name}}, {{value}}

  Design: track 44x24, knob 20x20, ON green-500, OFF neutral-200
--}}
<label class='relative inline-flex h-6 w-11 cursor-pointer items-center'>
  <input
    type='checkbox'
    class='peer sr-only'
    name='{{name}}'
    {{#if checked}}checked{{/if}}
    {{#if value}}value='{{value}}'{{/if}}
  />
  <span class='block h-6 w-11 rounded-full bg-[#E5E5E5] transition-colors peer-checked:bg-[#22C55E]'></span>
  <span class='absolute left-0.5 top-0.5 block h-5 w-5 rounded-full bg-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.06)] transition-transform peer-checked:translate-x-5'></span>
</label>
