{{!--
  Component: EditorJS Input (Admin) — atomic
  Path: components/ui/admin/form/editor-input.hbs
  Props: {{id}} (holder id, default 'editorjs'),
         {{name}} (hidden input name, default 'content'),
         {{inputId}} (hidden input id, default '{{id}}_input'),
         {{class}} (optional wrapper class),
         {{holderClass}} (optional holder class)
--}}
<div class='box-border w-full min-h-[160px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] p-[10px_14px] focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors {{class}}'>
  {{!-- x-ignore prevents Alpine from re-scanning and breaking EditorJS event listeners --}}
  <div
    id='{{default id "editorjs"}}'
    x-ignore
    class='editorjs-container w-full font-inter text-[16px] leading-[24px] text-[#171717] pl-8 sm:pl-10 {{holderClass}}'
  ></div>
</div>
<input
  type='hidden'
  name='{{default name "content"}}'
  id='{{#if inputId}}{{inputId}}{{else}}{{default id "editorjs"}}_input{{/if}}'
/>

<style>
  .editorjs-container .codex-editor__redactor {
    padding-bottom: 24px !important;
  }
  .editorjs-container .ce-block__content,
  .editorjs-container .ce-toolbar__content {
    max-width: 100% !important;
  }
  .editorjs-container .ce-header {
    font-family: 'Inter', sans-serif !important;
    color: #171717 !important;
    margin: 0 !important;
    padding: 0.4em 0 !important;
  }
  .editorjs-container h1.ce-header {
    font-size: 28px !important;
    line-height: 36px !important;
    font-weight: 700 !important;
  }
  .editorjs-container h2.ce-header {
    font-size: 24px !important;
    line-height: 32px !important;
    font-weight: 700 !important;
  }
  .editorjs-container h3.ce-header {
    font-size: 20px !important;
    line-height: 28px !important;
    font-weight: 600 !important;
  }
  .editorjs-container h4.ce-header {
    font-size: 18px !important;
    line-height: 26px !important;
    font-weight: 600 !important;
  }
  .editorjs-container h5.ce-header {
    font-size: 16px !important;
    line-height: 24px !important;
    font-weight: 600 !important;
  }
  .editorjs-container h6.ce-header {
    font-size: 14px !important;
    line-height: 20px !important;
    font-weight: 600 !important;
  }
  .editorjs-container .ce-header[data-placeholder]:empty::before {
    color: #737373 !important;
    font-weight: 400 !important;
  }
  .editorjs-container .ce-paragraph {
    font-family: 'Inter', sans-serif !important;
    font-size: 16px !important;
    line-height: 24px !important;
    color: #171717 !important;
  }
  .editorjs-container .ce-paragraph[data-placeholder]:empty::before {
    color: #737373 !important;
    font-weight: 400 !important;
  }
  .editorjs-container .image-tool__image,
  .codex-editor .image-tool__image {
    max-width: 648px !important;
    max-height: 486px !important;
  }
  .editorjs-container .image-tool__image-picture,
  .editorjs-container img,
  .codex-editor .image-tool__image-picture,
  .codex-editor img {
    max-width: 648px !important;
    max-height: 486px !important;
    width: auto;
    height: auto;
    object-fit: contain;
  }
</style>

