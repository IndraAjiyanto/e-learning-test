{{!--
  Component: Rich Text Editor Input (Admin) — reusable container (Quill)
  Path: components/ui/admin/form/editor-input.hbs
  Props: {{id}} (holder id, default 'editorjs'),
         {{name}} (hidden input name, default 'content'),
         {{inputId}} (hidden input id, default '{{id}}_input'),
         {{value}} (initial content string/json),
         {{placeholder}} (placeholder text),
         {{uploadUrl}} (upload URL, default '/program/upload-image'),
         {{class}} (optional wrapper class),
         {{holderClass}} (optional holder class)
--}}
<div
  x-data='quillEditorContainer({
    holderId: "{{default id "editorjs"}}",
    inputId: "{{#if inputId}}{{inputId}}{{else}}{{default id "editorjs"}}_input{{/if}}",
    uploadUrl: "{{default uploadUrl "/program/upload-image"}}",
    placeholder: "{{default placeholder "Write your content here..."}}"
  })'
  class='w-full'
>
  <div class='box-border w-full min-h-[200px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] overflow-hidden focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors {{class}}'>
    {{!-- x-ignore prevents Alpine from re-scanning and breaking editor listeners --}}
    <div
      id='{{default id "editorjs"}}'
      x-ignore
      class='quill-editor-container w-full font-inter text-[16px] leading-[24px] text-[#171717] min-h-[160px] {{holderClass}}'
    ></div>
  </div>
  <input
    type='hidden'
    name='{{default name "content"}}'
    id='{{#if inputId}}{{inputId}}{{else}}{{default id "editorjs"}}_input{{/if}}'
    x-ref='input'
  />
  {{#if value}}
    <script type="application/json" id="{{default id 'editorjs'}}_bootstrap_value">
      {{{jsonSafe value}}}
    </script>
  {{/if}}
</div>

<style>
  .quill-editor-container.ql-container {
    font-family: 'Inter', sans-serif !important;
    font-size: 16px !important;
    border: none !important;
  }
  .ql-toolbar.ql-snow {
    border: none !important;
    border-bottom: 1px solid #E5E7EB !important;
    background-color: #F8FAFC !important;
    padding: 8px 12px !important;
  }
  /* Ensure bulleted lists in Quill 2 show bullets and never numbers */
  .quill-editor-container .ql-editor li[data-list=bullet] > .ql-ui:before {
    content: '\2022' !important;
  }
  .quill-editor-container .ql-editor li[data-list=bullet]:before {
    content: none !important;
  }
  .quill-editor-container .ql-editor li[data-list=ordered]:before {
    content: none !important;
  }
  .quill-editor-container .ql-editor li:not([data-list=ordered]):before {
    content: none !important;
  }
  .quill-editor-container .ql-editor {
    min-height: 160px !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 16px !important;
    line-height: 24px !important;
    color: #171717 !important;
    padding: 12px 16px !important;
  }
  .quill-editor-container .ql-editor img {
    max-width: 100% !important;
    max-height: 280px !important;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    margin: 8px auto;
    display: block;
  }
  .quill-editor-container .ql-editor .ql-align-right img {
    margin-left: auto !important;
    margin-right: 0 !important;
  }
  .quill-editor-container .ql-editor .ql-align-left img {
    margin-left: 0 !important;
    margin-right: auto !important;
  }
  .quill-editor-container .ql-editor .ql-align-center img {
    margin-left: auto !important;
    margin-right: auto !important;
  }
  .ql-snow .ql-picker.ql-lineHeight,
  .ql-snow .ql-picker.ql-line-height {
    width: 105px;
  }
  .ql-snow .ql-picker.ql-lineHeight .ql-picker-label::before,
  .ql-snow .ql-picker.ql-line-height .ql-picker-label::before {
    content: 'Line Height';
    line-height: 22px;
