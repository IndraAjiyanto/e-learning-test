  .ql-snow .ql-picker.ql-lineHeight .ql-picker-item::before,
  .ql-snow .ql-picker.ql-line-height .ql-picker-item::before {
    content: 'Normal';
  }
  .ql-snow .ql-picker.ql-lineHeight .ql-picker-label[data-value="1"]::before,
  .ql-snow .ql-picker.ql-lineHeight .ql-picker-item[data-value="1"]::before,
  .ql-snow .ql-picker.ql-line-height .ql-picker-label[data-value="1"]::before,
  .ql-snow .ql-picker.ql-line-height .ql-picker-item[data-value="1"]::before {
    content: '1.0';
  }
  .ql-snow .ql-picker.ql-lineHeight .ql-picker-label[data-value="1.15"]::before,
  .ql-snow .ql-picker.ql-lineHeight .ql-picker-item[data-value="1.15"]::before,
  .ql-snow .ql-picker.ql-line-height .ql-picker-label[data-value="1.15"]::before,
  .ql-snow .ql-picker.ql-line-height .ql-picker-item[data-value="1.15"]::before {
    content: '1.15';
  }
