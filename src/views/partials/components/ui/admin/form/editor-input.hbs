{{!--
  Component: Rich Text Editor Input (Admin) — atomic (Quill)
  Path: components/ui/admin/form/editor-input.hbs
  Props: {{id}} (holder id, default 'editorjs'),
         {{name}} (hidden input name, default 'content'),
         {{inputId}} (hidden input id, default '{{id}}_input'),
         {{class}} (optional wrapper class),
         {{holderClass}} (optional holder class)
--}}
<div class='box-border w-full min-h-[200px] bg-[#FFFFFF] border border-[#D4D4D4] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] rounded-[8px] overflow-hidden focus-within:border-[#003060] focus-within:ring-1 focus-within:ring-[#003060] transition-colors {{class}}'>
  {{!-- x-ignore prevents Alpine from re-scanning and breaking editor listeners --}}
  <div
    id='{{default id "editorjs"}}'
    x-ignore
    class='quill-editor-container w-full font-inter text-[16px] leading-[24px] text-[#171717] min-h-[160px] {{holderClass}}'
  ></div>
</div>
<input
  type='hidden'
  name='{{default name "content"}}'
  id='{{#if inputId}}{{inputId}}{{else}}{{default id "editorjs"}}_input{{/if}}'
/>

<style>
  .quill-editor-container.ql-container {
    font-family: 'Inter', sans-serif !important;
    font-size: 16px !important;
    border: none !important;
  }
  .ql-toolbar.ql-snow {
    border: none !important;
    border-bottom: 1px solid #E5E7EB !important;
    background-color: #F8FAFC !important;
    padding: 8px 12px !important;
  }
  .quill-editor-container .ql-editor {
    min-height: 160px !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 16px !important;
    line-height: 24px !important;
    color: #171717 !important;
    padding: 12px 16px !important;
  }
  .quill-editor-container .ql-editor img {
    max-width: 100% !important;
    max-height: 280px !important;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    margin: 8px auto;
    display: block;
  }
  .quill-editor-container .ql-editor .ql-align-right img {
    margin-left: auto !important;
    margin-right: 0 !important;
  }
  .quill-editor-container .ql-editor .ql-align-left img {
    margin-left: 0 !important;
    margin-right: auto !important;
  }
  .quill-editor-container .ql-editor .ql-align-center img {
    margin-left: auto !important;
    margin-right: auto !important;
  }
</style>
