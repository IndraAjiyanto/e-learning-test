  }
  .ql-snow .ql-picker.ql-lineHeight .ql-picker-label[data-label]:not([data-label=''])::before,
  .ql-snow .ql-picker.ql-lineHeight .ql-picker-item[data-label]:not([data-label=''])::before,
  .ql-snow .ql-picker.ql-line-height .ql-picker-label[data-label]:not([data-label=''])::before,
  .ql-snow .ql-picker.ql-line-height .ql-picker-item[data-label]:not([data-label=''])::before {
    content: attr(data-label);
  }
  .quill-editor-container .ql-editor table {
    border-collapse: collapse !important;
    width: 100% !important;
    table-layout: fixed !important;
  }
  .quill-editor-container .ql-editor table td {
    border: 1px solid #d1d5db !important;
    padding: 6px 10px !important;
    min-width: 30px;
    vertical-align: top;
    box-sizing: border-box !important;
  }
</style>
