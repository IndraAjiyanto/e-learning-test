{{!--
  Component: Mentor Error Box (Admin) — atomic, prefix mentor-
  Path: components/ui/admin/form/mentor-error-box.hbs
  Dipakai: {{> components/ui/admin/form/mentor-error-box message="nameError"}}
  Props: {{message}} (Alpine expression untuk x-text — mis. 'nameError', 'positionError.id')
  Alpine scope: parent harus punya variabel error string tersebut.
  Dibuat terpisah karena pola error-box kecil ini dipakai ~8x per form mentor
  (name, linkedin, 3x position, 3x description) × 2 halaman (create/edit).
--}}
<div class='flex items-center gap-[6px] px-[10px] py-[6px] bg-[#FEF2F2] border border-[#FECACA] rounded-[6px]'>
  <span class='text-[12px]/[normal] font-inter text-[#DC2626]' x-text='{{{message}}}'></span>
</div>
