{{!--
  Component: Dynamic List Row (Admin) — atomic
  Path: components/ui/admin/form/dynamic-list-row.hbs
  Props: {{num}}, {{inputId}}, {{inputName}}, {{placeholder}}, {{xModel}}

  Design: flex row, gap 8, items center
  Num badge: 42x44, bg #F5F5F5, radius 8, text Inter 14 center
  Input: flex-1, h44, p10 14, bg white, outline 1px #D4D4D4, radius 8
  Delete btn: 44x44, bg white, outline 1px #D4D4D4, radius 8, icon trash 20px #DC2626
--}}
<div class='flex flex-row gap-[8px] justify-start items-center'>
  <div class='box-border w-[42px] shrink-0 h-[44px] flex flex-row gap-0 justify-center items-center bg-[#F5F5F5] rounded-[8px]'>
    <span class='text-[14px]/[normal] text-[#525252] font-inter font-medium'>{{num}}</span>
  </div>
  <div class='box-border flex-1 min-w-0 shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px]'>
    <input
      type='text'
      id='{{inputId}}'
      name='{{default inputName inputId}}'
      class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]'
      placeholder='{{default placeholder "Enter item"}}'
      {{#if xModel}}x-model='{{xModel}}'{{/if}}
    />
  </div>
  <button type='button'
    class='box-border w-[44px] shrink-0 h-[44px] flex flex-row gap-0 justify-center items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px] hover:bg-[#FEF2F2] transition-colors'
    title='Delete'>
    <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#DC2626' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[20px] h-[20px]'>
      <path d='M3 6h18'/>
      <path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/>
      <path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/>
      <line x1='10' x2='10' y1='11' y2='17'/>
      <line x1='14' x2='14' y1='11' y2='17'/>
    </svg>
  </button>
</div>
