{{!--
  Component: Text Input (Admin) — atomic
  Path: components/ui/admin/form/text-input.hbs
  Props: {{id}}, {{name}}, {{placeholder}}, {{value}}, {{type}} (default "text"),
         {{xModel}} (optional Alpine), {{class}} (optional), {{disabled}},
         {{required}} (optional, renders HTML required),
         {{xRequired}} (optional, Alpine expression for conditional required, e.g. "posTab === 'id'"),
         {{onBlur}} (optional Alpine expression), {{onInput}} (optional Alpine expression),
         {{validateKey}} (optional, key for parent borderClass() validation outline),
         {{icon}} (optional, "calendar" or "timer" — renders trailing SVG icon;
         clicking it opens the native picker via showPicker())

  outline 1px #D4D4D4, radius 8, text Inter 16/normal #404040
--}}
<div class='box-border w-full shrink-0 h-[44px] flex flex-row gap-[8px] p-[10px_14px] justify-start items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px] {{class}}'
  {{#if validateKey}}:class="borderClass('{{validateKey}}')"{{/if}}>
  <input
    type='{{default type "text"}}'
    id='{{id}}'
    name='{{default name id}}'
    class='text-[16px]/[normal] flex-1 min-w-0 text-[#404040] font-inter font-normal text-left bg-transparent outline-none placeholder:text-[#A3A3A3]{{#if (or (eq type "date") (eq type "time") (eq type "datetime-local") (eq type "month") (eq type "week"))}} [color-scheme:light] cursor-pointer [&::-webkit-calendar-picker-indicator]:hidden{{/if}}'
    placeholder='{{default placeholder ""}}'
    {{#if value}}value='{{value}}'{{/if}}
    {{#if xModel}}x-model='{{xModel}}'{{/if}}
    {{#if xRequired}}:required='{{xRequired}}'{{else if required}}required{{/if}}
    {{#if onBlur}}@blur='{{onBlur}}'{{/if}}
    {{#if onInput}}@input='{{onInput}}'{{/if}}
    {{#if disabled}}disabled{{/if}}
  />
  {{#if (eq icon "calendar")}}
  <label for='{{id}}' class='cursor-pointer shrink-0' onclick="var el=document.getElementById('{{id}}');if(el){if(el.showPicker){try{el.showPicker()}catch(e){}}el.focus()}">
    <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#737373' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'><rect width='18' height='18' x='3' y='4' rx='2' ry='2'/><line x1='16' x2='16' y1='2' y2='6'/><line x1='8' x2='8' y1='2' y2='6'/><line x1='3' x2='21' y1='10' y2='10'/></svg>
  </label>
  {{/if}}
  {{#if (eq icon "timer")}}
  <label for='{{id}}' class='cursor-pointer shrink-0' onclick="var el=document.getElementById('{{id}}');if(el){if(el.showPicker){try{el.showPicker()}catch(e){}}el.focus()}">
    <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#737373' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg>
  </label>
  {{/if}}
</div>
