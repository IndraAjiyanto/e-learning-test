{{!--
  Component: Logbook Review Table (Admin) — organism, prefix logbook-
  Path: components/ui/admin/logbook/logbook-table.hbs
  Dipakai: {{> components/ui/admin/logbook/logbook-table}} di dalam scope logbookData() pada admin/session/detail → tab logbook.
  Composes: program/user-avatar (userObj), logbook/logbook-status-badge (statusVar), program/logbook-pill tidak dipakai di sini.

  Header h44 bg FAFAFA Inter 12/500 #525252 p12 24 + border-bottom; Row h72 Inter 14/normal #525252 p16 24 + border-bottom + hover #fafafa
  Kolom (total 2252px + LinkedIn baru): User 268 | LinkedIn 200* | Activity 240 | Activity Details 240 | Obstacle 200 | Documentation 138 | Documentation Link 180 | Program Name 280 | Status 140 | Confirm 140 | Action(Details) 227
  *LinkedIn baru (user request): future-proof, BE User tidak punya linkedin → tampil "-" sampai BE menyediakannya; sumber: user.linkedin / user.biodata.linkedin / user.biodata?.linkedin
  Action: Details berisi edit (square-pen #525252 20) + delete (trash-2 #DC2626 20) + View (75 #003060). Confirm: Approve 40 #BBF7D0 check #16A34A + Reject 40 #FECACA x #DC2626
  Reuse: user-avatar sudah ada; status-badge baru karena warna/logika logbook spesifik; toolbar terpisah.
  BE: GET /session/logbooks/:sessionId → Logbook[] { id, activity, activityDetails, obstacles, documentation, otherDocumentation, process, createdAt, user { id, username, email, linkedin?, biodata? }, session.weeks.course.name }
      PATCH /logbooks/:id/:proses (approved/rejected), GET /logbooks/formEdit/:id, DELETE /logbooks/:sessionId/:id
  Alpine parent: filteredData, pageNumber, size, formatDate(), openModal(), exportExcel(), searchInput/search
--}}
<style>
  .logbook-review-scroll::-webkit-scrollbar { height: 6px; }
  .logbook-review-scroll::-webkit-scrollbar-track { background: transparent; }
  .logbook-review-scroll::-webkit-scrollbar-thumb { background: #D4D4D4; border-radius: 999px; }
  .logbook-review-scroll::-webkit-scrollbar-thumb:hover { background: #A3A3A3; }
</style>
<div class='box-border w-full h-fit shrink-0 flex flex-col gap-0 justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#E5E5E5] [outline-offset:-0.5px] rounded-[12px] overflow-hidden shadow-[0px_1px_2px_0px_rgba(0,0,0,0.06)]'>

  {{!-- Toolbar --}}
  {{> components/ui/admin/logbook/logbook-toolbar sessionId=session.id}}

  {{!-- Table --}}
  <div x-show='filteredData && filteredData.length > 0' class='logbook-review-scroll w-full overflow-x-auto overflow-y-hidden [scrollbar-width:thin] [scrollbar-color:#D4D4D4_transparent]'>
    {{!-- Header --}}
    <div class='w-full min-w-[2252px] h-[44px] shrink-0 flex flex-row gap-0 justify-start items-start bg-[#FAFAFA] [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#E5E5E5] [margin:0px_0px_-0.5px_0px]'>
      <div class='box-border w-[268px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>User</div></div>
      <div class='box-border w-[200px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>LinkedIn</div></div>
      <div class='box-border w-[240px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>Activity</div></div>
      <div class='box-border w-[240px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>Activity Details</div></div>
      <div class='box-border w-[200px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>Obstacle</div></div>
      <div class='box-border w-[138px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>Documentation</div></div>
      <div class='box-border w-[180px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>Documentation Link</div></div>
      <div class='box-border w-[280px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>Program Name</div></div>
      <div class='box-border w-[140px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-start items-center'><div class='text-[12px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-medium text-left'>Status</div></div>
      <div class='box-border w-[140px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-center items-center'><div class='text-[12px]/[normal] text-[#525252] font-inter font-medium text-center whitespace-nowrap'>Confirm</div></div>
      <div class='box-border w-[227px] shrink-0 h-full flex flex-row gap-0 p-[12px_24px] justify-center items-center'><div class='text-[12px]/[normal] text-[#525252] font-inter font-medium text-center whitespace-nowrap'>Action</div></div>
    </div>

    {{!-- Body --}}
    <template x-for='(log, index) in filteredData' :key='log.id'>
      <div class='w-full min-w-[2252px] h-[72px] shrink-0 flex flex-row gap-0 justify-start items-start bg-[#FFFFFF] [border-width:0px_0px_1px_0px] [border-style:solid] [border-color:#E5E5E5] [margin:0px_0px_-0.5px_0px] hover:bg-[#fafafa] transition-colors'>

        {{!-- User --}}
        <div class='box-border w-[268px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          <div class='box-border flex-1 min-w-0 flex flex-row gap-[10px] justify-start items-center'>
            {{> components/ui/admin/program/user-avatar userObj='log.user'}}
            <div class='flex-1 min-w-0 flex flex-col gap-0 justify-center items-start'>
              <div class='text-[14px]/[normal] w-full overflow-hidden text-ellipsis whitespace-nowrap text-[#404040] font-inter font-semibold text-left' x-text="log.user?.username ?? '-'" :title="log.user?.username ?? ''"></div>
              <div class='text-[12px]/[normal] w-full overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-normal text-left' x-text="log.user?.email ?? '-'" :title="log.user?.email ?? ''"></div>
            </div>
          </div>
        </div>

        {{!-- LinkedIn (future-proof) --}}
        <div class='box-border w-[200px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          <template x-if='log.user?.linkedin || log.user?.biodata?.linkedin'>
            <a :href='log.user?.linkedin || log.user?.biodata?.linkedin' target='_blank' rel='noopener noreferrer'
              class='text-[14px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#3B82F6] font-inter font-normal text-left hover:underline'
              x-text='log.user?.linkedin || log.user?.biodata?.linkedin' :title='log.user?.linkedin || log.user?.biodata?.linkedin'></a>
          </template>
          <template x-if='!log.user?.linkedin && !log.user?.biodata?.linkedin'>
            <div class='text-[14px]/[normal] flex-1 text-[#525252] font-inter font-normal text-left'>-</div>
          </template>
        </div>

        {{!-- Activity --}}
        <div class='box-border w-[240px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          <div class='text-[14px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-normal text-left' x-text="log.activity ?? '-'" :title="log.activity ?? ''"></div>
        </div>

        {{!-- Activity Details --}}
        <div class='box-border w-[240px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          <div class='text-[14px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-normal text-left' x-text="log.activityDetails ?? '-'" :title="log.activityDetails ?? ''"></div>
        </div>

        {{!-- Obstacle --}}
        <div class='box-border w-[200px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          <div class='text-[14px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-normal text-left' x-text="log.obstacles ?? '-'" :title="log.obstacles ?? ''"></div>
        </div>

        {{!-- Documentation image 90x52 --}}
        <div class='box-border w-[138px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          <div class='box-border w-[90px] shrink-0 h-[52px] flex flex-row gap-0 justify-center items-center bg-[#F9F5FF] [outline:1px_solid_#E9D7FE] [outline-offset:-0.5px] rounded-[12px] overflow-hidden cursor-pointer' @click='openModal(log.id)'>
            <template x-if='log.documentation'>
              <img :src='log.documentation' alt='Doc' class='h-full w-full object-cover' />
            </template>
            <template x-if='!log.documentation'>
              <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='#7F56D9' stroke-width='2'><rect width='18' height='18' x='3' y='3' rx='2'/><circle cx='9' cy='9' r='2'/><path d='m21 15-3-3-3 3'/></svg>
            </template>
          </div>
        </div>

        {{!-- Documentation Link --}}
        <div class='box-border w-[180px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          <template x-if='log.otherDocumentation'>
            <a :href='log.otherDocumentation' target='_blank' rel='noopener noreferrer'
              class='text-[14px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#3B82F6] font-inter font-normal text-left hover:underline' x-text='log.otherDocumentation' :title='log.otherDocumentation'></a>
          </template>
          <template x-if='!log.otherDocumentation'>
            <div class='text-[14px]/[normal] flex-1 text-[#525252] font-inter font-normal text-left'>-</div>
          </template>
        </div>

        {{!-- Program Name --}}
        <div class='box-border w-[280px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          <div class='text-[14px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#525252] font-inter font-normal text-left' x-text="log.session?.weeks?.course?.name ?? '-'" :title="log.session?.weeks?.course?.name ?? ''"></div>
        </div>

        {{!-- Status --}}
        <div class='box-border w-[140px] shrink-0 h-full flex flex-row gap-0 p-[16px_24px] justify-start items-center'>
          {{> components/ui/admin/logbook/logbook-status-badge statusVar='log.process'}}
        </div>

        {{!-- Confirm: Approve / Reject --}}
        <div class='box-border w-[140px] shrink-0 h-full flex flex-row gap-[10px] p-[16px_24px] justify-center items-center'>
          <form :action="`/logbooks/${log.id}/approved?_method=PATCH`" method='post' class='inline'>
            <button type='button' onclick="confirmAction(this, 'Are you sure approve this logbook?')"
              class='box-border w-[40px] h-[40px] flex justify-center items-center bg-[#BBF7D0] rounded-full shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#A7F3D0] transition-colors' title='Approve'>
              <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='#16A34A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6 9 17l-5-5'/></svg>
            </button>
          </form>
          <form :action="`/logbooks/${log.id}/rejected?_method=PATCH`" method='post' class='inline'>
            <button type='button' onclick="confirmAction(this, 'Are you sure reject this logbook?')"
              class='box-border w-[40px] h-[40px] flex justify-center items-center bg-[#FECACA] rounded-full shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-[#FCA5A5] transition-colors' title='Reject'>
              <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='#DC2626' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg>
            </button>
          </form>
        </div>

        {{!-- Action: Edit / Delete / View --}}
        <div class='box-border w-[227px] shrink-0 h-full flex flex-row gap-[4px] p-[16px] justify-center items-center'>
          <a :href="`/logbooks/formEdit/${log.id}`"
            class='box-border w-[40px] h-[40px] flex justify-center items-center bg-[#FFFFFF] rounded-[8px] hover:bg-[#F5F5F5] transition-colors' title='Edit' aria-label='Edit'>
            <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='#525252' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z'/><path d='m15 5 4 4'/></svg>
          </a>
          <form :action="`/logbooks/${log.session?.id}/${log.id}?_method=DELETE`" method='post' class='inline'>
            <button type='button' onclick='confirmDelete(this)'
              class='box-border w-[40px] h-[40px] flex justify-center items-center bg-[#FFFFFF] rounded-[8px] hover:bg-[#FEF2F2] transition-colors cursor-pointer' title='Delete' aria-label='Delete'>
              <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='#DC2626' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/></svg>
            </button>
          </form>
          {{> components/ui/admin/button/view-button click='openModal(log.id)'}}
        </div>

      </div>
    </template>
  </div>

  {{!-- Empty --}}
  <div x-show='!filteredData || filteredData.length === 0' class='w-full h-[72px] flex items-center justify-center'>
    <span class='font-inter text-sm text-[#A3A3A3]'>No logbook found.</span>
  </div>

  {{!-- Pagination --}}
  <div class='w-full flex justify-center gap-2 items-center py-4' x-show='pageCount() > 1'>
    <button @click='prevPage' :disabled='pageNumber==0' class='px-3 py-1 rounded border border-gray-900 text-gray-900' :class="{ 'opacity-50 cursor-not-allowed': pageNumber==0 }">Prev</button>
    <template x-for='(page,index) in pages()' :key='index'>
      <button @click='viewPage(index)' class='px-3 py-1 rounded' :class="{ 'bg-gray-900 text-white font-bold': index===pageNumber }" x-text='index+1'></button>
    </template>
    <button @click='nextPage' :disabled='pageNumber >= pageCount()-1' class='px-3 py-1 rounded border border-gray-900 text-gray-900' :class="{ 'opacity-50 cursor-not-allowed': pageNumber >= pageCount()-1 }">Next</button>
  </div>

</div>
