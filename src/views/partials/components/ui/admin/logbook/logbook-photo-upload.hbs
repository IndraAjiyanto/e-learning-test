{{!--
  Component: Logbook Photo Upload (Admin) — molecule, prefix logbook-
  Path: components/ui/admin/logbook/logbook-photo-upload.hbs
  Dipakai: {{> components/ui/admin/logbook/logbook-photo-upload}} di admin/logbooks/create.hbs & edit.hbs

  Props: {{inputId}} (default 'documentation'), {{inputName}} (default 'documentation'),
          {{required}} (optional bool — true di create, false di edit),
          {{currentFile}} (optional — URL foto lama di edit), {{showOldPhoto}} (optional bool)
  Alpine scope (parent form): previewUrl, hasFile, isValid, errorMessage, fileName, fileSize,
          validateFile(file), clearFile(), $refs.fileInput (atau $refs.documentationFile)
  Fitur baru: crop — file yang dipilih masuk modal crop dulu (free aspect) lalu
  hasil crop diteruskan ke validateFile. Preview memakai object-contain agar
  tidak terlalu zoom / terpotong.
  label Photo Documentation* 14 #404040; dropzone h200 fill #F8F9FA r8 stroke D9D9D9 p8 16 gap10
  ikon image 40 #718096; teks Montserrat 12/500 #718096; hint Montserrat 10/500 #ADB7C5 (JPEG,JPG,PNG Max 5 MB)
  Reuse: mentor-photo-upload mirip tapi hint & tinggi beda + logbook pakai field name documentation + validasi image 5MB
  Jadi komponen terpisah agar tidak mencampur konteks.
--}}
<div class='flex flex-col gap-[8px] w-full'>
  {{> components/ui/admin/form/form-label text="Photo Documentation*"}} 
  <input type='file' id='{{default inputId 'documentation'}}' name='{{default inputName 'documentation'}}' accept='.jpg,.jpeg,.png,image/jpeg,image/jpg,image/png'
    {{#if required}}required{{/if}} x-ref='fileInput' class='hidden'
    @change="$dispatch('crop-open-{{default inputId 'documentation'}}', { file: $event.target.files[0] })"
    @crop-done-{{default inputId 'documentation'}}.window='validateFile($event.detail.file)'
    @crop-cancel-{{default inputId 'documentation'}}.window='$refs.fileInput.value=null' />
  {{!-- Dropzone empty state: h 200 --}}
  <template x-if='!previewUrl{{#if showOldPhoto}} && !oldPhoto{{/if}}'>
    <label for='{{default inputId 'documentation'}}'
      class='box-border w-full h-[200px] flex flex-col justify-center items-center p-[8px_16px] gap-[10px] bg-[#F8F9FA] border border-[#D9D9D9] rounded-[8px] cursor-pointer transition-colors hover:bg-[#EFF3F6] overflow-hidden'>
      <div class='flex flex-col items-center gap-[10px]'>
        <svg xmlns='http://www.w3.org/2000/svg' width='40' height='40' viewBox='0 0 24 24' fill='none' stroke='#718096' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect width='18' height='18' x='3' y='3' rx='2' ry='2'/><circle cx='9' cy='9' r='2'/><path d='m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21'/></svg>
        <p class='text-[12px]/[16px] font-inter font-medium text-[#718096] text-center'>Drag &amp; Drop your Image here or click to browse</p>
        <p class='text-[10px]/[12px] font-inter font-medium text-[#ADB7C5] text-center'>JPEG, JPG, PNG · Max 5 MB · crop bebas anti-zoom</p>
      </div>
    </label>
  </template>
  {{!-- Preview besar memenuhi layar: tinggi 360-440, object-contain, klik untuk fullscreen --}}
  <template x-if='previewUrl'>
    <div class='relative w-full rounded-[8px] border border-[#D9D9D9] bg-white overflow-hidden group'>
      <img :src='previewUrl' alt='Preview' @click='showFull=true' class='w-full h-auto max-h-[520px] min-h-[320px] object-contain bg-white p-2 cursor-zoom-in transition-transform group-hover:scale-[1.01]' />
      <div class='absolute left-3 top-3 rounded-full bg-black/55 px-3 py-1 text-[11px] font-medium text-white backdrop-blur'>Preview hasil crop — klik untuk fullscreen</div>
      <button type='button' @click.prevent="document.getElementById('{{default inputId 'documentation'}}').click()" class='absolute right-3 bottom-3 inline-flex items-center gap-1 rounded-lg bg-white px-3 py-1.5 text-xs font-semibold text-[#003060] shadow border border-[#D9D9D9] hover:bg-[#f8fafc]'>Ganti</button>
    </div>
  </template>
  {{#if showOldPhoto}}
  <template x-if='!previewUrl && oldPhoto'>
    <div class='relative w-full rounded-[8px] border border-[#D9D9D9] bg-white overflow-hidden group'>
      <img :src='oldPhoto' alt='Current' @click='showFull=true' class='w-full h-auto max-h-[520px] min-h-[320px] object-contain bg-white p-2 cursor-zoom-in' />
      <div class='absolute left-3 top-3 rounded-full bg-amber-500 px-3 py-1 text-[11px] font-semibold text-white'>Foto saat ini — klik untuk lihat penuh</div>
      <label for='{{default inputId 'documentation'}}' class='absolute right-3 bottom-3 inline-flex cursor-pointer items-center gap-1 rounded-lg bg-[#003060] px-3 py-1.5 text-xs font-semibold text-white shadow hover:bg-[#00224a]'>Ganti Foto</label>
    </div>
  </template>
  {{/if}}
  {{#if showOldPhoto}}
  <template x-if='!previewUrl && oldPhoto'>
    <p class='text-[11px]/[normal] font-inter text-[#A3A3A3]'>Current photo — click to change (leave empty to keep)</p>
  </template>
  {{/if}}
  <template x-if='hasFile && isValid && previewUrl'>
    <div class='flex items-center gap-[6px] px-[10px] py-[6px] bg-[#F0FDF4] border border-[#BBF7D0] rounded-[6px]'>
      <svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='#16A34A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6 9 17l-5-5'/></svg>
      <span class='text-[12px]/[normal] font-inter text-[#16A34A]' x-text='fileName + " (" + (fileSize/1024).toFixed(1) + "KB)"'></span>
      <button type='button' @click='clearFile()' class='ml-auto text-[#DC2626] hover:text-[#B91C1C]'>
        <svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg>
      </button>
    </div>
  </template>
  <template x-if='!isValid && errorMessage'>
    <div class='flex items-start gap-[6px] px-[10px] py-[6px] bg-[#FEF2F2] border border-[#FECACA] rounded-[6px]'>
      <svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='#DC2626' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='mt-0.5 shrink-0'><circle cx='12' cy='12' r='10'/><line x1='12' x2='12' y1='8' y2='12'/><line x1='12' x2='12.01' y1='16' y2='16'/></svg>
      <span class='text-[12px]/[normal] font-inter text-[#DC2626]' x-text='errorMessage'></span>
    </div>
  </template>
  {{!-- Fullscreen preview --}}
  <div x-show='showFull' x-transition.opacity x-cloak
    @click.self='showFull=false' @keydown.escape.window='showFull=false'
    class='fixed inset-0 z-[70] flex items-center justify-center bg-black/85 p-4 sm:p-8'>
    <button @click='showFull=false' class='absolute right-4 top-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-[#0f172a] hover:bg-white'>
      <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg>
    </button>
    <img :src='previewUrl || oldPhoto' alt='Fullscreen' class='max-h-[88vh] max-w-[92vw] w-auto h-auto object-contain rounded-xl bg-white p-1 shadow-2xl' />
  </div>

  {{!-- Crop modal (free aspect) --}}
  {{> components/ui/admin/logbook/logbook-crop-modal inputId=(default inputId 'documentation') size=1200 }}
</div>
