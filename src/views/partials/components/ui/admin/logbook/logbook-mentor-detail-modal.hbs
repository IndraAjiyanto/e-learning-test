{{!--
  Component: Logbook Mentor Detail Modal / Container - User Property (Admin) — organism, prefix logbook-mentor-
  Path: components/ui/admin/logbook/logbook-mentor-detail-modal.hbs
  Dipakai: {{> components/ui/admin/logbook/logbook-mentor-detail-modal}} di dalam
           sub_partials/session/logbook_mentor_tab/modal_information.hbs (scope logBookMentorData():
           showModal, selectedLogbook, closeModal()).
  Composes: logbook/logbook-detail-header (title='Mentor Logbook Details', subtitleVar=course name),
            logbook/logbook-status-badge (conditional jika ada selectedLogbook.process),
            logbook/logbook-detail-card (Activity, Key Activities, Obstacle, Program Name, Doc Link),
            logbook/logbook-detail-field (Mentor Info + Date & Time),
            logbook/logbook-detail-photo (Photo Documentation).
  Pencil Design (Container - User Property ZP8Hp 980x820 r20 clip vertical):
  header navy h98 + body white stroke #D9D9D9 p14 28 gap10 vertical:
  Main Content gap14 horizontal: List Container w560 vertical gap12 (Activity, Key Activities, Obstacle, Program Name)
  + Sidebar Content w348 vertical gap12 (Mentor Info, Date & Time, Photo).
  BE: GET /session/logbooks-mentor/:sessionId → MentorLogbook[] { id, activity, activityDetail,
  obstacle, documentation, createdAt, user { id, username, email, biodata },
  session { weeks { course { name } } } }.
--}}
<div x-show='showModal'
  x-transition:enter='transition ease-out duration-300' x-transition:enter-start='opacity-0' x-transition:enter-end='opacity-100'
  x-transition:leave='transition ease-in duration-200' x-transition:leave-start='opacity-100' x-transition:leave-end='opacity-0'
  class='fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 p-4'
  @click.self='closeModal()'
  @keydown.escape.window='closeModal()'>
  <div class='box-border w-full max-w-[980px] max-h-[90vh] overflow-y-auto shrink-0 flex flex-col gap-0 justify-start items-stretch rounded-[20px]'
    style='scrollbar-width: none; -ms-overflow-style: none;'>

    {{> components/ui/admin/logbook/logbook-detail-header title='Mentor Logbook Details' subtitle='Detailed progress overview' subtitleVar='selectedLogbook?.session?.weeks?.course?.name'}}

    <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[10px] p-[14px_28px] justify-start items-stretch bg-[#FFFFFF] border border-[#D9D9D9] border-t-0 rounded-b-[20px]'>

      {{!-- Status row (ditampilkan jika ada field process pada selectedLogbook) --}}
      <template x-if='selectedLogbook?.process'>
        <div class='w-full h-[22px] shrink-0 flex flex-row gap-[8px] justify-between items-center'>
          <div class='text-[14px]/[normal] text-[#171717] font-montserrat font-semibold text-left'>Status</div>
          {{> components/ui/admin/logbook/logbook-status-badge statusVar='selectedLogbook.process'}}
        </div>
      </template>

      {{!-- Main Content: list + sidebar --}}
      <div class='w-full h-fit shrink-0 flex flex-col lg:flex-row gap-[14px] justify-start items-start'>

        {{!-- Kiri: Activity / Key Activities / Obstacle / Program Name / (Documentation Link if exists) --}}
        <div class='w-full lg:w-[560px] lg:shrink-0 flex flex-col gap-[12px] justify-start items-stretch'>
          {{> components/ui/admin/logbook/logbook-detail-card icon='zap' title='Activity' contentVar='selectedLogbook?.activity'}}
          {{> components/ui/admin/logbook/logbook-detail-card icon='list-checks' title='Key Activities' contentVar='selectedLogbook?.activityDetail || selectedLogbook?.activityDetails'}}
          {{> components/ui/admin/logbook/logbook-detail-card icon='triangle-alert' title='Obstacle' contentVar='selectedLogbook?.obstacle || selectedLogbook?.obstacles'}}
          {{> components/ui/admin/logbook/logbook-detail-card icon='book-open' title='Program Name' contentVar='selectedLogbook?.session?.weeks?.course?.name'}}
          <template x-if='selectedLogbook?.otherDocumentation'>
            {{> components/ui/admin/logbook/logbook-detail-card icon='link' title='Documentation Link' contentVar='selectedLogbook?.otherDocumentation' isLink=true}}
          </template>
        </div>

        {{!-- Kanan: Mentor Information (+LinkedIn) / Date & Time / Photo --}}
        <div class='w-full lg:w-[348px] lg:shrink-0 flex flex-col gap-[12px] justify-start items-stretch'>

          {{!-- Mentor Information Card --}}
          <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[10px] p-[20px_14px] justify-start items-stretch bg-[#F0F9FF] [outline:1px_solid_#BAE6FD] [outline-offset:-0.5px] rounded-[10px]'>
            <div class='w-full h-[24px] shrink-0 flex flex-row gap-[4px] justify-start items-center'>
              <svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#000000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='shrink-0'><path d='M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/></svg>
              <div class='text-[16px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#171717] font-montserrat font-semibold text-left'>Mentor Information</div>
            </div>
            <div class='w-full flex flex-col gap-[8px] justify-start items-stretch'>
              {{> components/ui/admin/logbook/logbook-detail-field label='Full Name:' valueVar='selectedLogbook?.user?.username'}}
              {{> components/ui/admin/logbook/logbook-detail-field label='Email:' valueVar='selectedLogbook?.user?.email'}}
              {{> components/ui/admin/logbook/logbook-detail-field label='LinkedIn:' valueVar='selectedLogbook?.user?.linkedin || selectedLogbook?.user?.biodata?.linkedin' isLink=true}}
            </div>
          </div>

          {{!-- Date & Time Card --}}
          <div class='box-border w-full h-fit shrink-0 flex flex-col gap-[10px] p-[20px_14px] justify-start items-stretch bg-[#F0F9FF] [outline:1px_solid_#BAE6FD] [outline-offset:-0.5px] rounded-[10px]'>
            <div class='w-full h-[24px] shrink-0 flex flex-row gap-[4px] justify-start items-center'>
              <svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#000000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='shrink-0'><path d='M8 2v4'/><path d='M16 2v4'/><rect width='18' height='18' x='3' y='4' rx='2'/><path d='M3 10h18'/></svg>
              <div class='text-[16px]/[normal] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap text-[#171717] font-montserrat font-semibold text-left'>Date &amp; Time</div>
            </div>
            <div class='w-full flex flex-col gap-[8px] justify-start items-stretch'>
              {{> components/ui/admin/logbook/logbook-detail-field label='Created:' valueVar="selectedLogbook?.createdAt ? new Date(selectedLogbook.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : null"}}
              {{> components/ui/admin/logbook/logbook-detail-field label='Time:' valueVar="selectedLogbook?.createdAt ? new Date(selectedLogbook.createdAt).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : null"}}
            </div>
          </div>

          {{!-- Photo Documentation Card --}}
          {{> components/ui/admin/logbook/logbook-detail-photo srcVar='selectedLogbook?.documentation'}}

        </div>
      </div>

    </div>
  </div>
</div>
