{{!--
  Komponen: Logbook Crop Modal (Admin & User) — molecule
  Lokasi: components/ui/admin/logbook/logbook-crop-modal.hbs
  Dipakai: di form logbook (admin/logbooks/create.hbs, edit.hbs, user/logbooks/createLog.hbs, edit.hbs)
           via {{> components/ui/admin/logbook/logbook-crop-modal inputId='documentation'}}

  Alur sama seperti super_admin/form/crop_modal tetapi aspect = free (NaN)
  supaya user bisa crop bebas tanpa ter-kunci rasio. Ini mencegah hasil
  preview yang terlalu zoom karena area crop bisa disesuaikan sebelum upload.

  Props:
  - inputId : string (wajib) — id <input type=file> yang diisi hasil crop
  - size    : number lebar piksel maksimum hasil crop (default 1200)
--}}
<div
  x-data="logbookCropper({
    inputId: {{json inputId}},
    outputWidth: {{default size 1200}}
  })"
  @crop-open-{{inputId}}.window='open($event.detail.file)'
  x-show='showModal'
  x-cloak
  @keydown.escape.window='cancel()'
  class='fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-[1px] p-3 sm:p-4'
  @click.self='cancel()'
  role='dialog'
  aria-modal='true'
  aria-label='Crop documentation photo'
>
  <div class='flex max-h-[92vh] w-full max-w-[960px] flex-col overflow-hidden rounded-2xl bg-white shadow-2xl'>
    <div class='shrink-0 border-b border-[#e5e7eb] px-6 py-5 sm:px-7'>
      <h3 class='font-inter text-[17px] font-semibold leading-6 text-[#003060]'>Atur Foto Dokumentasi</h3>
      <p class='mt-1 font-montserrat text-xs leading-5 text-[#718096]'>
        Geser, zoom, dan tarik sudut area crop. Rasio bebas — preview nanti <span class='font-semibold text-[#003060]'>object-contain</span> jadi tidak terpotong / terlalu zoom.
      </p>
    </div>

    <div class='flex min-h-0 flex-1 flex-col gap-4 bg-[#f8fafc] p-4 sm:p-6'>
      {{!-- Area crop diperbesar: 60vh + toolbar agar leluasa saat merapikan --}}
      <div class='relative flex h-[58vh] min-h-[380px] max-h-[620px] w-full items-center justify-center overflow-hidden rounded-xl bg-[#0f172a] shadow-inner'>
        <img x-ref='cropTarget' alt='' class='block max-h-full max-w-full' style='display:block; max-width:100%;' />
        <div x-show='!ready' class='absolute inset-0 flex items-center justify-center bg-[#0f172a]/60'>
          <span class='inline-flex items-center gap-2 rounded-full bg-white/90 px-4 py-2 text-xs font-medium text-[#003060] shadow'>
            <svg class='h-4 w-4 animate-spin' viewBox='0 0 24 24' fill='none'><circle cx='12' cy='12' r='10' stroke='#cbd5e1' stroke-width='3'/><path d='M22 12a10 10 0 0 0-10-10' stroke='#003060' stroke-width='3' stroke-linecap='round'/></svg>
            Memuat cropper...
          </span>
        </div>
      </div>

      {{!-- Toolbar zoom / reset --}}
      <div class='flex flex-wrap items-center justify-between gap-3'>
        <div class='flex items-center gap-2'>
          <button type='button' @click='zoom(-0.15)' :disabled='!ready' class='inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[#d9d9d9] bg-white text-[#334155] hover:bg-[#f1f5f9] disabled:opacity-40'>
            <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='11' cy='11' r='8'/><path d='M21 21l-4.3-4.3'/><path d='M8 11h6'/></svg>
          </button>
          <button type='button' @click='zoom(0.15)' :disabled='!ready' class='inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[#d9d9d9] bg-white text-[#334155] hover:bg-[#f1f5f9] disabled:opacity-40'>
            <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='11' cy='11' r='8'/><path d='M21 21l-4.3-4.3'/><path d='M8 11h6'/><path d='M11 8v6'/></svg>
          </button>
          <button type='button' @click='reset()' :disabled='!ready' class='inline-flex h-9 items-center justify-center gap-1 rounded-lg border border-[#d9d9d9] bg-white px-3 text-xs font-semibold text-[#334155] hover:bg-[#f1f5f9] disabled:opacity-40'>
            Reset
          </button>
          <span class='hidden sm:inline text-[11px] font-montserrat text-[#94a3b8] ml-1'>Scroll / pinch untuk zoom • drag untuk geser</span>
        </div>
        <p class='text-[11px] font-montserrat text-[#64748b]'>Tarik sudut putih untuk ubah rasio — bebas, tidak dikunci 1:1.</p>
      </div>
    </div>

    <div class='flex shrink-0 items-center justify-end gap-3 border-t border-[#e5e7eb] bg-white px-6 py-4 sm:px-7'>
      <button
        type='button'
        @click='cancel()'
        class='inline-flex h-[42px] items-center justify-center rounded-xl border border-[#d9d9d9] bg-white px-6 font-montserrat text-xs font-semibold leading-4 text-[#475569] transition-colors hover:border-[#94a3b8] hover:bg-[#f8fafc] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/20'
      >Batal</button>
      <button
        type='button'
        @click='apply()'
        :disabled='!ready'
        class='inline-flex h-[42px] items-center justify-center rounded-xl bg-[#003060] px-7 font-montserrat text-xs font-semibold leading-4 text-white shadow-sm transition-colors hover:bg-[#00224a] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/30 disabled:cursor-not-allowed disabled:opacity-50'
      >Pakai Hasil Crop</button>
    </div>
  </div>
</div>

<script>
  function logbookCropper(config) {
    return {
      showModal: false,
      ready: false,
      cropper: null,
      objectUrl: null,
      sourceFile: null,
      appliedFile: null,

      get input() {
        return document.getElementById(config.inputId);
      },

      open(file) {
        if (!file) return;
        // filter non-image early
        if (!file.type || !file.type.startsWith('image/')) return;
        this.sourceFile = file;
        this.revokeObjectUrl();
        this.objectUrl = URL.createObjectURL(file);
        this.showModal = true;

        this.$nextTick(() => {
          const target = this.$refs.cropTarget;
          if (this.cropper) this.cropper.destroy();
          this.ready = false;
          target.onload = () => {
            this.cropper = new Cropper(target, {
              aspectRatio: NaN,
              viewMode: 1,
              autoCropArea: 0.92,
              background: false,
              movable: true,
              zoomable: true,
              rotatable: false,
              scalable: false,
              responsive: true,
              checkOrientation: false,
              zoomOnWheel: true,
              ready: () => (this.ready = true),
            });
          };
          target.src = this.objectUrl;
        });
      },

      apply() {
        if (!this.cropper || !this.ready) return;
        const area = this.cropper.getData(true);
        // Jangan memperbesar: ikuti ukuran area asli, batasi ke outputWidth
        const scale = Math.min(1, config.outputWidth / area.width);
        const width = Math.round(area.width * scale);
        const height = Math.round(area.height * scale);
        const canvas = this.cropper.getCroppedCanvas({
          width: width,
          height: height,
          imageSmoothingEnabled: true,
          imageSmoothingQuality: 'high',
        });
        if (!canvas) return;
        const type = this.sourceFile.type === 'image/png' ? 'image/png' : 'image/jpeg';
        canvas.toBlob(
          (blob) => {
            if (!blob) return;
            const file = new File([blob], this.sourceFile.name, { type: type });
            this.setInputFile(file);
            this.appliedFile = file;
            this.$dispatch('crop-done-' + config.inputId, { file: file });
            this.close();
          },
          type,
          0.92,
        );
      },

      zoom(delta) {
        if (!this.cropper || !this.ready) return;
        this.cropper.zoom(delta);
      },

      reset() {
        if (!this.cropper || !this.ready) return;
        this.cropper.reset();
      },

      cancel() {
        this.setInputFile(this.appliedFile);
        // if cancel and there was no previous appliedFile, clear input to avoid ghost
        if (!this.appliedFile && this.input) {
          // let caller keep previous validation state; input already empty
        }
        this.close();
        // beri tahu caller bahwa cancel terjadi agar bisa reset preview jika perlu
        if (!this.appliedFile) {
          this.$dispatch('crop-cancel-' + config.inputId);
        }
      },

      setInputFile(file) {
        const transfer = new DataTransfer();
        if (file) transfer.items.add(file);
        if (this.input) this.input.files = transfer.files;
      },

      close() {
        if (this.cropper) {
          this.cropper.destroy();
          this.cropper = null;
        }
        this.revokeObjectUrl();
        this.ready = false;
        this.showModal = false;
      },

      revokeObjectUrl() {
        if (this.objectUrl) URL.revokeObjectURL(this.objectUrl);
        this.objectUrl = null;
      },
    };
  }
</script>
