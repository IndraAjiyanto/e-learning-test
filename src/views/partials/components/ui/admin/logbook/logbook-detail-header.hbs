{{!--
  Component: Logbook Detail Header (Admin) — molecule, prefix logbook-
  Path: components/ui/admin/logbook/logbook-detail-header.hbs
  Dipakai: {{> components/ui/admin/logbook/logbook-detail-header}} di dalam
           components/ui/admin/logbook/logbook-detail-modal.hbs
  Props: {{title}} (default 'User Logbook Details'),
         {{subtitle}} (default 'Detailed progress overview'),
         {{subtitleVar}} (optional Alpine expression for dynamic subtitle)
  Pencil (Container - User Property ZP8Hp → Feature Card 1: Partnership Header):
  h98 fill #003060 gap20 p20 28, title Montserrat 28/700 #FFF ls-1,
  subtitle Montserrat 16/500 #F3F3F3, close 28 circle white X lucide 16 #FFF.
  Alpine parent: closeModal().
--}}
<div class='box-border w-full h-[98px] shrink-0 flex flex-row gap-[20px] p-[20px_28px] justify-start items-center bg-[#003060] rounded-t-[20px]'>
  <div class='flex-1 min-w-0 flex flex-col gap-[4px] justify-center items-start'>
    <div class='text-[28px]/[1.21] w-full overflow-hidden text-ellipsis whitespace-nowrap text-[#FFFFFF] font-montserrat font-bold tracking-[-1px] text-left'>{{default title 'User Logbook Details'}}</div>
    <div class='text-[16px]/[1.25] w-full overflow-hidden text-ellipsis whitespace-nowrap text-[#F3F3F3] font-montserrat font-medium text-left'{{#if subtitleVar}} x-text="{{subtitleVar}} || '{{default subtitle 'Detailed progress overview'}}'"{{/if}}>{{default subtitle 'Detailed progress overview'}}</div>
  </div>
  <button type='button' @click='closeModal()' aria-label='Close'
    class='box-border w-[28px] shrink-0 h-[28px] flex justify-center items-center rounded-full hover:bg-white/10 transition-colors'>
    <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#FFFFFF' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg>
  </button>
</div>
