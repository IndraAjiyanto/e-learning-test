{{!--
  Component: Mentor Tech Badge (Admin) — atomic, prefix mentor-tech-
  Path: components/ui/admin/badge/mentor-tech-badge.hbs
  Dipakai: {{> components/ui/admin/badge/mentor-tech-badge}} di dalam x-for `tech` slice 0..2
  Props Alpine (parent): `tech.name`, `tIndex` (index 0..2 untuk warna)
  Slicing H6vxaE Col Tags: Figma #0284C7 bg #E0F2FE, Miro #6941C6 bg #F4EBFF,
    Slack #EA580C bg #FFEDD5, +N #404040 bg #F5F5F5, radius 16, p4 12
  Reusable: dipakai di mentor-table, bisa dipakai di detail page mentor lain.
--}}
<template x-for='(tech, tIndex) in (mentor.technologies ?? []).slice(0, 3)' :key='tech.id ?? tech.name'>
  <span class='box-border inline-flex shrink-0 h-fit flex-row gap-0 p-[4px_12px] justify-center items-center rounded-[16px] text-[14px]/[normal] font-inter font-medium whitespace-nowrap'
    :style="'background:' + mentorTechBg(tIndex) + ';color:' + mentorTechColor(tIndex)"
    x-text='tech.name' :title='tech.name'></span>
</template>
<template x-if='(mentor.technologies ?? []).length > 3'>
  <span class='box-border inline-flex shrink-0 h-fit flex-row gap-0 p-[4px_12px] justify-center items-center bg-[#F5F5F5] rounded-[16px] text-[14px]/[normal] text-[#404040] font-inter font-medium whitespace-nowrap'
    x-text="'+' + ((mentor.technologies ?? []).length - 3)"></span>
</template>
