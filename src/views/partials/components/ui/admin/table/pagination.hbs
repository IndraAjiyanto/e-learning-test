{{!--
  Component: Pagination (Admin) — atomic
  Path: components/ui/admin/table/pagination.hbs
  Alpine: currentPage, totalPages, changePage() dari parent scope

  "Page X of Y" ujung kiri | Previous + Next ujung kanan
  Parent: justify-between → text kiri, buttons kanan
  Actions: ml-auto → Previous/Next geser ujung kanan

  Pencil: p12 24 16 24, Inter 14,
  details #404040 medium, buttons p8 14 white outline #D4D4D4 radius 8 semibold
--}}
<div class='box-border w-full h-fit shrink-0 flex flex-row gap-[12px] p-[12px_24px_16px_24px] justify-between items-center bg-[#FFFFFF]'>
  <div class='text-[14px]/[normal] text-[#404040] font-inter font-medium whitespace-nowrap'>
    Page <span x-text='currentPage'></span> of <span x-text='totalPages'></span>
  </div>
  <div class='flex flex-row gap-[12px] items-center'>
    <button
      type='button'
      @click='changePage(currentPage - 1)'
      :disabled='currentPage <= 1'
      class='box-border w-fit shrink-0 h-fit flex flex-row gap-0 p-[8px_14px] justify-center items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px] text-[14px]/[normal] text-[#404040] font-inter font-semibold whitespace-nowrap hover:bg-[#fafafa] disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-white transition-colors'
    >
      Previous
    </button>
    <button
      type='button'
      @click='changePage(currentPage + 1)'
      :disabled='currentPage >= totalPages'
      class='box-border w-fit shrink-0 h-fit flex flex-row gap-0 p-[8px_14px] justify-center items-center bg-[#FFFFFF] [outline:1px_solid_#D4D4D4] [outline-offset:-0.5px] rounded-[8px] text-[14px]/[normal] text-[#404040] font-inter font-semibold whitespace-nowrap hover:bg-[#fafafa] disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-white transition-colors'
    >
      Next
    </button>
  </div>
</div>
