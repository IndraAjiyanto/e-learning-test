{{!--
  Component: Detail Learning Details (Admin)
  Path: components/ui/admin/detail/learning/index.hbs
  Props: {{course}} (mentorings, learningTargetsId, technologies)

  Pencil: Card Learning Details (J3SEIu): header book-open 36x36 #003060, Account Mentor, Target, Tools badges #F5F5F5/Inter 12 #404040
--}}
<div class='box-border w-full h-fit shrink-0 flex flex-col gap-[24px] p-[20px] justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px]'>

  <div class='w-full flex flex-row gap-[8px] justify-start items-center'>
    <div class='box-border w-[36px] h-[36px] shrink-0 flex flex-row gap-0 justify-center items-center bg-[#003060] rounded-full'>
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[20px] h-[20px]'><path d='M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20'/></svg>
    </div>
    <span class='text-[16px]/[normal] text-[#003060] font-montserrat font-semibold'>Learning Details</span>
  </div>

  <div class='w-full flex flex-col gap-[20px]'>
    <div class='w-full flex flex-col gap-[8px]'>
      <span class='text-[14px]/[normal] text-[#171717] font-montserrat font-semibold'>Account Mentor</span>
      <span class='text-[14px]/[normal] text-[#737373] font-montserrat font-medium'>{{#if course.mentorings}}{{#each course.mentorings}}{{this.user.username}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}Mentor{{/if}}</span>
    </div>
    <div class='w-full flex flex-col gap-[8px]'>
      <span class='text-[14px]/[normal] text-[#171717] font-montserrat font-semibold'>Target</span>
      <span class='text-[14px]/[normal] text-[#737373] font-montserrat font-medium break-words'>{{#if course.learningTargetsId}}{{#each course.learningTargetsId}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}Memahami dasar dasar uiux design{{/if}}</span>
    </div>
    <div class='w-full flex flex-col gap-[8px]'>
      <span class='text-[14px]/[normal] text-[#171717] font-montserrat font-semibold'>Tools</span>
      <div class='flex flex-row gap-[4px] justify-start items-center flex-wrap'>
        {{#if course.technologies}}
          {{#each course.technologies}}
          <div class='box-border h-fit flex flex-row gap-[6px] p-[2px_8px] justify-center items-center bg-[#F5F5F5] rounded-[16px]'>
            {{#if this.svg}}
            <span class='w-[14px] h-[14px] flex items-center justify-center shrink-0 overflow-hidden [&>svg]:w-full [&>svg]:h-full'>{{{this.svg}}}</span>
            {{else}}
              {{#if this.imgUrl}}
              <span class='w-[14px] h-[14px] flex items-center justify-center shrink-0 overflow-hidden'><img src="{{this.imgUrl}}" alt="{{this.name}}" class="w-full h-full object-contain" /></span>
              {{/if}}
            {{/if}}
            <span class='text-[12px]/[normal] text-[#404040] font-inter font-medium whitespace-nowrap'>{{this.name}}</span>
          </div>
          {{/each}}
        {{else}}
          <div class='box-border h-fit flex flex-row gap-0 p-[2px_8px] justify-center items-center bg-[#F5F5F5] rounded-[16px]'><span class='text-[12px]/[normal] text-[#404040] font-inter font-medium'>Figma</span></div>
          <div class='box-border h-fit flex flex-row gap-0 p-[2px_8px] justify-center items-center bg-[#F5F5F5] rounded-[16px]'><span class='text-[12px]/[normal] text-[#404040] font-inter font-medium'>Miro</span></div>
          <div class='box-border h-fit flex flex-row gap-0 p-[2px_8px] justify-center items-center bg-[#F5F5F5] rounded-[16px]'><span class='text-[12px]/[normal] text-[#404040] font-inter font-medium'>Notion</span></div>
          <div class='box-border h-fit flex flex-row gap-0 p-[2px_8px] justify-center items-center bg-[#F5F5F5] rounded-[16px]'><span class='text-[12px]/[normal] text-[#404040] font-inter font-medium'>Zoom</span></div>
        {{/if}}
      </div>
    </div>
  </div>

</div>
