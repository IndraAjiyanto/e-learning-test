{{!--
  Component: Detail Hero (Admin) — Card Hero Cover
  Path: components/ui/admin/detail/hero/index.hbs
  Props: {{course}} (Course entity + relations)

  Back to program (chevron-left #718096 + Montserrat 16 medium)
  Cover 500x264 #F8F9FA, image fill, Title 34 #003060 bold, Subtitle 14 #718096, 3 badges, Delete #FEF2F2 + Edit #003060
  Sumber kebenaran: course.* (name, description, image, category.name, courseType.nameClassesType, launch, checkPaid/form)
--}}
<div class='box-border w-full h-fit shrink-0 flex flex-col gap-[14px] p-[20px] justify-start items-start bg-[#FFFFFF] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[12px]'>

  {{!-- Back to program --}}
  <div class='flex flex-row gap-[24px] justify-between items-center w-full' x-data="{
       prev: '/program',
       init() { this.prev = localStorage.getItem('kelasPrevUrl') || '/program'; },
       goBack() {
         const prevUrl = localStorage.getItem('kelasPrevUrl');
         if (prevUrl) { localStorage.removeItem('kelasPrevUrl'); window.location.href = prevUrl; }
         else window.location.href = '/program';
       }
     }" x-init="init()">
    <a x-bind:href="prev" @click.prevent="goBack()" class='flex flex-row gap-[4px] justify-start items-center cursor-pointer hover:opacity-70 transition-opacity'>
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#718096' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[16px] h-[16px]'><path d='m15 18-6-6 6-6'/></svg>
      <span class='text-[16px]/[normal] text-[#718096] font-inter font-medium'>Back to program</span>
    </a>
  </div>

  {{!-- Hero: Cover + Info --}}
  <div class='w-full flex flex-col lg:flex-row gap-[20px] justify-start items-start'>

    {{!-- Cover 500x264 --}}
    <div class='box-border w-[500px] shrink-0 h-[264px] flex flex-row gap-0 justify-center items-center bg-[#F8F9FA] [outline:1px_solid_#D9D9D9] [outline-offset:-0.5px] rounded-[8px] overflow-hidden'>
      {{#if course.image}}
      <img src='{{course.image}}' alt='Cover {{course.name}}' class='w-full h-full object-cover' />
      {{else}}
      <div class='flex flex-col items-center gap-2'>
        <i class='fas fa-image text-[#718096] text-[32px]'></i>
        <span class='text-[12px] text-[#A3A3A3] font-inter'>No cover</span>
      </div>
      {{/if}}
    </div>

    {{!-- Info (title + badges + actions) --}}
    <div class='flex-1 min-w-0 flex flex-col gap-[12px] justify-between self-stretch'>

      <div class='flex flex-col gap-[16px] w-full'>
        <div class='flex flex-col gap-[4px] w-full'>
          <div class='text-[34px]/[1.12] text-[#003060] font-inter font-bold tracking-[-0.85px]'>{{course.name}}</div>
          <div class='text-[14px]/[normal] text-[#718096] font-inter font-medium'>{{#if course.description}}{{default (getByLang course.description 'en') course.description.id}}{{else}}Learn and build real projects with our design team.{{/if}}</div>
        </div>
        <div class='flex flex-row gap-[8px] justify-start items-center flex-wrap'>
          {{!-- Badge Category --}}
          <div class='box-border h-fit flex flex-row gap-0 p-[2px_8px] justify-center items-center bg-[#F5F5F5] rounded-[16px]'>
            <span class='text-[12px]/[normal] text-[#404040] font-inter font-medium whitespace-nowrap'>{{#if course.category}}{{course.category.name}}{{else}}-{{/if}} · {{#if course.courseType}}{{course.courseType.nameClassesType}}{{else}}-{{/if}}</span>
          </div>
          {{!-- Badge Status Lifecycle --}}
          {{#if (eq course.status 'done')}}
            <div class='box-border h-fit flex flex-row gap-[6px] p-[2px_8px] justify-center items-center bg-[#F3E8FF] rounded-[16px]'>
              <div class='w-[6px] h-[6px] rounded-full bg-[#A855F7]'></div>
              <span class='text-[12px]/[normal] text-[#7E22CE] font-inter font-medium whitespace-nowrap'>Done</span>
            </div>
          {{else if (eq course.status 'learning')}}
            <div class='box-border h-fit flex flex-row gap-[6px] p-[2px_8px] justify-center items-center bg-[#DBEAFE] rounded-[16px]'>
              <div class='w-[6px] h-[6px] rounded-full bg-[#3B82F6]'></div>
              <span class='text-[12px]/[normal] text-[#1D4ED8] font-inter font-medium whitespace-nowrap'>Learning</span>
            </div>
          {{else if (eq course.status 'launch')}}
            <div class='box-border h-fit flex flex-row gap-[6px] p-[2px_8px] justify-center items-center bg-[#DCFCE7] rounded-[16px]'>
              <div class='w-[6px] h-[6px] rounded-full bg-[#22C55E]'></div>
              <span class='text-[12px]/[normal] text-[#15803D] font-inter font-medium whitespace-nowrap'>Launch</span>
            </div>
          {{else}}
            <div class='box-border h-fit flex flex-row gap-[6px] p-[2px_8px] justify-center items-center bg-[#F1F5F9] rounded-[16px]'>
              <div class='w-[6px] h-[6px] rounded-full bg-[#94A3B8]'></div>
              <span class='text-[12px]/[normal] text-[#475569] font-inter font-medium whitespace-nowrap'>Unlaunch</span>
            </div>
          {{/if}}
          {{!-- Badge Launch --}}
          {{#if (or isSyllabus (eq caps.structure 'syllabus') (eq course.programType 'non_bootcamp'))}}
            {{#if course.launch}}
              <div class='box-border h-fit flex flex-row gap-[6px] p-[2px_8px_2px_6px] justify-center items-center bg-[#FFFFFF] [outline:1px_solid_#F5F5F5] [outline-offset:-0.5px] rounded-[16px]'>
                <div class='w-[8px] h-[8px] rounded-full bg-[#16A34A]'></div>
                <span class='text-[12px]/[normal] text-[#171717] font-inter font-medium whitespace-nowrap'>Launched</span>
              </div>
            {{/if}}
          {{/if}}
        </div>
      </div>

      {{!-- Delete + Edit (hanya tampil jika program belum memiliki peserta)
           [NONAKTIF SEMENTARA] Guard disembunyikan sementara agar tombol selalu
           tampil untuk keperluan bersih-bersih data. Kembalikan komentar di bawah
           untuk mengaktifkan lagi konsep semula. --}}
      {{!-- [NONAKTIF SEMENTARA] {{#unless course.userCourses.length}} --}}
      <div class='flex flex-row gap-[12px] justify-start items-center'>
        {{!-- Aksi hapus entitas di halaman detail digating `showDelete` dan mati secara
     default — hapus dilakukan dari halaman list/edit. Kirim showDelete=true
     dari controller bila suatu saat perlu ditampilkan lagi. Tombol hapus
     pada tabel/daftar di halaman ini sengaja TIDAK ikut digating. --}}
        {{#if showDelete}}
          <form action='/program/{{course.id}}?_method=DELETE' method='post' class='inline'>
            <input type='hidden' name='previous' :value="localStorage.getItem('kelasPrevUrl') || '/program'">
            <button type='button' onclick="if (typeof openDeleteModal === 'function') { openDeleteModal(this, 'Delete Program', 'Are you sure you want to delete this program? This action cannot be undone.'); } else if (typeof confirmDelete === 'function') { confirmDelete(this, '{{course.name}}'); } else { this.closest('form').submit(); }" class='box-border w-[87px] h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#FEF2F2] [outline:1px_solid_#FCA5A5] [outline-offset:-0.5px] rounded-[8px] hover:bg-[#FEE2E2] transition-colors'>
              <span class='text-[16px]/[normal] text-[#EF4444] font-inter font-semibold whitespace-nowrap'>Delete</span>
            </button>
          </form>
        {{/if}}
        <a href='/program/edit/{{course.id}}{{#if categoryId}}/{{categoryId}}{{/if}}'
          class='box-border w-[136px] h-[44px] flex flex-row gap-[8px] p-[10px_18px] justify-center items-center bg-[#003060] [outline:1px_solid_#003060] [outline-offset:-0.5px] rounded-[8px] hover:bg-[#002040] transition-colors'>
          <span class='text-[16px]/[normal] text-[#FFFFFF] font-inter font-semibold whitespace-nowrap'>Edit Program</span>
        </a>
      </div>
      {{!-- [NONAKTIF SEMENTARA] {{/unless}} --}}

    </div>
  </div>

</div>
