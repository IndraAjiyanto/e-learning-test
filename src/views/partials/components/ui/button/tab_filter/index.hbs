{{!-- 
  Komponen: Tab Filter Button (Responsive)
  Lokasi: src/views/partials/components/ui/button/tab_filter/index.hbs

  Props:
  - text          : string (wajib) — label tombol
  - targetValue   : string (wajib) — nilai yang di-set ke variabel Alpine saat diklik
  - activeVar     : string (opsional, default 'activeTab') — nama state Alpine
  - activeClass   : string (opsional) — kelas saat tab aktif
  - inactiveClass : string (opsional) — kelas saat tab tidak aktif
  - buttonClass   : string (opsional) — override kelas dasar (ukuran, radius, font)
--}}

<button
  @click="{{#if activeVar}}{{activeVar}}{{else}}activeTab{{/if}} = '{{targetValue}}'"
  :class="{{#if activeVar}}{{activeVar}}{{else}}activeTab{{/if}} === '{{targetValue}}' ? '{{default activeClass 'bg-[#6EB6E5] text-white'}}' : '{{default inactiveClass 'bg-[#003060] text-white'}}'"
  class="font-montserrat font-medium text-center flex items-center justify-center transition-all duration-300 {{default buttonClass 'text-xs sm:text-lg rounded-full sm:rounded-3xl px-4 py-2 sm:px-12 sm:py-4 w-full sm:max-w-[428px] shadow-sm sm:shadow-lg sm:backdrop-blur-sm'}}"
>
  {{text}}
</button>
