{{!--
  Komponen: Card Benefit (Responsive)
  Lokasi: src/views/partials/components/ui/card/card_benefit/index.hbs
  Level: L1 Atomik
  Figma: feat-card (250:2829) — why-choose-us (250:2815)

  Props:
  - icon        : string (nama ikon dari BE, diproses helper computeIcon)
  - title       : object|string (multibahasa)
  - description : object|string (multibahasa)
  - lang        : string (bahasa aktif)

  Catatan: mobile + desktop digabung dalam satu template responsif (breakpoint sm).
--}}

<div class="
  w-full flex flex-col items-start text-left
  gap-[12px] sm:gap-[16px]
  bg-[rgba(224,241,249,0.85)] sm:bg-[#F8F9FA]
  rounded-[16px]
  p-[24px] sm:p-[32px]
  shadow-[0_4px_12px_rgba(0,0,0,0.06)] sm:shadow-none
  sm:border sm:border-[#E5E7EB]
  sm:transition-all sm:duration-300 sm:hover:-translate-y-1 sm:hover:shadow-[0_12px_24px_rgba(11,31,59,0.08)]
">
  <!-- icon-bg (250:2830) -->
  <div class="
    flex items-center justify-center shrink-0
    w-[48px] h-[48px]
    rounded-full sm:rounded-[12px]
    bg-[#003060] sm:bg-[#E0F2F9]
  ">
    <i class="{{computeIcon icon}} text-xl lg:text-2xl text-white sm:text-[#0B1F3B]" aria-hidden="true"></i>
  </div>

  <!-- Card Title (250:2834) -->
  <h3 class="{{sizeClass 'h3'}} font-montserrat font-semibold leading-tight text-[#0B1F3B]">
    {{getByLang title lang}}
  </h3>

  <!-- Card Description (250:2835) -->
  <p class="{{sizeClass 'body'}} font-sans font-normal text-[#2D2D2D] sm:text-[#4A5568]">
    {{getByLang description lang}}
  </p>
</div>
