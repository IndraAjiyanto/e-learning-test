{{!--
  Komponen: Program Showcase Card (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/card/program_showcase/index.hbs

  Card showcase program Jepang sesuai spesifikasi Figma (Layer 3):
  - Card: p-6 (24px), gap-5 (20px), rounded-[16px], border #E5E7EB, shadow-[0px_4px_16px_rgba(0,0,0,0.06)]
  - Image: h-[190px], rounded-[10px], overlay gradient
  - Icon badge bulat navy (40x40) + Title (Montserrat 600 20px)
  - Tags row berpemisah titik (·)
  - Description text (Inter 400 13px / line-height 20px)
  - Footer: "Explore program" (13px font-semibold #003060) + Tombol bulat panah kanan (29x29 #003060)

  Props:
  - id          : string (ID program)
  - image       : string (URL gambar)
  - icon        : string (FontAwesome class, misal "fa-solid fa-graduation-cap")
  - title       : string (Nama program)
  - tag1        : string (Tag pertama, warna #003060 font-medium)
  - tag2        : string (Tag kedua)
  - tag3        : string (Tag ketiga)
  - tags        : array of strings (opsional jika passing array)
  - description : string (Deskripsi program)
  - href        : string (URL tujuan, default "/program/{{id}}")
--}}

<div class="group flex w-full flex-col justify-between rounded-[16px] border border-[#E5E7EB] bg-white p-6 shadow-[0px_4px_16px_rgba(0,0,0,0.06)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0px_12px_28px_rgba(11,31,59,0.10)]">
  
  {{!-- Top Image Area --}}
  <div class="relative h-[190px] w-full overflow-hidden rounded-[10px] bg-gray-100 mb-5">
    <img
      src="{{default image 'https://images.unsplash.com/photo-1528164344705-475426879c0d?q=80&w=800&fit=crop'}}"
      alt="{{title}}"
      class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
      onerror="this.src='/public/image/specialProgram/bgJapan.png'"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#0B1F3B]/30 via-transparent to-transparent"></div>
  </div>

  {{!-- Content Body --}}
  <div class="flex flex-1 flex-col gap-3">
    
    {{!-- Icon Badge + Title --}}
    <div class="flex items-center gap-3">
      <div class="grid size-10 shrink-0 place-items-center rounded-full bg-[#003060] text-white">
        <i class="{{default icon 'fa-solid fa-graduation-cap'}} text-sm text-white"></i>
      </div>
      <h3 class="font-montserrat text-[20px] font-semibold leading-[27px] text-[#0B1F3B]">
        {{title}}
      </h3>
    </div>

    {{!-- Tags Row --}}
    <div class="flex flex-wrap items-center gap-2 pt-0.5 font-inter text-[12px] leading-[17px]">
      {{#if tag1}}
        <span class="font-medium text-[#003060]">{{tag1}}</span>
        {{#if tag2}}
          <span class="text-[#D1D5DB] select-none">·</span>
          <span class="text-[#6B7280]">{{tag2}}</span>
        {{/if}}
        {{#if tag3}}
          <span class="text-[#D1D5DB] select-none">·</span>
          <span class="text-[#6B7280]">{{tag3}}</span>
        {{/if}}
      {{else if tags}}
        {{#each tags}}
          <span class="{{#if @first}}font-medium text-[#003060]{{else}}text-[#6B7280]{{/if}}">{{this}}</span>
          {{#unless @last}}<span class="text-[#D1D5DB] select-none">·</span>{{/unless}}
        {{/each}}
      {{/if}}
    </div>

    {{!-- Description --}}
    <p class="font-inter text-[13px] leading-[20px] text-[#6B7280] line-clamp-3">
      {{description}}
    </p>

  </div>

  {{!-- Bottom Action Row --}}
  <div class="mt-5 flex items-center justify-between border-t border-[#F3F4F6] pt-3">
    <a
      href="{{default href (ternary id (concat '/program/' id) '#programs')}}"
      class="font-inter text-[13px] font-semibold text-[#003060] hover:text-[#6EB6E5] transition-colors"
    >
      Explore program
    </a>

    <a
      href="{{default href (ternary id (concat '/program/' id) '#programs')}}"
      class="grid size-[29px] place-items-center rounded-full bg-[#003060] text-white shadow-[0px_2px_6px_rgba(0,48,96,0.25)] transition-transform hover:scale-105 active:scale-95"
      aria-label="Explore program"
    >
      <i class="fa-solid fa-arrow-right text-[11px] text-white"></i>
    </a>
  </div>

</div>
