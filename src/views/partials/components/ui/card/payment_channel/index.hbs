{{!--
  Komponen: Payment Channel Toggle (Gateway | Manual) — Level 2 Molekul
  Lokasi: src/views/partials/components/ui/card/payment_channel/index.hbs

  Digunakan di dalam summary card pembayaran (Full & Installment). Memberi user
  pilihan kanal pembayaran:
  - Gateway : CTA asli (Tombol Pay Now / partial-block) → API Xendit.
  - Manual  : Kartu rekening bank + form upload bukti transfer → rute manual
              verifikasi super admin.

  Props:
  - uid           : string (pembeda id, contoh 'full' | 'installment')
  - methodLabel   : string (label metode, contoh 'Full Payment')
  - actionUrl     : string (endpoint POST formulir manual)
  - gatewayEnabled: boolean — toggle gateway aktif
  - gatewayHidden : boolean — gateway ditolak otomatis (kunci Xendit kosong)
  - manualEnabled : boolean — toggle manual aktif

  @partial-block: konten CTA Gateway (biasanya tombol Pay Now lama).
--}}

<div
  x-data="paymentChannel({
    uid: '{{uid}}',
    gatewayEnabled: {{#if gatewayEnabled}}true{{else}}false{{/if}},
    gatewayHidden: {{#if gatewayHidden}}true{{else}}false{{/if}},
    manualEnabled: {{#if manualEnabled}}true{{else}}false{{/if}},
    copyCopied: '{{{t 'test.payment.channel.copied'}}}',
    copyAccountLabel: '{{{t 'test.payment.channel.copyAccount'}}}'
  })"
  class="flex flex-col gap-3 w-full"
>
  {{!-- Informasi kanal yang sedang aktif. Hanya satu kanal yang boleh aktif
       (ditegakkan di PaymentSettingsService), jadi layar "pilih kanal" tidak
       ada; kanal aktif langsung ditampilkan di bawah. --}}
  <template x-if="!gatewayAvailable && manualAvailable">
    <div class="flex items-center gap-2 rounded-lg bg-[#F1F5F9] px-3 py-2">
      <i class="fa-solid fa-building-columns text-xs text-[#003060]"></i>
      <span class="font-inter text-xs text-[#475569]">
        {{t 'test.payment.channel.manualOnly'}}
      </span>
    </div>
  </template>
  <template x-if="gatewayAvailable && !manualAvailable">
    <div class="flex items-center gap-2 rounded-lg bg-[#F1F5F9] px-3 py-2">
      <i class="fa-solid fa-bolt text-xs text-[#003060]"></i>
      <span class="font-inter text-xs text-[#475569]">
        {{t 'test.payment.channel.gatewayOnly'}}
      </span>
    </div>
  </template>
  <template x-if="!gatewayAvailable && !manualAvailable">
    <div class="flex items-center gap-2 rounded-lg bg-[#FEF2F2] border border-[#FECACA] px-3 py-2">
      <i class="fa-solid fa-circle-exclamation text-xs text-[#D9333F]"></i>
      <span class="font-inter text-xs text-[#D9333F]">
        {{t 'test.payment.channel.allClosed'}}
      </span>
    </div>
  </template>

  {{!-- VIEW: Gateway (halaman Xendit — CTA asli via partial-block) --}}
  <div x-show="channel === 'gateway' && gatewayAvailable" x-cloak class="flex flex-col gap-3 w-full">
    <div class="flex flex-col gap-1">
      <p class="font-montserrat font-semibold text-sm text-[#003060]">
        {{t 'test.payment.channel.gatewayTitle'}}
      </p>
      <p class="font-inter text-[11px] leading-[15px] text-[#8A94A6]">
        {{t 'test.payment.channel.gatewayHint'}}
      </p>
    </div>
    {{> @partial-block}}
  </div>

  {{!-- VIEW: Manual (halaman upload bukti transfer) --}}
  <div x-show="channel === 'manual' && manualAvailable" x-cloak class="flex flex-col gap-3 w-full">
    <div class="flex flex-col gap-1">
      <p class="font-montserrat font-semibold text-sm text-[#003060]">
        {{t 'test.payment.channel.manualTitle'}}
      </p>

    </div>

    {{!-- Kartu Rekening --}}
    <div class="w-full bg-gradient-to-br from-[#003060] to-[#0B3C69] text-white rounded-2xl p-5 flex flex-col gap-4">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-[11px] text-slate-300">{{t 'test.payment.channel.transferTo'}}</p>
          <p class="text-xl font-bold tracking-wider mt-1">046-317-2801</p>
        </div>
        <button
          type="button"
          @click="copyBank()"
          class="p-2 rounded-full bg-slate-700/60 hover:bg-emerald-600 transition-colors"
          :class="{'bg-emerald-600': copied}"
          :title="copied ? copyCopied : copyAccountLabel"
        >
          <i class="far" :class="copied ? 'fa-check' : 'fa-copy'"></i>
        </button>
      </div>
      <div class="flex justify-between items-end gap-3 pt-3 border-t border-slate-700">
        <div>
          <p class="text-[11px] text-slate-300">{{t 'test.payment.channel.accountName'}}</p>
          <p class="text-sm font-semibold">PT. WIRATEK SOLUSI ASIA</p>
        </div>
        <div class="text-right">
          <p class="text-[11px] text-slate-300">{{t 'test.payment.channel.bankLabel'}}</p>
          <p class="text-sm font-semibold">Bank Central Asia (BCA)</p>
        </div>
      </div>
    </div>

    {{!-- Instruksi + Form Upload --}}
    <div class="w-full bg-[#F8FAFC] border border-[#E2E8F0] rounded-xl p-4 flex flex-col gap-3">


      <form
        id="manual-form-{{uid}}"
        x-ref="manualForm"
        action="{{actionUrl}}"
        method="POST"
        enctype="multipart/form-data"
        class="flex flex-col gap-3"
        @submit.prevent="promptConfirm($event)"
      >
        <input type="hidden" name="fullName" :value="formData.fullName" />
        <input type="hidden" name="email" :value="formData.email" />
        <input type="hidden" name="whatsappNumber" :value="formData.whatsappNumber" />
        <input type="hidden" name="source" :value="formData.source" />
        <input type="hidden" name="currentStatus" :value="formData.currentStatus" />
        <input type="hidden" name="promoCode" :value="getPromoCode()" />

        <label
          class="flex flex-col items-center justify-center gap-2 w-full min-h-[120px] rounded-xl border-2 border-dashed border-[#CBD5E1] bg-white hover:border-[#003060] transition-colors cursor-pointer p-4 text-center"
          :class="file ? 'border-emerald-400 bg-emerald-50' : ''"
        >
          <i class="fa-solid fa-cloud-arrow-up text-xl text-[#64748B]" x-show="!file"></i>
          <i class="fa-solid fa-file-image text-xl text-emerald-500" x-show="file"></i>
          <span class="font-inter text-[13px] text-[#475569]" x-show="!file">
            {{t 'test.payment.channel.uploadHint'}}
          </span>
          <span class="font-inter text-[13px] font-semibold text-[#003060]" x-show="file" x-text="fileName"></span>
          <span class="font-inter text-[11px] text-[#94A3B8]">
            {{t 'test.payment.channel.chooseFile'}}
          </span>
          <input
            type="file"
            name="file"
            accept="image/jpeg,image/jpg,image/png"
            class="hidden"
            @change="onFileChange($event)"
          />
        </label>

        <button
          type="submit"
          class="w-full bg-[#16A34A] hover:bg-[#15803D] text-white rounded-lg py-3 font-inter font-semibold text-sm transition-colors flex items-center justify-center gap-2"
        >
          <i class="fa-solid fa-paper-plane text-xs"></i>
          {{t 'test.payment.channel.submit'}}
        </button>
      </form>

      <p class="font-inter text-[11px] text-[#94A3B8] text-center">
        {{t 'test.payment.channel.uniqueNote'}}
      </p>
    </div>
  </div>

  {{!-- Modal Konfirmasi Bukti Pembayaran --}}
  <template x-teleport="body">
    <div
      x-show="showConfirmModal"
      x-cloak
      @keydown.escape.window="closeConfirmModal()"
      class="fixed inset-0 z-[9999] flex items-center justify-center bg-[#0a0a0a]/70 p-4 backdrop-blur-[16px] w-screen h-screen overflow-y-auto"
      @click.self="closeConfirmModal()"
    >
      <div
        role="dialog"
        aria-modal="true"
        aria-labelledby="confirm-payment-title-{{uid}}"
        class="flex w-full max-w-[420px] flex-col gap-5 rounded-2xl bg-white p-6 shadow-2xl border border-slate-100 my-auto"
      >
        {{!-- Icon & Header --}}
        <div class="flex flex-col items-center gap-3">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-8 border-emerald-50 bg-emerald-100 text-emerald-600">
            <i class="fa-solid fa-file-invoice text-lg"></i>
          </span>

          <div class="flex flex-col items-center gap-1 text-center">
            <h2
              id="confirm-payment-title-{{uid}}"
              class="font-inter text-lg font-semibold leading-7 text-[#171717]"
            >
              {{t 'test.payment.channel.confirmTitle'}}
            </h2>
            <p class="font-inter text-xs font-normal leading-5 text-[#64748B]">
              {{t 'test.payment.channel.confirmDesc'}}
            </p>
          </div>
        </div>

        {{!-- Thumbnail / Preview Card --}}
        <div class="w-full flex flex-col gap-2 rounded-xl border border-[#E2E8F0] bg-[#F8FAFC] p-3">
          <div class="flex items-center justify-between text-xs text-[#64748B] font-inter">
            <span class="flex items-center gap-1.5 font-medium truncate max-w-[260px]">
              <i class="fa-solid fa-file-image text-emerald-600"></i>
              <span class="truncate" x-text="fileName"></span>
            </span>
            <span class="text-[11px] text-[#94A3B8] shrink-0" x-text="fileSizeFormatted"></span>
          </div>

          <div class="relative w-full max-h-56 min-h-[140px] rounded-lg overflow-hidden bg-white border border-[#E2E8F0] flex items-center justify-center p-1">
            <template x-if="previewUrl">
              <img
                :src="previewUrl"
                alt="Preview Bukti Pembayaran"
                class="max-h-52 w-auto max-w-full object-contain mx-auto rounded"
              />
            </template>
            <template x-if="!previewUrl">
              <div class="flex flex-col items-center gap-1 text-[#94A3B8] py-8">
                <i class="fa-solid fa-file-image text-3xl"></i>
                <span class="text-xs">{{t 'test.payment.channel.previewNotAvailable'}}</span>
              </div>
            </template>
          </div>
        </div>

        {{!-- Info Notice --}}
        <div class="flex items-start gap-2.5 rounded-lg bg-emerald-50/80 border border-emerald-200/70 p-2.5 text-left">
          <i class="fa-solid fa-shield-halved text-emerald-600 text-xs mt-0.5 shrink-0"></i>
          <p class="font-inter text-[11px] leading-[15px] text-emerald-800">
            {{t 'test.payment.channel.confirmNotice'}}
          </p>
        </div>

        {{!-- Action Buttons --}}
        <div class="flex items-center gap-3 pt-1">
          <button
            type="button"
            @click="closeConfirmModal()"
            :disabled="submitting"
            class="inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-[#D4D4D4] bg-white px-4 py-2.5 font-inter text-sm font-semibold text-[#404040] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#A3A3A3] hover:bg-[#F5F5F5] active:bg-[#EDEDED] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#404040]/40 disabled:cursor-not-allowed disabled:opacity-60"
          >
            {{t 'test.payment.channel.confirmCancel'}}
          </button>

          <button
            type="button"
            @click="confirmAndSubmit()"
            :disabled="submitting"
            class="inline-flex h-11 flex-1 items-center justify-center gap-2 rounded-lg border border-[#16A34A] bg-[#16A34A] px-4 py-2.5 font-inter text-sm font-semibold text-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#15803D] hover:bg-[#15803D] active:bg-[#166534] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#16A34A]/40 disabled:cursor-wait disabled:opacity-80"
          >
            <span x-show="!submitting" class="flex items-center gap-2">
              <i class="fa-solid fa-paper-plane text-xs"></i>
              <span>{{t 'test.payment.channel.confirmSubmit'}}</span>
            </span>
            <span x-show="submitting" class="flex items-center gap-2" x-cloak>
              <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span>{{t 'test.payment.channel.confirmSubmitting'}}</span>
            </span>
          </button>
        </div>
      </div>
    </div>
  </template>
</div>

<script>
  // Dua nilai di bawah dirender tanpa escaping (tiga kurung) supaya tanda
  // kutip di dalam terjemahan tidak menutup literal JS.
  const CHANNEL_FILE_TOO_LARGE_TITLE = '{{{t 'test.payment.channel.fileTooLarge'}}}';
  const CHANNEL_FILE_TOO_LARGE_BODY = '{{{t 'test.payment.channel.fileTooLargeBody'}}}';

  function paymentChannel(data) {
    return {
      uid: data?.uid || 'full',
      gatewayEnabled: !!data?.gatewayEnabled,
      gatewayHidden: !!data?.gatewayHidden,
      manualEnabled: !!data?.manualEnabled,
      channel: 'gateway',
      copied: false,
      file: null,
      fileName: '',
      previewUrl: null,
      showConfirmModal: false,
      submitting: false,
      formData: { fullName: '', email: '', whatsappNumber: '', source: '', currentStatus: '', },

      get gatewayAvailable() {
        return this.gatewayEnabled && !this.gatewayHidden;
      },

      get manualAvailable() {
        return this.manualEnabled;
      },

      // Jaring pengaman: kanal kosong hanya mungkin bila data tidak sinkron.
      get noChannel() {
        return !this.gatewayAvailable && !this.manualAvailable;
      },

      get fileSizeFormatted() {
        if (!this.file || !this.file.size) return '';
        const kb = this.file.size / 1024;
        if (kb < 1024) return kb.toFixed(1) + ' KB';
        return (kb / 1024).toFixed(2) + ' MB';
      },

      cleanPreviewUrl() {
        if (this.previewUrl) {
          URL.revokeObjectURL(this.previewUrl);
          this.previewUrl = null;
        }
      },

      init() {
        // Hanya satu kanal yang aktif, jadi tampilan langsung ke kanal itu
        // tanpa perlu user memilih.
        this.channel = this.gatewayAvailable ? 'gateway' : 'manual';
        this.fillFromDraft();
        document.addEventListener('payment:step-changed', () => this.fillFromDraft());
      },

      fillFromDraft() {
        const key =
          typeof window.getPaymentProgressStorageKey === 'function'
            ? window.getPaymentProgressStorageKey()
            : null;
        if (!key) return;
        try {
          const raw = localStorage.getItem(key);
          if (!raw) return;
          const parsed = JSON.parse(raw);
          const f1 = parsed?.forms?.form1;
          if (f1) {
            this.formData.fullName = f1.fullName || '';
            this.formData.email = f1.email || '';
            this.formData.whatsappNumber = f1.whatsappNumber || '';
            this.formData.source = f1.source || '';
            this.formData.currentStatus = f1.currentStatus || '';
          }
        } catch (e) {
          /* abaikan draft rusak */
        }
      },

      getPromoCode() {
        if (typeof window !== 'undefined' && window.activePromo) {
          return window.activePromo;
        }
        const input = document.getElementById('promo-input') || document.getElementById('promo-input-installment');
        if (input && input.value) {
          return input.value.trim().toUpperCase();
        }
        const key =
          typeof window.getPaymentProgressStorageKey === 'function'
            ? window.getPaymentProgressStorageKey()
            : null;
        if (key) {
          try {
            const raw = localStorage.getItem(key);
            if (raw) {
              const parsed = JSON.parse(raw);
              return parsed?.forms?.form2?.voucherDiscount || '';
            }
          } catch (e) {}
        }
        return '';
      },

      syncPromoCode(event) {
        const promo = this.getPromoCode();
        const form = (event && event.target) || this.$refs.manualForm || document.getElementById('manual-form-' + this.uid);
        if (form) {
          const promoInput = form.querySelector('input[name="promoCode"]');
          if (promoInput) {
            promoInput.value = promo;
          }
        }
      },

      onFileChange(event) {
        const input = event.target;
        const selected = input.files && input.files[0];
        if (!selected) {
          this.cleanPreviewUrl();
          this.file = null;
          this.fileName = '';
          return;
        }
        if (selected.size > 5 * 1024 * 1024) {
          showWarningToast(CHANNEL_FILE_TOO_LARGE_TITLE, CHANNEL_FILE_TOO_LARGE_BODY);
          input.value = '';
          this.cleanPreviewUrl();
          this.file = null;
          this.fileName = '';
          return;
        }
        this.cleanPreviewUrl();
        this.file = selected;
        this.fileName = selected.name;
        if (selected.type && selected.type.startsWith('image/')) {
          this.previewUrl = URL.createObjectURL(selected);
        }
      },

      promptConfirm(event) {
        if (event && typeof event.preventDefault === 'function') {
          event.preventDefault();
        }
        this.syncPromoCode(event);
        if (!this.file) {
          if (typeof showWarningToast === 'function') {
            showWarningToast(
              '{{{t 'test.payment.channel.chooseFile'}}}',
              '{{{t 'test.payment.channel.uploadHint'}}}'
            );
          }
          return;
        }
        this.showConfirmModal = true;
      },

      closeConfirmModal() {
        if (this.submitting) return;
        this.showConfirmModal = false;
      },

      confirmAndSubmit() {
        if (this.submitting) return;
        this.submitting = true;
        const form = this.$refs.manualForm || document.getElementById('manual-form-' + this.uid);
        if (form) {
          const promo = this.getPromoCode();
          const promoInput = form.querySelector('input[name="promoCode"]');
          if (promoInput) {
            promoInput.value = promo;
          }
          form.submit();
        }
      },

      async copyBank() {
        try {
          await navigator.clipboard.writeText('0463172801');
          this.copied = true;
          setTimeout(() => (this.copied = false), 1800);
        } catch (e) {
          /* clipboard tidak tersedia */
        }
      },
    };
  }
</script>