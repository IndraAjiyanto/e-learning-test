{{!--
  Komponen: Payment Channel Toggle (Gateway | Manual) — Level 2 Molekul
  Lokasi: src/views/partials/components/ui/card/payment_channel/index.hbs

  Digunakan di dalam summary card pembayaran (Full & Installment). Memberi user
  pilihan kanal pembayaran:
  - Gateway : CTA asli (Tombol Pay Now / partial-block) → API Xendit.
  - Manual  : Kartu rekening bank + form upload bukti transfer → rute manual
              verifikasi super admin.

  Props:
  - uid           : string (pembeda id, contoh 'full' | 'installment')
  - methodLabel   : string (label metode, contoh 'Full Payment')
  - actionUrl     : string (endpoint POST formulir manual)
  - gatewayEnabled: boolean — toggle gateway aktif
  - gatewayHidden : boolean — gateway ditolak otomatis (kunci Xendit kosong)
  - manualEnabled : boolean — toggle manual aktif

  @partial-block: konten CTA Gateway (biasanya tombol Pay Now lama).
--}}

<div
  x-data="paymentChannel({
    gatewayEnabled: {{#if gatewayEnabled}}true{{else}}false{{/if}},
    gatewayHidden: {{#if gatewayHidden}}true{{else}}false{{/if}},
    manualEnabled: {{#if manualEnabled}}true{{else}}false{{/if}}
  })"
  class="flex flex-col gap-3 w-full"
>
  {{!-- Informasi kanal yang sedang aktif. Hanya satu kanal yang boleh aktif
       (ditegakkan di PaymentSettingsService), jadi layar "pilih kanal" tidak
       ada; kanal aktif langsung ditampilkan di bawah. --}}
  <template x-if="!gatewayAvailable && manualAvailable">
    <div class="flex items-center gap-2 rounded-lg bg-[#F1F5F9] px-3 py-2">
      <i class="fa-solid fa-building-columns text-xs text-[#003060]"></i>
      <span class="font-inter text-xs text-[#475569]">
        Hanya pembayaran Manual (Bank Transfer) yang tersedia.
      </span>
    </div>
  </template>
  <template x-if="gatewayAvailable && !manualAvailable">
    <div class="flex items-center gap-2 rounded-lg bg-[#F1F5F9] px-3 py-2">
      <i class="fa-solid fa-bolt text-xs text-[#003060]"></i>
      <span class="font-inter text-xs text-[#475569]">
        Pembayaran cepat via Gateway (Xendit). Pembayaran manual sedang nonaktif.
      </span>
    </div>
  </template>
  <template x-if="!gatewayAvailable && !manualAvailable">
    <div class="flex items-center gap-2 rounded-lg bg-[#FEF2F2] border border-[#FECACA] px-3 py-2">
      <i class="fa-solid fa-circle-exclamation text-xs text-[#D9333F]"></i>
      <span class="font-inter text-xs text-[#D9333F]">
        Pembayaran untuk program ini sedang ditutup sementara.
      </span>
    </div>
  </template>

  {{!-- VIEW: Gateway (halaman Xendit — CTA asli via partial-block) --}}
  <div x-show="channel === 'gateway' && gatewayAvailable" x-cloak class="flex flex-col gap-3 w-full">
    <div class="flex flex-col gap-1">
      <p class="font-montserrat font-semibold text-sm text-[#003060]">
        Pembayaran Gateway (Xendit)
      </p>
      <p class="font-inter text-[11px] leading-[15px] text-[#8A94A6]">
        Anda akan diarahkan ke halaman pembayaran Xendit setelah menekan tombol di bawah.
      </p>
    </div>
    {{> @partial-block}}
  </div>

  {{!-- VIEW: Manual (halaman upload bukti transfer) --}}
  <div x-show="channel === 'manual' && manualAvailable" x-cloak class="flex flex-col gap-3 w-full">
    <div class="flex flex-col gap-1">
      <p class="font-montserrat font-semibold text-sm text-[#003060]">
        Upload Bukti Pembayaran (Manual Transfer)
      </p>
      <p class="font-inter text-[11px] leading-[15px] text-[#8A94A6]">
        Transfer sesuai nominal di ringkasan, lalu kirim bukti transfer untuk diverifikasi admin (maks. 1x24 jam).
      </p>
    </div>

    {{!-- Kartu Rekening --}}
    <div class="w-full bg-gradient-to-br from-[#003060] to-[#0B3C69] text-white rounded-2xl p-5 flex flex-col gap-4">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-[11px] text-slate-300">Transfer ke rekening berikut</p>
          <p class="text-xl font-bold tracking-wider mt-1">2847 9237 4298 1234</p>
        </div>
        <button
          type="button"
          @click="copyBank()"
          class="p-2 rounded-full bg-slate-700/60 hover:bg-emerald-600 transition-colors"
          :class="{'bg-emerald-600': copied}"
          :title="copied ? 'Tersalin!' : 'Salin nomor rekening'"
        >
          <i class="far" :class="copied ? 'fa-check' : 'fa-copy'"></i>
        </button>
      </div>
      <div class="flex justify-between items-end gap-3 pt-3 border-t border-slate-700">
        <div>
          <p class="text-[11px] text-slate-300">Atas nama</p>
          <p class="text-sm font-semibold">PT. WIRATEK SOLUSI ASIA</p>
        </div>
        <div class="text-right">
          <p class="text-[11px] text-slate-300">Bank</p>
          <p class="text-sm font-semibold">BANK BCA</p>
        </div>
      </div>
    </div>

    {{!-- Instruksi + Form Upload --}}
    <div class="w-full bg-[#F8FAFC] border border-[#E2E8F0] rounded-xl p-4 flex flex-col gap-3">
      <p class="font-inter text-xs leading-[18px] text-[#475569]">
        Setelah transfer, upload bukti pembayaran. Admin akan memverifikasi
        maksimal 1x24 jam dan akun program akan aktif setelah disetujui.
      </p>

      <form
        id="manual-form-{{uid}}"
        action="{{actionUrl}}"
        method="POST"
        enctype="multipart/form-data"
        class="flex flex-col gap-3"
      >
        <input type="hidden" name="fullName" :value="formData.fullName" />
        <input type="hidden" name="email" :value="formData.email" />
        <input type="hidden" name="whatsappNumber" :value="formData.whatsappNumber" />
        <input type="hidden" name="source" :value="formData.source" />

        <label
          class="flex flex-col items-center justify-center gap-2 w-full min-h-[120px] rounded-xl border-2 border-dashed border-[#CBD5E1] bg-white hover:border-[#003060] transition-colors cursor-pointer p-4 text-center"
          :class="file ? 'border-emerald-400 bg-emerald-50' : ''"
        >
          <i class="fa-solid fa-cloud-arrow-up text-xl text-[#64748B]" x-show="!file"></i>
          <i class="fa-solid fa-file-image text-xl text-emerald-500" x-show="file"></i>
          <span class="font-inter text-[13px] text-[#475569]" x-show="!file">
            Upload bukti transfer (JPG/PNG, maks 5MB)
          </span>
          <span class="font-inter text-[13px] font-semibold text-[#003060]" x-show="file" x-text="fileName"></span>
          <span class="font-inter text-[11px] text-[#94A3B8]">
            Klik untuk memilih file
          </span>
          <input
            type="file"
            name="file"
            accept="image/jpeg,image/jpg,image/png"
            required
            class="hidden"
            @change="onFileChange($event)"
          />
        </label>

        <button
          type="submit"
          class="w-full bg-[#16A34A] hover:bg-[#15803D] text-white rounded-lg py-3 font-inter font-semibold text-sm transition-colors flex items-center justify-center gap-2"
        >
          <i class="fa-solid fa-paper-plane text-xs"></i>
          Kirim Bukti Pembayaran
        </button>
      </form>

      <p class="font-inter text-[11px] text-[#94A3B8] text-center">
        Nomor unik pengajuan dibuat otomatis. Anda bisa memantau status di
        Payment History.
      </p>
    </div>
  </div>
</div>

<script>
  function paymentChannel(data) {
    return {
      gatewayEnabled: !!data?.gatewayEnabled,
      gatewayHidden: !!data?.gatewayHidden,
      manualEnabled: !!data?.manualEnabled,
      channel: 'gateway',
      copied: false,
      file: null,
      fileName: '',
      formData: { fullName: '', email: '', whatsappNumber: '', source: '' },

      get gatewayAvailable() {
        return this.gatewayEnabled && !this.gatewayHidden;
      },

      get manualAvailable() {
        return this.manualEnabled;
      },

      // Jaring pengaman: kanal kosong hanya mungkin bila data tidak sinkron.
      get noChannel() {
        return !this.gatewayAvailable && !this.manualAvailable;
      },

      init() {
        // Hanya satu kanal yang aktif, jadi tampilan langsung ke kanal itu
        // tanpa perlu user memilih.
        this.channel = this.gatewayAvailable ? 'gateway' : 'manual';
        this.fillFromDraft();
        document.addEventListener('payment:step-changed', () => this.fillFromDraft());
      },

      fillFromDraft() {
        const key =
          typeof window.getPaymentProgressStorageKey === 'function'
            ? window.getPaymentProgressStorageKey()
            : null;
        if (!key) return;
        try {
          const raw = localStorage.getItem(key);
          if (!raw) return;
          const parsed = JSON.parse(raw);
          const f1 = parsed?.forms?.form1;
          if (f1) {
            this.formData.fullName = f1.fullName || '';
            this.formData.email = f1.email || '';
            this.formData.whatsappNumber = f1.whatsappNumber || '';
            this.formData.source = f1.source || '';
          }
        } catch (e) {
          /* abaikan draft rusak */
        }
      },

      onFileChange(event) {
        const input = event.target;
        const selected = input.files && input.files[0];
        if (!selected) {
          this.file = null;
          this.fileName = '';
          return;
        }
        if (selected.size > 5 * 1024 * 1024) {
          showWarningToast('File terlalu besar', 'Ukuran file maksimal 5MB.');
          input.value = '';
          this.file = null;
          this.fileName = '';
          return;
        }
        this.file = selected;
        this.fileName = selected.name;
      },

      async copyBank() {
        try {
          await navigator.clipboard.writeText('2847923742981234');
          this.copied = true;
          setTimeout(() => (this.copied = false), 1800);
        } catch (e) {
          /* clipboard tidak tersedia */
        }
      },
    };
  }
</script>