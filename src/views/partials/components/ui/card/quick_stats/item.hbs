{{!--
  Komponen: Quick Stats Item (Level 1 - Atomic Card Item)
  Lokasi: src/views/partials/components/ui/card/quick_stats/item.hbs
  Props:
  - icon        : "calendar" | "monitor" | "users" | string icon class
  - label       : Label atas (misal: "TANGGAL MULAI")
  - valueLine1  : Nilai baris 1 (misal: "16 Sep")
  - valueLine2  : Nilai baris 2 (misal: "2026")
  - value       : Nilai fallback 1 baris (jika valueLine1 tidak di-set)
  - class       : Kelas styling tambahan
--}}
<div class="flex items-center gap-3 min-w-0 {{class}}">
  {{!-- Icon Frame 40x40 rounded-12 #F8F9FA border #E2E8F0 --}}
  <div class="flex size-10 shrink-0 items-center justify-center rounded-[12px] border border-[#E2E8F0] bg-[#F8F9FA] text-[#0B1F3B]">
    {{#if (eq icon "calendar")}}
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="#0B1F3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
        <line x1="16" x2="16" y1="2" y2="6"/>
        <line x1="8" x2="8" y1="2" y2="6"/>
        <line x1="3" x2="21" y1="10" y2="10"/>
      </svg>
    {{else if (eq icon "monitor")}}
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="#0B1F3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="20" height="14" x="2" y="3" rx="2"/>
        <line x1="8" x2="16" y1="21" y2="21"/>
        <line x1="12" x2="12" y1="17" y2="21"/>
      </svg>
    {{else if (eq icon "users")}}
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="#0B1F3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
    {{else}}
      <i class="{{icon}} text-lg text-[#0B1F3B]" aria-hidden="true"></i>
    {{/if}}
  </div>

  {{!-- Text info: Label 10px uppercase + 2-baris Value 20px bold (line-height 24px) persis Figma --}}
  <div class="flex flex-col justify-center min-w-0">
    <span class="font-inter text-[10px] font-semibold uppercase leading-tight tracking-wider text-[#64748B] mb-0.5 whitespace-nowrap">
      {{label}}
    </span>
    <div class="font-inter text-base sm:text-[18px] lg:text-[20px] font-bold leading-[22px] lg:leading-[24px] text-[#0B1F3B] flex flex-col justify-center min-h-[44px] lg:min-h-[48px]">
      {{#if valueLine1}}
        <span class="whitespace-nowrap">{{valueLine1}}</span>
        {{#if valueLine2}}<span class="whitespace-nowrap">{{valueLine2}}</span>{{/if}}
      {{else}}
        <span class="whitespace-nowrap">{{value}}</span>
      {{/if}}
    </div>
  </div>
</div>
