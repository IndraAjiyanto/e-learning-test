{{!--
  Komponen: Transaction Card (User Payment History)
  Lokasi: src/views/partials/components/ui/card/transaction_card/index.hbs
  Level: L2 Molekul (scoped user)

  Kartu riwayat transaksi user sesuai token Figma:
  - Container: White (#FFFFFF), border 1px solid #D8E6F6, shadow 0px 3px 12px rgba(23,59,104,0.0627), radius 10px, padding 16px 22px, gap 22px
  - Course artwork: 76x60px rounded-md (#E8E2FF / #DDE9FF) dengan icon 42px
  - Program details: Title (Inter 700 12px #082E63) & Category badge (Inter 600 9px)
  - Invoice / Schedule: Label (Inter 10px #6280A5) & Tanggal (Inter 10px #082E63 dengan calendar icon)
  - Method details: Label (Inter 10px #6280A5) & Metode pembayaran (Inter 11px #082E63 dengan icon banknote/card)
  - Payment details (Status): Label (Inter 10px #6280A5) & Pill status dot (Paid / Processing / Failed)
  - Action buttons: Tombol "View Detail" (Montserrat 600 14px #FFFFFF, background #003060, radius 8px, 42px height)
--}}
<div class="box-border flex flex-col lg:flex-row lg:items-center justify-between p-4 sm:p-[16px_22px] gap-4 lg:gap-[22px] w-full min-h-[95px] bg-white border border-[#D8E6F6] rounded-[10px] shadow-[0px_3px_12px_rgba(23,59,104,0.0627)] transition-all hover:border-[#B5D2F2]">
  <!-- Left Side: Artwork & Program Details -->
  <div class="flex items-center gap-3 sm:gap-[18px] min-w-0 flex-1">
    <!-- Course artwork -->
    <div
      class="flex flex-col justify-center items-center w-[70px] sm:w-[76px] h-[54px] sm:h-[60px] rounded-md shrink-0 transition-colors"
      :class="row.categoryName && row.categoryName.toLowerCase().includes('design') ? 'bg-[#E8E2FF] text-[#5135B5]' : 'bg-[#DDE9FF] text-[#2563EB]'"
    >
      <svg class="w-9 sm:w-[42px] h-9 sm:h-[42px] opacity-[0.78]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/>
      </svg>
    </div>

    <!-- Program details -->
    <div class="flex flex-col items-start gap-1.5 sm:gap-[7px] min-w-0 flex-1">
      <span class="font-inter font-bold text-xs leading-[15px] text-[#082E63] truncate w-full" x-text="row.courseName"></span>
      <div class="flex items-center gap-1.5">
        <span
          class="inline-flex items-center px-2.5 py-[3px] rounded-full font-inter font-semibold text-[9px] leading-[11px]"
          :class="row.categoryName && row.categoryName.toLowerCase().includes('design') ? 'bg-[#E8E2FF] text-[#5135B5]' : 'bg-[#DDE9FF] text-[#2563EB]'"
          x-text="row.categoryName || 'Bootcamp'"
        ></span>
        <template x-if="row.kind === 'installment' && row.installmentDetail">
          <span class="inline-flex items-center px-2 py-[2px] rounded-full font-inter font-medium text-[9px] leading-[11px] bg-[#eff8ff] text-[#175cd3]" x-text="'Cicilan ' + row.installmentDetail.planMonth + 'x'"></span>
        </template>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="hidden lg:block w-px h-[50px] bg-[#D8E6F6] shrink-0"></div>

  <!-- Middle Info Grid: Schedule, Method, and Status -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:flex lg:items-center gap-4 lg:gap-[22px] shrink-0">
    <!-- Invoice details / Schedule -->
    <div class="flex flex-col items-start gap-2 w-auto lg:w-[130px]">
      <span class="font-inter font-normal text-[10px] leading-3 text-[#6280A5]">Schedule</span>
      <div class="flex items-center gap-[7px]">
        <svg class="w-3 h-3 text-[#082E63] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span class="font-inter font-normal text-[10px] leading-3 text-[#082E63] truncate" x-text="formatDate(row.date)"></span>
      </div>
    </div>

    <!-- Divider -->
    <div class="hidden lg:block w-px h-[50px] bg-[#D8E6F6] shrink-0"></div>

    <!-- Method details -->
    <div class="flex flex-col items-start gap-2 w-auto lg:w-[160px]">
      <span class="font-inter font-normal text-[10px] leading-3 text-[#6280A5]">Payment method</span>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#082E63] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="5" width="20" height="14" rx="2"/>
          <line x1="2" y1="10" x2="22" y2="10"/>
        </svg>
        <span class="font-inter font-normal text-[11px] leading-[13px] text-[#082E63] truncate" x-text="row.method || 'Bank Transfer'"></span>
      </div>
    </div>

    <!-- Divider -->
    <div class="hidden lg:block w-px h-[50px] bg-[#D8E6F6] shrink-0"></div>

    <!-- Payment details (Status) -->
    <div class="flex flex-col items-start gap-2 w-auto lg:w-[130px]">
      <span class="font-inter font-normal text-[10px] leading-3 text-[#6280A5]">Payment status</span>
      <span
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-inter font-semibold text-[10px] leading-3"
        :class="row.status === 'paid' ? 'bg-[#CFF3DF] text-[#139B59]' : (row.status === 'processing' ? 'bg-[#FFF0C7] text-[#E99A0C]' : 'bg-[#FFDADA] text-[#D9333F]')"
      >
        <span
          class="w-[7px] h-[7px] rounded-full shrink-0"
          :class="row.status === 'paid' ? 'bg-[#139B59]' : (row.status === 'processing' ? 'bg-[#E99A0C]' : 'bg-[#D9333F]')"
        ></span>
        <span x-text="row.statusLabel"></span>
      </span>
    </div>
  </div>

  <!-- Divider -->
  <div class="hidden lg:block w-px h-[50px] bg-[#D8E6F6] shrink-0"></div>

  <!-- Action buttons -->
  <div class="flex items-center justify-end gap-2.5 shrink-0 w-full lg:w-auto pt-2 lg:pt-0 border-t lg:border-t-0 border-[#F0F0F0]">
    <button
      type="button"
      @click="openTransactionDetailModal(row)"
      class="inline-flex h-[42px] w-[122px] items-center justify-center gap-1.5 rounded-lg bg-[#003060] border border-[#003060] px-2.5 font-montserrat font-semibold text-sm leading-5 text-white shadow-[0px_1px_2px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#00254a] active:bg-[#001f3f]"
    >
      <svg class="w-4 h-4 text-white shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"/>
        <path d="m12 5 7 7-7 7"/>
      </svg>
      <span>View Detail</span>
    </button>
  </div>
</div>
