{{!--
  Komponen: Single Interactive Pricing Card (Level 1 - Atomic UI Component)
  Lokasi: src/views/partials/components/ui/card/pricing_card/index.hbs

  Spesifikasi Figma & Penyesuaian Backend:
  - Width: 773px (max-w-[773px], w-full mx-auto)
  - Background: #FFFFFF, rounded-[20px], border #E2E8F0, p-6 sm:p-8
  - Box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.0941176)
  - Interaktivitas Toggle Tab:
    - Tab "Full Payment":
      - Menampilkan harga Full Payment dari BE (kolom course.promo / course.price).
      - Menampilkan harga coret dan badge penghematan HANYA jika course.price > course.promo (diskon valid).
      - Countdown timer: Offer Ends In 15 Days 11 : 50 : 05
      - Kotak jadwal (Registration, Cicilan Per Bulan & Tanggal Jatuh Tempo, Start Learning)
      - Tombol "Registration Now" & link "Free Consultation"
    - Tab "Installment":
      - Menampilkan harga cicilan dari BE (kolom course.price / course.installments.[0].downPayment).
      - Countdown timer
      - Kotak kuning "Installment Information" dengan 4 poin penjelasan cicilan
      - Kotak jadwal (Registration, Cicilan Per Bulan & Tanggal Jatuh Tempo, Start Learning)
      - Tombol "Registration Now" & link "Free Consultation"

  Props:
  - course            : object (price, promo, startDate, startEnd, date_registration, id, installments)
  - installments      : array (opsional list cicilan)
  - contactWhatsapp   : string
  - userActivePayment : object (status transaksi aktif: approved | process)
  - user              : object
  - lang              : string
--}}

<div 
  class="box-border flex w-full max-w-[773px] mx-auto flex-col items-start gap-6 rounded-[20px] border border-[#E2E8F0] bg-white p-6 sm:p-8 shadow-[0px_8px_24px_rgba(0,0,0,0.09)] transition-all duration-300"
  x-data="{
    tab: 'full',
    openInstallmentInfo: true
  }"
>
  
  {{!-- Card Title: Inter 700 22px #0B1F3B text-center --}}
  <h3 class="w-full text-center font-inter text-xl sm:text-[22px] font-bold leading-[27px] text-[#0B1F3B]">
    {{default (t 'test.paidProgram.pricing.cardTitle') 'Kickstart Your Career Today'}}
  </h3>

  {{!-- Payment Toggle Tabs (Figma: width 100%, height 44px, bg #F1F5F9, rounded-full, p-1) --}}
  <div class="flex w-full items-center rounded-full bg-[#F1F5F9] p-1 select-none">
    {{!-- Full Payment Tab Button --}}
    <button 
      type="button"
      @click="tab = 'full'"
      class="flex flex-1 items-center justify-center py-2.5 rounded-full text-[13px] font-semibold transition-all duration-200 cursor-pointer"
      :class="tab === 'full' ? 'bg-[#003060] text-white shadow-xs' : 'border border-[#CBD5E1] text-[#64748B] hover:text-[#0B1F3B]'"
    >
      {{default (t 'test.paidProgram.pricing.fullPayment') 'Full Payment'}}
    </button>
    
    {{#if (or (and installments installments.length) (and course.installments course.installments.length))}}
      {{!-- Installment Tab Button --}}
      <button 
        type="button"
        @click="tab = 'installment'"
        class="flex flex-1 items-center justify-center py-2.5 rounded-full text-[13px] font-semibold transition-all duration-200 cursor-pointer"
        :class="tab === 'installment' ? 'bg-[#003060] text-white shadow-xs' : 'border border-[#CBD5E1] text-[#64748B] hover:text-[#0B1F3B]'"
      >
        {{default (t 'test.paidProgram.pricing.installment') 'Installment'}}
      </button>
    {{/if}}
  </div>

  {{!-- Dynamic Price Section --}}
  <div class="w-full flex flex-col gap-1.5">
    
    {{!-- FULL PAYMENT PRICE VIEW --}}
    <div x-show="tab === 'full'" class="flex flex-col items-start gap-1.5 w-full">
      {{!-- Harga Coret & Badge Save (Hanya tampil jika ada diskon valid: price > promo dan promo > 0) --}}
      {{#if (and (isNumber course.price) (isNumber course.promo) (gt course.price course.promo) (gt course.promo 0))}}
        <div class="flex flex-row items-center gap-2">
          <span class="font-inter text-sm font-normal text-[#9CA3AF] line-through">
            {{formatRupiah course.price}}
          </span>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-[#D1FAE5] font-inter text-[11px] font-semibold text-[#059669]">
            {{default (t 'test.paidProgram.pricing.save') 'Save'}} {{formatRupiah (subtract course.price course.promo)}}
          </span>
        </div>
      {{/if}}

      {{!-- Harga Utama Full Payment --}}
      <div class="font-inter text-2xl sm:text-[28px] font-extrabold leading-[34px] text-[#0B1F3B]">
        {{#if (and (isNumber course.promo) (gt course.promo 0))}}
          {{formatRupiah course.promo}}
        {{else if (and (isNumber course.price) (gt course.price 0))}}
          {{formatRupiah course.price}}
        {{else if (or (eq course.promo 0) (eq course.price 0))}}
          {{formatRupiah 0}}
        {{else}}
          Rp 100.000.000
        {{/if}}
      </div>
    </div>

    {{#if (or (and installments installments.length) (and course.installments course.installments.length))}}
      {{!-- INSTALLMENT PRICE VIEW --}}
      <div x-show="tab === 'installment'" x-cloak class="flex flex-col items-start gap-1 w-full">
        <div class="font-inter text-2xl sm:text-[28px] font-extrabold leading-[34px] text-[#0B1F3B]">
          {{#if (and (eq course.price 0) (eq course.promo 0))}}
            {{!-- Jika program gratis (Rp 0), cicilan/DP Rp 0 --}}
            {{formatRupiah 0}}
          {{else if course.installments.[0].downPayment}}
            {{!-- Menggunakan kolom downPayment dari table installment --}}
            {{formatRupiah course.installments.[0].downPayment}}
          {{else if installments.[0].downPayment}}
            {{formatRupiah installments.[0].downPayment}}
          {{else}}
            {{formatRupiah 0}}
          {{/if}}
        </div>
      </div>
    {{/if}}

  </div>



  {{!-- Divider (Only shown in Full Payment view) --}}
  <hr x-show="tab === 'full'" class="w-full border-t border-[#E5E7EB]" />

  {{#if (or (and installments installments.length) (and course.installments course.installments.length))}}
    {{!-- Installment Information Accordion (Only for Installment Tab) --}}
    <div x-show="tab === 'installment'" x-cloak class="flex flex-col gap-3 w-full">
      {{!-- Yellow Badge Bar --}}
      <div 
        @click="openInstallmentInfo = !openInstallmentInfo"
        class="flex items-center justify-between rounded-lg bg-[#FEF3C7] border border-[#FDE68A] px-3.5 py-2.5 cursor-pointer select-none transition-colors hover:bg-[#FDE68A]/60"
      >
        <div class="flex items-center gap-2 text-[#B7791F]">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="#B7791F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
            <line x1="7" y1="7" x2="7.01" y2="7"/>
          </svg>
          <span class="font-inter text-[13px] font-bold text-[#B7791F]">
            {{default (t 'test.paidProgram.pricing.installmentInfo') 'Installment Information'}}
          </span>
        </div>

        <svg 
          class="size-4 text-[#B7791F] transition-transform duration-200" 
          :class="openInstallmentInfo ? 'rotate-180' : ''"
          viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>

      {{!-- 4 Points List --}}
      <div x-show="openInstallmentInfo" x-collapse class="flex flex-col gap-1.5 font-inter text-xs sm:text-[13px] leading-relaxed text-[#64748B] pl-1">
        <div class="flex items-start gap-2">
          <span class="font-normal text-[#64748B] shrink-0">1.</span>
          <span>{{default (t 'test.paidProgram.pricing.point1') 'Down Payment (DP) is required as the first payment for enrollment'}}</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="font-normal text-[#64748B] shrink-0">2.</span>
          <span>{{default (t 'test.paidProgram.pricing.point2') 'No additional fees or interest'}}</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="font-normal text-[#64748B] shrink-0">3.</span>
          <span>{{default (t 'test.paidProgram.pricing.point3') 'Pay monthly as per schedule below'}}</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="font-normal text-[#64748B] shrink-0">4.</span>
          <span>{{default (t 'test.paidProgram.pricing.point4') 'Full access after DP payment'}}</span>
        </div>
      </div>
    </div>
  {{/if}}

  {{!-- Schedule Section Box (Shared across both tabs) --}}
  <div class="flex w-full flex-col gap-2.5 rounded-xl bg-[#F9FAFB] p-4 font-inter text-xs text-[#374151]">
    {{!-- Registration --}}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-3">
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="font-bold text-[#374151]">{{default (t 'test.paidProgram.pricing.registration') 'Registration'}}</span>
        <span x-show="tab === 'installment'" x-cloak class="font-bold text-[#374151]">(DP)</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2 sm:text-right">
        <span class="font-normal text-[#4B5563]">
          {{ternary course.date_registration (formatDateDayMonthYear course.date_registration lang) "Friday, 21 August 2026"}}
        </span>
        {{#if (or (and installments installments.length) (and course.installments course.installments.length))}}
          <span x-show="tab === 'installment'" x-cloak class="font-semibold text-[#003060]">
            {{#if course.installments.[0].downPayment}}
              ({{formatRupiah course.installments.[0].downPayment}})
            {{else if installments.[0].downPayment}}
              ({{formatRupiah installments.[0].downPayment}})
            {{/if}}
          </span>
        {{/if}}
      </div>
    </div>

    {{#if (or (and installments installments.length) (and course.installments course.installments.length))}}
      {{!-- Monthly Installment Schedule (Only for Installment Tab) --}}
      <div x-show="tab === 'installment'" x-cloak class="flex flex-col gap-2.5 border-t border-[#E5E7EB] pt-2.5">
        {{#with (coalesce course.installments.[0] installments.[0])}}
          {{#if (isArray price)}}
            {{#each price}}
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-3">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-[#374151] shrink-0">
                    {{default (t 'test.payment.installment.monthLabel') 'Bulan'}} {{addOne @index}}
                  </span>
                  <span class="font-semibold text-[#003060]">
                    {{formatRupiah this}}
                  </span>
                </div>
                <span class="font-normal text-[#4B5563] sm:text-right">
                  {{#if (lookup ../dueDates @index)}}
                    {{formatDateDayMonthYear (lookup ../dueDates @index) ../../lang}}
                  {{/if}}
                </span>
              </div>
            {{/each}}
          {{else if (isNumber price)}}
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-3">
              <div class="flex items-center gap-2">
                <span class="font-bold text-[#374151] shrink-0">
                  {{default (t 'test.payment.installment.monthlyAfterDp') 'Cicilan Bulanan'}}
                </span>
                <span class="font-semibold text-[#003060]">
                  {{formatRupiah price}}
                </span>
              </div>
              <span class="font-normal text-[#4B5563] sm:text-right">
                {{#if (lookup dueDates 0)}}
                  {{formatDateDayMonthYear (lookup dueDates 0) ../lang}}
                {{/if}}
              </span>
            </div>
          {{/if}}
        {{/with}}
      </div>
    {{/if}}
    
    {{!-- Start Learning --}}
    <div 
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-3"
      :class="tab === 'installment' ? 'border-t border-[#E5E7EB] pt-2.5' : ''"
    >
      <span class="font-bold text-[#374151] shrink-0">{{default (t 'test.paidProgram.pricing.startLearning') 'Start Learning'}}</span>
      <span class="font-normal text-[#4B5563] sm:text-right">
        {{#if course.startDate}}
          {{formatDateDayMonthYear course.startDate lang}}{{#if course.startEnd}} - {{formatDateDayMonthYear course.startEnd lang}}{{/if}}
        {{else}}
          Saturday, 22 August 2026 - Sunday, 23 August 2026
        {{/if}}
      </span>
    </div>
  </div>

  {{!-- CTA Section (Shared across both tabs) --}}
  <div class="flex w-full flex-col items-center gap-3">
    {{#if (eq userActivePayment.process 'approved')}}
      <a
        href="{{#if user.id}}/program/myProgram/{{user.id}}?courseId={{course.id}}{{else}}/users/profile?tab=history-payment{{/if}}"
        class="flex w-full h-[45px] items-center justify-center rounded-[10px] bg-[#16A34A] font-inter text-sm font-bold text-white shadow-xs transition-all hover:bg-[#15803D] hover:-translate-y-0.5 active:scale-95 text-center cursor-pointer select-none"
      >
        <i class="fa-solid fa-graduation-cap mr-2"></i>
        {{default (t 'test.paidProgram.pricing.btnGoToClass') 'Mulai Belajar'}}
      </a>
    {{else if (eq userActivePayment.process 'process')}}
      <a
        href="/users/profile?tab=history-payment"
        class="flex w-full h-[45px] items-center justify-center rounded-[10px] bg-[#D97706] font-inter text-sm font-bold text-white shadow-xs transition-all hover:bg-[#B45309] hover:-translate-y-0.5 active:scale-95 text-center cursor-pointer select-none"
      >
        <i class="fa-solid fa-clock mr-2"></i>
        {{default (t 'test.paidProgram.pricing.btnPending') 'Cek Status Pembayaran'}}
      </a>
    {{else}}
      <a
        {{#if (or (and installments installments.length) (and course.installments course.installments.length))}}
          :href="tab === 'installment' ? '{{#if course.id}}/payment/registration/{{course.id}}?method=installment{{else}}#hero{{/if}}' : '{{#if course.id}}/payment/registration/{{course.id}}?method=full{{else}}#hero{{/if}}'"
        {{/if}}
        href="{{#if course.id}}/payment/registration/{{course.id}}?method=full{{else}}#hero{{/if}}"
        class="flex w-full h-[45px] items-center justify-center rounded-[10px] bg-[#1E3A5F] font-inter text-sm font-bold text-white shadow-xs transition-all hover:bg-[#152841] hover:-translate-y-0.5 active:scale-95 text-center cursor-pointer select-none"
      >
        {{default (t 'test.paidProgram.pricing.btnRegister') 'Registration Now'}}
      </a>
    {{/if}}

    <a
      href="{{waLink contactWhatsapp}}"
      target="_blank"
      rel="noopener noreferrer"
      class="font-inter text-[13px] font-semibold text-[#1E3A5F] underline hover:text-[#003060] text-center cursor-pointer"
    >
      {{default (t 'test.paidProgram.pricing.btnConsultation') 'Free Consultation'}}
    </a>
  </div>

</div>
