{{!--
  Komponen: About Feature Card (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/card/about_feature/index.hbs

  Kartu ikon + judul + deskripsi untuk tab Story ("Our Commitment", Figma 250:778)
  dan tab Values (Figma 250:1069). Ikon dipakai lewat CSS mask supaya semua ikon
  tampil seragam (ukuran + warna #003060) walau file SVG sumbernya berbeda-beda.

  Props:
  - variant      : "commitment" (default) | "value"
  - iconBase     : path folder ikon (mis. "/public/image/about/story/")
  - iconName     : nama file ikon dari data
  - icon         : path ikon langsung (dipakai kalau tak ada iconBase)
  - title        : judul (HTML / multibahasa)
  - description  : deskripsi (HTML / multibahasa)
  - wide         : true -> layout baris (ikon kiri, teks kanan) untuk kartu spotlight
  - class        : kelas tambahan wrapper
--}}

{{#if (eq variant 'value')}}
<div class="flex {{#if wide}}flex-row items-center sm:col-span-full{{else}}flex-col{{/if}} gap-4 rounded-xl border border-[#E2E8F0] bg-white p-5 lg:p-6 shadow-[0px_1px_3px_0px_rgba(0,0,0,0.04),0px_8px_20px_-12px_rgba(0,0,0,0.08)] {{class}}">
  <span class="grid size-12 shrink-0 place-items-center rounded-full bg-[#E0F2F9]">
    <span class="block size-5 bg-[#003060]" style="-webkit-mask:url('{{#if iconBase}}{{iconBase}}{{iconName}}{{else}}{{icon}}{{/if}}') center/contain no-repeat;mask:url('{{#if iconBase}}{{iconBase}}{{iconName}}{{else}}{{icon}}{{/if}}') center/contain no-repeat;"></span>
  </span>
  <div class="flex flex-col gap-2 min-w-0">
    <h3 class="{{sizeClass 'h3'}} font-montserrat font-bold text-[#0B1F3B]">{{{title}}}</h3>
    <p class="{{sizeClass 'body'}} font-open-sans font-normal text-[#4B5563]">{{{description}}}</p>
  </div>
</div>
{{else}}
<div class="flex {{#if wide}}flex-row items-center{{else}}flex-col{{/if}} gap-4 rounded-2xl border border-[#E5E7EB] bg-white p-5 lg:p-6 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.04),0px_6px_16px_-6px_rgba(0,0,0,0.08)] {{class}}">
  <span class="grid size-12 lg:size-14 shrink-0 place-items-center rounded-xl bg-[#D9E8F5]">
    <span class="block size-6 bg-[#003060]" style="-webkit-mask:url('{{#if iconBase}}{{iconBase}}{{iconName}}{{else}}{{icon}}{{/if}}') center/contain no-repeat;mask:url('{{#if iconBase}}{{iconBase}}{{iconName}}{{else}}{{icon}}{{/if}}') center/contain no-repeat;"></span>
  </span>
  <div class="flex flex-col gap-2 min-w-0">
    <h3 class="{{sizeClass 'h3'}} font-inter font-semibold text-[#111827]">{{{title}}}</h3>
    <p class="{{sizeClass 'body'}} font-inter text-[#6B7280]">{{{description}}}</p>
  </div>
</div>
{{/if}}
