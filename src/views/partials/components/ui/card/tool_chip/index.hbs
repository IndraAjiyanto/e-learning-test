{{!--
  Komponen: Tool Chip / Logo Badge (Level 1 - Atomic UI Component)
  Lokasi: src/views/partials/components/ui/card/tool_chip/index.hbs

  Spesifikasi Figma:
  - Box: height 56px, padding 16px 24px, gap 12px, bg #FAFAFA, border 1px solid #E2E8F0, rounded 12px
  - Icon: 24x24px container (vektor 20x20px dengan warna tema masing-masing software)
  - Label: Inter 600 16px leading 19px, color #0B1F3B

  Props:
  - name     : string (Nama tool, misal: "Figma", "Figjam", "Maze", "Notion", "Miro")
  - toolType : "figma" | "figjam" | "maze" | "notion" | "miro" (opsional untuk SVG vektor Figma murni)
  - svg      : string (raw SVG dari tabel technologies jika ada)
  - imgUrl   : string (URL icon dari database jika ada)
  - class    : string
--}}

<div class="box-border inline-flex h-14 items-center justify-center gap-3 rounded-xl border border-[#E2E8F0] bg-[#FAFAFA] px-5 sm:px-6 py-4 shadow-2xs transition-all duration-300 hover:-translate-y-0.5 hover:bg-white hover:border-[#CBD5E1] hover:shadow-xs select-none {{class}}">
  
  {{!-- Icon Container 24x24px --}}
  <div class="flex size-6 shrink-0 items-center justify-center">
    {{#if (eq (lower name) "figma")}}
      {{!-- Figma Icon (Vektor spesifik Figma: #F24E1E) --}}
      <svg class="size-5" viewBox="0 0 24 24" fill="none">
        <path d="M5 5.5A3.5 3.5 0 0 1 8.5 2H12v7H8.5A3.5 3.5 0 0 1 5 5.5z" fill="#F24E1E"/>
        <path d="M12 2h3.5a3.5 3.5 0 1 1 0 7H12V2z" fill="#FF7262"/>
        <path d="M12 12.5a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" fill="#1ABCFE"/>
        <path d="M5 12.5A3.5 3.5 0 0 1 8.5 9H12v7H8.5A3.5 3.5 0 0 1 5 12.5z" fill="#A259FF"/>
        <path d="M5 19.5A3.5 3.5 0 0 1 8.5 16H12v3.5a3.5 3.5 0 1 1-7 0z" fill="#0ACF83"/>
      </svg>
    {{else if (eq (lower name) "figjam")}}
      {{!-- Figjam Icon (Vektor spesifik Figjam: #FF5F1F) --}}
      <svg class="size-5" viewBox="0 0 24 24" fill="none">
        <rect x="2" y="2" width="20" height="20" rx="6" stroke="#FF5F1F" stroke-width="2.2"/>
        <path d="M8 8l8 8M16 8l-8 8" stroke="#FF5F1F" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
    {{else if (eq (lower name) "maze")}}
      {{!-- Maze Icon (Vektor spesifik Maze: #2563EB) --}}
      <svg class="size-5" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="9" stroke="#2563EB" stroke-width="2.2"/>
        <path d="M8 12h8M12 8v8" stroke="#2563EB" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
    {{else if (eq (lower name) "notion")}}
      {{!-- Notion Icon (Vektor spesifik Notion: #000000) --}}
      <svg class="size-5" viewBox="0 0 24 24" fill="none">
        <path d="M4 4v16h16V4H4zm3.5 3h9v2h-9V7zm0 4h9v2h-9v-2zm0 4h6v2h-6v-2z" fill="#000000"/>
      </svg>
    {{else if (eq (lower name) "miro")}}
      {{!-- Miro Icon (Vektor spesifik Miro: #FFC107) --}}
      <svg class="size-5" viewBox="0 0 24 24" fill="none">
        <path d="M7 4L3 12l4 8M12 4l-4 8 4 8M17 4l-4 8 4 8" stroke="#FFC107" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    {{else if svg}}
      {{!-- Raw SVG dari Database (table technologies.svg) --}}
      <div class="size-5 flex items-center justify-center [&>svg]:w-5 [&>svg]:h-5 [&>svg]:object-contain">
        {{{svg}}}
      </div>
    {{else if imgUrl}}
      {{!-- Image URL dari Database (table technologies.imgUrl) --}}
      <img src="{{imgUrl}}" alt="{{name}}" class="size-5 object-contain" />
    {{else}}
      {{!-- Fallback Generic Tool Icon --}}
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="#0B1F3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
      </svg>
    {{/if}}
  </div>

  {{!-- Tool Name: Inter 600 16px #0B1F3B --}}
  <span class="font-inter text-sm sm:text-base font-semibold leading-[19px] text-[#0B1F3B]">
    {{name}}
  </span>

</div>
