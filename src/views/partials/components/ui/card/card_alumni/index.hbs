{{!-- 
  Komponen: Card Alumni (Global - Digunakan di Home, Free Program, Paid Program, Short Class)
  Lokasi: src/views/partials/components/ui/card/card_alumni/index.hbs
  Level: L1 Atomik

  Props:
  - variant         : 'stacked' (default) | 'profile'
                      'stacked' = layout lama (quote di atas, profil di bawah)
                      'profile' = layout baru (profil di atas, quote, badge bootcamp)
  - isDesktop       : boolean — true = data diambil dari state Alpine `item`, false = dari props Handlebars
  - message         : Teks ulasan/testimonial (multibahasa)
  - profile         : URL gambar profil (opsional, fallback ke orang.png)
  - name            : Nama alumni (multibahasa)
  - currentPosition : Jabatan/posisi (multibahasa)
  - courseName      : Nama kursus/program yang diikuti (opsional, tampil sebagai badge di variant 'profile')
  - badgeLabel      : string (opsional) — prefix badge, default (t 'test.home.alumniSection.bootcampLabel')
  - lang            : Bahasa yang aktif
--}}

{{#if (eq variant 'profile')}}
{{!-- ============ VARIANT: PROFILE ============ --}}
<div class="group relative flex h-full w-full flex-col items-start gap-5 overflow-hidden rounded-[20px] border border-[#E2E8F0] bg-gradient-to-r from-white to-[#F1F5F9] p-6 sm:p-8 shadow-[0px_12px_32px_-4px_rgba(11,31,59,0.0313726)] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#003060]/30 hover:shadow-[0px_16px_40px_-4px_rgba(11,31,59,0.12)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 isolate">
  <svg class="pointer-events-none absolute right-6 top-4 h-14 w-14 select-none text-[#0B1F3B]/[0.06] transition-colors duration-300 group-hover:text-[#0B1F3B]/10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
  </svg>

  <div class="relative z-[1] flex w-full items-center gap-4">
    <div class="flex h-[72px] w-[72px] shrink-0 items-center justify-center rounded-full border-2 border-[#003060] p-[3px]">
      <img {{#if isDesktop}}:src="item.photo || '/public/image/orang.png'" :alt="item.name"{{else}}src="{{default profile '/public/image/orang.png'}}" alt="{{getByLang name lang}}"{{/if}}
           class="h-full w-full rounded-full object-cover"
           onerror="this.onerror=null; this.src='/public/image/orang.png';" />
    </div>
    <div class="flex min-w-0 flex-1 flex-col gap-1 text-left">
      <h4 class="font-inter text-[18px] font-bold leading-[22px] text-[#0F172A]"
          {{#if isDesktop}}x-text="item.name"{{/if}}>
        {{#unless isDesktop}}{{getByLang name lang}}{{/unless}}
      </h4>
      <p class="truncate font-inter text-[14px] font-medium leading-[17px] text-[#475569]"
         {{#if isDesktop}}x-text="item.position"{{/if}}>
        {{#unless isDesktop}}{{getByLang currentPosition lang}}{{/unless}}
      </p>
    </div>
  </div>

  <p class="relative z-[2] flex-1 text-left font-inter text-[15px] font-normal leading-[160%] text-[#0F172A]"
     {{#if isDesktop}}x-text="'“' + item.testimonial + '”'"{{/if}}>
    {{#unless isDesktop}}&ldquo;{{getByLang message lang}}&rdquo;{{/unless}}
  </p>

  {{#if isDesktop}}
    <template x-if="item.company">
      <div class="relative z-[3] flex w-full items-start">
        <span class="rounded-full bg-[#E0F2FE] px-[14px] py-[6px] font-inter text-[12px] font-semibold leading-[15px] text-[#0369A1]">
          {{default badgeLabel (t 'test.home.alumniSection.bootcampLabel')}}: <span x-text="item.company"></span>
        </span>
      </div>
    </template>
  {{else if courseName}}
    <div class="relative z-[3] flex w-full items-start">
      <span class="rounded-full bg-[#E0F2FE] px-[14px] py-[6px] font-inter text-[12px] font-semibold leading-[15px] text-[#0369A1]">
        {{default badgeLabel (t 'test.home.alumniSection.bootcampLabel')}}: {{courseName}}
      </span>
    </div>
  {{/if}}
</div>

{{else}}
{{!-- ============ VARIANT: STACKED (layout lama) ============ --}}
<div class="w-full {{#if isDesktop}}min-h-[460px] p-5 lg:p-8 bg-gradient-to-b from-[#FFFFFF] to-[#E0F2F9] border-white/60{{else}}bg-white rounded-2xl p-6 shadow-[0px_4px_12px_0px_#00000010] border-white/80{{/if}} flex flex-col transition-all duration-500 border rounded-xl">
  <span class="text-[#0B1F3B] font-serif leading-none select-none {{#if isDesktop}}text-4xl lg:text-6xl mb-2{{else}}text-4xl mb-3{{/if}}">&#10077;</span>

  <p class="{{sizeClass 'body'}} font-inter font-normal text-left flex-1 {{#if isDesktop}}text-[#2D2D2D] mb-4 lg:mb-6 overflow-y-auto{{else}}text-[#2D2D2D] mb-4 line-clamp-4{{/if}}"
     {{#if isDesktop}}x-text="item.testimonial"{{/if}}>
    {{#unless isDesktop}}"{{getByLang message lang}}"{{/unless}}
  </p>

  <div class="w-full h-px {{#if isDesktop}}bg-gray-300/60 mb-4 lg:mb-6{{else}}bg-slate-200/80 mb-4{{/if}}"></div>

  <div class="flex items-center gap-3 {{#if isDesktop}}lg:gap-4{{else}}gap-3.5{{/if}}">
    <img {{#if isDesktop}}:src="item.photo || '/public/image/orang.png'" :alt="item.name"{{else}}src="{{default profile '/public/image/orang.png'}}" alt="{{getByLang name lang}}"{{/if}}
         class="rounded-full object-cover shadow-sm shrink-0 {{#if isDesktop}}size-11 lg:size-14{{else}}size-11{{/if}}"
         onerror="this.onerror=null; this.src='/public/image/orang.png';"/>
    <div class="text-left flex-1">
      <h4 class="{{sizeClass 'h3'}} font-inter font-semibold leading-tight text-[#0B1F3B] {{#if isDesktop}}mb-1{{/if}}"
          {{#if isDesktop}}x-text="item.name"{{/if}}>
        {{#unless isDesktop}}{{getByLang name lang}}{{/unless}}
      </h4>
      <p class="{{sizeClass 'body-sm'}} font-inter font-normal leading-snug text-[#2D2D2D] {{#unless isDesktop}}mt-1{{/unless}}">
        {{#if isDesktop}}
          <span x-text="item.company"></span>
          <template x-if="item.company">
            <span> at <span x-text="item.position"></span></span>
          </template>
        {{else}}
          {{getByLang currentPosition lang}} {{#if courseName}}at {{courseName}}{{/if}}
        {{/if}}
      </p>
    </div>
  </div>
</div>
{{/if}}
