{{!-- 
  Komponen: Card Team (Halaman About)
  Lokasi: src/views/partials/components/about/card_team.hbs
  
  Props:
  - profile     : URL gambar profil
  - name        : Nama anggota tim
  - position    : Jabatan (mendukung HTML/multibahasa)
  - description : Deskripsi pekerjaan (mendukung HTML/multibahasa, hanya muncul di desktop)
  - linkedin    : URL LinkedIn
  - instagram   : URL Instagram
--}}

<div class="w-full bg-[#F0F8FF] sm:bg-[#E0F1F9]/50 sm:backdrop-blur-[6.6px] border border-[#E0F1F9] sm:border-transparent rounded-[20px] sm:rounded-[12px] p-4 lg:px-2.5 lg:py-8 shadow-xs sm:shadow-[0px_0px_6px_0px_rgba(0,0,0,0.5)] flex flex-col items-center text-center justify-between sm:max-w-[344px] sm:min-h-[505px] lg:h-[505px]">
  
  <div class="w-16 h-16 sm:w-[100px] sm:h-[100px] lg:w-[120px] lg:h-[120px] rounded-full overflow-hidden border-2 sm:border-[4px] lg:border-[5px] border-[#9D9D9D] shrink-0 flex items-center justify-center bg-white shadow-xs mb-0 sm:mb-3 lg:mb-7">
    <img src="{{default profile '/public/image/about/orang.png'}}" alt="{{name}}" class="w-[75%] translate-y-[8%]" />
  </div>
  
  <h4 class="font-montserrat font-semibold text-[12px] sm:text-base lg:text-xl leading-none sm:leading-snug text-[#111111] sm:text-[#000000] mt-3 sm:mt-0 mb-1.5 lg:mb-2.5 line-clamp-2 min-h-[28px] sm:min-h-0 flex items-center justify-center tracking-normal">
    {{{name}}}
  </h4>
  
  <p class="font-montserrat font-medium sm:font-normal text-[10px] sm:text-xs lg:text-xl leading-none sm:leading-snug text-[#555555] sm:text-[#000000] mb-3 lg:mb-7 line-clamp-1 sm:line-clamp-none tracking-normal">
    {{{default position 'Specialist Mentor'}}}
  </p>
  
  <p class="hidden sm:block text-[#000000CC] text-xs lg:text-base leading-relaxed lg:leading-7 mb-4 lg:mb-7 font-sans font-normal line-clamp-4 flex-1">
    {{{description}}}
  </p>
  
  <div class="flex items-center justify-center gap-3 mt-auto">
    <a href="{{default linkedin '#'}}" target="_blank" class="w-auto h-auto sm:w-10 sm:h-10 lg:w-[60px] lg:h-[60px] hover:opacity-80 sm:hover:opacity-100 sm:bg-white rounded-full flex items-center justify-center sm:shadow-xs transition-opacity">
      <img src="/public/image/about/team/linkedin.svg" alt="LinkedIn" class="w-3 h-3 sm:w-4 sm:h-4 lg:w-6 lg:h-6 object-contain" />
    </a>
    <a href="{{default instagram '#'}}" target="_blank" class="w-auto h-auto sm:w-10 sm:h-10 lg:w-[60px] lg:h-[60px] hover:opacity-80 sm:hover:opacity-100 sm:bg-white rounded-full flex items-center justify-center sm:shadow-xs transition-opacity">
      <img src="/public/image/about/team/instagram.svg" alt="Instagram" class="w-3 h-3 sm:w-4 sm:h-4 lg:w-6 lg:h-6 object-contain" />
    </a>
  </div>
  
</div>
