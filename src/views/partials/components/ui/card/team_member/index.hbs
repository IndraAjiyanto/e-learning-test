{{!--
  Komponen: Team Member Card (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/card/team_member/index.hbs

  Kartu anggota tim untuk tab Team (Figma 354:805).

  Props:
  - profile     : URL foto
  - name        : nama
  - position    : jabatan (kosong -> "Mentor / Instructor")
  - description  : bio singkat (opsional)
  - linkedin    : URL (default "#")
  - instagram   : URL (default "#")
--}}

<div class="flex flex-col overflow-hidden rounded-3xl border border-[#E2E8F0] bg-white shadow-[0px_4px_20px_0px_rgba(0,0,0,0.03)]">
  <img
    src="{{default profile '/public/image/about/orang.png'}}"
    alt="{{name}}"
    class="aspect-[4/3] w-full object-cover"
    onerror="this.onerror=null;this.src='/public/image/about/orang.png';"
  />
  <div class="flex flex-1 flex-col gap-3 p-5 lg:p-6">
    <div class="flex flex-col gap-0.5">
      <p class="{{sizeClass 'body'}} font-inter font-bold text-[#003060]">{{name}}</p>
      <p class="{{sizeClass 'body-sm'}} font-inter font-semibold text-[#0056B3]">{{#if position}}{{position}}{{else}}{{t 'test.about.team.defaultRole'}}{{/if}}</p>
    </div>
    {{#if description}}
      <p class="{{sizeClass 'body-sm'}} font-inter text-[#475569]">{{description}}</p>
    {{/if}}
    <div class="mt-auto flex items-center gap-3 pt-2">
      <a href="{{default linkedin '#'}}" target="_blank" rel="noopener" class="grid size-10 place-items-center rounded-full bg-[#F3F4F6] transition hover:opacity-80">
        <img src="/public/image/about/team/linkedin.svg" alt="LinkedIn" class="size-5" />
      </a>
      <a href="{{default instagram '#'}}" target="_blank" rel="noopener" class="grid size-10 place-items-center rounded-full bg-[#F3F4F6] transition hover:opacity-80">
        <img src="/public/image/about/team/instagram.svg" alt="Instagram" class="size-5" />
      </a>
    </div>
  </div>
</div>
