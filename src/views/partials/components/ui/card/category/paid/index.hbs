{{!-- 
  Komponen: Card Program (Paid Program)
  Lokasi: src/views/partials/components/ui/card/category/paid/index.hbs

  Card program sesuai desain Figma "Short Classes for You".
  Struktur: image-area -> content (icon-badge + title, tags-row, description, bottom-row).

  Komponen yang digunakan:
  - components/ui/text/badge/index  -> untuk tag pills
  - components/ui/text/link/index   -> untuk link "Explore program"
  - components/ui/button/btn_action/index -> untuk tombol CTA bulat

  Props:
    id          (string)  — ID program untuk link
    image       (string)  — URL gambar program
    defaultImage(string)  — URL fallback gambar jika image kosong
    name        (string)  — Nama program (Inter SemiBold 22px)
    description (string)  — Deskripsi singkat (Inter 14px)
    icon        (string)  — FontAwesome icon class (e.g. "fa-graduation-cap")
    tags        (array)   — Array of tag strings, e.g. ["Language", "Culture", "Career"]
--}}
<div class="group flex h-full w-full max-w-[504px] flex-col overflow-hidden rounded-[24px] border border-[#F3F4F6] bg-white p-4 sm:p-5 shadow-[0px_4px_25px_rgba(0,0,0,0.06)] transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">

  {{!-- image-area --}}
  <div class="relative h-[210px] sm:h-[220px] w-full shrink-0 overflow-hidden rounded-[16px] bg-gray-100">
    {{#if image}}
      <img
        src="{{image}}"
        alt="{{name}}"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        onerror="this.src='{{default defaultImage 'https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=800&auto=format&fit=crop'}}'"
      />
    {{else if defaultImage}}
      <img
        src="{{defaultImage}}"
        alt="{{name}}"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    {{else}}
      <img
        src="https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=800&auto=format&fit=crop"
        alt="{{name}}"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    {{/if}}
  </div>

  {{!-- content --}}
  <div class="flex flex-1 flex-col pt-4 sm:pt-5">

    {{!-- icon-badge + title --}}
    <div class="flex items-center gap-3.5">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#003060] shadow-[0px_4px_14px_rgba(0,48,96,0.2)]">
        <i class="fa-solid {{icon}} text-white" style="font-size: 20px;"></i>
      </div>
      <h3 class="font-inter text-xl sm:text-[22px] font-bold leading-tight text-[#0B1F3B]">
        {{name}}
      </h3>
    </div>

    {{!-- tags-row --}}
    <div class="mt-3.5 flex flex-wrap items-center gap-2">
      {{#each tags}}
        {{> components/ui/text/badge/index
            text=this
            bgColor="bg-white"
            borderColor="border-[#E5E7EB]"
            color="text-[#0B1F3B]"
            shadowClass="shadow-none"
            fontWeight="font-semibold"
            textSize="text-xs"
            class="!px-3 !py-1 !rounded-full !text-[#0B1F3B]"
        }}
        {{#unless @last}}
          <span class="select-none font-inter text-xs font-semibold leading-none text-[#9CA3AF]">·</span>
        {{/unless}}
      {{/each}}
    </div>

    {{!-- description --}}
    <p class="mt-3 line-clamp-3 w-full font-inter text-sm font-normal leading-[160%] text-[#6B7280]">
      {{description}}
    </p>

    {{!-- bottom-row --}}
    <div class="mt-auto flex w-full items-center justify-between pt-6">
      {{> components/ui/text/link/index
          text=(default (t 'test.categoryPaidProgram.program.explore') 'Explore program')
          href=(ternary (and id (ne id "#")) (concat "/program/" id) "#programs")
          color="text-[#003060]"
          weight="semibold"
          size="text-sm"
          font="font-inter"
          class="hover:underline"
      }}
      {{> components/ui/button/btn_action/index
          href=(ternary (and id (ne id "#")) (concat "/program/" id) "#programs")
          icon="fa-solid fa-arrow-right text-sm"
          text=""
          variant="primary"
          class="!rounded-full !w-10 !h-10 sm:!w-11 sm:!h-11 !p-0 !shadow-[0px_4px_14px_rgba(0,48,96,0.25)] hover:scale-105 active:scale-95 transition-transform"
      }}
    </div>

  </div>
</div>
