{{!-- 
  Komponen: Card Program (Paid Program)
  Lokasi: src/views/partials/components/ui/card/category/paid/index.hbs

  Card program sesuai desain Figma "Short Classes for You".
  Struktur: image-area -> content (icon-badge + title, tags-row, description, bottom-row).

  Komponen yang digunakan:
  - components/ui/text/badge/index  -> untuk tag pills
  - components/ui/text/link/index   -> untuk link "Explore program"
  - components/ui/button/btn_action/index -> untuk tombol CTA bulat

  Props:
    id          (string)  — ID program untuk link
    image       (string)  — URL gambar program
    name        (string)  — Nama program (Inter SemiBold 22px)
    description (string)  — Deskripsi singkat (Inter 14px)
    icon        (string)  — FontAwesome icon class (e.g. "fa-graduation-cap")
    tags        (array)   — Array of tag strings, e.g. ["Language", "Culture", "Career"]
--}}
<div class="group flex w-full max-w-[504px] flex-col items-start overflow-hidden rounded-2xl bg-white shadow-[0px_6px_18px_-6px_rgba(0,0,0,0.05)] transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">

  {{!-- image-area --}}
  <div class="w-full rounded-t-2xl bg-white p-4 pb-0">
    <div class="relative h-[224px] w-full overflow-hidden rounded-xl bg-gray-100">
      {{#if image}}
        <img
          src="{{image}}"
          alt="{{name}}"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          onerror="this.src='https://images.unsplash.com/photo-1516321497487-e288fb19713f?q=80&w=800&auto=format&fit=crop'"
        />
      {{else}}
        <div class="flex h-full w-full flex-col items-center justify-center text-[#6EB6E5]/70">
          <i class="fa-solid fa-image mb-2 text-[40px]"></i>
          <span class="text-[13px] font-semibold tracking-wide">No Image Available</span>
        </div>
      {{/if}}
    </div>
  </div>

  {{!-- content --}}
  <div class="flex w-full flex-1 flex-col items-start gap-3 p-4">

    {{!-- icon-badge + title --}}
    <div class="flex items-center gap-[15px]">
      <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-[#003060] shadow-[0px_6px_16px_-6px_rgba(0,0,0,0.08)]">
        <i class="fa-solid {{icon}} text-white" style="font-size: 22px;"></i>
      </div>
      <h3 class="font-inter text-[22px] font-semibold leading-[120%] text-[#0B1F3B]">
        {{name}}
      </h3>
    </div>

    {{!-- tags-row --}}
    <div class="flex flex-wrap items-center gap-2">
      {{#each tags}}
        {{> components/ui/text/badge/index
            text=this
            size="sm"
            bgColor="bg-white"
            borderColor="border-[#E5E7EB]"
            color="dark"
            shadowClass="shadow-none"
            fontWeight="font-semibold"
            textSize="text-xs"
            class="!px-2.5 !py-1.5 !rounded-full"
        }}
        {{#unless @last}}
          <span class="font-inter text-xs leading-[15px] text-[#9CA3AF]">·</span>
        {{/unless}}
      {{/each}}
    </div>

    {{!-- description --}}
    <p class="line-clamp-2 w-full font-inter text-sm font-normal leading-[170%] text-[#6B7280]">
      {{description}}
    </p>

    {{!-- bottom-row --}}
    <div class="mt-auto flex w-full items-center justify-between pt-1">
      {{> components/ui/text/link/index
          text="Explore program"
          href=(concat "/program/" id)
          color="text-[#003060]"
          weight="semibold"
          size="text-[13px]"
          font="font-inter"
      }}
      {{> components/ui/button/btn_action/index
          href=(concat "/program/" id)
          icon="fa-solid fa-arrow-right text-sm"
          text=""
          variant="primary"
          class="!rounded-full !w-10 !h-10 !p-0 !shadow-[0px_8px_18px_-8px_rgba(0,0,0,0.15)]"
      }}
    </div>

  </div>
</div>
