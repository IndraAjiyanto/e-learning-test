{{!-- 
  Komponen: Card Program (Responsive)
  Lokasi: src/views/partials/components/ui/card/card_program/index.hbs
  
  Props:
  - image   : URL gambar kursus
  - name    : Nama kursus
  - text    : Deskripsi kursus (string)
  - lang    : Bahasa aktif (string)
  
  Refactored: Menggabungkan mobile + desktop menjadi satu template responsif (sm: breakpoint)
--}}

<div class="
  group flex w-full flex-col overflow-hidden rounded-2xl border border-[#D9D9D9] bg-white shadow-[0px_4px_12px_rgba(0,0,0,0.06)]
  sm:mx-auto sm:h-full sm:min-h-[552px] sm:w-[433px] sm:rounded-xl sm:border-2 sm:border-white/10 sm:bg-[#F5F5F5]/50 sm:backdrop-blur-[6.6px] sm:shadow-[0px_0px_4px_rgba(0,0,0,0.25)]
">
  <img src="{{image}}" alt="{{name}}" class="w-full object-cover h-[190px] sm:h-[278px]" />
  
  <div class="flex flex-col flex-1 p-5 sm:p-6 gap-2.5 sm:gap-0 sm:card-body">
    <h3 class="font-montserrat text-[#0B1F3B] text-left
      font-bold sm:font-[600]
      text-[20px] sm:text-4xl
      sm:mb-2
    ">
      {{name}}
    </h3>
    
    <p class="font-sans text-left flex-1
      font-normal sm:font-[400]
      text-[13px] sm:text-base
      leading-[20px] sm:leading-[30px]
      text-[#2D2D2D] sm:text-black/80
      mb-2 sm:mb-4
    ">
      {{getByLang text lang}}
    </p>
    
    <div class="mt-auto flex items-center pt-2 sm:pt-0 border-t border-slate-100 sm:border-0
      justify-between sm:justify-end
      sm:card-actions
    ">
      <a href="/category/program/{{name}}" class="font-montserrat font-bold text-[14px] text-[#003060] flex items-center gap-1.5 hover:underline sm:hidden">
        Learn More
      </a>
      
      <a href="/category/program/{{name}}" class="rounded-full bg-[#003060] text-white flex items-center justify-center shadow-sm shrink-0 hover:bg-[#001f3f] transition-colors w-9 h-9 sm:w-[50px] sm:h-[50px]">
        <i class="fas fa-arrow-right text-xs sm:text-sm"></i>
      </a>
    </div>
  </div>
</div>
