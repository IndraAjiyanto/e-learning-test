{{!--
  Komponen: Card Program (Responsive)
  Lokasi: src/views/partials/components/ui/card/card_program/index.hbs
  Level: L1 Atomik

  Props:
  - image     : string (URL gambar program, wajib)
  - name      : string (nama program, wajib)
  - text      : string|{en,id,ja} (deskripsi program, wajib — dirender via getByLang)
  - lang      : string (bahasa aktif, wajib bila text multibahasa)
  - learnMore : string (opsional, label link footer, default "Learn More")

  Desktop mengikuti Figma "program-card" (286:3525) — kartu putih, border #E5E7EB,
  radius 16px, gambar 220px, footer bergaris dengan link Learn More.
  Mobile tetap memakai layout ringkas frame "Choose Your Program".
--}}

<div
  class="
    group flex w-full flex-col overflow-hidden rounded-2xl border border-[#D9D9D9] bg-white shadow-[0px_4px_12px_rgba(0,0,0,0.06)]
    sm:h-full sm:min-h-[442px] sm:justify-between sm:rounded-[16px] sm:border-[#E5E7EB] sm:shadow-none
    sm:transition-all sm:duration-300 sm:hover:-translate-y-1 sm:hover:shadow-[0px_12px_28px_rgba(11,31,59,0.10)]
  "
>
  <div class="flex flex-col">
    <img
      src="{{image}}"
      alt="{{name}}"
      class="w-full object-cover h-[190px] sm:h-[220px]"
    />

    <div class="flex flex-col p-5 sm:p-[24px] gap-2.5 sm:gap-[12px]">
      <h3 class="font-montserrat text-left text-[#0B1F3B] font-bold sm:font-semibold text-[20px] sm:text-[22px] sm:leading-normal">
        {{name}}
      </h3>

      <p class="font-sans text-left font-normal text-[13px] sm:text-[14px] leading-[20px] sm:leading-[1.5] text-[#2D2D2D] sm:text-[#4A5568]">
        {{default (getByLang text lang) text}}
      </p>
    </div>
  </div>

  <!-- card-footer (286:3532) -->
  <div class="mt-auto flex items-center justify-end px-5 pb-5 pt-2 sm:p-[24px] border-t border-slate-100 sm:border-[#F3F4F6]">
    <!-- learn-more (286:3538) -->
    {{> components/ui/text/link/index
      text=(default learnMore 'Learn More')
      href=(concat '/category/program/' name)
      font="font-montserrat"
      weight="semibold"
      color="text-[#003060]"
      size="text-[12px] sm:text-[13px]"
      icon="fas fa-arrow-right"
    }}
  </div>
</div>
