{{!-- 
  Komponen: Card Alumni (Khusus Halaman Home - Mobile)
  Lokasi: src/views/partials/components/ui/card_alumni.hbs
  
  Props:
  - message         : Teks ulasan/testimonial (multibahasa)
  - profile         : URL gambar profil (opsional, fallback ke orang.png)
  - name            : Nama alumni (multibahasa)
  - currentPosition : Jabatan/posisi (multibahasa)
  - courseName      : Nama kursus/program yang diikuti (opsional)
  - lang            : Bahasa yang aktif
--}}

<div class="w-full {{#if isDesktop}}h-[460px] sm:h-[500px] md:h-[559.45px] p-5 sm:p-6 md:p-8 bg-gradient-to-b from-[#FFFFFF] to-[#E0F2F9] border-white/60{{else}}bg-white rounded-[16px] p-6 shadow-[0px_4px_12px_0px_#00000010] border-white/80{{/if}} flex flex-col transition-all duration-500 border"
     {{#if isDesktop}}
       :class="isCenter(index) ? 'rounded-xl sm:rounded-[13.24px]' : 'rounded-xl sm:rounded-[12px]'"
     {{/if}}>
  <span class="text-[#0B1F3B] font-serif leading-none select-none {{#if isDesktop}}text-[40px] sm:text-[50px] md:text-[60px] mb-2{{else}}text-4xl mb-3{{/if}}">❝</span>
  
  <p class="font-sans font-normal text-left flex-1 {{#if isDesktop}}text-[#2D2D2D] sm:text-[#333333] sm:font-[400] text-[14px] sm:text-[16px] md:text-[19.86px] leading-[22px] sm:leading-[28px] md:leading-[33.1px] mb-4 sm:mb-6 overflow-y-auto{{else}}text-[14px] leading-[22px] text-[#2D2D2D] mb-4 line-clamp-4{{/if}}"
     {{#if isDesktop}}x-text="item.testimonial"{{/if}}>
    {{#unless isDesktop}}"{{getByLang message lang}}"{{/unless}}
  </p>
  
  <div class="w-full h-px {{#if isDesktop}}bg-gray-300/60 mb-4 sm:mb-6{{else}}bg-slate-200/80 mb-4{{/if}}"></div>
  
  <div class="flex items-center gap-3 {{#if isDesktop}}sm:gap-4{{else}}gap-3.5{{/if}}">
    <img {{#if isDesktop}}:src="item.photo" :alt="item.name"{{else}}src="{{default profile '/public/image/orang.png'}}" alt="{{getByLang name lang}}"{{/if}} 
         class="rounded-full object-cover shadow-sm shrink-0 {{#if isDesktop}}w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14{{else}}w-11 h-11{{/if}}" 
         onerror="this.onerror=null; this.src='/public/image/orang.png';"/>
    <div class="text-left flex-1">
      <h4 class="font-montserrat font-semibold leading-none text-[#0B1F3B] {{#if isDesktop}}sm:font-[600] sm:text-[#000000] text-[16px] sm:text-[18px] md:text-[22.07px] mb-1{{else}}text-[14px]{{/if}}"
          {{#if isDesktop}}x-text="item.name"{{/if}}>
        {{#unless isDesktop}}{{getByLang name lang}}{{/unless}}
      </h4>
      <p class="font-sans font-normal leading-snug text-[#2D2D2D] {{#if isDesktop}}sm:font-[400] sm:text-[#000000]/80 text-[12px] sm:text-[14px] md:text-[18px]{{else}}text-[12px] leading-[16px] mt-1{{/if}}">
        {{#if isDesktop}}
          <span x-text="item.company"></span>
          <template x-if="item.company">
            <span> at <span x-text="item.position"></span></span>
          </template>
        {{else}}
          {{getByLang currentPosition lang}} {{#if courseName}}at {{courseName}}{{/if}}
        {{/if}}
      </p>
    </div>
  </div>
</div>
