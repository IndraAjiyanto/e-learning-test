{{!--
  Komponen: Icon Stepper (Level 2 - Molekul)
  Lokasi: src/views/partials/components/ui/stepper/icon_stepper/index.hbs

  Stepper navigasi berbasis ikon dan teks 2 baris dengan garis penghubung putus-putus.

  Props:
  - currentStep : number (opsional, default: 1)
  - class       : string (opsional, class tambahan wrapper)
--}}

<div class="relative w-full max-w-5xl mx-auto mb-10 md:mb-16 z-0 {{class}}">
  <!-- Dashed Connecting Line -->
  <div class="absolute left-6 right-6 md:left-12 md:right-12 top-6 -translate-y-1/2 border-t-2 border-dashed border-[#E5E7EB] z-0"></div>

  <!-- Stepper Nodes Container -->
  <div class="relative flex items-start justify-between w-full z-10">

    <!-- Node 1: Your Information -->
    <div class="step-indicator flex flex-col items-center text-center cursor-default group max-w-[140px] sm:max-w-[200px] md:max-w-[260px] w-full" data-step="1">
      <div
        class="step-circle flex items-center justify-center size-12 rounded-full transition-all duration-300 bg-[#1A56DB] border-4 border-white shadow-[0px_4px_8px_rgba(26,86,219,0.14)]"
      >
        <i class="step-icon fa-solid fa-user text-lg text-white transition-colors duration-300"></i>
      </div>
      <div class="mt-3 flex flex-col items-center">
        <span class="step-title font-inter font-bold text-xs sm:text-sm md:text-base text-[#1A56DB] transition-colors duration-300">
          Your Information
        </span>
        <span class="step-subtitle font-inter font-normal text-[11px] sm:text-xs md:text-[13px] text-[#6B7280] transition-colors duration-300 mt-0.5">
          Enter details
        </span>
      </div>
    </div>

    <!-- Node 2: Payment -->
    <div class="step-indicator flex flex-col items-center text-center cursor-default group max-w-[140px] sm:max-w-[200px] md:max-w-[260px] w-full" data-step="2">
      <div
        class="step-circle flex items-center justify-center size-12 rounded-full transition-all duration-300 bg-white border-2 border-[#E5E7EB] shadow-[0px_2px_4px_rgba(0,0,0,0.02)]"
      >
        <i class="step-icon fa-regular fa-credit-card text-lg text-[#9CA3AF] transition-colors duration-300"></i>
      </div>
      <div class="mt-3 flex flex-col items-center">
        <span class="step-title font-inter font-semibold text-xs sm:text-sm md:text-base text-[#6B7280] transition-colors duration-300">
          Payment
        </span>
        <span class="step-subtitle font-inter font-normal text-[11px] sm:text-xs md:text-[13px] text-[#9CA3AF] transition-colors duration-300 mt-0.5">
          Tuition fees
        </span>
      </div>
    </div>

    <!-- Node 3: Confirmation -->
    <div class="step-indicator flex flex-col items-center text-center cursor-default group max-w-[140px] sm:max-w-[200px] md:max-w-[260px] w-full" data-step="3">
      <div
        class="step-circle flex items-center justify-center size-12 rounded-full transition-all duration-300 bg-white border-2 border-[#E5E7EB] shadow-[0px_2px_4px_rgba(0,0,0,0.02)]"
      >
        <i class="step-icon fa-regular fa-circle-check text-lg text-[#9CA3AF] transition-colors duration-300"></i>
      </div>
      <div class="mt-3 flex flex-col items-center">
        <span class="step-title font-inter font-semibold text-xs sm:text-sm md:text-base text-[#6B7280] transition-colors duration-300">
          Confirmation
        </span>
        <span class="step-subtitle font-inter font-normal text-[11px] sm:text-xs md:text-[13px] text-[#9CA3AF] transition-colors duration-300 mt-0.5">
          Activate account
        </span>
      </div>
    </div>

  </div>
</div>
