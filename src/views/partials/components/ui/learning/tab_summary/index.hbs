{{!--
  Komponen: Ringkasan Tab Belajar — L2 Section
  Lokasi: src/views/partials/components/ui/learning/tab_summary/index.hbs

  Cincin persentase di kiri, satu kalimat keadaan, lalu beberapa hitungan di
  bawahnya. Idenya diambil dari blok ringkasan pada halaman belajar bisa.ai:
  sebelum daftar panjangnya, student melihat dulu berapa yang sudah beres.
  Warna dan bentuknya memakai token kita sendiri, bukan meniru tampilannya.

  Cincinnya SVG biasa dengan stroke-dasharray, jadi tidak perlu pustaka apa pun.

  Props:
  - percent : number 0..100 (wajib)
  - label   : string (wajib) — kalimat utama, mis. "3 dari 6 sesi dihadiri"
  - hint    : string (opsional) — kalimat kedua
  - aria    : string (opsional) — nama untuk pembaca layar
  - items   : array (opsional) — [{ label, value, tone }] dengan tone:
              'navy' | 'green' | 'amber' | 'red' | 'grey'

  Contoh:
    {{> components/ui/learning/tab_summary/index
        percent=stats.sessions.percent
        label='3 of 6 sessions attended'
        items=(array (obj 'label' 'Total' 'value' 6 'tone' 'navy')) }}
--}}
<div class="mb-6 rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-6">
  <div class="flex flex-col gap-5 rounded-lg bg-[#FAFAFA] p-5 sm:flex-row sm:items-center">
    <div
      class="relative grid size-24 shrink-0 place-items-center"
      role="progressbar"
      aria-label="{{default aria label}}"
      aria-valuenow="{{percent}}"
      aria-valuemin="0"
      aria-valuemax="100"
    >
      <svg viewBox="0 0 36 36" class="size-24 -rotate-90" aria-hidden="true">
        <circle cx="18" cy="18" r="15.915" fill="none" stroke="#E5E5E5" stroke-width="3"></circle>
        <circle cx="18" cy="18" r="15.915" fill="none" stroke="#22C55E" stroke-width="3" stroke-linecap="round" stroke-dasharray="{{percent}} 100"></circle>
      </svg>
      <span class="absolute font-inter text-lg font-bold text-[#003060]">{{percent}}%</span>
    </div>

    <div class="min-w-0 flex-1">
      <p class="font-inter text-base font-bold text-[#171717]">{{label}}</p>
      {{#if hint}}
        <p class="mt-0.5 font-inter text-sm text-[#737373]">{{hint}}</p>
      {{/if}}

      {{#if items.length}}
        <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3">
          {{#each items}}
            <span class="inline-flex items-center gap-2">
              <span
                class="grid size-8 shrink-0 place-items-center rounded-lg
                  {{#if (eq this.tone 'green')}}bg-[#f0fdf4] text-[#15803d]
                  {{else if (eq this.tone 'amber')}}bg-[#FEFCE8] text-[#A16207]
                  {{else if (eq this.tone 'red')}}bg-[#FEF2F2] text-[#B42318]
                  {{else if (eq this.tone 'grey')}}bg-[#F5F5F5] text-[#737373]
                  {{else}}bg-[#E4F1F7] text-[#003060]{{/if}}"
              >
                <i
                  class="text-xs fa-solid
                    {{#if (eq this.tone 'green')}}fa-circle-check
                    {{else if (eq this.tone 'amber')}}fa-clock
                    {{else if (eq this.tone 'red')}}fa-circle-xmark
                    {{else}}fa-list{{/if}}"
                ></i>
              </span>
              <span class="font-inter text-xs text-[#737373]">
                {{this.label}}
                <span class="block font-inter text-sm font-bold text-[#171717]">{{this.value}}</span>
              </span>
            </span>
          {{/each}}
        </div>
      {{/if}}
    </div>
  </div>
</div>
