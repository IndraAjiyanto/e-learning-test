{{!--
  Komponen: Assignment Page - Submission (kartu kiriman)
  Lokasi: src/views/partials/components/ui/learning/assignment_page/submission/index.hbs
  Level: L3 Section

  Kolom kanan halaman assignment: judul kolom lalu kartu kiriman. Kerangka kartu
  ini sama untuk tugas mingguan dan final assignment; yang berbeda hanya isinya
  (daftar jawaban + form ubah, atau satu kiriman + catatan mentor + form kirim).

  Lebarnya tidak ditetapkan di sini. Kolom ini mengisi sisa baris workspace di
  sebelah kartu brief 912px, jadi lebarnya ikut berubah kalau kartu brief
  diubah.

  Props:
  - heading : string (wajib) judul kolom, mis. "Jawabanmu"

  Isi dikirim lewat block:
    {{#> components/ui/learning/assignment_page/submission/index
          heading=(t 'test.assigment.yourAnswer') }}
      ...isi kartu kiriman...
    {{/components/ui/learning/assignment_page/submission/index}}
--}}
  <div class="flex flex-col items-start gap-[24px] w-full min-w-0 2xl:w-auto 2xl:flex-1">

    {{!-- heading --}}
    <h2 class="w-full font-bold text-[20px] leading-[26px] sm:text-[24px] sm:leading-[30px] text-[#0F172A]" style="font-family:'Schibsted Grotesk',sans-serif;">
      {{heading}}
    </h2>

    {{!-- submission-card --}}
    <div class="w-full flex flex-col items-start p-[20px] sm:p-[32px] gap-[24px] bg-white border border-[#E2E8F0] shadow-[0px_12px_24px_rgba(15,23,42,0.039)] rounded-[24px]">
    {{> @partial-block}}
  </div>
</div>
