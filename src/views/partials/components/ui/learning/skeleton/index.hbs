{{!--
  Komponen: Skeleton area belajar — L2 Section
  Lokasi: src/views/partials/components/ui/learning/skeleton/index.hbs

  Penahan tempat untuk panel Start Learning selama fragmennya diambil.

  Sebelumnya wadahnya berupa <div> kosong yang diisi tulisan "Loading..."
  setinggi ~120px, lalu diganti isi sebenarnya setinggi ~1026px. Selisih itulah
  yang terlihat sebagai halaman melompat sesudah menekan View Program.

  Ukurannya sengaja meniru tata letak sungguhan yang sudah diukur di browser:
  kartu kepala ~166px, kolom kanan ~752px. Jadi tinggi totalnya sudah mendekati
  isi akhirnya dan hampir tidak ada yang bergeser saat isinya datang.

  Dipakai dua kali: dirender langsung di dalam wadah (supaya gambar pertama
  sudah punya tinggi) dan disalin ulang oleh loadCourseFragment sebelum tiap
  pengambilan berikutnya.
--}}
<div class="p-4 sm:px-[34px] sm:py-[42px]" aria-hidden="true">
  {{!-- Kartu kepala: judul, satu baris keterangan, bar kemajuan. --}}
  <div class="mb-6 animate-pulse rounded-xl border border-[#E5E5E5] bg-white p-5 sm:p-6">
    <div class="h-7 w-52 rounded bg-[#EEF2F6]"></div>
    <div class="mt-3 h-4 w-72 rounded bg-[#EEF2F6]"></div>
    <div class="mt-6 h-2 w-full rounded-full bg-[#EEF2F6]"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
    {{!-- Kolom kiri: baris minggu. --}}
    <div class="min-w-0 space-y-4">
      <div class="animate-pulse rounded-xl border border-[#E5E5E5] bg-white px-5 py-4">
        <div class="flex items-center gap-3">
          <div class="size-9 shrink-0 rounded-lg bg-[#EEF2F6]"></div>
          <div class="min-w-0 flex-1">
            <div class="h-4 w-40 rounded bg-[#EEF2F6]"></div>
            <div class="mt-2 h-3 w-28 rounded bg-[#EEF2F6]"></div>
          </div>
        </div>
      </div>
      <div class="animate-pulse rounded-xl border border-[#E5E5E5] bg-white px-5 py-4">
        <div class="flex items-center gap-3">
          <div class="size-9 shrink-0 rounded-lg bg-[#EEF2F6]"></div>
          <div class="min-w-0 flex-1">
            <div class="h-4 w-32 rounded bg-[#EEF2F6]"></div>
            <div class="mt-2 h-3 w-24 rounded bg-[#EEF2F6]"></div>
          </div>
        </div>
      </div>
      <div class="animate-pulse rounded-xl border border-[#E5E5E5] bg-white px-5 py-4">
        <div class="flex items-center gap-3">
          <div class="size-9 shrink-0 rounded-lg bg-[#EEF2F6]"></div>
          <div class="min-w-0 flex-1">
            <div class="h-4 w-36 rounded bg-[#EEF2F6]"></div>
            <div class="mt-2 h-3 w-20 rounded bg-[#EEF2F6]"></div>
          </div>
        </div>
      </div>
    </div>

    {{!-- Kolom kanan: kartu program. --}}
    <div class="animate-pulse overflow-hidden rounded-xl border border-[#E5E5E5] bg-white">
      <div class="h-[160px] w-full bg-[#EEF2F6]"></div>
      {{!-- space-y-4, bukan space-y-3: diukur di browser, kartu sungguhan
           ~20px lebih tinggi dari skeleton versi rapat. --}}
      <div class="space-y-4 p-5">
        <div class="h-5 w-24 rounded-full bg-[#EEF2F6]"></div>
        <div class="h-5 w-44 rounded bg-[#EEF2F6]"></div>
        <div class="h-3 w-full rounded bg-[#EEF2F6]"></div>
        <div class="h-3 w-4/5 rounded bg-[#EEF2F6]"></div>
        <div class="space-y-2 pt-2">
          <div class="h-3 w-20 rounded bg-[#EEF2F6]"></div>
          <div class="h-11 w-full rounded-lg bg-[#EEF2F6]"></div>
          <div class="h-11 w-full rounded-lg bg-[#EEF2F6]"></div>
          <div class="h-11 w-full rounded-lg bg-[#EEF2F6]"></div>
        </div>
        <div class="space-y-2 border-t border-[#E5E5E5] pt-4">
          <div class="h-3 w-24 rounded bg-[#EEF2F6]"></div>
          <div class="h-11 w-full rounded-lg bg-[#EEF2F6]"></div>
          <div class="h-11 w-full rounded-lg bg-[#EEF2F6]"></div>
        </div>
        <div class="space-y-2 border-t border-[#E5E5E5] pt-4">
          <div class="h-11 w-full rounded-lg bg-[#EEF2F6]"></div>
          <div class="h-11 w-full rounded-lg bg-[#EEF2F6]"></div>
        </div>
      </div>
    </div>
  </div>
</div>
