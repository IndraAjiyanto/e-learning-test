{{!--
  Komponen: Transaction Detail / Payment Proof Modal
  Lokasi: src/views/partials/components/ui/modal/transaction_detail/index.hbs
  Level: L2 Molekul (reusable modal)

  Tampilan modal View Detail sesuai 100% token CSS all layer & Stitch LMS Kesatria UI Viewer:
  - Header: 76px #003060, judul "Payment Proof", icon file 18px & close button 36x36px
  - Invoice Viewer: Background #F6F8FB, padding 24px 32px
  - Subheader: "Invoice Image" & Tombol "Download" (116x31px)
  - Invoice Image Card: Background #FFFFFF, border 1px solid #D8E6F6, radius 16px, padding 20px 24px
  - Status Badge ("Accepted" #16A34A bg #EDFAF3) & Invoice Number (Inter 700 15px #173B68)
  - Info Grid: 2 kolom (Name, Email, Phone, Xendit Link | Program Name, Program Category, Keyword)
  - Summary: Harga (Inter 13px #173B68), Discount (Inter 13px #EF4444), Total (Inter 700 15px #173B68)
--}}

<script>
  window.openTransactionDetailModal = function(row) {
    window.dispatchEvent(
      new CustomEvent('transaction-detail:open', { detail: row })
    );
  };

  function transactionDetailModal() {
    return {
      open: false,
      row: null,

      _originalTitle: null,

      show(row) {
        if (!row) return;
        this.row = row;
        this.open = true;
        this.showReupload = false;
        this.reuploadFile = null;
        this.downloadingInvoice = false;
        this.activeManualMonth = null;
        if (!this._originalTitle) {
          this._originalTitle = document.title;
        }
        const cleanNo = String(this.invoiceNumber || '')
          .trim()
          .replace(/[^a-zA-Z0-9._-]/g, '_')
          .replace(/_+/g, '_')
          .replace(/^_+|_+$/g, '');
        if (cleanNo && cleanNo !== '—') {
          document.title = cleanNo;
        }
        document.body.classList.add('overflow-hidden');
        this.init();
      },

      close() {
        if (!this.open) return;
        this.open = false;
        this.row = null;
        if (this._originalTitle) {
          document.title = this._originalTitle;
          this._originalTitle = null;
        }
        document.body.classList.remove('overflow-hidden');
      },

      get userName() {
        return this.row?.userName || '—';
      },

      get userEmail() {
        return this.row?.userEmail || '—';
      },

      get userPhone() {
        return this.row?.userPhone || '—';
      },

      get xenditUrl() {
        return this.row?.paymentLink || '';
      },

      get programName() {
        return this.row?.courseName || '—';
      },

      get programCategory() {
        return this.row?.categoryName || 'General';
      },

      get rowKeyword() {
        if (this.row?.keyword) return this.row.keyword;
        if (this.row?.kind === 'installment') return '{{t "test.transactionDetail.installmentPlan"}}';
        return '—';
      },

      get rawStatus() {
        return String(this.row?.status || this.row?.process || '').toLowerCase().trim();
      },

      get isPaid() {
        return ['paid', 'approved', 'success', 'settlement', 'completed'].includes(this.rawStatus);
      },

      get isRejected() {
        return ['failed', 'rejected', 'expired', 'cancelled'].includes(this.rawStatus);
      },

      get statusBadgeText() {
        if (this.isPaid) return '{{t "test.transactionDetail.statusPaid"}}';
        if (this.isRejected) return '{{t "test.transactionDetail.statusRejected"}}';
        return this.row?.statusLabel || '{{t "test.transactionDetail.statusPending"}}';
      },

      get statusBadgeBg() {
        if (this.isRejected) return 'bg-[#FFDADA]';
        if (this.isPaid) return 'bg-[#EDFAF3]';
        return 'bg-[#FFF0C7]';
      },

      get statusTextColor() {
        if (this.isRejected) return 'text-[#D9333F]';
        if (this.isPaid) return 'text-[#16A34A]';
        return 'text-[#E99A0C]';
      },

      get statusDotBg() {
        if (this.isRejected) return 'bg-[#D9333F]';
        if (this.isPaid) return 'bg-[#22C55E]';
        return 'bg-[#E99A0C]';
      },

      get invoiceNumber() {
        return this.row?.no || '—';
      },

      get invoiceDateFormatted() {
        const raw = this.row?.invoiceDate || this.row?.createdAt || this.row?.date;
        if (!raw) return '—';
        const d = new Date(raw);
        if (Number.isNaN(d.getTime())) return '—';
        return d.toLocaleDateString('id-ID', {
          day: '2-digit',
          month: 'long',
          year: 'numeric',
        });
      },

      get paymentDateFormatted() {
        if (this.row?.status !== 'paid') return '—';
        const raw = this.row?.paidAt || this.row?.date;
        if (!raw) return '—';
        const d = new Date(raw);
        if (Number.isNaN(d.getTime())) return '—';
        const datePart = d.toLocaleDateString('id-ID', {
          day: '2-digit',
          month: 'long',
          year: 'numeric',
        });
        const timePart = d.toLocaleTimeString('id-ID', {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
        });
        return `${datePart}, ${timePart} WIB`;
      },

      get priceFormatted() {
        const val = this.row?.price !== undefined && this.row?.price !== null
          ? Number(this.row.price)
          : (this.row?.originalPrice ? Number(this.row.originalPrice) : null);
        if (val !== null && val > 0) {
          return 'Rp ' + val.toLocaleString('id-ID');
        }
        return '—';
      },

      get promoPriceFormatted() {
        const val = this.row?.promo !== undefined && this.row?.promo !== null
          ? Number(this.row.promo)
          : (this.row?.promoPrice !== undefined && this.row?.promoPrice !== null ? Number(this.row.promoPrice) : null);
        if (val !== null && val > 0) {
          return 'Rp ' + val.toLocaleString('id-ID');
        }
        return '—';
      },

      get discountFormatted() {
        const disc = Number(this.row?.discount ?? 0);
        if (disc > 0) {
          return '- Rp ' + disc.toLocaleString('id-ID');
        }
        return 'Rp 0';
      },

      get promoCodeFormatted() {
        const disc = Number(this.row?.promoCode ?? 0);
        if (disc > 0) {
          return '- Rp ' + disc.toLocaleString('id-ID');
        }
        return 'Rp 0';
      },

      get finalTotalFormatted() {
        // Sesuai aturan task: Data "total" di ambil dari table invoice column "subtotal"
        const total = this.row?.subtotal !== undefined && this.row?.subtotal !== null
          ? Number(this.row.subtotal)
          : (this.row?.total !== undefined && this.row?.total !== null
              ? Number(this.row.total)
              : (this.row?.finalTotal !== undefined && this.row?.finalTotal !== null ? Number(this.row.finalTotal) : (this.row?.amount ? Number(this.row.amount) : 0)));
        return 'Rp ' + total.toLocaleString('id-ID');
      },

      get originalPriceFormatted() {
        const orig = Number(this.row?.originalPrice || 0);
        const sub  = Number(this.row?.subtotal || 0);
        if (orig > 0 && sub > 0 && orig > sub) {
          return 'Rp ' + orig.toLocaleString('id-ID');
        }
        return null;
      },

      get subtotalFormatted() {
        if (this.row?.subtotal !== undefined && this.row?.subtotal !== null) {
          return 'Rp ' + Number(this.row.subtotal).toLocaleString('id-ID');
        }
        if (this.row?.amount !== undefined && this.row?.amount !== null) {
          return 'Rp ' + Number(this.row.amount).toLocaleString('id-ID');
        }
        return 'Rp 0';
      },


      get totalFormatted() {
        if (this.row?.amount !== undefined && this.row?.amount !== null) {
          return 'Rp ' + Number(this.row.amount).toLocaleString('id-ID') + ',00';
        }
        return 'Rp 0,00';
      },

      downloadingInvoice: false,

      async loadInvoicePdfLib() {
        if (window.downloadInvoicePdf) return window.downloadInvoicePdf;
        return new Promise((resolve, reject) => {
          const script = document.createElement('script');
          script.src = '/public/assets/invoice-pdf.bundle.js?v=10';
          script.onload = () => resolve(window.downloadInvoicePdf);
          script.onerror = () => reject(new Error('Failed to load invoice-pdf bundle'));
          document.head.appendChild(script);
        });
      },

      printInvoice() {
        const originalTitle = this._originalTitle || document.title;
        const cleanNo = String(this.invoiceNumber || '')
          .trim()
          .replace(/[^a-zA-Z0-9._-]/g, '_')
          .replace(/_+/g, '_')
          .replace(/^_+|_+$/g, '');
        if (cleanNo && cleanNo !== '—') {
          document.title = cleanNo;
        }
        const restore = () => {
          if (!this.open) {
            document.title = originalTitle;
          }
          window.removeEventListener('afterprint', restore);
        };
        window.addEventListener('afterprint', restore);
        window.print();
        setTimeout(restore, 2000);
      },

      async downloadInvoice() {
        if (this.downloadingInvoice) return;
        const element = document.getElementById('invoice-printable-card');
        if (!element) return;

        try {
          this.downloadingInvoice = true;
          const downloadFn = await this.loadInvoicePdfLib();
          if (typeof downloadFn === 'function') {
            await downloadFn('invoice-printable-card', this.invoiceNumber);
          } else {
            throw new Error('downloadInvoicePdf is not available');
          }
        } catch (error) {
          console.error('Download invoice PDF error:', error);
          alert('Gagal mengunduh invoice PDF secara otomatis. Silakan coba kembali.');
        } finally {
          this.downloadingInvoice = false;
        }
      },

      showReupload: false,
      reuploadFile: null,
      settings: {
        manual_enabled: true,
        gateway_enabled: true,
      },

      async init() {
        try {
          const res = await fetch('/api/payment/settings');
          const json = await res.json();
          if (res.ok && json.data) this.settings = json.data;
        } catch (e) {
          /* default: keduanya aktif */
        }
      },

      onReuploadFile(event) {
        const input = event.target;
        const f = input.files && input.files[0];
        if (!f) {
          this.reuploadFile = null;
          return;
        }
        if (f.size > 5 * 1024 * 1024) {
          alert('{{t "test.transactionDetail.uploadSizeAlert"}}');
          input.value = '';
          this.reuploadFile = null;
          return;
        }
        this.reuploadFile = f;
      },

      get canReupload() {
        if (!this.settings.manual_enabled) return false;
        if (!this.row) return false;
        // `paid` = sudah lunas (manual: diterima super admin, Xendit: sudah
        // dibayar). Backend menolak dengan pesan yang sama.
        if (this.row.status === 'paid') return false;
        if (this.row.paymentLink) return false;
        return true;
      },

      get installmentData() {
        return this.row?.installmentDetail?.monthly || [];
      },

      get installmentDueDates() {
        return this.row?.installmentDetail?.installment?.dueDates || [];
      },

      get installmentProgress() {
        const d = this.row?.installmentDetail;
        if (!d) return null;
        return {
          paid: Number(d.paidSoFar) || 0,
          total: Number(d.totalProgramFee) || 0,
          percent: Number(d.progressPercentage) || 0,
        };
      },

      formatPaidProgress(paid, total, percent) {
        const tpl = '{{t "test.transactionDetail.paidProgress"}}';
        return tpl.replace('{paid}', paid).replace('{total}', total).replace('{percent}', percent);
      },

      monthStatusLabel(m) {
        const map = {
          paid: '{{t "test.transactionDetail.monthStatus.paid"}}',
          process: '{{t "test.transactionDetail.monthStatus.process"}}',
          rejected: '{{t "test.transactionDetail.monthStatus.rejected"}}',
          due: '{{t "test.transactionDetail.monthStatus.due"}}',
          upcoming: '{{t "test.transactionDetail.monthStatus.upcoming"}}',
        };
        return map[m.status] || m.status || '—';
      },

      monthStatusClass(m) {
        const map = {
          paid: ['bg-[#CFF3DF]', 'text-[#139B59]'],
          process: ['bg-[#FFF0C7]', 'text-[#E99A0C]'],
          rejected: ['bg-[#FFDADA]', 'text-[#D9333F]'],
          due: ['bg-[#FFDADA]', 'text-[#D9333F]'],
          upcoming: ['bg-[#F1F5F9]', 'text-[#64748B]'],
        };
        const [bg, text] = map[m.status] || map.upcoming;
        return { bg, text };
      },

      canPayMonth(m) {
        if (!this.settings.manual_enabled) return false;
        if (!m) return false;
        if (m.status === 'paid' || m.process === 'approved') return false;
        return m.canPay !== false;
      },

      formatRupiah(n) {
        const number = Number(n);
        if (Number.isNaN(number)) return 'Rp 0';
        return new Intl.NumberFormat('id-ID', {
          style: 'currency',
          currency: 'IDR',
          maximumFractionDigits: 0,
        }).format(number);
      },

      formatDate(value) {
        if (!value) return '—';
        if (typeof value === 'string' && value.includes('T')) {
          const [datePart] = value.split('T');
          const [y, m, d] = datePart.split('-').map(Number);
          if (!y || !m || !d) return '—';
          return new Date(y, m - 1, d).toLocaleDateString('en-GB', {
            day: '2-digit',
            month: 'short',
            year: 'numeric',
          });
        }
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return '—';
        return date.toLocaleDateString('en-GB', {
          day: '2-digit',
          month: 'short',
          year: 'numeric',
        });
      },

      monthlyFilenames: {},
      activeManualMonth: null,
      copied: false,

      toggleManualMonth(month) {
        this.activeManualMonth = this.activeManualMonth === month ? null : month;
      },

      onMonthlyFile(month, event) {
        const input = event.target;
        const f = input.files && input.files[0];
        if (!f) return;
        if (f.size > 5 * 1024 * 1024) {
          alert('{{t "test.transactionDetail.uploadSizeAlert"}}');
          input.value = '';
          this.monthlyFilenames[month] = '';
          return;
        }
        this.monthlyFilenames[month] = f.name;
      },

      async copyBank() {
        try {
          await navigator.clipboard.writeText('2847923742981234');
          this.copied = true;
          setTimeout(() => (this.copied = false), 1800);
        } catch (e) {
          /* clipboard tidak tersedia */
        }
      },
    };
  }
</script>

<style>
  @media print {
    body > *:not(main),
    nav,
    aside,
    footer,
    #route-progress,
    .print\:hidden,
    [data-print-hide],
    #payment-proof-modal-header,
    #payment-proof-download-btn,
    #payment-proof-close-btn {
      display: none !important;
    }

    body * {
      visibility: hidden;
    }

    #payment-proof-modal,
    #payment-proof-modal * {
      visibility: visible;
    }

    #payment-proof-modal {
      position: absolute !important;
      left: 0 !important;
      top: 0 !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
      display: block !important;
    }

    #payment-proof-dialog {
      position: static !important;
      width: 100% !important;
      max-width: 100% !important;
      max-height: none !important;
      box-shadow: none !important;
      border: none !important;
      border-radius: 0 !important;
      overflow: visible !important;
      transform: none !important;
      background: transparent !important;
    }

    #payment-proof-viewer {
      max-height: none !important;
      overflow: visible !important;
      background: #ffffff !important;
      padding: 0 !important;
    }

    #invoice-printable-card {
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
    }

    #payment-proof-download-btn,
    #payment-proof-close-btn {
      display: none !important;
      visibility: hidden !important;
    }

    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    @page {
      size: A4 portrait;
      margin: 15mm 20mm;
    }
  }
</style>

<!-- Modal Backdrop & Container: Tersembunyi secara default (display: none), hanya aktif saat open=true -->
<div
  x-data="transactionDetailModal()"
  x-show="open"
  x-cloak
  id="payment-proof-modal"
  style="display: none;"
  @transaction-detail:open.window="show($event.detail)"
  @keydown.escape.window="close()"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-black/45 backdrop-blur-[2px] transition-opacity print:p-0 print:bg-transparent"
  x-transition:enter="ease-out duration-300"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="ease-in duration-200"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  @click.self="close()"
>
  <!-- View Proof Modal (Figma: width 1000px, height 728px, background #FFFFFF, border-radius 16px, box-shadow) -->
  <div
    role="dialog"
    aria-modal="true"
    id="payment-proof-dialog"
    aria-labelledby="modal-header-payment-proof-title"
    class="relative w-full max-w-[1100px] max-h-[92vh] flex flex-col bg-white rounded-2xl shadow-[0px_8px_24px_rgba(0,24,74,0.0941176),0px_24px_64px_rgba(0,24,74,0.2)] overflow-hidden border border-[#D8E6F6]/40 transition-all transform"
    x-transition:enter="ease-out duration-300"
    x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
    x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
    x-transition:leave="ease-in duration-200"
    x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
    x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
  >
    <!-- Modal Header (Figma: width 1000px, height 76px, padding 20px 32px, background #003060) -->
    <div id="payment-proof-modal-header" class="box-border flex flex-row justify-between items-center w-full h-[76px] px-6 sm:px-8 py-5 bg-[#003060] shrink-0 print:hidden">
      <!-- Frame: Icon & Payment Proof Title -->
      <div class="flex flex-row items-center gap-3">
        <!-- Frame icon: 36x36px, background rgba(255,255,255,0.101961), radius 8px -->
        <div class="flex flex-col justify-center items-center w-9 h-9 bg-white/[0.101961] rounded-lg shrink-0">
          <!-- file-text-icon: 18x18px -->
          <svg class="w-[18px] h-[18px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <!-- Title: Payment Proof (Montserrat 700 18px line-height 24px #FFFFFF) -->
        <h2 id="modal-header-payment-proof-title" class="font-montserrat font-bold text-lg leading-6 text-white tracking-wide">
          {{t "test.transactionDetail.paymentProof"}}
        </h2>
      </div>

      <!-- Close button: 36x36px, background rgba(255, 255, 255, 0.101961), radius 8px -->
      <button
        type="button"
        id="payment-proof-close-btn"
        data-print-hide="true"
        @click="close()"
        aria-label="Close modal"
        class="flex flex-col justify-center items-center w-9 h-9 bg-white/[0.101961] hover:bg-white/20 text-white rounded-lg transition-colors focus:outline-none shrink-0 print:hidden"
      >
        <!-- x: 16x16px -->
        <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Invoice Viewer (Figma: padding 24px 32px, gap 16px, background #F6F8FB, height 643px) -->
    <div class="box-border flex flex-col lg:flex-row items-start w-full p-5 sm:p-[24px_32px] gap-4 bg-[#F6F8FB] overflow-y-auto flex-1">
      <!-- Kolom Kiri: Invoice DP -->
      <div class="flex flex-col items-start w-full gap-4 shrink-0" :class="row?.kind === 'installment' && installmentData.length ? 'lg:w-[55%]' : 'lg:w-full'">
      <!-- Frame: Subheader (width 936px, height 31px) -->
      <div class="flex flex-row justify-between items-center w-full h-[31px] shrink-0">
        <!-- Invoice Image: Montserrat 700 14px line-height 17px #003060 -->
        <span class="font-montserrat font-bold text-sm leading-[17px] text-[#003060]">
          {{t "test.transactionDetail.invoiceImage"}}
        </span>

        <div class="flex items-center gap-2">
          <!-- Tombol Cetak Browser (Print manual jika memang ingin print ke kertas fisik) -->
          <button
            type="button"
            @click="printInvoice()"
            title="Print via Browser"
            class="box-border flex flex-row items-center justify-center w-[34px] h-[31px] bg-white border border-[#D9D9D9] hover:bg-slate-50 text-[#003060] rounded-lg transition-colors shadow-xs print:hidden cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 text-[#003060]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
          </button>

          <!-- Frame Download Button: 116x31px, padding 8px 16px, gap 6px, bg #FFFFFF, border 1px solid #D9D9D9, radius 8px -->
          <button
            type="button"
            id="payment-proof-download-btn"
            data-print-hide="true"
            @click="downloadInvoice()"
            :disabled="downloadingInvoice"
            class="box-border flex flex-row items-center justify-center min-w-[116px] h-[31px] px-3 py-1.5 gap-1.5 bg-white border border-[#D9D9D9] hover:bg-slate-50 rounded-lg transition-colors shadow-xs print:hidden disabled:opacity-60 disabled:cursor-not-allowed cursor-pointer"
          >
            <!-- Spinner saat proses unduh -->
            <template x-if="downloadingInvoice">
              <svg class="animate-spin w-3.5 h-3.5 text-[#003060]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
            </template>
            <!-- download-icon: 14x14px -->
            <template x-if="!downloadingInvoice">
              <svg class="w-3.5 h-3.5 text-[#003060] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </template>
            <!-- Download text: Montserrat 600 12px line-height 15px #003060 -->
            <span class="font-montserrat font-semibold text-xs leading-[15px] text-[#003060]" x-text="downloadingInvoice ? '{{t "test.transactionDetail.downloading"}}' : '{{t "test.transactionDetail.download"}}'">
              {{t "test.transactionDetail.download"}}
            </span>
          </button>
        </div>
      </div>

      <!-- Invoice Image Card (Desain Terbaru sesuai Mockup Kesatria) -->
      <div id="invoice-printable-card" class="box-border flex flex-col items-start w-full bg-white border border-[#D8E6F6] rounded-2xl p-6 sm:p-10 shadow-[0px_3px_12px_rgba(23,59,104,0.0627451)] shrink-0 print:border-none print:shadow-none print:p-0">
        <!-- Header Invoice: Logo di Kiri (tanpa teks) & INVOICE + No di Kanan -->
        <div class="flex flex-row justify-between items-start w-full">
          <div class="flex items-center">
            <img src="/public/image/logo_baru.png" alt="Kesatria" class="h-10 sm:h-12 w-auto object-contain" />
          </div>
          <div class="flex flex-col items-end text-right">
            <h1 class="font-montserrat font-bold text-2xl sm:text-3xl text-[#003060] tracking-wider leading-none">{{t "test.transactionDetail.invoice"}}</h1>
            <span class="font-inter font-medium text-xs sm:text-sm text-[#718096] mt-1" x-text="invoiceNumber"></span>
          </div>
        </div>

        <!-- Divider Line -->
        <div class="w-full h-px bg-[#E2E8F0] my-6"></div>

        <!-- Two Columns Info: Ditagihkan Kepada & Status Pembayaran -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full">
          <!-- Kolom Kiri: Ditagihkan Kepada -->
          <div class="flex flex-col items-start gap-1">
            <span class="font-inter font-semibold text-xs text-[#718096] tracking-wider uppercase">{{t "test.transactionDetail.billedTo"}}</span>
            <span class="font-inter font-bold text-base text-[#173B68]" x-text="userName"></span>
            <span class="font-inter text-sm text-[#4A5568]" x-text="userEmail"></span>
            <span class="font-inter text-sm text-[#4A5568]" x-text="userPhone"></span>
          </div>

          <!-- Kolom Kanan: Status Pembayaran & Tanggal -->
          <div class="flex flex-col items-start sm:items-start gap-3">
            <div class="flex flex-col gap-1">
              <span class="font-inter font-semibold text-xs text-[#718096] tracking-wider uppercase">{{t "test.transactionDetail.paymentStatus"}}</span>
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full shrink-0" :class="statusDotBg"></span>
                <span class="font-inter font-bold text-sm uppercase tracking-wide" :class="statusTextColor" x-text="statusBadgeText"></span>
              </div>
            </div>

            <div class="flex flex-col gap-0.5">
              <span class="font-inter text-xs text-[#718096]">{{t "test.transactionDetail.invoiceDate"}}</span>
              <span class="font-inter font-bold text-sm text-[#173B68]" x-text="invoiceDateFormatted"></span>
            </div>

          </div>
        </div>

        <!-- Rincian Pembelian -->
        <div class="w-full mt-8">
          <h2 class="font-inter font-bold text-sm sm:text-base text-[#173B68] mb-3">{{t "test.transactionDetail.purchaseDetails"}}</h2>

          <!-- Table Header Bar: Warna [#6EB6E5] -->
          <div class="w-full bg-[#6EB6E5] rounded-t-md px-4 py-2.5 flex justify-between items-center text-xs font-bold text-white uppercase tracking-wider">
            <span>{{t "test.transactionDetail.description"}}</span>
            <span>{{t "test.transactionDetail.price"}}</span>
          </div>

          <!-- Item Row -->
          <div class="w-full bg-white px-4 py-4 flex justify-between items-start border-b border-[#E2E8F0]">
            <div class="flex flex-col gap-1 max-w-[70%]">
              <span class="font-inter font-bold text-sm sm:text-base text-[#173B68]" x-text="programName"></span>
              <span class="font-inter text-xs text-[#718096]" x-text="programCategory ? programCategory + ' Course' : 'Program Course'"></span>
            </div>
            <div class="text-right">
              <span class="font-inter font-semibold text-sm sm:text-base text-[#173B68]" x-text="priceFormatted"></span>
            </div>
          </div>

          <!-- Summary Breakdown (Harga, Diskon, Promo Code, Total Dibayar) -->
          <div class="w-full flex flex-col gap-2.5 pt-4">
            <!-- Harga -->
            <div class="flex justify-between items-center text-xs sm:text-sm text-[#4A5568] px-4">
              <span>{{t "test.transactionDetail.price"}}</span>
              <span class="font-medium text-[#173B68]" x-text="originalPriceFormatted || priceFormatted"></span>
            </div>

            <!-- Diskon -->
            <div class="flex justify-between items-center text-xs sm:text-sm text-[#4A5568] px-4">
              <span>{{t "test.transactionDetail.discount"}}</span>
              <span :class="discountFormatted !== 'Rp 0' && discountFormatted !== '- Rp 0' ? 'text-[#EF4444] font-medium' : 'text-[#718096]'" x-text="discountFormatted"></span>
            </div>

            <!-- Promo Code -->
            <div class="flex justify-between items-center text-xs sm:text-sm text-[#4A5568] px-4">
              <span>{{t "test.transactionDetail.promoCode"}}</span>
              <span :class="promoCodeFormatted !== 'Rp 0' && promoCodeFormatted !== '- Rp 0' ? 'text-[#EF4444] font-medium' : 'text-[#718096]'" x-text="promoCodeFormatted"></span>
            </div>

            <!-- Total Dibayar -->
            <div class="flex justify-between items-center pt-4 border-t border-[#E2E8F0] px-4 mt-2">
              <span class="font-inter font-bold text-sm sm:text-base text-[#173B68] uppercase tracking-wider">{{t "test.transactionDetail.totalPaid"}}</span>
              <span class="font-inter font-bold text-lg sm:text-2xl text-[#003060]" x-text="finalTotalFormatted"></span>
            </div>
          </div>
        </div>

        <!-- Cap & Tanda Tangan Section (Dinamis: TTD jika Lunas, Status Badge jika Belum Lunas) -->
        <!-- 1. Kondisi Lunas (PAID / Approved): Tampilkan Approved by, Tanda Tangan, Cap, dan Pejabat Penyetuju -->
        <template x-if="isPaid">
          <div class="w-full mt-8 flex flex-col items-start gap-1">
            <span class="font-inter text-xs text-[#718096]">{{t "test.transactionDetail.approvedBy"}}</span>

            <div class="min-h-[72px] flex items-center justify-start py-2">
              <div class="relative flex items-center h-20 w-48">
                <!-- Tanda Tangan Resmi -->
                <img
                  src="/public/image/tanda_tangan.png"
                  alt="Tanda Tangan"
                  class="h-26 w-auto object-contain relative z-10"
                />
                <!-- Cap Stempel Kesatria -->
                <img
                  src="/public/image/cap_kesatria.png"
                  alt="Cap Kesatria"
                  class="h-28 w-auto object-contain absolute left-10 opacity-90 pointer-events-none z-20"
                />
              </div>
            </div>

            <span class="font-inter font-bold text-sm text-[#173B68]" x-text="row?.approvedBy || 'Adipura Arya Kangsadewa, S.Bns.'"></span>
            <span class="font-inter text-xs text-[#718096]">Manager Edukasi dan Budaya</span>
          </div>
        </template>

        <!-- 2. Kondisi Belum Lunas (Pending / Processing / Rejected): Tampilkan Status Pembayaran dengan Style Badge -->
        <template x-if="!isPaid">
          <div class="w-full mt-8 flex flex-col items-start gap-2">
            <span class="font-inter text-xs text-[#718096]">{{t "test.transactionDetail.paymentStatus"}}</span>

            <div class="py-1">
              <div
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border font-inter font-bold text-xs uppercase tracking-wider shadow-xs"
                :class="[
                  statusBadgeBg,
                  statusTextColor,
                  isRejected ? 'border-[#FECACA]' : 'border-[#FED7AA]'
                ]"
              >
                <span class="w-2.5 h-2.5 rounded-full" :class="statusDotBg"></span>
                <span x-text="statusBadgeText"></span>
              </div>
            </div>
          </div>
        </template>

        <!-- Footer Note -->
        <div class="w-full mt-8 pt-4 border-t border-[#E2E8F0] flex flex-col gap-1 text-xs text-[#718096]">
          <p class="font-medium text-[#4A5568]">{{t "test.transactionDetail.thankYou"}}</p>
          <p class="text-[11px] text-[#94A3B8]">{{t "test.transactionDetail.electronicDoc"}}</p>
        </div>
      </div>

      <!-- Tombol Upload Bukti (manual payment, jika bisa reupload) (Hidden in Print) -->
      <template x-if="canReupload">
        <div class="w-full mt-4 print:hidden">
          <button
            type="button"
            @click="showReupload = !showReupload"
            class="w-full inline-flex items-center justify-center gap-2 h-10 px-4 rounded-lg border border-[#D9333F] text-[#D9333F] font-inter font-semibold text-sm leading-5 transition-colors hover:bg-[#D9333F] hover:text-white cursor-pointer"
            :class="showReupload ? 'bg-[#D9333F] text-white' : ''"
          >
            <i class="fa-solid fa-rotate-left text-sm"></i>
            {{t "test.transactionDetail.uploadPaymentProof"}}
          </button>

          <div
            x-show="showReupload"
            x-cloak
            x-transition
            class="mt-3 rounded-xl border border-[#D8E6F6] bg-[#F8FAFC] p-4 flex flex-col gap-3"
          >
            <div class="w-full bg-gradient-to-br from-[#003060] to-[#0B3C69] text-white rounded-xl p-4 flex flex-col gap-3">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-[10px] text-slate-300">{{t "test.transactionDetail.transferInstruction"}}</p>
                  <p class="text-lg font-bold tracking-wider mt-0.5">2847 9237 4298 1234</p>
                </div>
                <button
                  type="button"
                  @click="copyBank()"
                  class="p-2 rounded-full bg-slate-700/60 hover:bg-emerald-600 transition-colors shrink-0"
                  :class="{'bg-emerald-600': copied}"
                >
                  <i class="far" :class="copied ? 'fa-check' : 'fa-copy'"></i>
                </button>
              </div>
              <div class="flex justify-between items-end gap-3 pt-2 border-t border-slate-700">
                <div>
                  <p class="text-[10px] text-slate-300">{{t "test.transactionDetail.accountHolder"}}</p>
                  <p class="text-xs font-semibold">PT. WIRATEK SOLUSI ASIA</p>
                </div>
                <div class="text-right">
                  <p class="text-[10px] text-slate-300">{{t "test.transactionDetail.bank"}}</p>
                  <p class="text-xs font-semibold">BANK BCA</p>
                </div>
              </div>
            </div>

            <form
              method="POST"
              :action="'/payment/manual/reupload/' + row.id"
              enctype="multipart/form-data"
              class="flex flex-col gap-3"
            >
              <label
                class="flex flex-col items-center justify-center gap-2 w-full min-h-[96px] rounded-xl border-2 border-dashed border-[#CBD5E1] bg-white hover:border-[#003060] transition-colors cursor-pointer p-4 text-center"
                :class="reuploadFile ? 'border-emerald-400 bg-emerald-50' : ''"
              >
                <i class="fa-solid fa-cloud-arrow-up text-lg text-[#64748B]" x-show="!reuploadFile"></i>
                <i class="fa-solid fa-file-image text-lg text-emerald-500" x-show="reuploadFile"></i>
                <span class="font-inter text-[12px] text-[#475569]">
                  <span x-show="!reuploadFile">{{t "test.transactionDetail.uploadInstruction"}}</span>
                  <span x-show="reuploadFile" class="font-semibold text-[#003060]" x-text="reuploadFile?.name"></span>
                </span>
                <input
                  type="file"
                  name="file"
                  accept="image/jpeg,image/jpg,image/png"
                  required
                  class="hidden"
                  @change="onReuploadFile($event)"
                />
              </label>
              <button
                type="submit"
                class="w-full bg-[#16A34A] hover:bg-[#15803D] text-white rounded-lg py-2.5 font-inter font-semibold text-[13px] transition-colors flex items-center justify-center gap-2 cursor-pointer"
              >
                <i class="fa-solid fa-paper-plane text-xs"></i>
                {{t "test.transactionDetail.sendProof"}}
              </button>
            </form>
          </div>
        </div>
      </template>

      <!-- Lampiran Bukti Transfer (Opsional jika ada file upload) (Hidden in Print) -->
      <template x-if="row?.proof">
        <div class="w-full mt-4 pt-4 border-t border-[#D8E6F6] flex flex-col gap-2 print:hidden">
          <div class="flex items-center justify-between">
            <span class="font-inter font-semibold text-xs text-[#173B68]">{{t "test.transactionDetail.attachedProof"}}</span>
            <a
              :href="row.proof"
              target="_blank"
              rel="noopener noreferrer"
              class="font-inter text-xs text-[#3B82F6] hover:underline inline-flex items-center gap-1"
            >
              <span>{{t "test.transactionDetail.viewOriginalFile"}} &rarr;</span>
            </a>
          </div>
          <div class="rounded-xl border border-[#D8E6F6] overflow-hidden bg-[#F8FAFC] p-2 flex items-center justify-center">
            <img :src="row.proof" alt="Payment proof attachment" class="max-h-52 object-contain rounded-lg" />
          </div>
        </div>
      </template>
      </div>

      <!-- Kolom Kanan: Cicilan Per Bulan -->
      <template x-if="row.kind === 'installment' && installmentData.length">
        <div class="box-border flex flex-col items-start w-full lg:w-[45%] bg-white border border-[#D8E6F6] rounded-2xl p-5 sm:p-[20px_24px] shadow-[0px_3px_12px_rgba(23,59,104,0.0627)] shrink-0 lg:max-h-[calc(92vh-76px-2rem)] overflow-y-auto">
          <div class="flex items-center justify-between gap-3 w-full pb-4">
            <span class="font-montserrat font-bold text-sm leading-[17px] text-[#003060]">
              {{t "test.transactionDetail.monthlyInstallments"}}
            </span>
          </div>
          <div class="w-full h-px bg-[#D8E6F6]"></div>

          <div class="flex flex-col w-full">
            <template x-for="(m, index) in installmentData" :key="m.month">
              <div class="flex flex-col border-b border-[#EDF1F7] last:border-b-0 py-3">
                <div class="flex flex-wrap items-center gap-3 w-full">
                  <div class="flex flex-col gap-0.5 min-w-[110px]">
                    <span class="font-inter font-semibold text-[13px] leading-4 text-[#173B68]" x-text="formatDate(installmentDueDates[index] || m.dueDate)"></span>
                    <span class="font-inter font-normal text-[11px] leading-[13px] text-[#9CA3AF]">
                      {{t "test.transactionDetail.dueDate"}}
                    </span>
                  </div>
                  <span class="font-inter font-bold text-sm leading-4 text-[#173B68]" x-text="formatRupiah(m.amount)"></span>
                  <span
                    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-inter font-semibold text-[10px] leading-3"
                    :class="monthStatusClass(m).bg + ' ' + monthStatusClass(m).text"
                  >
                    <span class="w-[7px] h-[7px] rounded-full shrink-0" :class="monthStatusClass(m).text"></span>
                    <span x-text="monthStatusLabel(m)"></span>
                  </span>

                  <div class="flex items-center gap-2 ml-auto shrink-0">
                    <template x-if="canPayMonth(m)">
                      <button
                        type="button"
                        @click="toggleManualMonth(m.month)"
                        class="inline-flex items-center justify-center gap-1.5 h-8 px-3 rounded-lg border border-[#D9333F] text-[#D9333F] font-inter font-semibold text-[11px] leading-4 transition-colors hover:bg-[#D9333F] hover:text-white cursor-pointer"
                        :class="activeManualMonth === m.month ? 'bg-[#D9333F] text-white' : ''"
                      >
                        <i class="fa-solid fa-rotate-left text-[10px]"></i>
                        <span x-text="m.process ? '{{t "test.transactionDetail.reupload"}}' : '{{t "test.transactionDetail.pay"}}'"></span>
                      </button>
                    </template>
                  </div>
                </div>

                <div
                  x-show="activeManualMonth === m.month"
                  x-cloak
                  x-transition
                  class="mt-3 rounded-xl border border-[#D8E6F6] bg-[#F8FAFC] p-4 flex flex-col gap-3"
                >
                  <div class="w-full bg-gradient-to-br from-[#003060] to-[#0B3C69] text-white rounded-xl p-4 flex flex-col gap-3">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <p class="text-[10px] text-slate-300">{{t "test.transactionDetail.transferInstruction"}}</p>
                        <p class="text-lg font-bold tracking-wider mt-0.5">2847 9237 4298 1234</p>
                      </div>
                      <button
                        type="button"
                        @click="copyBank()"
                        class="p-2 rounded-full bg-slate-700/60 hover:bg-emerald-600 transition-colors shrink-0"
                        :class="{'bg-emerald-600': copied}"
                      >
                        <i class="far" :class="copied ? 'fa-check' : 'fa-copy'"></i>
                      </button>
                    </div>
                    <div class="flex justify-between items-end gap-3 pt-2 border-t border-slate-700">
                      <div>
                        <p class="text-[10px] text-slate-300">{{t "test.transactionDetail.accountHolder"}}</p>
                        <p class="text-xs font-semibold">PT. WIRATEK SOLUSI ASIA</p>
                      </div>
                      <div class="text-right">
                        <p class="text-[10px] text-slate-300">{{t "test.transactionDetail.bank"}}</p>
                        <p class="text-xs font-semibold">BANK BCA</p>
                      </div>
                    </div>
                  </div>

                  <form
                    method="POST"
                    :action="'/payment/manual/installment/' + row.id + '/' + m.month"
                    enctype="multipart/form-data"
                    class="flex flex-col gap-3"
                  >
                    <label
                      class="flex flex-col items-center justify-center gap-2 w-full min-h-[96px] rounded-xl border-2 border-dashed border-[#CBD5E1] bg-white hover:border-[#003060] transition-colors cursor-pointer p-4 text-center"
                      :class="monthlyFilenames[m.month] ? 'border-emerald-400 bg-emerald-50' : ''"
                    >
                      <i class="fa-solid fa-cloud-arrow-up text-lg text-[#64748B]" x-show="!monthlyFilenames[m.month]"></i>
                      <i class="fa-solid fa-file-image text-lg text-emerald-500" x-show="monthlyFilenames[m.month]"></i>
                      <span class="font-inter text-[12px] text-[#475569]">
                        <span x-show="!monthlyFilenames[m.month]">{{t "test.transactionDetail.uploadInstruction"}}</span>
                        <span x-show="monthlyFilenames[m.month]" class="font-semibold text-[#003060]" x-text="monthlyFilenames[m.month]"></span>
                      </span>
                      <input
                        type="file"
                        name="file"
                        accept="image/jpeg,image/jpg,image/png"
                        required
                        class="hidden"
                        @change="onMonthlyFile(m.month, $event)"
                      />
                    </label>
                    <button
                      type="submit"
                      class="w-full bg-[#16A34A] hover:bg-[#15803D] text-white rounded-lg py-2.5 font-inter font-semibold text-[13px] transition-colors flex items-center justify-center gap-2 cursor-pointer"
                    >
                      <i class="fa-solid fa-paper-plane text-xs"></i>
                      {{t "test.transactionDetail.sendMonthProof"}} <span x-text="m.month"></span>
                    </button>
                  </form>
                </div>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>
  </div>
</div>
