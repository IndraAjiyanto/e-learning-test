{{!--
  Komponen: Crop Photo Modal (modal crop foto profil pakai Cropper.js)
  Lokasi: src/views/partials/components/ui/modal/crop_photo/index.hbs
  Level: L1 Atomik

  Kontrak Alpine yang wajib disediakan x-data induk (lihat pola `profilePictureCrop()`
  di src/views/partials/user/sidebar_user_profile/profile/index.hbs):
  - showCropModal (boolean)
  - tempImageUrl (string|null) — object URL gambar sumber
  - closeCropModal()
  - applyCrop()

  Props:
  - cropImageId : string (wajib) — id elemen <img> target Cropper.js, HARUS SAMA dengan
                  id yang dipakai di initCropper() (document.getElementById(cropImageId))
                  milik x-data pemanggil. Wajib unik per instance bila ada >1 modal di 1 page.
  - title        : string (opsional, default "Crop Profile Photo")
  - description  : string (opsional, default "Sesuaikan area crop untuk foto profil kamu")
  - cancelLabel  : string (opsional, default "Batal")
  - applyLabel   : string (opsional, default "Apply Crop")
  - applyBtnClass: string (opsional, default "bg-[#003060] text-white hover:bg-[#0B3A68]")
  - wrapperClass : string (opsional) — class tambahan pembungkus overlay
--}}

<div
  x-show="showCropModal"
  x-cloak
  class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4 {{wrapperClass}}"
  @click.self="closeCropModal()"
>
  <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-hidden">
    <div class="p-6 border-b border-gray-200">
      <h3 class="text-xl font-semibold text-slate-900">{{default title 'Crop Profile Photo'}}</h3>
      <p class="text-sm text-slate-600 mt-1">{{default description 'Sesuaikan area crop untuk foto profil kamu'}}</p>
    </div>
    <div class="p-6 overflow-auto max-h-[60vh]">
      <img id="{{cropImageId}}" :src="tempImageUrl" class="max-w-full" style="display: block;"/>
    </div>
    <div class="p-6 border-t border-gray-200 flex justify-end gap-3">
      <button type="button"
        class="px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition"
        @click="closeCropModal()">
        {{default cancelLabel 'Batal'}}
      </button>
      <button type="button"
        class="px-6 py-2 rounded-lg {{default applyBtnClass 'bg-[#003060] text-white hover:bg-[#0B3A68]'}} transition"
        @click="applyCrop()">
        {{default applyLabel 'Apply Crop'}}
      </button>
    </div>
  </div>
</div>
