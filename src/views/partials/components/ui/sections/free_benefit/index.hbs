{{!--
  Section: Free Benefit (L2) - reskin ke standar internal.
  Lokasi: src/views/partials/components/ui/sections/free_benefit/index.hbs
  Props: category (.name), benefit_category[] (.title jsonb), lang.
--}}
<section id="benefit" class="w-full bg-[#F8F9FA] py-14 font-montserrat lg:py-20">
  <div class="page-shell flex flex-col items-center gap-12 lg:gap-16">

    <div class="flex max-w-[680px] flex-col items-center gap-4 text-center">
      {{> components/ui/text/eyebrow/index text=(t 'test.categoryFreeProgram.benefit.eyebrow') }}
      <h2 class="{{sizeClass 'h2'}} font-montserrat font-bold text-[#0B1F3B]">
        {{t 'test.categoryFreeProgram.benefit.title'}} <span class="text-[#6EB6E5]">{{category.name}}</span>
      </h2>
      <p class="{{sizeClass 'lead'}} font-open-sans text-[#4A5568]">
        {{t 'test.categoryFreeProgram.benefit.description1'}} {{category.name}} {{t 'test.categoryFreeProgram.benefit.description2'}}
      </p>
    </div>

    {{#if benefit_category.length}}
      <div class="flex w-full flex-wrap justify-center gap-6 [&>*]:w-full [&>*]:sm:w-[calc((100%-1.5rem)/2)] [&>*]:lg:w-[calc((100%-3rem)/3)]">
        {{#each benefit_category}}
          <div class="flex items-start gap-4 rounded-2xl border border-[#E5E7EB] bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-[0px_12px_28px_rgba(11,31,59,0.10)] lg:p-8">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-[#E0F2F9] text-[#003060]">
              <i class="fas fa-circle-check text-lg" aria-hidden="true"></i>
            </span>
            <p class="{{sizeClass 'body'}} self-center font-open-sans text-[#374151]">{{getByLang this.title ../lang}}</p>
          </div>
        {{/each}}
      </div>
    {{/if}}
  </div>
</section>
