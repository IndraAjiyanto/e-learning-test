{{!--
  Section: Team (tab halaman About) - Figma 250:1176
  Lokasi: src/views/partials/components/ui/sections/team/index.hbs

  Data (dari dashboard.about()):
  - teamLead   : 1 baris (CEO) - profile, name, position/description (jsonb per-bahasa), linkedin, instagram
  - team       : N baris - profile, name, position/description (jsonb per-bahasa), linkedin, instagram
  - background : N baris (content + details per-bahasa) untuk akordion Educational Background
  - experience : N baris (content + details per-bahasa) untuk akordion Portfolio & Experience

  Satu pohon markup yang mengalir. L1: text/section_header, card/team_member.
--}}

<div class="w-full font-inter">
  {{!-- Hero --}}
  {{> components/ui/text/section_header/index
      align="text-left"
      titleTag="h1"
      titleSize="display"
      title=(t 'test.about.team.title')
      titleClass="font-inter font-bold text-[#003060]"
      descSize="h3"
      description=(t 'test.about.team.description')
      descClass="font-inter font-medium text-[#4B5563] mt-3" }}

  {{!-- Featured member (CEO) --}}
  <div class="mt-10 flex flex-col gap-8 rounded-3xl border border-[#E5E7EB] bg-white p-5 shadow-[0px_18px_40px_-16px_rgba(0,0,0,0.06)] lg:flex-row lg:gap-12 lg:p-10">
    <div class="flex flex-col items-center gap-6 lg:w-[360px] lg:shrink-0">
      <img
        src="{{#if teamLead.[0].profile}}{{teamLead.[0].profile}}{{else}}/public/image/about/orang.png{{/if}}"
        alt="{{#if teamLead.[0]}}{{teamLead.[0].name}}{{else}}CEO{{/if}}"
        class="aspect-[4/5] w-full max-w-[360px] rounded-2xl object-cover"
        onerror="this.onerror=null;this.src='/public/image/about/orang.png';"
      />
      <div class="flex items-center gap-3">
        <a href="{{#if teamLead.[0]}}{{teamLead.[0].linkedin}}{{else}}#{{/if}}" target="_blank" rel="noopener" class="grid size-11 place-items-center rounded-full bg-[#F3F4F6] transition hover:opacity-80">
          <img src="/public/image/about/team/linkedin.svg" alt="LinkedIn" class="size-5" />
        </a>
        <a href="{{#if teamLead.[0]}}{{teamLead.[0].instagram}}{{else}}#{{/if}}" target="_blank" rel="noopener" class="grid size-11 place-items-center rounded-full bg-[#F3F4F6] transition hover:opacity-80">
          <img src="/public/image/about/team/instagram.svg" alt="Instagram" class="size-5" />
        </a>
      </div>
    </div>

    <div class="flex flex-1 flex-col gap-5">
      <div class="flex flex-col gap-1">
        <h3 class="{{sizeClass 'h2'}} font-inter font-bold text-[#111827]">{{#if teamLead.[0]}}{{teamLead.[0].name}}{{else}}Faisal Wirakusuma, S.Kom., M.Sc.{{/if}}</h3>
        <p class="{{sizeClass 'h3'}} font-inter font-semibold text-[#003060]">{{#if teamLead.[0]}}{{getByLang teamLead.[0].position lang}}{{else}}Chief Executive Officer{{/if}}</p>
      </div>

      <p class="{{sizeClass 'body'}} font-inter text-justify text-[#6B7280]">{{#if teamLead.[0]}}{{getByLang teamLead.[0].description lang}}{{else}}Faisal is the Founder and CEO of Wiratek Solusi Asia, bringing over 11 years of experience in web application development, API creation, data science, and analytics. He is experienced in handling projects for State-Owned Enterprises (BUMN), government agencies, and private companies, including Pertamina, Biofarma, Angkasa Pura II, and Bank DBS Indonesia. His deep expertise in technology and data analytics, combined with his experience serving major clients, serves as the core foundation for his vision to build an Edutech company.{{/if}}</p>

      {{!-- Links to the CEO detail page tabs (not accordions) --}}
      <div class="flex flex-col gap-3">
        <a href="/dashboard/about/team/lead" class="group flex items-center justify-between gap-4 rounded-2xl border border-[#E5E7EB] bg-white px-5 py-4 shadow-[0px_2px_10px_-4px_rgba(0,0,0,0.04)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0px_12px_28px_rgba(11,31,59,0.10)]">
          <span class="flex items-center gap-4">
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-[#F3F4F6]"><img src="/public/image/about/team/educational.svg" alt="" class="size-5" /></span>
            <span class="{{sizeClass 'h3'}} font-inter font-semibold text-[#111827]">{{t 'test.about.team.educationBackground'}}</span>
          </span>
          <i class="fas fa-chevron-right text-xs text-[#003060] transition-transform group-hover:translate-x-1"></i>
        </a>
        <a href="/dashboard/about/team/lead?tab=portfolio" class="group flex items-center justify-between gap-4 rounded-2xl border border-[#E5E7EB] bg-white px-5 py-4 shadow-[0px_2px_10px_-4px_rgba(0,0,0,0.04)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0px_12px_28px_rgba(11,31,59,0.10)]">
          <span class="flex items-center gap-4">
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-[#F3F4F6]"><img src="/public/image/about/team/portofolio.svg" alt="" class="size-5" /></span>
            <span class="{{sizeClass 'h3'}} font-inter font-semibold text-[#111827]">{{t 'test.about.team.portfolioExperience'}}</span>
          </span>
          <i class="fas fa-chevron-right text-xs text-[#003060] transition-transform group-hover:translate-x-1"></i>
        </a>
      </div>
    </div>
  </div>

  {{!-- Meet the team --}}
  <div class="mt-14 lg:mt-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="flex flex-col gap-1">
        <h2 class="{{sizeClass 'h2'}} font-inter font-bold text-[#111827]">{{t 'test.about.team.meetTheTeam'}}</h2>
        <p class="{{sizeClass 'body'}} font-inter text-[#6B7280]">{{t 'test.about.team.meetTheTeamSub'}}</p>
      </div>
      <a href="/dashboard/about/team" class="inline-flex h-11 items-center gap-2 rounded-full border border-[#E5E7EB] bg-white px-4 {{sizeClass 'body'}} font-inter font-bold text-[#003060] transition hover:bg-[#F9FAFB]">
        {{t 'test.about.team.viewAll'}} <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {{#if team.length}}
        {{!-- Tab shows up to 6 (Figma 250:1176 = 3 rows); "View all" leads to the full roster --}}
        {{#each team}}
          {{#if (check @index 6)}}
            {{> components/ui/card/team_member/index
                profile=profile
                name=name
                position=(getByLang position ../lang)
                description=(getByLang description ../lang)
                linkedin=linkedin
                instagram=instagram }}
          {{/if}}
        {{/each}}
      {{else}}
        {{> components/ui/card/team_member/index profile="/public/image/about/orang.png" name="Rizal Rahadian Ramadhan, S.E" position="Chief Finance Officer" description="Oversees the company's financial planning, budgeting, and investment strategies. Maintains financial stability and supports data-driven decision-making." }}
        {{> components/ui/card/team_member/index profile="/public/image/about/orang.png" name="Adipura Arya Kangsadewa, S.Bns" position="Education & Culture Manager" description="Leads the development of training programs and strategic partnerships. Focuses on innovation in digital education, business growth, and collaboration." }}
        {{> components/ui/card/team_member/index profile="/public/image/about/orang.png" name="Zahra Andriani Mustika Fitri, S.M" position="Human Resource & Recruiter" description="Manages recruitment processes and talent development initiatives. Supports participants in their career preparation for the professional industry." }}
        {{> components/ui/card/team_member/index profile="/public/image/about/orang.png" name="Gilang Priambodo, S.Bns" position="Operational & Creative Admin" description="Coordinates daily operations and administrative processes. Ensures efficient documentation and smooth execution of internal programs." }}
        {{> components/ui/card/team_member/index profile="/public/image/about/orang.png" name="Feri Handoyo, S.Kom" description="Instructor specializing in programming and application development. Guides participants through project-based learning and portfolio building." }}
        {{> components/ui/card/team_member/index profile="/public/image/about/orang.png" name="Reno Agil Saputra, S.Kom" description="Web development mentor with experience guiding students through hands-on projects and industry-ready portfolios." }}
      {{/if}}
    </div>
  </div>

  {{!-- Join Our Team CTA --}}
  <div class="mt-12 flex flex-col gap-6 rounded-3xl border border-[#E5E7EB] bg-white p-6 shadow-[0px_2px_10px_-4px_rgba(0,0,0,0.04)] lg:flex-row lg:items-center lg:justify-between lg:p-10">
    <div class="flex flex-col gap-2">
      <h2 class="{{sizeClass 'h2'}} font-inter font-bold text-[#111827]">{{t 'test.about.team.joinOurTeam'}}</h2>
      <p class="{{sizeClass 'body'}} font-inter text-[#6B7280]">{{t 'test.about.team.joinDescription'}}</p>
    </div>
    <a href="#" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-[#003060] px-6 py-3.5 {{sizeClass 'body'}} font-inter font-bold text-white transition hover:bg-[#00274d]">
      <img src="/public/image/about/team/portofolio.svg" alt="" class="size-4 brightness-0 invert" />
      {{t 'test.about.team.buttonJob'}}
    </a>
  </div>
</div>
