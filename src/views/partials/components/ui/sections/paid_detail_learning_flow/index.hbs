          <img src="/public/image/icons/paid_program/learning-flow/1.svg" alt="Step 1" class="w-[28px] h-[28px] mb-4 object-contain" />
          <h3 class="text-[#2D2D2D] font-[600] text-[15px] mb-3 leading-tight max-w-[140px]">{{getByLang this.title ../lang}}</h3>
          <p class="text-[#2D2D2D] text-[12px] leading-[25px] w-[137px]">{{getByLang this.content ../lang}}</p>
