        <div class="w-10 h-10 min-w-[40px] min-h-[40px] flex-shrink-0 flex-grow-0 rounded-full bg-[#6EB6E5] text-black flex items-center justify-center font-[600] text-[12px] mb-4 relative z-10">1</div>
