{{!--
  Section: Hero (L2) - Figma hero-section 250:2796
  Lokasi: src/views/partials/components/ui/sections/hero/index.hbs
  Satu pohon markup, base + lg. Data: about.[0].{title,text,image} (jsonb), social.[0].number.
  sizeClass untuk teks, .page-shell untuk kontainer.
--}}
<section class="w-full bg-[#F8F9FA] font-montserrat" data-node-id="250:2796">
  <div class="page-shell flex flex-col justify-center gap-10 py-24 lg:min-h-[680px] lg:flex-row lg:items-center lg:gap-[80px]">

    {{!-- content --}}
    <div class="flex flex-1 flex-col items-start gap-8">
      {{> components/ui/text/eyebrow/index text=(t 'test.home.heroSection.badge') }}

      <h1 class="{{sizeClass 'display'}} max-w-[619px] font-montserrat font-extrabold tracking-[-0.02em] text-[#0B1F3B]">
        <span
          x-data="heroTypewriter()"
          data-full="{{#if about.[0].title}}{{getByLang about.[0].title lang}}{{else}}{{t 'test.home.heroSection.title'}}{{/if}}"
          x-init="start($el.dataset.full)"
        ><span x-text="head"></span><span class="text-[#6EB6E5]" x-text="tail"></span><span class="ml-1 inline-block h-[0.8em] w-[3px] translate-y-[0.06em] rounded-sm bg-[#6EB6E5] transition-opacity" :class="showCursor ? 'opacity-100' : 'opacity-0'"></span></span>
      </h1>

      <p class="{{sizeClass 'lead'}} max-w-[719px] font-open-sans text-[#4A5568]">
        {{#if about.[0].text}}{{{nl2br (getByLang about.[0].text lang)}}}{{else}}{{t 'test.home.heroSection.description'}}{{/if}}
      </p>

      <div class="flex w-full flex-col items-stretch gap-4 sm:w-auto sm:flex-row sm:items-center">
        {{> components/ui/button/btn_action/index
            onClick="document.getElementById('courses-section').scrollIntoView({ behavior: 'smooth', block: 'start' })"
            text=(t 'test.home.heroSection.buttonExplorePrograms')
            icon="fas fa-arrow-right text-sm shrink-0"
            iconPosition="right"
            variant="primary"
            class="gap-2.5 px-8 py-4 text-sm shadow-none hover:-translate-y-0.5 hover:shadow-lg" }}
        {{> components/ui/button/consultation/index
            phone=social.[0].number
            variant="light"
            text=(t 'test.home.heroSection.buttonConsultation')
            class="gap-2.5 px-8 py-4 text-sm" }}
      </div>
    </div>

    {{!-- visual --}}
    <div class="w-full lg:w-[620px] lg:shrink-0">
      <div class="aspect-[4/3] w-full overflow-hidden rounded-3xl lg:aspect-[73/50]">
        <img
          src="{{#if about.[0].image}}{{about.[0].image}}{{else}}/public/image/dashboard/bgHeroSection.png{{/if}}"
          alt="Hero"
          onerror="this.src='/public/image/dashboard/bgHeroSection.png'"
          class="size-full object-cover"
        />
      </div>
    </div>
  </div>
</section>

<script>
  function heroTypewriter() {
    return {
      head: '', tail: '', showCursor: true, _target: '', _i: 0,
      start(full) {
        full = (full || 'Shape your path in the digital frontier').replace(/\s*\|\s*$/, '').trim();
        const w = full.split(/\s+/);
        const n = w.length > 2 ? 2 : 1;
        this._target = w.slice(-n).join(' ');
        this.head = w.slice(0, w.length - n).join(' ') + (w.length > n ? ' ' : '');
        this._i = 0;
        this._loop();
        setInterval(() => { this.showCursor = !this.showCursor; }, 530);
      },
      _loop() {
        if (this._i <= this._target.length) {
          this.tail = this._target.slice(0, this._i++);
          setTimeout(() => this._loop(), 85);
        } else {
          setTimeout(() => { this._i = 0; this._loop(); }, 2600);
        }
      }
    };
  }
</script>
