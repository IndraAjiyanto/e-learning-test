{{!--
  Section: Program / "Specialized Career Pathways" (L2) - Figma programs-section 250:2866
  Lokasi: src/views/partials/components/ui/sections/program/index.hbs
  Satu pohon markup, base + lg. Data: category[] (jsonb name/text + icon), social.[0].number.
--}}
<section class="relative z-10 w-full bg-[#F8F9FA] py-14 font-montserrat lg:pt-[50px] lg:pb-[120px]" id="courses-section">
  <div class="page-shell flex flex-col items-center gap-12 lg:gap-16">

    {{!-- section header --}}
    <div
      x-data="{ shown: false }"
      x-init="new IntersectionObserver(([e]) => { if (e.isIntersecting) { shown = true; } }, { threshold: 0.3, rootMargin: '0px 0px -50px 0px' }).observe($el)"
      :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 -translate-y-6'"
      class="flex flex-col items-center gap-4 text-center transition-all duration-700 ease-out"
    >
      <span class="inline-flex items-center gap-2 rounded-full border border-[#E5E7EB] bg-white px-4 py-1.5 {{sizeClass 'eyebrow'}} font-montserrat font-bold text-[#0B1F3B]">
        <i class="fas fa-circle text-[8px] leading-none text-[#6EB6E5]" aria-hidden="true"></i>
        {{t 'test.home.programSection.ourProgram'}}
      </span>
      <h2 class="{{sizeClass 'h2'}} font-montserrat font-bold text-[#0B1F3B]">{{t 'test.home.programSection.title'}}</h2>
      <p class="{{sizeClass 'lead'}} max-w-[542px] font-open-sans text-[#4A5568]">{{t 'test.home.programSection.description'}}</p>
      <div class="h-1 w-[60px] rounded-[2px] bg-[#003060]"></div>
    </div>

    {{!-- programs grid --}}
    <div
      x-data="{ shown: false }"
      x-init="new IntersectionObserver(([e]) => { if (e.isIntersecting) { shown = true; } }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' }).observe($el)"
      :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-12'"
      class="grid w-full grid-cols-1 gap-6 transition-all duration-700 ease-out sm:grid-cols-2 lg:grid-cols-3 lg:gap-[30px]"
    >
      {{#each category}}
        {{> components/ui/card/card_program/index image=this.icon name=this.name text=this.text learnMore=(t 'test.home.programSection.learnMore') lang=../lang}}
      {{else}}
        {{> components/ui/card/card_program/index image="/public/image/Bootcamp.png" name="Bootcamp" text="Intensive career-switch track with mentor-led projects and job-ready portfolio." learnMore=(t 'test.home.programSection.learnMore')}}
        {{> components/ui/card/card_program/index image="/public/image/Course.png" name="Course" text="Self-paced modules to sharpen a specific technical skill at your own rhythm." learnMore=(t 'test.home.programSection.learnMore')}}
        {{> components/ui/card/card_program/index image="/public/image/InHouseTraining.png" name="In House Training" text="Tailored team training designed around your company's stack and objectives." learnMore=(t 'test.home.programSection.learnMore')}}
      {{/each}}

      {{!-- program banner (Figma 286:3598) --}}
      <div class="flex flex-col justify-center gap-6 rounded-2xl bg-[#003060] p-8 lg:p-10">
        <h3 class="{{sizeClass 'h3'}} font-montserrat font-bold leading-snug text-white">{{t 'test.home.programSection.bannerTitle'}}</h3>
        <p class="{{sizeClass 'body'}} font-open-sans text-[#E0F2F9]">{{t 'test.home.programSection.bannerDescription'}}</p>
        {{> components/ui/button/consultation/index
            phone=social.[0].number
            variant="solid"
            roundedClass="rounded-lg"
            text=(t 'test.home.programSection.bannerCta')
            class="self-start px-6 py-3 font-montserrat text-sm" }}
      </div>
    </div>
  </div>
</section>
