{{!--
  Section: Program / "Specialized Career Pathways" (L2) - Figma programs-section 250:2866
  Lokasi: src/views/partials/components/ui/sections/program/index.hbs
  Satu pohon markup, base + lg. Data: category[] (jsonb name/text + icon), social.[0].number.
--}}
<section class="relative z-10 w-full bg-[#F8F9FA] py-14 font-montserrat lg:pt-[50px] lg:pb-[120px]" id="courses-section">
  <div class="page-shell flex flex-col items-center gap-12 lg:gap-16">

    {{!-- section header --}}
    <div
      x-data="{ shown: false }"
      x-init="new IntersectionObserver(([e]) => { if (e.isIntersecting) { shown = true; } }, { threshold: 0.3, rootMargin: '0px 0px -50px 0px' }).observe($el)"
      :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 -translate-y-6'"
      class="flex flex-col items-center gap-4 text-center transition-all duration-700 ease-out"
    >
      {{> components/ui/text/eyebrow/index text=(t 'test.home.programSection.ourProgram') }}
      <h2 class="{{sizeClass 'h2'}} font-montserrat font-bold text-[#0B1F3B]">{{t 'test.home.programSection.title'}}</h2>
      <p class="{{sizeClass 'lead'}} max-w-[542px] font-open-sans text-[#4A5568]">{{t 'test.home.programSection.description'}}</p>
      <div class="h-1 w-[60px] rounded-[2px] bg-[#003060]"></div>
    </div>

    {{!-- programs grid --}}
    {{!-- flex-wrap + justify-center so an incomplete last row stays centered (not left-aligned) --}}
    <div
      x-data="{ shown: false }"
      x-init="new IntersectionObserver(([e]) => { if (e.isIntersecting) { shown = true; } }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' }).observe($el)"
      :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-12'"
      class="flex w-full flex-wrap justify-center gap-6 transition-all duration-700 ease-out lg:gap-[30px] [&>*]:w-full [&>*]:sm:w-[calc((100%-1.5rem)/2)] [&>*]:lg:w-[calc((100%-3.75rem)/3)]"
    >
      {{!-- "In House Training" has a dedicated redesigned page; the rest route to the generic category page --}}
      {{#each category}}
        <div class="flex">{{> components/ui/card/card_program/index image=this.icon name=this.name text=this.text learnMore=(t 'test.home.programSection.learnMore') lang=../lang href=(ternary (eq this.name 'In House Training') '/dashboard/corporate-training' (concat '/category/program/' this.name))}}</div>
      {{else}}
        <div class="flex">{{> components/ui/card/card_program/index image="/public/image/Bootcamp.png" name="Bootcamp" text="Intensive career-switch track with mentor-led projects and job-ready portfolio." learnMore=(t 'test.home.programSection.learnMore')}}</div>
        <div class="flex">{{> components/ui/card/card_program/index image="/public/image/Course.png" name="Course" text="Self-paced modules to sharpen a specific technical skill at your own rhythm." learnMore=(t 'test.home.programSection.learnMore')}}</div>
        <div class="flex">{{> components/ui/card/card_program/index image="/public/image/InHouseTraining.png" name="In House Training" text="Tailored team training designed around your company's stack and objectives." learnMore=(t 'test.home.programSection.learnMore') href="/dashboard/corporate-training"}}</div>
      {{/each}}

      {{!-- program banner (Figma 286:3598) --}}
      <div class="flex flex-col justify-center gap-4 rounded-2xl bg-[#003060] p-7 lg:p-8">
        <h3 class="text-lg font-montserrat font-bold leading-snug text-white">{{t 'test.home.programSection.bannerTitle'}}</h3>
        <p class="{{sizeClass 'body-sm'}} font-open-sans text-[#E0F2F9]">{{t 'test.home.programSection.bannerDescription'}}</p>
        {{> components/ui/button/consultation/index
            phone=social.[0].number
            variant="solid"
            roundedClass="rounded-lg"
            text=(t 'test.home.programSection.bannerCta')
            class="self-start px-6 py-3 font-montserrat text-sm" }}
      </div>
    </div>
  </div>
</section>
