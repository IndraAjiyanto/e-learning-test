{{!-- 
  Section: Alumni (L2 Section) - reusable untuk home & paid/free/special program
  Lokasi: src/views/partials/components/ui/sections/alumni/index.hbs
  Level: L2 Section
  Desain: Figma "testimonials-section" (node 250:2970)

  Struktur: blok MOBILE (block sm:hidden) + blok DESKTOP (hidden sm:block)
  dalam 1 file, sesuai pedoman §7 & §9.6. Markup bersama diangkat jadi
  inline partial (_alumni_header, _alumni_grid, _alumni_footer) yang dipanggil
  dua kali dengan prop ukuran berbeda — jadi tidak ada duplikasi struktur.

  Props (opsional, default = home agar backward-compatible):
  - headerVariant      : 'home' | 'paid' (default: 'home')
  - badgeKey, titleKey, descKey, footerTextKey, footerLinkTextKey : i18n keys
  - showMobile         : boolean (default: true) — render blok mobile
  - showDesktop        : boolean (default: true) — render blok desktop
  - sectionClass       : override kelas section desktop
  - mobileSectionClass : override kelas section mobile
  - desktopBgStyle     : inline style background section desktop
  - mobileBgStyle      : inline style background section mobile
  - alumni, category, lang : data dari controller
--}}

{{!-- ============ HEADER (dipakai blok mobile & desktop) ============ --}}
{{!--
  Params: wrapperClass, titleClass, descClass, dividerClass
--}}
{{#*inline "_alumni_header"}}
  {{#if (eq (default headerVariant 'home') 'paid')}}
    <!-- Header varian paid/free/special (stabilo highlight) -->
    <div class="relative z-10 flex w-full flex-col items-center gap-[16px] text-center {{wrapperClass}}">
      {{!-- title & description = 1 grup rapat (8px); jarak antar grup tetap 16px --}}
      <div class="flex w-full flex-col items-center gap-[8px]">
        <h2 class="flex flex-wrap items-center justify-center gap-2 font-montserrat font-semibold tracking-tight text-[#000000] {{titleClass}}">
          <span>{{t (default titleKey 'test.categoryPaidProgram.alumni.title')}}</span>
          <span 
            class="relative my-1 inline-flex items-center justify-center overflow-hidden align-middle"
            x-data="{
              isHighlighted: false,
              init() {
                const observer = new IntersectionObserver((entries) => {
                  entries.forEach(entry => {
                    if (entry.isIntersecting) { this.isHighlighted = true; }
                  });
                }, { threshold: 0.4, rootMargin: '0px 0px -50px 0px' });
                observer.observe(this.$el);
              }
            }"
          >
            <span class="whitespace-nowrap px-3 py-1 font-montserrat font-semibold opacity-0 sm:px-4 sm:py-1.5 {{titleClass}}">
              Alumni {{category.name}}
            </span>
            <span 
              class="pointer-events-none absolute inset-y-0 left-0 flex items-center justify-center overflow-hidden whitespace-nowrap rounded-[8px] bg-[#003060] shadow-md transition-all duration-[800ms] ease-out sm:rounded-[10px]"
              :class="isHighlighted ? 'w-full' : 'w-0'"
            >
              <span class="min-w-max whitespace-nowrap px-3 py-1 font-montserrat font-semibold text-white sm:px-4 sm:py-1.5 {{titleClass}}">
                Alumni {{category.name}}
              </span>
            </span>
          </span>
        </h2>
        <p class="font-sans font-normal leading-[1.6] text-[#4A5568] {{descClass}}">
          {{t (default descKey 'test.categoryPaidProgram.alumni.description')}} {{category.name}}.
        </p>
      </div>
      <div class="rounded-[2px] bg-[#003060] {{default dividerClass 'h-[4px] w-[60px]'}}"></div>
    </div>
  {{else}}
    <!-- Header varian home — struktur Figma "section-header": badge > heading > subheading > accent-line, gap 16px -->
    <div class="relative z-10 flex w-full flex-col items-center gap-[16px] {{wrapperClass}}">
      {{> components/ui/text/badge/index
          text=(t (default badgeKey 'test.home.alumniSection.badge'))
          variant='section'
      }}

      {{!-- title & description = 1 grup rapat (8px); jarak antar grup tetap 16px --}}
      <div class="flex w-full flex-col items-center gap-[8px]">
        {{> components/ui/text/section_header/index
            title=(t (default titleKey 'test.home.alumniSection.title'))
            titleTag='h2'
            align='text-center'
            titleClass=titleClass
        }}

        {{> components/ui/text/description/index
            text=(t (default descKey 'test.home.alumniSection.description'))
            size=descSize
            color="text-[#4A5568]"
            align="center"
            font="sans"
            class=descClass
        }}
      </div>

      <div class="rounded-[2px] bg-[#003060] {{default dividerClass 'h-[4px] w-[60px]'}}"></div>
    </div>
  {{/if}}
{{/inline}}

{{!-- ============ GRID + PAGINATION ============ --}}
{{!--
  Params: gridClass (jumlah kolom), navBtnClass (ukuran tombol prev/next)
  Catatan: jumlah kolom di sini HARUS sinkron dengan `syncPerPage()` di
  src/common/public/js/testimonial-carousel.js (1 kol < 640px, 2 kol < 1024px, 3 kol >= 1024px).
--}}
{{#*inline "_alumni_grid"}}
  <div class="relative z-10 mx-auto flex w-full max-w-[1760px] flex-col gap-10">
    <div class="grid items-stretch gap-6 {{default gridClass 'grid-cols-1'}}">
      <template x-for="(item, index) in visible" :key="'alumni-' + page + '-' + (item.id || index)">
        <div class="h-full animate-fadeInUp motion-reduce:animate-none" :style="`animation-delay: ${index * 90}ms`">
          {{> components/ui/card/card_alumni/index variant="profile" isDesktop=true}}
        </div>
      </template>
    </div>

    <div class="flex items-center justify-center gap-6" x-show="totalPages > 1">
      <button
        type="button"
        class="flex items-center justify-center rounded-[20px] border border-[#F3F4F6] bg-white text-[#0B1F3B] shadow-sm transition-all hover:border-[#003060] hover:text-[#003060] {{default navBtnClass 'h-[62px] w-[62px]'}}"
        @click="prev()"
        aria-label="Previous alumni"
      >
        <i class="fas fa-chevron-left text-base"></i>
      </button>

      <div class="flex items-center gap-3">
        <template x-for="(dot, index) in totalPages" :key="'alumni-dot-' + index">
          <button
            type="button"
            class="h-2 w-2 rounded-full transition-all duration-300"
            :class="page === index ? 'bg-[#003060] scale-125' : 'bg-[#D9D9D9] hover:bg-[#B8B8B8]'"
            @click="goTo(index)"
            :aria-label="'Go to page ' + (index + 1)"
          ></button>
        </template>
      </div>

      <button
        type="button"
        class="flex items-center justify-center rounded-[20px] border border-[#F3F4F6] bg-white text-[#0B1F3B] shadow-sm transition-all hover:border-[#003060] hover:text-[#003060] {{default navBtnClass 'h-[62px] w-[62px]'}}"
        @click="next()"
        aria-label="Next alumni"
      >
        <i class="fas fa-chevron-right text-base"></i>
      </button>
    </div>
  </div>
{{/inline}}

{{!-- ============ FOOTER (teks + link "lihat semua") ============ --}}
{{!--
  Params: textClass, linkClass
--}}
{{#*inline "_alumni_footer"}}
  <div class="relative z-10 mt-12 text-center">
    {{#if (eq (default headerVariant 'home') 'paid')}}
      <p class="mb-3 font-sans font-normal text-[#4A5568] {{textClass}}">
        {{t (default footerTextKey 'test.categoryPaidProgram.alumni.footer')}}
      </p>
      <a href="/dashboard/alumni" class="inline-flex items-center gap-2 font-sans font-medium text-[#003060] hover:underline {{linkClass}}">
        {{t (default footerLinkTextKey 'test.categoryPaidProgram.alumni.allStories')}}
        <i class="fas fa-arrow-right text-sm"></i>
      </a>
    {{else}}
      <a href="/dashboard/alumni" class="inline-flex items-center gap-2 font-sans font-medium text-[#003060] hover:underline {{linkClass}}">
        {{t (default footerLinkTextKey 'test.home.alumniSection.seeAll')}}
        <i class="fas fa-arrow-right text-sm"></i>
      </a>
    {{/if}}
  </div>
{{/inline}}

{{#if (ternary (eq showMobile undefined) true showMobile)}}
<!-- ================= MOBILE ALUMNI SECTION (< 640px) ================= -->
<section
  class="{{default mobileSectionClass 'block sm:hidden py-12 px-5 relative overflow-hidden bg-white w-full'}}"
  style="{{mobileBgStyle}}"
  x-data="alumniGrid(window.__alumniCarousel)"
>
  {{> _alumni_header
      wrapperClass="mb-[40px]"
      titleClass="font-montserrat font-bold text-[24px] text-[#0B1F3B] text-center"
      descSize="text-sm"
      descClass="font-normal !leading-[1.6] max-w-[542px]"
      dividerClass="h-[4px] w-[60px]"
  }}

  {{> _alumni_grid gridClass="grid-cols-1" navBtnClass="h-[52px] w-[52px]"}}

  {{> _alumni_footer textClass="text-sm" linkClass="text-sm"}}
</section>
{{/if}}

{{#if (ternary (eq showDesktop undefined) true showDesktop)}}
<!-- ================= DESKTOP ALUMNI SECTION (>= 640px) ================= -->
<section
  class="{{default sectionClass 'hidden sm:block py-16 sm:py-24 relative overflow-hidden bg-white'}}"
  style="{{default desktopBgStyle (ternary (eq (default headerVariant 'home') 'paid') 'background: linear-gradient(122.58deg, rgba(220, 220, 220, 0.5) -3.76%, #CEE6F6 79.97%);' '')}}"
  x-data="alumniGrid(window.__alumniCarousel)"
>
  <div class="page-shell">
    {{> _alumni_header
        wrapperClass="mb-[64px]"
        titleClass="font-montserrat font-bold text-[32px] lg:text-[36px] text-[#0B1F3B] text-center"
        descSize="text-lg lg:text-[20px]"
        descClass="font-normal !leading-[1.6] max-w-[542px] lg:max-w-[592px]"
        dividerClass="h-[4px] w-[60px]"
    }}

    {{> _alumni_grid gridClass="grid-cols-2 lg:grid-cols-3" navBtnClass="h-[78px] w-[78px]"}}

    {{> _alumni_footer textClass="text-base md:text-xl" linkClass="text-base md:text-lg"}}
  </div>
</section>
{{/if}}

<script>
  window.__alumniCarousel = [
    {{#each alumni}}
    {
      id: '{{this.id}}',
      name: {{{json (getByLang this.name ../lang)}}},
      position: {{{json (getByLang this.currentPosition ../lang)}}},
      company: {{{json (default this.course.name '')}}},
      photo: {{{json (default this.profile '')}}},
      testimonial: {{{json (getByLang this.message ../lang)}}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ];
</script>
