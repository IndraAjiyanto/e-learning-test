{{!-- 
  Section: Alumni (L2 Section) - reusable untuk home & paid/free/special program
  Lokasi: src/views/partials/components/ui/sections/alumni/index.hbs
  Level: L2 Section
  Desain: Figma "testimonials-section" (node 250:2970)

  Struktur: blok MOBILE (block sm:hidden) + blok DESKTOP (hidden sm:block)
  dalam 1 file, sesuai pedoman §7 & §9.6. Markup bersama diangkat jadi
  inline partial (_alumni_header, _alumni_grid, _alumni_footer) yang dipanggil
  dua kali dengan prop ukuran berbeda — jadi tidak ada duplikasi struktur.

  Props (opsional, default = home agar backward-compatible):
  - headerVariant      : 'home' | 'paid' (default: 'home')
  - badgeKey, titleKey, descKey, footerTextKey, footerLinkTextKey : i18n keys
  - showMobile         : boolean (default: true) — render blok mobile
  - showDesktop        : boolean (default: true) — render blok desktop
  - sectionClass       : override kelas section desktop
  - mobileSectionClass : override kelas section mobile
  - desktopBgStyle     : inline style background section desktop
  - mobileBgStyle      : inline style background section mobile
  - alumni, category, lang : data dari controller
--}}

{{!-- ============ HEADER (dipakai blok mobile & desktop) ============ --}}
{{!--
  Params: wrapperClass, titleClass, descClass, dividerClass
--}}
{{#*inline "_alumni_header"}}
  <div class="relative z-10 flex w-full flex-col items-center gap-4 text-center {{wrapperClass}}">
    {{#if (eq (default headerVariant 'home') 'paid')}}
      {{> components/ui/text/eyebrow/index text=(t (default badgeKey 'test.categoryPaidProgram.alumni.badge')) }}
      <h2 class="{{sizeClass (default titleSize 'h2')}} font-montserrat font-bold text-[#0B1F3B] {{titleClass}}">
        {{t (default titleKey 'test.categoryPaidProgram.alumni.title')}} <span class="text-[#6EB6E5]">{{category.name}}</span>
      </h2>
      <p class="{{sizeClass 'body'}} max-w-[592px] font-open-sans text-[#4A5568] {{descClass}}">
        {{t (default descKey 'test.categoryPaidProgram.alumni.description')}} {{category.name}}.
      </p>
    {{else}}
      {{> components/ui/text/eyebrow/index text=(t (default badgeKey 'test.home.alumniSection.badge')) }}
      <h2 class="{{sizeClass (default titleSize 'h2')}} font-montserrat font-bold text-[#0B1F3B] {{titleClass}}">
        {{t (default titleKey 'test.home.alumniSection.title')}}
      </h2>
      <p class="{{sizeClass 'body'}} max-w-[592px] font-open-sans text-[#4A5568] {{descClass}}">
        {{t (default descKey 'test.home.alumniSection.description')}}
      </p>
    {{/if}}
    <div class="rounded-[2px] bg-[#003060] {{default dividerClass 'h-1 w-[60px]'}}"></div>
  </div>
{{/inline}}

{{!-- ============ GRID + PAGINATION ============ --}}
{{!--
  Params: gridClass (jumlah kolom), navBtnClass (ukuran tombol prev/next)
  Catatan: jumlah kolom di sini HARUS sinkron dengan `syncPerPage()` di
  src/common/public/js/testimonial-carousel.js (1 kol < 640px, 2 kol < 1024px, 3 kol >= 1024px).
--}}
{{#*inline "_alumni_grid"}}
  <div class="relative z-10 flex w-full flex-col gap-8">
    {{!-- viewport clips horizontally; generous vertical padding so the raised centre card + its shadow are not cut off --}}
    <div class="-mx-3 overflow-x-hidden px-3 py-10">
      <div
        class="flex transition-transform duration-500 ease-out"
        :style="`transform: translateX(-${active * (100 / per)}%)`"
      >
        <template x-for="(item, i) in items" :key="item.id || i">
          <div class="shrink-0 px-3" :style="`width: ${100 / per}%`">
            <div
              class="h-full rounded-[20px] transition-all duration-500 ease-out"
              :class="i === centerIndex ? '-translate-y-5 shadow-[0_28px_56px_-16px_rgba(11,31,59,0.22)]' : 'shadow-[0_10px_28px_-12px_rgba(11,31,59,0.08)] lg:opacity-90'"
            >
              {{> components/ui/card/card_alumni/index variant="profile" isDesktop=true}}
            </div>
          </div>
        </template>
      </div>
    </div>

    {{> components/ui/nav/carousel_nav/index count="dots" index="active" goTo="goTo" goPrev="prev()" goNext="next()" }}
  </div>
{{/inline}}

{{!-- ============ FOOTER (teks + link "lihat semua") ============ --}}
{{!--
  Params: textClass, linkClass
--}}
{{#*inline "_alumni_footer"}}
  <div class="relative z-10 mt-12 text-center">
    {{#if (eq (default headerVariant 'home') 'paid')}}
      <p class="mb-3 font-sans font-normal text-[#4A5568] {{textClass}}">
        {{t (default footerTextKey 'test.categoryPaidProgram.alumni.footer')}}
      </p>
      <a href="/dashboard/alumni" class="inline-flex items-center gap-2 font-sans font-medium text-[#003060] hover:underline {{linkClass}}">
        {{t (default footerLinkTextKey 'test.categoryPaidProgram.alumni.allStories')}}
        <i class="fas fa-arrow-right text-sm"></i>
      </a>
    {{else}}
      <a href="/dashboard/alumni" class="inline-flex items-center gap-2 font-sans font-medium text-[#003060] hover:underline {{linkClass}}">
        {{t (default footerLinkTextKey 'test.home.alumniSection.seeAll')}}
        <i class="fas fa-arrow-right text-sm"></i>
      </a>
    {{/if}}
  </div>
{{/inline}}

<!-- ================= ALUMNI SECTION (satu pohon, base + lg) ================= -->
<section
  class="{{default sectionClass 'w-full relative overflow-hidden bg-white py-14 lg:py-24'}}"
  style="{{default desktopBgStyle (ternary (eq (default headerVariant 'home') 'paid') 'background: linear-gradient(122.58deg, rgba(220, 220, 220, 0.5) -3.76%, #CEE6F6 79.97%);' '')}}"
  x-data="alumniDeck(window.__alumniCarousel)"
>
  <div class="page-shell">
    {{> _alumni_header
        wrapperClass="mb-12 lg:mb-16"
        titleSize="h2"
        titleClass="font-montserrat font-bold text-[#0B1F3B] text-center"
        descSize="body"
        descClass="font-normal max-w-[592px]"
        dividerClass="h-1 w-[60px]"
    }}

    {{> _alumni_grid gridClass="grid-cols-1 sm:grid-cols-2 lg:grid-cols-3" navBtnClass="h-14 w-14 lg:h-[72px] lg:w-[72px]"}}

    {{> _alumni_footer textClass="text-sm lg:text-base" linkClass="text-sm lg:text-base"}}
  </div>
</section>

<script>
  window.__alumniCarousel = [
    {{#each alumni}}
    {
      id: '{{this.id}}',
      name: {{{json (getByLang this.name ../lang)}}},
      position: {{{json (getByLang this.currentPosition ../lang)}}},
      company: {{{json (default this.course.name '')}}},
      photo: {{{json (default this.profile '')}}},
      testimonial: {{{json (getByLang this.message ../lang)}}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ];
</script>
