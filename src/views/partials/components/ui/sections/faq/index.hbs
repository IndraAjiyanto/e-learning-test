{{!--
  Section: FAQ (L2) - Figma faq-section 250:3103 - reusable (home + program)
  Lokasi: src/views/partials/components/ui/sections/faq/index.hbs
  Satu pohon markup, base + lg. Data: faq[] (landing) atau faqs[] (kategori), fallback statis.
--}}
<section
  id="faq"
  class="w-full overflow-hidden bg-[#F8F9FA] py-14 font-montserrat lg:py-20"
  x-data="{
    isVisible: false,
    activeIndex: 0,
    faqs: [
      {{#if faqs.length}}
        {{#each faqs}}{ question: `{{getByLang question ../lang}}`, answer: `{{getByLang answer ../lang}}` }{{#unless @last}},{{/unless}}{{/each}}
      {{else if faq.length}}
        {{#each faq}}{ question: `{{getByLang question ../lang}}`, answer: `{{getByLang answer ../lang}}` }{{#unless @last}},{{/unless}}{{/each}}
      {{else}}
        { question: 'What will I learn in this bootcamp?', answer: 'You will learn hands-on industry skills, tools, and methodologies to build real-world projects and accelerate your career.' },
        { question: 'Is the bootcamp online or offline?', answer: 'We offer flexible options: interactive live online classes and hybrid offline sessions depending on your program.' },
        { question: 'Do I need prior programming experience?', answer: 'No prior experience required. We welcome beginners and guide you step by step from the basics.' },
        { question: 'Will I receive a certificate after completing the bootcamp?', answer: 'Yes. On completing the coursework and capstone project you receive an official certificate of completion.' },
        { question: 'What if I miss a class?', answer: 'All live sessions are recorded and available on the learning platform so you can catch up anytime.' },
        { question: 'How can I register?', answer: 'Register through our website by choosing your program and completing the enrollment form.' },
        { question: 'Is there career support after graduation?', answer: 'Yes: resume reviews, portfolio building, mock interviews, and hiring-partner connections.' }
      {{/if}}
    ],
    toggle(index) { this.activeIndex = this.activeIndex === index ? null : index; },
    init() {
      const io = new IntersectionObserver((e) => { e.forEach(x => { if (x.isIntersecting) this.isVisible = true; }); }, { threshold: 0.2, rootMargin: '0px 0px -100px 0px' });
      io.observe(this.$el);
    }
  }"
>
  <div class="page-shell flex flex-col items-center gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-16">

    {{!-- Left: heading --}}
    <div
      class="flex w-full flex-col items-center text-center transition-all duration-700 ease-out lg:w-5/12 lg:items-start lg:text-left"
      :class="isVisible ? 'translate-x-0 opacity-100' : 'lg:-translate-x-16 lg:opacity-0'"
    >
      {{#> components/ui/text/section_header/index
          align="text-center lg:text-left"
          badge=(t 'test.home.faq.question')
          titleTag="h2"
          titleSize="h2"
          titleClass="font-montserrat font-bold"
          showDivider=true
          dividerClass="w-[70px] h-1.5 bg-[#0B1F3B] mt-3 mb-6 mx-auto lg:mx-0"
          descSize="body"
          description=(t 'test.home.faq.description')
          descClass="font-open-sans text-[#545454] max-w-sm" }}
        {{#*inline "titleBlock"}}
          <span class="block text-[#0F0F0F]">{{t 'test.home.faq.title'}}</span>
          <span class="block text-[#6EB6E5]">{{t 'test.home.faq.title2'}}</span>
        {{/inline}}
      {{/components/ui/text/section_header/index}}
    </div>

    {{!-- Right: accordion --}}
    <div
      class="w-full transition-all delay-200 duration-700 ease-out lg:w-7/12"
      :class="isVisible ? 'translate-y-0 opacity-100' : 'lg:translate-y-16 lg:opacity-0'"
    >
      <div class="flex flex-col border-t border-[#E0E0E0]">
        <template x-for="(faq, index) in faqs" :key="index">
          {{> components/ui/accordion/faq/index }}
        </template>
      </div>
    </div>
  </div>
</section>
