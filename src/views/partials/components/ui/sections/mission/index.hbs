{{!--
  Section: Vision & Mission (tab halaman About) - Figma 250:883
  Lokasi: src/views/partials/components/ui/sections/mission/index.hbs

  Data (dari controller dashboard.about()):
  - visions : 1 baris, visions.[0].visions = jsonb per-bahasa (getByLang ... lang)
  - mission : N baris urut missionOrder, tiap baris content (lead) + items (body), jsonb per-bahasa

  Responsive: satu pohon markup yang mengalir (grid-cols-1 -> lg:grid 2 kolom).
  L1: text/section_header, sections/mission/mission_item
--}}

<div
  x-transition:enter='transition ease-out duration-300'
  x-transition:enter-start='opacity-0 transform translate-y-4'
  x-transition:enter-end='opacity-100 transform translate-y-0'
  class="w-full font-inter"
>
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[2fr_3fr] lg:gap-12">

    {{!-- Vision --}}
    <div class="min-w-0">
      {{> components/ui/text/section_header/index
          align="text-left"
          titleTag="h2"
          titleSize="display"
          title=(t 'test.about.visionsMisi.vision')
          titleClass="font-inter font-bold tracking-[-0.02em] text-[#003060]"
          showDivider=true
          dividerClass="w-full h-px bg-[#E2E8F0] mt-3 mb-5 lg:mt-4 lg:mb-6" }}

      <div class="rounded-2xl border border-[#E2E8F0] bg-white p-6 lg:p-8 shadow-[0px_8px_24px_0px_rgba(0,0,0,0.05)]">
        <p class="{{sizeClass 'lead'}} font-inter font-medium tracking-[-0.01em] text-[#0B1F3B]">
          {{#if visions.length}}
            {{getByLang visions.[0].visions lang}}
          {{else}}
            To become a leading digital education institution that nurtures outstanding information technology talents job-ready and globally competitive to drive Indonesia's digital transformation.
          {{/if}}
        </p>
      </div>
    </div>

    {{!-- Mission --}}
    <div class="min-w-0">
      {{> components/ui/text/section_header/index
          align="text-left"
          titleTag="h2"
          titleSize="display"
          title=(t 'test.about.visionsMisi.mission')
          titleClass="font-inter font-bold tracking-[-0.02em] text-[#003060]"
          showDivider=true
          dividerClass="w-full h-px bg-[#E2E8F0] mt-3 mb-1 lg:mt-4 lg:mb-2" }}

      <div class="divide-y divide-[#E2E8F0] border-b border-[#E2E8F0]">
        {{#if mission.length}}
          {{#each mission}}
            {{> components/ui/sections/mission/mission_item
                number=(addOne @index)
                lead=(getByLang content ../lang)
                body=(getByLang items ../lang) }}
          {{/each}}
        {{else}}
          {{> components/ui/sections/mission/mission_item number="1" lead="To Become a Leading Provider:" body="of digital education that continuously innovates in line with advancements in information technology." }}
          {{> components/ui/sections/mission/mission_item number="2" lead="To Develop Exceptional Human Resources:" body="equipped with both technical expertise and soft skills that meet industry demands." }}
          {{> components/ui/sections/mission/mission_item number="3" lead="To Prepare Job-Ready Graduates:" body="through practical learning programs and professional mentoring." }}
          {{> components/ui/sections/mission/mission_item number="4" lead="To Build a Globally Competitive Generation:" body="with internationally recognized digital competencies." }}
          {{> components/ui/sections/mission/mission_item number="5" lead="To Accelerate Digital Transformation:" body="by cultivating impactful and valuable talents." }}
        {{/if}}
      </div>
    </div>

  </div>
</div>
