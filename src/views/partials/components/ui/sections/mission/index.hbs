<!-- Vision & Mission Section -->
<div
  x-transition:enter='transition ease-out duration-300'
  x-transition:enter-start='opacity-0 transform translate-y-4'
  x-transition:enter-end='opacity-100 transform translate-y-0'
>
  <!-- MOBILE VISION & MISSION TAB (< 640px) -->
  <div class="block sm:hidden w-full relative font-montserrat overflow-hidden">
    <!-- Header Title & Divider -->
    {{> components/ui/text/section_header/index
        align="text-left"
        wrapperClass="mb-6"
        title=(t 'test.about.visionsMisi.title')
        titleClass="font-montserrat font-bold text-[24px] leading-[34px] text-[#003060]"
        showDivider=true
        dividerClass="w-full h-[2px] bg-[#6EB6E5] mt-2 mb-0"
    }}

    <!-- Vision Card Mobile -->
    <div class="bg-[#E0F1F9]/65 backdrop-blur-[6.6px] border border-[#E0F1F9] rounded-[20px] p-6 shadow-[0px_4px_12px_0px_#00000010] mb-6">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-12 h-12 bg-[#003060] rounded-full flex items-center justify-center text-white shrink-0 shadow-sm">
          <img src="/public/image/about/vision/ourVision.svg" alt="Our Vision" class="w-6 h-6 object-contain brightness-0 invert" onerror="this.onerror=null; this.src='/public/image/about/story/inclusive.svg';" />
        </div>
        <div>
          <h3 class="font-montserrat font-bold text-[20px] leading-none text-[#0B1F3B]">
            {{t 'test.about.visionsMisi.visions'}}
          </h3>
          <div class="w-10 h-[3px] bg-[#003060] rounded-full mt-1.5"></div>
        </div>
      </div>
      <p class="font-sans font-normal text-[14px] leading-[24px] text-[#000000CC]">
        {{#if visions.length}}
          {{getByLang visions.[0].visions lang}}
        {{else}}
          To become a leading digital education institution that nurtures outstanding information technology talents job-ready and globally competitive to drive Indonesia's digital transformation.
        {{/if}}
      </p>
    </div>

    <!-- Mission Card Mobile -->
    <div class="bg-[#E0F1F9]/65 backdrop-blur-[6.6px] border border-[#E0F1F9] rounded-[20px] p-6 shadow-[0px_4px_12px_0px_#00000010]">
      <div class="flex items-center gap-4 mb-5">
        <div class="w-12 h-12 bg-[#003060] rounded-full flex items-center justify-center text-white shrink-0 shadow-sm">
          <img src="/public/image/about/vision/ourMission.svg" alt="Our Mission" class="w-6 h-6 object-contain brightness-0 invert" onerror="this.onerror=null; this.src='/public/image/about/story/inclusive.svg';" />
        </div>
        <div>
          <h3 class="font-montserrat font-bold text-[20px] leading-none text-[#0B1F3B]">
            {{t 'test.about.visionsMisi.missions'}}
          </h3>
          <div class="w-10 h-[3px] bg-[#003060] rounded-full mt-1.5"></div>
        </div>
      </div>

      <ul class="space-y-4">
        {{#if mission.length}}
          {{#each mission}}
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full text-[#003060] flex items-center justify-center shrink-0 mt-0.5 text-base">
                <i class="far fa-check-circle"></i>
              </div>
              <p class="font-sans font-normal text-[14px] leading-[22px] text-[#000000CC]">
                <strong class="font-semibold text-[#003060]">{{getByLang content ../lang}}:</strong>
                {{getByLang items ../lang}}
              </p>
            </li>
          {{/each}}
        {{else}}
          <!-- Item 1 -->
          <li class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full text-[#003060] flex items-center justify-center shrink-0 mt-0.5 text-base">
              <i class="far fa-check-circle"></i>
            </div>
            <p class="font-sans font-normal text-[14px] leading-[22px] text-[#000000CC]">
              <strong class="font-semibold text-[#003060]">To Become a Leading Provider:</strong>
              of digital education that continuously innovates in line with advancements in information technology.
            </p>
          </li>
          <!-- Item 2 -->
          <li class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full text-[#003060] flex items-center justify-center shrink-0 mt-0.5 text-base">
              <i class="far fa-check-circle"></i>
            </div>
            <p class="font-sans font-normal text-[14px] leading-[22px] text-[#000000CC]">
              <strong class="font-semibold text-[#003060]">To Develop Exceptional Human Resources:</strong>
              equipped with both technical expertise and soft skills that meet industry demands.
            </p>
          </li>
          <!-- Item 3 -->
          <li class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full text-[#003060] flex items-center justify-center shrink-0 mt-0.5 text-base">
              <i class="far fa-check-circle"></i>
            </div>
            <p class="font-sans font-normal text-[14px] leading-[22px] text-[#000000CC]">
              <strong class="font-semibold text-[#003060]">To Prepare Job-Ready Graduates:</strong>
              through practical learning programs and professional mentoring.
            </p>
          </li>
          <!-- Item 4 -->
          <li class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full text-[#003060] flex items-center justify-center shrink-0 mt-0.5 text-base">
              <i class="far fa-check-circle"></i>
            </div>
            <p class="font-sans font-normal text-[14px] leading-[22px] text-[#000000CC]">
              <strong class="font-semibold text-[#003060]">To Build a Globally Competitive Generation:</strong>
              with internationally recognized digital competencies.
            </p>
          </li>
          <!-- Item 5 -->
          <li class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full text-[#003060] flex items-center justify-center shrink-0 mt-0.5 text-base">
              <i class="far fa-check-circle"></i>
            </div>
            <p class="font-sans font-normal text-[14px] leading-[22px] text-[#000000CC]">
              <strong class="font-semibold text-[#003060]">To Accelerate Digital Transformation:</strong>
              by cultivating impactful and valuable talents.
            </p>
          </li>
        {{/if}}
      </ul>
    </div>
  </div>

  <!-- DESKTOP VISION & MISSION TAB (>= 640px) -->
  <div class="hidden sm:block">
    {{> components/ui/text/section_header/index
        align="text-left"
        wrapperClass="mb-6 sm:mb-8"
        title=(t 'test.about.visionsMisi.title')
        titleClass="text-3xl sm:text-4xl font-bold text-[#003060] mb-8 font-montserrat"
        showDivider=false
    }}

    <!-- Vision Card -->
    <div class='bg-[#E0F1F9]/50 p-6 sm:p-8 rounded-2xl border border-sky-100 shadow-sm mb-8'>
      <div class='flex items-start gap-5 sm:gap-6'>
        <div class='w-12 h-12 sm:w-14 sm:h-14 bg-[#003060] rounded-full flex items-center justify-center text-white flex-shrink-0 shadow-sm text-xl'>
          <img src="/public/image/about/vision/ourVision.svg" alt="Our Vision" class="w-7 h-7 object-contain" />
        </div>
        <div class='flex-1'>
          <h3 class='text-2xl sm:text-3xl font-bold text-[#0B1F3B] mb-2 font-montserrat leading-none tracking-normal'>
            {{t 'test.about.visionsMisi.visions'}}
          </h3>
          <div class='w-11 h-1 bg-[#003060] rounded-full mb-4'></div>
          <p class='text-[#000000CC] text-lg sm:text-xl leading-[35px] tracking-normal font-sans font-normal'>
            {{#if visions.length}}
              {{getByLang visions.[0].visions lang}}
            {{else}}
              To become a leading digital education institution that nurtures outstanding information technology talents job-ready and globally competitive to drive Indonesia's digital transformation.
            {{/if}}
          </p>
        </div>
      </div>
    </div>

    <!-- Mission Card -->
    <div class='bg-[#E0F1F9]/50 p-6 sm:p-8 rounded-2xl border border-sky-100 shadow-sm'>
      <div class='flex items-start gap-5 sm:gap-6'>
        <div class='w-12 h-12 sm:w-14 sm:h-14 bg-[#003060] rounded-full flex items-center justify-center text-white flex-shrink-0 shadow-sm text-xl'>
          <img src="/public/image/about/vision/ourMission.svg" alt="Our Mission" class="w-7 h-7 object-contain" />
        </div>
        <div class='flex-1'>
          <h3 class='text-2xl sm:text-3xl font-bold text-[#0B1F3B] mb-2 font-montserrat leading-none tracking-normal'>
            {{t 'test.about.visionsMisi.missions'}}
          </h3>
          <div class='w-11 h-1 bg-[#003060] rounded-full mb-4'></div>
          
          <ul class='space-y-4 sm:space-y-5'>
            {{#if mission.length}}
              {{#each mission}}
                <li class='flex items-start space-x-3.5'>
                  <div class='w-6 h-6 rounded-full bg-[#003060] text-white flex items-center justify-center flex-shrink-0 text-xs mt-1'>
                    <i class='fas fa-check'></i>
                  </div>
                  <p class='text-[#000000CC] text-lg sm:text-xl leading-[35px] tracking-normal font-sans font-normal'>
                    <strong class='font-semibold text-[#000000CC]'>{{getByLang content ../lang}}:</strong>
                    {{getByLang items ../lang}}
                  </p>
                </li>
              {{/each}}
            {{else}}
              <!-- Item 1 -->
              <li class='flex items-start space-x-3.5'>
                <div class='w-6 h-6 rounded-full bg-[#003060] text-white flex items-center justify-center flex-shrink-0 text-xs mt-1'>
                  <i class='fas fa-check'></i>
                </div>
                <p class='text-[#000000CC] text-lg sm:text-xl leading-[35px] tracking-normal font-sans font-normal'>
                  <strong class='font-semibold text-[#003060]'>To Become a Leading Provider:</strong>
                  of digital education that continuously innovates in line with advancements in information technology.
                </p>
              </li>

              <!-- Item 2 -->
              <li class='flex items-start space-x-3.5'>
                <div class='w-6 h-6 rounded-full bg-[#003060] text-white flex items-center justify-center flex-shrink-0 text-xs mt-1'>
                  <i class='fas fa-check'></i>
                </div>
                <p class='text-[#000000CC] text-lg sm:text-xl leading-[35px] tracking-normal font-sans font-normal'>
                  <strong class='font-semibold text-[#003060]'>To Develop Exceptional Human Resources:</strong>
                  equipped with both technical expertise and soft skills that meet industry demands.
                </p>
              </li>

              <!-- Item 3 -->
              <li class='flex items-start space-x-3.5'>
                <div class='w-6 h-6 rounded-full bg-[#003060] text-white flex items-center justify-center flex-shrink-0 text-xs mt-1'>
                  <i class='fas fa-check'></i>
                </div>
                <p class='text-[#000000CC] text-lg sm:text-xl leading-[35px] tracking-normal font-sans font-normal'>
                  <strong class='font-semibold text-[#003060]'>To Prepare Job-Ready Graduates:</strong>
                  through practical learning programs and professional mentoring.
                </p>
              </li>

              <!-- Item 4 -->
              <li class='flex items-start space-x-3.5'>
                <div class='w-6 h-6 rounded-full bg-[#003060] text-white flex items-center justify-center flex-shrink-0 text-xs mt-1'>
                  <i class='fas fa-check'></i>
                </div>
                <p class='text-[#000000CC] text-lg sm:text-xl leading-[35px] tracking-normal font-sans font-normal'>
                  <strong class='font-semibold text-[#003060]'>To Build a Globally Competitive Generation:</strong>
                  with internationally recognized digital competencies.
                </p>
              </li>

              <!-- Item 5 -->
              <li class='flex items-start space-x-3.5'>
                <div class='w-6 h-6 rounded-full bg-[#003060] text-white flex items-center justify-center flex-shrink-0 text-xs mt-1'>
                  <i class='fas fa-check'></i>
                </div>
                <p class='text-[#000000CC] text-lg sm:text-xl leading-[35px] tracking-normal font-sans font-normal'>
                  <strong class='font-semibold text-[#003060]'>To Accelerate Digital Transformation:</strong>
                  by cultivating impactful and valuable talents.
                </p>
              </li>
            {{/if}}
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>