{{!--
  Section: Paid Advantage - "Core Knowledge First" (L2) - reskin ke standar internal.
  Lokasi: src/views/partials/components/ui/sections/paid_advantage/index.hbs
  4 poin keunggulan (teks statis dari i18n). .page-shell, sizeClass.
--}}
<section id="advantage" class="w-full bg-[#F8F9FA] py-14 font-montserrat lg:py-20">
  <div class="page-shell">
    <div class="flex flex-col gap-8 rounded-3xl border border-[#E5E7EB] bg-white p-8 shadow-[0px_12px_32px_-12px_rgba(11,31,59,0.08)] lg:p-12">

      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-4">
          <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-[#E0F2F9] text-[#003060]">
            <i class="fas fa-lightbulb text-lg" aria-hidden="true"></i>
          </span>
          <h2 class="{{sizeClass 'h2'}} font-montserrat font-bold text-[#0B1F3B]">{{t 'test.categoryPaidProgram.advantage.title'}}</h2>
        </div>
        <p class="{{sizeClass 'lead'}} font-open-sans text-[#4A5568]">{{t 'test.categoryPaidProgram.advantage.description'}}</p>
      </div>

      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {{#each (array
          (t 'test.categoryPaidProgram.advantage.point1')
          (t 'test.categoryPaidProgram.advantage.point2')
          (t 'test.categoryPaidProgram.advantage.point3')
          (t 'test.categoryPaidProgram.advantage.point4')
        )}}
          <li class="flex items-start gap-3 rounded-2xl border border-[#E5E7EB] bg-[#F8FAFC] p-4">
            <i class="fas fa-circle-check mt-0.5 shrink-0 text-[#0284C7]" aria-hidden="true"></i>
            <span class="{{sizeClass 'body'}} font-open-sans text-[#374151]">{{this}}</span>
          </li>
        {{/each}}
      </ul>
    </div>
  </div>
</section>
