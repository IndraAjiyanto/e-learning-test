<section id="faq" class="bg-white py-16 lg:py-20" x-data='{ activeIndex: 0, faqs: {{json faqs}} }'><div class="mx-auto flex max-w-[820px] flex-col items-center gap-9 px-4 sm:px-6"><div class="flex flex-col items-center gap-3 text-center"><span class="rounded-full border border-[#E5E7EB] bg-[#F8F9FA] px-4 py-1.5 text-xs font-bold uppercase tracking-[0.15em] text-[#0B1F3B]"><i class="fas fa-circle mr-2 text-[9px] text-[#6EB6E5]"></i>Pertanyaan</span><h2 class="text-2xl font-bold text-[#0B1F3B] sm:text-3xl">Pertanyaan yang Sering Diajukan</h2><p class="text-sm text-[#6B7280]">Seputar pelatihan untuk perusahaan, kampus, dan institusi.</p></div><div class="flex w-full flex-col gap-3"><template x-for="(item, index) in faqs" :key="index"><div class="overflow-hidden rounded-2xl border border-[#E5E7EB] bg-white"><button type="button" @click="activeIndex = activeIndex === index ? null : index" class="flex min-h-[60px] w-full items-center justify-between gap-4 px-5 py-3.5 text-left font-semibold text-[#0B1F3B]"><span x-text="item.question"></span><span class="grid size-7 shrink-0 place-items-center rounded-full bg-[#E4F1F7] text-lg text-[#003060]" x-text="activeIndex === index ? '−' : '+'"></span></button><div x-show="activeIndex === index" x-collapse><p class="px-5 pb-5 text-sm leading-relaxed text-[#4A5568]" x-text="item.answer"></p></div></div></template></div></div></section>