<section class="bg-white py-16 lg:py-20"><div class="page-shell flex flex-col items-center gap-10"><div class="flex max-w-[680px] flex-col items-center gap-3 text-center"><h2 class="text-2xl font-bold text-[#111827] sm:text-3xl">{{{t 'test.corporateTraining.flow.title'}}}</h2><p class="text-sm text-[#6B7280]">{{t 'test.corporateTraining.flow.description'}}</p></div><div class="grid w-full gap-6 sm:grid-cols-2 lg:grid-cols-4">{{#each (array (array (t 'test.corporateTraining.flow.step1Title') (t 'test.corporateTraining.flow.step1Desc')) (array (t 'test.corporateTraining.flow.step2Title') (t 'test.corporateTraining.flow.step2Desc')) (array (t 'test.corporateTraining.flow.step3Title') (t 'test.corporateTraining.flow.step3Desc')) (array (t 'test.corporateTraining.flow.step4Title') (t 'test.corporateTraining.flow.step4Desc')))}}<article class="flex flex-col gap-3 border-t-[3px] border-[#003060] pt-5"><span class="grid size-10 place-items-center rounded-full bg-[#E4F1F7] font-extrabold text-[#003060]">{{add @index 1}}</span><h3 class="text-lg font-bold text-[#0B1F3B]">{{lookup this 0}}</h3><p class="text-sm leading-relaxed text-[#4A5568]">{{lookup this 1}}</p></article>{{/each}}</div></div></section>