<section id="program" class="bg-white py-16 lg:py-20" x-data='{
  programs: {{json programs}}, activeCategory: "code", selectedNo: 1,
  categories: [{id:"code",label:"Code Class",count:6},{id:"design",label:"Design Class",count:5},{id:"business",label:"Business Class",count:6},{id:"impl",label:"Implementasi ERP",count:1}],
  get visiblePrograms() { return this.programs.filter(program => program.category === this.activeCategory) },
  get selectedProgram() { return this.programs.find(program => program.no === this.selectedNo) || this.visiblePrograms[0] },
  selectCategory(category) { this.activeCategory = category; this.selectedNo = this.programs.find(program => program.category === category).no },
  wa(program) { return "{{#if social.length}}{{waLink social.[0].number}}{{else}}#{{/if}}" + (program ? "?text=" + encodeURIComponent("Halo Kesatria Academy, saya tertarik dengan in house training " + program.name + " dan ingin meminta proposal.") : "") }
}'>
  <div class="page-shell flex flex-col items-center gap-9">
    <div class="flex max-w-[680px] flex-col items-center gap-3 text-center"><h2 class="text-2xl font-bold text-[#111827] sm:text-3xl"><span class="text-[#6EB6E5]">Pilih</span> Program In House Training Anda</h2><p class="text-sm leading-relaxed text-[#6B7280]">Pilih klasifikasi, lalu pilih menu pelatihan yang sesuai dengan tujuan dan kebutuhan tim Anda.</p></div>
    <div class="flex flex-wrap justify-center gap-2" role="group" aria-label="Klasifikasi program"><template x-for="category in categories" :key="category.id"><button type="button" @click="selectCategory(category.id)" :aria-pressed="activeCategory === category.id" :class="activeCategory === category.id ? 'border-[#003060] bg-[#003060] text-white' : 'border-[#E5E7EB] bg-white text-[#0B1F3B]'" class="inline-flex min-h-11 items-center gap-2 rounded-full border px-5 text-sm font-semibold transition hover:border-[#6EB6E5]"><span x-text="category.label"></span><small class="opacity-75" x-text="category.count"></small></button></template></div>
    <div class="grid w-full max-w-[1040px] gap-6 rounded-[20px] border border-[#E5E7EB] bg-white p-5 shadow-[0_10px_24px_-12px_rgba(0,0,0,0.08)] lg:grid-cols-[0.9fr_1.4fr]">
      <div class="flex flex-col gap-2"><template x-for="program in visiblePrograms" :key="program.no"><button type="button" @click="selectedNo = program.no" :aria-pressed="selectedNo === program.no" :class="selectedNo === program.no ? 'border-[#6EB6E5] bg-[#E4F1F7] text-[#003060]' : 'border-transparent bg-white text-[#0B1F3B]'" class="flex min-h-[60px] w-full items-center justify-between gap-3 rounded-xl border px-4 py-2.5 text-left transition hover:border-[#6EB6E5]"><span class="min-w-0"><b class="block text-[15px] leading-tight" x-text="program.name"></b><small class="block text-xs leading-snug text-[#6B7280]" x-text="program.sub"></small></span><b class="shrink-0 text-xs text-[#6B7280]" x-text="String(program.no).padStart(2, '0')"></b></button></template></div>
      <div class="flex min-h-[360px] flex-col gap-4 rounded-2xl border border-[#E5E7EB] bg-[#F8F9FA] p-6 sm:p-7"><div class="flex flex-wrap gap-2"><span class="rounded-full bg-[#E4ECFF] px-3 py-1 text-xs font-bold text-[#1537A8]" x-text="selectedProgram.categoryLabel"></span><span class="rounded-full border border-[#E5E7EB] bg-white px-3 py-1 text-xs font-semibold text-[#4A5568]" x-text="selectedProgram.type"></span></div><div><h3 class="text-2xl font-extrabold leading-tight text-[#0B1F3B]" x-text="selectedProgram.name"></h3><p class="mt-1 font-semibold text-[#2C5C9C]" x-text="selectedProgram.sub"></p></div><p class="text-[15px] leading-relaxed text-[#4A5568]" x-text="selectedProgram.description"></p><div class="flex flex-wrap items-center gap-2 border-t border-[#E5E7EB] pt-4"><span class="mr-1 text-xs font-bold uppercase tracking-wider text-[#6B7280]">Format</span><span class="rounded-full border border-[#E5E7EB] bg-white px-3 py-1 text-xs font-semibold text-[#0B1F3B]"><i class="fas fa-desktop mr-1 text-[#2C5C9C]"></i>Online</span><span class="rounded-full border border-[#E5E7EB] bg-white px-3 py-1 text-xs font-semibold text-[#0B1F3B]"><i class="fas fa-location-dot mr-1 text-[#2C5C9C]"></i>Offline</span></div><div class="mt-auto flex flex-wrap items-center gap-3"><a :href="wa(selectedProgram)" class="inline-flex h-12 items-center rounded-full bg-[#003060] px-6 text-sm font-bold text-white transition hover:-translate-y-0.5" x-text="selectedProgram.cta"></a><span class="text-xs text-[#6B7280]">Konsultasi awal gratis</span></div></div>
    </div>
    <p class="max-w-[640px] text-center text-xs leading-relaxed text-[#6B7280]">Integrated Training adalah masterclass lengkap per tool atau peran, Thematic Training berfokus pada fundamental dan praktik, dan Product/Service adalah layanan implementasi sistem.</p>
  </div>
</section>