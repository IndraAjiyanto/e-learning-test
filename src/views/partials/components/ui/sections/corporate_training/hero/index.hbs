<section class="bg-[#F8F9FA] py-14 lg:py-16">
  <div class="page-shell flex flex-col gap-10">
    <div class="flex max-w-[900px] flex-col items-start gap-5">
      {{> components/ui/text/eyebrow/index text=(t 'test.corporateTraining.hero.badge') dotColor='#6EB6E5'}}
      <h1 class="max-w-[900px] text-3xl font-extrabold leading-tight tracking-tight text-[#0B1F3B] sm:text-4xl lg:text-[40px]">{{{t 'test.corporateTraining.hero.title'}}}</h1>
      <p class="max-w-[760px] text-base leading-relaxed text-[#4A5568]">{{t 'test.corporateTraining.hero.description'}}</p>
    </div>
    <div class="relative pb-16 lg:pb-20" x-data="{ activeSlide: 0, slides: ['/public/image/corporateTraining/workshop-people.jpg', '/public/image/corporateTraining/workshop-room.jpg', '/public/image/corporateTraining/workshop-online.png'] }" x-init="setInterval(() => activeSlide = (activeSlide + 1) % slides.length, 5000)">
      <div class="relative flex min-h-[560px] flex-wrap items-center gap-8 overflow-hidden rounded-[24px] bg-[#0B1F3B] p-7 pb-28 sm:p-10 sm:pb-32 lg:p-16 lg:pb-32">
        <template x-for="(slide, index) in slides" :key="slide">
          <div x-show="activeSlide === index" x-transition.opacity.duration.700ms class="absolute inset-0 bg-cover bg-center bg-no-repeat" :style="`background-size: cover; background-position: center center; background-repeat: no-repeat; background-image: linear-gradient(115deg, rgba(11,31,59,.88) 0%, rgba(38,70,115,.68) 55%, rgba(44,92,156,.48) 100%), url('${slide}')`" aria-hidden="true"></div>
        </template>
        <span class="pointer-events-none absolute -left-20 -top-20 size-[340px] rounded-full border border-white/[0.08] bg-white/[0.03]"></span>
        <span class="pointer-events-none absolute -bottom-28 -right-24 size-[420px] rounded-full border border-white/[0.08] bg-white/[0.03]"></span>
        <div class="relative flex min-w-0 max-w-[620px] flex-1 flex-col items-start gap-5">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-bold uppercase tracking-wide text-white"><i class="fas fa-briefcase text-[11px]"></i>{{t 'test.corporateTraining.hero.cardBadge'}}</span>
          <h2 class="text-3xl font-bold leading-tight text-white lg:text-[44px] lg:leading-[1.15]">{{t 'test.corporateTraining.hero.cardTitle'}}</h2>
          <p class="max-w-[520px] text-[15px] leading-relaxed text-white/90">{{t 'test.corporateTraining.hero.cardDescription'}}</p>
          <div class="flex flex-wrap gap-2"><span class="rounded-full border border-white/30 bg-white/10 px-3.5 py-1.5 text-sm font-semibold text-white"><i class="fas fa-desktop mr-2 text-xs"></i>{{t 'test.corporateTraining.hero.chipsOnline'}}</span><span class="rounded-full border border-white/30 bg-white/10 px-3.5 py-1.5 text-sm font-semibold text-white"><i class="fas fa-location-dot mr-2 text-xs"></i>{{t 'test.corporateTraining.hero.chipsOffline'}}</span></div>
          <div class="mt-1 flex flex-wrap gap-3"><a href="#program" class="inline-flex h-[52px] items-center justify-center rounded-full bg-white px-6 text-sm font-bold text-[#0B1F3B] shadow-lg transition hover:-translate-y-0.5">{{t 'test.corporateTraining.hero.cardCtaPrimary'}}</a><a href="{{#if social.length}}{{waLink social.[0].number}}{{else}}#{{/if}}" class="inline-flex h-[52px] items-center justify-center rounded-full border border-white/40 px-6 text-sm font-semibold text-white transition hover:bg-white/10">{{t 'test.corporateTraining.hero.cardCtaSecondary'}}</a></div>
        </div>
        <div class="relative flex min-w-0 max-w-[360px] flex-1 flex-col gap-3.5 rounded-[20px] border border-white/20 bg-white/10 p-6 text-white backdrop-blur-sm"><span class="text-xs font-bold uppercase tracking-[0.15em] text-[#93C5FD]">{{t 'test.corporateTraining.hero.catalogLabel'}}</span><strong class="text-[26px] leading-tight">{{t 'test.corporateTraining.hero.catalogTitle'}}</strong><div class="mt-1 divide-y divide-white/15 text-sm"><div class="flex justify-between py-2.5"><span>{{t 'test.corporateTraining.category.code'}}</span><b>6</b></div><div class="flex justify-between py-2.5"><span>{{t 'test.corporateTraining.category.design'}}</span><b>5</b></div><div class="flex justify-between py-2.5"><span>{{t 'test.corporateTraining.category.business'}}</span><b>6</b></div><div class="flex justify-between py-2.5"><span>{{t 'test.corporateTraining.category.impl'}}</span><b>1</b></div></div></div>
      </div>
      <div class="absolute inset-x-4 bottom-0 mx-auto grid max-w-[880px] gap-5 rounded-2xl border border-[#E5E7EB] bg-white p-6 shadow-[0_18px_44px_-12px_rgba(11,31,59,0.16)] sm:grid-cols-3 lg:inset-x-0 lg:p-8">
        <div class="flex items-center gap-4"><span class="grid size-14 shrink-0 place-items-center rounded-full bg-[#E8EDF5] text-[#334155]"><i class="fas fa-users"></i></span><div><b class="block text-2xl text-[#111827] lg:text-[28px]">{{t 'test.corporateTraining.hero.stat1Value'}}</b><span class="text-xs text-[#6B7280]">{{t 'test.corporateTraining.hero.stat1Label'}}</span></div></div>
        <div class="flex items-center gap-4 border-t border-[#E5E7EB] pt-5 sm:border-l sm:border-t-0 sm:pl-5 sm:pt-0"><span class="grid size-14 shrink-0 place-items-center rounded-full bg-[#E8EDF5] text-[#334155]"><i class="fas fa-briefcase"></i></span><div><b class="block text-2xl text-[#111827] lg:text-[28px]">{{t 'test.corporateTraining.hero.stat2Value'}}</b><span class="text-xs text-[#6B7280]">{{t 'test.corporateTraining.hero.stat2Label'}}</span></div></div>
        <div class="flex items-center gap-4 border-t border-[#E5E7EB] pt-5 sm:border-l sm:border-t-0 sm:pl-5 sm:pt-0"><span class="grid size-14 shrink-0 place-items-center rounded-full bg-[#E8EDF5] text-[#334155]"><i class="fas fa-arrow-trend-up"></i></span><div><b class="block text-2xl text-[#111827] lg:text-[28px]">{{t 'test.corporateTraining.hero.stat3Value'}}</b><span class="text-xs text-[#6B7280]">{{t 'test.corporateTraining.hero.stat3Label'}}</span></div></div>
      </div>
    </div>
  </div>
</section>