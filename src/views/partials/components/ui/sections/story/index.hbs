<!-- Story Section Container -->
<div x-transition:enter='transition ease-out duration-300' x-transition:enter-start='opacity-0 transform translate-y-4'
  x-transition:enter-end='opacity-100 transform translate-y-0'
  x-data="{ videoUrl: '{{#if social.length}}{{social.[0].videoYoutube}}{{else}}https://youtu.be/Ft3UMrgTDpc?si=SkBf4VNA-qL5PG4S{{/if}}' }">

  <!-- MOBILE STORY TAB (< 640px) -->
  <div class="block sm:hidden w-full relative font-montserrat overflow-hidden">
    <!-- Header Title & Subtitle -->
    <div class="mb-4">
      <h1 class="font-montserrat font-bold text-[28px] leading-[34px] text-[#0B1F3B]">
        Kesatria Academy
      </h1>
      <p class="font-montserrat font-semibold text-[18px] leading-[24px] text-[#6EB6E5] mt-1">
        Empowering Future Digital Tech Talents
      </p>
    </div>

    <!-- Story Paragraphs Mobile -->
    <div class="space-y-4 font-sans font-normal text-[14px] leading-[24px] text-[#000000CC] text-left">
      {{#if paragraphs.length}}
        {{#each paragraphs}}
          <p>{{getByLang this.paragraphs ../lang}}</p>
        {{/each}}
      {{else}}
        <p>
          Kesatria Academy is an educational services institution focused on developing superior digital talent in the information technology sector. Our programs are designed to address real and evolving industry needs, ensuring that every learner is prepared to contribute meaningfully to the ongoing digital transformation happening across various sectors.
        </p>
        <p>
          At Kesatria Academy, we believe that technology education is not solely about theoretical understanding. It is a transformative journey that builds practical capabilities, problem-solving skills, and a strong professional work ethic.
        </p>
      {{/if}}
    </div>

    <!-- YouTube Video / Real Moments Card Mobile -->
    <div class="my-6">
      <div class="aspect-video bg-slate-900 rounded-xl overflow-hidden shadow-md border border-gray-200 w-full relative">
        <iframe 
          width="100%" 
          height="100%" 
          x-bind:src="videoUrl.includes('youtube.com/watch?v=') 
            ? videoUrl.replace('watch?v=', 'embed/') 
            : videoUrl.includes('youtu.be/') 
              ? videoUrl.replace('youtu.be/', 'youtube.com/embed/') 
              : videoUrl" 
          title="Kesatria Academy Introduction" 
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          class="w-full h-full"
        ></iframe>
      </div>
      <p class="font-montserrat font-medium italic text-[12px] leading-[16px] text-[#000000CC] mt-2.5">
        * Real moments from classrooms and professional mentoring.
      </p>
    </div>

    <!-- Our Commitment Section Mobile -->
    <div class="mt-8">
      {{#> components/ui/text/section_header/index
          align="text-left"
          wrapperClass="mb-6"
          showDivider=true
          dividerClass="w-12 h-[3px] bg-[#6EB6E5] mb-0"
      }}
        {{#*inline "titleBlock"}}
          <span class="font-montserrat font-medium text-[12px] leading-[16px] uppercase tracking-wider block mb-1 text-[#6EB6E5]">
            CORE VALUES
          </span>
          <h2 class="font-montserrat font-bold text-[28px] leading-[34px] text-[#003060] mb-2">
            {{t "test.about.ourStory.commitment"}}
          </h2>
        {{/inline}}
      {{/components/ui/button/section_header}}

      <!-- Mobile Commitment Cards List -->
      <div class="space-y-4">
        {{#each commitment}}
          {{> components/ui/card/card_value/index 
              bgClass="bg-[#E0F1F9]/65"
              iconBgClass="bg-[#EFF4FE] rounded-full"
              iconBase="/public/image/about/story/"
              iconName=this.icon
              fallbackIcon="/public/image/about/story/inclusive.svg"
              title=(getByLang title ../lang)
              description=(getByLang description ../lang)
          }}
        {{else}}
          <!-- Card 1 -->
          {{> components/ui/card/card_value/index 
              bgClass="bg-[#E0F1F9]/65"
              iconBgClass="bg-[#EFF4FE] rounded-full"
              icon="/public/image/about/story/inclusive.svg"
              title="Inclusive & Accessible Education"
              description="Providing equal opportunities for all learners through flexible and accessible learning experiences."
          }}

          <!-- Card 2 -->
          {{> components/ui/card/card_value/index 
              bgClass="bg-[#E0F1F9]/65"
              iconBgClass="bg-[#EFF4FE] rounded-full"
              icon="/public/image/about/story/industry.svg"
              title="Industry-Aligned Curriculum"
              description="Bridging the gap between education and employment with a curriculum tailored to the latest industry standards."
          }}

          <!-- Card 3 -->
          {{> components/ui/card/card_value/index 
              bgClass="bg-[#E0F1F9]/65"
              iconBgClass="bg-[#EFF4FE] rounded-full"
              icon="/public/image/about/story/lifelong.svg"
              title="Lifelong Learning Ecosystem"
              description="Fostering a culture of continuous learning to adapt to the fast-changing tech landscape."
          }}

          <!-- Card 4 -->

          <!-- Card 5 -->
          <div class="bg-[#E0F1F9]/65 backdrop-blur-[6.6px] rounded-[16px] p-6 shadow-[0px_4px_8px_0px_#00000015] border border-[#E0F1F9]">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-[#EFF4FE] flex items-center justify-center shadow-sm shrink-0">
                <img src="/public/image/about/story/empowering.svg" alt="Empowering Community" class="w-6 h-6 object-contain" />
              </div>
              <h4 class="font-montserrat font-semibold text-[18px] leading-[24px] text-[#0B1F3B]">
                Empowering Community
              </h4>
            </div>
            <p class="font-sans font-normal text-[14px] leading-[24px] text-[#000000CC]">
              Fostering collaborative learning networks and supportive ecosystems that grow together.
            </p>
          </div>

          <!-- Card 6 -->
          <div class="bg-[#E0F1F9]/65 backdrop-blur-[6.6px] rounded-[16px] p-6 shadow-[0px_4px_8px_0px_#00000015] border border-[#E0F1F9]">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-[#EFF4FE] flex items-center justify-center shadow-sm shrink-0">
                <img src="/public/image/about/story/excellence.svg" alt="Excellence in Learning" class="w-6 h-6 object-contain" />
              </div>
              <h4 class="font-montserrat font-semibold text-[18px] leading-[24px] text-[#0B1F3B]">
                Excellence in Learning
              </h4>
            </div>
            <p class="font-sans font-normal text-[14px] leading-[24px] text-[#000000CC]">
              Empowering learners with high-quality, industry-driven education that shapes future-ready professionals.
            </p>
          </div>
        {{/each}}
      </div>
    </div>
  </div>

  <!-- DESKTOP STORY TAB (>= 640px) -->
  <div class="hidden sm:block">
    <!-- Header Title & Subtitle -->
    <div class='mb-6 sm:mb-8'>
      <h1 class='text-xl sm:text-2xl md:text-4xl font-semibold text-[#003060] mb-2 font-montserrat'>
        {{t "test.about.ourStory.title"}}
      </h1>
      <h2 class='text-lg sm:text-xl md:text-2xl font-normal text-[#003060] mb-6 font-montserrat'>
        {{t "test.about.ourStory.description"}}
      </h2>
    </div>

    <!-- Story Paragraphs -->
    <div class='space-y-4 sm:space-y-6 text-[#000000] text-base md:text-2xl leading-normal md:leading-[45px] font-sans font-normal text-justify'>
      {{#if paragraphs.length}}
        {{#each paragraphs}}
          <p>{{getByLang this.paragraphs ../lang}}</p>
        {{/each}}
      {{else}}
        <p>
          Kesatria Academy is an educational services institution focused on developing superior digital talent in the information technology sector. Our programs are designed to address real and evolving industry needs, ensuring that every learner is prepared to contribute meaningfully to the ongoing digital transformation happening across various sectors.
        </p>
        <p>
          At Kesatria Academy, we believe that technology education is not solely about theoretical understanding. It is a transformative journey that builds practical capabilities, problem-solving skills, and a strong professional work ethic. Through hands-on learning, real-world projects, and personalized mentoring from industry experts, we prepare participants to become highly competitive and job-ready professionals.
        </p>
        <p>
          We emphasize measurable outcomes and the creation of a globally recognized portfolio as a key indicator of success. With a curriculum aligned to industry standards and a learning environment that encourages collaboration, innovation, and continuous improvement, Kesatria Academy strives to empower future digital talents to excel in both local and international levels.
        </p>
      {{/if}}
    </div>

    <!-- Company Profile YouTube Video Player Card -->
    <div class='mt-10 mb-12 w-full'>
      <div class='w-full'>
        <div class='aspect-video bg-slate-900 rounded-2xl overflow-hidden shadow-xl border border-gray-200 relative w-full'>
          <iframe 
            width='100%' 
            height='100%' 
            x-bind:src="videoUrl.includes('youtube.com/watch?v=') 
              ? videoUrl.replace('watch?v=', 'embed/') 
              : videoUrl.includes('youtu.be/') 
                ? videoUrl.replace('youtu.be/', 'youtube.com/embed/') 
                : videoUrl" 
            title='Kesatria Academy Introduction' 
            frameborder='0'
            allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
            allowfullscreen
            class="w-full h-full"
          ></iframe>
        </div>
      </div>
    </div>

    <!-- Our Commitment Grid -->
    <div class='mt-10'>
      <h3 class='font-montserrat font-semibold text-[#003060] text-2xl md:text-[36px] leading-[100%] tracking-normal text-left mb-8'>
        {{t "test.about.ourStory.commitment"}}
      </h3>
      
      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 justify-items-center md:justify-items-start'>
        {{#each commitment}}
          {{> components/ui/card/card_value/index 
              desktopAlign="center"
              wrapperClass="max-w-[349px] lg:min-h-[362px]"
              bgClass="bg-[#E0F1F9]/65"
              iconBgClass="bg-[#EFF4FE] text-white"
              iconBase="/public/image/about/story/"
              iconName=this.icon
              fallbackIcon="/public/image/about/story/inclusive.svg"
              title=(getByLang title ../lang)
              description=(getByLang description ../lang)
              showDivider=true
          }}
        {{else}}
          <!-- Card 1 -->
          {{> components/ui/card/card_value/index 
              desktopAlign="center"
              wrapperClass="max-w-[349px] lg:min-h-[362px]"
              bgClass="bg-[#E0F1F9]/65"
              iconBgClass="bg-[#EFF4FE] text-white"
              icon="/public/image/about/story/inclusive.svg"
              title="Inclusive & Accessible Education"
              description="Providing equal opportunities for all learners through flexible and accessible learning experiences."
              showDivider=true
          }}

          <!-- Card 2 -->
          {{> components/ui/card/card_value/index 
              desktopAlign="center"
              wrapperClass="max-w-[349px] lg:min-h-[362px]"
              bgClass="bg-[#E0F1F9]/65"
              iconBgClass="bg-[#EFF4FE] text-white"
              icon="/public/image/about/story/career.svg"
              title="Career Growth & Professional Mentoring"
              description="Supporting learners through mentoring, portfolio building, certifications, and career placement pathways."
              showDivider=true
          }}

          <!-- Card 3 -->
          {{> components/ui/card/card_value/index 
              desktopAlign="center"
              wrapperClass="max-w-[349px] lg:min-h-[362px]"
              bgClass="bg-[#E0F1F9]/65"
              iconBgClass="bg-[#EFF4FE] text-white"
              icon="/public/image/about/story/real-world.svg"
              title="Real-World Industry Experience"
              description="Offering hands-on project, case studies, and collaboration with experts to bridge theory and practice."
              showDivider=true
          }}

          <!-- Card 4 -->
          {{> components/ui/card/card_value/index 
              desktopAlign="center"
              wrapperClass="max-w-[349px] lg:min-h-[362px]"
              bgClass="bg-[#E0F1F9]/65"
              iconBgClass="bg-[#EFF4FE] text-white"
              icon="/public/image/about/story/innovative.svg"
              title="Innovative Technology Adoption"
              description="Continuously integrating modern tech stacks, AI tools, and interactive platforms into learning."
              showDivider=true
          }}

          <!-- Card 5 -->
          {{> components/ui/card/card_value/index 
              desktopAlign="center"
              wrapperClass="max-w-[349px] lg:min-h-[362px]"
              bgClass="bg-[#E0F1F9]/65"
              iconBgClass="bg-[#EFF4FE] text-white"
              icon="/public/image/about/story/excellence.svg"
              title="Excellence & Industry Relevance"
              description="Ensuring all curriculum content meets current market standards and expectations of global companies."
              showDivider=true
          }}

          <!-- Card 6 -->
          {{> components/ui/card/card_value/index 
              desktopAlign="center"
              wrapperClass="max-w-[349px] lg:min-h-[362px]"
              bgClass="bg-[#E0F1F9]/65"
              iconBgClass="bg-[#EFF4FE] text-white"
              icon="/public/image/about/story/empowering.svg"
              title="Empowering Digital Talent"
              description="Developing highly skilled individuals who are ready to make a significant impact in the tech ecosystem."
              showDivider=true
          }}
        {{/each}}
      </div>
    </div>
  </div>

</div>