<!-- WHAT YOU'LL GET SECTION -->
<!-- Menambahkan id="what-you-get" untuk fitur navigasi scroll otomatis -->
<section id="what-you-get" class="w-full bg-[#fafafa] py-20 font-montserrat">
  
  <div class="max-w-[1537px] mx-auto px-8 lg:px-16 flex flex-col items-center">
    
    <!-- 1. Badge Judul (Tengah) -->
    {{> components/ui/text/section_header/index
      badge=(default badgeTitle (t 'test.freeProgram.badge.benefit'))
      badgeClass="px-14 py-2.5 mb-14 font-medium text-base"
    }}

    <!-- 2. Grid Kartu (Dibuat 2 Kolom) -->
    <!-- Dibatasi max-w-[800px] agar 4 kartu mengelompok rapi di tengah -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8 w-full max-w-[800px]">
      
      {{#each course.programBenefits}}
      <div class="bg-white border border-gray-200 rounded-[12px] py-12 px-8 flex flex-col items-center justify-center text-center hover:shadow-md transition-shadow">
        <div class="text-black mb-6 flex items-center justify-center h-[50px]">
          <i class="fas {{this.icon}} text-[42px]"></i>
        </div>
        <p class="text-black font-semibold text-[17px]">
          {{getByLang this.benefit ../lang}}
        </p>
        <p class="text-black font-normal text-[14px] mt-2">
          {{getByLang this.description ../lang}}
        </p>
      </div>
      {{/each}}
    </div>

  </div>
</section>