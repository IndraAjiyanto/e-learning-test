{{!--
  Section: Partner / "Trusted by Leading Partners" (L2)
  Lokasi: src/views/partials/components/ui/sections/partner/index.hbs
  Satu pohon markup, base + lg. Data: categoryPartner[] (filter), partners[] ({ image, categoryPartner.category }).
  Hanya dipakai dashboard.hbs.
--}}
<script>
  window.__partners = [
    {{#each partners}}
    {
      id: {{{json this.id}}},
      image: {{{json this.image}}},
      category: {{{json this.categoryPartner.category}}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ];
</script>

<section class="relative w-full overflow-hidden bg-white py-16 font-inter lg:py-24">
  <div class="page-shell flex flex-col items-center">

    <div class="flex flex-col items-center gap-4 text-center">
      {{> components/ui/text/eyebrow/index text=(t 'test.home.partnerSection.ourPartners') }}
      <h2 class="font-inter text-2xl sm:text-3xl lg:text-[36px] font-bold lg:leading-[44px] text-[#0B1F3B] text-center">{{t 'test.home.partnerSection.title'}}</h2>
      <p class="max-w-[592px] font-inter text-base lg:text-[20px] font-normal leading-[160%] text-[#4A5568] text-center">{{t 'test.home.partnerSection.description'}}</p>
      <div class="h-1 w-[60px] rounded-[2px] bg-[#003060]"></div>
    </div>

    <div class="mt-10 w-full lg:mt-14" x-data="partnerGrid(window.__partners || [], '{{default categoryPartner.[0].category 'Institutions'}}')">
      <div class="flex flex-wrap items-center justify-center gap-3 lg:gap-5">
        {{#each categoryPartner}}
          {{> components/ui/button/tab_filter/index
              text=this.category
              targetValue=this.category
              activeClass="bg-[#003060] text-white"
              inactiveClass="bg-transparent text-[#003060] hover:bg-[#003060]/5"
              buttonClass="border-2 border-[#003060] rounded-full whitespace-nowrap text-sm lg:text-base px-5 py-2.5 lg:px-7 lg:py-3"
              onClick=(concat "setTab('" this.category "')") }}
        {{/each}}
      </div>

<div class="relative z-10 flex w-full flex-col">
  <div class="mx-auto mt-8 grid w-fit max-w-full grid-cols-2 justify-center gap-3 sm:grid-cols-3 md:grid-cols-4 lg:mt-10 lg:grid-cols-6 lg:gap-3">
    <template x-for="partner in visiblePartners" :key="partner.id">
      <div
        class="flex h-[60px] w-[180px] items-center justify-center overflow-hidden rounded-md px-3 bg-white/50 shadow-[0_0_3px_0_rgba(0,0,0,0.3)] backdrop-blur-[3px] transition-transform hover:scale-[1.03]"
      >
        <img :src="partner.image" alt="Partner Logo" class="max-h-[42px] max-w-full object-contain scale-125" />
      </div>
    </template>
    <div x-show="visiblePartners.length === 0" class="flex h-[60px] w-[180px] items-center justify-center rounded-md px-3 bg-white/50 shadow-[0_0_3px_0_rgba(0,0,0,0.3)] backdrop-blur-[3px]">
      <img src="/public/image/logo.png" alt="Partner Logo" class="max-h-[42px] max-w-full object-contain scale-125" />
    </div>
  </div>

  <div class="mt-10 flex justify-center lg:mt-14" x-show="hasMore">
    <button
      @click="loadMore()"
      type="button"
      class="rounded-full border-2 border-[#003060] bg-[#003060] px-8 py-3 font-inter text-sm font-medium text-white transition-colors hover:bg-[#003060]/90 lg:text-base"
    >
      {{t 'test.home.partnerSection.loadMore'}}
    </button>
  </div>

  <div class="mt-10 flex justify-center lg:mt-14" x-show="canCollapse">
    <button
      @click="showLess()"
      type="button"
      class="rounded-full border-2 border-[#003060] bg-transparent px-8 py-3 font-inter text-sm font-medium text-[#003060] transition-colors hover:bg-[#003060]/5 lg:text-base"
    >
      {{t 'test.home.partnerSection.showLess'}}
    </button>
  </div>
</div>
    </div>
  </div>
</section>
