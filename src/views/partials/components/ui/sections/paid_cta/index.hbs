{{!--
  Section: Paid CTA - learning path (L2) - reskin ke standar internal.
  Lokasi: src/views/partials/components/ui/sections/paid_cta/index.hbs
  Props: category (.contact), lang.
--}}
<section id="explore-program" class="w-full bg-white py-14 font-montserrat lg:py-20">
  <div class="page-shell">
    <div class="flex flex-col items-center gap-6 rounded-3xl bg-[#003060] px-6 py-14 text-center lg:gap-8 lg:px-10 lg:py-16">
      <span class="grid size-16 shrink-0 place-items-center rounded-full bg-white/10 text-white">
        <i class="fas fa-users text-xl"></i>
      </span>
      <div class="flex max-w-[720px] flex-col items-center gap-3">
        <h2 class="{{sizeClass 'h2'}} font-montserrat font-extrabold tracking-[-0.01em] text-white">{{t 'test.categoryPaidProgram.cta.title'}}</h2>
        <p class="{{sizeClass 'lead'}} font-open-sans text-white/80">{{t 'test.categoryPaidProgram.cta.description'}}</p>
      </div>
      <a
        href="#programs"
        class="inline-flex items-center gap-2.5 rounded-xl bg-white px-8 py-4 {{sizeClass 'body'}} font-bold text-[#003060] transition hover:-translate-y-0.5 hover:bg-[#E0F2F9]"
      >
        <i class="fas fa-arrow-up text-xs"></i>{{t 'test.categoryPaidProgram.cta.button'}}
      </a>
    </div>
  </div>
</section>
