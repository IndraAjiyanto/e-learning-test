{{!--
  Section: Final CTA - Paid Program (L2)
  Lokasi: src/views/partials/components/ui/sections/paid_cta/index.hbs
  Figma node: 1158:4810 (final-cta)
  Props: category (.contact), lang.
--}}
<section id="explore-program" class="w-full bg-[#F8F9FA] px-6 py-16 sm:px-10 sm:py-20 lg:px-20 lg:py-20">
  <div class="mx-auto flex w-full max-w-[1568px] flex-col items-center justify-center gap-10 text-center">

    {{!-- cta-text (1158:4811) --}}
    {{> components/ui/text/section_header/index
        title=(t 'test.categoryPaidProgram.cta.title')
        titleClass="font-inter text-2xl font-bold leading-tight text-[#003060] sm:text-3xl lg:text-[36px] lg:leading-[44px]"
        description=(t 'test.categoryPaidProgram.cta.description')
        descClass="max-w-[658px] font-inter text-sm font-normal leading-relaxed text-[#003060] sm:text-base lg:text-[20px] lg:leading-[160%]"
        wrapperClass="gap-4 max-w-[1568px]"
    }}

    {{!-- cta-btn (1158:4814) --}}
    <a
      href="{{#if category.contact}}{{waLink category.contact}}{{else}}#programs{{/if}}"
      {{#if category.contact}}target="_blank" rel="noopener"{{/if}}
      class="inline-flex items-center justify-center gap-2.5 rounded-[12px] bg-[#003060] px-9 py-[18px] text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#002244] hover:shadow-md active:translate-y-0"
    >
      <span class="font-montserrat text-base font-bold leading-5 text-white">
        {{t 'test.categoryPaidProgram.cta.button'}}
      </span>
      <i class="fas fa-arrow-up text-xs text-white" aria-hidden="true"></i>
    </a>

  </div>
</section>

