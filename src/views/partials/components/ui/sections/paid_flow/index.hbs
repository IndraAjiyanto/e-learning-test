{{!--
  Section: Paid Flow - capstone / portfolio showcase (L2) - reskin ke standar internal.
  Lokasi: src/views/partials/components/ui/sections/paid_flow/index.hbs
  Props: portfolio[] (.image[], .title, .course.category.name, .course.name).
--}}
<section id="flow" class="w-full bg-[#F8F9FA] py-14 font-montserrat lg:py-20">
  <div class="page-shell flex flex-col items-center gap-12 lg:gap-16">

    <div class="flex max-w-[640px] flex-col items-center gap-4 text-center">
      {{> components/ui/text/eyebrow/index text=(t 'test.categoryPaidProgram.flow.eyebrow') }}
      <h2 class="{{sizeClass 'h2'}} font-montserrat font-bold text-[#0B1F3B]">{{t 'test.categoryPaidProgram.flow.title'}}</h2>
      <p class="{{sizeClass 'lead'}} font-open-sans text-[#4A5568]">{{t 'test.categoryPaidProgram.flow.description'}}</p>
    </div>

    {{#if portfolio}}
      <div class="flex w-full flex-wrap justify-center gap-6 [&>*]:w-full [&>*]:sm:w-[calc((100%-1.5rem)/2)] [&>*]:lg:w-[calc((100%-3rem)/3)]">
        {{#each portfolio}}
          <article class="flex flex-col overflow-hidden rounded-2xl border border-[#E5E7EB] bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-[0px_12px_28px_rgba(11,31,59,0.10)]">
            <div class="aspect-[4/3] w-full overflow-hidden bg-[#E0F2F9]">
              {{#if image.[0]}}
                <img src="{{image.[0]}}" alt="{{title}}" onerror="this.style.display='none'" class="size-full object-cover" />
              {{else}}
                <div class="grid size-full place-items-center text-[#94A3B8]"><i class="fas fa-image text-3xl"></i></div>
              {{/if}}
            </div>
            <div class="flex flex-1 flex-col items-start gap-3 p-6">
              <h3 class="{{sizeClass 'h3'}} font-montserrat font-semibold text-[#0B1F3B]">{{title}}</h3>
              {{#if course}}
                <span class="inline-flex rounded-lg bg-[#E0F2F9] px-3 py-1.5 {{sizeClass 'body-sm'}} font-open-sans font-medium text-[#003060]">
                  {{course.category.name}}: {{course.name}}
                </span>
              {{/if}}
            </div>
          </article>
        {{/each}}
      </div>
    {{/if}}
  </div>
</section>
