{{!--
  Section: Paid Program — "Short Classes for You" (L2)
  Lokasi: src/views/partials/components/ui/sections/paid_program/index.hbs

  Desain baru sesuai Figma: header "Short Classes for You" + 3 program cards.
  Props: courses[] (backend data untuk image & id), lang.

  Menggunakan komponen yang sudah ada:
  - components/ui/text/section_header/index -> untuk section header
  - components/ui/card/category/paid/index   -> untuk card program (L1)

  Catatan:
  - Judul section, subtitle, card titles, descriptions, tags, dan icons di-hardcode
    sesuai instruksi (tidak ada perintah menggunakan data backend untuk konten ini).
  - Data backend (courses[]) digunakan untuk image dan link id jika tersedia.
--}}
<section id="programs" class="w-full bg-white py-16 sm:py-20 lg:py-24 font-inter">
  <div class="page-shell flex flex-col items-center gap-12 lg:gap-16">

    {{!-- section-header --}}
    {{> components/ui/text/section_header/index
        title=(t 'test.categoryPaidProgram.program.title')
        titleSize="h2"
        titleClass="font-inter font-bold text-3xl sm:text-4xl lg:text-[40px] lg:leading-[48px] text-[#6EB6E5] mb-3 text-center"
        description=(t 'test.categoryPaidProgram.program.description')
        descSize="lead"
        descClass="font-inter font-normal text-base sm:text-lg text-[#6B7280] leading-relaxed max-w-[720px] text-center"
        wrapperClass="max-w-[760px] items-center text-center"
    }}

    {{!-- program-cards grid --}}
    <div class="grid w-full grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch justify-items-center">

      {{!-- Card 1: Japan Program (graduation-cap) --}}
      {{#with (lookup courses 0)}}
        {{> components/ui/card/category/paid/index
            id=this.id
            group=this.group
            image=this.image
            defaultImage="https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=800&auto=format&fit=crop"
            name=(default this.name (default ../category.name "Japan Program"))
            description="A structured journey from language fundamentals to workplace readiness and long-term career opportunities."
            icon="fa-graduation-cap"
            tags=(array "Language" "Culture" "Career")
        }}
      {{else}}
        {{> components/ui/card/category/paid/index
            id="#"
            image=""
            defaultImage="https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=800&auto=format&fit=crop"
            name=(default category.name "Japan Program")
            description="A structured journey from language fundamentals to workplace readiness and long-term career opportunities."
            icon="fa-graduation-cap"
            tags=(array "Language" "Culture" "Career")
        }}
      {{/with}}

      {{!-- Card 2: Japan Program (eye) --}}
      {{#with (lookup courses 1)}}
        {{> components/ui/card/category/paid/index
            id=this.id
            image=this.image
            defaultImage="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=800&auto=format&fit=crop"
            name=(default this.name (default ../category.name "Japan Program"))
            description="Build strong communication skills through structured lessons and interactive practice."
            icon="fa-eye"
            tags=(array "Speaking" "Listening" "Reading" "Writing")
        }}
      {{else}}
        {{> components/ui/card/category/paid/index
            id="#"
            image=""
            defaultImage="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=800&auto=format&fit=crop"
            name=(default category.name "Japan Program")
            description="Build strong communication skills through structured lessons and interactive practice."
            icon="fa-eye"
            tags=(array "Speaking" "Listening" "Reading" "Writing")
        }}
      {{/with}}

      {{!-- Card 3: Career & Study Support (users) --}}
      {{#with (lookup courses 2)}}
        {{> components/ui/card/category/paid/index
            id=this.id
            image=this.image
            defaultImage="https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=800&auto=format&fit=crop"
            name=(default this.name "Career & Study Support")
            description="Receive support for applications, interviews, and planning your path in Japan."
            icon="fa-users"
            tags=(array "Applications" "Interviews" "Planning")
        }}
      {{else}}
        {{> components/ui/card/category/paid/index
            id="#"
            image=""
            defaultImage="https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=800&auto=format&fit=crop"
            name="Career & Study Support"
            description="Receive support for applications, interviews, and planning your path in Japan."
            icon="fa-users"
            tags=(array "Applications" "Interviews" "Planning")
        }}
      {{/with}}

    </div>

  </div>
</section>
