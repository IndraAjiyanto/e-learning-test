{{!--
  Section: Paid Program - course list (L2) - reskin ke standar internal.
  Lokasi: src/views/partials/components/ui/sections/paid_program/index.hbs
  Props: courses[], lang.
--}}
<section id="programs" class="w-full bg-white py-14 font-montserrat lg:py-20">
  <div class="page-shell flex flex-col items-center gap-12 lg:gap-16">

    <div class="flex max-w-[640px] flex-col items-center gap-4 text-center">
      {{> components/ui/text/eyebrow/index text=(t 'test.categoryPaidProgram.program.eyebrow') }}
      <h2 class="{{sizeClass 'h2'}} font-montserrat font-bold text-[#0B1F3B]">{{t 'test.categoryPaidProgram.program.title'}}</h2>
      <p class="{{sizeClass 'lead'}} font-open-sans text-[#4A5568]">{{t 'test.categoryPaidProgram.program.description'}}</p>
    </div>

    <div class="flex w-full flex-wrap justify-center gap-6 [&>*]:w-full [&>*]:sm:w-[calc((100%-1.5rem)/2)] [&>*]:lg:w-[calc((100%-3rem)/3)]">
      {{#each courses}}
        {{> components/ui/card/category/paid/index
            id=this.id
            image=this.image
            name=this.name
            description=(getByLang this.description ../lang)
            method=this.method
            month=this.month
            quota=this.quota }}
      {{/each}}
    </div>
  </div>
</section>
