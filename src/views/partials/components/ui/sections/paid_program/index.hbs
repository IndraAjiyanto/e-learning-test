<!-- PROGRAM SECTION (CHOOSE YOUR LEARNING PATH) -->
<section id="programs" class="w-full bg-[#FAFAFA] font-montserrat py-12 sm:py-20">
  <div class="container mx-auto px-5 sm:px-6 lg:px-12 max-w-[1440px]">
    
    <!-- Section Header -->
    {{> components/ui/text/section_header/index
        wrapperClass="mb-8 sm:mb-12"
        title=(t 'test.categoryPaidProgram.program.title')
        titleClass="font-montserrat font-bold sm:font-semibold text-2xl sm:text-3xl lg:text-4xl text-center mb-2 sm:mb-5"
        description=(t 'test.categoryPaidProgram.program.description')
        descClass="font-sans font-normal text-sm sm:text-base lg:text-lg text-black/80 text-center max-w-[340px] sm:max-w-2xl mx-auto"
    }}

    <!-- Course Cards Grid -->
    <div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 justify-items-center">
      {{#each courses}}
        {{> components/ui/card/category/paid/index
            id=this.id
            image=this.image
            name=this.name
            description=(getByLang this.description ../lang)
            method=this.method
            month=this.month
            quota=this.quota
        }}
      {{/each}}
    </div>

  </div>
</section>

