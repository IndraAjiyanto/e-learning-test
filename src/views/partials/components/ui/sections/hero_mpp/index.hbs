<section class="w-full bg-[url('/public/image/mpp/background.png')] bg-cover bg-center overflow-hidden">
  <div class="container mx-auto px-6 lg:px-12 max-w-[1728px]">
    <div class="flex flex-col-reverse lg:flex-row lg:items-stretch gap-10 lg:gap-16 pt-24 lg:pt-32 pb-8 lg:pb-16">
      <div class="w-full lg:w-1/2 flex gap-4 h-[calc(100vh-120px)] overflow-hidden">
        <style>
          @keyframes scrollUp { from { transform: translateY(0); } to { transform: translateY(-50%); } }
          @keyframes scrollDown { from { transform: translateY(-50%); } to { transform: translateY(0); } }
          .animate-scroll-up { animation: scrollUp 18s linear infinite; will-change: transform; }
          .animate-scroll-down { animation: scrollDown 18s linear infinite; will-change: transform; }
        </style>

        <div class="flex flex-col gap-4 animate-scroll-up">
          {{#each (array
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
          )}}
            {{> components/ui/card/mpp_scroll_galeri/index image=this}}
          {{/each}}
          {{#each (array
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
          )}}
            {{> components/ui/card/mpp_scroll_galeri/index image=this}}
          {{/each}}
        </div>

        <div class="flex flex-col gap-4 animate-scroll-down">
          {{#each (array
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
          )}}
            {{> components/ui/card/mpp_scroll_galeri/index image=this}}
          {{/each}}
          {{#each (array
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
            "/public/image/mpp/hero_section.png"
          )}}
            {{> components/ui/card/mpp_scroll_galeri/index image=this}}
          {{/each}}
        </div>
      </div>

      <div class="w-full lg:w-1/2 flex flex-col justify-center items-start">
        {{> components/ui/text/section_header/index
            align="text-left"
            wrapperClass="space-y-4 lg:space-y-6"
            titleTag="h1"
            title="Marketing Partner <br class='hidden lg:block'> Program"
            titleClass="text-3xl md:text-4xl lg:text-[60px] font-bold font-montserrat text-white leading-tight lg:leading-none tracking-normal"
            description="Program Kemitraan Pemasaran IT Bootcamp untuk Mahasiswa & Fresh Graduate By Kesatria Academy"
            descClass="text-base lg:text-[25px] font-normal tracking-normal text-white leading-relaxed lg:leading-[40px] text-justify font-sans xl:pr-10"
        }}
        <div class="mt-4">
          {{> components/ui/button/btn_action/index
              variant="white"
              text="Daftar Sekarang"
              textClass="text-[25px]"
              class="w-full lg:w-[370px] h-16 lg:h-[85px] rounded-xl"
              onClick="document.getElementById('programs').scrollIntoView({ behavior: 'smooth', block: 'start' })"
          }}
        </div>
      </div>
    </div>
  </div>
</section>
