{{!--
  Section: Special Program - course list (L2)
  Lokasi: src/views/partials/components/ui/sections/special_program/index.hbs
  Props: category (.name), courses[], lang, isJapan.
--}}
<section id="programs" class="{{default sectionClass 'w-full bg-gradient-to-b from-[#FAFAFA] via-white to-[#FAFAFA] py-14 font-inter lg:py-20'}}">
  <div class="page-shell flex flex-col items-center gap-12 lg:gap-16">


    {{> components/ui/sections/program_section_header/index category=category lang=lang}}


    {{#if courses.length}}
      {{#> components/ui/filter/course_catalog_filter/index courses=courses lang=lang showPayment=true isJapan=isJapan}}
        <div
          x-show="visibleIds.length > 0"
          class="grid w-full grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 items-stretch justify-items-center max-w-[1568px]"
        >
          {{#each courses}}
            <div
              x-show="visibleIds.includes('{{this.id}}')"
              x-transition.opacity.duration.200ms
              class="w-full flex"
            >
              {{> components/ui/card/program_showcase/index
                  id=this.id
                  image=this.image
                  icon=(default this.icon "fa-solid fa-graduation-cap")
                  title=this.name
                  description=(default (getByLang this.description ../lang) (default (t 'test.special_program.program.defaultCardDesc') "A structured journey from fundamentals to workplace readiness and long-term career opportunities."))
                  tag1=(ternary this.method this.method (ternary ../isJapan (default (t 'test.special_program.program.language') "Language") (default (t 'test.special_program.program.practical') "Practical")))
                  tag2=(ternary (or (eq this.checkPaid false) this.day) (concat (default this.day 1) " " (default (t 'test.special_program.program.day') "Day")) (concat (default this.month 1) " " (default (t 'test.special_program.program.month') "Month")))
                  tag3=(ternary this.quota (concat this.quota " " (default (t 'test.special_program.program.quota') "Quota")) (default (t 'test.special_program.program.career') "Career"))
                  href=(concat '/program/' this.id)
                  lang=../lang
              }}
            </div>
          {{/each}}
        </div>
      {{/components/ui/filter/course_catalog_filter/index}}
    {{else}}

      {{> components/ui/sections/program_coming_soon/index
          title=(default (t 'test.special_program.program.comingSoonTitle') "Coming Soon")
          text=(default (t 'test.special_program.program.comingSoonText') "We're preparing something great for this category. Check back soon or reach out for details.")
      }}
    {{/if}}

  </div>
</section>
