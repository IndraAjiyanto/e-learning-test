{{!--
  Section: Japan Program Hero (Special Program)
  Lokasi: src/views/partials/components/ui/sections/japan_hero/index.hbs

  Slicing lengkap Hero Section untuk Japan Program (Special Program) sesuai spesifikasi Figma:
  - hero-bg-wash: Linear gradient pink sakura ke biru langit (rgba(252, 231, 243, 0.22) -> rgba(224, 242, 254, 0.22))
  - Tag / Eyebrow: "PREMIUM STUDY ABROAD" dengan accent dot #6EB6E5
  - Headline: Montserrat 800, 52px, -1px letter-spacing, #0B1F3B
  - Subheading: Inter 400, 16px, line-height 165%, #4B5563
  - CTA Primary: View Program (dark navy #0B1F3B, pill, arrow icon)
  - CTA Secondary: Watch overview (white border, pill, play icon, interactive modal video)
  - Line divider: 1px solid #E5E7EB
  - Meta Chips: "N5 readiness curriculum" dan "Career & study support"
  - Visual Collage: 520x520 rounded-[24px] foto Pagoda Chureito & Gunung Fuji
  - Floating Snapshot Bar: Horizontal 900x112px dengan 3 fitur & divider vertikal
--}}

<section 
  x-data="{ videoModalOpen: false }"
  class="relative w-full bg-[#FAFAFA] font-inter pt-10 sm:pt-14 pb-16 lg:pb-24" 
  data-node-id="japan-hero"
>
  {{!-- Main Hero Shell --}}
  <div class="page-shell relative z-10">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-12 lg:gap-14 pt-4 lg:pt-8">

      {{!-- hero-left: Content Column --}}
      <div class="flex flex-1 flex-col items-start gap-7 w-full lg:max-w-[680px] xl:max-w-[720px]">
        
        {{!-- Tag / Eyebrow (Premium Study Abroad with blue accent dot #6EB6E5) -> table category column type --}}
        <div class="inline-flex h-[27px] items-center gap-2 rounded-full border border-[#E5E7EB] bg-[#F8F9FA] px-4 py-1.5 shadow-xs">
          <span class="size-2.5 shrink-0 rounded-full bg-[#6EB6E5]"></span>
          <span class="font-montserrat text-[12px] font-bold leading-[15px] uppercase tracking-wider text-[#0B1F3B]">
            {{#if category.type}}{{category.type}}{{else}}{{default tagText "PREMIUM STUDY ABROAD"}}{{/if}}
          </span>
        </div>

        {{!-- Frame: Headline & Subheading -> table category column name & description --}}
        <div class="flex flex-col gap-4">
          <h1 class="font-montserrat text-3xl sm:text-4xl lg:text-[46px] xl:text-[52px] font-extrabold leading-[110%] tracking-[-1px] text-[#0B1F3B]">
            {{#if headline}}
              {{headline}}
            {{else if (getByLang category.text lang)}}
              {{getByLang category.text lang}}
            {{else}}
              Transform your future in {{default category.name "Japan"}} — from language to career.
            {{/if}}
          </h1>

          <p class="font-inter text-base sm:text-lg leading-[165%] text-[#4B5563] max-w-[600px]">
            {{#if subheading}}
              {{subheading}}
            {{else if (getByLang category.description lang)}}
              {{getByLang category.description lang}}
            {{else}}
              A structured journey designed for ambitious learners: immersive Japanese training, workplace readiness, and guided support for long-term success.
            {{/if}}
          </p>
        </div>

        {{!-- hero-ctas: Primary & Secondary Buttons (Figma spec: 390px x 52px, gap 12px) --}}
        <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-[390px] h-auto sm:h-[52px]">
          {{!-- Primary CTA: View Program --}}
          {{> components/ui/button/view_program/index
              href="#programs"
              text="View Program"
          }}

          {{!-- Secondary CTA: Watch overview --}}
          {{> components/ui/button/watch_overview/index
              xClick="videoModalOpen = true"
              text="Watch overview"
          }}
        </div>

        {{!-- Divider Line --}}
        <div class="w-full h-px bg-[#E5E7EB] my-1"></div>

        {{!-- hero-meta: Checkmark Meta Chips -> table category -> table course type column icon dan nameClassesType --}}
        <div class="flex flex-wrap items-center gap-3">
          {{#if category.courseTypes.length}}
            {{#each category.courseTypes}}
              <div class="inline-flex h-[44px] items-center gap-2.5 rounded-full border border-[#6EB6E3]/20 bg-[#6EB6E5]/10 px-3.5 py-2.5 shadow-[0px_2px_8px_rgba(0,0,0,0.04)]">
                <span class="grid size-6 shrink-0 place-items-center rounded-full border border-[#6EB6E3]/20 bg-white">
                  <i class="{{computeIcon this.icon}} text-[10px] text-[#0B1F3B]"></i>
                </span>
                <span class="font-inter text-[13px] font-semibold leading-[16px] text-[#0B1F3B] whitespace-nowrap">
                  {{this.nameClassesType}}
                </span>
              </div>
            {{/each}}
          {{else}}
            {{!-- Fallback 2 meta chips from Figma --}}
            <div class="inline-flex h-[44px] items-center gap-2.5 rounded-full border border-[#6EB6E3]/20 bg-[#6EB6E5]/10 px-3.5 py-2.5 shadow-[0px_2px_8px_rgba(0,0,0,0.04)]">
              <span class="grid size-6 shrink-0 place-items-center rounded-full border border-[#6EB6E3]/20 bg-white">
                <svg class="h-2 w-2.5 text-[#0B1F3B]" viewBox="0 0 10 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 4.2L3.5 6.7L9 1.2" stroke="#0B1F3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="font-inter text-[13px] font-semibold leading-[16px] text-[#0B1F3B] whitespace-nowrap">
                N5 readiness curriculum
              </span>
            </div>

            <div class="inline-flex h-[44px] items-center gap-2.5 rounded-full border border-[#6EB6E3]/20 bg-[#6EB6E5]/10 px-3.5 py-2.5 shadow-[0px_2px_8px_rgba(0,0,0,0.04)]">
              <span class="grid size-6 shrink-0 place-items-center rounded-full border border-[#6EB6E3]/20 bg-white">
                <svg class="h-2 w-2.5 text-[#0B1F3B]" viewBox="0 0 10 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 4.2L3.5 6.7L9 1.2" stroke="#0B1F3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="font-inter text-[13px] font-semibold leading-[16px] text-[#0B1F3B] whitespace-nowrap">
                Career &amp; study support
              </span>
            </div>
          {{/if}}
        </div>

      </div>

      {{!-- hero-right-collage: Visual Image Box (Pagoda & Mt Fuji with Cherry Blossoms) --}}
      <div class="w-full lg:w-[520px] shrink-0 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-[420px] lg:max-w-[520px] aspect-square rounded-[24px] overflow-hidden shadow-[0px_18px_40px_-12px_rgba(11,31,59,0.08)] border border-[#E5E7EB]/60 bg-white">
          <img
            src="/public/image/specialProgram/bgJapan.png"
            alt="Japan Study Program - Mount Fuji &amp; Chureito Pagoda"
            onerror="this.src='/public/image/specialProgram/bgJapan.png'"
            class="size-full object-cover transform hover:scale-105 transition-transform duration-700 ease-out"
          />
          {{!-- Subtle inner gradient overlay at bottom of image --}}
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent"></div>
        </div>
      </div>

    </div>

    {{!-- floating-snapshot-card-horizontal: Overlapping Snapshot Bar at bottom of Hero --}}
    <div class="mt-14 lg:mt-16 flex justify-center w-full">
      {{> components/ui/card/snapshot_bar/index
          item1Title="Comprehensive curriculum"
          item1Desc="Language + culture + career prep"
          item1Icon="fa-solid fa-book-open"

          item2Title="Mentor-led learning"
          item2Desc="Experienced instructors & support"
          item2Icon="fa-solid fa-chalkboard-user"

          item3Title="Career & study pathways"
          item3Desc="Guidance for next steps in Japan"
          item3Icon="fa-solid fa-compass"
      }}
    </div>

  </div>

  {{!-- Modal Overview Video (Alpine.js) --}}
  <div
    x-show="videoModalOpen"
    x-cloak
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-[9999] flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
    @keydown.escape.window="videoModalOpen = false"
    style="display: none;"
  >
    <div 
      @click="videoModalOpen = false"
      class="fixed inset-0 z-0"
    ></div>

    <div 
      x-show="videoModalOpen"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 scale-95 translate-y-4"
      x-transition:enter-end="opacity-100 scale-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 scale-100 translate-y-0"
      x-transition:leave-end="opacity-0 scale-95 translate-y-4"
      class="relative z-10 w-full max-w-3xl rounded-2xl bg-white p-6 shadow-2xl border border-gray-100"
    >
      <div class="flex items-center justify-between pb-4 border-b border-gray-100 mb-4">
        <h3 class="font-montserrat text-lg font-bold text-[#0B1F3B]">
          Program Overview: Japan Pathway
        </h3>
        <button
          type="button"
          @click="videoModalOpen = false"
          class="rounded-full p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition-colors"
          aria-label="Close modal"
        >
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>
      
      <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-slate-900 flex items-center justify-center">
        <div class="text-center p-6 text-white">
          <div class="grid size-16 mx-auto mb-3 place-items-center rounded-full bg-white/20 backdrop-blur-xs">
            <i class="fa-solid fa-play text-2xl text-white ml-1"></i>
          </div>
          <p class="font-montserrat font-semibold text-lg">Japan Study &amp; Career Overview</p>
          <p class="font-inter text-xs text-white/70 mt-1">Video overview will play here</p>
        </div>
      </div>
    </div>
  </div>

</section>
