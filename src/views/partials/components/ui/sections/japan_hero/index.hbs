{{!--
  Section: Special/Japan Program Hero - reskin 1:1 mengikuti paid_hero (Figma).
  Lokasi: src/views/partials/components/ui/sections/japan_hero/index.hbs
  Layout: eyebrow + headline + desc + CTA pill + meta chips (kiri) | image (kanan) + feature strip (bawah).
  Props: category (.name, .description, .hero_section_image, .type, .courseTypes), lang, isJapan, course, headline, subheading, tagText.
--}}
{{#*inline 'japanHeroFeature'}}
  <div class="flex flex-1 items-center gap-4">
    <div class="grid size-12 shrink-0 place-items-center rounded-full bg-[#6EB6E51F]">
      <i class="{{computeIcon icon}} text-xl text-[#0B1F3B]" aria-hidden="true"></i>
    </div>
    <div class="flex flex-1 flex-col gap-1">
      {{> components/ui/text/sub_title/index
          text=title
          tag="span"
          size="body-sm"
          color="gray"
          font="inter"
          fontWeight="font-bold"
          align="left"
          class="font-inter leading-[17px]" }}
      {{> components/ui/text/description/index
          text=description
          tag="span"
          size="body-sm"
          color="muted"
          font="inter"
          align="left"
          class="leading-[15px] !text-[#4B5563]" }}
    </div>
  </div>
{{/inline}}

<section id="hero" class="relative w-full overflow-hidden bg-[#F9FAFB] font-inter">
  {{!-- hero-bg-wash: gradien lembut pink -> biru (desain pencil, sama seperti paid_hero) --}}
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#FDE7F3]/20 to-[#E0F2FE]/20" aria-hidden="true"></div>

  <div class="page-shell relative flex flex-col justify-center gap-10 py-16 lg:min-h-[560px] lg:flex-row lg:items-center lg:gap-[72px] lg:py-20">

    {{!-- hero-left --}}
    <div class="flex flex-1 flex-col items-start gap-7">

      {{!-- tag: pill with red accent dot (#E63946) --}}
      <span class="inline-flex items-center gap-2 rounded-full border border-[#E5E7EB] bg-[#F8F9FA] px-4 py-1.5">
        <span class="size-2.5 shrink-0 rounded-full bg-[#E63946]"></span>
        <span class="font-inter text-xs font-bold uppercase leading-[15px] text-[#0B1F3B]">
          {{#if category.type}}{{category.type}}{{else}}{{default tagText (default (t 'test.special_program.heroSection.tagText') 'PREMIUM STUDY ABROAD')}}{{/if}}
        </span>
      </span>

      {{!-- Frame: headline + subheading --}}
      <div class="flex flex-col items-start gap-4">
        <h1 class="max-w-[809px] font-inter text-3xl font-extrabold leading-[110%] tracking-[-1px] text-[#0B1F3B] lg:text-[52px]">
          {{#if headline}}
            {{headline}}
          {{else if category.name}}
            {{nameByLang category lang}}
          {{else if (getByLang category.text lang)}}
            {{getByLang category.text lang}}
          {{else}}
            {{#if (or isJapan (includes category.name 'japan'))}}{{default (t 'test.special_program.heroSection.defaultHeadlineJapan') 'Transform your future in Japan — from language to career.'}}{{else}}{{default (t 'test.special_program.heroSection.defaultHeadlineGeneral') 'Transform your future with us — from learning to career.'}}{{/if}}
          {{/if}}
        </h1>

        <p class="max-w-full font-inter text-base leading-[165%] text-[#4B5563]">
          {{#if subheading}}
            {{subheading}}
          {{else if (getByLang course.description lang)}}
            {{getByLang course.description lang}}
          {{else if (getByLang category.description lang)}}
            {{getByLang category.description lang}}
          {{else}}
            {{#if (or isJapan (includes category.name 'japan'))}}{{default (t 'test.special_program.heroSection.defaultSubheadingJapan') 'A structured journey designed for ambitious learners: immersive Japanese training, workplace readiness, and guided support for long-term success.'}}{{else}}{{default (t 'test.special_program.heroSection.defaultSubheadingGeneral') 'A structured journey designed for ambitious learners: practical industry training, workplace readiness, and guided support for long-term success.'}}{{/if}}
          {{/if}}
        </p>
      </div>

      {{!-- hero-ctas --}}
      <div class="flex flex-col items-center gap-3 sm:flex-row">
        {{!-- cta-primary: #0B1F3B pill --}}
        {{> components/ui/button/btn_action/index
            onClick="document.getElementById('programs')?.scrollIntoView({ behavior: 'smooth', block: 'start' })"
            text=(default (t 'test.special_program.heroSection.buttonViewProgram') 'View Program')
            icon="fas fa-arrow-right text-sm shrink-0"
            iconPosition="right"
            variant="dark-navy"
            class="!h-[52px] gap-2.5 !rounded-full px-[22px] py-[14px] shadow-[0px_10px_24px_-8px_rgba(11,31,59,0.0784314)]"
            textClass="font-inter text-[15px] font-bold leading-[18px] text-white" }}
      </div>

      {{!-- divider line --}}
      <div class="w-full border-t border-[#E5E7EB]"></div>

      {{!-- hero-meta: chips -> table category -> table course type column icon dan nameClassesType --}}
      <div class="flex flex-wrap items-center gap-3">
        {{#if category.courseTypes.length}}
          {{#each category.courseTypes}}
            <span class="inline-flex items-center gap-2.5 rounded-full border border-[#6EB6E333] bg-[#6EB6E51A] px-3.5 py-2.5 shadow-[0px_2px_8px_rgba(0,0,0,0.04)]">
              <span class="grid size-6 shrink-0 place-items-center rounded-full border border-[#6EB6E333] bg-white">
                <i class="{{computeIcon this.icon}} text-[10px] text-[#0B1F3B]" aria-hidden="true"></i>
              </span>
              <span class="font-inter text-[13px] font-semibold leading-4 text-[#0B1F3B] whitespace-nowrap">
                {{this.nameClassesType}}
              </span>
            </span>
          {{/each}}
        {{else}}
          <span class="inline-flex items-center gap-2.5 rounded-full border border-[#6EB6E333] bg-[#6EB6E51A] px-3.5 py-2.5 shadow-[0px_2px_8px_rgba(0,0,0,0.04)]">
            <span class="grid size-6 shrink-0 place-items-center rounded-full border border-[#6EB6E333] bg-white">
              <i class="fas fa-check text-[10px] text-[#0B1F3B]" aria-hidden="true"></i>
            </span>
            <span class="font-inter text-[13px] font-semibold leading-4 text-[#0B1F3B]">
              {{#if (or isJapan (includes category.name 'japan'))}}{{default (t 'test.special_program.heroSection.curriculumChipJapan') 'N5 readiness curriculum'}}{{else}}{{default (t 'test.special_program.heroSection.curriculumChipGeneral') 'Industry-standard curriculum'}}{{/if}}
            </span>
          </span>
          <span class="inline-flex items-center gap-2.5 rounded-full border border-[#6EB6E333] bg-[#6EB6E51A] px-3.5 py-2.5 shadow-[0px_2px_8px_rgba(0,0,0,0.04)]">
            <span class="grid size-6 shrink-0 place-items-center rounded-full border border-[#6EB6E333] bg-white">
              <i class="fas fa-check text-[10px] text-[#0B1F3B]" aria-hidden="true"></i>
            </span>
            <span class="font-inter text-[13px] font-semibold leading-4 text-[#0B1F3B]">{{default (t 'test.special_program.heroSection.supportChip') 'Career & study support'}}</span>
          </span>
        {{/if}}
      </div>
    </div>

    {{!-- hero-right: visual (full width) --}}
    <div class="w-full lg:flex-1">
      <div class="w-full overflow-hidden rounded-xl lg:rounded-2xl">
        <img
          src="{{#if course.image}}{{course.image}}{{else if category.hero_section_image}}{{category.hero_section_image}}{{else if (or isJapan (includes category.name 'japan'))}}/public/image/specialProgram/bgJapan.png{{else}}/public/image/dashboard/bgHeroSection.png{{/if}}"
          alt="{{#if course.name}}{{course.name}}{{else if (or isJapan (includes category.name 'japan'))}}Japan Study Program - Mount Fuji &amp; Chureito Pagoda{{else}}{{nameByLang category lang}}{{/if}}"
          onerror="this.src='{{#if (or isJapan (includes category.name 'japan'))}}/public/image/specialProgram/bgJapan.png{{else}}/public/image/dashboard/bgHeroSection.png{{/if}}'"
          class="block h-auto w-full"
        />
      </div>
    </div>
  </div>

  {{!-- floating-snapshot-card-horizontal: feature strip --}}
  <div class="page-shell relative pb-14 lg:pb-20">
    <div class="mx-auto flex max-w-[900px] flex-col items-center justify-between gap-6 rounded-[20px] border border-[#E5E7EB] bg-white px-6 py-[18px] shadow-[0px_16px_32px_-4px_rgba(11,31,59,0.05)] sm:flex-row sm:gap-0 sm:px-6 lg:px-6">
        {{> japanHeroFeature icon="fa-solid fa-book-open" title=(default (t 'test.special_program.heroSection.snapshot1Title') "Comprehensive curriculum") description=(ternary (or isJapan (includes category.name 'japan')) (default (t 'test.special_program.heroSection.snapshot1DescJapan') "Language + culture + career prep") (default (t 'test.special_program.heroSection.snapshot1DescGeneral') "Practical + industry readiness"))}}
        <div class="hidden h-12 w-px shrink-0 bg-[#E5E7EB] sm:block" aria-hidden="true"></div>
        {{> japanHeroFeature icon="fa-solid fa-chalkboard-user" title=(default (t 'test.special_program.heroSection.snapshot2Title') "Mentor-led learning") description=(default (t 'test.special_program.heroSection.snapshot2Desc') "Experienced instructors & support")}}
        <div class="hidden h-12 w-px shrink-0 bg-[#E5E7EB] sm:block" aria-hidden="true"></div>
        {{> japanHeroFeature icon="fa-solid fa-compass" title=(ternary (or isJapan (includes category.name 'japan')) (default (t 'test.special_program.heroSection.snapshot3TitleJapan') "Career & study pathways") (default (t 'test.special_program.heroSection.snapshot3TitleGeneral') "Career development pathways")) description=(ternary (or isJapan (includes category.name 'japan')) (default (t 'test.special_program.heroSection.snapshot3DescJapan') "Guidance for next steps in Japan") (default (t 'test.special_program.heroSection.snapshot3DescGeneral') "Guidance for professional growth"))}}
    </div>
  </div>
</section>