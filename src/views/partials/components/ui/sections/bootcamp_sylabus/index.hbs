{{!--
  Komponen: Bootcamp Syllabus / Curriculum Section (Level 2 - Section)
  Lokasi: src/views/partials/components/ui/sections/bootcamp_sylabus.hbs
  Referensi Figma: Node 1149-830 (Curriculum Section)

  Props:
  - course_flows : array (opsional, data course_flow dari controller)
  - course       : object (opsional, fallback ke course.courseFlow)
  - badgeTitle   : string (opsional, default: "BOOTCAMP SYLLABUS")
  - title        : string (opsional, default: "Structured & Industry-Proven Curriculum")
  - description  : string (opsional, default: "Complete a hands-on, project-based curriculum designed to align with current digital corporate operational standards.")
  - lang         : string (opsional, kode bahasa)
--}}

<section id="curriculum" class="w-full bg-[#FAFAFA] py-16 md:py-24 lg:py-[120px] px-4 sm:px-8 lg:px-[80px] flex flex-col items-center font-inter relative z-0">
  <div class="w-full max-w-[1568px] mx-auto flex flex-col items-center gap-10 md:gap-14 lg:gap-[64px]">

    {{!-- Curriculum Header --}}
    <div class="w-full max-w-[1568px] flex flex-col items-center gap-4 text-center">
      {{!-- Badge --}}
      <div class="inline-flex items-center justify-center px-4 py-2 bg-[#E0F2FE] rounded-full">
        <span class="font-inter font-bold text-[14px] leading-[17px] text-[#003060] uppercase tracking-wider">
          {{default badgeTitle "BOOTCAMP SYLLABUS"}}
        </span>
      </div>

      {{!-- Main Title (Hanya font Inter) --}}
      <h2 class="font-inter font-extrabold text-[28px] sm:text-[32px] md:text-[36px] leading-[36px] sm:leading-[40px] md:leading-[44px] text-center text-[#0B1F3B] max-w-[1568px]">
        {{default title "Structured & Industry-Proven Curriculum"}}
      </h2>

      {{!-- Subtitle / Description --}}
      <p class="font-inter font-normal text-[15px] sm:text-[16px] leading-[19px] sm:leading-[24px] text-center text-[#64748B] max-w-[680px]">
        {{default description "Complete a hands-on, project-based curriculum designed to align with current digital corporate operational standards."}}
      </p>
    </div>

    {{!-- Curriculum Accordion Grid (Max width 1040px) --}}
    <div
      class="w-full max-w-[1040px] flex flex-col items-center gap-4 sm:gap-5 md:gap-[30px]"
      x-data="{
        opened: {},
        init() {
          const total = {{#if (or course_flows.length course.courseFlow.length)}}{{default course_flows.length course.courseFlow.length}}{{else}}0{{/if}};
          for (let i = 0; i < total; i++) {
            this.opened[i] = true;
          }
        },
        isOpen(index) {
          return this.opened[index] === true;
        },
        toggle(index) {
          this.opened[index] = !this.isOpen(index);
        }
      }"
    >
      {{#if (or course_flows.length course.courseFlow.length)}}
        {{#each (default course_flows course.courseFlow)}}
          <div class="box-border w-full bg-white border border-[#E2E8F0] rounded-[12px] p-6 flex flex-col gap-4 transition-shadow duration-200 hover:shadow-sm">
            {{!-- Top Row --}}
            <button
              type="button"
              @click="toggle({{@index}})"
              class="w-full flex flex-row justify-between items-center text-left focus:outline-none cursor-pointer select-none group"
              aria-label="Toggle curriculum item"
            >
              {{!-- Left Frame: Icon Box + Title --}}
              <div class="flex flex-row items-center gap-4 min-w-0 pr-2">
                {{!-- Award Icon Box (44x44, rounded 14px, bg rgba(110, 182, 229, 0.08)) --}}
                <div class="w-[44px] h-[44px] min-w-[44px] min-h-[44px] flex items-center justify-center rounded-[14px] bg-[rgba(110,182,229,0.08)] shrink-0">
                  <svg class="w-[22px] h-[22px] text-[#0B1F3B]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="7"></circle>
                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                  </svg>
                </div>

                {{!-- Item Title --}}
                <h3 class="font-inter font-bold text-[18px] sm:text-[20px] md:text-[22px] leading-[27px] text-[#0B1F3B] truncate sm:whitespace-normal">
                  {{getByLang this.title ../lang}}
                </h3>
              </div>

              {{!-- Right Frame: Chevron Icon --}}
              <div class="shrink-0 ml-2">
                <svg
                  class="w-5 h-5 text-[#64748B] transition-transform duration-300 transform"
                  :class="isOpen({{@index}}) ? 'rotate-180' : ''"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
            </button>

            {{!-- Item Content / Description --}}
            <div
              x-show="isOpen({{@index}})"
              x-collapse
              class="w-full"
            >
              <p class="font-inter font-normal text-[15px] sm:text-[16px] leading-[150%] text-[#66738C]">
                {{getByLang this.content ../lang}}
              </p>
            </div>
          </div>
        {{/each}}
      {{else}}
        {{!-- Empty State: Belum Ada Silabus / Kurikulum --}}
        <div class="w-full flex flex-col items-center justify-center p-8 sm:p-12 md:p-16 rounded-[20px] border border-dashed border-[#CBD5E1] bg-white text-center shadow-[0px_4px_16px_rgba(0,0,0,0.02)]">
          <div class="relative mb-5 flex size-20 sm:size-24 items-center justify-center rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] shadow-2xs">
            <span class="flex size-14 items-center justify-center rounded-xl bg-[#E0F2FE] text-[#003060]">
              <i class="fa-solid fa-layer-group text-2xl sm:text-3xl"></i>
            </span>
            <span class="absolute -top-1.5 -right-1.5 flex size-6 items-center justify-center rounded-full bg-[#F59E0B] text-white text-[10px] shadow-sm">
              <i class="fa-solid fa-clock"></i>
            </span>
          </div>

          <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#E0F2FE] border border-[#BAE6FD] text-[#0369A1] text-xs font-semibold uppercase tracking-wider mb-3">
            <span class="size-1.5 rounded-full bg-[#0284C7] animate-pulse"></span>
            {{default (t 'test.freeProgram.sylabus.emptyBadge') 'Sedang Disiapkan'}}
          </span>

          <h3 class="font-inter font-bold text-lg sm:text-xl md:text-2xl text-[#0B1F3B] mb-2 max-w-md">
            {{default (t 'test.freeProgram.sylabus.emptyTitle') 'Silabus Belum Tersedia'}}
          </h3>

          <p class="font-inter font-normal text-sm sm:text-base leading-relaxed text-[#64748B] max-w-lg">
            {{default (t 'test.freeProgram.sylabus.emptyDesc') 'Rincian modul dan silabus kurikulum untuk program ini sedang dipersiapkan oleh tim instruktur untuk menjamin materi pembelajaran terbaik.'}}
          </p>
        </div>
      {{/if}}
    </div>

  </div>
</section>
