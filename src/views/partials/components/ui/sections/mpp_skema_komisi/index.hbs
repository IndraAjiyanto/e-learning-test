<section class="w-full bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-[1728px] px-6 lg:px-12">

        <!-- Heading -->
        {{> components/ui/text/section_header/index
            wrapperClass="mx-auto max-w-[904px] text-center"
            title="Skema Komisi dan Insentif"
            titleClass="mb-8 text-[36px] font-bold text-[#003060] sm:text-4xl"
            description="Skema berikut merupakan contoh kerangka tingkatan mitra. Nominal komisi perlu disesuaikan dengan struktur margin dan kebijakan bisnis internal sebelum diimplementasikan."
            descClass="font-sans text-[20px] leading-8 text-gray-900"
        }}

        <!-- Table -->
        <div class="mx-auto mt-12 flex h-[481px] overflow-hidden rounded-xl border border-gray-300 shadow-lg">

            <!-- TINGKATAN -->
            <div class="flex w-[22%] flex-col ">

                <!-- Header -->
                <div class="flex h-[75px] shrink-0 items-center justify-center bg-[#003060] px-4 text-center font-sans text-[25px] font-semibold text-white">
                    {{> components/ui/text/sub_title/index
                        tag="h2"
                        text="TINGKATAN"
                        size="xl"
                        color="white"
                        font="sans"
                        fontWeight="font-semibold"
                    }}
                </div>

                <!-- Content -->
                <div class="flex flex-1 flex-col bg-white font-sans text-[20px] border-r border-gray-300 text-gray-900">

                    <div class="flex flex-1 items-center justify-center border-gray-200 px-6">
                        {{> components/ui/text/description/index
                            text="Partner Starter"
                            color="gray"
                            align="center"
                            font="sans"
                            class="text-[30px]"
                        }}
                    </div>

                    <div class="flex flex-1 items-center justify-center border-gray-200 px-6">
                        {{> components/ui/text/description/index
                            text="Partner Active"
                            color="gray"
                            align="center"
                            font="sans"
                            class="text-[30px]"
                        }}
                    </div>

                    <div class="flex flex-1 items-center justify-center px-6">
                        {{> components/ui/text/description/index
                            text="Partner Lead"
                            color="gray"
                            align="center"
                            font="sans"
                            class="text-[30px]"
                        }}
                    </div>

                </div>
            </div>

            <!-- SYARAT -->
            <div class="flex w-[25%] flex-col ">

                <!-- Header -->
                <div class="flex h-[75px] shrink-0 items-center justify-center bg-[#003060] px-4 text-center font-sans text-[25px] font-semibold text-white">
                    {{> components/ui/text/sub_title/index
                        tag="h2"
                        text="SYARAT"
                        size="xl"
                        color="white"
                        font="sans"
                        fontWeight="font-semibold"
                    }}
                </div>

                <!-- Content -->
                <div class="flex flex-1 flex-col bg-white font-sans text-[20px] border-r border-gray-300 text-gray-900">

                    <div class="flex flex-1 items-center justify-center border-gray-200 px-6">
                        {{> components/ui/text/description/index
                            text="Baru bergabung"
                            color="gray"
                            align="center"
                            font="sans"
                            class="text-[30px]"
                        }}
                    </div>

                    <div class="flex flex-1 items-center justify-center border-gray-200 px-6">
                        {{> components/ui/text/description/index
                            text="≥ 3 closing per bulan"
                            color="gray"
                            align="center"
                            font="sans"
                            class="text-[30px]"
                        }}
                    </div>

                    <div class="flex flex-1 items-center justify-center px-6">
                        {{> components/ui/text/description/index
                            text="≥ 10 closing per bulan"
                            color="gray"
                            align="center"
                            font="sans"
                            class="text-[30px]"
                        }}
                    </div>

                </div>
            </div>

            <!-- KOMISI -->
            <div class="flex w-[28%] flex-col ">

                <!-- Header -->
                <div class="flex h-[75px] shrink-0 items-center justify-center bg-[#003060] px-4 text-center font-sans text-[25px] font-semibold leading-7 text-white">
                    {{> components/ui/text/sub_title/index
                        tag="h2"
                        text="KOMISI PER PENDAFTAR"
                        size="xl"
                        color="white"
                        font="sans"
                        fontWeight="font-semibold"
                        class="leading-7"
                    }}
                </div>

                <!-- Content -->
                <div class="flex flex-1 flex-col bg-white font-sans border-r border-gray-300 text-[20px] text-gray-900">

                    <!-- Starter -->
                    <div class="flex flex-1 items-center border-gray-200 px-28">
                        <p>
                            <span class="text-[30px]">7%</span>
                            per closing
                        </p>
                    </div>

                    <!-- Active -->
                    <div class="flex flex-1 flex-col justify-center border-gray-200 mx-auto">
                        <p>
                            <span class="text-[30px]">7%</span>
                            per closing
                        </p>
                        <p>
                            <span class="text-[30px]">+5%</span>
                            revenue per batch
                        </p>
                    </div>

                    <!-- Lead -->
                    <div class="flex flex-1 flex-col justify-center mx-auto">
                        <p>
                            <span class="text-[30px]">7%</span>
                            per closing
                        </p>
                        <p>
                            <span class="text-[30px]">+5%</span>
                            revenue per batch
                        </p>
                    </div>

                </div>
            </div>

            <!-- BENEFIT -->
            <div class="flex min-w-0 flex-1 flex-col">

                <!-- Header -->
                <div class="flex h-[75px] shrink-0 items-center justify-center bg-[#003060] px-4 text-center font-sans text-[25px] font-semibold leading-7 text-white">
                    {{> components/ui/text/sub_title/index
                        tag="h2"
                        text="BENEFIT TAMBAHAN"
                        size="xl"
                        color="white"
                        font="sans"
                        fontWeight="font-semibold"
                        class="leading-7"
                    }}
                </div>

                <!-- Content -->
                <div class="flex flex-col mt-10 bg-white font-sans border-r border-gray-300 text-[20px] text-gray-900">

                    <div class="flex flex-1 items-center gap-4 mb-2 px-6">
                        <i class="fa-solid fa-circle-check text-[#003060]"></i>
                        {{> components/ui/text/description/index
                            text="Akses campaign eksklusif"
                            color="gray"
                            align="left"
                            font="sans"
                            class="text-[30px]"
                        }}
                    </div>

                    <div class="flex flex-1 items-center gap-4 px-6">
                        <i class="fa-solid fa-circle-check text-[#003060]"></i>
                        {{> components/ui/text/description/index
                            text="Mentoring karir"
                            color="gray"
                            align="left"
                            font="sans"
                            class="text-[30px]"
                        }}
                    </div>

                    

                </div>
            </div>

        </div>
    </div>
</section>