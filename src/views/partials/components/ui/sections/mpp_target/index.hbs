            color="gray"
            align="justify"
            class="text-[25px] leading-7"
        }}
    </div>

    <div class="flex items-start gap-4">
        <span class="mt-2 h-[25px] w-[25px] shrink-0 rounded-full bg-[linear-gradient(162.23deg,#6EB6E5_-3.62%,#003060_104.94%)]"></span>

