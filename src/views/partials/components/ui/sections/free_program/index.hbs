{{!--
  Section: Free Program - Program Selection / Course List (L2)
  Lokasi: src/views/partials/components/ui/sections/free_program/index.hbs
  
  Slicing presisi 100% sesuai Figma Node 2591:835 (Program Selection):
  - Background: #FAFAFA / #F9FAFB
  - Section Header (Node 2591:836):
    - Title: Montserrat Bold 44px "#6EB6E5 Short Classes" "#0B1F3B for You"
    - Subtitle: Inter Regular 18px text-[#6B7280] max-w-[760px]
  - Grid: 3 kolom responsif (Node 2591:839 program-cards, gap 24px)
  - Card: High fidelity matching Node 2591:840
  
  Props:
  - category (.name), courses[], lang.
--}}

<section id="programs" class="w-full bg-[#FAFAFA] py-16 font-inter lg:py-24" data-node-id="2591:835">
  <div class="page-shell flex flex-col items-center gap-12 lg:gap-14">


    {{> components/ui/sections/program_section_header/index category=category lang=lang}}

    {{#if courses.length}}
      {{#> components/ui/filter/course_catalog_filter/index courses=courses lang=lang showPayment=true}}

        <div
          x-show="visibleIds.length > 0"
          class="grid w-full grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 items-stretch justify-items-center max-w-[1568px]"
        >
          {{#each courses}}
            <div
              x-show="visibleIds.includes('{{this.id}}')"
              x-transition.opacity.duration.200ms
              class="w-full flex"
            >
              {{> components/ui/card/program_showcase/index
                  id=this.id
                  image=this.image
                  icon=(default this.icon "fa-solid fa-graduation-cap")
                  title=this.name
                  description=(default (getByLang this.description ../lang) (default this.description "A structured journey from fundamentals to workplace readiness and long-term career opportunities."))
                  tag1=(ternary this.method this.method (default (t 'test.categoryPaidProgram.program.online') "Online"))
                  tag2=(ternary (or (eq this.checkPaid false) this.day) (concat (default this.day 1) " " (default (t 'test.categoryPaidProgram.program.day') "Day")) (concat (default this.month 1) " " (default (t 'test.categoryPaidProgram.program.month') "Month")))
                  tag3=(ternary this.quota (concat this.quota " " (default (t 'test.categoryPaidProgram.program.quota') "Quota")) (concat "20 " (default (t 'test.categoryPaidProgram.program.quota') "Quota")))
                  href=(concat '/program/' this.id)
                  lang=../lang
              }}
            </div>
          {{/each}}
        </div>
      {{/components/ui/filter/course_catalog_filter/index}}
    {{else}}
      {{!-- Tidak ada program berstatus Published/launch -> Coming Soon (gaya corporate_training) --}}
      {{> components/ui/sections/program_coming_soon/index
          title=(default (t 'test.categoryFreeProgram.program.comingSoonTitle') "Program Coming Soon")
          text=(default (t 'test.categoryFreeProgram.program.comingSoonText') "We're preparing this program to deliver the best learning experience. Stay tuned for updates.")
      }}
    {{/if}}

  </div>
</section>
