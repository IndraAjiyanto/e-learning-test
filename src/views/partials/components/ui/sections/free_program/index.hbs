{{!--
  Section: Free Program - course list (L2) - reskin ke standar internal.
  Lokasi: src/views/partials/components/ui/sections/free_program/index.hbs
  Props: category (.name), courses[], lang.
--}}
<section id="programs" class="w-full bg-white py-14 font-montserrat lg:py-20">
  <div class="page-shell flex flex-col items-center gap-12 lg:gap-16">

    <div class="flex max-w-[640px] flex-col items-center gap-4 text-center">
      {{> components/ui/text/eyebrow/index text=(t 'test.categoryFreeProgram.program.eyebrow') }}
      <h2 class="{{sizeClass 'h2'}} font-montserrat font-bold text-[#0B1F3B]">
        <span class="text-[#6EB6E5]">{{category.name}}</span> {{t 'test.categoryFreeProgram.program.title'}}
      </h2>
      <p class="{{sizeClass 'lead'}} font-open-sans text-[#4A5568]">
        {{t 'test.categoryFreeProgram.program.description1'}} {{category.name}} {{t 'test.categoryFreeProgram.program.description2'}}
      </p>
    </div>

    {{#if courses.length}}
      <div class="flex w-full flex-wrap justify-center gap-6 [&>*]:w-full [&>*]:sm:w-[calc((100%-1.5rem)/2)] [&>*]:lg:w-[calc((100%-3rem)/3)]">
        {{#each courses}}
          {{> components/ui/card/category/free/index
              id=this.id
              image=(default this.thumbnail this.image)
              name=this.name
              day=this.day
              method=this.method
              quota=this.quota }}
        {{/each}}
      </div>
    {{else}}
      <div class="flex w-full max-w-[560px] flex-col items-center gap-4 rounded-2xl border border-[#E5E7EB] bg-white p-10 text-center shadow-[0px_10px_24px_-12px_rgba(0,0,0,0.06)] lg:p-14">
        <span class="grid size-14 place-items-center rounded-full bg-[#0B1F3B] text-white">
          <i class="fas fa-clock text-lg"></i>
        </span>
        <h3 class="{{sizeClass 'h3'}} font-montserrat font-bold text-[#111827]">{{t 'test.special_program.program.comingSoonTitle'}}</h3>
        <p class="{{sizeClass 'body'}} font-open-sans leading-relaxed text-[#6B7280]">{{t 'test.special_program.program.comingSoonText'}}</p>
      </div>
    {{/if}}
  </div>
</section>
