{{!--
  Section: Paid Program Hero (Bootcamp) (L2) - reskin ke standar internal (no Figma).
  Lokasi: src/views/partials/components/ui/sections/paid_hero/index.hbs
  Satu pohon markup, base + lg. .page-shell, sizeClass, font-montserrat heading + open-sans body.
  Props: category (.name, .description, .hero_section_image, .contact, .type), lang.
--}}
<section id="hero" class="w-full bg-[#F8F9FA] font-montserrat">
  <div class="page-shell py-14 lg:py-20">
    <div class="relative overflow-hidden rounded-[28px] bg-[#003060] px-6 py-12 lg:px-14 lg:py-16">
      <img
        src="{{#if category.hero_section_image}}{{category.hero_section_image}}{{else}}/public/image/dashboard/bgHeroSection.png{{/if}}"
        alt="{{category.name}}"
        onerror="this.style.display='none'"
        class="pointer-events-none absolute inset-0 size-full object-cover opacity-25"
      />
      <div class="relative flex max-w-[640px] flex-col items-start gap-5">
        {{> components/ui/text/eyebrow/index text=(default (getByLang category.type lang) (default category.type (t 'test.categoryPaidProgram.hero.eyebrow'))) }}

        <h1 class="{{sizeClass 'display'}} font-montserrat font-extrabold tracking-[-0.02em] text-white">
          {{#if category.name}}{{category.name}}{{else}}Bootcamp{{/if}}
        </h1>

        <p class="{{sizeClass 'lead'}} max-w-[560px] font-open-sans text-white/85">
          {{default (getByLang category.description lang) (t 'test.categoryPaidProgram.hero.description')}}
        </p>

        <div class="mt-1 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
          {{> components/ui/button/btn_action/index
              onClick="document.getElementById('programs')?.scrollIntoView({ behavior: 'smooth', block: 'start' })"
              text=(t 'test.categoryPaidProgram.hero.explore')
              icon="fas fa-arrow-right text-sm shrink-0"
              iconPosition="right"
              variant="white"
              class="gap-2.5 px-8 py-4 text-sm" }}
          {{> components/ui/button/btn_action/index
              href=(waLink category.contact)
              target="_blank"
              text=(t 'test.categoryPaidProgram.hero.consultation')
              icon="fas fa-headset text-sm shrink-0"
              variant="outline-white"
              class="gap-2.5 px-8 py-4 text-sm" }}
        </div>
      </div>
    </div>
  </div>
</section>
