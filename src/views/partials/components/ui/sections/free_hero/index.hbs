{{!--
  Section: Free Program Hero (L2) - reskin ke standar internal (no Figma).
  Lokasi: src/views/partials/components/ui/sections/free_hero/index.hbs
  Props: category (.name, .hero_section_image), lang.
--}}
<section class="w-full bg-[#F8F9FA] font-montserrat">
  <div class="page-shell flex flex-col justify-center gap-10 py-16 lg:min-h-[520px] lg:flex-row lg:items-center lg:gap-[72px] lg:py-20">

    <div class="flex flex-1 flex-col items-start gap-6">
      {{> components/ui/text/eyebrow/index text=(t 'test.categoryFreeProgram.hero.eyebrow') }}

      <h1 class="{{sizeClass 'display'}} max-w-[640px] font-montserrat font-extrabold tracking-[-0.02em] text-[#0B1F3B]">
        {{t 'test.categoryFreeProgram.hero.title'}} <span class="text-[#6EB6E5]">{{category.name}}</span> {{t 'test.categoryFreeProgram.hero.title1'}} {{t 'test.categoryFreeProgram.hero.title2'}} {{t 'test.categoryFreeProgram.hero.title3'}}
      </h1>

      <p class="{{sizeClass 'lead'}} max-w-[560px] font-open-sans text-[#4A5568]">
        {{t 'test.categoryFreeProgram.hero.description'}}
      </p>

      {{> components/ui/button/btn_action/index
          onClick="document.getElementById('programs')?.scrollIntoView({ behavior: 'smooth', block: 'start' })"
          text=(t 'test.categoryFreeProgram.hero.button')
          icon="fas fa-arrow-right text-sm shrink-0"
          iconPosition="right"
          variant="primary"
          class="gap-2.5 px-8 py-4 text-sm shadow-none hover:-translate-y-0.5 hover:shadow-lg" }}
    </div>

    <div class="w-full lg:w-[520px] lg:shrink-0">
      <div class="aspect-[4/3] w-full overflow-hidden rounded-3xl bg-[#E0F2F9] lg:aspect-[73/50]">
        <img
          src="{{#if category.hero_section_image}}{{category.hero_section_image}}{{else}}/public/image/dashboard/bgHeroSection.png{{/if}}"
          alt="{{category.name}}"
          onerror="this.src='/public/image/dashboard/bgHeroSection.png'"
          class="size-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
