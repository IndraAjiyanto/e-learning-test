<!-- SCHEDULE & FEES SECTION -->
<section id="schedule-fees" class="w-full bg-[#FAFAFA] py-20 font-montserrat flex justify-center">
  
  <div class="max-w-[800px] w-full px-8 flex flex-col items-center">
    
    <!-- 1. Badge Judul (Tengah) -->
    {{> components/ui/text/section_header/index
      badge=(default badgeTitle (t 'test.freeProgram.badge.schedule'))
      badgeClass="px-14 py-2.5 mb-14 font-medium text-base"
    }}

    {{> components/ui/text/sub_title/index
      text=(t 'test.freeProgram.schedule.title')
      tag="h2"
      align="center"
      color="text-[#22C55E]"
      class="text-[28px] md:text-[34px] font-bold mb-4"
    }}

    {{> components/ui/text/description/index
      text=(t 'test.freeProgram.schedule.description')
      align="center"
      color="gray"
      class="text-[16px] mb-10"
    }}

    <!-- 3. Kotak Jadwal (Abu-abu rounded) -->
    <div class="bg-[#F3F4F6] rounded-[12px] w-full max-w-[650px] p-6 md:px-10 md:py-8 flex flex-col gap-6 mb-12">
      
      <!-- Baris Pendaftaran -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center text-[18px] md:text-[20px] gap-2">
        <span class="text-black font-bold">{{t 'test.freeProgram.schedule.registration'}}</span>
        <span class="text-gray-800 text-left sm:text-right">
          Until {{formatDate course.date_registration lang}}
        </span>
      </div>
      
      <!-- Baris Mulai -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center text-[18px] md:text-[20px] gap-2">
        <span class="text-black font-bold">{{t 'test.freeProgram.schedule.start'}}</span>
        <span class="text-gray-800 text-left sm:text-right">
          {{formatDate course.startDate lang}}
        </span>
      </div>
      
    </div>

    <!-- 4. Tombol Pendaftaran -->
    {{> components/ui/button/btn_action/index
      xClick="openRegistrationModal()"
      text=(t 'test.freeProgram.schedule.regisNow')
      variant="primary"
      class="w-full max-w-[340px] py-4 text-[18px] font-medium rounded-[10px]"
    }}

  </div>
</section>