{{!--
  Komponen: Program Detail Gallery Section (Level 2 - Section)
  Lokasi: src/views/partials/components/ui/sections/program_detail_gallery/index.hbs

  Props:
  - badgeTitle : string (opsional, default test.paidProgram.navbarMenu.gallery)
  - lang       : string (opsional)
--}}

<!-- GALLERY SECTION -->
<section id="gallery" class="w-full py-20 bg-[#FAFAFA] font-montserrat">
  
  <div class="max-w-[1537px] mx-auto px-8 lg:px-16 flex flex-col items-center">
    
    <!-- 1. Header (Badge & Sub-judul) -->
    <!-- Badge Baru dengan bentuk lebar & presisi -->
    {{> components/ui/text/section_header/index
      badge=(default badgeTitle (t 'test.paidProgram.navbarMenu.gallery'))
      badgeClass="px-14 py-2.5 mb-14 font-medium text-base"
    }}
    
    <!-- Sub-judul -->
    {{> components/ui/text/description/index
      text=(t 'test.paidProgram.gallery.description')
      size="lg"
      class="mb-14"
    }}

    <!-- 2. Gallery Grid (3 Kolom) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 justify-items-center w-full max-w-[1200px]">
      
      <!-- KOLOM 1 -->
      <div class="flex flex-col gap-6 lg:gap-8 w-full">
        {{> components/ui/card/gallery/index
          image=course.category.gallery.[0].filePath
          heightClass="h-[225px] md:h-[240px]"
        }}
        {{> components/ui/card/gallery/index
          image=course.category.gallery.[1].filePath
          heightClass="h-[433px] md:h-[460px]"
        }}
      </div>
      
      <!-- KOLOM 2 -->
      <div class="flex flex-col gap-6 lg:gap-8 w-full">
        {{> components/ui/card/gallery/index
          image=course.category.gallery.[2].filePath
          heightClass="h-[433px] md:h-[460px]"
        }}
        {{> components/ui/card/gallery/index
          image=course.category.gallery.[3].filePath
          heightClass="h-[225px] md:h-[240px]"
        }}
      </div>
      
      <!-- KOLOM 3 -->
      <div class="flex flex-col gap-6 lg:gap-8 w-full">
        {{> components/ui/card/gallery/index
          image=course.category.gallery.[4].filePath
          heightClass="h-[225px] md:h-[240px]"
        }}
        {{> components/ui/card/gallery/index
          image=course.category.gallery.[5].filePath
          heightClass="h-[433px] md:h-[460px]"
        }}
      </div>
      
    </div>

    <!-- 3. Teks Bawah (Tautan) -->
    <div class="mt-16">
      <a href="/dashboard/gallery" class="inline-flex items-center gap-2 text-[#0B1F3B] text-[16px] font-semibold transition-all hover:text-[#7AA3C4] border-b-[1.5px] border-[#0B1F3B] hover:border-[#7AA3C4] pb-1">
        {{t 'test.paidProgram.gallery.seeAllOurGallery'}} <i class="fa-solid fa-arrow-right-long text-[15px]"></i>
      </a>
    </div>

  </div>
</section>