{{!--
  Komponen: Tools Section (Level 2 - Section)
  Lokasi: src/views/partials/components/ui/sections/tools/index.hbs
  Referensi Figma: Node 1149-892 (Tools Section)

  Props:
  - technologies : array (opsional, data teknologi dari controller)
  - course       : object (opsional, fallback course.technologies)
  - eyebrow      : string (opsional, default: "SOFTWARE & TOOLS")
  - title        : string (opsional, default: "Tools You Will Master")
  - lang         : string (opsional, kode bahasa)
--}}

<section id="tools" class="w-full bg-white pt-[50px] px-4 sm:px-8 lg:px-[80px] pb-[80px] flex flex-col items-center font-inter relative z-0">
  <div class="w-full max-w-[1568px] mx-auto flex flex-col items-center gap-[40px]">

    {{!-- Tools Header --}}
    <div class="w-full max-w-[1568px] flex flex-col items-center gap-[12px] text-center">
      {{!-- Eyebrow / Software & Tools --}}
      <span class="font-inter font-semibold text-[13px] leading-[16px] uppercase tracking-wider text-[#64748B]">
        {{default eyebrow (default (t 'test.freeProgram.tools.eyebrow') "SOFTWARE & TOOLS")}}
      </span>

      {{!-- Main Title --}}
      <h3 class="font-inter font-bold text-[20px] leading-[24px] text-[#0B1F3B] text-center">
        {{default title (default (t 'test.freeProgram.tools.title') "Tools You Will Master")}}
      </h3>
    </div>

    {{!-- Tools Row Logo Grid --}}
    <div class="w-full max-w-[1568px] flex flex-row flex-wrap justify-center items-center gap-4 sm:gap-6 md:gap-[48px]">
      {{#if (or technologies.length course.technologies.length)}}
        {{#each (default technologies course.technologies)}}
          <div class="box-border flex flex-row items-center px-6 py-4 gap-3 h-[56px] bg-[#FAFAFA] border border-[#E2E8F0] rounded-[12px] transition-all duration-200 hover:shadow-xs hover:border-[#CBD5E1]">
            <div class="w-6 h-6 flex items-center justify-center shrink-0">
              {{#if this.svg}}
                <span class="w-5 h-5 flex items-center justify-center shrink-0 overflow-hidden [&>svg]:w-full [&>svg]:h-full">{{{this.svg}}}</span>
              {{else if this.imgUrl}}
                <img src="{{this.imgUrl}}" alt="{{this.name}}" class="w-5 h-5 object-contain" />
              {{else}}
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="m15 9-6 6"></path>
                  <path d="m9 9 6 6"></path>
                </svg>
              {{/if}}
            </div>
            <span class="font-inter font-semibold text-[16px] leading-[19px] text-[#0B1F3B] whitespace-nowrap">
              {{this.name}}
            </span>
          </div>
        {{/each}}
      {{else}}
        {{!-- Fallback: Tools from Figma (Figma, Figjam, Maze, Notion, Miro) --}}

        {{!-- Tool Block Figma --}}
        <div class="box-border flex flex-row items-center px-6 py-4 gap-3 h-[56px] bg-[#FAFAFA] border border-[#E2E8F0] rounded-[12px] transition-all duration-200 hover:shadow-xs hover:border-[#CBD5E1]">
          <div class="w-6 h-6 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5.5 5.5C5.5 3.567 7.067 2 9 2H12V9H9C7.067 9 5.5 7.433 5.5 5.5Z" fill="#F24E1E"/>
              <path d="M12 2H15C16.933 2 18.5 3.567 18.5 5.5C18.5 7.433 16.933 9 15 9H12V2Z" fill="#FF7262"/>
              <path d="M5.5 12C5.5 10.067 7.067 8.5 9 8.5H12V15.5H9C7.067 15.5 5.5 13.933 5.5 12Z" fill="#A259FF"/>
              <path d="M12 8.5H15C16.933 8.5 18.5 10.067 18.5 12C18.5 13.933 16.933 15.5 15 15.5C13.067 15.5 12 13.933 12 12V8.5Z" fill="#1ABCFE"/>
              <path d="M5.5 18.5C5.5 16.567 7.067 15 9 15H12V18.5C12 20.433 10.433 22 9 22C7.067 22 5.5 20.433 5.5 18.5Z" fill="#0ACF83"/>
            </svg>
          </div>
          <span class="font-inter font-semibold text-[16px] leading-[19px] text-[#0B1F3B] whitespace-nowrap">
            Figma
          </span>
        </div>

        {{!-- Tool Block Figjam --}}
        <div class="box-border flex flex-row items-center px-6 py-4 gap-3 h-[56px] bg-[#FAFAFA] border border-[#E2E8F0] rounded-[12px] transition-all duration-200 hover:shadow-xs hover:border-[#CBD5E1]">
          <div class="w-6 h-6 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#FF5F1F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="m15 9-6 6"></path>
              <path d="m9 9 6 6"></path>
            </svg>
          </div>
          <span class="font-inter font-semibold text-[16px] leading-[19px] text-[#0B1F3B] whitespace-nowrap">
            Figjam
          </span>
        </div>

        {{!-- Tool Block Maze --}}
        <div class="box-border flex flex-row items-center px-6 py-4 gap-3 h-[56px] bg-[#FAFAFA] border border-[#E2E8F0] rounded-[12px] transition-all duration-200 hover:shadow-xs hover:border-[#CBD5E1]">
          <div class="w-6 h-6 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="m15 9-6 6"></path>
              <path d="m9 9 6 6"></path>
            </svg>
          </div>
          <span class="font-inter font-semibold text-[16px] leading-[19px] text-[#0B1F3B] whitespace-nowrap">
            Maze
          </span>
        </div>

        {{!-- Tool Block Notion --}}
        <div class="box-border flex flex-row items-center px-6 py-4 gap-3 h-[56px] bg-[#FAFAFA] border border-[#E2E8F0] rounded-[12px] transition-all duration-200 hover:shadow-xs hover:border-[#CBD5E1]">
          <div class="w-6 h-6 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="m15 9-6 6"></path>
              <path d="m9 9 6 6"></path>
            </svg>
          </div>
          <span class="font-inter font-semibold text-[16px] leading-[19px] text-[#0B1F3B] whitespace-nowrap">
            Notion
          </span>
        </div>

        {{!-- Tool Block Miro --}}
        <div class="box-border flex flex-row items-center px-6 py-4 gap-3 h-[56px] bg-[#FAFAFA] border border-[#E2E8F0] rounded-[12px] transition-all duration-200 hover:shadow-xs hover:border-[#CBD5E1]">
          <div class="w-6 h-6 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#FFC107" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="m15 9-6 6"></path>
              <path d="m9 9 6 6"></path>
            </svg>
          </div>
          <span class="font-inter font-semibold text-[16px] leading-[19px] text-[#0B1F3B] whitespace-nowrap">
            Miro
          </span>
        </div>

      {{/if}}
    </div>

  </div>
</section>
