{{!--
  Section: Paid Curriculum / Bootcamp Syllabus (Level 2 - Section)
  Lokasi: src/views/partials/components/ui/sections/paid_curriculum/index.hbs

  Spesifikasi Figma:
  - Section container: bg #FAFAFA, padding 120px 80px (desktop), gap 64px
  - Header:
    - Badge: bg #E0F2FE, rounded-full, px-4 py-2, text "BOOTCAMP SYLLABUS", Inter 700 14px #003060
    - Headline: "Structured & Industry-Proven Curriculum", Montserrat 800 36px leading 44px #0B1F3B
    - Description: "Complete a hands-on, project-based curriculum designed to align with current digital corporate operational standards.", Inter 400 16px #64748B, max-w 680px
  - Accordion:
    - Max-w: 1040px, gap 16px-24px
    - Dynamic Modules with collapsible content via Alpine.js

  Props:
  - course       : object (course data jika memiliki relasi course.weeks atau course.courseFlow)
  - course_flows : array (opsional array course_flow)
  - weeks        : array (opsional array weeks)
  - lang         : string
--}}

<section 
  id="curriculum" 
  class="relative w-full bg-[#FAFAFA] font-inter py-16 sm:py-20 lg:py-24"
  data-node-id="curriculum-section"
>
  <div class="w-full max-w-[1568px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center gap-12 lg:gap-16">
    
    {{!-- Curriculum Header (Figma: Frame 2147229479, gap 16px) --}}
    <div class="flex flex-col items-center gap-4 text-center max-w-[800px]">
      
      {{!-- Badge (Figma: bg #E0F2FE, rounded 999px, text BOOTCAMP SYLLABUS) --}}
      <div class="inline-flex items-center justify-center px-4 py-2 rounded-full bg-[#E0F2FE]">
        <span class="font-inter text-xs sm:text-[14px] font-bold uppercase tracking-wider text-[#003060] leading-none">
          {{default (t 'test.paidProgram.curriculum.badge') 'BOOTCAMP SYLLABUS'}}
        </span>
      </div>

      {{!-- Headline (Figma: Montserrat 800, 36px, leading 44px, #0B1F3B) --}}
      <h2 class="font-montserrat text-2xl sm:text-3xl lg:text-[36px] font-extrabold leading-[120%] tracking-tight text-[#0B1F3B]">
        {{default (t 'test.paidProgram.curriculum.title') 'Structured & Industry-Proven Curriculum'}}
      </h2>

      {{!-- Description (Figma: Inter 400, 16px, #64748B, max-w 680px) --}}
      <p class="font-inter text-sm sm:text-base font-normal leading-[160%] text-[#64748B] max-w-[680px]">
        {{default (t 'test.paidProgram.curriculum.description') 'Complete a hands-on, project-based curriculum designed to align with current digital corporate operational standards.'}}
      </p>

    </div>

    {{!-- Curriculum Accordion Grid (Figma: max-w 1040px, gap 20px-30px) --}}
    <div 
      x-data="{ activeIndex: 0 }" 
      class="flex flex-col w-full max-w-[1040px] gap-4 sm:gap-5"
    >
      {{#if course.courseFlow.length}}
        {{!-- Dynamic Data dari Database (table course_flow via course.courseFlow) --}}
        {{#each course.courseFlow}}
          {{> components/ui/card/curriculum_item/index
              index=@index
              title=(default (getByLang this.title ../lang) (default this.title (concat (default (t 'test.paidProgram.curriculum.modulePrefix') 'Module ') (default this.sequence (add @index 1)))))
              description=(default (getByLang this.content ../lang) (default this.content (default (t 'test.paidProgram.curriculum.defaultModuleDesc') 'Pelajari materi komprehensif pada modul ini dengan panduan intensif dari mentor praktisi industri.')))
              lang=../lang
          }}
        {{/each}}

      {{else if course_flows.length}}
        {{!-- Dynamic Data jika array course_flows dioper langsung --}}
        {{#each course_flows}}
          {{> components/ui/card/curriculum_item/index
              index=@index
              title=(default (getByLang this.title ../lang) (default this.title (concat (default (t 'test.paidProgram.curriculum.modulePrefix') 'Module ') (default this.sequence (add @index 1)))))
              description=(default (getByLang this.content ../lang) (default this.content (default (t 'test.paidProgram.curriculum.defaultModuleDesc') 'Pelajari materi komprehensif pada modul ini dengan panduan intensif dari mentor praktisi industri.')))
              lang=../lang
          }}
        {{/each}}

      {{else if course.weeks.length}}
        {{!-- Dynamic Data dari Database (table weeks via course.weeks) --}}
        {{#each course.weeks}}
          {{> components/ui/card/curriculum_item/index
              index=@index
              title=(default (getByLang this.description ../lang) (concat (default (t 'test.paidProgram.curriculum.modulePrefix') 'Module ') (default this.weekNumber (add @index 1))))
              description=(default (getByLang this.description ../lang) (default (t 'test.paidProgram.curriculum.defaultModuleDesc') 'Pelajari materi komprehensif pada modul ini dengan panduan intensif dari mentor praktisi industri.'))
              lang=../lang
          }}
        {{/each}}

      {{else if weeks.length}}
        {{!-- Dynamic Data jika array weeks dioper langsung --}}
        {{#each weeks}}
          {{> components/ui/card/curriculum_item/index
              index=@index
              title=(default (getByLang this.description ../lang) (concat (default (t 'test.paidProgram.curriculum.modulePrefix') 'Module ') (default this.weekNumber (add @index 1))))
              description=(default (getByLang this.description ../lang) (default (t 'test.paidProgram.curriculum.defaultModuleDesc') 'Pelajari materi komprehensif pada modul ini dengan panduan intensif dari mentor praktisi industri.'))
              lang=../lang
          }}
        {{/each}}

      {{else}}
        {{!-- Empty State: Belum Ada Silabus / Kurikulum --}}
        <div class="w-full flex flex-col items-center justify-center p-8 sm:p-12 md:p-16 rounded-[20px] border border-dashed border-[#CBD5E1] bg-white text-center shadow-[0px_4px_16px_rgba(0,0,0,0.02)]">
          <div class="relative mb-5 flex size-20 sm:size-24 items-center justify-center rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] shadow-2xs">
            <span class="flex size-14 items-center justify-center rounded-xl bg-[#E0F2FE] text-[#003060]">
              <i class="fa-solid fa-layer-group text-2xl sm:text-3xl"></i>
            </span>
            <span class="absolute -top-1.5 -right-1.5 flex size-6 items-center justify-center rounded-full bg-[#F59E0B] text-white text-[10px] shadow-sm">
              <i class="fa-solid fa-clock"></i>
            </span>
          </div>

          <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#E0F2FE] border border-[#BAE6FD] text-[#0369A1] text-xs font-semibold uppercase tracking-wider mb-3">
            <span class="size-1.5 rounded-full bg-[#0284C7] animate-pulse"></span>
            {{default (t 'test.paidProgram.curriculum.emptyBadge') 'Sedang Disiapkan'}}
          </span>

          <h3 class="font-montserrat font-bold text-lg sm:text-xl md:text-2xl text-[#0B1F3B] mb-2 max-w-md">
            {{default (t 'test.paidProgram.curriculum.emptyTitle') 'Silabus Belum Tersedia'}}
          </h3>

          <p class="font-inter font-normal text-sm sm:text-base leading-relaxed text-[#64748B] max-w-lg">
            {{default (t 'test.paidProgram.curriculum.emptyDesc') 'Rincian modul dan silabus kurikulum untuk program ini sedang dipersiapkan oleh tim instruktur untuk menjamin materi pembelajaran terbaik.'}}
          </p>
        </div>
      {{/if}}
    </div>

  </div>
</section>
