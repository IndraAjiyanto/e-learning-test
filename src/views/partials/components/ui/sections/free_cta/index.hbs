{{!--
  Section: Free CTA (L2) - minimal centered style
  Lokasi: src/views/partials/components/ui/sections/free_cta/index.hbs
  Props: category (.name, .contact), lang, title, description, buttonText, href.
--}}
<section id="explore-program" class="{{default sectionClass 'w-full bg-[#F9FAFB] py-16 font-inter lg:py-24'}}">
  <div class="page-shell flex flex-col items-center gap-6 text-center lg:gap-8">
    {{> components/ui/text/section_header/index
        title=(default title (default (t 'test.categoryFreeProgram.cta.title') 'Transform your team today'))
        titleClass="font-inter text-2xl font-bold leading-tight text-[#003060] sm:text-3xl lg:text-[36px] lg:leading-[44px]"
        description=(default description (default (t 'test.categoryFreeProgram.cta.description') 'Get a customized training proposal for your organization.'))
        descClass="max-w-[658px] font-inter text-sm font-normal leading-relaxed text-[#4A5568] sm:text-base lg:text-[20px] lg:leading-[160%]"
        wrapperClass="gap-4 max-w-[680px]"
    }}

    <div>
      <a
        href="{{#if href}}{{href}}{{else if category.contact}}{{waLink category.contact}}{{else}}#programs{{/if}}"
        {{#if category.contact}}target="_blank" rel="noopener"{{/if}}
        class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-[#003060] px-8 py-3.5 text-base font-semibold text-white shadow-sm transition-all duration-200 hover:bg-[#00244a] hover:-translate-y-0.5 active:scale-95"
      >
        <span>{{default buttonText (default (t 'test.categoryFreeProgram.cta.button') 'Contact Us')}}</span>
        <i class="fas fa-arrow-up text-xs"></i>
      </a>
    </div>
  </div>
</section>

