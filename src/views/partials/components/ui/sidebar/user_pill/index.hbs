{{!--
  Komponen: Sidebar User Pill + Profile Popover
  Lokasi: src/views/partials/components/ui/sidebar/user_pill/index.hbs
  Level: L1 Atomik

  Menampilkan avatar + nama + role user. Saat pill diklik, muncul popover
  mengambang di atas pill berisi aksi "Edit Profile" dan "Logout"
  (Figma node 238:20262 — PROFILE POPOVER).

  Props:
  - href         : string (opsional, default "/users/profile") tujuan Edit Profile
  - logoutHref   : string (opsional, default "/logout")
  - username     : string (wajib) nama user
  - role         : string (wajib) role user
  - profile      : string (opsional) URL foto profil; bila kosong dipakai inisial
  - initial      : string (opsional) huruf inisial bila tidak ada foto
  - profileLabel : string (opsional, default "Edit Profile")
  - logoutLabel  : string (opsional, default "Logout")
--}}

<div class="relative w-full" x-data="{ userMenuOpen: false }" @click.outside="userMenuOpen = false" @keydown.escape.window="userMenuOpen = false">
  {{!-- Popover: mengambang tepat di atas pill --}}
  <div
    x-show="userMenuOpen"
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0 translate-y-1"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-100"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 translate-y-1"
    x-cloak
    role="menu"
    class="absolute bottom-full left-[8px] mb-[13px] z-50 w-[237px] p-[9px] space-y-[4px]
      bg-white border border-[#D9D9D9] rounded-[10px]
      shadow-[0px_10px_15px_-3px_rgba(0,0,0,0.1),0px_4px_6px_-4px_rgba(0,0,0,0.1)]"
  >
    <a
      href="{{default href '/users/profile'}}"
      role="menuitem"
      class="flex items-center gap-[12px] w-full px-[12px] py-[10px] rounded-[6px]
        font-montserrat font-medium text-[14px] leading-[21px] text-[#003060]
        transition-colors duration-150 hover:bg-[#E7F3FB] active:bg-[#D7E9F6]
        focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#055C90]/40"
    >
      <span class="flex shrink-0 text-[#4A5568]">
        {{> components/ui/sidebar/nav_icon/index name='icon_edit_profile' size='16px'}}
      </span>
      <span>{{default profileLabel 'Edit Profile'}}</span>
    </a>

    <div class="px-[4px] py-[2px]">
      <div class="h-px w-full bg-[#D9D9D9]"></div>
    </div>

    <a
      href="{{default logoutHref '/logout'}}"
      role="menuitem"
      class="flex items-center gap-[12px] w-full px-[12px] py-[10px] rounded-[6px]
        font-montserrat font-medium text-[14px] leading-[21px] text-[#C80606]
        transition-colors duration-150 hover:bg-[#FDECEC] active:bg-[#FBD5D5]
        focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#C80606]/40"
    >
      <span class="flex shrink-0 text-[#C80606]">
        {{> components/ui/sidebar/nav_icon/index name='icon_logout' size='16px'}}
      </span>
      <span>{{default logoutLabel 'Logout'}}</span>
    </a>
  </div>

  {{!-- Pill profil --}}
  <button
    type="button"
    @click="userMenuOpen = !userMenuOpen"
    :aria-expanded="userMenuOpen"
    aria-haspopup="menu"
    :class="userMenuOpen ? 'bg-[#E7F3FB]' : 'hover:bg-[#E7F3FB]/60 active:bg-[#E7F3FB]'"
    class="flex items-center justify-between w-full p-[8px] rounded-[8px] transition-colors duration-150
      focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#055C90]/40"
  >
    <span class="flex items-center gap-[14px] min-w-0">
      <span class="size-[40px] rounded-full overflow-hidden shrink-0 bg-[#003060] flex items-center justify-center">
        {{#if profile}}
          <img
            src="{{profile}}"
            alt="{{username}}"
            class="w-full h-full object-cover"
            onerror="this.src='/public/image/orang.png'"
          />
        {{else}}
          <span class="font-montserrat font-bold text-[15px] leading-[22.5px] text-white uppercase">{{initial}}</span>
        {{/if}}
      </span>
      <span class="flex flex-col items-start min-w-0 text-left">
        <span class="font-montserrat font-semibold text-[14px] leading-[17.5px] text-[#003060] truncate max-w-[150px]">{{username}}</span>
        <span class="font-montserrat font-medium text-[12px] leading-[15px] text-[#718096] truncate max-w-[150px]">{{role}}</span>
      </span>
    </span>
    <span class="flex shrink-0 text-[#718096]">
      {{> components/ui/sidebar/nav_icon/index name='icon_chevron_updown' size='16px'}}
    </span>
  </button>
</div>
