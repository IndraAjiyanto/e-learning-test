{{!-- 
  Komponen: Icon Card (Level 1 - UI Dasar, Shared)
  Lokasi: src/views/partials/components/ui/icon/icon_card/index.hbs
  
  Props:
  - iconSrc             : URL gambar icon (opsional)
  - icon                : Class icon Font Awesome (opsional)
  - title               : Judul card
  - description         : Deskripsi card (opsional)
  - wrapperClass        : Class wrapper utama
  - titleClass          : Class untuk title
  - descClass           : Class untuk description
  - iconContainerClass  : Class untuk container icon
  - iconClass           : Class untuk icon element
--}}
<div class="group flex flex-col items-center text-center rounded-2xl border border-gray-100 bg-[#FFFFFFBF]/75 p-6 shadow-sm hover:shadow-md transition-shadow {{default wrapperClass 'w-full max-w-[320px] min-h-[280px]'}}">
  {{#if iconSrc}}
    <img src="{{iconSrc}}" alt="{{title}}" class="{{default iconClass 'w-[48px] h-[48px] object-contain mb-4'}}" />
  {{else if icon}}
    <div class="{{default iconContainerClass 'w-12 h-12 rounded-full bg-[#6EB6E5]/20 flex items-center justify-center mb-4'}}">
      <i class="{{icon}} {{default iconClass 'text-xl text-[#003060]'}}"></i>
    </div>
  {{/if}}
  <h3 class="{{default titleClass 'font-montserrat font-bold text-lg text-[#003060] mb-2'}}">{{{title}}}</h3>
  {{#if description}}
    <p class="{{default descClass 'font-sans text-sm leading-6 text-gray-700'}}">{{{description}}}</p>
  {{/if}}
</div>
