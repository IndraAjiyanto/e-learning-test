{{!-- 
  Komponen: Tab Filter Button (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/tab_filter_btn.hbs
  
  Props:
  - text        : Label tab (misal: "Institutions")
  - targetValue : Nilai saat diklik (misal: 'Institutions')
  - activeVar   : Nama variabel Alpine state (default: activeTab)
  - desktop     : boolean (true untuk styling desktop)
--}}

{{#if desktop}}
  <button
    @click="{{#if activeVar}}{{activeVar}}{{else}}activeTab{{/if}} = '{{targetValue}}'"
    :class="{{#if activeVar}}{{activeVar}}{{else}}activeTab{{/if}} === '{{targetValue}}' ? 'bg-[#6EB6E5]' : 'bg-[#003060]'"
    class="w-[428px] h-[62px] rounded-[24px] text-white font-montserrat text-[17px] font-medium transition-all duration-300 shadow-[0px_0px_8px_0px_rgba(0,0,0,0.5)] backdrop-blur-[6.6px] flex items-center justify-center opacity-100 text-center"
  >
    {{text}}
  </button>
{{else}}
  <button
    @click="{{#if activeVar}}{{activeVar}}{{else}}activeTab{{/if}} = '{{targetValue}}'"
    :class="{{#if activeVar}}{{activeVar}}{{else}}activeTab{{/if}} === '{{targetValue}}' ? 'bg-[#6EB6E5] text-white' : 'bg-[#003060] text-white'"
    class="rounded-[50px] px-4 py-2 text-[13px] font-montserrat font-medium transition-all shadow-sm"
  >
    {{text}}
  </button>
{{/if}}
