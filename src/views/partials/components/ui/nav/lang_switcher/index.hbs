{{!--
  Komponen: Language Switcher (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/nav/lang_switcher/index.hbs
  POST ke /translation dengan hidden input `lang` (en | id | ja). Butuh `lang` context var.
  Props: mobile (boolean) - varian daftar untuk drawer mobile.
--}}
{{#if mobile}}
  <div x-data="{ langOpen: false }" class="flex flex-col">
    <button
      @click="langOpen = !langOpen"
      class="flex items-center justify-between rounded-lg px-4 py-3 text-sm font-semibold text-white/85 hover:bg-white/10"
    >
      <span class="flex items-center gap-2">
        <span class="text-lg" :class="lang === 'id' ? 'fi fi-id' : lang === 'en' ? 'fi fi-gb' : 'fi fi-jp'"></span>
        <span x-text="lang === 'id' ? 'Bahasa Indonesia' : lang === 'en' ? 'English' : '日本語'"></span>
      </span>
      <i class="fas fa-chevron-down text-xs transition-transform" :class="langOpen && 'rotate-180'"></i>
    </button>
    <div x-show="langOpen" x-collapse class="flex flex-col py-1 pl-3" style="display:none">
      <form action="/translation" method="post"><input type="hidden" name="lang" value="en" />
        <button type="submit" class="flex w-full items-center gap-3 rounded-lg px-4 py-2.5 text-sm text-white/85 hover:bg-white/10"><span class="fi fi-gb"></span>English (EN)</button>
      </form>
      <form action="/translation" method="post"><input type="hidden" name="lang" value="id" />
        <button type="submit" class="flex w-full items-center gap-3 rounded-lg px-4 py-2.5 text-sm text-white/85 hover:bg-white/10"><span class="fi fi-id"></span>Bahasa Indonesia (ID)</button>
      </form>
      <form action="/translation" method="post"><input type="hidden" name="lang" value="ja" />
        <button type="submit" class="flex w-full items-center gap-3 rounded-lg px-4 py-2.5 text-sm text-white/85 hover:bg-white/10"><span class="fi fi-jp"></span>日本語 (JP)</button>
      </form>
    </div>
  </div>
{{else}}
  <div x-data="{ langOpen: false }" class="relative" @click.away="langOpen = false">
    <button
      @click="langOpen = !langOpen"
      class="flex items-center gap-2 rounded-full border border-[#E5E7EB] bg-white px-3 py-2.5 text-sm font-medium text-[#1F2937] hover:border-[#CBD5E1]"
    >
      <span class="text-base" :class="lang === 'id' ? 'fi fi-id' : lang === 'en' ? 'fi fi-gb' : 'fi fi-jp'"></span>
      <span x-text="lang === 'id' ? 'ID' : lang === 'en' ? 'ENG' : 'JP'"></span>
      <i class="fas fa-chevron-down text-[10px] transition-transform" :class="langOpen && 'rotate-180'"></i>
    </button>
    <div
      x-show="langOpen"
      x-transition
      class="absolute right-0 z-[100] mt-2 w-32 rounded-xl border border-[#E5E7EB] bg-[#F5F5F5] p-1.5 shadow-[0px_4px_12px_rgba(0,0,0,0.08)]"
      style="display:none"
    >
      <form action="/translation" method="post"><input type="hidden" name="lang" value="en" />
        <button
          type="submit"
          class="flex w-full items-center justify-between gap-2 rounded-lg px-3 py-2 text-left font-inter text-sm transition-colors hover:bg-[#EAEAEA]"
          :class="lang === 'en' ? 'bg-[#E4F1F7] font-semibold text-[#003060]' : 'text-[#374151]'"
        >
          <span class="flex items-center gap-2.5">
            <span class="fi fi-gb shadow-[0_0_1px_rgba(0,0,0,0.3)]"></span>EN
          </span>
          <i x-show="lang === 'en'" class="fa-solid fa-check text-xs text-[#003060]"></i>
        </button>
      </form>
      <form action="/translation" method="post"><input type="hidden" name="lang" value="id" />
        <button
          type="submit"
          class="flex w-full items-center justify-between gap-2 rounded-lg px-3 py-2 text-left font-inter text-sm transition-colors hover:bg-[#EAEAEA]"
          :class="lang === 'id' ? 'bg-[#E4F1F7] font-semibold text-[#003060]' : 'text-[#374151]'"
        >
          <span class="flex items-center gap-2.5">
            <span class="fi fi-id shadow-[0_0_1px_rgba(0,0,0,0.3)]"></span>ID
          </span>
          <i x-show="lang === 'id'" class="fa-solid fa-check text-xs text-[#003060]"></i>
        </button>
      </form>
      <form action="/translation" method="post"><input type="hidden" name="lang" value="ja" />
        <button
          type="submit"
          class="flex w-full items-center justify-between gap-2 rounded-lg px-3 py-2 text-left font-inter text-sm transition-colors hover:bg-[#EAEAEA]"
          :class="lang === 'ja' ? 'bg-[#E4F1F7] font-semibold text-[#003060]' : 'text-[#374151]'"
        >
          <span class="flex items-center gap-2.5">
            <span class="fi fi-jp shadow-[0_0_1px_rgba(0,0,0,0.3)]"></span>JP
          </span>
          <i x-show="lang === 'ja'" class="fa-solid fa-check text-xs text-[#003060]"></i>
        </button>
      </form>
    </div>
  </div>
{{/if}}
