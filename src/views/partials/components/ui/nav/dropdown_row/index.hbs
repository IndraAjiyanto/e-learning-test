{{!--
  Komponen: Nav Dropdown Row (Level 1) - satu "Feature Item" / "Menu Item" di dropdown navbar.
  Lokasi: src/views/partials/components/ui/nav/dropdown_row/index.hbs
  Figma: 439:396 (Class) / 439:336 (Informasi). Ikon lucide 20px (kontainer transparan 32px),
  judul Inter Bold 15 #003060, desc Inter Regular 11 #4A5568, chevron-right kanan.
  Props: href, icon (rocket|zap|building|globe|help|info|image|briefcase|cap|users|book), title, desc, last (bool)
--}}
<a
  href="{{href}}"
  @click="classOpen = false; infoOpen = false"
  class="group flex items-center gap-4 {{#unless last}}border-b border-[#E5E7EB] pb-5{{/unless}}"
>
  <span class="grid size-8 shrink-0 place-items-center text-[#003060]">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
      {{#if (eq icon 'rocket')}}<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>{{/if}}
      {{#if (eq icon 'zap')}}<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>{{/if}}
      {{#if (eq icon 'building')}}<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4M10 10h4M10 14h4M10 18h4"/>{{/if}}
      {{#if (eq icon 'globe')}}<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>{{/if}}
      {{#if (eq icon 'help')}}<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>{{/if}}
      {{#if (eq icon 'info')}}<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>{{/if}}
      {{#if (eq icon 'image')}}<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>{{/if}}
      {{#if (eq icon 'briefcase')}}<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>{{/if}}
      {{#if (eq icon 'cap')}}<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>{{/if}}
      {{#if (eq icon 'users')}}<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>{{/if}}
      {{#if (eq icon 'book')}}<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>{{/if}}
    </svg>
  </span>
  <span class="flex min-w-0 flex-1 flex-col gap-1.5">
    <span class="font-inter text-[15px] font-bold leading-tight text-[#003060]">{{title}}</span>
    <span class="font-inter text-[11px] leading-[1.5] text-[#4A5568]">{{desc}}</span>
  </span>
  <svg viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0 transition group-hover:translate-x-0.5"><path d="m9 18 6-6-6-6"/></svg>
</a>
