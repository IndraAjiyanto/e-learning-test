{{!-- 
  Komponen: Floating WhatsApp Button (Fitur Global Reusable)
  Lokasi: src/views/partials/components/ui/floating_whatsapp_btn.hbs
  
  Props:
  - phone   : Nomor WhatsApp tujuan (contoh: social.[0].number)
  - message : Pesan awalan default yang dikirim via WA
  - tooltip : Teks bantuan saat tombol di-hover
--}}
<div
  x-data='{ showTooltip: false }'
  class='fixed bottom-6 right-6 md:bottom-8 md:right-8 z-50 group'
  @mouseenter='showTooltip = true'
  @mouseleave='showTooltip = false'
>
  <!-- Tooltip -->
  <div
    x-show='showTooltip'
    x-transition:enter='transition ease-out duration-200'
    x-transition:enter-start='opacity-0 translate-x-2'
    x-transition:enter-end='opacity-100 translate-x-0'
    x-transition:leave='transition ease-in duration-150'
    x-transition:leave-start='opacity-100 translate-x-0'
    x-transition:leave-end='opacity-0 translate-x-2'
    class='hidden md:block absolute right-20 top-1/2 -translate-y-1/2 bg-gradient-to-r from-slate-700 to-slate-800 text-white px-5 py-3 rounded-xl shadow-2xl whitespace-nowrap font-semibold text-sm'
  >
    {{tooltip}}
    <div
      class='absolute -right-2 top-1/2 -translate-y-1/2 w-0 h-0 border-t-8 border-b-8 border-l-8 border-transparent border-l-slate-800'
    ></div>
  </div>

  <!-- Button — via agregator wa.helper (SSR waLink) -->
  <a
    href='{{waLink phone message}}'
    target='_blank'
    class='relative flex items-center justify-center w-14 h-14 md:w-16 md:h-16 bg-gradient-to-br from-green-500 to-green-600 rounded-full shadow-lg hover:shadow-2xl hover:scale-110 hover:-translate-y-2 hover:from-green-400 hover:to-green-500 transition-all duration-300 animate-pulse-slate group'
    aria-label='Chat WhatsApp'
  >
    <i class='fab fa-whatsapp text-white text-2xl md:text-3xl'></i>
  </a>
</div>
