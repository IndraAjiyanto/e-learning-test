{{!--
  Komponen: Search Input Generik

  Props Wajib:
  - value       : Expression Alpine untuk nilai input
                    Contoh: "searchQuery"
  - placeholder : Teks placeholder input

  Komponen ini hanya bertanggung jawab terhadap:
  - Tampilan input
  - Icon search
  - Binding nilai dengan Alpine melalui x-model

  Business logic seperti:
  - fetch API
  - filtering data
  - pagination
  - debounce
  tetap berada di parent/page.
--}}

<div class="relative w-full min-w-0">
  <input
    type="text"
    x-model="{{value}}"
    placeholder="{{placeholder}}"
    class="w-full h-auto pl-9 pr-3 py-2 shadow-2xs rounded-[10px] font-montserrat font-medium text-[12px] text-[#0B1F3B] placeholder-[#676767] bg-[#E0F1F9] focus:outline-none lg:h-[60px] lg:pl-[50px] lg:pr-[20px] lg:py-0 lg:rounded-[12px] lg:text-[22px] lg:shadow-[0px_0px_5px_rgba(0,0,0,0.5)]"
  />

  <i
    class="absolute left-3 top-1/2 -translate-y-1/2 fas fa-search text-xs text-gray-500 lg:left-[18px] lg:text-xl lg:text-black"
  ></i>
</div>