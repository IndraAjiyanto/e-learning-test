{{!--
  Komponen: Editable Select (Dropdown dengan mode klik-untuk-edit)
  Lokasi: src/views/partials/components/ui/input/editable_select/index.hbs
  Level: L1 Atomik

  Butuh Alpine x-data induk yang menyediakan:
  - editingField (string|null)
  - startEditing(field)

  Props:
  - label            : string (wajib) — teks label di atas select
  - model            : string (wajib) — target x-model, contoh "currentValues.education"
  - editingKey       : string (wajib) — key dibandingkan ke `editingField`, contoh "education"
  - placeholderOption: string (opsional) — teks option pertama yang disabled, contoh "Select Your Education Level"
  - wrapperClass     : string (opsional) — class tambahan pembungkus

  Children:
  - Isi block ({{#> ...}}...{{/...}}) berupa daftar <option> spesifik pemanggil, contoh:
    {{#> components/ui/input/editable_select/index label="Gender" model="currentValues.gender" editingKey="gender" placeholderOption="Select Your Gender"}}
      <option value="Laki laki">Laki laki</option>
      <option value="Perempuan">Perempuan</option>
    {{/components/ui/input/editable_select/index}}
--}}

<div class="{{wrapperClass}}">
  <label class="block font-montserrat font-semibold text-[25px] text-[#003060] leading-none mb-[25px]">
    {{label}}
  </label>
  <select
    x-model="{{model}}"
    @click="startEditing('{{editingKey}}')"
    :class="editingField === '{{editingKey}}' ? 'bg-white cursor-text ring-1 ring-[#0B3A68] border-[#0B3A68]' : 'bg-white/50 cursor-default border-slate-200/80'"
    class="w-full max-w-[1146px] h-[43px] rounded-[6px] p-[10px] px-4 border shadow-[0px_0px_5px_0px_rgba(0,0,0,0.5)] focus:outline-none focus:ring-1 focus:ring-[#0B3A68] focus:border-[#0B3A68] font-montserrat font-medium text-xl text-black transition-all duration-200"
  >
    <option value="" disabled>{{default placeholderOption 'Select an option'}}</option>
    {{#if @partial-block}}{{> @partial-block}}{{/if}}
  </select>
</div>
