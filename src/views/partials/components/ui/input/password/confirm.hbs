{{!--
  Komponen: Input Confirm Password dengan Validasi Real-time (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/input/password/confirm.hbs

  Input confirm password dengan validasi real-time untuk mengecek kecocokan dengan password utama.

  Props:
  - name                 : Atribut name (default: "confirm_password")
  - id                   : Atribut id (default: name)
  - label                : Teks label (wajib)
  - placeholder          : Placeholder teks (default: "********")
  - value                : Nilai input (opsional)
  - required             : Boolean required (default: true)
  - autocomplete         : Atribut autocomplete (default: "new-password")
  - labelClass           : Kelas tambahan label
  - inputClass           : Kelas tambahan input
  - wrapperClass         : Kelas tambahan pembungkus
  - showValidation       : Boolean menampilkan validasi match (default: true)
  - matchText            : Teks ketika password cocok
  - noMatchText          : Teks ketika password tidak cocok
  - xModel               : Nama variabel Alpine.js untuk binding (default: "confirmPassword")
--}}

<div class="{{default wrapperClass ''}}">
  <label
    for="{{default id (default name 'confirm_password')}}"
    class="block text-xs sm:text-sm font-medium text-[#0B1F3B] mb-1 font-montserrat {{default labelClass ''}}"
  >{{label}}</label>

  <div class="relative">
    <input
      :type="show{{default xModel 'confirmPassword'}} ? 'text' : 'password'"
      id="{{default id (default name 'confirm_password')}}"
      name="{{default name 'confirm_password'}}"
      x-model="{{default xModel 'confirmPassword'}}"
      {{#if value}}value="{{value}}"{{/if}}
      placeholder="{{default placeholder '********'}}"
      autocomplete="{{default autocomplete 'new-password'}}"
      {{#if required}}required{{/if}}
      class="w-full px-3.5 py-2.5 sm:px-4 sm:py-3 text-xs sm:text-sm rounded-[12px] sm:rounded-lg bg-white border text-[#2D2D2D] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#003060] pr-10 transition-colors {{default inputClass ''}}"
      :class="{{default xModel 'confirmPassword'}}.length === 0 ? 'border-[#D9D9D9]' : (isConfirmValid ? 'border-green-500' : 'border-red-400')"
    />
    <button
      type="button"
      @click="show{{default xModel 'confirmPassword'}} = !show{{default xModel 'confirmPassword'}}"
      class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400 hover:text-gray-700"
      aria-label="Toggle password visibility"
    >
      <i class="fas text-xs sm:text-sm" :class="show{{default xModel 'confirmPassword'}} ? 'fa-eye-slash' : 'fa-eye'"></i>
    </button>
  </div>

  {{#if (default showValidation true)}}
    <p
      x-show="{{default xModel 'confirmPassword'}}.length > 0"
      x-transition
      class="text-[11px] sm:text-xs mt-1 sm:mt-1.5 font-sans flex items-center gap-1.5"
      :class="isConfirmValid ? 'text-green-600' : 'text-red-500'"
    >
      <i class="fas text-[10px] sm:text-xs" :class="isConfirmValid ? 'fa-check-circle' : 'fa-times-circle'"></i>
      <span x-text="isConfirmValid ? '{{default matchText 'Passwords match'}}' : '{{default noMatchText 'Passwords do not match'}}'"></span>
    </p>
  {{/if}}
</div>
