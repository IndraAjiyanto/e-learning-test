{{!--
  Komponen: Input Password (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/input/password/index.hbs

  Input password dengan validasi HTML5, toggle show/hide (Alpine.js),
  serta opsi link forgot password di kanan bawah.

  Props:
  - name                 : Atribut name (default: "password")
  - id                   : Atribut id (default: name)
  - label                : Teks label (wajib)
  - placeholder          : Placeholder teks (default: "********")
  - value                : Nilai input (opsional)
  - required             : Boolean required (default: true)
  - autocomplete         : Atribut autocomplete (default: "current-password")
  - labelClass           : Kelas tambahan label
  - inputClass           : Kelas tambahan input
  - wrapperClass         : Kelas tambahan pembungkus
  - showForgotPassword   : Boolean menampilkan link lupa password (default: false)
  - forgotPasswordText   : Teks link lupa password (default: "Forgot password?")
  - forgotPasswordUrl    : URL lupa password (default: "/users/forgot-password")
  - forgotLinkClass      : Kelas tambahan untuk link forgot password
--}}

<div class="{{default wrapperClass ''}}" x-data="{ show: false }">
  <label
    for="{{default id (default name 'password')}}"
    class="block mb-5 text-[15px] font-medium text-[#2D2D2D] leading-none font-inter lg:text-[20px] {{default labelClass ''}}"
  >{{label}}</label>

  <div class="relative">
    <div class="flex absolute inset-y-0 left-[25px] items-center pointer-events-none text-[#003060]">
      {{#if leftIcon}}
        <i class="{{leftIcon}} text-lg lg:text-xl"></i>
      {{else}}
        <svg class="size-5 text-[#003060] lg:size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          <circle cx="12" cy="16" r="1" fill="currentColor" />
        </svg>
      {{/if}}
    </div>

    <input
      :type="show ? 'text' : 'password'"
      id="{{default id (default name 'password')}}"
      name="{{default name 'password'}}"
      {{#if value}}value="{{value}}"{{/if}}
      placeholder="{{default placeholder (t 'test.signUp.placeholderPassword')}}"
      autocomplete="{{default autocomplete 'current-password'}}"
      {{#if required}}required{{/if}}
      class="w-full h-[48px] pl-[74px] pr-[74px] py-2.5 text-[15px] font-normal text-[#2D2D2D] leading-none font-inter bg-white border border-[#D9D9D9] rounded-[6px] shadow-[0px_0px_4px_0px_#00000040] placeholder:text-[15px] placeholder:font-normal placeholder:text-[#2D2D2DCC] focus:outline-none focus:ring-2 focus:ring-[#003060] lg:h-[59px] lg:pl-[74px] lg:pr-[74px] lg:py-3 {{default inputClass ''}}"
    />
    <button
      type="button"
      @click="show = !show"
      class="flex absolute inset-y-0 right-[25px] items-center text-[#003060] hover:text-gray-700"
      aria-label="Toggle password visibility"
    >
      <i class="fas text-base lg:text-lg" :class="show ? 'fa-eye-slash' : 'fa-eye'"></i>
    </button>
  </div>

  {{#if showForgotPassword}}
    <div class="flex justify-end mt-1.5 lg:mt-2">
      <a
        href="{{default forgotPasswordUrl '/users/forgot-password'}}"
        class="text-xs text-[#6EB6E5] font-medium font-inter hover:underline lg:text-sm {{default forgotLinkClass ''}}"
      >{{default forgotPasswordText 'Forgot password?'}}</a>
    </div>
  {{/if}}
</div>
