{{!--
  Komponen: Input Password dengan Validasi Real-time (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/input/password/validated.hbs

  Input password dengan validasi real-time menggunakan Alpine.js,
  menampilkan checklist untuk: minimal 8 karakter, uppercase, lowercase, angka, dan karakter spesial.

  Props:
  - name                 : Atribut name (default: "password")
  - id                   : Atribut id (default: name)
  - label                : Teks label (wajib)
  - placeholder          : Placeholder teks (default: "********")
  - value                : Nilai input (opsional)
  - required             : Boolean required (default: true)
  - autocomplete         : Atribut autocomplete (default: "new-password")
  - labelClass           : Kelas tambahan label
  - inputClass           : Kelas tambahan input
  - wrapperClass         : Kelas tambahan pembungkus
  - showValidation       : Boolean menampilkan checklist validasi (default: true)
  - lengthText           : Teks untuk validasi minimal panjang
  - uppercaseText        : Teks untuk validasi uppercase
  - lowercaseText        : Teks untuk validasi lowercase
  - numberText           : Teks untuk validasi angka
  - specialText          : Teks untuk validasi karakter spesial
  - xModel               : Nama variabel Alpine.js untuk binding (default: "password")
--}}

<div class="{{default wrapperClass ''}}">
  <label
    for="{{default id (default name 'password')}}"
    class="block text-xs sm:text-sm font-medium text-[#0B1F3B] mb-1 font-montserrat {{default labelClass ''}}"
  >{{label}}</label>

  <div class="relative">
    <input
      :type="show{{default xModel 'password'}} ? 'text' : 'password'"
      id="{{default id (default name 'password')}}"
      name="{{default name 'password'}}"
      x-model="{{default xModel 'password'}}"
      {{#if value}}value="{{value}}"{{/if}}
      placeholder="{{default placeholder '********'}}"
      autocomplete="{{default autocomplete 'new-password'}}"
      {{#if required}}required{{/if}}
      class="w-full px-3.5 py-2.5 sm:px-4 sm:py-3 text-xs sm:text-sm rounded-[12px] sm:rounded-lg bg-white border text-[#2D2D2D] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#003060] pr-10 transition-colors {{default inputClass ''}}"
      :class="{{default xModel 'password'}}.length === 0 ? 'border-[#D9D9D9]' : (isPasswordValid ? 'border-green-500' : 'border-red-400')"
    />
    <button
      type="button"
      @click="show{{default xModel 'password'}} = !show{{default xModel 'password'}}"
      class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400 hover:text-gray-700"
      aria-label="Toggle password visibility"
    >
      <i class="fas text-xs sm:text-sm" :class="show{{default xModel 'password'}} ? 'fa-eye-slash' : 'fa-eye'"></i>
    </button>
  </div>

  {{#if (default showValidation true)}}
    <ul class="mt-1.5 sm:mt-2 space-y-0.5 sm:space-y-1">
      <li class="text-[11px] sm:text-xs flex items-center gap-1.5 font-sans" :class="hasLength ? 'text-green-600' : 'text-gray-500'">
        <i class="fas text-[10px] sm:text-xs" :class="hasLength ? 'fa-check-circle' : 'fa-circle'"></i>
        {{default lengthText 'At least 8 characters'}}
      </li>
      <li class="text-[11px] sm:text-xs flex items-center gap-1.5 font-sans" :class="hasUpper ? 'text-green-600' : 'text-gray-500'">
        <i class="fas text-[10px] sm:text-xs" :class="hasUpper ? 'fa-check-circle' : 'fa-circle'"></i>
        {{default uppercaseText '1 uppercase letter'}}
      </li>
      <li class="text-[11px] sm:text-xs flex items-center gap-1.5 font-sans" :class="hasLower ? 'text-green-600' : 'text-gray-500'">
        <i class="fas text-[10px] sm:text-xs" :class="hasLower ? 'fa-check-circle' : 'fa-circle'"></i>
        {{default lowercaseText '1 lowercase letter'}}
      </li>
      <li class="text-[11px] sm:text-xs flex items-center gap-1.5 font-sans" :class="hasNumber ? 'text-green-600' : 'text-gray-500'">
        <i class="fas text-[10px] sm:text-xs" :class="hasNumber ? 'fa-check-circle' : 'fa-circle'"></i>
        {{default numberText '1 number'}}
      </li>
      <li class="text-[11px] sm:text-xs flex items-center gap-1.5 font-sans" :class="hasSpecial ? 'text-green-600' : 'text-gray-500'">
        <i class="fas text-[10px] sm:text-xs" :class="hasSpecial ? 'fa-check-circle' : 'fa-circle'"></i>
        {{default specialText '1 special character'}}
      </li>
    </ul>
  {{/if}}
</div>
