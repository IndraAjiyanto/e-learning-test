{{!--
  Komponen: Input Password dengan Validasi Real-time (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/input/password/validated.hbs

  Input password dengan validasi real-time menggunakan Alpine.js,
  menampilkan checklist untuk: minimal 8 karakter, uppercase, lowercase, angka, dan karakter spesial.

  Props:
  - name                 : Atribut name (default: "password")
  - id                   : Atribut id (default: name)
  - label                : Teks label (wajib)
  - placeholder          : Placeholder teks (default: "********")
  - value                : Nilai input (opsional)
  - required             : Boolean required (default: true)
  - autocomplete         : Atribut autocomplete (default: "new-password")
  - labelClass           : Kelas tambahan label
  - inputClass           : Kelas tambahan input
  - wrapperClass         : Kelas tambahan pembungkus
  - showValidation       : Boolean menampilkan checklist validasi (default: true)
  - lengthText           : Teks untuk validasi minimal panjang
  - uppercaseText        : Teks untuk validasi uppercase
  - lowercaseText        : Teks untuk validasi lowercase
  - numberText           : Teks untuk validasi angka
  - specialText          : Teks untuk validasi karakter spesial
  - xModel               : Nama variabel Alpine.js untuk binding (default: "password")
--}}

<div class="{{default wrapperClass ''}}">
  <label
    for="{{default id (default name 'password')}}"
    class="mb-2 block font-inter text-sm font-medium text-[#2D2D2D] {{default labelClass ''}}"
  >{{label}}</label>

  <div class="relative">
    <div class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-[#003060]">
      {{#if leftIcon}}
        <i class="{{leftIcon}} text-lg lg:text-xl"></i>
      {{else}}
        <svg class="size-5 text-[#003060] lg:size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          <circle cx="12" cy="16" r="1" fill="currentColor" />
        </svg>
      {{/if}}
    </div>

    <input
      :type="show{{default xModel 'password'}} ? 'text' : 'password'"
      id="{{default id (default name 'password')}}"
      name="{{default name 'password'}}"
      x-model="{{default xModel 'password'}}"
      {{#if value}}value="{{value}}"{{/if}}
      placeholder="{{default placeholder (t 'test.signUp.placeholderPassword')}}"
      autocomplete="{{default autocomplete 'new-password'}}"
      {{#if required}}required{{/if}}
      class="h-12 w-full rounded-[8px] border bg-white pl-11 pr-11 font-inter text-sm font-normal text-[#2D2D2D] shadow-[0px_0px_4px_0px_#00000030] transition-colors placeholder:text-sm placeholder:text-[#2D2D2DCC] focus:outline-none focus:ring-2 focus:ring-[#003060] {{default inputClass ''}}"
      :class="{{default xModel 'password'}}.length === 0 ? 'border-[#D9D9D9]' : (isPasswordValid ? 'border-green-500' : 'border-red-400')"
    />
    <button
      type="button"
      @click="show{{default xModel 'password'}} = !show{{default xModel 'password'}}"
      class="absolute inset-y-0 right-4 flex items-center text-[#003060] hover:text-gray-700"
      aria-label="Toggle password visibility"
    >
      <i class="fas text-base lg:text-lg" :class="show{{default xModel 'password'}} ? 'fa-eye-slash' : 'fa-eye'"></i>
    </button>
  </div>

  {{#if (default showValidation true)}}
    <ul class="mt-1.5 space-y-0.5 font-inter lg:mt-2 lg:space-y-1">
      <li class="flex items-center gap-1.5 text-[11px] lg:text-xs" :class="hasLength ? 'text-green-600' : 'text-gray-500'">
        <i class="fas text-[10px] lg:text-xs" :class="hasLength ? 'fa-check-circle' : 'fa-circle'"></i>
        {{default lengthText 'At least 8 characters'}}
      </li>
      <li class="flex items-center gap-1.5 text-[11px] lg:text-xs" :class="hasUpper ? 'text-green-600' : 'text-gray-500'">
        <i class="fas text-[10px] lg:text-xs" :class="hasUpper ? 'fa-check-circle' : 'fa-circle'"></i>
        {{default uppercaseText '1 uppercase letter'}}
      </li>
      <li class="flex items-center gap-1.5 text-[11px] lg:text-xs" :class="hasLower ? 'text-green-600' : 'text-gray-500'">
        <i class="fas text-[10px] lg:text-xs" :class="hasLower ? 'fa-check-circle' : 'fa-circle'"></i>
        {{default lowercaseText '1 lowercase letter'}}
      </li>
      <li class="flex items-center gap-1.5 text-[11px] lg:text-xs" :class="hasNumber ? 'text-green-600' : 'text-gray-500'">
        <i class="fas text-[10px] lg:text-xs" :class="hasNumber ? 'fa-check-circle' : 'fa-circle'"></i>
        {{default numberText '1 number'}}
      </li>
      <li class="flex items-center gap-1.5 text-[11px] lg:text-xs" :class="hasSpecial ? 'text-green-600' : 'text-gray-500'">
        <i class="fas text-[10px] lg:text-xs" :class="hasSpecial ? 'fa-check-circle' : 'fa-circle'"></i>
        {{default specialText '1 special character'}}
      </li>
    </ul>
  {{/if}}
</div>
