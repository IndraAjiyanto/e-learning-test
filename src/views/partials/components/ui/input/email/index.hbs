{{!--
  Komponen: Input Email (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/input/email/index.hbs

  Input email dengan label, validasi HTML5 & styling responsif.

  Props:
  - name           : Atribut name (default: "email")
  - id             : Atribut id (default: name)
  - label          : Teks label (wajib)
  - placeholder    : Placeholder teks (default: "Email")
  - value          : Nilai input (opsional)
  - required       : Boolean required (default: true)
  - disabled       : Boolean disabled/readonly (default: false)
  - labelClass     : Kelas tambahan label (default: "block text-xs sm:text-sm font-medium text-[#0B1F3B] mb-1 font-montserrat")
  - inputClass     : Kelas tambahan input (default: "w-full px-3.5 py-2.5 sm:px-4 sm:py-3 text-xs sm:text-sm rounded-[12px] sm:rounded-lg bg-white border border-[#D9D9D9] text-[#2D2D2D] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#003060]")
  - wrapperClass   : Kelas tambahan pembungkus (default: "")
  - autocomplete   : Atribut autocomplete (default: "email")
  - hint           : Teks bantuan di bawah input (opsional)
--}}

<div class="{{wrapperClass}}">
  <label
    for="{{default id (default name 'email')}}"
    class="block text-xs sm:text-sm font-medium text-[#0B1F3B] mb-1 font-montserrat {{labelClass}}"
  >{{label}}</label>

  <input
    type="email"
    id="{{default id (default name 'email')}}"
    name="{{default name 'email'}}"
    {{#if value}}value="{{value}}"{{/if}}
    placeholder="{{default placeholder 'Email'}}"
    autocomplete="{{default autocomplete 'email'}}"
    {{#if required}}required{{/if}}
    {{#if disabled}}disabled readonly{{/if}}
    class="w-full px-3.5 py-2.5 sm:px-4 sm:py-3 text-xs sm:text-sm rounded-[12px] sm:rounded-lg bg-white border border-[#D9D9D9] text-[#2D2D2D] placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#003060] {{default inputClass ''}}"
  />

  {{#if hint}}
    <p class="text-xs text-gray-400 mt-1 font-sans">{{hint}}</p>
  {{/if}}
</div>
