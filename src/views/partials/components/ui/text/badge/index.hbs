{{!-- 
  Komponen: Badge/Chip (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/text/badge/index.hbs

  Menampilkan badge/chip dengan styling konsisten & responsif.

  Props:
  - text        : Teks badge (wajib)
  - tag         : Elemen HTML: span | h2 | h3 | div (default: span)
  - color       : Warna teks (default: primary → "text-[#003060]")
  - bgColor     : Warna background (default: "bg-[#6EB6E533]")
  - borderColor : Warna border (default: "border-[#003060]")
  - size        : Ukuran: sm | md | lg (default: md) — menentukan padding, text size & font weight
  - textSize    : Override ukuran teks, mis. "text-[12px]" (default: ikut `size`)
  - fontWeight  : Override tebal teks, mis. "font-bold" (default: ikut `size`)
  - shadowClass : Override bayangan, mis. "shadow-none" (default: "shadow-sm")
  - class       : Kelas tambahan (default: "")

  Catatan: text size, font weight & shadow WAJIB lewat prop di atas, bukan lewat `class`.
  Tailwind menyelesaikan konflik utility berdasarkan urutan di file CSS hasil build,
  bukan urutan penulisan di atribut class — mis. `class="font-bold"` tetap kalah
  dari `font-medium` bawaan `size='sm'`.
--}}

<{{default tag 'span'}} class="inline-block rounded-full border
  {{default shadowClass 'shadow-sm'}}
  {{default bgColor 'bg-[#6EB6E533]'}}
  {{default borderColor 'border-[#003060]'}}
  {{colorClass (default color 'primary')}}
  {{#if (eq size 'sm')}}px-4 py-1{{else if (eq size 'lg')}}px-8 py-2.5{{else}}px-6 py-2{{/if}}
  {{#if textSize}}{{textSize}}{{else}}{{#if (eq size 'sm')}}text-sm{{else if (eq size 'lg')}}text-2xl{{else}}text-xl{{/if}}{{/if}}
  {{#if fontWeight}}{{fontWeight}}{{else}}{{#if (eq size 'sm')}}font-medium{{else}}font-semibold{{/if}}{{/if}}
  {{class}}">
  {{text}}
</{{default tag 'span'}}>
