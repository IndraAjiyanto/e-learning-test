{{!--
  Komponen: Form Section Header (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/text/form_section_header/index.hbs

  Header bagian di dalam form card dengan title dan helper text.

  Props:
  - title      : string (wajib)
  - helperText : string (opsional)
  - boxed      : boolean (opsional, render container border box)
  - class      : string (opsional)
--}}

<div
  class="
    flex flex-col items-start gap-2 w-full
    {{#if boxed}}
      rounded-2xl border border-[#D9D9D9] bg-white p-6 sm:p-8
    {{/if}}
    {{class}}
  "
>
  <h3 class="font-montserrat font-semibold text-lg sm:text-xl text-[#003060] leading-tight">
    {{title}}
  </h3>
  {{#if helperText}}
    <p class="font-inter font-normal text-sm sm:text-base md:text-xl text-[#7895BD] leading-normal">
      {{helperText}}
    </p>
  {{/if}}
</div>
