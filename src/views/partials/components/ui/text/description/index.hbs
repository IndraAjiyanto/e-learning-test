{{!--
  Komponen: Text Description (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/text/description/index.hbs

  Menampilkan paragraf deskripsi dengan styling konsisten & responsif.

  Props:
  - text      : Teks deskripsi (wajib)
  - align     : Posisi teks: left | center | right (default: center)
  - size      : Ukuran: xs | sm | md | lg (default: sm)
  - color     : Warna teks (default: "text-[#2D2D2D]")
  - class     : Kelas tambahan untuk layout/spacing (default: "")
  - tag       : Elemen HTML: p | span | div (default: p)
--}}

{{#if (eq size 'xs')}}
  <{{default tag 'p'}} class="text-xs {{default color 'text-[#2D2D2D]'}} text-{{default align 'center'}} font-sans {{class}}">{{text}}</{{default tag 'p'}}>
{{else if (eq size 'md')}}
  <{{default tag 'p'}} class="text-base {{default color 'text-[#2D2D2D]'}} text-{{default align 'center'}} font-sans {{class}}">{{text}}</{{default tag 'p'}}>
{{else if (eq size 'lg')}}
  <{{default tag 'p'}} class="text-lg {{default color 'text-[#2D2D2D]'}} text-{{default align 'center'}} font-sans {{class}}">{{text}}</{{default tag 'p'}}>
{{else}}
  <{{default tag 'p'}} class="text-xs sm:text-sm {{default color 'text-[#2D2D2D]'}} text-{{default align 'center'}} font-sans {{class}}">{{text}}</{{default tag 'p'}}>
{{/if}}
