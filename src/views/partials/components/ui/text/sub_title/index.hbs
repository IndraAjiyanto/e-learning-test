{{!--
  Komponen: Text Sub Title (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/text/sub_title/index.hbs

  Menampilkan judul/heading sub-section dengan styling konsisten & responsif.

  Props (semua support shorthand & raw value):
  - text       : Teks judul (wajib)
  - align      : left | center | right | justify (default: center)
  - size       : xs | sm | md | lg | xl | 2xl | 3xl | 4xl (default: md)
  - color      : primary | secondary | dark | muted | gray | white (default: dark)
  - font       : sans | montserrat | inter | opensans (default: montserrat)
  - fontWeight : font-normal | font-medium | font-semibold | font-bold (default: font-bold)
  - class      : Kelas tambahan untuk layout/spacing (default: "")
  - tag        : Elemen HTML: h1 | h2 | h3 | h4 | h5 | h6 (default: h1)
--}}

<{{default tag 'h1'}} class="{{sizeClass (default size 'md')}} {{colorClass (default color 'dark')}} {{alignClass (default align 'center')}} {{fontClass (default font 'montserrat')}} {{default fontWeight 'font-bold'}} {{class}}">{{text}}</{{default tag 'h1'}}>
