{{!--
  Komponen: Change Password Form (Profile)
  Lokasi: src/views/partials/components/ui/profile/change_password/index.hbs
  Level: L2 Section

  Dipakai dua mode:
  - isTab=true  : isi tab "password" di shell user_profile/index.hbs (role user)
  - isTab=false : halaman /users/profile/password (admin & super_admin)

  Form-nya tetap POST biasa ke /users/password/:id?_method=PATCH; field-nya
  merender <input name=...> sehingga submit native tetap jalan. Alpine hanya
  dipakai untuk validasi sisi klien dan gating tombol simpan, sesuai
  docs/form-submit-gating.md.

  Props:
  - user       : object (wajib, butuh user.id)
  - isTab      : boolean (opsional, default false)
  - cancelHref : string (opsional, default '/users/profile') — hanya mode non-tab
--}}
<div class='{{#unless isTab}}min-h-screen bg-[#f3f3f3] {{/unless}}p-4 sm:px-[34px] sm:py-[42px]'>
  <div class='mx-auto flex w-full max-w-[620px] flex-col gap-7'>

    <div class='flex flex-col gap-1'>
      {{> components/ui/super_admin/page_header/index
        titleTag='h2'
        title=(default (t 'test.profile.editPassword.title') 'Change your password')
      }}
      {{> components/ui/super_admin/description/index
        text=(default (t 'test.profile.editPassword.subtitle') 'Enter your new password below.')
      }}
    </div>

    <form
      action='/users/password/{{user.id}}?_method=PATCH'
      method='POST'
      x-data='changePasswordForm()'
      @submit='onSubmit($event)'
      class='flex flex-col gap-6 rounded-xl border border-[#d9d9d9] bg-white p-5 sm:p-8'
    >
      <div class='flex flex-col gap-5'>
        {{> components/ui/super_admin/form/text_field
          id=(concat 'current-password-' (default idSuffix 'tab'))
          name='currentPassword'
          field='currentPassword'
          label=(default (t 'test.profile.editPassword.currentPassword') 'Current Password')
          type='password'
          toggle=true
          required=true
          placeholder=(default (t 'test.profile.editPassword.placeholderCurrentPassword') 'Enter your current password')
        }}

        {{> components/ui/super_admin/form/text_field
          id=(concat 'new-password-' (default idSuffix 'tab'))
          name='newPassword'
          field='newPassword'
          label=(default (t 'test.profile.editPassword.newPassword') 'New Password')
          type='password'
          toggle=true
          required=true
          placeholder=(default (t 'test.profile.editPassword.placeholderNewPassword') 'Enter your new password')
        }}

        {{!--
          Daftar syarat password.

          Halaman daftar dan lupa-password sudah memakainya (regis.hbs,
          reset-password.hbs, super_admin/user/create) dengan kunci i18n yang
          sama, sementara halaman ini dulu hanya menuntut 8 karakter tanpa
          memberi tahu syarat lainnya - padahal server menolak dengan aturan
          yang jauh lebih ketat. Kelimanya sama persis dengan
          assertStrongPassword di src/common/utils/password.util.ts.
        --}}
        <ul class='-mt-2 flex flex-col gap-1.5' aria-label='Password requirements'>
          {{#each (array
            (array 'length' 'rules.length')
            (array 'uppercase' 'rules.uppercase')
            (array 'lowercase' 'rules.lowercase')
            (array 'number' 'rules.number')
            (array 'special' 'rules.special')
          )}}
            <li
              class='flex items-center gap-1.5 font-inter text-xs'
              :class="{{lookup this 1}} ? 'text-[#15803d]' : 'text-[#737373]'"
            >
              <i
                class='text-[10px]'
                :class="{{lookup this 1}} ? 'fas fa-check-circle' : 'far fa-circle'"
                aria-hidden='true'
              ></i>
              {{t (concat 'test.passwordChecklist.' (lookup this 0))}}
            </li>
          {{/each}}
        </ul>

        {{> components/ui/super_admin/form/text_field
          id=(concat 'confirm-password-' (default idSuffix 'tab'))
          name='confirmPassword'
          field='confirmPassword'
          label=(default (t 'test.profile.editPassword.confirmNewPassword') 'Confirm Password')
          type='password'
          toggle=true
          required=true
          placeholder=(default (t 'test.profile.editPassword.placeholderConfirmNewPassword') 'Confirm your new password')
        }}

        <p
          x-show='formData.confirmPassword.length > 0'
          x-cloak
          class='flex items-center gap-1.5 font-inter text-xs'
          :class="matches ? 'text-[#15803d]' : 'text-[#dc2626]'"
        >
          <i :class="matches ? 'fas fa-check-circle' : 'fas fa-circle-exclamation'" class='text-xs'></i>
          <span x-text="matches
            ? '{{default (t 'test.passwordChecklist.match') 'Passwords match'}}'
            : '{{default (t 'test.passwordChecklist.noMatch') 'Passwords do not match'}}'"></span>
        </p>
      </div>

      <div class='flex items-center justify-end gap-3 border-t border-[#d9d9d9] pt-6'>
        {{#if isTab}}
          {{> components/ui/super_admin/form/button
            label=(default (t 'test.profile.editPassword.cancel') 'Cancel')
            variant='secondary'
            atClick="toggleActiveSection('profile')"
          }}
        {{else}}
          {{> components/ui/super_admin/form/button
            label=(default (t 'test.profile.editPassword.cancel') 'Cancel')
            variant='secondary'
            as='link'
            href=(default cancelHref '/users/profile')
          }}
        {{/if}}
        {{> components/ui/super_admin/form/button
          label=(default (t 'test.profile.editPassword.saveChanges') 'Save Changes')
          type='submit'
          loading=true
          disabled='!canSubmit() || loading'
        }}
      </div>
    </form>

  </div>
</div>

<script>
  function changePasswordForm() {
    const trim = (v) => String(v ?? '');

    // Salinan assertStrongPassword (src/common/utils/password.util.ts). Kalau
    // aturan di sana berubah, keduanya harus ikut berubah - itu sebabnya
    // bentuknya dibuat semirip mungkin.
    const RULES = {
      length: (v) => v.length >= 8,
      uppercase: (v) => /[A-Z]/.test(v),
      lowercase: (v) => /[a-z]/.test(v),
      number: (v) => /[0-9]/.test(v),
      special: (v) => /[^A-Za-z0-9]/.test(v),
    };
    const strongEnough = (v) => Object.values(RULES).every((ok) => ok(v));

    const errorFor = (field, value, all) => {
      const val = trim(value);
      switch (field) {
        case 'currentPassword':
          return val ? '' : 'Current password is required.';
        case 'newPassword':
          if (!val) return 'New password is required.';
          // Sengaja tidak mengulang kelima syaratnya di sini: daftarnya sudah
          // tercetak di bawah field dan ikut bergerak saat diketik. Aturannya
          // sendiri dijaga `rules` di bawah, yang menyalin assertStrongPassword
          // di server - dulu klien hanya meminta 8 karakter, server meminta 6,
          // dan yang dipakai saat mendaftar justru lima syarat ini.
          if (!strongEnough(val)) {
            return 'Your new password does not meet the requirements listed below.';
          }
          return '';
        case 'confirmPassword':
          if (!val) return 'Please confirm your new password.';
          if (val !== trim(all.newPassword)) return 'Passwords do not match.';
          return '';
        default:
          return '';
      }
    };

    return {
      loading: false,
      formData: { currentPassword: '', newPassword: '', confirmPassword: '' },
      formErrors: {},
      touched: {},

      get rules() {
        const value = trim(this.formData.newPassword);
        return {
          length: RULES.length(value),
          uppercase: RULES.uppercase(value),
          lowercase: RULES.lowercase(value),
          number: RULES.number(value),
          special: RULES.special(value),
        };
      },

      get matches() {
        return (
          this.formData.confirmPassword.length > 0 &&
          this.formData.newPassword === this.formData.confirmPassword
        );
      },

      validateField(field, value) {
        const message = errorFor(field, value, this.formData);
        if (message && this.touched[field]) this.formErrors[field] = message;
        else delete this.formErrors[field];

        // Konfirmasi ikut dihitung ulang saat password baru berubah, supaya
        // pesannya tidak tertinggal di keadaan lama.
        if (field === 'newPassword' && this.touched.confirmPassword) {
          const confirmMessage = errorFor('confirmPassword', this.formData.confirmPassword, {
            ...this.formData,
            newPassword: value,
          });
          if (confirmMessage) this.formErrors.confirmPassword = confirmMessage;
          else delete this.formErrors.confirmPassword;
        }
      },

      touch(field) {
        this.touched[field] = true;
        this.validateField(field, this.formData[field]);
      },

      canSubmit() {
        return ['currentPassword', 'newPassword', 'confirmPassword'].every(
          (f) => !errorFor(f, this.formData[f], this.formData),
        );
      },

      onSubmit(event) {
        if (!this.canSubmit()) {
          event.preventDefault();
          Object.keys(this.formData).forEach((f) => this.touch(f));
          return;
        }
        this.loading = true;
      },
    };
  }
</script>
