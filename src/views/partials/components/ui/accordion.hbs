{{!-- 
  Komponen: Accordion (Level 1 - UI Dasar, Shared)
  Lokasi: src/views/partials/components/ui/accordion.hbs
  Dipakai: mpp/faq.hbs, dashboard/faq.hbs
  
  Props:
  - faqs         : Array {question, answer} (jika disediakan, render via x-for; jika tidak, pakai block)
  - activeIndex  : Index aktif awal (default null)
  - wrapperClass : Class tambahan untuk container accordion
  - ctaBlock     : Block opsional untuk CTA bawah (misal WhatsApp)
--}}
<div
  x-data="{
    activeIndex: {{default activeIndex 'null'}},
    faqs: {{{json faqs}}}
  }"
  class="mx-auto max-w-[1406px] space-y-4 {{wrapperClass}}"
>
  <template x-for="(faq, index) in faqs" :key="index">
    <div class="overflow-hidden rounded-xl bg-white shadow-lg">
      <button
        type="button"
        @click="activeIndex = activeIndex === index ? null : index"
        :aria-expanded="activeIndex === index"
        :aria-controls="'faq-answer-' + index"
        class="group flex w-full items-center justify-between gap-6 px-6 py-5 text-left transition-colors duration-300 hover:bg-[#6EB6E5]/10 sm:px-8 sm:py-6"
      >
        <h3
          class="font-sans text-[25px] font-semibold leading-7 text-[#003060] sm:text-[20px] sm:leading-8 lg:text-[25px]"
          x-text="(index + 1) + '. ' + faq.question"
        ></h3>
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full transition-colors duration-300">
          <i class="fas fa-chevron-down text-[16px] text-[#003060] transition-transform duration-300" :class="activeIndex === index ? 'rotate-180' : ''"></i>
        </span>
      </button>
      <div x-cloak x-show="activeIndex === index" x-collapse :id="'faq-answer-' + index" class="border-t border-gray-200">
        <div class="px-6 py-5 sm:px-8 sm:py-6">
          <p class="font-sans text-[25px] leading-7 text-gray-900 sm:text-[18px] sm:leading-8 lg:text-[25px]" x-text="faq.answer"></p>
        </div>
      </div>
    </div>
  </template>
  {{#> accordionContent}}{{/accordionContent}}
</div>
{{#if ctaBlock}}
<div class="mx-auto mt-12 max-w-[1406px]">
  <div class="rounded-2xl px-6 py-8 text-center sm:px-10">
    {{> ctaBlock}}
  </div>
</div>
{{/if}}
