{{!--
  Komponen: User Notification Pop-Up (Proportional Standard + Robust i18n)
  Lokasi: src/views/partials/components/ui/notification/index.hbs
  Level: L2 Section Component
  Ref: ClickUp z8pbk8xvjz - Proporsional Web UI Standard dengan integrasi i18n aman kutip (apostrophe-safe)

  ponytail: in-memory Alpine state for unread IDs, static cards rendered directly via Handlebars i18n to avoid JS string injection errors.
--}}
<div
  class="relative inline-block"
  x-data="{
    open: false,
    unreadIds: [1, 2, 3, 4],
    get unreadCount() {
      return this.unreadIds.length;
    },
    markAllAsRead() {
      this.unreadIds = [];
    },
    markAsRead(id) {
      this.unreadIds = this.unreadIds.filter(i => i !== id);
    },
    isUnread(id) {
      return this.unreadIds.includes(id);
    }
  }"
  @click.outside="open = false"
  @keydown.escape.window="open = false"
>
  {{!-- Trigger Bell Button --}}
  <button
    type="button"
    @click="open = !open"
    class="relative grid size-9 shrink-0 place-items-center rounded-full bg-[#F4F7FC] text-[#003060] transition-colors hover:bg-[#E8EFF8] focus:outline-none"
    aria-label="{{t 'test.notification.title'}}"
    :aria-expanded="open"
  >
    <i class="fas fa-bell text-sm"></i>
    <template x-if="unreadCount > 0">
      <span
        x-text="unreadCount"
        class="absolute -right-1 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-[#1764F6] px-1 font-montserrat text-[10px] font-bold text-white shadow-[0px_1px_4px_rgba(23,100,246,0.33)]"
      ></span>
    </template>
  </button>

  {{!-- Popover Dropdown Panel (Proportional Web Standard: 380px-420px) --}}
  <div
    x-cloak
    x-show="open"
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0 translate-y-1 scale-95"
    x-transition:enter-end="opacity-100 translate-y-0 scale-100"
    x-transition:leave="transition ease-in duration-100"
    x-transition:leave-start="opacity-100 translate-y-0 scale-100"
    x-transition:leave-end="opacity-0 translate-y-1 scale-95"
    class="absolute right-0 top-full mt-2.5 z-50 w-[380px] sm:w-[420px] max-w-[calc(100vw-24px)] flex flex-col rounded-xl border border-[#CDD7E6] bg-white p-4 shadow-[0px_10px_25px_rgba(35,67,107,0.1)]"
    style="display: none;"
  >
    {{!-- Pointer & Seam Cover --}}
    <div class="pointer-events-none absolute -top-[7px] right-3.5 z-10 size-3.5 rotate-45 border-l border-t border-[#CDD7E6] bg-white"></div>
    <div class="pointer-events-none absolute -top-px right-3 z-20 h-1 w-4 bg-white"></div>

    {{!-- Header --}}
    <div class="flex items-center justify-between pb-3 border-b border-[#DFE6F1]">
      <h2 class="font-montserrat text-lg font-bold text-[#122143]">
        {{t 'test.notification.title'}}
      </h2>
      <button
        type="button"
        @click="markAllAsRead()"
        class="font-montserrat text-xs font-semibold text-[#1764F6] hover:underline focus:outline-none transition-colors"
      >
        {{t 'test.notification.markAllAsRead'}}
      </button>
    </div>

    {{!-- Notification List --}}
    <div class="max-h-[360px] overflow-y-auto divide-y divide-[#DFE6F1] py-1 pr-1">
      {{!-- Item 1: Session --}}
      <div
        @click="markAsRead(1)"
        class="relative flex items-start gap-3 py-3 px-2 cursor-pointer hover:bg-[#F9FBFE] transition-colors rounded-lg"
      >
        <div class="grid size-10 shrink-0 place-items-center rounded-full text-base bg-[#EFEEFF] text-[#5049F2]">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <div class="flex flex-1 flex-col items-start gap-1 min-w-0 pr-4">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-full px-2 py-0.5 font-montserrat text-[11px] font-semibold leading-none bg-[#EFEEFF] text-[#5049F2]">
              {{t 'test.notification.categories.session'}}
            </span>
            <span class="font-montserrat text-[11px] font-normal text-[#8C9DBC]">
              {{t 'test.notification.mock.sessionTime'}}
            </span>
          </div>
          <h3 class="font-montserrat text-xs sm:text-sm font-bold text-[#122143] leading-tight truncate w-full">
            {{t 'test.notification.mock.sessionTitle'}}
          </h3>
          <p class="font-montserrat text-xs font-normal text-[#60749E] line-clamp-2 leading-relaxed">
            {{t 'test.notification.mock.sessionDesc'}}
          </p>
        </div>
        <span
          x-show="isUnread(1)"
          class="mt-1.5 size-2 sm:size-2.5 rounded-full bg-[#1764F6] shadow-[0px_1px_4px_rgba(23,100,246,0.33)] shrink-0"
        ></span>
      </div>

      {{!-- Item 2: Week --}}
      <div
        @click="markAsRead(2)"
        class="relative flex items-start gap-3 py-3 px-2 cursor-pointer hover:bg-[#F9FBFE] transition-colors rounded-lg"
      >
        <div class="grid size-10 shrink-0 place-items-center rounded-full text-base bg-[#E6F6F2] text-[#159A7F]">
          <i class="fa-solid fa-calendar-days"></i>
        </div>
        <div class="flex flex-1 flex-col items-start gap-1 min-w-0 pr-4">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-full px-2 py-0.5 font-montserrat text-[11px] font-semibold leading-none bg-[#E6F6F2] text-[#159A7F]">
              {{t 'test.notification.categories.week'}}
            </span>
            <span class="font-montserrat text-[11px] font-normal text-[#8C9DBC]">
              {{t 'test.notification.mock.weekTime'}}
            </span>
          </div>
          <h3 class="font-montserrat text-xs sm:text-sm font-bold text-[#122143] leading-tight truncate w-full">
            {{t 'test.notification.mock.weekTitle'}}
          </h3>
          <p class="font-montserrat text-xs font-normal text-[#60749E] line-clamp-2 leading-relaxed">
            {{t 'test.notification.mock.weekDesc'}}
          </p>
        </div>
        <span
          x-show="isUnread(2)"
          class="mt-1.5 size-2 sm:size-2.5 rounded-full bg-[#1764F6] shadow-[0px_1px_4px_rgba(23,100,246,0.33)] shrink-0"
        ></span>
      </div>

      {{!-- Item 3: Silabus --}}
      <div
        @click="markAsRead(3)"
        class="relative flex items-start gap-3 py-3 px-2 cursor-pointer hover:bg-[#F9FBFE] transition-colors rounded-lg"
      >
        <div class="grid size-10 shrink-0 place-items-center rounded-full text-base bg-[#FFF4DD] text-[#F29A00]">
          <i class="fa-solid fa-book-open"></i>
        </div>
        <div class="flex flex-1 flex-col items-start gap-1 min-w-0 pr-4">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-full px-2 py-0.5 font-montserrat text-[11px] font-semibold leading-none bg-[#FFF4DD] text-[#F29A00]">
              {{t 'test.notification.categories.syllabus'}}
            </span>
            <span class="font-montserrat text-[11px] font-normal text-[#8C9DBC]">
              {{t 'test.notification.mock.syllabusTime'}}
            </span>
          </div>
          <h3 class="font-montserrat text-xs sm:text-sm font-bold text-[#122143] leading-tight truncate w-full">
            {{t 'test.notification.mock.syllabusTitle'}}
          </h3>
          <p class="font-montserrat text-xs font-normal text-[#60749E] line-clamp-2 leading-relaxed">
            {{t 'test.notification.mock.syllabusDesc'}}
          </p>
        </div>
        <span
          x-show="isUnread(3)"
          class="mt-1.5 size-2 sm:size-2.5 rounded-full bg-[#1764F6] shadow-[0px_1px_4px_rgba(23,100,246,0.33)] shrink-0"
        ></span>
      </div>

      {{!-- Item 4: Quiz --}}
      <div
        @click="markAsRead(4)"
        class="relative flex items-start gap-3 py-3 px-2 cursor-pointer hover:bg-[#F9FBFE] transition-colors rounded-lg"
      >
        <div class="grid size-10 shrink-0 place-items-center rounded-full text-base bg-[#FDECEF] text-[#F34E5D]">
          <i class="fa-solid fa-brain"></i>
        </div>
        <div class="flex flex-1 flex-col items-start gap-1 min-w-0 pr-4">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-full px-2 py-0.5 font-montserrat text-[11px] font-semibold leading-none bg-[#FDECEF] text-[#F34E5D]">
              {{t 'test.notification.categories.quiz'}}
            </span>
            <span class="font-montserrat text-[11px] font-normal text-[#8C9DBC]">
              {{t 'test.notification.mock.quizTime'}}
            </span>
          </div>
          <h3 class="font-montserrat text-xs sm:text-sm font-bold text-[#122143] leading-tight truncate w-full">
            {{t 'test.notification.mock.quizTitle'}}
          </h3>
          <p class="font-montserrat text-xs font-normal text-[#60749E] line-clamp-2 leading-relaxed">
            {{t 'test.notification.mock.quizDesc'}}
          </p>
        </div>
        <span
          x-show="isUnread(4)"
          class="mt-1.5 size-2 sm:size-2.5 rounded-full bg-[#1764F6] shadow-[0px_1px_4px_rgba(23,100,246,0.33)] shrink-0"
        ></span>
      </div>

      {{!-- Item 5: Session User --}}
      <div
        @click="markAsRead(5)"
        class="relative flex items-start gap-3 py-3 px-2 cursor-pointer hover:bg-[#F9FBFE] transition-colors rounded-lg"
      >
        <div class="grid size-10 shrink-0 place-items-center rounded-full text-base bg-[#EAF2FF] text-[#3778EE]">
          <i class="fa-solid fa-user"></i>
        </div>
        <div class="flex flex-1 flex-col items-start gap-1 min-w-0 pr-4">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-full px-2 py-0.5 font-montserrat text-[11px] font-semibold leading-none bg-[#EAF2FF] text-[#3778EE]">
              {{t 'test.notification.categories.sessionUser'}}
            </span>
            <span class="font-montserrat text-[11px] font-normal text-[#8C9DBC]">
              {{t 'test.notification.mock.sessionUserTime'}}
            </span>
          </div>
          <h3 class="font-montserrat text-xs sm:text-sm font-bold text-[#122143] leading-tight truncate w-full">
            {{t 'test.notification.mock.sessionUserTitle'}}
          </h3>
          <p class="font-montserrat text-xs font-normal text-[#60749E] line-clamp-2 leading-relaxed">
            {{t 'test.notification.mock.sessionUserDesc'}}
          </p>
        </div>
        <span
          x-show="isUnread(5)"
          class="mt-1.5 size-2 sm:size-2.5 rounded-full bg-[#1764F6] shadow-[0px_1px_4px_rgba(23,100,246,0.33)] shrink-0"
        ></span>
      </div>
    </div>

    {{!-- View All Notifications Button --}}
    <div class="pt-3 border-t border-[#DFE6F1]">
      <a
        href="/users/profile?tab=dashboard"
        class="flex h-10 w-full items-center justify-center gap-2 rounded-lg bg-[#F1F5FD] font-montserrat text-xs font-semibold text-[#1764F6] transition hover:bg-[#E3EDFD]"
      >
        <span>{{t 'test.notification.viewAll'}}</span>
        <i class="fa-solid fa-chevron-right text-[10px]"></i>
      </a>
    </div>
  </div>
</div>
