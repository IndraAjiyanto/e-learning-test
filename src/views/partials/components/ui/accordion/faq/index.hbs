{{!-- 
  Komponen: Accordion FAQ (Responsive)
  Lokasi: src/views/partials/components/ui/accordion/faq/index.hbs
  
  Props: None (removed desktop prop)
  
  Catatan: Komponen ini bergantung pada Alpine.js `x-for="(faq, index) in faqs"`.
  Variabel `faq.question`, `faq.answer`, dan fungsi `toggle(index)` berasal dari Alpine state.
  
  Refactored: Menggabungkan mobile + desktop template menjadi satu dengan responsive classes
--}}

<div class="
  overflow-hidden transition-all
  bg-white sm:bg-transparent
  border sm:border-0 sm:border-b
  border-[#D9D9D9] sm:border-[#E0E0E0]
  rounded-[16px] sm:rounded-none
  shadow-[0px_4px_12px_0px_#00000010] sm:shadow-none
">
  <!-- Tombol Pertanyaan -->
  <button
    @click="toggle(index)"
    class="w-full text-left focus:outline-none flex items-center justify-between group transition-colors duration-300
      p-4 sm:py-5 sm:px-4
      sm:hover:bg-[#003060]
    "
    :class="activeIndex === index ? 'bg-[#003060] text-white sm:bg-[#003060] sm:text-white' : 'bg-white text-[#0B1F3B] sm:bg-transparent sm:text-[#0F0F0F]'"
  >
    <div class="flex items-center gap-3 sm:gap-4">
      <!-- Bullet -->
      <div class="w-1.5 h-1.5 rounded-full flex-shrink-0 transition-colors duration-300 sm:group-hover:bg-white"
           :class="activeIndex === index ? 'bg-white' : 'bg-[#0B1F3B]'"></div>
      
      <!-- Vertical Line (Desktop Only) -->
      <div class="hidden sm:block w-[1px] h-5 flex-shrink-0 transition-colors duration-300 sm:group-hover:bg-white/40"
           :class="activeIndex === index ? 'bg-white/40' : 'bg-gray-300'"></div>
      
      <h3 class="font-montserrat font-semibold leading-snug tracking-normal transition-colors duration-300 sm:group-hover:text-white
        text-[15px] sm:text-xl sm:leading-none
      " 
          :class="activeIndex === index ? 'text-white' : 'text-[#0B1F3B] sm:text-[#0F0F0F]'" 
          x-text="faq.question"></h3>
    </div>
    
    <!-- Icon Chevron -->
    <div class="flex-shrink-0 ml-3 sm:ml-4">
      <i class="fas fa-chevron-down transition-transform duration-300 sm:group-hover:text-white
        text-sm sm:text-base
      "
         :class="activeIndex === index ? 'text-white rotate-180' : 'text-[#8F8F8F]'">
      </i>
    </div>
  </button>
  
  <!-- Jawaban -->
  <div
    x-show="activeIndex === index"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 max-h-0"
    x-transition:enter-end="opacity-100 max-h-[500px]"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100 max-h-[500px]"
    x-transition:leave-end="opacity-0 max-h-0"
    class="overflow-hidden
      bg-[#F8F9FA] sm:bg-[#FAFAFA]
      border-t sm:border-t-0 border-[#EAEAEA] sm:border-none
    "
  >
    <div class="p-4 sm:p-6 sm:pl-[42px]">
      <p class="font-sans font-normal leading-relaxed text-[#2D2D2D]
        text-[13px] sm:text-base
        leading-[20px] sm:leading-relaxed
      " x-html="faq.answer"></p>
    </div>
  </div>
</div>
