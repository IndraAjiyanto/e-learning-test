{{!--
  Komponen: Error Toast (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/toast/error/index.hbs
  Level: L1 Atomik (scoped super_admin)

  Kembaran dari toast/success untuk kabar buruk. Sebelum ini kegagalan di area
  student disampaikan lewat dua kanal lama: `alert()` bawaan browser (11 tempat)
  dan toast SweetAlert merah dari flash `error` - dua bahasa visual yang tidak
  ada hubungannya dengan design system.

  KONTRAK PEMAKAIAN
  Dipasang SEKALI saja di layouts/main.hbs, jadi halaman tidak perlu
  memasangnya sendiri. Dua cara memunculkannya:
  1. Server-side — `flashToastError(req, title, description)`
     (src/common/utils/toast.util.ts) mengisi flash `toastError`, yang dibaca
     main.ts menjadi res.locals.toastError dan dioper ke sini sebagai `toast`.
  2. Client-side — window.dispatchEvent(new CustomEvent('toast:error', {
       detail: { title, description } })).

  Sengaja memakai key flash sendiri (`toastError`), bukan `error`: partial
  global `sweetalert` masih merender flash `error` sebagai toast SweetAlert,
  jadi memakai key yang sama akan memunculkan dua notifikasi sekaligus.

  Props:
  - toast       : objek {title, description} dari flash. Bila ada, toast tampil
                  otomatis saat load dan isinya menang atas props di bawah.
  - title       : string fallback judul (default 'Something went wrong')
  - description : string fallback deskripsi
  - duration    : number ms auto-dismiss (default 5000 — lebih lama dari toast
                  sukses karena pesan gagal biasanya perlu dibaca, bukan sekadar
                  dilihat; bar timer ikut sembunyi bila duration <= 0)
--}}
<div
  x-data="errorToast({
    autoShow: {{#if toast}}true{{else}}false{{/if}},
    title: {{json (default toast.title (default title 'Something went wrong'))}},
    description: {{json (default toast.description (default description ''))}},
    duration: {{default duration 5000}}
  })"
  x-show='open'
  x-cloak
  x-transition:enter='transition ease-out duration-200'
  x-transition:enter-start='-translate-y-2 opacity-0'
  x-transition:enter-end='translate-y-0 opacity-100'
  x-transition:leave='transition ease-in duration-150'
  x-transition:leave-start='translate-y-0 opacity-100'
  x-transition:leave-end='-translate-y-2 opacity-0'
  @toast:error.window='show($event.detail)'
  @keydown.escape.window='close()'
  {{!-- assertive, bukan polite: isinya menghalangi apa yang sedang dikerjakan
       user, jadi pembaca layar harus menyelanya. --}}
  role='alert'
  aria-live='assertive'
  :style="`--toast-duration: ${duration}ms`"
  class='fixed right-4 top-[var(--app-toast-top)] z-50 flex w-[calc(100%-2rem)] max-w-[544px] items-start gap-6 overflow-hidden rounded-xl bg-white p-6 shadow-[0px_8px_8px_-4px_rgba(0,0,0,0.03),0px_20px_24px_-4px_rgba(0,0,0,0.08)] sm:right-[34px]'
>
  <span
    class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-8 border-[#fef2f2] bg-[#fee2e2]'
  >
    <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#dc2626' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='h-6 w-6'>
      <circle class='sa-toast-ring-error' cx='12' cy='12' r='10' />
      <path class='sa-toast-mark' d='M12 7v6' />
      <path class='sa-toast-mark' d='M12 17h.01' />
    </svg>
  </span>

  <div class='flex min-w-0 flex-1 flex-col gap-2'>
    <div class='flex items-start justify-between gap-3'>
      <p class='font-inter text-lg font-semibold leading-7 text-[#003060]' x-text='title'></p>

      <button
        type='button'
        @click='close()'
        aria-label='Close notification'
        class='-m-1 flex h-6 w-6 shrink-0 items-center justify-center rounded p-1 text-[#4a5568] transition-colors hover:bg-[#f5f5f5] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40'
      >
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 14 14' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' aria-hidden='true' class='h-3.5 w-3.5'>
          <path d='M1 1 13 13M13 1 1 13' />
        </svg>
      </button>
    </div>

    <p class='font-inter text-sm font-normal leading-5 text-[#718096]' x-text='description'></p>
  </div>

  <span
    x-show='duration > 0'
    aria-hidden='true'
    class='sa-toast-bar-error absolute inset-x-0 bottom-0 h-1 origin-left bg-[#dc2626]'
  ></span>
</div>

<style>
  /* Lingkaran penuh pada viewBox 24x24: keliling 2*pi*10 = 62.8. */
  .sa-toast-ring-error {
    --sa-toast-len: 63;
    stroke-dasharray: 63;
    /* Keadaan awal wajib ditulis di sini juga, bukan hanya di keyframe: tanpa
       ini garisnya tampil penuh selama animation-delay. */
    stroke-dashoffset: 63;
    animation: sa-toast-draw-error 0.45s ease-out forwards;
  }

  .sa-toast-mark {
    opacity: 0;
    animation: sa-toast-fade-error 0.2s 0.35s ease-out forwards;
  }

  .sa-toast-bar-error {
    animation: sa-toast-countdown-error var(--toast-duration, 5000ms) linear forwards;
  }

  @keyframes sa-toast-draw-error {
    from { stroke-dashoffset: var(--sa-toast-len); }
    to { stroke-dashoffset: 0; }
  }

  @keyframes sa-toast-fade-error {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes sa-toast-countdown-error {
    from { transform: scaleX(1); }
    to { transform: scaleX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sa-toast-ring-error,
    .sa-toast-mark,
    .sa-toast-bar-error {
      animation: none;
    }
    .sa-toast-ring-error {
      stroke-dashoffset: 0;
    }
    .sa-toast-mark {
      opacity: 1;
    }
  }
</style>

<script>
  /**
   * Jalan pintas untuk pemanggil sisi klien:
   *   showErrorToast('Judul', 'Keterangan')
   *
   * Komponennya dipasang di layouts/main.hbs, jadi fungsi ini ada di setiap
   * halaman penuh - termasuk halaman yang menyuntikkan fragment, karena
   * fragment selalu mendarat di dalam halaman yang sudah memuat layout ini.
   * Bila suatu saat ada layar yang benar-benar tanpa layout, pemanggilnya
   * kembali ke alert() lama alih-alih diam saja.
   */
  window.showErrorToast = function (title, description) {
    const payload = {
      title: title || 'Something went wrong',
      description: description || '',
    };

    if (!window.__errorToastMounted) {
      window.alert([payload.title, payload.description].filter(Boolean).join('\n'));
      return;
    }

    window.dispatchEvent(new CustomEvent('toast:error', { detail: payload }));
  };

  function errorToast(config) {
    window.__errorToastMounted = true;
    return {
      open: false,
      title: config.title,
      description: config.description,
      duration: config.duration,
      // Timer auto-dismiss; disimpan agar bisa dibatalkan saat toast dipanggil
      // ulang atau ditutup manual - tanpa ini timer lama bisa menutup toast
      // yang baru.
      timer: null,

      init() {
        if (config.autoShow) this.$nextTick(() => this.show());
      },

      show(detail) {
        if (detail && detail.title) this.title = detail.title;
        // Deskripsi boleh dikosongkan secara sengaja oleh pemanggil, jadi yang
        // diperiksa keberadaan propertinya, bukan isinya.
        if (detail && 'description' in detail) this.description = detail.description;

        clearTimeout(this.timer);
        this.open = true;
        this.$nextTick(() => this.restartAnimations());

        if (this.duration > 0) {
          this.timer = setTimeout(() => (this.open = false), this.duration);
        }
      },

      close() {
        if (!this.open) return;

        clearTimeout(this.timer);
        this.open = false;
      },

      // Bila toast dipanggil lagi sementara masih terbuka, elemennya tidak
      // pernah display:none sehingga ikon & bar tidak restart sendiri - bar
      // akan lanjut dari posisi lama padahal timernya sudah direset. Hanya CSS
      // animation yang di-restart (punya animationName); transisi x-show
      // dilewati.
      restartAnimations() {
        this.$el
          .querySelectorAll('.sa-toast-ring-error, .sa-toast-mark, .sa-toast-bar-error')
          .forEach((node) => {
            node.style.animation = 'none';
            void node.offsetWidth; // paksa reflow agar animasinya benar-benar diulang
            node.style.animation = '';
          });
      },
    };
  }
</script>
