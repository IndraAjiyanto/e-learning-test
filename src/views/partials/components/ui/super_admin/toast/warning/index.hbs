{{!--
  Komponen: Warning Toast (Super Admin & Global)
  Lokasi: src/views/partials/components/ui/super_admin/toast/warning/index.hbs
  Level: L1 Atomik (scoped toast system)

  KONTRAK PEMAKAIAN
  Dipasang di layouts/main.hbs agar tersedia secara global.
  Dua cara memunculkannya:
  1. Server-side — `flashToastWarning(req, title, description)`
     (src/common/utils/toast.util.ts) mengisi flash `toastWarning`, yang dibaca
     main.ts menjadi res.locals.toastWarning dan dioper ke sini sebagai `toast`.
  2. Client-side — window.dispatchEvent(new CustomEvent('toast:warning', {
       detail: { title, description } })).

  Props:
  - toast       : objek {title, description} dari flash. Bila ada, toast tampil
                  otomatis saat load.
  - title       : string fallback judul (default 'Warning')
  - description : string fallback deskripsi
  - duration    : number ms auto-dismiss (default 5000)
--}}
<div
  x-data="warningToast({
    autoShow: {{#if toast}}true{{else}}false{{/if}},
    title: {{json (default toast.title (default title 'Warning'))}},
    description: {{json (default toast.description (default description ''))}},
    duration: {{default duration 5000}}
  })"
  x-show='open'
  x-cloak
  x-transition:enter='transition ease-out duration-200'
  x-transition:enter-start='-translate-y-2 opacity-0'
  x-transition:enter-end='translate-y-0 opacity-100'
  x-transition:leave='transition ease-in duration-150'
  x-transition:leave-start='translate-y-0 opacity-100'
  x-transition:leave-end='-translate-y-2 opacity-0'
  @toast:warning.window='show($event.detail)'
  @keydown.escape.window='close()'
  role='alert'
  aria-live='assertive'
  :style="`--toast-duration: ${duration}ms`"
  class='fixed right-4 top-[var(--app-toast-top)] z-50 flex w-[calc(100%-2rem)] max-w-[544px] items-start gap-6 overflow-hidden rounded-xl bg-white p-6 shadow-[0px_8px_8px_-4px_rgba(0,0,0,0.03),0px_20px_24px_-4px_rgba(0,0,0,0.08)] sm:right-[34px]'
>
  <span
    class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-8 border-[#fffbeb] bg-[#fef3c7]'
  >
    <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='#d97706' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='h-6 w-6'>
      <circle class='sa-toast-ring-warning' cx='12' cy='12' r='10' />
      <path class='sa-toast-mark-warning' d='M12 8v5' />
      <path class='sa-toast-mark-warning' d='M12 16h.01' />
    </svg>
  </span>

  <div class='flex min-w-0 flex-1 flex-col gap-2'>
    <div class='flex items-start justify-between gap-3'>
      <p class='font-inter text-lg font-semibold leading-7 text-[#003060]' x-text='title'></p>

      <button
        type='button'
        @click='close()'
        aria-label='Close notification'
        class='-m-1 flex h-6 w-6 shrink-0 items-center justify-center rounded p-1 text-[#4a5568] transition-colors hover:bg-[#f5f5f5] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40'
      >
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 14 14' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' aria-hidden='true' class='h-3.5 w-3.5'>
          <path d='M1 1 13 13M13 1 1 13' />
        </svg>
      </button>
    </div>

    <p class='font-inter text-sm font-normal leading-5 text-[#718096]' x-text='description'></p>
  </div>

  <span
    x-show='duration > 0'
    aria-hidden='true'
    class='sa-toast-bar-warning absolute inset-x-0 bottom-0 h-1 origin-left bg-[#d97706]'
  ></span>
</div>

<style>
  .sa-toast-ring-warning {
    --sa-toast-len: 63;
    stroke-dasharray: 63;
    stroke-dashoffset: 63;
    animation: sa-toast-draw-warning 0.45s ease-out forwards;
  }

  .sa-toast-mark-warning {
    opacity: 0;
    animation: sa-toast-fade-warning 0.2s 0.35s ease-out forwards;
  }

  .sa-toast-bar-warning {
    animation: sa-toast-countdown-warning var(--toast-duration, 5000ms) linear forwards;
  }

  @keyframes sa-toast-draw-warning {
    from { stroke-dashoffset: var(--sa-toast-len); }
    to { stroke-dashoffset: 0; }
  }

  @keyframes sa-toast-fade-warning {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes sa-toast-countdown-warning {
    from { transform: scaleX(1); }
    to { transform: scaleX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sa-toast-ring-warning,
    .sa-toast-mark-warning,
    .sa-toast-bar-warning {
      animation: none;
    }
    .sa-toast-ring-warning {
      stroke-dashoffset: 0;
    }
    .sa-toast-mark-warning {
      opacity: 1;
    }
  }
</style>

<script>
  window.showWarningToast = function (title, description) {
    const payload = {
      title: title || 'Warning',
      description: description || '',
    };

    if (!window.__warningToastMounted) {
      window.alert([payload.title, payload.description].filter(Boolean).join('\n'));
      return;
    }

    window.dispatchEvent(new CustomEvent('toast:warning', { detail: payload }));
  };

  function warningToast(config) {
    window.__warningToastMounted = true;
    return {
      open: false,
      title: config.title,
      description: config.description,
      duration: config.duration,
      timer: null,

      init() {
        if (config.autoShow) this.$nextTick(() => this.show());
      },

      show(detail) {
        if (detail && detail.title) this.title = detail.title;
        if (detail && 'description' in detail) this.description = detail.description;

        clearTimeout(this.timer);
        this.open = true;
        this.$nextTick(() => this.restartAnimations());

        if (this.duration > 0) {
          this.timer = setTimeout(() => (this.open = false), this.duration);
        }
      },

      close() {
        if (!this.open) return;

        clearTimeout(this.timer);
        this.open = false;
      },

      restartAnimations() {
        this.$el
          .querySelectorAll('.sa-toast-ring-warning, .sa-toast-mark-warning, .sa-toast-bar-warning')
          .forEach((node) => {
            node.style.animation = 'none';
            void node.offsetWidth;
            node.style.animation = '';
          });
      },
    };
  }
</script>
