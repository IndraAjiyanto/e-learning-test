{{!--
  Komponen: Voucher Form State (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/voucher/form.hbs
  Level: L0 Skrip pendamping (scoped super_admin)

  Factory Alpine `voucherForm()` untuk super_admin/voucher/{create,edit}.hbs.

  Menyediakan: formData, formErrors, validateField(), touch() (form/text_field,
  form/select_field); loading (form/button); typeOptions & activeOptions
  (form/select_field); courseOptions, userOptions, initialCourses, initialUsers
  (form/multi_select_field).

  `active` disimpan sebagai string 'true'/'false' karena select_field
  membandingkan nilai dengan === dan mengirimkannya lewat hidden input;
  VoucherService.parseBool sudah menerima bentuk string itu.

  `percent` hanya divalidasi saat type === 'discount' — sejalan dengan service
  yang menyimpannya null untuk voucher free.

  Tidak merender markup apa pun — panggil sekali di halaman yang memakainya.
--}}
<script>
  (() => {
    const LABEL = {
      code_voucher: 'Voucher Code',
      type: 'Type',
      percent: 'Discount Percent',
      active: 'Status',
    };

    // Urutan ini juga urutan fokus saat submit gagal.
    const PATHS = ['code_voucher', 'type', 'percent', 'active'];

    // Id yang dipasang select_field pada trigger-nya berbeda dari id field.
    const FOCUS_ID = { type: 'type-trigger', active: 'active-trigger' };

    const errorFor = (field, value, formData) => {
      const val = (value ?? '').toString().trim();

      if (field === 'percent') {
        // Tidak relevan untuk voucher free, jadi tidak pernah jadi error.
        if (formData.type !== 'discount') return '';
        if (!val) return `${LABEL.percent} is required.`;
        const n = Number(val);
        if (!Number.isFinite(n)) return `${LABEL.percent} must be a number.`;
        if (n <= 0 || n > 100) return `${LABEL.percent} must be between 1 and 100.`;
        return '';
      }

      if (!val) return `${LABEL[field]} is required.`;

      if (field === 'code_voucher' && val.length < 3) {
        return `${LABEL.code_voucher} must be at least 3 characters.`;
      }

      return '';
    };

    window.voucherForm = function voucherForm({
      code_voucher,
      type,
      percent,
      active,
      courses,
      users,
      selectedCourseIds,
      selectedUserIds,
      excludeId,
    } = {}) {
      // Endpoint cek kode (VoucherController.checkCode). Dipanggil saat kode
      // diketik supaya konflik terlihat SEBELUM tombol Create/Edit ditekan.
      // `excludeId` diisi halaman edit agar voucher tidak bentrok dengan dirinya.
      const CODE_API = '/voucher/check-code';
      let codeCheckTimer = null;

      const courseOptions = (courses || []).map((c) => ({
        value: c.id,
        label: c.name,
      }));
      const userOptions = (users || []).map((u) => ({
        value: u.id,
        label: u.email ? `${u.username} (${u.email})` : u.username,
      }));

      // Menerima dua bentuk: array id ('allowed_user_ids' memang array string)
      // dan array entity ('voucher.courses' datang sebagai objek Course utuh),
      // supaya halaman edit tidak perlu memetakannya lebih dulu di template.
      const preselect = (options, selected) => {
        const chosen = new Set(
          (selected || []).map((item) =>
            String(item && typeof item === 'object' ? item.id : item),
          ),
        );
        return options.filter((option) => chosen.has(String(option.value)));
      };

      return {
        loading: false,

        typeOptions: [
          { value: 'free', label: 'Free' },
          { value: 'discount', label: 'Discount' },
        ],
        activeOptions: [
          { value: 'true', label: 'Active', dot: 'bg-[#22c55e]' },
          { value: 'false', label: 'Inactive', dot: 'bg-[#718096]' },
        ],

        courseOptions,
        userOptions,
        initialCourses: preselect(courseOptions, selectedCourseIds),
        initialUsers: preselect(userOptions, selectedUserIds),

        formData: {
          code_voucher: code_voucher || '',
          type: type || '',
          percent: percent == null ? '' : String(percent),
          // Voucher baru default aktif, sama seperti default kolom di database.
          active: active == null ? 'true' : String(active),
        },
        formErrors: { code_voucher: '', type: '', percent: '', active: '' },
        touched: { code_voucher: false, type: false, percent: false, active: false },

        // Hasil cek kode dari server. `codeTaken` menandai kode sudah dipakai
        // voucher lain; `codeChecking` aktif selama cek berjalan (debounce/fetch).
        codeChecking: false,
        codeTaken: false,
        checkedCode: '',
        // Nomor urut cek: hasil fetch yang usang (kode berubah saat menunggu)
        // dibuang agar pesan error tidak menempel pada kode yang salah.
        codeCheckSeq: 0,

        // Gabungan error lokal (required/panjang) dan error hasil cek server.
        fieldError(path) {
          const local = errorFor(path, this.formData[path], this.formData);
          if (local) return local;
          const currentCode = (this.formData.code_voucher ?? '').toString().trim();
          if (
            path === 'code_voucher' &&
            this.codeTaken &&
            currentCode.toLowerCase() === (this.checkedCode || '').toLowerCase()
          ) {
            return `${LABEL.code_voucher} is already in use and must be unique.`;
          }
          return '';
        },

        // Simpan pesan error kode sesuai keadaan: error lokal selalu tampil
        // (bila sudah disentuh), error "sudah dipakai" tampil tanpa perlu blur.
        syncCodeError() {
          this.formErrors.code_voucher =
            this.touched.code_voucher || this.codeTaken
              ? this.fieldError('code_voucher')
              : '';
        },

        // Panggil server setelah jeda singkat supaya tidak menembak tiap ketikan.
        scheduleCodeCheck() {
          if (codeCheckTimer) clearTimeout(codeCheckTimer);
          const code = (this.formData.code_voucher ?? '').toString().trim();
          if (!code) {
            this.codeChecking = false;
            this.codeTaken = false;
            this.checkedCode = '';
            this.syncCodeError();
            return;
          }
          this.codeChecking = true;
          codeCheckTimer = setTimeout(() => this.runCodeCheck(), 400);
        },

        async runCodeCheck() {
          const code = (this.formData.code_voucher ?? '').toString().trim();
          if (!code) {
            this.codeChecking = false;
            this.codeTaken = false;
            this.checkedCode = '';
            this.syncCodeError();
            return;
          }
          const seq = ++this.codeCheckSeq;
          try {
            const params = new URLSearchParams({ code });
            if (excludeId) params.set('excludeId', excludeId);
            const res = await fetch(`${CODE_API}?${params.toString()}`, {
              headers: { Accept: 'application/json' },
            });
            if (!res.ok) throw new Error('check failed');
            const data = await res.json();
            if (seq !== this.codeCheckSeq) return;
            this.checkedCode = code;
            this.codeTaken = !!(data && data.available === false);
            // Jaringan gagal: jangan menghalangi; pengecekan di server (create/
            // update) tetap menjadi jaring pengaman terakhir.
            if (seq !== this.codeCheckSeq) return;
            this.codeTaken = false;
          } finally {
            if (seq === this.codeCheckSeq) {
              this.codeChecking = false;
              this.syncCodeError();
            }
          }
        },

        // Dipakai saat submit: jalankan cek tanpa menunggu debounce dan laporkan
        // apakah kode boleh dipakai.
        async ensureCodeAvailable() {
          if (codeCheckTimer) clearTimeout(codeCheckTimer);
          const code = (this.formData.code_voucher ?? '').toString().trim();
          if (!code) return true;
          await this.runCodeCheck();
          return !this.codeTaken;
        },

        validateField(path, value) {
          this.formData[path] = value ?? '';
          if (path === 'code_voucher') {
            this.syncCodeError();
            this.scheduleCodeCheck();
          } else {
            this.formErrors[path] = this.touched[path]
              ? errorFor(path, this.formData[path], this.formData)
              : '';
          }

          // Berganti tipe mengubah apakah percent wajib, jadi errornya dihitung ulang.
          if (path === 'type') {
            this.formErrors.percent = this.touched.percent
              ? errorFor('percent', this.formData.percent, this.formData)
              : '';
          }
        },

        touch(path) {
          if (!(path in this.touched)) return;
          this.touched[path] = true;
          this.validateField(path, this.formData[path]);
        },

        validateAll() {
          PATHS.forEach((path) => this.touch(path));
        },

        // Gating tombol simpan: form siap bila semua field wajib lolos errorFor,
        // terlepas dari sudah disentuh atau belum. Sengaja bukan hasFormErrors(),
        // yang hanya melihat error yang sudah diungkap `touched` sehingga form
        // kosong yang belum disentuh justru terbaca "tanpa error".
        canSubmit() {
          return (
            PATHS.every(
              (path) => errorFor(path, this.formData[path], this.formData) === '',
            ) &&
            !this.codeChecking &&
            !this.codeTaken
          );
        },

        hasFormErrors() {
          return (
            this.codeTaken ||
            PATHS.some((path) => this.formErrors[path] !== '')
          );
        },

        revealFirstInvalid() {
          const path = PATHS.find((p) => this.formErrors[p]);
          if (!path) return;

          this.$nextTick(() => {
            const el = document.getElementById(FOCUS_ID[path] || path);
            if (!el) {
              console.warn(`voucherForm: field "${path}" tidak ditemukan — id di form/voucher/fields berubah?`);
              return;
            }
            el.focus();
          });
        },

        // Tombol submit tidak pernah disabled; validasi dijalankan di sini.
        async submitForm(event) {
          const form = event.target;
          this.validateAll();

          // Pastikan kode sudah dicek server sebelum benar-benar submit.
          const codeOk = await this.ensureCodeAvailable();
          this.syncCodeError();

          if (!codeOk || this.hasFormErrors()) {
            this.revealFirstInvalid();
            return;
          }

          this.loading = true;
          form.submit();
        },
      };
    };
  })();
</script>
