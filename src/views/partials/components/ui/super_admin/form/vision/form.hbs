{{!--
  Komponen: Vision Form State (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/vision/form.hbs
  Level: L0 Skrip pendamping (scoped super_admin)

  Factory Alpine `visionForm()` untuk super_admin/visions/{create,edit}.hbs.

  Menyediakan: formData, formErrors, validateField(), touch() (form/text_field);
  loading (form/button); visionsLang (tabs/language lewat prop `state`).

  Submit yang gagal memindahkan tab ke bahasa yang error agar pesannya terlihat.

  Tidak merender markup apa pun — panggil sekali di halaman yang memakainya.
--}}
<script>
  (() => {
    const LANGS = ['id', 'en', 'ja'];
    const LANG_LABEL = { id: 'Indonesian', en: 'English', ja: 'Japanese' };
    const MIN = 10;

    // Urutan ini juga urutan fokus saat submit gagal.
    const PATHS = LANGS.map((l) => `visions.${l}`);
    const byLang = (valueFor) => Object.fromEntries(LANGS.map((l) => [l, valueFor(l)]));

    const read = (obj, path) => obj.visions[path.split('.')[1]];
    const write = (obj, path, value) => { obj.visions[path.split('.')[1]] = value; };

    const errorFor = (path, value) => {
      const lang = path.split('.')[1];
      const val = (value ?? '').toString().trim();
      const label = `Vision (${LANG_LABEL[lang]})`;
      if (!val) return `${label} is required.`;
      if (val.length < MIN) return `${label} must be at least ${MIN} characters.`;
      return '';
    };

    window.visionForm = function visionForm({ visions } = {}) {
      // Kolom jsonb nullable: data lama bisa belum punya salah satu bahasa.
      const initial = (src) => byLang((l) => (src && src[l]) || '');

      return {
        loading: false,
        visionsLang: 'id',

        formData: { visions: initial(visions) },
        formErrors: { visions: byLang(() => '') },
        // Error baru muncul setelah field disentuh atau setelah submit ditekan.
        touched: { visions: byLang(() => false) },

        validateField(path, value) {
          write(this.formData, path, value ?? '');
          write(
            this.formErrors,
            path,
            read(this.touched, path) ? errorFor(path, read(this.formData, path)) : '',
          );
        },

        touch(path) {
          write(this.touched, path, true);
          this.validateField(path, read(this.formData, path));
        },

        validateAll() {
          PATHS.forEach((path) => this.touch(path));
        },

        hasFormErrors() {
          return PATHS.some((path) => read(this.formErrors, path) !== '');
        },

        // Id harus sama dengan yang dibentuk form/vision/fields (`visions-id`, ...).
        revealFirstInvalid() {
          const path = PATHS.find((p) => read(this.formErrors, p));
          if (!path) return;

          const lang = path.split('.')[1];
          this.visionsLang = lang;
          this.$nextTick(() => {
            const el = document.getElementById(`visions-${lang}`);
            if (!el) {
              console.warn(`visionForm: field "visions-${lang}" tidak ditemukan — id di form/vision/fields berubah?`);
              return;
            }
            el.focus();
          });
        },

        // Tombol submit tidak pernah disabled; validasi dijalankan di sini.
        submitForm(event) {
          this.validateAll();
          if (this.hasFormErrors()) {
            this.revealFirstInvalid();
            return;
          }

          this.loading = true;
          event.target.submit();
        },
      };
    };
  })();
</script>
