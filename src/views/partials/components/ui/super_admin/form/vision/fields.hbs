{{!--
  Komponen: Vision Form Fields (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/vision/fields.hbs
  Level: L2 Blok field (scoped super_admin)

  Satu kartu tanpa header bernomor, mengikuti bentuk yang sudah terverifikasi
  di frame Figma Teknologi dan Program Type. Baris tombol ikut di dalam kartu
  lewat partial block.

  Visi hanya punya satu field, `visions`, dan isinya multibahasa (kolom jsonb
  { id, en, ja } — lihat catatan di entities/visions.entity.ts). Ketiga bahasa
  tetap di DOM (x-show, bukan x-if) supaya nilainya ikut terkirim meski tabnya
  tidak aktif; x-cloak mencegah ketiganya sempat tampil bertumpuk sebelum
  Alpine (defer) jalan. Id field `visions-{kodeBahasa}` dipakai
  form/vision/form untuk fokus ke field yang error — jangan diubah sepihak.

  Dipanggil oleh super_admin/visions/{create,edit}.hbs; pemanggil menyediakan
  state Alpine dari form/vision/form.
--}}
{{#*inline 'visionLangPanel'}}
  <div x-show="visionsLang === '{{code}}'" x-cloak>
    {{> components/ui/super_admin/form/text_field
      id=(concat 'visions-' code)
      name=(concat 'visions[' code ']')
      field=(concat 'visions.' code)
      label=(concat 'Vision (' langName ')')
      hideLabel=true
      multiline=true
      rows=6
      placeholder='Enter the vision statement...'
    }}
  </div>
{{/inline}}

<div class='flex flex-col gap-5 rounded-xl border border-[#d9d9d9] bg-white p-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-5'>
  <div class='flex flex-col gap-2'>
    <span class='font-inter text-sm font-medium leading-5 text-[#404040]'>Vision<span class='text-[#dc2626]'>*</span></span>

    <div class='flex flex-col gap-2'>
      {{> components/ui/super_admin/tabs/language/index
        state='visionsLang'
        ariaLabel='Vision language'
      }}

      {{> visionLangPanel code='id' langName='Indonesian' }}
      {{> visionLangPanel code='en' langName='English' }}
      {{> visionLangPanel code='ja' langName='Japanese' }}
    </div>

    <p class='font-inter text-sm leading-5 text-[#525252]'>
      Shown in the Vision &amp; Mission section on the public About page.
    </p>
  </div>

  {{#if @partial-block}}
    <div class='pt-2'>
      {{> @partial-block}}
    </div>
  {{/if}}
</div>
