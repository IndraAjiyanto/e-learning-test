{{!--
  Komponen: Benefit Form Fields (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/benefit/fields.hbs
  Level: L2 Blok field (scoped super_admin)

  Kartu 01 Icon Information, 02 Benefit Information, 03 Information Display.
  Dipanggil oleh super_admin/benefit/{create,edit}.hbs dan
  super_admin/benefit_category/create.hbs; pemanggil menyediakan state Alpine
  dari form/benefit/form.

  Props:
  - hideOrder : boolean (opsional) — tanpa kartu 03; pasangkan dengan
                benefitForm({ withOrder: false })

  Partial block (opsional) dirender di akhir kartu 03 — Edit menaruh tombol
  aksinya di sana, sedangkan Create memakai kartu aksi terpisah.

  Ketiga bahasa tetap di DOM (x-show, bukan x-if) supaya nilainya ikut terkirim
  meski tab-nya tidak aktif; x-cloak mencegah ketiganya sempat tampil bertumpuk
  sebelum Alpine (defer) jalan. Id field `{field}-{kodeBahasa}` dipakai
  form/benefit/form untuk fokus ke field yang error — jangan diubah sepihak.
--}}
{{#*inline 'benefitCardHeader'}}
  <div class='flex items-center gap-2'>
    <span class='flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#003060] font-montserrat text-base font-semibold leading-6 text-white'>{{number}}</span>
    <h2 class='font-montserrat text-base font-semibold leading-6 text-[#003060]'>{{title}}</h2>
  </div>
{{/inline}}

{{#*inline 'benefitLangPanel'}}
  <div x-show="{{field}}Lang === '{{code}}'" x-cloak>
    {{> components/ui/super_admin/form/text_field
      id=(concat field '-' code)
      name=(concat field '[' code ']')
      field=(concat field '.' code)
      label=(concat label ' (' langName ')')
      hideLabel=true
      multiline=true
      placeholder=placeholder
      required=true
    }}
  </div>
{{/inline}}

{{#*inline 'benefitLangField'}}
  <div class='flex flex-col gap-2'>
    <span class='font-inter text-sm font-medium leading-5 text-[#404040]'>{{label}}<span class='text-[#dc2626]'>*</span></span>

    <div class='flex flex-col gap-4'>
      {{> components/ui/super_admin/tabs/language/index
        state=(concat field 'Lang')
        short=true
        ariaLabel=(concat label ' language')
      }}

      {{> benefitLangPanel code='id' langName='Indonesian' }}
      {{> benefitLangPanel code='en' langName='English' }}
      {{> benefitLangPanel code='ja' langName='Japanese' }}
    </div>
  </div>
{{/inline}}

<div class='flex flex-col gap-3.5'>
  <section class='flex flex-col gap-6 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:p-5'>
    {{> benefitCardHeader number='01' title='Icon Information' }}

    <div class='flex items-center gap-1'>
      <div class='min-w-0 flex-1'>
        {{> components/ui/super_admin/form/text_field
          id='icon'
          name='icon'
          field='icon'
          label='Icon'
          placeholder='fa-home, fa-layer-group, etc'
          hint='Enter a Font Awesome class, such as fa-code or fas fa-code.'
          required=true
        }}
      </div>

      {{!-- Pratinjau langsung dari kelas yang diketik --}}
      <div class='flex shrink-0 items-center' aria-hidden='true'>
        <span class='flex h-8 w-8 box-content items-center justify-center px-3 py-4 text-[26px] text-[#525252]'>
          <i :class='iconClass'></i>
        </span>
        <span
          class='hidden max-w-[160px] break-all px-2 py-4 font-inter text-sm leading-5 text-[#525252] sm:block'
          x-text='formData.icon.trim()'
        ></span>
      </div>
    </div>
  </section>

  <section class='flex flex-col gap-6 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:p-5'>
    {{> benefitCardHeader number='02' title='Benefit Information' }}

    {{> benefitLangField field='title' label='Title' placeholder='Enter a title...' }}

    {{> benefitLangField field='description' label='Description' placeholder='Enter a description...' }}
  </section>

  {{#unless hideOrder}}
  <section class='flex flex-col gap-6 rounded-xl border border-[#d9d9d9] bg-white p-4 sm:p-5'>
    {{> benefitCardHeader number='03' title='Information Display' }}

    {{> components/ui/super_admin/form/select_field
      id='no'
      name='no'
      field='no'
      label='Display Order'
      placeholder='Select a number'
      options='noOptions'
      required=true
    }}

    {{#if @partial-block}}
      <div class='pt-6'>
        {{> @partial-block}}
      </div>
    {{/if}}
  </section>
  {{/unless}}
</div>
