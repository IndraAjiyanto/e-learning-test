{{!--
  Komponen: Team Form Fields (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/team/fields.hbs
  Level: L2 Blok field (scoped super_admin)

  Foto profil, lalu Name / LinkedIn / Instagram, lalu Position & Description
  per bahasa. Tidak menerima props; pemanggil menyediakan state Alpine dari
  form/team/form.

  Field per bahasa dikirim sebagai position[id]/position[en]/position[ja]
  (idem description) — bentuk yang dibaca halaman publik lewat getByLang.

  Ketiga bahasa tetap di DOM (x-show, bukan x-if) supaya nilainya ikut terkirim
  meski tab-nya tidak aktif.

  Id field dibentuk `{namaField}-{kodeBahasa}` (mis. `position-id`) — dipakai
  form/team/form untuk memfokuskan field pertama yang error.

  Foto di-crop 1:1 lebih dulu lewat form/crop_modal, mengikuti avatar bulat
  yang dipakai halaman publik.
--}}
{{#*inline 'teamLangFields'}}
  <div x-show="lang === '{{code}}'" x-cloak class='flex flex-col gap-5'>
    {{> components/ui/super_admin/form/text_field
      id=(concat 'position-' code)
      name=(concat 'position[' code ']')
      field=(concat 'position.' code)
      label='Position'
      placeholder=positionHint
      required=true
    }}

    {{> components/ui/super_admin/form/text_field
      id=(concat 'description-' code)
      name=(concat 'description[' code ']')
      field=(concat 'description.' code)
      label='Description'
      multiline=true
      placeholder=descriptionHint
    }}
  </div>
{{/inline}}

<div class='flex flex-col gap-5'>
  {{> components/ui/super_admin/form/photo_upload
    id='profile'
    name='profile'
    label='Profile Photo'
    meta='JPG or PNG · Max 5 MB'
    action='Upload Photo'
    crop=true
  }}

  <div class='grid grid-cols-1 gap-5 sm:grid-cols-2'>
    {{> components/ui/super_admin/form/text_field
      id='name'
      name='name'
      field='name'
      label='Name'
      placeholder='Full name'
      required=true
    }}

    {{> components/ui/super_admin/form/text_field
      id='linkedin'
      name='linkedin'
      field='linkedin'
      type='url'
      icon='link'
      label='LinkedIn URL'
      placeholder='https://linkedin.com/in/username'
      required=true
    }}

    {{> components/ui/super_admin/form/text_field
      id='instagram'
      name='instagram'
      field='instagram'
      type='url'
      icon='link'
      label='Instagram URL'
      placeholder='https://instagram.com/username'
      hint='Optional.'
    }}
  </div>

  {{> components/ui/super_admin/tabs/language/index ariaLabel='Team language' }}

  {{> teamLangFields
    code='id'
    positionHint='Jabatan (ID)'
    descriptionHint='Deskripsi singkat (ID)...'
  }}

  {{> teamLangFields
    code='en'
    positionHint='Position (EN)'
    descriptionHint='Short description (EN)...'
  }}

  {{> teamLangFields
    code='ja'
    positionHint='役職 (JA)'
    descriptionHint='簡単な説明 (JA)...'
  }}
</div>
