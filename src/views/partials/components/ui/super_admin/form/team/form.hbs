{{!--
  Komponen: Team Form State (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/team/form.hbs
  Level: L0 Skrip pendamping (scoped super_admin)

  Factory Alpine `teamForm({ team })` untuk super_admin/team/{create,edit}.hbs.
  `team` hanya diisi di Edit: field terisi dari data tersimpan dan foto baru
  jadi opsional karena foto lama tetap dipakai bila tidak diganti.

  `position` dan `description` disimpan per bahasa { id, en, ja } dan dikirim
  sebagai position[id] dst. — bentuk yang dibaca halaman publik lewat getByLang.
  (Entity menyebut string[], tapi tidak ada ValidationPipe global yang memaksanya.)

  Menyediakan: formData, formErrors, validateField(), touch() (form/text_field);
  previewUrl, errorMessage, isValid, hasFile, fileName, validateImage(),
  clearFile() (form/photo_upload); loading (form/button); lang (tabs/language).

  `lang` ikut di factory ini agar submit yang gagal bisa memindahkan tab ke
  bahasa yang error — kalau tidak, pesan errornya tersembunyi di tab lain.

  Tidak merender markup apa pun — panggil sekali di halaman yang memakainya.
--}}
<script>
  (() => {
    const LANGS = ['id', 'en', 'ja'];
    const LANG_FIELDS = ['position', 'description'];
    const LANG_LABEL = { id: 'Indonesian', en: 'English', ja: 'Japanese' };

    // Hanya LinkedIn dan position yang wajib; instagram dan description opsional,
    // sama seperti form lama. Instagram yang diisi tetap harus berupa URL valid.
    const LINKEDIN_PATTERN = /^https?:\/\/(www\.)?linkedin\.com\/.+/;
    const INSTAGRAM_PATTERN = /^https?:\/\/(www\.)?instagram\.com\/[A-Za-z0-9._]+\/?(\?.*)?$/;

    const byLang = (valueFor) => Object.fromEntries(LANGS.map((l) => [l, valueFor(l)]));

    // `path` berbentuk 'position.id' untuk field multibahasa, atau 'name'.
    const splitPath = (path) => {
      const [field, lang] = path.split('.');
      return { field, lang };
    };

    const errorFor = (field, lang, value) => {
      const val = (value ?? '').toString().trim();

      switch (field) {
        case 'name':
          if (!val) return 'Name is required.';
          if (val.length < 2) return 'Name must be at least 2 characters.';
          return '';

        case 'position': {
          const label = `Position (${LANG_LABEL[lang]})`;
          if (!val) return `${label} is required.`;
          if (val.length < 2) return `${label} must be at least 2 characters.`;
          return '';
        }

        case 'linkedin':
          if (!val) return 'LinkedIn URL is required.';
          if (!LINKEDIN_PATTERN.test(val)) return 'Please enter a valid LinkedIn URL.';
          return '';

        case 'instagram':
          if (val && !INSTAGRAM_PATTERN.test(val)) return 'Please enter a valid Instagram URL.';
          return '';

        default:
          return '';
      }
    };

    window.teamForm = function teamForm({ team } = {}) {
      const saved = (field) => byLang((l) => team?.[field]?.[l] ?? '');

      return {
        loading: false,
        lang: 'id',

        // Foto profil
        originalUrl: team?.profile || '',
        previewUrl: team?.profile || null,
        objectUrl: null,
        errorMessage: '',
        isValid: true,
        fileName: '',
        hasFile: false,

        formData: {
          name: team?.name ?? '',
          linkedin: team?.linkedin ?? '',
          instagram: team?.instagram ?? '',
          position: saved('position'),
          description: saved('description'),
        },
        formErrors: {
          name: '',
          linkedin: '',
          instagram: '',
          position: byLang(() => ''),
          description: byLang(() => ''),
        },
        // Error baru muncul setelah field disentuh atau setelah submit ditekan.
        touched: {
          name: false,
          linkedin: false,
          instagram: false,
          position: byLang(() => false),
          description: byLang(() => false),
        },

        validateField(path, value) {
          const { field, lang } = splitPath(path);
          if (!lang) {
            this.formData[field] = value ?? '';
            this.formErrors[field] = this.touched[field]
              ? errorFor(field, null, this.formData[field])
              : '';
            return;
          }

          this.formData[field][lang] = value ?? '';
          this.formErrors[field][lang] = this.touched[field][lang]
            ? errorFor(field, lang, this.formData[field][lang])
            : '';
        },

        touch(path) {
          const { field, lang } = splitPath(path);
          if (!lang) {
            this.touched[field] = true;
            this.validateField(path, this.formData[field]);
            return;
          }

          this.touched[field][lang] = true;
          this.validateField(path, this.formData[field][lang]);
        },

        // Batas mengikuti kontrak backend (ValidateImage pada TeamController):
        // JPEG/JPG/PNG, maks 5 MB.
        validateImage(file) {
          this.clearPreview();

          if (!file) return;

          this.hasFile = true;
          this.fileName = file.name;

          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!allowedTypes.includes(file.type)) {
            this.setImageError('Only JPEG, JPG, and PNG formats are allowed');
            return;
          }

          const maxSize = 5 * 1024 * 1024;
          if (file.size > maxSize) {
            this.setImageError(
              `File size too large (${(file.size / 1024 / 1024).toFixed(2)} MB). Maximum 5 MB`,
            );
            return;
          }

          this.objectUrl = URL.createObjectURL(file);
          this.previewUrl = this.objectUrl;
          this.isValid = true;
          this.errorMessage = '';
        },

        // Berkas ditolak dikosongkan dari input agar tidak ikut terkirim;
        // di Edit pratinjau kembali ke foto tersimpan.
        setImageError(message) {
          this.clearPreview();
          this.errorMessage = message;
          this.isValid = false;
          if (this.$refs.fileInput) this.$refs.fileInput.value = null;
        },

        clearPreview() {
          if (this.objectUrl) URL.revokeObjectURL(this.objectUrl);
          this.objectUrl = null;
          this.previewUrl = this.originalUrl || null;
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '';
          this.hasFile = false;
        },

        clearFile() {
          this.clearPreview();
          this.$refs.fileInput.value = null;
        },

        validateAll() {
          ['name', 'linkedin', 'instagram'].forEach((field) => {
            this.touched[field] = true;
            this.formErrors[field] = errorFor(field, null, this.formData[field]);
          });

          LANG_FIELDS.forEach((field) =>
            LANGS.forEach((lang) => {
              this.touched[field][lang] = true;
              this.formErrors[field][lang] = errorFor(field, lang, this.formData[field][lang]);
            }),
          );
        },

        hasFormErrors() {
          return (
            this.formErrors.name !== '' ||
            this.formErrors.linkedin !== '' ||
            this.formErrors.instagram !== '' ||
            LANG_FIELDS.some((field) => LANGS.some((lang) => this.formErrors[field][lang] !== ''))
          );
        },

        // Foto tidak wajib di sini, sama seperti form lama: yang dicek hanya
        // berkas yang dipilih tapi ditolak (isValid=false).
        // Dihitung ulang dari nilai formData, bukan dari hasFormErrors(): formErrors
        // hanya terisi untuk field yang sudah disentuh, sehingga form kosong yang
        // belum disentuh akan terbaca "tanpa error" dan tombol ikut menyala.
        // Team.profile adalah kolom NOT NULL, jadi create tanpa foto pasti gagal
        // di database — dulu tombolnya tetap bisa diklik dan user hanya melihat
        // toast error (TC-049). Di halaman edit foto lama tetap dipakai bila
        // tidak diunggah ulang, jadi syaratnya dilonggarkan di sana.
        photoOk() {
          return this.originalUrl
            ? !this.hasFile || this.isValid
            : this.hasFile && this.isValid;
        },

        canSubmit() {
          const plainOk = ['name', 'linkedin', 'instagram'].every(
            (field) => errorFor(field, null, this.formData[field]) === '',
          );
          const langOk = LANG_FIELDS.every((field) =>
            LANGS.every((lang) => errorFor(field, lang, this.formData[field][lang]) === ''),
          );

          return this.photoOk() && plainOk && langOk;
        },

        // Urutan mengikuti tampilan: foto, name, linkedin, instagram, lalu field per bahasa.
        // Id `${field}-${lang}` harus sama dengan yang dibentuk form/team/fields.
        revealFirstInvalid() {
          if (!this.isValid) {
            this.$refs.fileInput.parentElement.scrollIntoView({ block: 'center' });
            return;
          }

          for (const field of ['name', 'linkedin', 'instagram']) {
            if (!this.formErrors[field]) continue;
            document.getElementById(field)?.focus();
            return;
          }

          for (const lang of LANGS) {
            for (const field of LANG_FIELDS) {
              if (!this.formErrors[field][lang]) continue;

              this.lang = lang;
              this.$nextTick(() => {
                const el = document.getElementById(`${field}-${lang}`);
                if (!el) {
                  console.warn(`teamForm: field "${field}-${lang}" tidak ditemukan — id di form/team/fields berubah?`);
                  return;
                }
                el.focus();
              });
              return;
            }
          }
        },

        // Tombol submit tidak pernah disabled; validasi dijalankan di sini.
        submitForm(event) {
          this.validateAll();
          if (!this.canSubmit()) {
            this.revealFirstInvalid();
            return;
          }

          this.loading = true;
          event.target.submit();
        },
      };
    };
  })();
</script>
