{{!--
  Komponen: Course Flow Form State (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/course_flow/form.hbs
  Level: L0 Skrip pendamping (scoped super_admin)

  Factory Alpine `courseFlowForm()` untuk super_admin/course_flows/{create,edit}.hbs —
  keduanya memakai field, validasi, dan aturan submit yang sama.

  Menyediakan: formData, formErrors, validateField(), touch() (form/text_field dan
  form/select_field); loading (form/button); lang (tabs/language); courseOptions
  (form/select_field, hanya terisi bila halaman mengirim `courses`).

  `lang` sengaja ikut di factory ini, bukan x-data terpisah: submit yang gagal harus
  bisa memindahkan tab ke bahasa yang error, kalau tidak pesan errornya tersembunyi
  di balik tab lain dan form terlihat macet.

  Tidak merender markup apa pun — panggil sekali di halaman yang memakainya.
--}}
<script>
  (() => {
    const LANGS = ['id', 'en', 'ja'];
    const FIELDS = ['title', 'content'];
    const LANG_LABEL = { id: 'Indonesian', en: 'English', ja: 'Japanese' };
    const FIELD_LABEL = { title: 'Title', content: 'Description' };
    const MIN = { title: 3, content: 10 };

    const byLang = (valueFor) => Object.fromEntries(LANGS.map((l) => [l, valueFor(l)]));

    // `path` berbentuk 'title.id' untuk field multibahasa, atau 'kelas_id' untuk
    // field datar — dua bentuk yang dikirim form/text_field dan form/select_field.
    const splitPath = (path) => {
      const [field, lang] = path.split('.');
      return { field, lang };
    };

    // Ketiga bahasa wajib, di Create maupun Edit: flow tampil di situs publik dalam
    // tiga bahasa. Kolomnya nullable dan halaman lama membolehkan record tak lengkap,
    // jadi record warisan yang bahasanya kosong harus dilengkapi dulu sebelum bisa
    // disimpan di sini. Untuk melonggarkan, ubah errorFor — jangan validateAll,
    // karena itu ikut melonggarkan Create.
    const errorFor = (field, lang, value) => {
      const val = (value ?? '').toString().trim();

      if (field === 'kelas_id') return val ? '' : 'Program is required.';

      const label = FIELD_LABEL[field];
      if (!val) return `${label} (${LANG_LABEL[lang]}) is required.`;
      if (val.length < MIN[field]) {
        return `${label} (${LANG_LABEL[lang]}) must be at least ${MIN[field]} characters.`;
      }

      return '';
    };

    window.courseFlowForm = function courseFlowForm({ title, content, courses } = {}) {
      // Nilai awal dinormalkan: data lama bisa belum punya salah satu bahasa.
      const initial = (src) => byLang((l) => (src && src[l]) || '');

      // Select program hanya dirender oleh route tanpa :courseId; di route lain
      // program sudah ditentukan URL dan field ini tidak ikut divalidasi.
      const withCourse = Array.isArray(courses);

      return {
        loading: false,
        lang: 'id',

        courseOptions: (courses || []).map((c) => ({ value: c.id, label: c.name })),

        formData: { title: initial(title), content: initial(content), kelas_id: '' },
        formErrors: { title: byLang(() => ''), content: byLang(() => ''), kelas_id: '' },
        // Error baru muncul setelah field disentuh atau setelah submit ditekan.
        touched: { title: byLang(() => false), content: byLang(() => false), kelas_id: false },

        // Tiap entri: [field, lang]; lang null untuk field datar (kelas_id).
        // read/write menyembunyikan percabangan nested-vs-datar itu.
        entries() {
          const multilang = LANGS.flatMap((lang) => FIELDS.map((field) => [field, lang]));
          return withCourse ? [['kelas_id', null], ...multilang] : multilang;
        },

        read(target, field, lang) {
          return lang === null ? this[target][field] : this[target][field][lang];
        },

        write(target, field, lang, value) {
          if (lang === null) this[target][field] = value;
          else this[target][field][lang] = value;
        },

        validateField(path, value) {
          const { field, lang = null } = splitPath(path);
          this.write('formData', field, lang, value ?? '');
          this.write(
            'formErrors',
            field,
            lang,
            this.read('touched', field, lang)
              ? errorFor(field, lang, this.read('formData', field, lang))
              : '',
          );
        },

        touch(path) {
          const { field, lang = null } = splitPath(path);
          this.write('touched', field, lang, true);
          this.validateField(path, this.read('formData', field, lang));
        },

        validateAll() {
          this.entries().forEach(([field, lang]) => {
            this.write('touched', field, lang, true);
            this.write('formErrors', field, lang, errorFor(field, lang, this.read('formData', field, lang)));
          });
        },

        hasFormErrors() {
          return this.entries().some(([field, lang]) => this.read('formErrors', field, lang) !== '');
        },

        // Dihitung ulang dari nilai lewat errorFor(), BUKAN dari formErrors:
        // formErrors hanya terisi untuk field yang sudah disentuh, jadi form kosong
        // akan terbaca "tanpa error" dan tombolnya menyala sejak awal.
        // Lihat docs/form-submit-gating.md.
        canSubmit() {
          return this.entries().every(
            ([field, lang]) => errorFor(field, lang, this.read('formData', field, lang)) === '',
          );
        },

        // Field yang error bisa berada di tab bahasa lain — pindahkan tab dulu, baru
        // fokuskan, supaya pesan errornya benar-benar terlihat.
        //
        // Id `${field}-${lang}` harus sama dengan yang dibentuk form/course_flow/fields.
        // Ketidakcocokan dilaporkan ke console, bukan ditelan `?.`.
        revealFirstInvalid() {
          const invalid = this.entries().find(([field, lang]) => this.read('formErrors', field, lang));
          if (!invalid) return;

          const [field, lang] = invalid;
          if (lang !== null) this.lang = lang;

          this.$nextTick(() => {
            // Select program bukan input: yang bisa difokuskan tombol trigger-nya.
            const id = lang === null ? `${field}-trigger` : `${field}-${lang}`;
            const el = document.getElementById(id);
            if (!el) {
              console.warn(`courseFlowForm: field "${id}" tidak ditemukan — id di form/course_flow/fields berubah?`);
              return;
            }
            el.focus();
          });
        },

        // Tombol submit tidak pernah disabled; validasi dijalankan di sini.
        submitForm(event) {
          this.validateAll();
          if (this.hasFormErrors()) {
            this.revealFirstInvalid();
            return;
          }

          this.loading = true;
          event.target.submit();
        },
      };
    };
  })();
</script>
