{{!--
  Komponen: Icon Picker (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/icon_picker.hbs
  Level: L1 Atomik (scoped super_admin)

  Pengganti text_field untuk field ikon Font Awesome. Sebelumnya super admin
  harus hafal nama kelas (`fa-layer-group`); di sini nama kelas itu dicari
  lewat kata sehari-hari — mengetik "sampah" tidak, tapi "trash" menemukan
  fa-trash, fa-trash-can, dst. karena indeksnya ikut memuat search terms FA.

  SATU INPUT, DUA PERAN
  Input teksnya tetap field asli yang dikirim ke backend, sekaligus jadi kotak
  pencarian: mengetik apa pun membuka panel dan memfilter grid. Jadi entri
  manual (mis. menempel `fa-solid fa-code` dari dokumentasi FA) tetap jalan
  persis seperti sebelum ada picker — tidak ada perilaku lama yang hilang.
  Nilai yang belum lengkap pun aman karena helper toIconClass melengkapinya:
  "trash" -> "fa-solid fa-trash".

  KONTRAK PEMAKAIAN
  Pemanggil menyediakan state Alpine: formData, formErrors, validateField(),
  touch(), dan `iconClass` (getter pratinjau) — sama seperti text_field.

  Indeks ikon dimuat MALAS (fetch saat panel pertama kali dibuka), bukan
  di-inline ke halaman: asetnya ±232 KB (±69 KB gzip) dan halaman form tidak
  boleh ikut berat hanya karena field ini. Kalau fetch gagal, panel menampilkan
  pesan dan input tetap bisa diisi manual.

  Aset dibangun `npm run build:icons` (ikut `npm run build` & `start:dev`) dari
  metadata paket @fortawesome/fontawesome-free — lihat scripts/generate-icon-index.js.

  Props:
  - id          : string (wajib) — id field sekaligus target label
  - name        : string (wajib) — name yang dikirim ke backend
  - field       : string (wajib) — key state Alpine (formData/formErrors)
  - label       : string (wajib)
  - placeholder : string (opsional)
  - hint        : string (opsional) — disembunyikan saat ada error
  - required    : boolean (opsional)
--}}
<div class='flex flex-col gap-1.5' x-data="iconPicker('{{field}}')" @click.outside='close()' @keydown.escape.stop='close()'>
  <label
    for='{{id}}'
    class='font-inter text-sm font-medium leading-5 text-[#404040]'
  >{{label}}{{#if required}}<span class='text-[#dc2626]'>*</span>{{/if}}</label>

  <div class='relative'>
    {{!-- Pratinjau di dalam input: ikon yang sedang aktif selalu terlihat
         bersebelahan dengan nama kelasnya. --}}
    <span
      class='pointer-events-none absolute left-3.5 top-1/2 flex h-5 w-5 -translate-y-1/2 items-center justify-center text-base text-[#525252]'
      aria-hidden='true'
    >
      <i :class='iconClass'></i>
    </span>

    <input
      id='{{id}}'
      name='{{name}}'
      type='text'
      autocomplete='off'
      role='combobox'
      aria-expanded='false'
      :aria-expanded="open ? 'true' : 'false'"
      aria-controls='{{id}}-listbox'
      aria-autocomplete='list'
      {{#if required}}required{{/if}}
      placeholder='{{default placeholder "Search an icon — trash, user, code..."}}'
      x-model='formData.{{field}}'
      @focus='openPanel()'
      @input='onInput($event.target.value)'
      @blur='touch("{{field}}")'
      @keydown.arrow-down.prevent='openPanel()'
      :aria-invalid="formErrors.{{field}} ? 'true' : 'false'"
      :class="formErrors.{{field}}
        ? 'border-[#fca5a5] focus:border-[#ef4444] focus:ring-[#ef4444]/20'
        : 'border-[#d4d4d4] hover:border-[#a3a3a3] focus:border-[#003060] focus:ring-[#003060]/20'"
      class='h-11 w-full rounded-lg border bg-white py-2.5 pl-11 pr-11 font-inter text-base leading-6 text-[#171717] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors placeholder:text-[#737373] focus:outline-none focus:ring-2'
    />

    <button
      type='button'
      @click='toggle()'
      :aria-label="open ? 'Hide icon list' : 'Browse icons'"
      class='absolute right-3.5 top-1/2 flex h-5 w-5 -translate-y-1/2 items-center justify-center rounded-sm text-[#737373] transition-colors hover:text-[#003060] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40'
    >
      {{!-- lucide: chevron-down --}}
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-4 w-4 transition-transform' :class="open && 'rotate-180'">
        <path d='m6 9 6 6 6-6' />
      </svg>
    </button>

    {{!-- Panel hasil pencarian --}}
    <div
      x-show='open'
      x-cloak
      id='{{id}}-listbox'
      role='listbox'
      class='absolute left-0 right-0 z-20 mt-1 overflow-hidden rounded-lg border border-[#d4d4d4] bg-white shadow-[0px_8px_8px_-4px_rgba(0,0,0,0.03),0px_20px_24px_-4px_rgba(0,0,0,0.08)]'
    >
      <div x-show='loading' class='px-3.5 py-6 text-center font-inter text-sm leading-5 text-[#a3a3a3]'>
        Loading icons...
      </div>

      <div x-show='loadError' x-cloak class='px-3.5 py-6 text-center font-inter text-sm leading-5 text-[#ef4444]'>
        Icon list failed to load. You can still type a Font Awesome class manually.
      </div>

      <template x-if='!loading && !loadError'>
        <div>
          <div
            x-show='results.length === 0'
            class='px-3.5 py-6 text-center font-inter text-sm leading-5 text-[#a3a3a3]'
          >
            No icon matches “<span x-text='query'></span>”.
          </div>

          <div
            x-show='results.length > 0'
            class='grid max-h-[268px] grid-cols-[repeat(auto-fill,minmax(84px,1fr))] gap-1 overflow-y-auto p-2'
          >
            <template x-for='item in results' :key='item.key'>
              <button
                type='button'
                role='option'
                :aria-selected="(formData.{{field}} || '').trim() === item.value"
                @click='choose(item)'
                :title='item.title'
                class='flex flex-col items-center gap-1.5 rounded-lg border border-transparent px-1 py-2.5 transition-colors hover:bg-[#f5f5f5] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40'
                :class="(formData.{{field}} || '').trim() === item.value && 'border-[#003060] bg-[#f0f6fb]'"
              >
                <i :class='item.value' class='text-xl text-[#525252]'></i>
                <span class='w-full truncate px-1 font-inter text-[11px] leading-4 text-[#737373]' x-text='item.name'></span>
              </button>
            </template>
          </div>

          <div
            x-show='results.length > 0'
            class='flex items-center justify-between gap-3 border-t border-[#e5e5e5] px-3.5 py-2 font-inter text-xs leading-[18px] text-[#a3a3a3]'
          >
            <span>
              <span x-text='results.length'></span> of <span x-text='matchCount'></span> shown
            </span>
            <span x-show='matchCount > results.length'>Keep typing to narrow it down</span>
          </div>
        </div>
      </template>
    </div>
  </div>

  <p
    x-show='formErrors.{{field}}'
    x-cloak
    x-text='formErrors.{{field}}'
    class='font-inter text-sm leading-5 text-[#ef4444]'
  ></p>

  {{#if hint}}
    <p
      x-show='!formErrors.{{field}}'
      class='font-inter text-sm leading-5 text-[#525252]'
    >{{hint}}</p>
  {{/if}}
</div>

<script>
  (() => {
    if (window.iconPicker) return;

    const INDEX_URL = '/public/assets/fa-icons.json';
    const STYLE_CLASS = { s: 'fa-solid', r: 'fa-regular', b: 'fa-brands' };
    const STYLE_LABEL = { s: 'Solid', r: 'Regular', b: 'Brands' };
    // Batas tile yang dirender. Tanpa ini pencarian kosong akan membuat Alpine
    // memasang >2000 node sekaligus dan panel terasa berat saat dibuka.
    const MAX_RESULTS = 60;

    // Dipakai bersama semua instance di halaman, dan hanya sekali per load.
    let cache = null;
    let inflight = null;

    function loadIndex() {
      if (cache) return Promise.resolve(cache);
      if (!inflight) {
        inflight = fetch(INDEX_URL)
          .then((res) => {
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            return res.json();
          })
          .then((rows) => {
            // Satu tile per pasangan (ikon, gaya): ikon yang punya versi solid
            // dan regular muncul dua kali, jadi pilihan gayanya kelihatan
            // langsung tanpa toggle tersembunyi.
            cache = [];
            for (const [name, label, styles, terms] of rows) {
              for (const code of styles) {
                const prefix = STYLE_CLASS[code];
                if (!prefix) continue;
                cache.push({
                  key: `${prefix} ${name}`,
                  value: `${prefix} fa-${name}`,
                  name,
                  label,
                  terms,
                  title: `${label} — ${STYLE_LABEL[code]} (${prefix} fa-${name})`,
                });
              }
            }
            return cache;
          })
          .finally(() => {
            inflight = null;
          });
      }
      return inflight;
    }

    // Skor kecil = lebih relevan. Mengurutkan begini membuat "user" menaruh
    // fa-user di depan fa-user-astronaut, bukan sebaliknya.
    function score(item, q) {
      if (item.name === q) return 0;
      if (item.name.startsWith(q)) return 1;
      if (item.name.includes(q)) return 2;
      if (item.label.toLowerCase().includes(q)) return 3;
      if (item.terms.some((t) => t.includes(q))) return 4;
      return -1;
    }

    // `field` dikirim pemanggil supaya komponen ini tidak terkunci ke nama
    // 'icon' — kontraknya sama dengan text_field.
    window.iconPicker = function iconPicker(field) {
      return {
        field,
        open: false,
        loading: false,
        loadError: false,
        query: '',
        results: [],
        matchCount: 0,

        openPanel() {
          this.open = true;
          this.ensureIndex();
        },

        toggle() {
          if (this.open) return this.close();
          this.openPanel();
        },

        close() {
          this.open = false;
        },

        ensureIndex() {
          if (cache) return this.search();
          this.loading = true;
          this.loadError = false;
          loadIndex()
            .then(() => {
              this.loading = false;
              this.search();
            })
            .catch((err) => {
              console.error('Icon index failed to load:', err);
              this.loading = false;
              this.loadError = true;
            });
        },

        onInput(value) {
          // Field ini juga field form, jadi validasi induk tetap dipanggil.
          this.validateField(this.field, value);
          this.openPanel();
          this.search();
        },

        search() {
          if (!cache) return;

          // Nilai tersimpan berbentuk kelas ("fa-solid fa-code"); yang berguna
          // sebagai kata kunci hanya nama ikonnya, jadi prefix gaya dibuang.
          //
          // Dua langkah, dan urutannya penting: kalau `fa` ikut dialternasikan
          // bersama prefix gaya, ia menggigit "fa" milik "fa-code" lebih dulu
          // dan menyisakan "-code" — pencarian jadi meleset untuk nilai yang
          // ditempel utuh dari dokumentasi FA. Prefix gaya dibuang dulu, baru
          // sisa "fa-" di AWAL token yang dipangkas; tanda hubung di tengah
          // nama ("trash-can") sengaja dibiarkan supaya tetap cocok.
          const raw = (this.formData[this.field] || '').toString().toLowerCase().trim();
          const q = raw
            .replace(
              /\b(fa-solid|fa-regular|fa-brands|fa-light|fa-thin|fa-duotone|fas|far|fab)\b/g,
              ' ',
            )
            .trim()
            .replace(/^fa-/, '')
            .trim();

          this.query = raw;

          if (!q) {
            this.matchCount = cache.length;
            this.results = cache.slice(0, MAX_RESULTS);
            return;
          }

          const scored = [];
          for (const item of cache) {
            const s = score(item, q);
            if (s >= 0) scored.push([s, item]);
          }
          scored.sort((a, b) => a[0] - b[0] || a[1].name.length - b[1].name.length);

          this.matchCount = scored.length;
          this.results = scored.slice(0, MAX_RESULTS).map(([, item]) => item);
        },

        choose(item) {
          this.validateField(this.field, item.value);
          this.touch(this.field);
          this.close();
        },
      };
    };
  })();
</script>
