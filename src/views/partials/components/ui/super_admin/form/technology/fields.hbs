{{!--
  Komponen: Technology Form Fields (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/technology/fields.hbs
  Level: L2 Blok field (scoped super_admin)

  dan "Program/Edit Teknologi".

  SATU KARTU, BUKAN KARTU BERNOMOR
  Berbeda dari form/benefit/fields dan form/program_type/fields yang memakai
  kartu bernomor 01/02, Figma untuk Teknologi menaruh seluruh field dalam satu
  kartu tanpa header bernomor. Baris tombol ikut di dalam kartu yang sama, tanpa
  garis pemisah di atasnya.

  PEMILIH METODE = RADIO
  Dua metode logo (SVG Code / Upload Image) dipilih lewat radio, bukan toggle
  switch. Hanya satu panel field yang tampil sesuai `mode`. Perpindahan yang
  akan menghapus isi yang sudah ada tetap dikonfirmasi lewat modal.

  PRATINJAU SVG (prop `showPreview`)
  Bila true, blok SVG Code dibelah dua kolom — textarea di kiri, panel "Preview"
  di kanan. Dipakai halaman Create maupun Edit.

  Backend (TechnologiesController) menolak tech tanpa svg maupun imgUrl tetapi
  menerima salah satunya, jadi error gabungannya tetap ada sebagai jaring
  terakhir di bawah area upload.

  Input file-nya bernama `image` (bukan `imgUrl`): itu nama yang dibaca
  FileInterceptor, dan controller yang mengubahnya jadi imgUrl.

  Props:
  - showPreview : boolean (opsional) — render panel pratinjau SVG di samping
                  textarea (dipakai halaman create & edit)

  Dipanggil oleh super_admin/technologies/{create,edit}.hbs; pemanggil
  menyediakan state Alpine dari form/technology/form. Partial block dirender di
  akhir kartu sebagai baris aksi.
--}}
{{#*inline 'technologySvgField'}}
  {{> components/ui/super_admin/form/text_field
    id='svg'
    name='svg'
    field='svg'
    label='SVG Code'
    multiline=true
    rows=6
    heightClass='h-[147px]'
    placeholder='Enter a svg code...'
  }}
{{/inline}}

<div class='flex flex-col gap-5 rounded-xl border border-[#d9d9d9] bg-white p-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-5'>
  {{> components/ui/super_admin/form/text_field
    id='name'
    name='name'
    field='name'
    label='Tools Name'
    placeholder='Enter a tools name'
  }}

  <div class='flex flex-col gap-3.5'>
    <div class='flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between'>
      <div class='flex flex-col gap-1'>
        <h2 class='font-inter text-xl font-semibold leading-7 text-[#171717]'>Tools Logo</h2>
        <p class='font-inter text-sm leading-5 text-[#718096]'>
          Choose one logo method: SVG Code or Upload Image
        </p>
      </div>

      {{!-- Radio kustom: lingkaran digambar manual dan tercentang murni dari
           `mode` (bukan input natif), supaya tidak bentrok dengan state natif
           grup radio saat perpindahan dibatalkan lewat modal. --}}
      <fieldset class='flex flex-col gap-1'>
        <legend class='sr-only'>Tools logo method</legend>
        <div class='flex items-center gap-4' role='radiogroup' aria-label='Tools logo method'>
          <button
            type='button'
            role='radio'
            :aria-checked="mode === 'svg' ? 'true' : 'false'"
            @click='switchMode("svg")'
            class='flex cursor-pointer items-center gap-2 font-inter text-sm leading-5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40'
          >
            <span
              class='flex h-4 w-4 shrink-0 items-center justify-center rounded-full border transition-colors'
              :class="mode === 'svg' ? 'border-[#003060]' : 'border-[#a3a3a3]'"
            >
              <span
                class='h-2 w-2 rounded-full transition-colors'
                :class="mode === 'svg' ? 'bg-[#003060]' : 'bg-transparent'"
              ></span>
            </span>
            <span :class="mode === 'svg' ? 'font-semibold text-[#171717]' : 'font-medium text-[#718096]'">SVG Code</span>
          </button>

          <button
            type='button'
            role='radio'
            :aria-checked="mode === 'image' ? 'true' : 'false'"
            @click='switchMode("image")'
            class='flex cursor-pointer items-center gap-2 font-inter text-sm leading-5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40'
          >
            <span
              class='flex h-4 w-4 shrink-0 items-center justify-center rounded-full border transition-colors'
              :class="mode === 'image' ? 'border-[#003060]' : 'border-[#a3a3a3]'"
            >
              <span
                class='h-2 w-2 rounded-full transition-colors'
                :class="mode === 'image' ? 'bg-[#003060]' : 'bg-transparent'"
              ></span>
            </span>
            <span :class="mode === 'image' ? 'font-semibold text-[#171717]' : 'font-medium text-[#718096]'">Upload Image</span>
          </button>
        </div>
      </fieldset>
    </div>

    {{!-- Input SVG Code --}}
    <div x-show="mode === 'svg'" x-cloak>
      {{#if showPreview}}
        <div class='grid grid-cols-1 gap-5 lg:grid-cols-2'>
          {{> technologySvgField}}

          <div class='flex flex-col gap-1.5'>
            <span class='font-inter text-sm font-medium leading-5 text-[#404040]'>Preview</span>
            <div class='flex h-[147px] items-center justify-center rounded-lg border border-[#d4d4d4] bg-[#fafafa] p-4'>
              <template x-if='svgPreview()'>
                <span class='flex h-20 w-20 items-center justify-center [&>svg]:h-full [&>svg]:w-full' x-html='svgPreview()'></span>
              </template>
              <template x-if='!svgPreview()'>
                <span class='font-inter text-sm leading-5 text-[#a3a3a3]'>No SVG to preview</span>
              </template>
            </div>
          </div>
        </div>
      {{else}}
        {{> technologySvgField}}
      {{/if}}
    </div>

    {{!-- Input Upload Gambar --}}
    <div x-show="mode === 'image'" x-cloak>
      {{> components/ui/super_admin/form/image_dropzone
        id='image'
        name='image'
        label='Upload Image (Max 2MB)'
        meta='JPG / PNG / SVG · Max 2 MB'
        accept='image/jpeg,image/jpg,image/png,image/svg+xml'
        boxClass='h-[147px]'
      }}
    </div>

    {{!-- Nilai dibaca controller saat user menghapus gambar lama tanpa
         mengunggah pengganti atau saat beralih ke SVG. --}}
    <input type='hidden' name='remove_image' :value="mode === 'image' && previewUrl ? 'false' : 'true'" />

    {{!-- Pesan error validasi iconSource --}}
    <p
      x-show='formErrors.iconSource'
      x-cloak
      x-text='formErrors.iconSource'
      class='font-inter text-sm leading-5 text-[#ef4444]'
    ></p>
  </div>

  {{!-- Modal Konfirmasi Pergantian Mode Logo (Super Admin style) --}}
  <div
    x-show='confirmModal.open'
    x-cloak
    @keydown.escape.window='if (confirmModal.open) cancelSwitchMode()'
    class='fixed inset-0 z-50 flex items-center justify-center bg-[#0a0a0a]/70 p-4 backdrop-blur-[16px]'
    @click.self='cancelSwitchMode()'
  >
    <div
      role='dialog'
      aria-modal='true'
      class='flex w-full max-w-[400px] flex-col gap-8 rounded-xl bg-white p-6 shadow-[0px_8px_8px_-4px_rgba(0,0,0,0.03),0px_20px_24px_-4px_rgba(0,0,0,0.08)]'
    >
      <div class='flex flex-col items-center gap-5'>
        <span
          class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-8 border-[#FEF2F2] bg-[#FEE2E2]'
        >
          <svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#DC2626' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-6 w-6'>
            <circle cx='12' cy='12' r='10'></circle>
            <line x1='12' y1='8' x2='12' y2='12'></line>
            <line x1='12' y1='16' x2='12.01' y2='16'></line>
          </svg>
        </span>

        <div class='flex flex-col items-center gap-2'>
          <h2
            class='text-center font-inter text-lg font-semibold leading-7 text-[#171717]'
            x-text='confirmModal.title'
          ></h2>

          <p
            class='text-center font-inter text-sm font-normal leading-5 text-[#525252]'
            x-text='confirmModal.description'
          ></p>
        </div>
      </div>

      <div class='flex items-start gap-3'>
        <button
          type='button'
          @click='cancelSwitchMode()'
          class='inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-[#d4d4d4] bg-white px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-[#404040] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#a3a3a3] hover:bg-[#f5f5f5] active:bg-[#ededed] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#404040]/40'
        >Cancel</button>

        <button
          type='button'
          @click='confirmSwitchMode()'
          class='inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-[#dc2626] bg-[#dc2626] px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#b91c1c] hover:bg-[#b91c1c] active:bg-[#991b1b] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#dc2626]/40'
        >Remove &amp; Change</button>
      </div>
    </div>
  </div>

  {{#if @partial-block}}
    {{> @partial-block}}
  {{/if}}
</div>
