{{!--
  Komponen: Repeater Field (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/repeater.hbs
  Level: L1 Atomik (scoped super_admin)

  Daftar input bernomor yang bisa ditambah/dihapus; tiap baris dikirim sebagai
  satu nilai `name[]`. Minimal selalu tersisa satu baris.

  KONTRAK PEMAKAIAN
  Pemanggil menyediakan array string Alpine (prop `state`), formErrors, dan touch().

  Props:
  - name        : string (wajib) — mis. 'materialsId[]'
  - state       : string (wajib) — path array Alpine, mis. 'lists.materials.id'
  - field       : string (wajib) — key formErrors & argumen touch()
  - label       : string (wajib) — label a11y tiap input, diikuti nomor baris
  - addLabel    : string (wajib) — teks tombol tambah
  - placeholder : string (opsional)
--}}
<div class='flex flex-col gap-2.5'>
  <template x-for='(item, index) in {{state}}' :key='index'>
    <div class='flex gap-2'>
      <span
        class='flex h-11 w-[42px] shrink-0 items-center justify-center rounded-lg border border-[#d9d9d9] bg-[#f5f5f5] font-montserrat text-sm font-medium leading-[22.75px] text-[#718096]'
        aria-hidden='true'
        x-text="String(index + 1).padStart(2, '0')"
      ></span>

      <input
        type='text'
        name='{{name}}'
        placeholder='{{placeholder}}'
        :aria-label="'{{label}} ' + (index + 1)"
        x-model='{{state}}[index]'
        @input='touch("{{field}}")'
        x-data='{ seen: false }'
        x-init="$el.form?.addEventListener('submit', () => seen = true); $el.addEventListener('blur', () => seen = true)"
        :class="formErrors.{{field}} && !{{state}}[index].trim()
          ? 'border-[#fca5a5] focus:border-[#ef4444] focus:ring-[#ef4444]/20'
          : seen
            ? 'border-[#22c55e] focus:border-[#16a34a] focus:ring-[#16a34a]/20'
            : 'border-[#d4d4d4] hover:border-[#a3a3a3] focus:border-[#003060] focus:ring-[#003060]/20'"
        class='h-11 min-w-0 flex-1 rounded-lg border bg-white px-3.5 py-2.5 font-inter text-base leading-6 text-[#171717] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors placeholder:text-[#737373] focus:outline-none focus:ring-2'
      />

      <button
        type='button'
        x-show='{{state}}.length > 1'
        @click='{{state}}.splice(index, 1); touch("{{field}}")'
        :aria-label="'Remove {{label}} ' + (index + 1)"
        class='flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#d4d4d4] bg-white text-[#737373] transition-colors hover:border-[#fca5a5] hover:bg-[#fef2f2] hover:text-[#dc2626] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 active:bg-[#fee2e2]'
      >
        {{!-- lucide: trash-2 --}}
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='h-4 w-4'>
          <path d='M3 6h18' />
          <path d='M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6' />
          <path d='M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2' />
        </svg>
      </button>
    </div>
  </template>

  <button
    type='button'
    @click="{{state}}.push('')"
    class='inline-flex h-11 w-full items-center justify-center gap-2 rounded-lg border border-[#3b82f6] bg-white px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-[#3b82f6] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#eff6ff] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3b82f6]/40 active:bg-[#dbeafe]'
  >{{addLabel}}</button>

  <p
    x-show='formErrors.{{field}}'
    x-cloak
    x-text='formErrors.{{field}}'
    class='font-inter text-sm leading-5 text-[#ef4444]'
  ></p>
</div>
