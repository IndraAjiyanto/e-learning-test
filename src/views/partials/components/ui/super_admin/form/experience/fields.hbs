{{!--
  Komponen: Experience Form Fields (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/experience/fields.hbs
  Level: L2 Blok field (scoped super_admin)

  Satu kartu dengan dua field multibahasa (jsonb { id, en, ja }), masing-masing
  punya tab bahasa sendiri. Ketiga bahasa tetap di DOM (x-show, bukan x-if)
  supaya nilainya ikut terkirim meski tabnya tidak aktif. Id field
  `{field}-{kodeBahasa}` dipakai form/experience/form untuk fokus ke field yang
  error — jangan diubah sepihak.

  @partial-block (opsional): baris tombol aksi, dirender di dalam kartu.
--}}
{{#*inline 'experienceLangPanel'}}
  <div x-show="{{field}}Lang === '{{code}}'" x-cloak>
    {{> components/ui/super_admin/form/text_field
      id=(concat field '-' code)
      name=(concat field '[' code ']')
      field=(concat field '.' code)
      label=(concat label ' (' langName ')')
      hideLabel=true
      multiline=true
      heightClass=heightClass
      placeholder=placeholder
      maxlength=255
    }}
  </div>
{{/inline}}

{{#*inline 'experienceLangField'}}
  <div class='flex flex-col gap-2'>
    <span class='font-inter text-sm font-medium leading-5 text-[#404040]'>{{label}}<span class='text-[#dc2626]'>*</span></span>

    <div class='flex flex-col gap-2'>
      {{> components/ui/super_admin/tabs/language/index
        state=(concat field 'Lang')
        ariaLabel=(concat label ' language')
      }}

      {{> experienceLangPanel code='id' langName='Indonesian' }}
      {{> experienceLangPanel code='en' langName='English' }}
      {{> experienceLangPanel code='ja' langName='Japanese' }}
    </div>
  </div>
{{/inline}}

<div class='flex flex-col gap-5 rounded-xl border border-[#d9d9d9] bg-white p-4 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-5'>
  {{> experienceLangField
    field='content'
    label='Content'
    heightClass='h-[92px]'
    placeholder='Enter experience content...'
  }}

  {{> experienceLangField
    field='details'
    label='Text'
    heightClass='h-[124px]'
    placeholder='Enter experience text...'
  }}

  {{#if @partial-block}}
    <div class='pt-2'>
      {{> @partial-block}}
    </div>
  {{/if}}
</div>
