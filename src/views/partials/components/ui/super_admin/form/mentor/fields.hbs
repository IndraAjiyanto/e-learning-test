{{!--
  Komponen: Mentor Form Fields (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/mentor/fields.hbs
  Level: L2 Blok field (scoped super_admin)

  Baris atas dua kolom: foto profil di kiri, Full Name / LinkedIn / Position di
  kanan. Di bawahnya Description selebar kartu, lalu Tools. Tidak menerima props;
  pemanggil menyediakan state Alpine dari form/mentor/form.

  Position dan Description punya tab bahasa masing-masing (positionLang dan
  descriptionLang) sehingga bisa dipindah sendiri-sendiri.

  Field per bahasa dikirim sebagai position[id]/position[en]/position[ja]
  (idem description) — bentuk yang dibaca halaman publik lewat getByLang.

  Ketiga bahasa tetap di DOM (x-show, bukan x-if) supaya nilainya ikut terkirim
  meski tab-nya tidak aktif.

  Id field dibentuk `{namaField}-{kodeBahasa}` (mis. `position-id`) — dipakai
  form/mentor/form untuk memfokuskan field pertama yang error.

  Teknologi dikirim sebagai `technologyId[]`, nama yang dibaca CreateMentorDto
  dan MentorService — bukan `technologiesIds[]` seperti form lama, yang membuat
  pilihannya tidak pernah tersimpan.
--}}
{{#*inline 'mentorLangField'}}
  <div class='flex flex-col gap-2'>
    <span class='font-inter text-sm font-medium leading-5 text-[#404040]'>{{label}}<span class='text-[#dc2626]'>*</span></span>

    <div class='flex flex-col gap-4'>
      {{> components/ui/super_admin/tabs/language/index
        ariaLabel=(concat label ' language')
        state=state
        size='sm'
      }}

      {{#each langs}}
        <div x-show="{{../state}} === '{{this}}'" x-cloak>
          {{> components/ui/super_admin/form/text_field
            id=(concat ../field '-' this)
            name=(concat ../field '[' this ']')
            field=(concat ../field '.' this)
            label=../label
            hideLabel=true
            multiline=../multiline
            placeholder=../placeholder
            maxlength=../maxlength
            required=true
          }}
        </div>
      {{/each}}
    </div>
  </div>
{{/inline}}

<div class='flex flex-col gap-5'>
  <div class='grid grid-cols-1 gap-5 sm:grid-cols-2'>
    {{!-- Batas di meta mengikuti @ValidateImage MentorController, bukan hint
         Figma (1900×1000–1920×1080, 10 MB) yang akan ditolak backend. --}}
    {{> components/ui/super_admin/form/image_dropzone
      id='profile'
      name='profile'
      label='Profile Photo'
      previewAlt='Profile photo preview'
      required=true
      meta='JPG / PNG · 300×300 – 2000×2000 · Max 5 MB'
      boxClass='h-[265px]'
      crop=true
    }}

    <div class='flex flex-col gap-3'>
      {{> components/ui/super_admin/form/text_field
        id='name'
        name='name'
        field='name'
        label='Full Name'
        placeholder='Enter full name'
        required=true
      }}

      {{> components/ui/super_admin/form/text_field
        id='linkedin'
        name='linkedin'
        field='linkedin'
        type='url'
        icon='link'
        label='LinkedIn'
        placeholder='Enter linkedin link'
        required=true
      }}

      {{> mentorLangField
        label='Position'
        field='position'
        state='positionLang'
        placeholder='Enter position'
        maxlength=255
        langs=(array 'id' 'en' 'ja')
      }}
    </div>
  </div>

  {{> mentorLangField
    label='Description'
    field='description'
    state='descriptionLang'
    placeholder='Enter a description...'
    maxlength=1000
    multiline=true
    langs=(array 'id' 'en' 'ja')
  }}

  {{> components/ui/super_admin/form/multi_select_field
    id='technologyId'
    name='technologyId[]'
    field='technologyId'
    label='Tools'
    placeholder='Search or select tools'
    options='technologyOptions'
    initial='initialTechnologies'
    required=true
  }}
</div>
