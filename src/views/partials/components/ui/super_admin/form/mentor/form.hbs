{{!--
  Komponen: Mentor Form State (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/mentor/form.hbs
  Level: L0 Skrip pendamping (scoped super_admin)

  Factory Alpine `mentorForm({ mentor, technologies })` untuk
  super_admin/mentor/{create,edit}.hbs. `mentor` hanya diisi di Edit: field
  terisi dari data tersimpan dan foto baru jadi opsional karena foto lama tetap
  dipakai bila tidak diganti.

  `position` dan `description` disimpan per bahasa { id, en, ja } dan dikirim
  sebagai position[id] dst. — bentuk yang dibaca halaman publik lewat getByLang.
  (Entity menyebut string[], tapi tidak ada ValidationPipe global yang memaksanya.)

  Menyediakan: formData, formErrors, validateField(), touch() (form/text_field);
  technologyOptions, initialTechnologies (form/multi_select_field); previewUrl,
  errorMessage, isValid, hasFile, fileName, validateImage(), clearFile()
  (form/photo_upload); loading (form/button); lang (tabs/language).

  `lang` ikut di factory ini agar submit yang gagal bisa memindahkan tab ke
  bahasa yang error — kalau tidak, pesan errornya tersembunyi di tab lain.

  Tidak merender markup apa pun — panggil sekali di halaman yang memakainya.
--}}
<script>
  (() => {
    const LANGS = ['id', 'en', 'ja'];
    const LANG_FIELDS = ['position', 'description'];
    const PLAIN_FIELDS = ['name', 'linkedin'];
    const LANG_LABEL = { id: 'Indonesian', en: 'English', ja: 'Japanese' };

    const byLang = (valueFor) => Object.fromEntries(LANGS.map((l) => [l, valueFor(l)]));

    // `path` berbentuk 'position.id' untuk field multibahasa, atau 'name'.
    const splitPath = (path) => {
      const [field, lang] = path.split('.');
      return { field, lang };
    };

    const errorFor = (field, lang, value) => {
      const val = (value ?? '').toString().trim();

      switch (field) {
        case 'name':
          if (!val) return 'Mentor name is required.';
          return '';

        case 'linkedin':
          if (!val) return 'LinkedIn link is required.';
          return '';

        case 'position': {
          const label = `Position (${LANG_LABEL[lang]})`;
          if (!val) return `${label} is required.`;
          if (val.length < 2) return `${label} must be at least 2 characters.`;
          return '';
        }

        case 'description': {
          const label = `Description (${LANG_LABEL[lang]})`;
          if (!val) return `${label} is required.`;
          if (val.length < 10) return `${label} must be at least 10 characters.`;
          return '';
        }

        default:
          return '';
      }
    };

    window.mentorForm = function mentorForm({ mentor, technologies } = {}) {
      const saved = (field) => byLang((l) => mentor?.[field]?.[l] ?? '');
      const asOption = (tech) => ({ value: tech.id, label: tech.name });

      return {
        loading: false,
        lang: 'id',

        technologyOptions: (technologies || []).map(asOption),
        initialTechnologies: (mentor?.technologies || []).map(asOption),

        // Foto profil
        originalUrl: mentor?.profile || '',
        previewUrl: mentor?.profile || null,
        objectUrl: null,
        errorMessage: '',
        isValid: true,
        fileName: '',
        hasFile: false,

        formData: {
          name: mentor?.name ?? '',
          linkedin: mentor?.linkedin ?? '',
          position: saved('position'),
          description: saved('description'),
        },
        formErrors: {
          name: '',
          linkedin: '',
          position: byLang(() => ''),
          description: byLang(() => ''),
        },
        // Error baru muncul setelah field disentuh atau setelah submit ditekan.
        touched: {
          name: false,
          linkedin: false,
          position: byLang(() => false),
          description: byLang(() => false),
        },

        validateField(path, value) {
          const { field, lang } = splitPath(path);
          if (!lang) {
            this.formData[field] = value ?? '';
            this.formErrors[field] = this.touched[field]
              ? errorFor(field, null, this.formData[field])
              : '';
            return;
          }

          this.formData[field][lang] = value ?? '';
          this.formErrors[field][lang] = this.touched[field][lang]
            ? errorFor(field, lang, this.formData[field][lang])
            : '';
        },

        touch(path) {
          const { field, lang } = splitPath(path);
          if (!lang) {
            this.touched[field] = true;
            this.validateField(path, this.formData[field]);
            return;
          }

          this.touched[field][lang] = true;
          this.validateField(path, this.formData[field][lang]);
        },

        // Batas mengikuti kontrak backend (@ValidateImage pada MentorController):
        // JPEG/JPG/PNG, maks 5 MB, 300x300 - 2000x2000 px.
        validateImage(file) {
          this.clearPreview();

          if (!file) return;

          this.hasFile = true;
          this.fileName = file.name;

          const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
          if (!allowedTypes.includes(file.type)) {
            this.setImageError('Only JPEG, JPG, and PNG formats are allowed');
            return;
          }

          const maxSize = 5 * 1024 * 1024;
          if (file.size > maxSize) {
            this.setImageError(
              `File size too large (${(file.size / 1024 / 1024).toFixed(2)} MB). Maximum 5 MB`,
            );
            return;
          }

          this.checkDimensions(file);
        },

        // Dimensi baru terbaca setelah gambar dimuat, jadi pratinjau dipasang
        // belakangan — bukan langsung seperti cek tipe dan ukuran di atas.
        checkDimensions(file) {
          const objectUrl = URL.createObjectURL(file);
          const image = new Image();

          image.onload = () => {
            const { width, height } = image;
            if (width < 300 || width > 2000 || height < 300 || height > 2000) {
              URL.revokeObjectURL(objectUrl);
              this.setImageError(
                `Image dimensions ${width}x${height}px. Required: 300x300 to 2000x2000 pixels`,
              );
              return;
            }

            this.objectUrl = objectUrl;
            this.previewUrl = objectUrl;
            this.isValid = true;
            this.errorMessage = '';
          };

          image.onerror = () => {
            URL.revokeObjectURL(objectUrl);
            this.setImageError('Failed to load image');
          };

          image.src = objectUrl;
        },

        // Berkas ditolak dikosongkan dari input agar tidak ikut terkirim;
        // di Edit pratinjau kembali ke foto tersimpan.
        setImageError(message) {
          this.clearPreview();
          this.errorMessage = message;
          this.isValid = false;
          if (this.$refs.fileInput) this.$refs.fileInput.value = null;
        },

        clearPreview() {
          if (this.objectUrl) URL.revokeObjectURL(this.objectUrl);
          this.objectUrl = null;
          this.previewUrl = this.originalUrl || null;
          this.errorMessage = '';
          this.isValid = true;
          this.fileName = '';
          this.hasFile = false;
        },

        clearFile() {
          this.clearPreview();
          this.$refs.fileInput.value = null;
        },

        validateAll() {
          PLAIN_FIELDS.forEach((field) => {
            this.touched[field] = true;
            this.formErrors[field] = errorFor(field, null, this.formData[field]);
          });

          LANG_FIELDS.forEach((field) =>
            LANGS.forEach((lang) => {
              this.touched[field][lang] = true;
              this.formErrors[field][lang] = errorFor(field, lang, this.formData[field][lang]);
            }),
          );
        },

        // Foto tidak wajib di sini, sama seperti form lama: yang dicek hanya
        // berkas yang dipilih tapi ditolak (isValid=false).
        // Dihitung ulang dari nilai formData, bukan dari formErrors: formErrors
        // hanya terisi untuk field yang sudah disentuh, sehingga form kosong yang
        // belum disentuh akan terbaca "tanpa error" dan tombol ikut menyala.
        canSubmit() {
          const plainOk = PLAIN_FIELDS.every(
            (field) => errorFor(field, null, this.formData[field]) === '',
          );
          const langOk = LANG_FIELDS.every((field) =>
            LANGS.every((lang) => errorFor(field, lang, this.formData[field][lang]) === ''),
          );

          return this.isValid && plainOk && langOk;
        },

        // Urutan mengikuti tampilan: foto, name, linkedin, lalu field per bahasa.
        // Id `${field}-${lang}` harus sama dengan yang dibentuk form/mentor/fields.
        revealFirstInvalid() {
          if (!this.isValid) {
            this.$refs.fileInput.parentElement.scrollIntoView({ block: 'center' });
            return;
          }

          for (const field of PLAIN_FIELDS) {
            if (!this.formErrors[field]) continue;
            document.getElementById(field)?.focus();
            return;
          }

          for (const lang of LANGS) {
            for (const field of LANG_FIELDS) {
              if (!this.formErrors[field][lang]) continue;

              this.lang = lang;
              this.$nextTick(() => {
                const el = document.getElementById(`${field}-${lang}`);
                if (!el) {
                  console.warn(`mentorForm: field "${field}-${lang}" tidak ditemukan — id di form/mentor/fields berubah?`);
                  return;
                }
                el.focus();
              });
              return;
            }
          }
        },

        submitForm(event) {
          this.validateAll();
          if (!this.canSubmit()) {
            this.revealFirstInvalid();
            return;
          }

          this.loading = true;
          event.target.submit();
        },
      };
    };
  })();
</script>
