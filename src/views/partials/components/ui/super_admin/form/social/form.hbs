{{!--
  Komponen: Social Form State (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/social/form.hbs
  Level: L0 Skrip pendamping (scoped super_admin)

  Factory Alpine `socialForm({ social })` untuk super_admin/social/{create,edit}.hbs.
  `social` hanya diisi di Edit, supaya field terisi dari data tersimpan.

  Menyediakan: formData, formErrors, validateField(), touch() (form/text_field);
  loading (form/button).

  Aturan validasi sama persis dengan form lama, termasuk pesan errornya. Yang
  berubah hanya waktu munculnya: error baru tampil setelah field disentuh atau
  setelah submit ditekan, dan `canSubmit()` dihitung dari hasil validateAll()
  bukan dari flag `formValid` yang di Edit dulu di-seed true untuk semua field
  (sehingga data tersimpan yang tidak valid bisa lolos submit).

  Tidak merender markup apa pun — panggil sekali di halaman yang memakainya.
--}}
<script>
  (() => {
    const FIELDS = [
      'linkedin',
      'instagram',
      'youtube',
      'videoYoutube',
      'email',
      'number',
      'address',
      'linkAddress',
      'linkForm',
    ];

    // Label domain standar + TLD 2-10 huruf, sehingga "gmail.comasdasd..." tertolak.
    const EMAIL_PATTERN = /^[a-z0-9._%+-]+@(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,10}$/i;

    // Penyedia umum wajib memakai domain aslinya: "gmail.comx" tetap tertolak.
    const EMAIL_PROVIDERS = {
      gmail: ['gmail.com'],
      yahoo: ['yahoo.com', 'yahoo.co.id'],
      outlook: ['outlook.com', 'outlook.co.id'],
      hotmail: ['hotmail.com'],
      icloud: ['icloud.com'],
    };

    const isEmail = (value) => {
      if (value.length > 254 || !EMAIL_PATTERN.test(value)) return false;
      const domain = value.split('@')[1].toLowerCase();
      const allowed = EMAIL_PROVIDERS[domain.split('.')[0]];
      return !allowed || allowed.includes(domain);
    };

    // Angka, boleh diawali +, dan pemisah umum (spasi, tanda hubung, kurung).
    const PHONE_PATTERN = /^\+?[\d\s().-]+$/;

    const PHONE_MAX_DIGITS = 15;
    const ADDRESS_MAX = 500;
    const URL_MAX = 2048;

    // new URL() menerima skema apa pun ("abc:xyz") dan menormalkan "https:www.x.com",
    // jadi awalan http(s):// dicek pada teks mentahnya.
    const parseUrl = (value) => {
      if (value.length > URL_MAX || !/^https?:\/\/[^\s]+$/i.test(value)) return null;
      try {
        const url = new URL(value);
        return url.hostname.includes('.') ? url : null;
      } catch {
        return null;
      }
    };
    const isUrl = (value) => parseUrl(value) !== null;

    const hostIs = (value, ...domains) => {
      const host = parseUrl(value)?.hostname.toLowerCase();
      return !!host && domains.some((d) => host === d || host.endsWith('.' + d));
    };

    const isMapsUrl = (value) => {
      const url = parseUrl(value);
      if (!url) return false;
      const host = url.hostname.toLowerCase();
      if (host === 'maps.app.goo.gl') return true;
      if (host === 'goo.gl') return url.pathname.startsWith('/maps');
      if (/^maps\.google\.[a-z.]+$/.test(host)) return true;
      return /^(www\.)?google\.[a-z.]+$/.test(host) && url.pathname.startsWith('/maps');
    };

    // Kembalikan '' bila valid. Urutan cek mengikuti form lama: wajib dulu,
    // baru bentuk URL, baru domain yang diharapkan.
    const errorFor = (field, value) => {
      const val = (value ?? '').toString().trim();

      switch (field) {
        case 'linkedin':
          if (!val) return 'LinkedIn URL is required';
          if (!isUrl(val)) return 'Please enter a valid URL';
          if (!hostIs(val, 'linkedin.com')) return 'Please enter a valid LinkedIn URL';
          return '';

        case 'instagram':
          if (!val) return 'Instagram URL is required';
          if (!isUrl(val)) return 'Please enter a valid URL';
          if (!hostIs(val, 'instagram.com')) return 'Please enter a valid Instagram URL';
          return '';

        case 'youtube':
          if (!val) return 'YouTube URL is required';
          if (!isUrl(val)) return 'Please enter a valid URL';
          if (!hostIs(val, 'youtube.com', 'youtu.be')) {
            return 'Please enter a valid YouTube URL';
          }
          return '';

        case 'videoYoutube':
          if (!val) return 'YouTube Video URL is required';
          if (!isUrl(val)) return 'Please enter a valid URL';
          if (!hostIs(val, 'youtube.com', 'youtu.be')) {
            return 'Please enter a valid YouTube video URL';
          }
          return '';

        case 'email':
          if (!val) return 'Email is required';
          if (!isEmail(val)) return 'Please enter a valid email address';
          return '';

        // Aturan lama hanya "minimal 10 karakter", sehingga nilai seperti
        // "98u2988989u" lolos — persis yang tersimpan di basis data saat
        // TC dilaporkan. Sekarang bentuknya ikut diperiksa.
        case 'number':
          if (!val) return 'Phone number is required';
          if (!PHONE_PATTERN.test(val)) {
            return 'Please enter a valid phone number (digits, may start with +)';
          }
          if (val.replace(/\D/g, '').length < 10) {
            return 'Phone number must have at least 10 digits';
          }
          if (val.replace(/\D/g, '').length > PHONE_MAX_DIGITS) {
            return `Phone number must have at most ${PHONE_MAX_DIGITS} digits`;
          }
          return '';

        case 'address':
          if (!val) return 'Address is required';
          if (val.length < 10) return 'Address must be at least 10 characters';
          if (val.length > ADDRESS_MAX) {
            return `Address must be at most ${ADDRESS_MAX} characters`;
          }
          return '';

        // Dulu hanya dicek "wajib diisi" karena dikhawatirkan ada baris lama yang
        // menyimpan potongan embed HTML — menolaknya akan mengunci admin dari
        // halaman Edit-nya sendiri. Isi basis data sudah diperiksa saat menangani
        // TC ini: yang tersimpan URL biasa (maps.app.goo.gl), jadi kekhawatiran
        // itu tidak terbukti dan field ini bisa diperlakukan sesuai namanya.
        case 'linkAddress':
          if (!val) return 'Google Maps link is required';
          if (!isUrl(val)) {
            return 'Please enter a valid URL (paste the link, not the embed code)';
          }
          if (!isMapsUrl(val)) {
            return 'Please enter a valid Google Maps link';
          }
          return '';

        case 'linkForm':
          if (!val) return 'Link form is required';
          if (!isUrl(val)) return 'Please enter a valid URL';
          return '';

        default:
          return '';
      }
    };

    const mapFields = (valueFor) => Object.fromEntries(FIELDS.map((f) => [f, valueFor(f)]));

    window.socialForm = function socialForm({ social } = {}) {
      return {
        loading: false,

        formData: mapFields((field) => social?.[field] ?? ''),
        formErrors: mapFields(() => ''),
        // Error baru muncul setelah field disentuh atau setelah submit ditekan.
        touched: mapFields(() => false),

        validateField(field, value) {
          this.formData[field] = value ?? '';
          this.formErrors[field] = this.touched[field]
            ? errorFor(field, this.formData[field])
            : '';
        },

        touch(field) {
          this.touched[field] = true;
          this.validateField(field, this.formData[field]);
        },

        validateAll() {
          FIELDS.forEach((field) => {
            this.touched[field] = true;
            this.formErrors[field] = errorFor(field, this.formData[field]);
          });
        },

        hasFormErrors() {
          return FIELDS.some((field) => this.formErrors[field] !== '');
        },

        // Dihitung ulang dari nilai formData, bukan dari hasFormErrors(): formErrors
        // hanya terisi untuk field yang sudah disentuh, sehingga form kosong yang
        // belum disentuh akan terbaca "tanpa error" dan tombol ikut menyala.
        canSubmit() {
          return FIELDS.every((field) => errorFor(field, this.formData[field]) === '');
        },

        // Id field di form/social/fields sengaja sama dengan nama field.
        revealFirstInvalid() {
          const field = FIELDS.find((f) => this.formErrors[f]);
          if (!field) return;
          document.getElementById(field)?.focus();
        },

        // Tombol submit tidak pernah disabled; validasi dijalankan di sini.
        submitForm(event) {
          this.validateAll();
          if (!this.canSubmit()) {
            this.revealFirstInvalid();
            return;
          }

          this.loading = true;
          event.target.submit();
        },
      };
    };
  })();
</script>
