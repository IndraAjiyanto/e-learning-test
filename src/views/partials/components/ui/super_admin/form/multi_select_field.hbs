{{!--
  Komponen: Form Multi Select Field (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/multi_select_field.hbs
  Level: L1 Atomik (scoped super_admin)

  Cari lalu pilih banyak nilai; tiap nilai tampil sebagai chip dan dikirim
  sebagai satu hidden input per nilai. Untuk satu nilai pakai form/select_field.

  State pilihan dipegang komponen ini sendiri (x-data lokal), jadi pemanggil
  cukup menyediakan daftar opsinya.

  Props:
  - id          : string (wajib) — id input pencarian sekaligus target label
  - name        : string (wajib) — name hidden input, mis. 'courseType[]'
  - label       : string (wajib)
  - options     : string (wajib) — nama properti Alpine pemanggil berisi [{ value, label }]
  - placeholder : string (opsional)
  - hint        : string (opsional)
  - emptyText   : string (default 'No options found.')
--}}
<div
  class='flex flex-col gap-1.5'
  x-data='{
    open: false,
    search: "",
    selected: [],
    get filtered() {
      const needle = this.search.trim().toLowerCase();
      return (this.{{options}} || []).filter(
        (option) =>
          String(option.label).toLowerCase().includes(needle) &&
          !this.selected.some((chosen) => chosen.value === option.value),
      );
    },
    choose(option) {
      this.selected.push(option);
      this.search = "";
      this.open = false;
    },
    remove(value) {
      this.selected = this.selected.filter((chosen) => chosen.value !== value);
    },
  }'
  @click.outside='open = false'
  @keydown.escape.stop='open = false'
>
  <label
    for='{{id}}'
    class='font-inter text-sm font-medium leading-5 text-[#404040]'
  >{{label}}</label>

  <div x-show='selected.length' x-cloak class='flex flex-wrap gap-2'>
    <template x-for='option in selected' :key='String(option.value)'>
      <span class='inline-flex items-center gap-1 rounded-2xl bg-[#e4f1f7] py-0.5 pl-2 pr-1 font-inter text-sm font-medium leading-5 text-[#055c90]'>
        <span x-text='option.label'></span>
        <button
          type='button'
          @click='remove(option.value)'
          :aria-label="'Remove ' + option.label"
          class='flex h-4 w-4 items-center justify-center rounded-full transition-colors hover:bg-[#cfe6f1] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40'
        >
          {{!-- lucide: x --}}
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-3 w-3'>
            <path d='M18 6 6 18' />
            <path d='m6 6 12 12' />
          </svg>
        </button>
      </span>
    </template>
  </div>

  <div class='relative'>
    <input
      id='{{id}}'
      type='text'
      autocomplete='off'
      placeholder='{{placeholder}}'
      x-model='search'
      @focus='open = true'
      @input='open = true'
      class='h-11 w-full rounded-lg border border-[#d4d4d4] bg-white py-2.5 pl-3.5 pr-3.5 font-inter text-base leading-6 text-[#171717] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors placeholder:text-[#737373] hover:border-[#a3a3a3] focus:border-[#003060] focus:outline-none focus:ring-2 focus:ring-[#003060]/20'
    />

    <ul
      x-show='open'
      x-cloak
      x-transition.opacity.duration.150ms
      class='absolute left-0 top-[calc(100%+6px)] z-20 max-h-60 w-full overflow-y-auto rounded-lg border border-[#e5e5e5] bg-white py-1 shadow-[0px_4px_6px_-2px_rgba(0,0,0,0.03),0px_12px_16px_-4px_rgba(0,0,0,0.08)]'
    >
      <template x-for='option in filtered' :key='String(option.value)'>
        <li>
          <button
            type='button'
            @click='choose(option)'
            x-text='option.label'
            class='flex h-11 w-full items-center px-3.5 py-2.5 text-left font-montserrat text-base leading-6 text-[#4a5568] transition-colors hover:bg-[#f5f5f5] active:bg-[#ededed] focus:outline-none focus-visible:bg-[#f5f5f5] focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#003060]/40'
          ></button>
        </li>
      </template>
      <li
        x-show='!filtered.length'
        class='px-3.5 py-2.5 font-inter text-sm leading-5 text-[#a3a3a3]'
      >{{default emptyText 'No options found.'}}</li>
    </ul>
  </div>

  <template x-for='option in selected' :key='String(option.value)'>
    <input type='hidden' name='{{name}}' :value='option.value' />
  </template>

  {{#if hint}}
    <p class='font-inter text-sm leading-5 text-[#525252]'>{{hint}}</p>
  {{/if}}
</div>
