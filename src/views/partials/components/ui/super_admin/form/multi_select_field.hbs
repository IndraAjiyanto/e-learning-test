{{!--
  Komponen: Form Multi Select Field (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/multi_select_field.hbs
  Level: L1 Atomik (scoped super_admin)

  Cari lalu pilih banyak nilai; tiap nilai tampil sebagai chip dan dikirim
  sebagai satu hidden input per nilai. Untuk satu nilai pakai form/select_field.

  State pilihan dipegang komponen ini sendiri (x-data lokal), jadi pemanggil
  cukup menyediakan daftar opsinya.

  Props:
  - id          : string (wajib) — id input pencarian sekaligus target label
  - name        : string (wajib) — name hidden input, mis. 'courseType[]'
  - label       : string (wajib)
  - options     : string (wajib) — nama properti Alpine pemanggil berisi [{ value, label }]
  - initial     : string (opsional) — nama properti Alpine pemanggil berisi
                  [{ value, label }] yang sudah terpilih (mis. halaman edit)
  - placeholder : string (opsional)
  - hint        : string (opsional)
  - required    : boolean (opsional) — asterisk merah; validasi tetap di pemanggil
  - emptyText   : string (default 'No options found.')
  - single      : boolean (opsional) — hanya satu nilai; memilih opsi lain menggantikannya
  - field       : string (opsional) — key state Alpine pemanggil. Bila diisi, pilihan
                  disinkronkan ke formData[field] (nilai tunggal bila `single`, array
                  bila tidak), touch(field) dipanggil, dan formErrors[field] ditampilkan.
                  Pemanggil wajib menyediakan formData, formErrors, dan touch().
--}}
<div
  class='flex flex-col gap-1.5'
  x-data='{
    open: false,
    search: "",
    selected: [...({{#if initial}}{{initial}}{{else}}[]{{/if}} || [])],
    get filtered() {
      const needle = this.search.trim().toLowerCase();
      return (this.{{options}} || []).filter(
        (option) =>
          String(option.label).toLowerCase().includes(needle) &&
          !this.selected.some((chosen) => chosen.value === option.value),
      );
    },
    choose(option) {
      {{#if single}}this.selected = [option];{{else}}this.selected.push(option);{{/if}}
      this.search = "";
      this.open = false;
    },
    remove(value) {
      this.selected = this.selected.filter((chosen) => chosen.value !== value);
    },
  }'
  {{#if field}}
  x-init="$watch('selected', (chosen) => {
    formData.{{field}} = {{#if single}}chosen.length ? chosen[0].value : ''{{else}}chosen.map((o) => o.value){{/if}};
    touch('{{field}}');
  })"
  {{/if}}
  @click.outside='open = false'
  @keydown.escape.stop='open = false'
>
  <label
    for='{{id}}'
    class='font-inter text-sm font-medium leading-5 text-[#404040]'
  >{{label}}{{#if required}}<span class='text-[#dc2626]'>*</span>{{/if}}</label>

  <div x-show='selected.length' x-cloak class='flex flex-wrap gap-2'>
    <template x-for='option in selected' :key='String(option.value)'>
      <span :class="option.isTool ? 'inline-flex items-center gap-[6px] rounded-[16px] bg-[#F5F5F5] py-1 pl-[6px] pr-[12px] font-inter text-sm font-medium leading-5 text-[#404040]' : 'inline-flex items-center gap-1 rounded-2xl bg-[#e4f1f7] py-0.5 pl-2 pr-1 font-inter text-sm font-medium leading-5 text-[#055c90]'">
        <template x-if="option.isTool">
          <span class="flex h-4 w-4 items-center justify-center overflow-hidden rounded-full bg-white">
            <template x-if="option.iconSvg">
              <span class="flex h-full w-full items-center justify-center [&>svg]:h-full [&>svg]:w-full" x-html="option.iconSvg"></span>
            </template>
            <template x-if="!option.iconSvg && option.iconUrl">
              <img :src="option.iconUrl" alt="" class="h-full w-full object-cover" />
            </template>
            <template x-if="!option.iconSvg && !option.iconUrl">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#737373" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </template>
          </span>
        </template>
        
        <span x-text='option.label' :class="option.isTool ? 'text-center' : ''"></span>
        
        <button
          type='button'
          @click='remove(option.value)'
          :aria-label="'Remove ' + option.label"
          :class="option.isTool ? 'ml-0.5 flex h-3 w-3 items-center justify-center rounded-full transition-opacity hover:opacity-70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40' : 'flex h-4 w-4 items-center justify-center rounded-full transition-colors hover:bg-[#cfe6f1] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40'"
        >
          <template x-if="option.isTool">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 3L3 9M3 3L9 9" stroke="#737373" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </template>
          <template x-if="!option.isTool">
            {{!-- lucide: x --}}
            <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-3 w-3'>
              <path d='M18 6 6 18' />
              <path d='m6 6 12 12' />
            </svg>
          </template>
        </button>
      </span>
    </template>
  </div>

  <div class='relative'>
    <input
      id='{{id}}'
      type='text'
      autocomplete='off'
      placeholder='{{placeholder}}'
      x-model='search'
      @focus='open = true'
      @input='open = true'
      {{#if field}}
      :aria-invalid="formErrors.{{field}} ? 'true' : 'false'"
      x-data='{ seen: false }'
      x-init="$el.form?.addEventListener('submit', () => seen = true); $watch('selected', () => seen = true)"
      :class="formErrors.{{field}}
        ? 'border-[#fca5a5] focus:border-[#ef4444] focus:ring-[#ef4444]/20'
        : seen
          ? 'border-[#22c55e] focus:border-[#16a34a] focus:ring-[#16a34a]/20'
          : 'border-[#d4d4d4] hover:border-[#a3a3a3] focus:border-[#003060] focus:ring-[#003060]/20'"
      class='h-11 w-full rounded-lg border bg-white py-2.5 pl-3.5 pr-10 font-inter text-base leading-6 text-[#171717] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors placeholder:text-[#737373] focus:outline-none focus:ring-2'
      {{else}}
      class='h-11 w-full rounded-lg border border-[#d4d4d4] bg-white py-2.5 pl-3.5 pr-10 font-inter text-base leading-6 text-[#171717] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors placeholder:text-[#737373] hover:border-[#a3a3a3] focus:border-[#003060] focus:outline-none focus:ring-2 focus:ring-[#003060]/20'
      {{/if}}
    />
    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-[#737373]">
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='w-[20px] h-[20px]'><path d='m6 9 6 6 6-6'/></svg>
    </div>

    <ul
      x-show='open'
      x-cloak
      x-transition.opacity.duration.150ms
      class='absolute left-0 top-[calc(100%+6px)] z-20 max-h-60 w-full overflow-y-auto rounded-lg border border-[#e5e5e5] bg-white py-1 shadow-[0px_4px_6px_-2px_rgba(0,0,0,0.03),0px_12px_16px_-4px_rgba(0,0,0,0.08)]'
    >
      <template x-for='option in filtered' :key='String(option.value)'>
        <li>
          <button
            type='button'
            @click='choose(option)'
            class='flex h-11 w-full items-center gap-2 px-3.5 py-2.5 text-left font-montserrat text-base leading-6 text-[#4a5568] transition-colors hover:bg-[#f5f5f5] active:bg-[#ededed] focus:outline-none focus-visible:bg-[#f5f5f5] focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#003060]/40'
          >
            <template x-if="option.isTool">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white border border-[#e5e5e5]">
                <template x-if="option.iconSvg">
                  <span class="flex h-full w-full items-center justify-center [&>svg]:h-3/4 [&>svg]:w-3/4" x-html="option.iconSvg"></span>
                </template>
                <template x-if="!option.iconSvg && option.iconUrl">
                  <img :src="option.iconUrl" alt="" class="h-full w-full object-cover" />
                </template>
                <template x-if="!option.iconSvg && !option.iconUrl">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#737373" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                </template>
              </span>
            </template>
            <span x-text='option.label'></span>
          </button>
        </li>
      </template>
      <li
        x-show='!filtered.length'
        class='px-3.5 py-2.5 font-inter text-sm leading-5 text-[#a3a3a3]'
      >{{default emptyText 'No options found.'}}</li>
    </ul>
  </div>

  <template x-for='option in selected' :key='String(option.value)'>
    <input type='hidden' name='{{name}}' :value='option.value' />
  </template>

  {{#if field}}
    <p
      x-show='formErrors.{{field}}'
      x-cloak
      x-text='formErrors.{{field}}'
      class='font-inter text-sm leading-5 text-[#ef4444]'
    ></p>
  {{/if}}

  {{#if hint}}
    <p{{#if field}} x-show='!formErrors.{{field}}'{{/if}} class='font-inter text-sm leading-5 text-[#525252]'>{{hint}}</p>
  {{/if}}
</div>
