{{!--
  Komponen: Form Text Field (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/text_field.hbs
  Level: L1 Atomik (scoped super_admin)

  SATU BARIS vs MULTILINE
  `multiline` mengganti ELEMEN-nya (<input> → <textarea>), bukan sekadar
  tingginya: <input> tidak bisa dibuat multi-baris lewat CSS. Selain elemen,
  tinggi, dan posisi ikon error, sisanya identik — karena itu tetap satu
  komponen, bukan dua file terpisah.
  `toggle` hanya berlaku untuk mode satu baris (password bukan textarea).

  KONTRAK PEMAKAIAN
  Pemanggil menyediakan state Alpine: formData, formErrors, validateField(),
  dan touch().

  WARNA BORDER
  Merah bila formErrors berisi, hijau bila field sudah dilewati (blur) atau
  form pernah di-submit dan tidak ada error, abu-abu bila belum disentuh.
  `seen` disimpan lokal di elemen agar tidak bergantung bentuk `touched`
  yang berbeda-beda antar factory.

  Props:
  - id          : string (wajib) — id field sekaligus target label
  - name        : string (wajib) — name yang dikirim ke backend
  - label       : string (wajib)
  - field       : string (wajib) — key state Alpine (formData/formErrors).
                  Boleh path bertitik (mis. 'question.id') selama factory
                  form pemanggil ikut menanganinya.
  - multiline   : boolean (opsional) — render <textarea> alih-alih <input>
  - rows        : number (default 4) — hanya untuk multiline; tinggi sebenarnya
                  diatur `heightClass`, bukan rows
  - heightClass : string (default 'h-32') — tinggi textarea; dipakai bila desain
                  memakai kotak lebih tinggi (mis. SVG Code di form Teknologi)
  - type        : 'text' | 'email' | 'password' (default 'text') — diabaikan bila multiline
                  dikunci h-32
  - type        : 'text' | 'email' | 'password' | 'number' | 'url' | 'date' | 'time'
                  (default 'text') — diabaikan bila multiline
  - iconLeft    : 'user' | 'mail' | 'map-pin' | 'graduation-cap' | 'book' | 'phone'
                  ikon 16px di slot kiri. Aditif: tidak mengubah perilaku `icon`.
                  Dipakai form profil student, yang desainnya memberi ikon pada
                  setiap field. Berlaku untuk mode satu baris maupun multiline.
  - icon        : 'link' (kiri) | 'clock' | 'calendar' (kanan; ikon picker native
                  disembunyikan; klik input membuka picker lewat showPicker. Firefox tidak bisa
                  menyembunyikan ikon native, jadi di sana SVG ini yang disembunyikan)
  - numeric     : boolean (opsional) — tampilan angka berformat dari formData, sementara
                  nilai yang dikirim hanya digit lewat hidden input `name`
  - placeholder : string (opsional)
  - hint        : string (opsional) — hint statis, disembunyikan saat ada error
  - required    : boolean (opsional) — asterisk merah + attribute required
  - toggle      : boolean (opsional) — tombol show/hide password; hanya mode satu baris.
                  Ikon mata tetap tampil selama field terisi (termasuk saat error)
                  agar user bisa memeriksa password yang sedang diketik; ikon
                  alert-circle hanya mengisi slot kanan saat error & field kosong.
  - autocomplete: string (opsional)
  - maxlength   : number (opsional) — batas karakter native
  - hideLabel   : boolean (opsional) — label hanya untuk screen reader, bila label
                  visual sudah dirender pemanggil (mis. di atas tab bahasa)
--}}
<div class='flex flex-col gap-1.5'{{#if toggle}} x-data='{ showValue: false }'{{/if}}>
  <label
    for='{{id}}'
    class='{{#if hideLabel}}sr-only{{else}}font-inter text-sm font-medium leading-5 text-[#404040]{{/if}}'
  >{{label}}{{#if required}}<span class='text-[#dc2626]'>*</span>{{/if}}</label>

  <div class='relative'>
    {{#if multiline}}
      <textarea
        id='{{id}}'
        name='{{name}}'
        rows='{{default rows 4}}'
        {{#if required}}required{{/if}}
        {{#if maxlength}}maxlength='{{maxlength}}'{{/if}}
        {{#if autocomplete}}autocomplete='{{autocomplete}}'{{/if}}
        placeholder='{{placeholder}}'
        x-model='formData.{{field}}'
        @input='validateField("{{field}}", $event.target.value)'
        @blur='touch("{{field}}")'
        :aria-invalid="formErrors.{{field}} ? 'true' : 'false'"
        x-data='{ seen: false }'
        x-init="$el.form?.addEventListener('submit', () => seen = true); $el.addEventListener('blur', () => seen = true)"
        :class="formErrors.{{field}}
          ? 'border-[#fca5a5] focus:border-[#ef4444] focus:ring-[#ef4444]/20'
          : seen
            ? 'border-[#22c55e] focus:border-[#16a34a] focus:ring-[#16a34a]/20'
            : 'border-[#d4d4d4] hover:border-[#a3a3a3] focus:border-[#003060] focus:ring-[#003060]/20'"
        {{!-- slot ikon error: inline style agar tidak kalah urutan dari utility pr-3.5 --}}
        :style="formErrors.{{field}} && 'padding-right: 44px'"
        {{!-- block: textarea inline menyisakan ruang baseline ~7px di bawahnya --}}
        class='block {{default heightClass "h-32"}} w-full resize-none rounded-lg border bg-white py-2.5 {{#if iconLeft}}pl-10{{else}}pl-3.5{{/if}} pr-3.5 font-inter text-base leading-6 text-[#171717] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors placeholder:text-[#737373] focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:bg-[#f5f5f5] disabled:text-[#a3a3a3]'
      ></textarea>

      {{#if iconLeft}}
        <span class='pointer-events-none absolute left-3.5 top-[18px] flex h-4 w-4 items-center justify-center text-[#737373]' aria-hidden='true'>
          {{> components/ui/super_admin/form/field_icon name=iconLeft }}
        </span>
      {{/if}}
    {{else}}
      <input
        id='{{id}}'
        {{#unless numeric}}name='{{name}}'{{/unless}}
        type='{{default type "text"}}'
        {{#if numeric}}inputmode='numeric'{{/if}}
        {{#if (or (eq icon 'clock') (eq icon 'calendar'))}}@click='$el.showPicker && $el.showPicker()'{{/if}}
        {{#if toggle}}:type="showValue ? 'text' : 'password'"{{/if}}
        {{#if required}}required{{/if}}
        {{#if maxlength}}maxlength='{{maxlength}}'{{/if}}
        {{#if autocomplete}}autocomplete='{{autocomplete}}'{{/if}}
        placeholder='{{placeholder}}'
        x-model='formData.{{field}}'
        @input='validateField("{{field}}", $event.target.value)'
        @blur='touch("{{field}}")'
        :aria-invalid="formErrors.{{field}} ? 'true' : 'false'"
        x-data='{ seen: false }'
        x-init="$el.form?.addEventListener('submit', () => seen = true); $el.addEventListener('blur', () => seen = true)"
        :class="formErrors.{{field}}
          ? 'border-[#fca5a5] focus:border-[#ef4444] focus:ring-[#ef4444]/20'
          : seen
            ? 'border-[#22c55e] focus:border-[#16a34a] focus:ring-[#16a34a]/20'
            : 'border-[#d4d4d4] hover:border-[#a3a3a3] focus:border-[#003060] focus:ring-[#003060]/20'"
        {{#unless (or toggle (eq icon 'calendar') (eq icon 'clock'))}}
          {{!-- slot ikon error: pakai inline style agar tidak kalah urutan dari utility pr-3.5 --}}
          :style="formErrors.{{field}} && 'padding-right: 44px'"
        {{/unless}}
        class='h-11 w-full rounded-lg border bg-white py-2.5 {{#if (or (eq icon 'link') iconLeft)}}pl-10{{else}}pl-3.5{{/if}} {{#if toggle}}pr-11{{else if (or (eq icon 'clock') (eq icon 'calendar'))}}pr-10 cursor-pointer [&::-webkit-calendar-picker-indicator]:hidden{{else}}pr-3.5{{/if}} font-inter text-base leading-6 text-[#171717] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors placeholder:text-[#737373] focus:outline-none focus:ring-2 disabled:cursor-not-allowed disabled:bg-[#f5f5f5] disabled:text-[#a3a3a3]'
      />

      {{#if numeric}}
        <input type='hidden' name='{{name}}' :value="String(formData.{{field}} ?? '').replace(/\D/g, '')" />
      {{/if}}

      {{#if iconLeft}}
        <span class='pointer-events-none absolute left-3.5 top-1/2 flex h-4 w-4 -translate-y-1/2 items-center justify-center text-[#737373]' aria-hidden='true'>
          {{> components/ui/super_admin/form/field_icon name=iconLeft }}
        </span>
      {{/if}}

      {{#if (eq icon 'link')}}
        <span class='pointer-events-none absolute left-3.5 top-1/2 flex h-4 w-4 -translate-y-1/2 items-center justify-center text-[#737373]' aria-hidden='true'>
          {{!-- lucide: link --}}
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-4 w-4'>
            <path d='M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71' />
            <path d='M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71' />
          </svg>
        </span>
      {{else if (eq icon 'clock')}}
        <span :class="formErrors.{{field}} ? 'text-[#ef4444]' : 'text-[#737373]'" class='pointer-events-none absolute right-3.5 top-1/2 flex h-4 w-4 -translate-y-1/2 items-center justify-center supports-[-moz-orient:inline]:hidden' aria-hidden='true'>
          {{!-- lucide: clock --}}
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-4 w-4'>
            <circle cx='12' cy='12' r='10' />
            <path d='M12 6v6l4 2' />
          </svg>
        </span>
      {{else if (eq icon 'calendar')}}
        <span :class="formErrors.{{field}} ? 'text-[#ef4444]' : 'text-[#737373]'" class='pointer-events-none absolute right-3.5 top-1/2 flex h-4 w-4 -translate-y-1/2 items-center justify-center supports-[-moz-orient:inline]:hidden' aria-hidden='true'>
          {{!-- lucide: calendar --}}
          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-4 w-4'>
            <rect width='18' height='18' x='3' y='4' rx='2' />
            <path d='M16 2v4M8 2v4M3 10h18' />
          </svg>
        </span>
      {{/if}}

      {{#if toggle}}
        <button
          type='button'
          x-show='formData.{{field}} || !formErrors.{{field}}'
          @click='showValue = !showValue'
          :aria-label="showValue ? 'Hide password' : 'Show password'"
          :class="formErrors.{{field}} ? 'text-[#ef4444]' : 'text-[#545454]'"
          class='absolute right-3.5 top-1/2 flex h-4 w-4 -translate-y-1/2 items-center justify-center rounded-sm transition-colors hover:text-[#003060] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 focus-visible:ring-offset-2 active:text-[#001c39]'
        >
          {{!-- lucide: eye --}}
          <svg x-show='!showValue' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-4 w-4'>
            <path d='M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z' />
            <circle cx='12' cy='12' r='3' />
          </svg>
          {{!-- lucide: eye-off --}}
          <svg x-show='showValue' x-cloak xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-4 w-4'>
            <path d='M10.7 5.1A9.9 9.9 0 0 1 12 5c6.5 0 10 7 10 7a17.6 17.6 0 0 1-3.2 4.1M6.6 6.6A17.6 17.6 0 0 0 2 12s3.5 7 10 7a9.7 9.7 0 0 0 4.4-1' />
            <path d='m2 2 20 20' />
            <path d='M9.9 9.9a3 3 0 0 0 4.2 4.2' />
          </svg>
        </button>
      {{/if}}
    {{/if}}

    {{#unless (or (eq icon 'clock') (eq icon 'calendar'))}}
    {{!-- Textarea rata atas, jadi ikonnya dipatok ke baris pertama, bukan tengah. --}}
    <span
      x-show='formErrors.{{field}}{{#if toggle}} && !formData.{{field}}{{/if}}'
      x-cloak
      class='pointer-events-none absolute right-3.5 flex h-4 w-4 items-center justify-center text-[#ef4444] {{#if multiline}}top-3.5{{else}}top-1/2 -translate-y-1/2{{/if}}'
    >
      {{!-- lucide: alert-circle --}}
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.67' stroke-linecap='round' stroke-linejoin='round' class='h-4 w-4'>
        <circle cx='12' cy='12' r='10' />
        <path d='M12 8v4' />
        <path d='M12 16h.01' />
      </svg>
    </span>
    {{/unless}}
  </div>

  <p
    x-show='formErrors.{{field}}'
    x-cloak
    x-text='formErrors.{{field}}'
    class='font-inter text-sm leading-5 text-[#ef4444]'
  ></p>

  {{#if hint}}
    <p
      x-show='!formErrors.{{field}}'
      class='font-inter text-sm leading-5 text-[#525252]'
    >{{hint}}</p>
  {{/if}}
</div>
