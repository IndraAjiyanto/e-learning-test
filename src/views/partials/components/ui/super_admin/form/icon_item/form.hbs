{{!--
  Komponen: Icon Item Form State (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/form/icon_item/form.hbs
  Level: L0 Skrip pendamping (scoped super_admin)

  Factory Alpine `iconItemForm()` untuk super_admin/{value,commitment}/{create,edit}.hbs.
  Keduanya memakai field, validasi, dan aturan submit yang sama — lihat catatan
  di form/icon_item/fields.

  Menyediakan: formData, formErrors, validateField(), touch() (form/text_field,
  form/icon_picker); loading (form/button); titleLang & descriptionLang
  (tabs/language lewat prop `state` — dua field multibahasa punya tab sendiri).

  Submit yang gagal memindahkan tab field yang error agar pesannya terlihat.

  Tidak merender markup apa pun — panggil sekali di halaman yang memakainya.
--}}
<script>
  (() => {
    const LANGS = ['id', 'en', 'ja'];
    const LANG_LABEL = { id: 'Indonesian', en: 'English', ja: 'Japanese' };
    const LABEL = { icon: 'Icon Code', title: 'Title', description: 'Description' };
    const MIN = { icon: 2, title: 3, description: 10 };

    // Urutan ini juga urutan fokus saat submit gagal, mengikuti urutan field.
    const PATHS = [
      ...LANGS.map((l) => `title.${l}`),
      'icon',
      ...LANGS.map((l) => `description.${l}`),
    ];
    const byLang = (valueFor) => Object.fromEntries(LANGS.map((l) => [l, valueFor(l)]));

    // `path` berbentuk 'icon' atau 'title.id' — bentuk yang dikirim form/text_field.
    const read = (obj, path) => {
      const [f, l] = path.split('.');
      return l ? obj[f][l] : obj[f];
    };
    const write = (obj, path, value) => {
      const [f, l] = path.split('.');
      if (l) obj[f][l] = value;
      else obj[f] = value;
    };

    const errorFor = (path, value) => {
      const [field, lang] = path.split('.');
      const val = (value ?? '').toString().trim();
      const label = lang ? `${LABEL[field]} (${LANG_LABEL[lang]})` : LABEL[field];
      if (!val) return `${label} is required.`;
      if (val.length < MIN[field]) {
        return `${label} must be at least ${MIN[field]} characters.`;
      }
      return '';
    };

    // Sama dengan helper computeIcon di server; helper itu tidak bisa dipanggil dari Alpine.
    const toIconClass = (value) => {
      const icon = String(value || '').trim();
      if (!icon) return 'fa-solid fa-circle-question';
      const hasFaPrefix = /\b(fa|fas|far|fal|fad|fab|fa-solid|fa-regular|fa-light|fa-duotone)\b/i.test(icon)
        || icon.split(/\s+/).some((part) => /^fa-/i.test(part));
      if (hasFaPrefix) return /^fa-\w+/i.test(icon) && !/\s/.test(icon) ? 'fa-solid ' + icon : icon;
      return icon.includes(' ') ? icon : 'fa-solid fa-' + icon;
    };

    window.iconItemForm = function iconItemForm({ icon, title, description } = {}) {
      // Kolom jsonb nullable: data lama bisa belum punya salah satu bahasa.
      const initial = (src) => byLang((l) => (src && src[l]) || '');

      return {
        loading: false,
        titleLang: 'id',
        descriptionLang: 'id',

        formData: {
          icon: icon || '',
          title: initial(title),
          description: initial(description),
        },
        formErrors: { icon: '', title: byLang(() => ''), description: byLang(() => '') },
        // Error baru muncul setelah field disentuh atau setelah submit ditekan.
        touched: { icon: false, title: byLang(() => false), description: byLang(() => false) },

        get iconClass() {
          return toIconClass(this.formData.icon);
        },

        validateField(path, value) {
          write(this.formData, path, value ?? '');
          write(
            this.formErrors,
            path,
            read(this.touched, path) ? errorFor(path, read(this.formData, path)) : '',
          );
        },

        touch(path) {
          write(this.touched, path, true);
          this.validateField(path, read(this.formData, path));
        },

        validateAll() {
          PATHS.forEach((path) => this.touch(path));
        },

        hasFormErrors() {
          return PATHS.some((path) => read(this.formErrors, path) !== '');
        },

        // Id harus sama dengan yang dibentuk form/icon_item/fields
        // (`icon`, `title-id`, `description-en`, ...).
        revealFirstInvalid() {
          const path = PATHS.find((p) => read(this.formErrors, p));
          if (!path) return;

          const [field, lang] = path.split('.');
          if (lang) this[`${field}Lang`] = lang;

          const id = lang ? `${field}-${lang}` : field;
          this.$nextTick(() => {
            const el = document.getElementById(id);
            if (!el) {
              console.warn(`iconItemForm: field "${id}" tidak ditemukan — id di form/icon_item/fields berubah?`);
              return;
            }
            el.focus();
          });
        },

        // Tombol submit tidak pernah disabled; validasi dijalankan di sini.
        submitForm(event) {
          this.validateAll();
          if (this.hasFormErrors()) {
            this.revealFirstInvalid();
            return;
          }

          this.loading = true;
          event.target.submit();
        },
      };
    };
  })();
</script>
