{{!--
  Partner Tabs (Super Admin) — navigasi antara halaman Partnership dan Partner Category.

  Props:
  - active : 'partnership' (default) | 'category' — menentukan tab bergaris
--}}
<nav
  aria-label='Partner sections'
  class='flex items-end gap-3 border-b border-[#d9d9d9]'
>
  <a
    href='/partnership'
    {{#if (eq active 'partnership')}}aria-current='page'{{/if}}
    class='-mb-px inline-flex h-10 items-center justify-center border-b-2 px-7 py-2.5 font-montserrat text-sm font-semibold leading-5 text-[#003060] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 {{#if (eq active 'partnership')}}border-[#055c90]{{else}}border-transparent hover:border-[#d9d9d9]{{/if}}'
  >Partnership</a>

  <a
    href='/category-partner'
    {{#if (eq active 'category')}}aria-current='page'{{/if}}
    class='-mb-px inline-flex h-10 items-center justify-center border-b-2 px-7 py-2.5 font-montserrat text-sm font-semibold leading-5 text-[#003060] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 {{#if (eq active 'category')}}border-[#055c90]{{else}}border-transparent hover:border-[#d9d9d9]{{/if}}'
  >Partner Category</a>
</nav>
