{{!--
  Komponen: Search Input (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/input/search/index.hbs
  Level: L1 Atomik (scoped super_admin)

  Input pencarian outline sesuai token Figma:
  - Tinggi: 44px (h-11)
  - Border: 1px solid #D4D4D4, radius 8px (rounded-lg)
  - Background: #FFFFFF
  - Teks / Placeholder: Inter 16px regular, placeholder #A3A3A3
  - Icon: Search SVG 20x20 #A3A3A3 di sebelah kanan/kiri

  Props:
  - model       : string (wajib) — nama state Alpine untuk x-model, mis. 'searchQuery'
  - placeholder : string (default 'Search...')
  - class       : string (opsional)
--}}
<div class="relative w-full flex items-center {{class}}">
  <input
    type="text"
    x-model="{{default model 'searchQuery'}}"
    placeholder="{{default placeholder 'Search...'}}"
    class="w-full h-11 bg-white border border-[#D4D4D4] rounded-lg pl-3.5 pr-10 py-2.5 font-inter font-normal text-base leading-6 text-[#171717] placeholder-[#A3A3A3] transition-colors focus:border-[#003060] focus:outline-none focus:ring-1 focus:ring-[#003060]"
  />
  <div class="absolute right-3.5 pointer-events-none flex items-center justify-center text-[#A3A3A3]">
    <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M17.5 17.5L13.875 13.875M15.8333 9.16667C15.8333 12.8486 12.8486 15.8333 9.16667 15.8333C5.48477 15.8333 2.5 12.8486 2.5 9.16667C2.5 5.48477 5.48477 2.5 9.16667 2.5C12.8486 2.5 15.8333 5.48477 15.8333 9.16667Z" stroke="currentColor" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</div>
