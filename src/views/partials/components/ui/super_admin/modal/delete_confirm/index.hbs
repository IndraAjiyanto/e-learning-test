{{!--
  Komponen: Delete Confirmation Modal (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/modal/delete_confirm/index.hbs
  Level: L1 Atomik (scoped super_admin)

  hanya berbeda judul & deskripsi yang dikirim lewat props.

  - overlay        : #0a0a0a opacity 70%, background blur 16px, menutup 1440x1024
  - Content        : gap 20, center
  - _Modal actions : gap 12, dua tombol FILL (masing-masing 170x44)
                     Cancel  bg #ffffff, border #d4d4d4, teks #404040
                     Delete  bg #e84338, border #e84338, teks #ffffff
                     keduanya radius 8, px 18, py 10, Inter SemiBold 16/24,
                     shadow 0 1px 2px rgba(0,0,0,0.05)

  (#404040 dan #e84338) berbeda dari varian secondary (#003060) dan danger (#dc2626)
  komponen tersebut, dan prop `class` di sana hanya menambah class (tidak meng-override

  KONTRAK PEMAKAIAN
  Komponen ini TIDAK membuat mekanisme delete baru. Ia hanya menahan submit form
  delete yang sudah ada sampai user menekan Delete.

  Cara pakai: panggil sekali di page (di luar x-data lain), lalu setiap tombol delete
  cukup memakai `onclick='openDeleteModal(this)'` dan berada di dalam <form> delete
  existing (mis. POST /users/:id?_method=DELETE atau /partnership/:id?_method=DELETE).

  NAMA FUNGSI SENGAJA `openDeleteModal`, BUKAN `confirmDelete`:
  layouts/main.hbs memuat {{> sweetalert}} SETELAH {{{body}}}, dan partial itu
  mendefinisikan global `confirmDelete()` versi SweetAlert. Karena skrip page
  dieksekusi lebih dulu, deklarasi dari sweetalert.hbs akan menimpa nama yang sama
  dan modal ini tidak akan pernah muncul. Nama berbeda menghindari tabrakan itu
  tanpa perlu mengubah partial global yang dipakai role lain.

  Props:
  - title       : string (default 'Delete User Account?')
  - cancelLabel : string (default 'Cancel')
  - confirmLabel: string (default 'Delete')
--}}
<div
  x-data='deleteConfirmModal()'
  x-show='open'
  x-cloak
  @delete-confirm:open.window='show($event.detail.form, $event.detail.trigger)'
  @keydown.escape.window='close()'
  class='fixed inset-0 z-50 flex items-center justify-center bg-[#0a0a0a]/70 p-4 backdrop-blur-[16px]'
  @click.self='close()'
>
  <div
    role='dialog'
    aria-modal='true'
    aria-labelledby='delete-confirm-modal-title'
    aria-describedby='delete-confirm-modal-description'
    @keydown.tab.prevent='cycleFocus($event)'
    class='flex w-full max-w-[400px] flex-col gap-8 rounded-xl bg-white p-6 shadow-[0px_8px_8px_-4px_rgba(0,0,0,0.03),0px_20px_24px_-4px_rgba(0,0,0,0.08)]'
  >
    
    <div class='flex flex-col items-center gap-5'>
      
      <span
        class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-8 border-[#f2e1e1] bg-[#f4dddd]'
      >
        
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' aria-hidden='true' class='h-6 w-6'>
          <path
            d='M20.25 4.5H16.5V3.75C16.5 3.15326 16.2629 2.58097 15.841 2.15901C15.419 1.73705 14.8467 1.5 14.25 1.5H9.75C9.15326 1.5 8.58097 1.73705 8.15901 2.15901C7.73705 2.58097 7.5 3.15326 7.5 3.75V4.5H3.75C3.55109 4.5 3.36032 4.57902 3.21967 4.71967C3.07902 4.86032 3 5.05109 3 5.25C3 5.44891 3.07902 5.63968 3.21967 5.78033C3.36032 5.92098 3.55109 6 3.75 6H4.5V19.5C4.5 19.8978 4.65804 20.2794 4.93934 20.5607C5.22064 20.842 5.60218 21 6 21H18C18.3978 21 18.7794 20.842 19.0607 20.5607C19.342 20.2794 19.5 19.8978 19.5 19.5V6H20.25C20.4489 6 20.6397 5.92098 20.7803 5.78033C20.921 5.63968 21 5.44891 21 5.25C21 5.05109 20.921 4.86032 20.7803 4.71967C20.6397 4.57902 20.4489 4.5 20.25 4.5ZM9 3.75C9 3.55109 9.07902 3.36032 9.21967 3.21967C9.36032 3.07902 9.55109 3 9.75 3H14.25C14.4489 3 14.6397 3.07902 14.7803 3.21967C14.921 3.36032 15 3.55109 15 3.75V4.5H9V3.75ZM18 19.5H6V6H18V19.5ZM10.5 9.75V15.75C10.5 15.9489 10.421 16.1397 10.2803 16.2803C10.1397 16.421 9.94891 16.5 9.75 16.5C9.55109 16.5 9.36032 16.421 9.21967 16.2803C9.07902 16.1397 9 15.9489 9 15.75V9.75C9 9.55109 9.07902 9.36032 9.21967 9.21967C9.36032 9.07902 9.55109 9 9.75 9C9.94891 9 10.1397 9.07902 10.2803 9.21967C10.421 9.36032 10.5 9.55109 10.5 9.75ZM15 9.75V15.75C15 15.9489 14.921 16.1397 14.7803 16.2803C14.6397 16.421 14.4489 16.5 14.25 16.5C14.0511 16.5 13.8603 16.421 13.7197 16.2803C13.579 16.1397 13.5 15.9489 13.5 15.75V9.75C13.5 9.55109 13.579 9.36032 13.7197 9.21967C13.8603 9.07902 14.0511 9 14.25 9C14.4489 9 14.6397 9.07902 14.7803 9.21967C14.921 9.36032 15 9.55109 15 9.75Z'
            fill='#c80606'
          />
        </svg>
      </span>

      
      <div class='flex flex-col items-center gap-2'>
        <h2
          id='delete-confirm-modal-title'
          class='text-center font-inter text-lg font-semibold leading-7 text-[#171717]'
        >{{default title 'Delete User Account?'}}</h2>

        <p
          id='delete-confirm-modal-description'
          class='text-center font-inter text-sm font-normal leading-5 text-[#525252]'
        >{{default description "Are you sure you want to delete this user? This action will permanently remove the user's account and cannot be undone."}}</p>
      </div>
    </div>

    
    <div class='flex items-start gap-3'>
      <button
        type='button'
        x-ref='cancelButton'
        @click='close()'
        :disabled='submitting'
        class='inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-[#d4d4d4] bg-white px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-[#404040] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#a3a3a3] hover:bg-[#f5f5f5] active:bg-[#ededed] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#404040]/40 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60'
      >{{default cancelLabel 'Cancel'}}</button>

      <button
        type='button'
        x-ref='confirmButton'
        @click='confirm()'
        :disabled='submitting'
        class='inline-flex h-11 flex-1 items-center justify-center rounded-lg border border-[#e84338] bg-[#e84338] px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#d13328] hover:bg-[#d13328] active:bg-[#b82c22] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#e84338]/40 focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-80'
      >{{default confirmLabel 'Delete'}}</button>
    </div>
  </div>
</div>

<script>
  // Dipanggil oleh tombol delete existing: onclick='openDeleteModal(this)'.
  // Tugasnya hanya membuka modal sambil membawa <form> delete milik tombol itu —
  // form-nya sendiri (POST /users/:id?_method=DELETE) tidak diubah dan baru
  // di-submit setelah user menekan Delete di modal.
  function openDeleteModal(button) {
    const form = button.closest('form');
    if (!form) return;

    window.dispatchEvent(
      new CustomEvent('delete-confirm:open', { detail: { form, trigger: button } }),
    );
  }

  function deleteConfirmModal() {
    return {
      open: false,
      // Form delete milik baris/halaman yang memicu modal. Null saat modal tertutup,
      // sehingga confirm() tidak mungkin menghapus user lain.
      pendingForm: null,
      // Elemen yang memicu modal; fokus dikembalikan ke sini saat modal ditutup.
      lastTrigger: null,
      // Mengunci tombol setelah submit agar delete tidak terkirim dua kali.
      submitting: false,

      show(form, trigger) {
        if (!form) return;

        this.pendingForm = form;
        this.lastTrigger = trigger || null;
        this.submitting = false;
        this.open = true;
        document.body.classList.add('overflow-hidden');

        // Fokus ke aksi non-destruktif dulu — Enter tidak boleh langsung menghapus.
        // requestAnimationFrame dipakai setelah $nextTick karena x-show baru
        // melepas `display: none` saat frame berikutnya; elemen yang masih
        // display:none tidak bisa menerima focus() dan panggilannya gagal diam-diam.
        this.$nextTick(() => requestAnimationFrame(() => this.$refs.cancelButton?.focus()));
      },

      close() {
        // `@keydown.escape.window` ikut menyala saat modal tertutup, jadi tanpa guard
        // ini Escape di mana pun pada halaman akan melepas scroll-lock body —
        // termasuk milik komponen lain yang sedang memakainya.
        if (!this.open) return;

        // Saat submit sedang berjalan modal dibiarkan terbuka; halaman akan reload.
        if (this.submitting) return;

        this.open = false;
        this.pendingForm = null;
        document.body.classList.remove('overflow-hidden');
        this.lastTrigger?.focus();
        this.lastTrigger = null;
      },

      // Satu-satunya jalan menuju delete. Memakai form existing, tanpa fetch baru.
      confirm() {
        if (!this.pendingForm || this.submitting) return;

        this.submitting = true;
        this.pendingForm.submit();
      },

      // Focus trap sederhana: Tab berputar di antara Cancel dan Delete saja.
      cycleFocus(event) {
        const order = [this.$refs.cancelButton, this.$refs.confirmButton];
        const current = order.indexOf(document.activeElement);
        const step = event.shiftKey ? -1 : 1;
        order[(current + step + order.length) % order.length]?.focus();
      },
    };
  }
</script>
