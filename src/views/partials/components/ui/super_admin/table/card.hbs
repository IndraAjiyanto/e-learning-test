{{!--
  Table Card (Super Admin) — pembungkus tabel + pagination.
  Isi tabel (colgroup/thead/tbody) dikirim lewat partial-block.

  Pemanggil WAJIB menyediakan state Alpine yang dipakai table/pagination:
  currentPage, totalPages, changePage().

  Props:
  - tableClass : class untuk <table>, mis. 'min-w-[1010px]'. WAJIB ditulis literal
                 di pemanggil supaya Tailwind ikut men-generate kelasnya saat build.
--}}
<div class='overflow-hidden rounded-xl border border-[#e5e5e5] bg-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.06)]'>
  <div class='overflow-x-auto'>
    <table class='w-full table-fixed border-collapse text-left {{tableClass}}'>
      {{> @partial-block}}
    </table>
  </div>

  {{> components/ui/super_admin/table/pagination }}
</div>
