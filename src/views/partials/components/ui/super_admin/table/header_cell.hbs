{{!--
  Table Header Cell (Super Admin) — <th> untuk tabel Super Admin.

  Props:
  - label    : teks header kolom (wajib jika bukan checkbox)
  - align    : 'center' (opsional) — default rata kiri, mengikuti isi selnya
  - checkbox : boolean (opsional) — render checkbox "Select All"
--}}
<th
  scope='col'
  {{#if checkbox}}
  x-show='selectMode' x-cloak style='display: none;'
  class='h-11 border-b border-[#e5e5e5] bg-[#fafafa] w-[48px] px-3 py-3 text-center'
  {{else}}
  class='h-11 border-b border-[#e5e5e5] bg-[#fafafa] px-6 py-3 font-inter text-xs font-medium leading-[18px] text-[#525252]{{#if (eq align 'center')}} text-center{{/if}}'
  {{/if}}
>
  {{#if checkbox}}
  <input
    type='checkbox'
    :checked='isAllSelected()'
    @change='toggleSelectAll($event)'
    :disabled='typeof isRowDisabled === "function" ? !((filtered || items || rows || []).some(row => !isRowDisabled(row))) : (filtered || items || rows || []).length === 0'
    class='h-4 w-4 rounded border-[#d4d4d4] text-[#003060] focus:ring-[#003060] cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed'
    title='Select All'
  />
  {{else}}
  {{label}}
  {{/if}}
</th>
