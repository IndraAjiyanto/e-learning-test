{{!--
  Table Cell (Super Admin) — <td>, pasangan table/header_cell.

  Props:
  - text     : ekspresi Alpine; bila diisi, sel jadi sel teks dan partial-block diabaikan.
               Dirender ke x-text='…', jadi di dalamnya pakai kutip GANDA.
  - variant  : 'default' | 'action' (padding rata, untuk sel tombol aksi)
               | 'media' (py-2.5, agar gambar 52px tetap muat di baris 72px)
  - checkbox : boolean — bila true, render checkbox baris
  - idField  : string (default 'row.id') — ekspresi properti ID untuk :value
  - isi bebas lewat partial-block bila `text` tidak dipakai.
--}}
{{#if checkbox}}
<td x-show='selectMode' x-cloak style='display: none;' class='h-[72px] w-[48px] px-3 py-4 text-center align-middle border-b border-[#e5e5e5]'>
  <input
    type='checkbox'
    :value='{{default idField "row.id"}}'
    x-model='selectedIds'
    class='h-4 w-4 rounded border-[#d4d4d4] text-[#003060] focus:ring-[#003060] cursor-pointer'
  />
</td>
{{else}}
<td
  {{!-- break-words: nilai panjang tanpa spasi (mis. nama 30+ karakter) dulu
       meluber ke sel sebelahnya. Hanya memenggal saat terpaksa, jadi teks
       normal tetap berpindah baris di spasi seperti biasa (TC-049). --}}
  class='h-[72px] break-words border-b border-[#e5e5e5] align-middle {{#if (eq variant 'action')}}p-4{{else if (eq variant 'media')}}px-6 py-2.5{{else}}px-6 py-4{{/if}}{{#if text}} font-inter text-sm leading-5 text-[#525252]{{/if}}'
  {{#if text}}x-text='{{{text}}}'{{/if}}
>{{#unless text}}{{#if @partial-block}}{{> @partial-block}}{{/if}}{{/unless}}</td>
{{/if}}
