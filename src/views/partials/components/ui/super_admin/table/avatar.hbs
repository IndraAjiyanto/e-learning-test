{{!--
  Table Avatar (Super Admin) — gambar bulat (default 40px) dengan fallback huruf awal.

  Semua prop dirender ke atribut ber-kutip TUNGGAL, jadi di dalam ekspresi pakai kutip GANDA.

  Props:
  - src  : ekspresi Alpine sumber gambar (wajib)
  - name : ekspresi Alpine dasar huruf inisial (wajib)
  - alt  : ekspresi Alpine teks alt (opsional, default memakai `name`)
  - avatarClass : class ukuran lingkaran, default 'h-10 w-10'. WAJIB ditulis
                  literal di pemanggil supaya Tailwind ikut men-generate kelasnya.
--}}
<template x-if='{{{src}}}'>
  <img
    :src='{{{src}}}'
    :alt='{{#if alt}}{{{alt}}}{{else}}{{{name}}}{{/if}}'
    class='{{default avatarClass "h-10 w-10"}} shrink-0 rounded-full object-cover'
  />
</template>
<template x-if='!({{{src}}})'>
  <div class='{{default avatarClass "h-10 w-10"}} flex shrink-0 items-center justify-center rounded-full bg-[#c7b9da]'>
    <span
      class='font-inter text-sm font-semibold leading-5 text-white'
      x-text='(({{{name}}}) || "?").charAt(0).toUpperCase()'
    ></span>
  </div>
</template>
