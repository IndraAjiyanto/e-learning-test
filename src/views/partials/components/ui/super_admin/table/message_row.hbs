{{!--
  Table Message Row (Super Admin) — satu baris membentang penuh untuk
  loading / empty state / pesan error.

  Props:
  - show    : ekspresi Alpine, kapan baris tampil (wajib). Dirender ke x-show='…',
              jadi di dalamnya pakai kutip GANDA.
  - colspan : jumlah kolom tabel (wajib)
  - isi lewat partial-block
--}}
<tr x-show='{{{show}}}'>
  <td
    colspan='{{colspan}}'
    class='border-b border-[#e5e5e5] px-6 py-16 text-center font-inter text-sm leading-5 text-[#a3a3a3]'
  >{{#if @partial-block}}{{> @partial-block}}{{/if}}</td>
</tr>
