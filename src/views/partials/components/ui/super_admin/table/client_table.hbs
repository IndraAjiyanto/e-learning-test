{{!--
  Komponen: Client Table State (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/table/client_table.hbs
  Level: L0 Skrip pendamping (scoped super_admin)

  Menyediakan factory Alpine `clientTable()`: search + pagination di sisi client,
  serta bulk selection & bulk delete dengan modal dan toast design system terbaru.
--}}
<script>
  // Membaca path bertitik ("categoryPartner.category") dengan aman
  function valueAt(row, path) {
    const value = path.split('.').reduce((acc, key) => (acc == null ? acc : acc[key]), row);
    return value == null ? '' : String(value);
  }

  function clientTable({ items, size, searchKeys, url, dataKey, sortKey, entityName, deleteEntity }) {
    const byKey = (list) =>
      sortKey
        ? list.sort((a, b) => valueAt(a, sortKey).localeCompare(valueAt(b, sortKey)))
        : list;
    const allItems = byKey(items || []);

    return {
      items: allItems,
      searchKeys: searchKeys || [],
      searchInput: '',
      filtered: allItems,
      currentPage: 1,
      size: size || 10,
      loading: Boolean(url),
      searchTimeout: null,
      raw: null,

      // Bulk delete states
      selectMode: false,
      selectedIds: [],
      entityName: entityName || '',
      deleteEntity: deleteEntity || '',

      toggleSelectMode() {
        this.selectMode = !this.selectMode;
        if (!this.selectMode) {
          this.selectedIds = [];
        }
      },

      resolveEntity() {
        if (this.deleteEntity) return this.deleteEntity;
        const p = window.location.pathname.replace(/^\/|\/$/g, '').split('/')[0];
        return p || 'data';
      },

      isAllSelected() {
        const list = this.rows || this.filtered || [];
        if (!list || list.length === 0) return false;
        return list.every((row) => this.selectedIds.some((id) => String(id) === String(row.id)));
      },

      toggleSelectAll(event) {
        const list = this.rows || this.filtered || [];
        if (event.target.checked) {
          const currentIds = list.map((r) => r.id);
          const currentSet = new Set(this.selectedIds.map(String));
          currentIds.forEach((id) => {
            if (!currentSet.has(String(id))) {
              this.selectedIds.push(id);
              currentSet.add(String(id));
            }
          });
        } else {
          const currentSet = new Set(list.map((r) => String(r.id)));
          this.selectedIds = this.selectedIds.filter((id) => !currentSet.has(String(id)));
        }
      },

      toggleSelectAllOnPage() {
        const list = this.rows || this.filtered || [];
        if (this.isAllSelected()) {
          const currentSet = new Set(list.map((r) => String(r.id)));
          this.selectedIds = this.selectedIds.filter((id) => !currentSet.has(String(id)));
        } else {
          const currentIds = list.map((r) => r.id);
          const currentSet = new Set(this.selectedIds.map(String));
          currentIds.forEach((id) => {
            if (!currentSet.has(String(id))) {
              this.selectedIds.push(id);
              currentSet.add(String(id));
            }
          });
        }
      },

      clearSelection() {
        this.selectedIds = [];
      },

      confirmDeleteSingle(item) {
        if (!item) return;
        const itemName = item.name || item.title || 'this item';
        const label = this.entityName
          ? (this.entityName.endsWith('ies')
              ? this.entityName.slice(0, -3) + 'y'
              : this.entityName.replace(/s$/, ''))
          : 'item';
        const capitalizedLabel = label.charAt(0).toUpperCase() + label.slice(1);

        if (typeof openDeleteModal === 'function') {
          openDeleteModal({
            title: `Delete ${capitalizedLabel}?`,
            description: `Are you sure you want to delete ${label} "${itemName}"? This action is permanent and cannot be undone.`,
            confirmLabel: 'Delete',
            cancelLabel: 'Cancel',
            onConfirm: async () => {
              await this.executeDeleteSingle(item.id);
            },
          });
        }
      },

      async executeDeleteSingle(id) {
        try {
          const entity = this.resolveEntity();
          const res = await fetch(`/${entity}/${id}`, {
            method: 'DELETE',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
            },
          });
          const json = await res.json().catch(() => null);

          if (json && json.success) {
            this.selectedIds = this.selectedIds.filter(
              (selectedId) => String(selectedId) !== String(id),
            );
            window.dispatchEvent(
              new CustomEvent('toast:success', {
                detail: {
                  title: 'Deleted Successfully',
                  description:
                    json.message || 'Item has been deleted successfully.',
                },
              }),
            );
            if (url) {
              await this.load();
            } else {
              setTimeout(() => {
                window.location.reload();
              }, 500);
            }
          } else {
            window.dispatchEvent(
              new CustomEvent('toast:error', {
                detail: {
                  title: 'Failed to Delete',
                  description: json?.message || 'Failed to delete item.',
                },
              }),
            );
          }
        } catch (err) {
          console.error('Delete single error:', err);
          window.dispatchEvent(
            new CustomEvent('toast:error', {
              detail: {
                title: 'Error',
                description:
                  'A network or server error occurred while deleting item.',
              },
            }),
          );
        }
      },

      confirmDeleteSelected() {
        const count = this.selectedIds.length;
        if (count === 0) return;
        const label = this.entityName || 'items';
        const displayLabel =
          count === 1
            ? label.endsWith('ies')
              ? label.slice(0, -3) + 'y'
              : label.replace(/s$/, '')
            : label;

        if (typeof openDeleteModal === 'function') {
          openDeleteModal({
            title: `Delete ${count} Selected ${displayLabel.charAt(0).toUpperCase() + displayLabel.slice(1)}?`,
            description: `Are you sure you want to delete ${count} selected ${displayLabel}? This action is permanent and cannot be undone.`,
            cancelLabel: 'Cancel',
            confirmLabel: `Delete (${count})`,
            onConfirm: async () => {
              await this.executeDeleteSelected();
            },
          });
        }
      },

      async executeDeleteSelected() {
        try {
          const res = await fetch('/api/bulk-delete/selected', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify({
              entity: this.resolveEntity(),
              ids: this.selectedIds,
            }),
          });
          const json = await res.json().catch(() => null);

          if (json && json.success) {
            this.selectedIds = [];
            window.dispatchEvent(
              new CustomEvent('toast:success', {
                detail: {
                  title: 'Deleted Successfully',
                  description:
                    json.message ||
                    'Selected data has been deleted successfully.',
                },
              }),
            );
            if (url) {
              await this.load();
            } else {
              setTimeout(() => {
                window.location.reload();
              }, 600);
            }
          } else {
            window.dispatchEvent(
              new CustomEvent('toast:error', {
                detail: {
                  title: 'Failed to Delete',
                  description:
                    json?.message ||
                    'An error occurred while deleting data.',
                },
              }),
            );
          }
        } catch (err) {
          window.dispatchEvent(
            new CustomEvent('toast:error', {
              detail: {
                title: 'Error',
                description:
                  'A network or server error occurred while deleting data.',
              },
            }),
          );
        }
      },

      confirmDeleteAll() {
        const total = (this.rows || this.filtered || this.items || []).length;
        if (total === 0) return;
        const label = this.entityName || 'items';

        if (typeof openDeleteModal === 'function') {
          openDeleteModal({
            title: `Delete ALL ${label.charAt(0).toUpperCase() + label.slice(1)}?`,
            description: `WARNING: You are about to delete ALL ${label} (${total} items). This action is permanent and cannot be undone!`,
            cancelLabel: 'Cancel',
            confirmLabel: 'Yes, Delete ALL',
            onConfirm: async () => {
              await this.executeDeleteAll();
            },
          });
        }
      },

      async executeDeleteAll() {
        try {
          const res = await fetch('/api/bulk-delete/all', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify({
              entity: this.resolveEntity(),
            }),
          });
          const json = await res.json().catch(() => null);

          if (json && json.success) {
            this.selectedIds = [];
            this.selectMode = false;
            window.dispatchEvent(
              new CustomEvent('toast:success', {
                detail: {
                  title: 'Deleted Successfully',
                  description:
                    json.message || 'All data has been deleted successfully.',
                },
              }),
            );
            if (url) {
              await this.load();
            } else {
              setTimeout(() => {
                window.location.reload();
              }, 600);
            }
          } else {
            window.dispatchEvent(
              new CustomEvent('toast:error', {
                detail: {
                  title: 'Failed to Delete',
                  description:
                    json?.message ||
                    'An error occurred while deleting all data.',
                },
              }),
            );
          }
        } catch (err) {
          window.dispatchEvent(
            new CustomEvent('toast:error', {
              detail: {
                title: 'Error',
                description:
                  'A network or server error occurred while deleting all data.',
              },
            }),
          );
        }
      },

      async load() {
        if (!url) return;

        this.loading = true;

        try {
          const response = await fetch(url);
          if (!response.ok) throw new Error(`Request failed with status ${response.status}`);

          const data = await response.json();
          this.raw = data;

          const list = dataKey ? data?.[dataKey] : data;

          if (!Array.isArray(list)) {
            console.error(
              `clientTable: ${url} tidak mengembalikan array` +
                (dataKey ? ` pada key "${dataKey}"` : '') +
                '. Tabel dirender kosong.',
            );
          }

          this.items = byKey(Array.isArray(list) ? list : []);
        } catch (error) {
          console.error('Failed to load table data:', error);
          this.raw = null;
          this.items = [];
        } finally {
          this.loading = false;
          this.currentPage = 1;
          this.applySearch(this.searchInput);
        }
      },

      valueAt,

      applySearch(keyword) {
        const needle = String(keyword || '').trim().toLowerCase();

        this.filtered = needle
          ? this.items.filter((row) =>
              this.searchKeys.some((path) => this.valueAt(row, path).toLowerCase().includes(needle)),
            )
          : this.items;

        if (this.currentPage > this.totalPages) this.currentPage = this.totalPages;
      },

      get totalPages() {
        return Math.max(1, Math.ceil(this.filtered.length / this.size));
      },

      get visiblePages() {
        const t = this.totalPages, c = this.currentPage;
        if (t <= 5) return Array.from({ length: t }, (_, i) => i + 1);
        if (c <= 3) return [1, 2, 3, '...', t];
        if (c >= t - 2) return [1, '...', t - 2, t - 1, t];
        return [1, '...', c - 1, c, c + 1, '...', t];
      },

      get rows() {
        const start = (this.currentPage - 1) * this.size;
        return this.filtered.slice(start, start + this.size);
      },

      handleSearch() {
        clearTimeout(this.searchTimeout);
        this.searchTimeout = setTimeout(() => {
          this.currentPage = 1;
          this.applySearch(this.searchInput);
        }, 300);
      },

      changePage(page) {
        if (page < 1 || page > this.totalPages) return;
        this.currentPage = page;
      },
    };
  }
</script>
