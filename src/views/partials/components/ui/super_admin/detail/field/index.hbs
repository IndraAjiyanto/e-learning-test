{{!--
  Komponen: Detail Field (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/detail/field/index.hbs
  Level: L1 Atomik (scoped super_admin)

  Satu pasangan label + isi pada halaman detail (read-only).

  Props:
  - label : string (wajib)
  - value : string
  - class : string (opsional) — class tambahan wrapper

  Isi custom (chip, gambar) dikirim lewat block; value diabaikan:
    {{#> components/ui/super_admin/detail/field/index label='Type Program'}}
      <span ...>...</span>
    {{/components/ui/super_admin/detail/field/index}}
--}}
<div class='flex flex-col gap-2{{#if class}} {{class}}{{/if}}'>
  <span class='font-montserrat text-sm font-semibold leading-5 text-[#171717]'>{{label}}</span>

  {{#if @partial-block}}
    {{> @partial-block}}
  {{else}}
    <p class='break-words font-montserrat text-sm font-medium leading-[22.75px] text-[#737373]'>{{default value '-'}}</p>
  {{/if}}
</div>
