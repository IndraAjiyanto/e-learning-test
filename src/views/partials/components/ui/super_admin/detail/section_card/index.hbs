{{!--
  Komponen: Detail Section Card (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/detail/section_card/index.hbs
  Level: L1 Atomik (scoped super_admin)

  Kartu putih berjudul dengan ikon bulat di halaman detail (read-only).
  Isi kartu dikirim lewat block.

  Props:
  - title        : string (wajib)
  - iconPaths    : string HTML (wajib) — isi <svg>, mis. '<circle cx="12" .../><path d="..."/>'
                   dirender apa adanya, jadi hanya boleh diisi markup statis dari template.
  - class        : string (opsional) — class tambahan wrapper
  - contentClass : string (default 'flex flex-col gap-5') — layout isi

  Contoh:
    {{#> components/ui/super_admin/detail/section_card/index
      title='Basic Information'
      iconPaths='<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/>'}}
      {{> components/ui/super_admin/detail/field/index label='Program Name' value=course.name }}
    {{/components/ui/super_admin/detail/section_card/index}}
--}}
<section class='flex h-fit w-full flex-col gap-6 rounded-xl border border-[#d9d9d9] bg-white p-5{{#if class}} {{class}}{{/if}}'>
  <div class='flex w-full items-center gap-2'>
    <span class='flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#003060] text-white' aria-hidden='true'>
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-5 w-5'>{{{iconPaths}}}</svg>
    </span>
    <h2 class='font-inter text-base font-semibold leading-6 text-[#003060]'>{{title}}</h2>
  </div>

  <div class='{{default contentClass "flex flex-col gap-5"}}'>
    {{> @partial-block}}
  </div>
</section>
