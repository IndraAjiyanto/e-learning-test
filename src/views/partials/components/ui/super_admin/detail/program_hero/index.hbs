{{!--
  Komponen: Program Hero (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/detail/program_hero/index.hbs
  Level: L1 Atomik (scoped super_admin)

  Kartu paling atas halaman detail program: tombol kembali, cover, judul,
  badge ringkas (kategori, status, sisa kuota) dan aksi Delete/Edit.

  Tombol kembali memakai `kelasPrevUrl` di localStorage — hanya diset oleh
  partials/category/kelas_tab saat detail dibuka dari tab Program milik sebuah
  kategori. Dari mana pun selain itu, tombol jatuh ke /program.

  Tombol Delete memanggil openDeleteModal dari modal/delete_confirm (bukan
  confirmDelete milik partial sweetalert global yang menimpa fungsi senama),
  jadi page WAJIB ikut memanggil modal tersebut.

  Props:
  - course     : Course entity (wajib) — name, description, image, quota, launch,
                 category, courseType, userCourses
  - categoryId : string (opsional) — dibawa ke tautan Edit bila detail dibuka dari kategori
--}}
<section
  class='flex h-fit w-full flex-col gap-3.5 rounded-xl border border-[#d9d9d9] bg-white p-5'
  x-data="{
    goBack() {
      const prevUrl = localStorage.getItem('kelasPrevUrl');
      if (prevUrl) localStorage.removeItem('kelasPrevUrl');
      window.location.href = prevUrl || '/program';
    }
  }"
>
  <a
    href='/program'
    @click.prevent='goBack()'
    class='inline-flex w-fit items-center gap-1 font-inter text-base font-medium leading-5 text-[#718096] transition-colors hover:text-[#003060] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40'
  >
    {{!-- lucide: chevron-left --}}
    <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' class='h-4 w-4'>
      <path d='m15 18-6-6 6-6' />
    </svg>
    Back to program
  </a>

  <div class='flex w-full flex-col gap-5 lg:flex-row'>
    <div class='flex h-[264px] w-full shrink-0 items-center justify-center overflow-hidden rounded-lg border border-[#d9d9d9] bg-[#f8f9fa] lg:w-[500px]'>
      {{#if course.image}}
        <img src='{{course.image}}' alt='Cover {{course.name}}' class='h-full w-full object-cover' />
      {{else}}
        <p class='font-inter text-xs font-medium leading-[18px] text-[#a3a3a3]'>No cover</p>
      {{/if}}
    </div>

    <div class='flex min-w-0 flex-1 flex-col justify-between gap-3 self-stretch'>
      <div class='flex w-full flex-col gap-4'>
        <div class='flex w-full flex-col gap-1'>
          <h1 class='font-inter text-[34px] font-bold leading-9 tracking-[-0.85px] text-[#003060]'>{{course.name}}</h1>
          {{> components/ui/super_admin/description/index
            class='font-inter text-sm font-medium leading-5 text-[#718096]'
            text=(default (getByLang course.description 'en') '-')
          }}
        </div>

        <div class='flex flex-wrap items-center gap-2'>
          <span class='inline-flex items-center rounded-2xl bg-[#f5f5f5] px-2 py-0.5 font-inter text-xs font-medium leading-[18px] text-[#404040]'>
            {{default course.category.name '-'}} &middot; {{default course.courseType.nameClassesType '-'}}
          </span>

          <span class='inline-flex items-center rounded-2xl px-2 py-0.5 font-inter text-xs font-medium leading-[18px] {{#if (eq course.process 'approved')}}bg-[#dcfce7] text-[#16a34a]{{else}}bg-[#fef3c7] text-[#d97706]{{/if}}'>
            {{#if (eq course.process 'approved')}}Approved{{else}}Pending{{/if}}
          </span>

          <span class='inline-flex items-center gap-1.5 rounded-2xl border border-[#f5f5f5] bg-white py-0.5 pl-1.5 pr-2 font-inter text-xs font-medium leading-[18px] text-[#171717]'>
            <span class='h-2 w-2 rounded-full bg-[#ef4444]' aria-hidden='true'></span>
            {{#if course.quota}}{{subtract course.quota (default course.userCourses.length 0)}}{{else}}-{{/if}} Seats Left
          </span>
        </div>
      </div>

      <div class='flex flex-wrap items-center gap-3'>
        <form
          action='/program/{{course.id}}?_method=DELETE'
          method='post'
          x-data="{
            hasUsers: {{default course.userCourses.length 0}},
            handleDelete(btn) {
              if (this.hasUsers > 0) {
                window.dispatchEvent(new CustomEvent('toast:error', {
                  detail: {
                    title: 'Gagal Menghapus Program',
                    description: 'program &quot;{{course.name}}&quot; tidak dapat dihapus karena masih memiliki ' + this.hasUsers + ' peserta. Hapus peserta tersebut terlebih dahulu.'
                  }
                }));
              } else {
                openDeleteModal(btn);
              }
            }
          }"
        >
          {{!-- Controller memakai `previous` untuk redirect balik ke list yang sama setelah hapus. --}}
          <input type='hidden' name='previous' :value="localStorage.getItem('kelasPrevUrl') || '/program'" />

          {{> components/ui/super_admin/form/button
            variant='danger-soft'
            label='Delete'
            atClick='handleDelete($el)'
          }}
        </form>

        {{#if categoryId}}
          {{> components/ui/super_admin/form/button
            as='link'
            href=(concat '/program/edit/' course.id '/' categoryId)
            label='Edit Program'
          }}
        {{else}}
          {{> components/ui/super_admin/form/button
            as='link'
            href=(concat '/program/edit/' course.id)
            label='Edit Program'
          }}
        {{/if}}
      </div>
    </div>
  </div>
</section>
