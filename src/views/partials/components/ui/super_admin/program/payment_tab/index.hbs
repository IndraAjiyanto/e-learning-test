{{!--
  Komponen: Program Payment Tab (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/program/payment_tab/index.hbs
  Level: L2 Section (scoped super_admin)

  Panel tab "Payment" di halaman detail program. Berbeda dari tab lain yang berupa
  tabel: isinya grid kartu pengajuan, karena tiap baris punya bukti transfer dan
  dua aksi keputusan — bukan sekadar data yang dibaca.

  Dua tingkat penyaringan:
  - sub-tab sumber data (Full Payment / Installment / Registration) yang tiap
    pergantiannya MENGAMBIL data baru, jadi tombolnya memakai tabs/fetch
  - filter status (All / Process / Accepted / Rejected) yang hanya menyaring data
    yang sudah ada, jadi tombolnya memakai tabs/panel dengan state 'tabStatus'

  Program gratis tidak punya pengajuan pembayaran: hanya sub-tab Registration yang
  dirender dan dipakai sebagai sumber awal.

  Halaman pemanggil WAJIB memuat sekali:
  - components/ui/super_admin/table/formatters  (formatDate)

  modal/detail dipanggil oleh komponen ini sendiri (kanal 'payment-proof').

  Props:
  - courseId  : string (wajib) — dipakai untuk semua endpoint
  - checkPaid : boolean (wajib) — true bila program berbayar
--}}
<div
  class='flex flex-col gap-5'
  x-data='paymentTab({{json courseId}}, {{#if checkPaid}}true{{else}}false{{/if}})'
  x-init='init()'
>
  <nav role='tablist' aria-label='Payment source' class='flex overflow-x-auto border-b border-[#d9d9d9]'>
    {{#if checkPaid}}
      {{> components/ui/super_admin/tabs/fetch/index
        name='payment'
        label='Full Payment'
        url=(concat '/program/payment/' courseId)
      }}
      {{> components/ui/super_admin/tabs/fetch/index
        name='installment'
        label='Installment'
        url=(concat '/program/paymentInstallment/' courseId)
      }}
    {{else}}
      {{> components/ui/super_admin/tabs/fetch/index
        name='register'
        label='Registration'
        url=(concat '/program/register/' courseId)
      }}
    {{/if}}
  </nav>

  <nav role='tablist' aria-label='Payment status' class='flex overflow-x-auto border-b border-[#d9d9d9]'>
    {{> components/ui/super_admin/tabs/panel/index name='all' label='All' state='tabStatus' }}
    {{> components/ui/super_admin/tabs/panel/index name='proces' label='Process' state='tabStatus' }}
    {{> components/ui/super_admin/tabs/panel/index name='acc' label='Accepted' state='tabStatus' }}
    {{> components/ui/super_admin/tabs/panel/index name='rejected' label='Rejected' state='tabStatus' }}
  </nav>

  <template x-if='loading'>
    <p class='py-16 text-center font-inter text-sm leading-5 text-[#a3a3a3]'>Loading submissions…</p>
  </template>

  <template x-if='!loading && visibleItems.length === 0'>
    <p class='py-16 text-center font-inter text-sm leading-5 text-[#a3a3a3]'>No submissions found.</p>
  </template>

  {{!-- Satu grid per sub-tab, di-x-show dari luar: kartunya beda rute aksi & label,
       dan nilai itu ditentukan saat render Handlebars, bukan saat runtime. --}}
  <div x-show="tab === 'payment'" class='grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3'>
    <template x-for='item in visibleItems' :key='item.id'>
      {{> components/ui/super_admin/card/payment/index
        actionBase='payment'
        label="'PAYMENT'"
        showNo=true
      }}
    </template>
  </div>

  <div x-show="tab === 'installment'" class='grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3'>
    <template x-for='item in visibleItems' :key='item.id'>
      {{> components/ui/super_admin/card/payment/index
        actionBase='payment'
        label="(item.installment?.month ?? '-') + ' MONTH PAYMENT'"
        showNo=true
      }}
    </template>
  </div>

  <div x-show="tab === 'register'" class='grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3'>
    <template x-for='item in visibleItems' :key='item.id'>
      {{> components/ui/super_admin/card/payment/index
        actionBase='registration'
        label="'REGISTRATION'"
      }}
    </template>
  </div>
</div>

{{#> components/ui/super_admin/modal/detail/index
  name='payment-proof'
  title='Payment Proof'
  maxWidth='max-w-[900px]'
}}
  <img
    :src='row.file'
    alt='Payment proof'
    class='max-h-[70vh] w-full rounded-xl border border-[#e5e5e5] bg-[#fafafa] object-contain'
  />
{{/components/ui/super_admin/modal/detail/index}}

<script>
  function paymentTab(courseId, checkPaid) {
    return {
      // Sub-tab aktif. Program gratis hanya punya 'register'.
      tab: checkPaid ? 'payment' : 'register',
      tabStatus: 'all',
      items: [],
      loading: true,

      init() {
        const url = checkPaid
          ? '/program/payment/' + courseId
          : '/program/register/' + courseId;

        this.toggleFetch(url, this.tab);
      },

      // Nama & tanda tangan ini adalah kontrak tabs/fetch: toggleFetch(url, name).
      async toggleFetch(url, name) {
        this.tab = name;
        this.loading = true;

        try {
          const response = await fetch(url);
          if (!response.ok) throw new Error(`Request failed with status ${response.status}`);

          const data = await response.json();
          this.items = Array.isArray(data) ? data : [];
        } catch (error) {
          // Grid dirender kosong; pesan empty state yang muncul, bukan halaman rusak.
          console.error('Failed to load payment submissions:', error);
          this.items = [];
        } finally {
          this.loading = false;
        }
      },

      // Penyaringan status dilakukan di sini, bukan lewat x-show per kartu:
      // dengan x-show kartu yang tersembunyi tetap dirender, dan pesan
      // "No submissions found" tidak pernah muncul saat sebuah status kosong.
      get visibleItems() {
        if (this.tabStatus === 'all') return this.items;
        return this.items.filter((item) => item.process === this.tabStatus);
      },
    };
  }
</script>
