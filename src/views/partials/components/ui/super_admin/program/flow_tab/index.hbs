{{!--
  Komponen: Program Flow Tab (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/program/flow_tab/index.hbs
  Level: L2 Section (scoped super_admin)

  Panel tab "Flow" di halaman detail program: search + tabel alur kelas
  + pagination. Datanya diambil sendiri dari GET /program/flow/:courseId,
  karena controller detail tidak ikut mengirimnya saat render.

  `lang` hidup di scope Alpine bersarang: getter `rows` dan `totalPages` milik
  clientTable() akan hilang bila state digabung.

  title & content dibaca sebagai objek { id, en, ja } mengikuti bentuk yang
  benar-benar tersimpan (form create/edit mengirim dan mem-prefill objek).
  Entity & DTO menuliskannya string[], tapi itu sudah usang — tidak ada
  ValidationPipe global yang menegakkannya.

  Halaman pemanggil WAJIB memuat sekali:
  - components/ui/super_admin/table/client_table  (factory clientTable)
  - components/ui/super_admin/modal/delete_confirm/index (openDeleteModal)

  Props:
  - courseId : string (wajib) — dipakai untuk endpoint, tombol create, dan aksi delete
--}}
<div
  class='flex flex-col gap-3.5'
  x-data='clientTable({ url: "/program/flow/" + {{json courseId}}, searchKeys: ["title.id", "title.en", "title.ja", "content.id", "content.en", "content.ja"] })'
  x-init='load()'
>
  {{> components/ui/super_admin/table/toolbar
    placeholder='Search flow..'
    searchLabel='Search program flow'
    createHref=(concat '/flow-program/formCreate/' courseId)
    createLabel='Add Flow'
    fullWidth=true
  }}

  {{!-- courseId masuk lewat state Alpine, bukan ditempel ke prop :action row_actions
       yang dirender mentah; json menghasilkan literal yang aman di dalam atribut. --}}
  <div class='flex flex-col gap-5' x-data='{ lang: "id", courseId: {{json courseId}} }'>
    {{> components/ui/super_admin/tabs/language/index ariaLabel='Program flow language' }}

    {{#> components/ui/super_admin/table/card tableClass='min-w-[1010px]'}}
      <colgroup>
        <col class='w-[66px]' />
        <col class='w-[73px]' />
        <col class='w-[377px]' />
        <col class='w-[378px]' />
        <col class='w-[116px]' />
      </colgroup>
      <thead>
        <tr>
          {{> components/ui/super_admin/table/header_cell label='No' }}
          {{> components/ui/super_admin/table/header_cell label='Flow' }}
          {{> components/ui/super_admin/table/header_cell label='Title' }}
          {{> components/ui/super_admin/table/header_cell label='Description' }}
          {{> components/ui/super_admin/table/header_cell label='Action' }}
        </tr>
      </thead>
      <tbody>
        <template x-for='(row, index) in rows' :key='row.id'>
          <tr class='transition-colors hover:bg-[#fafafa]'>

            {{> components/ui/super_admin/table/cell
              text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
            }}

            {{> components/ui/super_admin/table/cell text='row.sequence' }}

            {{#> components/ui/super_admin/table/cell}}
              <span
                class='block truncate font-inter text-sm leading-5 text-[#525252]'
                x-text="(row.title && row.title[lang]) || '—'"
              ></span>
            {{/components/ui/super_admin/table/cell}}

            {{#> components/ui/super_admin/table/cell}}
              <span
                class='block truncate font-inter text-sm leading-5 text-[#525252]'
                x-text="(row.content && row.content[lang]) || '—'"
              ></span>
            {{/components/ui/super_admin/table/cell}}

            {{#> components/ui/super_admin/table/cell variant='action'}}
              {{> components/ui/super_admin/table/row_actions
                entity='flow'
                deleteAction="'/flow-program/' + row.id + '/' + courseId + '?_method=DELETE'"
                editHref="'/flow-program/formEdit/' + row.id"
              }}
            {{/components/ui/super_admin/table/cell}}
          </tr>
        </template>

        {{#> components/ui/super_admin/table/message_row show='loading' colspan='5'}}
          Loading flows…
        {{/components/ui/super_admin/table/message_row}}

        {{#> components/ui/super_admin/table/message_row show='!loading && rows.length === 0' colspan='5'}}
          No flows found.
        {{/components/ui/super_admin/table/message_row}}
      </tbody>
    {{/components/ui/super_admin/table/card}}
  </div>
</div>
