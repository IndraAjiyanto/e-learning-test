{{!--
  Komponen: Program FAQ Tab (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/program/faq_tab/index.hbs
  Level: L2 Section (scoped super_admin)

  Panel tab "FAQ" di halaman detail program: search + tabel tanya-jawab
  + pagination. Datanya diambil sendiri dari GET /program/faq/:courseId,
  karena controller detail tidak ikut mengirimnya saat render.

  `lang` hidup di scope Alpine bersarang: getter `rows` dan `totalPages` milik
  clientTable() akan hilang bila state digabung.

  questions & answers dibaca sebagai objek { id, en, ja } sesuai yang tersimpan;
  entity course_question menuliskannya string[], tapi itu sudah usang.

  Halaman pemanggil WAJIB memuat sekali:
  - components/ui/super_admin/table/client_table  (factory clientTable)
  - components/ui/super_admin/modal/delete_confirm/index (openDeleteModal)

  Props:
  - courseId : string (wajib) — dipakai untuk endpoint, tombol create, dan aksi delete
--}}
<div
  class='flex flex-col gap-3.5'
  x-data='clientTable({ url: "/program/faq/" + {{json courseId}}, searchKeys: ["questions.id", "questions.en", "questions.ja", "answers.id", "answers.en", "answers.ja"] })'
  x-init='load()'
>
  {{> components/ui/super_admin/table/toolbar
    placeholder='Search FAQ..'
    searchLabel='Search program FAQ'
    createHref=(concat '/question-program/formCreate/' courseId)
    createLabel='Add FAQ'
    fullWidth=true
  }}

  {{!-- courseId masuk lewat state Alpine, bukan ditempel ke prop :action row_actions
       yang dirender mentah; json menghasilkan literal yang aman di dalam atribut. --}}
  <div class='flex flex-col gap-5' x-data='{ lang: "id", courseId: {{json courseId}} }'>
    {{> components/ui/super_admin/tabs/language/index ariaLabel='Program FAQ language' }}

    {{#> components/ui/super_admin/table/card tableClass='min-w-[1010px]'}}
      <colgroup>
        <col class='w-[66px]' />
        <col class='w-[414px]' />
        <col class='w-[414px]' />
        <col class='w-[116px]' />
      </colgroup>
      <thead>
        <tr>
          {{> components/ui/super_admin/table/header_cell label='No' }}
          {{> components/ui/super_admin/table/header_cell label='Question' }}
          {{> components/ui/super_admin/table/header_cell label='Answer' }}
          {{> components/ui/super_admin/table/header_cell label='Action' }}
        </tr>
      </thead>
      <tbody>
        <template x-for='(row, index) in rows' :key='row.id'>
          <tr class='transition-colors hover:bg-[#fafafa]'>

            {{> components/ui/super_admin/table/cell
              text='String((currentPage - 1) * size + index + 1).padStart(2, "0")'
            }}

            {{#> components/ui/super_admin/table/cell}}
              <span
                class='block truncate font-inter text-sm leading-5 text-[#525252]'
                x-text="(row.questions && row.questions[lang]) || '—'"
              ></span>
            {{/components/ui/super_admin/table/cell}}

            {{#> components/ui/super_admin/table/cell}}
              <span
                class='block truncate font-inter text-sm leading-5 text-[#525252]'
                x-text="(row.answers && row.answers[lang]) || '—'"
              ></span>
            {{/components/ui/super_admin/table/cell}}

            {{#> components/ui/super_admin/table/cell variant='action'}}
              {{> components/ui/super_admin/table/row_actions
                entity='FAQ'
                deleteAction="'/question-program/' + row.id + '/' + courseId + '?_method=DELETE'"
                editHref="'/question-program/formEdit/' + row.id"
              }}
            {{/components/ui/super_admin/table/cell}}
          </tr>
        </template>

        {{#> components/ui/super_admin/table/message_row show='loading' colspan='4'}}
          Loading FAQs…
        {{/components/ui/super_admin/table/message_row}}

        {{#> components/ui/super_admin/table/message_row show='!loading && rows.length === 0' colspan='4'}}
          No FAQs found.
        {{/components/ui/super_admin/table/message_row}}
      </tbody>
    {{/components/ui/super_admin/table/card}}
  </div>
</div>
