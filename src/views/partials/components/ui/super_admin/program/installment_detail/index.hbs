{{!--
  Komponen: Program Installment Detail View (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/program/installment_detail/index.hbs
  Level: L2 Section (scoped super_admin)

  Tampilan detail transaksi installment pada halaman detail program sesuai token Figma:
  - Container width 1052px, gap 28px
  - Title: Heading (Montserrat 700, 34px, #003060) & Sub heading (Montserrat 500, 16px, #718096)
  - Feature Card 1 (Payment Transaction Details):
    - White (#FFFFFF), border #D9D9D9, radius 12px, p-5
    - Header: Circle #003060 with 20px white icon + Title Montserrat 600, 16px
    - Header row: Payment Type (Montserrat 14px), Badge DP (#F0FDF4 text #15803D), Badge Termin (#E4F1F7 text #003060 with CaretDown)
    - Inner Card:
      - Header "Installment Plan" with ClockClockwise icon
      - Rows: Term N, Due Date, Nominal/Month, and Status badge + dot (Paid/Pending/Unpaid)
  - Feature Card 2 (Bottom Action Card):
    - White (#FFFFFF), border #D9D9D9, radius 12px, p-5, height 86px
    - Button 177px x 44px, Brand #003060, Inter 600 16px white ("Kembali")
--}}

<div class="flex flex-col items-start gap-7 w-full max-w-[1052px] mx-auto animate-fadeIn">
  <!-- Title Section -->
  <div class="flex flex-col items-start gap-1 w-full">
    <h1 class="font-montserrat font-bold text-[34px] leading-9 tracking-[-1px] text-[#003060]">
      Detail Cicilan Peserta
    </h1>
    <p class="font-montserrat font-medium text-base leading-5 text-[#718096]">
      <span x-text="selectedInstallment?.user_fullname || selectedInstallment?.user?.username || 'Peserta'"></span>
      —
      <span x-text="selectedInstallment?.course?.title || selectedInstallment?.course?.name || 'Program'"></span>
      (<span x-text="selectedInstallment?.invoice?.xendit_invoice_id || selectedInstallment?.no || ('INV/' + (selectedInstallment?.id ? selectedInstallment.id.substring(0,8).toUpperCase() : '—'))"></span>)
    </p>
  </div>

  <!-- Frame 2147229746: Cards Container -->
  <div class="flex flex-col items-start gap-4 w-full">
    <!-- Feature Card 1: Payment Transaction Details -->
    <div class="box-border flex flex-col items-start p-5 gap-6 w-full bg-white border border-[#D9D9D9] rounded-xl shadow-xs">
      <!-- Card Header Container -->
      <div class="flex flex-row items-center gap-2 w-full h-9">
        <div class="flex flex-row justify-center items-center w-9 h-9 bg-[#003060] rounded-full shrink-0">
          <!-- White Vector Icon (Receipt / Card) -->
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <rect width="20" height="14" x="2" y="5" rx="2" stroke-width="2"/>
            <line x1="2" x2="22" y1="10" y2="10" stroke-width="2"/>
          </svg>
        </div>
        <h2 class="font-montserrat font-semibold text-base leading-6 text-[#003060]">
          Payment Transaction Details
        </h2>
      </div>

      <!-- Frame 2147229576: Inner Body -->
      <div class="flex flex-col items-start gap-5 w-full">
        <!-- Container Header: Payment Type & Badges -->
        <div class="flex flex-col items-start gap-2 w-full">
          <!-- Frame 2147229617: Row Payment Type -->
          <div class="flex flex-row items-center justify-between w-full min-h-[28px] gap-2 flex-wrap">
            <span class="font-montserrat font-semibold text-sm leading-5 text-[#171717]">
              Payment Type
            </span>

            <div class="flex items-center gap-2">
              <!-- Badge DP -->
              <span
                class="inline-flex items-center justify-center px-3 py-1 rounded-2xl font-inter font-medium text-sm leading-5"
                :class="selectedInstallment?.dpPaidAt || selectedInstallment?.process === 'acc' || selectedInstallment?.process === 'approved'
                  ? 'bg-[#F0FDF4] text-[#15803D]'
                  : 'bg-[#FEFCE8] text-[#A16207]'"
              >
                <span x-text="selectedInstallment?.dpPaidAt || selectedInstallment?.process === 'acc' || selectedInstallment?.process === 'approved' ? 'DP Paid' : 'DP Pending'"></span>
              </span>

              <!-- Badge Skema Cicilan / Dropdown -->
              <span class="inline-flex items-center justify-center px-3 py-1 gap-1 rounded-2xl bg-[#E4F1F7] text-[#003060] font-inter font-medium text-sm leading-5">
                <span x-text="(selectedInstallment?.installment?.month || 3) + ' Bulan Cicilan'"></span>
                <!-- CaretDown Icon -->
                <svg class="w-4 h-4 text-[#003060]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </div>
          </div>

          <!-- Feature Card 1: Inner Installment Plan List -->
          <div class="flex flex-col items-start px-2 py-1 gap-3 w-full bg-white rounded-xl border border-slate-100">
            <!-- Frame 2147229582: Header Plan -->
            <div class="flex flex-row items-center gap-1.5 w-full h-10 border-b border-[#D9D9D9] pb-2">
              <!-- ClockClockwise Icon -->
              <svg class="w-5 h-5 text-[#003060] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              <span class="font-montserrat font-semibold text-sm leading-5 text-[#003060]">
                Installment Plan
              </span>
            </div>

            <!-- Dynamic Terms List (Term 1, Term 2, Term 3, ...) -->
            <div class="flex flex-col w-full">
              <template x-for="(price, idx) in (selectedInstallment?.installment?.price || [400000, 400000, 400000])" :key="idx">
                <div class="flex flex-row justify-between items-center w-full min-h-[42px] py-2 border-b border-[#D9D9D9] last:border-b-0 gap-4">
                  <!-- Left: Term Title & Due Date -->
                  <div class="flex flex-col items-start gap-px">
                    <span class="font-montserrat font-semibold text-sm leading-5 text-[#003060]" x-text="'Term ' + (idx + 1)"></span>
                    <span
                      class="font-montserrat font-medium text-sm leading-5 text-[#718096]"
                      x-text="selectedInstallment?.installment?.dueDates && selectedInstallment.installment.dueDates[idx]
                        ? ('Due ' + formatDate(selectedInstallment.installment.dueDates[idx]))
                        : ('Termin Bulan ke-' + (idx + 1))"
                    ></span>
                  </div>

                  <!-- Right: Amount/Month & Status Badge with Dot -->
                  <div class="flex flex-row items-center justify-end gap-2.5 shrink-0">
                    <span class="font-montserrat font-semibold text-sm leading-5 text-[#003060]" x-text="formatCurrency(price) + '/Month'"></span>

                    <!-- Status Badges with Dot -->
                    <!-- Approved / Paid -->
                    <template x-if="getTermStatus(selectedInstallment, idx + 1) === 'approved'">
                      <span class="inline-flex items-center h-[22px] gap-1.5 pl-1.5 pr-2 rounded-2xl bg-[#F0FDF4] text-[#15803D] font-inter font-medium text-xs leading-[18px]">
                        <span class="flex h-2 w-2 items-center justify-center shrink-0">
                          <span class="block w-1.5 h-1.5 rounded-full bg-[#22C55E] shrink-0"></span>
                        </span>
                        <span>Paid</span>
                      </span>
                    </template>

                    <!-- Pending / Process -->
                    <template x-if="getTermStatus(selectedInstallment, idx + 1) === 'process'">
                      <span class="inline-flex items-center h-[22px] gap-1.5 pl-1.5 pr-2 rounded-2xl bg-[#FFF7ED] text-[#A16207] font-inter font-medium text-xs leading-[18px]">
                        <span class="flex h-2 w-2 items-center justify-center shrink-0">
                          <span class="block w-1.5 h-1.5 rounded-full bg-[#F97316] shrink-0"></span>
                        </span>
                        <span>Pending</span>
                      </span>
                    </template>

                    <!-- Unpaid -->
                    <template x-if="getTermStatus(selectedInstallment, idx + 1) === 'unpaid' || !getTermStatus(selectedInstallment, idx + 1)">
                      <span class="inline-flex items-center h-[22px] gap-1.5 pl-1.5 pr-2 rounded-2xl bg-[#FAFAFA] text-[#404040] font-inter font-medium text-xs leading-[18px] border border-slate-200">
                        <span class="flex h-2 w-2 items-center justify-center shrink-0">
                          <span class="block w-1.5 h-1.5 rounded-full bg-[#737373] shrink-0"></span>
                        </span>
                        <span>Unpaid</span>
                      </span>
                    </template>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature Card 2: Bottom Action Card (Kembali) -->
    <div class="box-border flex flex-row justify-between items-center p-5 w-full h-[86px] bg-white border border-[#D9D9D9] rounded-xl shadow-xs">
      <div class="flex items-center gap-3">
        <!-- Optional back info / breadcrumb -->
        <span class="font-inter text-xs text-[#737373] hidden sm:inline">
          Menampilkan rincian skema termin cicilan peserta
        </span>
      </div>

      <!-- Section D: Primary Actions -->
      <div class="flex flex-row justify-end items-center gap-3">
        <button
          type="button"
          @click="selectedInstallment = null"
          class="box-border flex flex-row justify-center items-center px-[18px] py-2.5 gap-2 w-[177px] h-11 bg-[#003060] hover:bg-[#002244] border border-[#003060] rounded-lg shadow-[0px_1px_2px_rgba(0,0,0,0.05)] transition-all cursor-pointer"
        >
          <span class="font-inter font-semibold text-base leading-6 text-white text-center">
            Kembali
          </span>
        </button>
      </div>
    </div>
  </div>
</div>
