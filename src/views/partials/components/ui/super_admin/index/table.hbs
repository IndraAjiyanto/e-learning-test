{{!--
  Komponen: User Table Card (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/index/table.hbs
  Level: L2 Section (scoped super_admin)

  Figma: node 768:42381 — Table
  - card bg #ffffff, border 1px #e5e5e5, radius 12, shadow 0 1px 2px rgba(0,0,0,0.06)
  - header cell h44, px24 py12, bg #fafafa, border-bottom #e5e5e5, text Inter 12/18 #525252
  - lebar kolom: 88 / 297 / 297 / 120 / 135 / 116 (total 1052)

  Header "Name" pada Figma dipakai untuk kolom avatar → di sini dinamai "Profile"
  agar konsisten dengan field `user.profile`.

  Alpine (dari userTable()): loading, users, currentPage, totalPages
--}}
<div class='overflow-hidden rounded-xl border border-[#e5e5e5] bg-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.06)]'>
  <div class='overflow-x-auto'>
    <table class='w-full min-w-[1052px] table-fixed border-collapse text-left'>
      <colgroup>
        <col class='w-[88px]' />
        <col class='w-[297px]' />
        <col class='w-[297px]' />
        <col class='w-[120px]' />
        <col class='w-[135px]' />
        <col class='w-[116px]' />
      </colgroup>
      <thead>
        <tr class='bg-[#fafafa]'>
          <th scope='col' class='h-11 border-b border-[#e5e5e5] px-6 py-3 font-inter text-xs font-medium leading-[18px] text-[#525252]'>Profile</th>
          <th scope='col' class='h-11 border-b border-[#e5e5e5] px-6 py-3 font-inter text-xs font-medium leading-[18px] text-[#525252]'>Username</th>
          <th scope='col' class='h-11 border-b border-[#e5e5e5] px-6 py-3 font-inter text-xs font-medium leading-[18px] text-[#525252]'>Email address</th>
          <th scope='col' class='h-11 border-b border-[#e5e5e5] px-6 py-3 font-inter text-xs font-medium leading-[18px] text-[#525252]'>Role</th>
          <th scope='col' class='h-11 border-b border-[#e5e5e5] px-6 py-3 font-inter text-xs font-medium leading-[18px] text-[#525252]'>Status</th>
          <th scope='col' class='h-11 border-b border-[#e5e5e5] px-6 py-3 font-inter text-xs font-medium leading-[18px] text-[#525252]'>Action</th>
        </tr>
      </thead>
      <tbody>
        {{!-- Loading --}}
        <tr x-show='loading'>
          <td colspan='6' class='border-b border-[#e5e5e5] px-6 py-16 text-center font-inter text-sm leading-5 text-[#a3a3a3]'>
            <i class='fas fa-spinner fa-spin text-xl'></i>
          </td>
        </tr>

        {{!-- Rows --}}
        <template x-for='(user, index) in (loading ? [] : users)' :key='user.id'>
          {{> components/ui/super_admin/index/table_row }}
        </template>

        {{!-- Empty state --}}
        <tr x-show='!loading && users.length === 0'>
          <td colspan='6' class='border-b border-[#e5e5e5] px-6 py-16 text-center font-inter text-sm leading-5 text-[#a3a3a3]'>
            No users found.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  {{> components/ui/super_admin/index/pagination }}
</div>
