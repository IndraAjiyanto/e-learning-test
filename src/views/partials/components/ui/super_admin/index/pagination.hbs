{{!--
  Komponen: User Pagination (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/index/pagination.hbs
  Level: L1 Atomik (scoped super_admin)

  Figma: node 768:42614 — Pagination
  - pt12 pr24 pb16 pl24, space-between, items-center
  - Details "Page 1 of 10" Inter 14/20 #404040
  - Actions gap 12; tombol h36, px14 py8, radius 8, bg white, border #d4d4d4, text 14/20 #404040

  Alpine: currentPage, totalPages, changePage()
--}}
<div class='flex flex-col gap-3 pb-4 pl-6 pr-6 pt-3 sm:flex-row sm:items-center sm:justify-between'>
  <p class='font-inter text-sm leading-5 text-[#404040]'>
    Page <span x-text='currentPage'></span> of <span x-text='totalPages'></span>
  </p>

  <div class='flex items-center gap-3'>
    <button
      type='button'
      @click='changePage(currentPage - 1)'
      :disabled='currentPage <= 1'
      class='inline-flex h-9 items-center justify-center rounded-lg border border-[#d4d4d4] bg-white px-3.5 py-2 font-inter text-sm leading-5 text-[#404040] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#fafafa] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 active:bg-[#f5f5f5] disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-white'
    >
      Previous
    </button>
    <button
      type='button'
      @click='changePage(currentPage + 1)'
      :disabled='currentPage >= totalPages'
      class='inline-flex h-9 items-center justify-center rounded-lg border border-[#d4d4d4] bg-white px-3.5 py-2 font-inter text-sm leading-5 text-[#404040] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#fafafa] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#003060]/40 active:bg-[#f5f5f5] disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-white'
    >
      Next
    </button>
  </div>
</div>
