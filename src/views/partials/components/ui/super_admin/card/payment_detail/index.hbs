{{!--
  Komponen: Payment Detail Card (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/card/payment_detail/index.hbs
  Level: L2 Molekul (scoped super_admin)

  Kartu detail transaksi (Full Payment & Installment) sesuai token Figma (Frame 2147229586):
  - Luar: bg #F6F7F8, radius 14px, p-2.5 sm:p-3
  - Header: Nomor Invoice (INV/...) & Badge status dot
  - Card dalam: White (#FFFFFF), shadow 0px 1px 6px rgba(0,0,0,0.04), radius 8px, p-3
  - Info 2 Kolom: Name, Program Name, Email, Category, Phone, Keyword/Skema
  - Link Xendit: #2563EB
  - Data Cicilan (Khusus Installment): Status DP dan rincian tiap termin cicilan
  - Rincian Biaya: Subtotal/Harga, Potongan Diskon, dan Total Pembayaran
--}}
<div class="w-full bg-[#F6F7F8] rounded-[14px] p-2.5 sm:p-3 flex flex-col gap-3 border border-transparent hover:border-slate-300 transition-all">
  <!-- Header: Invoice No & Status Badge -->
  <div class="flex items-center justify-between gap-2 px-1">
    <div class="flex items-center gap-2">
      <span class="font-inter font-semibold text-[13px] leading-5 text-black tracking-[-0.325px]" x-text="item.invoice?.xendit_invoice_id || item.no || ('INV/' + (item.id ? item.id.substring(0,8).toUpperCase() : '—'))"></span>
      <template x-if="tab === 'installment' || item.installment">
        <span class="px-2 py-0.5 rounded bg-[#003060]/10 text-[#003060] font-inter text-xs font-semibold" x-text="(item.installment?.month || 3) + ' Bulan Cicilan'"></span>
      </template>
    </div>
    <div>
      <!-- Accepted / Approved -->
      <template x-if="item.process === 'acc' || item.process === 'approved'">
        <span class="inline-flex items-center h-[22px] gap-1.5 pl-1.5 pr-2 rounded-2xl bg-[#F0FDF4] text-[#15803D] font-inter font-medium text-xs leading-[18px]">
          <span class="flex h-2 w-2 items-center justify-center shrink-0">
            <span class="block w-1.5 h-1.5 rounded-full bg-[#22C55E] shrink-0"></span>
          </span>
          <span>Accepted</span>
        </span>
      </template>

      <!-- Process / Processing / Pending -->
      <template x-if="item.process === 'proces' || item.process === 'process' || item.process === 'pending'">
        <span class="inline-flex items-center h-[22px] gap-1.5 pl-1.5 pr-2 rounded-2xl bg-[#FEFCE8] text-[#A16207] font-inter font-medium text-xs leading-[18px]">
          <span class="flex h-2 w-2 items-center justify-center shrink-0">
            <span class="block w-1.5 h-1.5 rounded-full bg-[#EAB308] shrink-0"></span>
          </span>
          <span>Process</span>
        </span>
      </template>

      <!-- Rejected -->
      <template x-if="item.process === 'rejected' || (!item.process)">
        <span class="inline-flex items-center h-[22px] gap-1.5 pl-1.5 pr-2 rounded-2xl bg-[#FEF2F2] text-[#B91C1C] font-inter font-medium text-xs leading-[18px]">
          <span class="flex h-2 w-2 items-center justify-center shrink-0">
            <span class="block w-1.5 h-1.5 rounded-full bg-[#EF4444] shrink-0"></span>
          </span>
          <span>Rejected</span>
        </span>
      </template>
    </div>
  </div>

  <!-- Inner White Card -->
  <div class="bg-white rounded-lg p-3 shadow-[0px_1px_6px_rgba(0,0,0,0.04)] flex flex-col gap-3.5">
    <!-- 2 Column Info Grid -->
    <div class="flex flex-col gap-2.5">
      <!-- Row 1: Name & Program Name -->
      <div class="grid grid-cols-2 gap-2.5">
        <div class="flex flex-col gap-0.5">
          <span class="font-inter font-normal text-xs leading-4 text-[#737373]">Name</span>
          <span class="font-inter font-medium text-sm leading-5 text-[#404040] truncate" x-text="item.user_fullname || item.user?.username || '—'"></span>
        </div>
        <div class="flex flex-col gap-0.5">
          <span class="font-inter font-normal text-xs leading-4 text-[#737373]">Program Name</span>
          <span class="font-inter font-medium text-sm leading-5 text-[#404040] truncate" x-text="item.course?.title || item.course?.name || '—'"></span>
        </div>
      </div>

      <!-- Row 2: Email & Program Category -->
      <div class="grid grid-cols-2 gap-2.5">
        <div class="flex flex-col gap-0.5">
          <span class="font-inter font-normal text-xs leading-4 text-[#737373]">Email</span>
          <span class="font-inter font-medium text-sm leading-5 text-[#404040] truncate" x-text="item.user_email || item.user?.email || '—'"></span>
        </div>
        <div class="flex flex-col gap-0.5">
          <span class="font-inter font-normal text-xs leading-4 text-[#737373]">Program Category</span>
          <span class="font-inter font-medium text-sm leading-5 text-[#404040] truncate" x-text="item.course?.category?.name || 'Bootcamp'"></span>
        </div>
      </div>

      <!-- Row 3: Phone & Keyword / Skema -->
      <div class="grid grid-cols-2 gap-2.5">
        <div class="flex flex-col gap-0.5">
          <span class="font-inter font-normal text-xs leading-4 text-[#737373]">Phone</span>
          <span class="font-inter font-medium text-sm leading-5 text-[#404040] truncate" x-text="item.user_no || item.user?.no || '—'"></span>
        </div>
        <div class="flex flex-col gap-0.5">
          <span class="font-inter font-normal text-xs leading-4 text-[#737373]" x-text="(tab === 'installment' || item.installment) ? 'Skema Cicilan' : 'Keyword'"></span>
          <span class="font-inter font-medium text-sm leading-5 text-[#404040] truncate" x-text="(tab === 'installment' || item.installment) ? ((item.installment?.month || 3) + 'x Termin') : (item.referalSource || item.keyword || '—')"></span>
        </div>
      </div>

      <!-- Row 4: Xendit Link -->
      <div class="flex flex-col gap-0.5">
        <span class="font-inter font-normal text-xs leading-4 text-[#737373]">Xendit Link</span>
        <template x-if="item.invoice?.xendit_invoice_url">
          <a
            :href="item.invoice.xendit_invoice_url"
            target="_blank"
            rel="noopener noreferrer"
            class="font-inter font-normal text-sm leading-5 text-[#2563EB] hover:underline truncate"
            x-text="item.invoice.xendit_invoice_url"
          ></a>
        </template>
        <template x-if="!item.invoice?.xendit_invoice_url">
          <span class="font-inter font-normal text-sm leading-5 text-[#A3A3A3]">—</span>
        </template>
      </div>
    </div>

    <!-- Khusus Tab Installment: Detail Cicilan (Termin & Status) -->
    <template x-if="tab === 'installment' || item.installment">
      <div class="flex flex-col gap-2 pt-2.5 border-t border-[#E5E5E5]">
        <div class="flex items-center justify-between">
          <span class="font-inter font-semibold text-xs leading-4 text-[#003060]">Data Angsuran / Cicilan</span>
          <span class="font-inter text-xs font-medium text-[#737373]" x-text="(item.installment?.month || 3) + ' Bulan'"></span>
        </div>

        <!-- DP Item -->
        <div class="flex items-center justify-between bg-[#F6F7F8] px-2.5 py-1.5 rounded text-xs font-inter">
          <div class="flex items-center gap-1.5">
            <span class="block w-1.5 h-1.5 shrink-0 rounded-full" :class="item.dpPaidAt || item.process === 'acc' || item.process === 'approved' ? 'bg-[#22C55E]' : 'bg-[#EAB308]'"></span>
            <span class="font-medium text-[#404040]">Down Payment (DP)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#404040] font-medium" x-text="formatCurrency(item.installment?.downPayment || 0)"></span>
            <span
              class="px-2 py-0.5 rounded text-[11px] font-semibold"
              :class="item.dpPaidAt || item.process === 'acc' || item.process === 'approved' ? 'bg-[#F0FDF4] text-[#15803D]' : 'bg-[#FEFCE8] text-[#A16207]'"
              x-text="item.dpPaidAt || item.process === 'acc' || item.process === 'approved' ? 'Lunas' : 'Menunggu'"
            ></span>
          </div>
        </div>

        <!-- Monthly Terms -->
        <div class="flex flex-col gap-1.5">
          <template x-for="(price, idx) in (item.installment?.price || [])" :key="idx">
            <div class="flex items-center justify-between bg-[#F6F7F8] px-2.5 py-1.5 rounded text-xs font-inter">
              <div class="flex items-center gap-1.5">
                <span
                  class="block w-1.5 h-1.5 shrink-0 rounded-full"
                  :class="getTermStatus(item, idx + 1) === 'approved' ? 'bg-[#22C55E]' : (getTermStatus(item, idx + 1) === 'process' ? 'bg-[#EAB308]' : 'bg-slate-300')"
                ></span>
                <span class="font-medium text-[#404040]" x-text="'Termin ' + (idx + 1)"></span>
                <template x-if="item.installment?.dueDates && item.installment.dueDates[idx]">
                  <span class="text-[11px] text-[#737373]" x-text="'(' + formatDate(item.installment.dueDates[idx]) + ')'"></span>
                </template>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#404040] font-medium" x-text="formatCurrency(price)"></span>
                <span
                  class="px-2 py-0.5 rounded text-[11px] font-semibold"
                  :class="getTermStatus(item, idx + 1) === 'approved' ? 'bg-[#F0FDF4] text-[#15803D]' : (getTermStatus(item, idx + 1) === 'process' ? 'bg-[#FEFCE8] text-[#A16207]' : 'bg-slate-200 text-slate-600')"
                  x-text="getTermStatusLabel(item, idx + 1)"
                ></span>
              </div>
            </div>
          </template>
        </div>
      </div>
    </template>

    <!-- Breakdown Harga -->
    <div class="border-t border-[#E5E5E5] pt-3 pb-1 flex flex-col gap-2">
      <!-- Full Payment Breakdown -->
      <template x-if="!(tab === 'installment' || item.installment)">
        <div class="flex flex-col gap-2">
          <!-- Subtotal / Harga -->
          <div class="flex items-center justify-between">
            <span class="font-inter font-normal text-xs leading-4 text-[#737373]">Harga</span>
            <span class="font-inter font-normal text-sm leading-5 text-[#404040]" x-text="formatCurrency(item.invoice?.subtotal || item.course?.price || 0)"></span>
          </div>

          <!-- Discount -->
          <div class="flex items-center justify-between">
            <span class="font-inter font-normal text-xs leading-4 text-[#737373]">Discount</span>
            <span
              class="font-inter font-normal text-sm leading-5"
              :class="Number(item.invoice?.discount_amount) > 0 ? 'text-[#16A34A]' : 'text-[#737373]'"
              x-text="Number(item.invoice?.discount_amount) > 0 ? ('- ' + formatCurrency(item.invoice.discount_amount)) : 'Rp 0'"
            ></span>
          </div>

          <!-- Total -->
          <div class="flex items-center justify-between">
            <span class="font-inter font-normal text-xs leading-4 text-[#737373]">Total</span>
            <span class="font-inter font-medium text-sm leading-5 text-[#404040]" x-text="formatCurrency(item.invoice?.final_total || item.course?.price || 0)"></span>
          </div>
        </div>
      </template>

      <!-- Installment Breakdown -->
      <template x-if="tab === 'installment' || item.installment">
        <div class="flex flex-col gap-2">
          <!-- Down Payment -->
          <div class="flex items-center justify-between">
            <span class="font-inter font-normal text-xs leading-4 text-[#737373]">Down Payment (DP)</span>
            <span class="font-inter font-normal text-sm leading-5 text-[#404040]" x-text="formatCurrency(item.installment?.downPayment || 0)"></span>
          </div>

          <!-- Total Cicilan Bulanan -->
          <div class="flex items-center justify-between">
            <span class="font-inter font-normal text-xs leading-4 text-[#737373]">Total Angsuran</span>
            <span class="font-inter font-normal text-sm leading-5 text-[#404040]" x-text="formatCurrency((item.installment?.price || []).reduce((a, b) => Number(a) + Number(b), 0))"></span>
          </div>

          <!-- Total Keseluruhan Program -->
          <div class="flex items-center justify-between">
            <span class="font-inter font-normal text-xs leading-4 text-[#737373]">Total Program</span>
            <span class="font-inter font-medium text-sm leading-5 text-[#404040]" x-text="formatCurrency((Number(item.installment?.downPayment || 0) + (item.installment?.price || []).reduce((a, b) => Number(a) + Number(b), 0)) || item.invoice?.final_total || 0)"></span>
          </div>

          <!-- View Detail Action Button (Figma Frame 2147229722 _Button base) -->
          <div class="pt-2 border-t border-[#E5E5E5] flex justify-center w-full">
            <a
              :href="'/payment/' + item.id"
              class="box-border flex flex-row justify-center items-center px-[18px] py-2.5 gap-2 w-full h-11 bg-white hover:bg-slate-50 border border-[#003060] rounded-lg shadow-[0px_1px_2px_rgba(0,0,0,0.05)] transition-colors text-decoration-none"
            >
              <span class="font-inter font-medium text-base leading-6 text-[#003060] text-center">
                View Detail
              </span>
            </a>
          </div>
        </div>
      </template>
    </div>
  </div>
</div>
