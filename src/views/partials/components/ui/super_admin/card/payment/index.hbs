{{!--
  Komponen: Payment Card (Super Admin)
  Lokasi: src/views/partials/components/ui/super_admin/card/payment/index.hbs
  Level: L1 Atomik (scoped super_admin)

  Satu kartu pengajuan pembayaran / pendaftaran: identitas pengaju, bukti transfer,
  dan tombol Accept / Reject. Dipakai tiga varian tab Payment (full payment,
  installment, registration) — yang membedakan hanya label, rute aksi, dan
  apakah nomor pengajuan ditampilkan.

  Dirender di dalam <template x-for='item in ...'>, jadi membaca state `item`.
  Tombol bukti transfer membuka modal/detail kanal 'payment-proof'.

  Accept / Reject memakai <form> PATCH yang sudah ada — tidak ada fetch baru,
  dan halaman reload seperti sebelumnya.

  Props:
  - actionBase : string (wajib) — 'payment' atau 'registration', dasar rute aksi
  - label      : string (wajib) — ekspresi Alpine untuk teks pill. Dirender ke
                 atribut ber-kutip GANDA, jadi di dalam ekspresi pakai kutip
                 TUNGGAL, mis. "'PAYMENT'" atau
                 "item.installment?.month + ' MONTH PAYMENT'"
  - showNo     : boolean — tampilkan nomor pengajuan (item.no)
--}}
<div
  class='relative flex flex-col gap-5 rounded-xl border bg-white p-5 transition-colors'
  :class="item.process === 'acc' ? 'border-[#16a34a]/30 bg-[#f0fdf4]' : item.process === 'rejected' ? 'border-[#dc2626]/30 bg-[#fef2f2]' : 'border-[#e5e5e5] bg-white'"
>
  <div class='flex items-start justify-between gap-3'>
    <span
      class='inline-flex w-fit items-center rounded-lg bg-[#f5f5f5] px-2.5 py-1 font-inter text-xs font-semibold leading-[18px] text-[#404040]'
      x-text="{{{label}}}"
    ></span>

    <span
      class='inline-flex shrink-0 items-center rounded-2xl px-2.5 py-0.5 font-inter text-xs font-semibold leading-[18px]'
      :class="item.process === 'acc' ? 'bg-[#dcfce7] text-[#15803d]' : item.process === 'rejected' ? 'bg-[#fee2e2] text-[#b91c1c]' : 'bg-[#fef3c7] text-[#b45309]'"
      x-text="item.process === 'acc' ? 'Accepted' : item.process === 'rejected' ? 'Rejected' : 'Processing'"
    ></span>
  </div>

  <div class='flex flex-col gap-2'>
    <div class='flex flex-col gap-0.5'>
      <span class='font-inter text-xs font-medium leading-[18px] text-[#737373]'>Name</span>
      <span class='font-inter text-sm leading-5 text-[#171717]' x-text='item.user?.username || "—"'></span>
    </div>

    <div class='flex flex-col gap-0.5'>
      <span class='font-inter text-xs font-medium leading-[18px] text-[#737373]'>Email</span>
      <span class='break-all font-inter text-sm leading-5 text-[#525252]' x-text='item.user?.email || "—"'></span>
    </div>

    {{#if showNo}}
      <div class='flex flex-col gap-0.5'>
        <span class='font-inter text-xs font-medium leading-[18px] text-[#737373]'>Submission No</span>
        <span class='font-inter text-sm leading-5 text-[#525252]' x-text='item.no ?? "—"'></span>
      </div>
    {{/if}}

    <div class='flex flex-col gap-0.5'>
      <span class='font-inter text-xs font-medium leading-[18px] text-[#737373]'>Submitted At</span>
      <span class='font-inter text-sm leading-5 text-[#525252]' x-text='formatDate(item.createdAt)'></span>
    </div>
  </div>

  <template x-if='item.file'>
    <button
      type='button'
      @click="openDetailModal('payment-proof', item)"
      class='inline-flex h-11 w-full items-center justify-center gap-2 rounded-lg border border-[#d4d4d4] bg-white px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-[#404040] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#a3a3a3] hover:bg-[#f5f5f5] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#404040]/40'
    >
      {{!-- lucide: image --}}
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.67' stroke-linecap='round' stroke-linejoin='round' class='h-5 w-5'>
        <rect width='18' height='18' x='3' y='3' rx='2' ry='2' />
        <circle cx='9' cy='9' r='2' />
        <path d='m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21' />
      </svg>
      View Proof
    </button>
  </template>

  {{!-- Aksi mengikuti status: yang masih diproses boleh dua-duanya, yang sudah
       diputuskan hanya menawarkan kebalikannya. --}}
  <div class='flex items-center gap-3'>
    <template x-if="item.process !== 'acc'">
      <form :action="'/{{actionBase}}/acc/' + item.id + '?_method=PATCH'" method='post' class='flex-1'>
        <button
          type='submit'
          class='inline-flex h-11 w-full items-center justify-center rounded-lg border border-[#16a34a] bg-[#16a34a] px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#15803d] hover:bg-[#15803d] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#16a34a]/40 focus-visible:ring-offset-2'
        >Accept</button>
      </form>
    </template>

    <template x-if="item.process !== 'rejected'">
      <form :action="'/{{actionBase}}/rejected/' + item.id + '?_method=PATCH'" method='post' class='flex-1'>
        <button
          type='submit'
          class='inline-flex h-11 w-full items-center justify-center rounded-lg border border-[#d4d4d4] bg-white px-[18px] py-2.5 font-inter text-base font-semibold leading-6 text-[#dc2626] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:border-[#dc2626] hover:bg-[#fef2f2] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#dc2626]/40 focus-visible:ring-offset-2'
        >Reject</button>
      </form>
    </template>
  </div>
</div>
