{{!--
  Komponen: Alert (Level 1 - UI Dasar)
  Lokasi: src/views/partials/components/ui/alert/index.hbs

  Menampilkan pesan notifikasi (success/error/warning/info) yang reusable.

  Props:
  - type        : success | error | warning | info (default: info)
  - message     : Pesan yang ditampilkan (wajib)
  - title       : Judul alert (opsional)
  - dismissible : Boolean tombol close (default: true)
  - class       : Kelas tambahan pembungkus (default: "mb-4 sm:mb-6")
  - icon        : Kelas FontAwesome custom (opsional, auto berdasarkan type
                  jika tidak diisi)
--}}

{{#if (eq type 'success')}}
  <div role="alert" class="p-3 sm:p-4 rounded-xl bg-green-900/20 sm:bg-green-900/30 border border-green-500/40 text-xs sm:text-sm {{default class 'mb-4 sm:mb-6'}}">
    <div class="flex items-start gap-3">
      <i class="fas {{default icon 'fa-circle-check'}} mt-0.5 text-green-500"></i>
      <div class="flex-1 flex flex-col">
        {{#if title}}<p class="font-medium text-green-700 sm:text-green-200">{{title}}</p>{{/if}}
        <p class="font-medium text-green-700 sm:text-green-200">{{message}}</p>
      </div>
      {{#if dismissible}}
        <button type="button" onclick="this.parentElement.parentElement.style.display='none'" class="flex-shrink-0 text-green-500 hover:text-green-400 transition-colors">
          <i class="fas fa-xmark"></i>
        </button>
      {{/if}}
    </div>
  </div>
{{else if (eq type 'error')}}
  <div role="alert" class="p-3 sm:p-4 rounded-xl bg-red-900/20 sm:bg-red-900/30 border border-red-500/40 text-xs sm:text-sm {{default class 'mb-4 sm:mb-6'}}">
    <div class="flex items-start gap-3">
      <i class="fas {{default icon 'fa-circle-exclamation'}} mt-0.5 text-red-500"></i>
      <div class="flex-1 flex flex-col">
        {{#if title}}<p class="font-medium text-red-700 sm:text-red-200">{{title}}</p>{{/if}}
        <p class="font-medium text-red-700 sm:text-red-200">{{message}}</p>
      </div>
      {{#if dismissible}}
        <button type="button" onclick="this.parentElement.parentElement.style.display='none'" class="flex-shrink-0 text-red-500 hover:text-red-400 transition-colors">
          <i class="fas fa-xmark"></i>
        </button>
      {{/if}}
    </div>
  </div>
{{else if (eq type 'warning')}}
  <div role="alert" class="p-3 sm:p-4 rounded-xl bg-yellow-900/20 sm:bg-yellow-900/30 border border-yellow-500/40 text-xs sm:text-sm {{default class 'mb-4 sm:mb-6'}}">
    <div class="flex items-start gap-3">
      <i class="fas {{default icon 'fa-triangle-exclamation'}} mt-0.5 text-yellow-500"></i>
      <div class="flex-1 flex flex-col">
        {{#if title}}<p class="font-medium text-yellow-700 sm:text-yellow-200">{{title}}</p>{{/if}}
        <p class="font-medium text-yellow-700 sm:text-yellow-200">{{message}}</p>
      </div>
      {{#if dismissible}}
        <button type="button" onclick="this.parentElement.parentElement.style.display='none'" class="flex-shrink-0 text-yellow-500 hover:text-yellow-400 transition-colors">
          <i class="fas fa-xmark"></i>
        </button>
      {{/if}}
    </div>
  </div>
{{else}}
  <div role="alert" class="p-3 sm:p-4 rounded-xl bg-blue-900/20 sm:bg-blue-900/30 border border-blue-500/40 text-xs sm:text-sm {{default class 'mb-4 sm:mb-6'}}">
    <div class="flex items-start gap-3">
      <i class="fas {{default icon 'fa-circle-info'}} mt-0.5 text-blue-500"></i>
      <div class="flex-1 flex flex-col">
        {{#if title}}<p class="font-medium text-blue-700 sm:text-blue-200">{{title}}</p>{{/if}}
        <p class="font-medium text-blue-700 sm:text-blue-200">{{message}}</p>
      </div>
      {{#if dismissible}}
        <button type="button" onclick="this.parentElement.parentElement.style.display='none'" class="flex-shrink-0 text-blue-500 hover:text-blue-400 transition-colors">
          <i class="fas fa-xmark"></i>
        </button>
      {{/if}}
    </div>
  </div>
{{/if}}
