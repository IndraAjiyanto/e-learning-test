<div class="w-full flex justify-center items-center">
  <h2 
  class="text-4xl md:text-5xl mt-0 mb-0 font-bold leading-tight font-montserrat {{textColor}}"
>
  {{!-- Text before highlight --}}
  {{before}}

  {{!-- Dynamic highlight using Tailwind classes --}}
  <span 
    class="py-1 px-2 rounded-md {{bg}} {{color}}"
  >
    {{highlight}}
  </span>

  {{!-- Text after highlight --}}
  {{after}}
</h2>
</div>
