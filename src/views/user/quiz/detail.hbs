<div class="max-w-4xl mx-auto pt-28 px-6">
  <h2 class="text-2xl font-bold mb-6 font-montserrat">
    Detail Quiz Pertemuan {{session.sessionOrder}}
  </h2>

  {{#each questions}}
  <div class="p-6 mb-6 border rounded-xl bg-white shadow">
    <p class="font-medium text-gray-800 mb-4">
       {{questionText}}
    </p>

    <div class="space-y-2">
      {{#each answers}}
      <div
        class="px-4 py-2 rounded-lg border border-gray-200 bg-gray-50 text-gray-700">
        {{answer}}
      </div>
      {{/each}}
    </div>
  </div>
  {{/each}}

  <div class="p-6 border-t text-right">
    <p class="text-xl font-bold">
      Nilai Kamu: {{scores}}
    </p>
  </div>
</div>
