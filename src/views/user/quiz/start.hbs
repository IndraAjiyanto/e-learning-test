{{#> user/shell_frame/index user=user active='learning' pageTitle=(t 'test.startLearning.quiz')}}
<div class="min-h-full px-4 pb-10 pt-6 sm:px-8">

{{> user/quiz/start/header}}

{{> user/quiz/start/content}}
</div>

<script>
let saveTimeout;

document.addEventListener("change", function(e){

    if(e.target.type === "radio"){

        const radio = e.target;
        const name = radio.name;
        const value = radio.value;

        const questionId = name.replace("q-", "");

        // simpan ke localStorage dulu
        localStorage.setItem(name, value);

        // hentikan timer sebelumnya
        clearTimeout(saveTimeout);

        // tunggu user berhenti klik
        saveTimeout = setTimeout(async () => {

            try {

                const response = await fetch("/answer-users/chose-answer", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        userId: '{{user.id}}',
                        questionsId: questionId,
                        answersId: value
                    })
                });

                if(!response.ok){
                    throw new Error("Server error");
                }

            } catch(err){

                console.error("Autosave gagal", err);

                // kosongkan pertanyaan
       document.querySelectorAll(`input[name="${name}"]`)
.forEach(r => {
    r.checked = false;
    r.dispatchEvent(new Event('change', { bubbles: true }));
});

                localStorage.removeItem(name);

            }

        }, 700);

    }

});
</script>

<script>
document.addEventListener("DOMContentLoaded", function(){

    const form = document.querySelector('#formSubmit');
    const radios = document.querySelectorAll("input[type='radio']");

    radios.forEach(radio => {

        const savedValue = localStorage.getItem(radio.name);

        if(savedValue && savedValue === radio.value){
            radio.checked = true;
            radio.dispatchEvent(new Event('change', { bubbles: true }));
        }

    });

    function clearQuizStorage(){
        Object.keys(localStorage)
        .filter(key => key.startsWith("q-"))
        .forEach(key => localStorage.removeItem(key));
    }

    // saat submit biasa
    form.addEventListener("submit", clearQuizStorage);

    // kalau submit via timer
    window.clearQuizStorage = clearQuizStorage;

});
</script>

<script>
    function quiz() {
        return {
            currentQuestion: 0,
            answeredQuestions: [],
            
            init() {
                this.$el.addEventListener('change', (e) => {
                    if (e.target.type === 'radio') {
                        this.updateAnsweredStatus();
                    }
                });
                this.updateAnsweredStatus();
            },
            
            updateAnsweredStatus() {
                const questionIds = [{{#each pertanyaan}}{{#unless @first}},{{/unless}}"{{id}}"{{/each}}];
                this.answeredQuestions = questionIds.map((qId, index) => {
                    const input = this.$el.querySelector(`input[name="q-${qId}"]:checked`);
                    return input !== null;
                });
            },
            
            get answeredCount() {
                return this.answeredQuestions.filter(answered => answered).length;
            },
            
            nextQuestion() {
                if (this.currentQuestion < {{pertanyaan.length}} - 1) {
                    this.currentQuestion++;
                }
            },
            
            prevQuestion() {
                if (this.currentQuestion > 0) {
                    this.currentQuestion--;
                }
            },
            
            isAnswered(index) {
                return this.answeredQuestions[index] || false;
            }
        }
    }
</script>

<script>
function prepareAndSubmit() {
    try {
        if (typeof window.clearQuizStorage === "function") {
            window.clearQuizStorage();
        }
    } catch (e) {}

    const form = document.getElementById('formSubmit');
    if (!form) return;

    form.querySelectorAll('input[name^="answerUser"]').forEach((el) => el.remove());

    const userId = '{{user.id}}';
    const checked = form.querySelectorAll('input[type="radio"]:checked');

    checked.forEach((radio, index) => {
        const questionId = radio.name.replace("q-", "");
        const append = (name, value) => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = value;
            form.appendChild(input);
        };
        append(`answerUser[${index}][userId]`, userId);
        append(`answerUser[${index}][questionsId]`, questionId);
        append(`answerUser[${index}][answersId]`, radio.value);
    });

    form.submit();
}

function confirmQuizSubmit() {
    Swal.fire({
        title: "Confirmation",
        text: "Are you sure you want to submit your answers?",
        icon: "info",
        showCancelButton: true,
        buttonsStyling: false,
        confirmButtonText: "Yes, continue",
        cancelButtonText: "Cancel",
        customClass: {
            confirmButton: "px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition",
            cancelButton: "px-4 py-2 rounded-lg bg-gray-200 text-gray-700 font-medium hover:bg-gray-300 transition",
            actions: "flex gap-4 justify-center"
        }
    }).then((result) => {
        if (result.isConfirmed) prepareAndSubmit();
    });
}

function timeOverSubmit() {
    Swal.fire({
        title: "Time's Up!",
        text: "Quiz time is over, submitting your answers.",
        icon: "info",
        customClass: {
            confirmButton: "px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition",
        },
    }).then((result) => {
        if (result.isConfirmed) prepareAndSubmit();
    });
}
</script>
