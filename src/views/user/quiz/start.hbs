<div class="min-h-full px-4 pb-10 pt-6 sm:px-8">

{{> user/quiz/start/header}}

<!-- Banner peringatan jika sesi login habis di tengah pengerjaan -->
<div id="sessionExpiredAlert" class="mt-4 hidden rounded-xl border border-[#FCD34D] bg-[#FEF3C7] p-4 text-[#92400E] shadow-sm">
  <div class="flex flex-wrap items-center gap-3">
    <i class="fa-solid fa-triangle-exclamation text-lg text-[#D97706]"></i>
    <div class="min-w-0 flex-1 text-sm font-medium">
      <span>Sesi login Anda telah habis atau koneksi terputus. Jawaban Anda <strong>tetap tersimpan aman di browser ini</strong>.</span>
      <a href="/login" target="_blank" class="ml-2 inline-flex items-center gap-1 font-bold text-[#B45309] underline hover:text-[#78350F]">
        Buka Tab Baru untuk Login Ulang <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
      </a>
    </div>
  </div>
</div>

{{> user/quiz/start/content}}
</div>

{{> components/ui/admin/modal/confirm_action/index}}
{{> components/ui/user/modal/time_over/index}}

<script>
const currentUserId = '{{user.id}}';
const currentQuizId = '{{quizId}}';

function getStorageKey(questionId) {
    return `quiz_${currentQuizId}_user_${currentUserId}_q_${questionId}`;
}

function showSessionExpiredNotification() {
    const el = document.getElementById('sessionExpiredAlert');
    if (el) el.classList.remove('hidden');
}

function hideSessionExpiredNotification() {
    const el = document.getElementById('sessionExpiredAlert');
    if (el) el.classList.add('hidden');
}

let saveTimeout;

document.addEventListener("change", function(e){

    if(e.target.type === "radio"){

        const radio = e.target;
        const name = radio.name;
        const value = radio.value;

        const questionId = name.replace("q-", "");

        // Simpan ke localStorage dengan namespace user & quiz agar tidak bocor ke user lain
        localStorage.setItem(getStorageKey(questionId), value);

        // Hentikan timer sebelumnya
        clearTimeout(saveTimeout);

        // Tunggu user selesai klik
        saveTimeout = setTimeout(async () => {

            try {

                const response = await fetch("/answer-users/chose-answer", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        userId: currentUserId,
                        questionsId: questionId,
                        answersId: value
                    })
                });

                if (response.status === 401 || response.redirected) {
                    showSessionExpiredNotification();
                    return;
                }

                if(!response.ok){
                    throw new Error("Server error " + response.status);
                }

                hideSessionExpiredNotification();

            } catch(err){

                console.warn("Autosave ke server tertunda (koneksi/sesi)", err);

                // JANGAN kosongkan pilihan dan JANGAN hapus dari localStorage!
                // Jawaban tetap aman di localStorage khusus user ini.
                showSessionExpiredNotification();

            }

        }, 700);

    }

});
</script>

<script>
document.addEventListener("DOMContentLoaded", function(){

    const form = document.querySelector('#formSubmit');
    const radios = document.querySelectorAll("input[type='radio']");

    // 1. Bersihkan cache kuis dari user lain di browser ini (isolasi privasi)
    const currentPrefix = `quiz_${currentQuizId}_user_${currentUserId}_`;
    const quizPrefix = `quiz_${currentQuizId}_user_`;

    try {
        Object.keys(localStorage).forEach(key => {
            // Hapus cache kuis ini yang bukan milik user yang sedang login
            if (key.startsWith(quizPrefix) && !key.startsWith(currentPrefix)) {
                localStorage.removeItem(key);
            }
            // Bersihkan format lama yang tanpa namespace user
            if (key.startsWith("q-")) {
                localStorage.removeItem(key);
            }
        });

        // Jika bukan sesi lanjutan (isOngoing false), artinya ini percobaan baru / pengerjaan ulang (retake).
        // Bersihkan sisa localStorage kuis sebelumnya agar jawaban lama tidak muncul kembali.
        const isOngoingSession = {{ternary isOngoing 'true' 'false'}};
        if (!isOngoingSession) {
            Object.keys(localStorage)
                .filter(key => key.startsWith(currentPrefix))
                .forEach(key => localStorage.removeItem(key));
        }
    } catch (e) {}

    // 2. Pre-load jawaban dari database (jika user pernah menjawab) atau dari localStorage
    let serverSavedAnswers = {};
    try {
        serverSavedAnswers = {{{jsonSafe (default savedAnswers (obj))}}} || {};
    } catch (e) {
        serverSavedAnswers = {};
    }

    radios.forEach(radio => {
        const questionId = radio.name.replace("q-", "");
        const storageKey = getStorageKey(questionId);

        const localSaved = localStorage.getItem(storageKey);
        const serverSaved = serverSavedAnswers[questionId];

        // Prioritas: localStorage (jika ada jawaban offline terbaru), jika tidak ada gunakan server
        const valToUse = localSaved || serverSaved;

        if(valToUse && valToUse === radio.value){
            radio.checked = true;
            // Sinkronkan ke localStorage jika sebelumnya belum ada di lokal
            if (!localSaved && serverSaved) {
                localStorage.setItem(storageKey, serverSaved);
            }
        }
    });

    // Beritahu komponen Alpine untuk memperbarui status nomor soal terjawab
    window.dispatchEvent(new CustomEvent('quiz:answers-loaded'));

    // 3. Bersihkan HANYA storage milik user aktif saat submit selesai
    function clearQuizStorage(){
        try {
            Object.keys(localStorage)
                .filter(key => key.startsWith(currentPrefix))
                .forEach(key => localStorage.removeItem(key));
        } catch (e) {}
    }

    if (form) {
        form.addEventListener("submit", clearQuizStorage);
    }
    window.clearQuizStorage = clearQuizStorage;

    // 4. Heartbeat ping setiap 1.5 menit untuk mencegah sesi logout tak terduga
    setInterval(async () => {
        try {
            const res = await fetch('/auth/ping');
            if (res.status === 401 || !res.ok) {
                showSessionExpiredNotification();
            } else {
                hideSessionExpiredNotification();
            }
        } catch (e) {}
    }, 90 * 1000);

});
</script>

<script>
    function quiz() {
        return {
            currentQuestion: 0,
            answeredQuestions: [],
            
            init() {
                this.$el.addEventListener('change', (e) => {
                    if (e.target.type === 'radio') {
                        this.updateAnsweredStatus();
                    }
                });
                window.addEventListener('quiz:answers-loaded', () => {
                    this.updateAnsweredStatus();
                });
                this.updateAnsweredStatus();
            },
            
            updateAnsweredStatus() {
                const questionIds = [{{#each pertanyaan}}{{#unless @first}},{{/unless}}"{{id}}"{{/each}}];
                this.answeredQuestions = questionIds.map((qId, index) => {
                    const input = this.$el.querySelector(`input[name="q-${qId}"]:checked`);
                    return input !== null;
                });
            },
            
            get answeredCount() {
                return this.answeredQuestions.filter(answered => answered).length;
            },
            
            nextQuestion() {
                if (this.currentQuestion < {{pertanyaan.length}} - 1) {
                    this.currentQuestion++;
                }
            },
            
            prevQuestion() {
                if (this.currentQuestion > 0) {
                    this.currentQuestion--;
                }
            },
            
            isAnswered(index) {
                return this.answeredQuestions[index] || false;
            }
        }
    }
</script>

<script>
function prepareAndSubmit() {
    try {
        if (typeof window.clearQuizStorage === "function") {
            window.clearQuizStorage();
        }
    } catch (e) {}

    const form = document.getElementById('formSubmit');
    if (!form) return;

    form.querySelectorAll('input[name^="answerUser"]').forEach((el) => el.remove());

    const userId = '{{user.id}}';
    const checked = form.querySelectorAll('input[type="radio"]:checked');

    checked.forEach((radio, index) => {
        const questionId = radio.name.replace("q-", "");
        const append = (name, value) => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = value;
            form.appendChild(input);
        };
        append(`answerUser[${index}][userId]`, userId);
        append(`answerUser[${index}][questionsId]`, questionId);
        append(`answerUser[${index}][answersId]`, radio.value);
    });

    form.submit();
}

function confirmQuizSubmit() {
    openConfirmModal({
        title: "Confirmation",
        description: "Are you sure you want to submit your answers?",
        confirmLabel: "Yes, continue",
        cancelLabel: "Cancel",
        onConfirm: () => prepareAndSubmit()
    });
}

function timeOverSubmit() {
    openTimeOverModal({
        title: "Time's Up!",
        description: "Quiz time is over, submitting your answers.",
        confirmLabel: "Submit Answers",
        onConfirm: () => prepareAndSubmit()
    });
}
</script>
