{{!-- Dibungkus chrome backoffice. Halaman ini ditautkan dari dalam area
     belajar tetapi punya rute sendiri; sebelumnya memakai navbar publik
     dan footer. Controller-nya merender dengan bareShell: true.
     Lihat docs/user-area-learning-consolidation-plan.md tahap 2. --}}
{{#> user/shell_frame/index user=user active='learning'}}
<div class="max-w-3xl mx-auto px-6 py-8">
  <!-- Header Quiz -->
  <div class="mb-8 text-center">
    <!-- Enhanced header with gradient text and better spacing -->
    <h1 class="text-2xl font-bold text-[#003060] mb-4 font-montserrat">{{quiz.quizName}}</h1>
  </div>

  <!-- Info Quiz -->
  <!-- Enhanced info card with gradient border and better styling -->
  <div class="bg-white rounded-xl border border-[#E5E5E5] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] p-6 mb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="flex items-center space-x-3">
        <svg class="w-10 h-10 text-[#404040]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <div>
          <p class="text-[#525252] text-sm font-medium">{{t "test.quiz.totalQuestions"}}</p>
          <p class="text-2xl font-bold text-[#171717]">{{questions.length}}</p>
        </div>
      </div>
      <div class="flex items-center space-x-3">
        <svg class="w-10 h-10 text-[#404040]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div>
          <p class="text-[#525252] text-sm font-medium">{{t "test.quiz.minimumScore"}}</p>
          <p class="text-2xl font-bold text-[#171717]">{{quiz.minScore}}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Tombol Kembali + Mulai Quiz -->
  <!-- Enhanced buttons with better styling and hover effects -->
  <div class="mb-8 flex flex-row justify-between items-center gap-4">
      <a href="/program/{{quiz.weeks.course.id}}" 
     class="bg-white inline-flex items-center gap-3 px-6 py-3 rounded-xl border border-[#D4D4D4] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] text-[#404040] hover:bg-[#FAFAFA] hover:border-[#D4D4D4] transition-all duration-300 font-semibold text-lg focus:outline-none">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    {{t "test.quiz.backProgram"}}
  </a>
    <a href="/quiz/start/{{quiz.id}}"
       class="bg-[#003060] hover:bg-[#00254a] text-white inline-flex items-center gap-3 px-6 py-3 rounded-xl shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-all duration-300 font-semibold text-lg focus:outline-none">

      <span>{{t "test.quiz.startQuiz"}}</span>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
</svg>
    </a>
  </div>

  <!-- Riwayat Nilai -->
  <!-- Enhanced history section with better table styling and empty state -->
  <div class="bg-white rounded-xl border border-[#E5E5E5] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] p-6">
    <div class="flex items-center space-x-3 mb-6">
      <svg class="w-8 h-8 text-[#404040]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
      </svg>
      <h2 class="text-2xl font-bold text-[#171717] font-montserrat">{{t "test.quiz.scoreHistory"}}</h2>
    </div>

    {{#if scores.length}}
      <div class="overflow-x-auto max-h-96 overflow-y-auto rounded-lg border border-[#E5E5E5]">
        <table class="w-full">
          <thead class="sticky top-0 z-10">
            <tr class="bg-[#FAFAFA] border-b border-[#E5E5E5]">
              <th class="px-6 py-4 text-left text-sm font-semibold text-[#404040] uppercase tracking-wider">{{t "test.quiz.score"}}</th>
              <th class="px-6 py-4 text-left text-sm font-semibold text-[#404040] uppercase tracking-wider">{{t "test.quiz.status"}}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            {{#each scores}}
            <tr class="hover:bg-[#FAFAFA] transition-colors duration-150">
              <td class="px-6 py-4">
                <span class="text-2xl font-bold text-[#171717]">{{this.score}}</span>
              </td>
              <td class="px-6 py-4">
                {{#if (gte this.score ../quiz.minScore)}}
                  <span class="inline-flex items-center px-3 py-1 text-sm font-medium rounded-full bg-[#f0fdf4] text-[#15803d] border border-[#bbf7d0]">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    {{t "test.quiz.passed"}}
                  </span>
                {{else}}
                  <span class="inline-flex items-center px-3 py-1 text-sm font-medium rounded-full bg-[#FEF2F2] text-[#B42318] border border-[#FECACA]">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    {{t "test.quiz.failed"}}
                  </span>
                {{/if}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="text-center py-12">
        <div class="w-20 h-20 bg-[#E4F1F7] rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-10 h-10 text-[#A3A3A3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <p class="text-[#737373] text-lg font-medium mb-2">{{t "test.quiz.noQuizAttempt"}}</p>
        <p class="text-[#A3A3A3]">{{t "test.quiz.startYourFirstQuiz"}}</p>
      </div>
    {{/if}}
  </div>
</div>
{{/user/shell_frame/index}}
