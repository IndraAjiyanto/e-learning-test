{{!--
  Halaman: Ikhtisar Kuis (area student)
  Rute   : GET /quiz/form/:quizId  (quiz.controller.ts)

  Ini satu-satunya perhentian antara daftar kuis di tab dan halaman
  pengerjaannya. Sebelumnya ada satu perhentian lagi - tampilan detail di dalam
  tab Quiz - yang isinya persis sama dengan halaman ini; tampilan itu sudah
  dihapus.

  Susunannya meniru IDE kartu kepala pada halaman kuis bisa.ai: ikon, nama,
  satu kalimat penjelas, lalu sebaris chip keterangan. Yang dipakai token warna
  dan bentuk kita sendiri, bukan warnanya.

  Halaman ini juga jadi tempat mendarat sesudah kuis dikumpulkan
  (user_answers.controller.ts me-redirect ke sini), jadi hasil percobaan
  terakhir harus langsung terbaca.
--}}
{{#> user/shell_frame/index user=user active='learning' pageTitle=(t 'test.startLearning.quiz') back=(concat '/program/' quiz.weeks.course.id)}}
<div class="min-h-full px-4 pb-10 pt-6 sm:px-8">
  <div class="flex w-full flex-col gap-4">

    <!-- Kepala kuis -->
    <div class="overflow-hidden rounded-xl border border-[#E5E5E5] bg-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]">
      <div class="flex flex-wrap items-start gap-4 p-5 sm:p-6">
        <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-[#E4F1F7] text-[#003060]">
          <i class="fa-solid fa-circle-question text-base"></i>
        </span>

        <div class="min-w-0 flex-1">
          <h1 class="font-inter text-xl font-bold leading-snug text-[#003060] sm:text-2xl">{{quiz.quizName}}</h1>
          <p class="mt-1 font-inter text-sm text-[#737373]">{{t 'test.quiz.overviewHint'}}</p>

          {{!-- Chip keterangan: ide dari baris chip halaman kuis bisa.ai.
               Yang disebut hanya yang memang ada datanya. --}}
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#F5F5F5] px-2.5 py-1 font-inter text-xs font-medium text-[#525252]">
              <i class="fa-solid fa-list-ol text-[0.65rem] text-[#718096]"></i>
              {{questionCount}} {{t 'test.quiz.questionsCount'}}
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#F5F5F5] px-2.5 py-1 font-inter text-xs font-medium text-[#525252]">
              <i class="fa-solid fa-list-check text-[0.65rem] text-[#718096]"></i>
              {{t 'test.quiz.multipleChoice'}}
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#F5F5F5] px-2.5 py-1 font-inter text-xs font-medium text-[#525252]">
              <i class="fa-regular fa-clock text-[0.65rem] text-[#718096]"></i>
              {{#if quiz.duration}}{{quiz.duration}} {{#if (eq quiz.duration 1)}}{{t 'test.quiz.minute'}}{{else}}{{t 'test.quiz.minutes'}}{{/if}}{{else}}{{t 'test.quiz.noTimeLimit'}}{{/if}}
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#F5F5F5] px-2.5 py-1 font-inter text-xs font-medium text-[#525252]">
              <i class="fa-solid fa-bullseye text-[0.65rem] text-[#718096]"></i>
              {{t 'test.quiz.minimumScore'}} {{quiz.minScore}}
            </span>
          </div>
        </div>
      </div>

      {{!-- Garis keadaan: hasil terbaik dan tombol utama. Sebelumnya tombol
           Start Quiz berdiri sendiri di tengah halaman tanpa menyebutkan sama
           sekali apakah kuisnya sudah pernah lulus. --}}
      <div class="flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-[#E5E5E5] bg-[#FAFAFA] px-5 py-4 sm:px-6">
        {{#if attempts.length}}
          <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 font-inter text-xs font-medium leading-none {{#if passed}}border-[#BBF7D0] bg-[#F0FDF4] text-[#15803D]{{else}}border-[#FECACA] bg-[#FEF2F2] text-[#B42318]{{/if}}">
            <span class="size-1.5 shrink-0 rounded-full {{#if passed}}bg-[#22C55E]{{else}}bg-[#EF4444]{{/if}}"></span>
            {{#if passed}}{{t 'test.quiz.passed'}}{{else}}{{t 'test.quiz.failed'}}{{/if}}
          </span>
          <span class="min-w-0 flex-1 font-inter text-xs text-[#737373]">
            {{t 'test.quiz.bestScore'}} <span class="font-semibold text-[#171717]">{{best}}</span>
            &middot; {{t 'test.quiz.attempts'}} <span class="font-semibold text-[#171717]">{{attempts.length}}</span>
          </span>
        {{else}}
          <span class="min-w-0 flex-1 font-inter text-xs text-[#737373]">{{t 'test.quiz.startYourFirstQuiz'}}</span>
        {{/if}}

        <a
          href="/quiz/start/{{quiz.id}}"
          class="inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-4 font-inter text-sm font-semibold text-white no-underline transition-colors hover:bg-[#00254a]"
        >
          <i class="fa-solid fa-play text-xs"></i>
          {{#if attempts.length}}{{t 'test.quiz.retakeQuiz'}}{{else}}{{t 'test.quiz.startQuiz'}}{{/if}}
        </a>
      </div>
    </div>

    <!-- Riwayat nilai -->
    <div class="overflow-hidden rounded-xl border border-[#E5E5E5] bg-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]">
      <div class="border-b border-[#E5E5E5] px-5 py-4 sm:px-6">
        <h2 class="font-inter text-base font-bold text-[#171717]">{{t 'test.quiz.scoreHistory'}}</h2>
      </div>

      {{#if attempts.length}}
        {{!-- Nomor percobaan dan tanggal ditambahkan: tanpa keduanya, empat
             baris bernilai 0 tampak seperti baris yang sama diulang. --}}
        <ul class="divide-y divide-[#F0F0F0]">
          {{#each attempts}}
            <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-5 py-3.5 sm:px-6">
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-[#F5F5F5] font-inter text-xs font-bold text-[#525252]">{{this.attempt}}</span>
              <span class="min-w-0 flex-1">
                <span class="block font-inter text-sm font-semibold text-[#171717]">
                  {{t 'test.quiz.attempt'}} {{this.attempt}}
                </span>
                <span class="mt-0.5 block font-inter text-xs text-[#737373]">
                  {{t 'test.quiz.takenOn'}} {{formatDate this.createdAt ../lang}}
                </span>
              </span>
              <span class="shrink-0 font-inter text-lg font-bold text-[#171717]">{{this.score}}</span>
              <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 font-inter text-xs font-medium leading-none {{#if this.passed}}border-[#BBF7D0] bg-[#F0FDF4] text-[#15803D]{{else}}border-[#FECACA] bg-[#FEF2F2] text-[#B42318]{{/if}}">
                <span class="size-1.5 shrink-0 rounded-full {{#if this.passed}}bg-[#22C55E]{{else}}bg-[#EF4444]{{/if}}"></span>
                {{#if this.passed}}{{t 'test.quiz.passed'}}{{else}}{{t 'test.quiz.failed'}}{{/if}}
              </span>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <div class="px-5 py-10 text-center sm:px-6">
          <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-[#F5F5F5] text-[#a3a3a3]">
            <i class="fa-solid fa-chart-simple text-base"></i>
          </span>
          <p class="font-inter text-sm font-semibold text-[#171717]">{{t 'test.quiz.noQuizAttempt'}}</p>
          <p class="mt-1 font-inter text-xs text-[#737373]">{{t 'test.quiz.startYourFirstQuiz'}}</p>
        </div>
      {{/if}}
    </div>

  </div>
</div>
{{/user/shell_frame/index}}
