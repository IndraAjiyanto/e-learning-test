<div class='max-w-7xl mx-auto px-6 py-8 pt-32'>
  <!-- Main Form -->
  <div class='grid grid-cols-1 lg:grid-cols-3 gap-8'>

    <!-- Course Info Column -->
    <div class='lg:col-span-2 space-y-6'>
      <div class='bg-white rounded-lg shadow-lg overflow-hidden'>
        <img
          src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80'
          alt='Course'
          class='w-full h-64 object-cover'
        />
        <div class='p-8'>
          <h2
            class='text-3xl font-bold text-gray-900 mb-4 font-montserrat'
          >Belajar Web Development</h2>
          <p class='text-gray-600 mb-6 text-lg leading-relaxed'>
            Pelajari HTML, CSS, dan JavaScript dari dasar hingga mahir. Kelas
            ini dirancang khusus untuk pemula dengan pendekatan praktis dan
            project-based learning.
          </p>

          <div class='grid grid-cols-2 gap-6 mb-6'>
            <div class='flex items-center text-gray-700'>
              <div class='bg-slate-100 p-3 rounded-lg mr-4'>
                <i data-lucide='clock' class='w-6 h-6 text-slate-700'></i>
              </div>
              <div>
                <p class='text-sm text-gray-500'>Durasi</p>
                <p class='font-bold text-lg'>40 Jam</p>
              </div>
            </div>
            <div class='flex items-center text-gray-700'>
              <div class='bg-slate-100 p-3 rounded-lg mr-4'>
                <i data-lucide='users' class='w-6 h-6 text-slate-700'></i>
              </div>
              <div>
                <p class='text-sm text-gray-500'>Siswa</p>
                <p class='font-bold text-lg'>1,234</p>
              </div>
            </div>
            <div class='flex items-center text-gray-700'>
              <div class='bg-slate-100 p-3 rounded-lg mr-4'>
                <i data-lucide='book' class='w-6 h-6 text-slate-700'></i>
              </div>
              <div>
                <p class='text-sm text-gray-500'>Materi</p>
                <p class='font-bold text-lg'>15 Modul</p>
              </div>
            </div>
            <div class='flex items-center text-gray-700'>
              <div class='bg-green-100 p-3 rounded-lg mr-4'>
                <i data-lucide='award' class='w-6 h-6 text-green-600'></i>
              </div>
              <div>
                <p class='text-sm text-gray-500'>Sertifikat</p>
                <p class='font-bold text-lg text-green-600'>Tersedia</p>
              </div>
            </div>
          </div>

          <!-- What You'll Learn -->
          <div>
            <h4
              class='font-bold text-lg text-gray-900 mb-3 font-montserrat'
            >Yang Akan Dipelajari:</h4>
            <ul class='space-y-2'>
              <li class='flex items-start'>
                <i
                  data-lucide='check'
                  class='w-5 h-5 text-green-500 mr-2 mt-0.5'
                ></i>
                <span class='text-gray-700'>HTML5 dan struktur web semantik
                  modern</span>
              </li>
              <li class='flex items-start'>
                <i
                  data-lucide='check'
                  class='w-5 h-5 text-green-500 mr-2 mt-0.5'
                ></i>
                <span class='text-gray-700'>CSS3, Flexbox, Grid dan Responsive
                  Design</span>
              </li>
              <li class='flex items-start'>
                <i
                  data-lucide='check'
                  class='w-5 h-5 text-green-500 mr-2 mt-0.5'
                ></i>
                <span class='text-gray-700'>JavaScript ES6+ dan DOM manipulation</span>
              </li>
              <li class='flex items-start'>
                <i
                  data-lucide='check'
                  class='w-5 h-5 text-green-500 mr-2 mt-0.5'
                ></i>
                <span class='text-gray-700'>Project portfolio dan deployment</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class='bg-white rounded-lg shadow-lg p-6'>
        <h3 class='text-xl font-bold text-gray-900 mb-6 font-montserrat'>Kata
          Alumni:</h3>
        <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
          <div class='bg-gray-50 rounded-lg p-4'>
            <p class='text-gray-700 text-sm italic'>"Materi sangat lengkap dan
              mudah dipahami."</p>
            <p class='mt-2 font-semibold'>- Sarah M.</p>
          </div>
          <div class='bg-gray-50 rounded-lg p-4'>
            <p class='text-gray-700 text-sm italic'>"Project-based learning nya
              sangat membantu."</p>
            <p class='mt-2 font-semibold'>- Andi K.</p>
          </div>
        </div>
      </div>
    </div>

    <div class='space-y-6'>

      <div
        class='bg-gradient-to-br from-slate-800 to-slate-900 text-white rounded-xl shadow-xl p-6 top-6'
      >
        <h3 class='text-xl font-bold mb-4 flex items-center font-montserrat'>
          <i data-lucide='tag' class='w-6 h-6 mr-2'></i>
          Detail Harga
        </h3>
        <div class='space-y-3 mb-6'>
          <div class='flex justify-between items-center'>
            <span class='text-white/80'>Harga Normal:</span>
            <span class='line-through text-white/60 text-lg'>Rp 500.000</span>
          </div>
          <div class='flex justify-between items-center'>
            <span class='text-white/80'>Diskon Early Bird:</span>
            <div
              class='bg-yellow-500 text-black px-2 py-1 rounded font-bold text-sm'
            >-40%</div>
          </div>
          <div class='border-t border-slate-600 pt-3'>
            <div class='flex justify-between items-center text-2xl font-bold'>
              <span>Total Pembayaran:</span>
              <span class='text-green-400'>Rp 300.000</span>
            </div>
          </div>
        </div>
      </div>

      <div class='bg-white rounded-lg shadow-lg p-6'>
        <h3
          class='text-xl font-bold text-gray-900 mb-4 flex items-center font-montserrat'
        >
          <i data-lucide='credit-card' class='w-6 h-6 mr-2'></i>
          Metode Pembayaran
        </h3>
        
        <form
            action='/payment/{{user.id}}/{{course.id}}'
            method='post'
            class='space-y-6'
        >
            {{#if (roles course.category.name 'free class')}}
                <p class='text-gray-600 mb-4'>Daftar ke kelas gratis ini sekarang dan tingkatkan skill kamu.</p>
                <button type='submit' class='btn btn-primary w-full'>
                <i data-lucide='send' class='w-5 h-5 mr-2'></i>
                Daftar Kelas
                </button>
            {{else}}
                <p class='text-gray-600 mb-4'>Anda akan diarahkan ke halaman pembayaran aman Xendit untuk menyelesaikan transaksi.</p>
                
                <!-- Payment Method (optional for Invoice API if Xendit UI shows it, but here we can pass it if we want specific channel) -->
                <input type="hidden" name="paymentMethod" value="XENDIT_UI" />

                <button type='submit' class='btn btn-primary w-full bg-blue-600 hover:bg-blue-700 text-white'>
                <i data-lucide='credit-card' class='w-5 h-5 mr-2'></i>
                Lanjutkan Pembayaran
                </button>
            {{/if}}
        </form>
      </div>

      <div class='bg-green-50 border border-green-200 rounded-lg p-4'>
        <div class='flex items-center space-x-3'>
          <i data-lucide='shield-check' class='w-8 h-8 text-green-600'></i>
          <div>
            <h4 class='font-bold text-green-800 mb-1 font-montserrat'>Transaksi
              Aman</h4>
            <p class='text-sm text-green-700'>
              Data pembayaran Anda dilindungi dengan enkripsi SSL dan tidak akan
              dibagikan kepada pihak ketiga.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  lucide.createIcons();
</script>