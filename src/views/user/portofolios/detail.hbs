{{!-- Dibungkus chrome backoffice. Halaman ini ditautkan dari dalam area
     belajar tetapi punya rute sendiri; sebelumnya memakai navbar publik
     dan footer. Controller-nya merender dengan bareShell: true.
     Lihat docs/user-area-learning-consolidation-plan.md tahap 2. --}}
{{#> user/shell_frame/index
  user=user
  active=(ternary isFromCourse 'learning' 'portfolio')
  pageTitle=(default portfolio.title (t 'test.myPortfolio.detailPortfolio.pageTitle'))
  back=(ternary isFromCourse (concat '/users/profile?tab=course-portfolio&courseId=' courseId) '/users/profile?tab=portfolio')
  trail=(ternary isFromCourse
    (array
      (obj 'label' (t 'test.common.home') 'href' '/users/profile?tab=dashboard' 'icon' 'ph ph-house')
      (obj 'label' (t 'test.userSidebar.myLearning') 'href' '/users/profile?tab=learning' 'icon' 'ph ph-book-open')
      (obj 'label' (t 'test.startLearning.portfolio') 'href' (concat '/users/profile?tab=course-portfolio&courseId=' courseId) 'icon' 'ph ph-briefcase')
      (obj 'label' (default portfolio.title (t 'test.myPortfolio.detailPortfolio.pageTitle')) 'icon' 'ph ph-file-text')
    )
    (array
      (obj 'label' (t 'test.common.home') 'href' '/users/profile?tab=dashboard' 'icon' 'ph ph-house')
      (obj 'label' (t 'test.userSidebar.myPortfolio') 'href' '/users/profile?tab=portfolio' 'icon' 'ph ph-briefcase')
      (obj 'label' (default portfolio.title (t 'test.myPortfolio.detailPortfolio.pageTitle')) 'icon' 'ph ph-file-text')
    )
  )
}}
<div class="min-h-full py-4 sm:py-6 font-inter">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">

    <!-- Top Header: Eyebrow Badge & Title -->
    {{> portfolio/detail/header portfolio=portfolio}}

    <!-- Showcase Image Gallery -->
    {{> portfolio/detail/gallery portfolio=portfolio}}

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left Column: Description & Overview -->
      <div class="lg:col-span-2 space-y-6">
        {{> portfolio/detail/content portfolio=portfolio}}
      </div>

      <!-- Right Column: Sidebar Meta Info, Tools & CTA -->
      <div class="lg:col-span-1 space-y-4">
        {{> portfolio/detail/sidebar portfolio=portfolio}}

        {{!-- Action Button (Edit) if user owns this portfolio --}}
        {{#if (or (eq portfolio.userId user.id) (eq portfolio.user.id user.id))}}
          <div class="pt-2">
            <a
              href="/portfolio/formEdit/{{portfolio.id}}{{#if courseId}}/{{courseId}}{{/if}}"
              class="w-full h-11 rounded-xl border border-[#D4D4D4] bg-white text-[#003060] font-inter font-medium text-sm leading-none flex items-center justify-center gap-2 transition-colors cursor-pointer hover:border-[#a3a3a3] hover:bg-[#F5F5F5] no-underline shadow-sm"
            >
              <i class="fa-regular fa-pen-to-square text-xs"></i>
              {{t "test.myPortfolio.editPortfolio.editPortfolio"}}
            </a>
          </div>
        {{/if}}
      </div>

    </div>

  </div>
</div>
{{/user/shell_frame/index}}
