{{!-- Dibungkus chrome backoffice. Halaman ini ditautkan dari dalam area
     belajar tetapi punya rute sendiri; sebelumnya memakai navbar publik
     dan footer. Controller-nya merender dengan bareShell: true.
     Lihat docs/user-area-learning-consolidation-plan.md tahap 2. --}}
{{#> user/shell_frame/index
  user=user
  active=(ternary isFromCourse 'learning' 'portfolio')
  pageTitle=(t 'test.myPortfolio.editPortfolio.editPortfolio')
  back=false
  trail=(ternary isFromCourse
    (array
      (obj 'label' (t 'test.common.home') 'href' '/users/profile?tab=dashboard')
      (obj 'label' (t 'test.userSidebar.myLearning') 'href' '/users/profile?tab=learning')
      (obj 'label' (t 'test.startLearning.portfolio') 'href' (concat '/users/profile?tab=course-portfolio&courseId=' courseId))
      (obj 'label' (t 'test.myPortfolio.editPortfolio.editPortfolio'))
    )
    (array
      (obj 'label' (t 'test.common.home') 'href' '/users/profile?tab=dashboard')
      (obj 'label' (t 'test.userSidebar.myPortfolio') 'href' '/users/profile?tab=portfolio')
      (obj 'label' (t 'test.myPortfolio.editPortfolio.editPortfolio'))
    )
  )
}}
<div class="min-h-full py-4 sm:py-6">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="bg-white rounded-xl border border-[#E5E5E5] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] p-6 sm:p-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2 font-inter text-center">
        {{t "test.myPortfolio.editPortfolio.editPortfolio"}}
      </h1>
      <p class="text-sm sm:text-base text-[#718096] mb-8 font-inter text-center">
        {{t "test.myPortfolio.editPortfolio.placeholderDescription"}}
      </p>

      <script id="portfolio_bootstrap_data" type="application/json">
      {
        "content": {{{jsonSafe (default portfolio.content null)}}}
      }
      </script>

      <form
        id="portfolioEditForm"
        method="POST"
        action="/portfolio/{{portfolio.id}}/{{courseId}}?_method=PATCH"
        enctype="multipart/form-data"
        x-data="editPortfolioForm()"
        @submit.prevent="handleSubmit($event)"
      >
        {{#unless isFromCourse}}
          <input type="hidden" name="from" value="portfolio" />
        {{/unless}}

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Kolom Kiri -->
          <div class="space-y-6">
            <!-- Judul Portfolio -->
            <div>
              <label for="title" class="block text-base sm:text-lg font-semibold text-[#003060] mb-2 font-inter">
                {{t "test.myPortfolio.editPortfolio.portfolioTittle"}}<span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="title"
                name="title"
                x-model="form.title"
                required
                placeholder="{{t "test.myPortfolio.editPortfolio.placeholderTittle"}}"
                class="w-full h-[44px] px-[14px] bg-white border border-[#D4D4D4] rounded-[8px] font-inter text-base text-[#404040] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-colors shadow-[0px_1px_2px_rgba(0,0,0,0.05)]"
              />
            </div>

            <!-- Deskripsi -->
            <div>
              <label for="description" class="block text-base sm:text-lg font-semibold text-[#003060] mb-2 font-inter">
                {{t "test.myPortfolio.editPortfolio.description"}}<span class="text-red-500">*</span>
              </label>
              <textarea
                name="description"
                id="description"
                x-model="form.description"
                required
                placeholder="{{t "test.myPortfolio.editPortfolio.placeholderDescription"}}"
                rows="4"
                class="w-full px-[14px] py-[10px] bg-white border border-[#D4D4D4] rounded-[8px] font-inter text-base text-[#404040] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-colors resize-none shadow-[0px_1px_2px_rgba(0,0,0,0.05)]"
              ></textarea>
            </div>

            <!-- Program (Locked) -->
            <div>
              <label class="block text-base sm:text-lg font-semibold text-[#003060] mb-2 font-inter">
                {{t "test.myPortfolio.detailPortfolio.program"}}<span class="text-red-500">*</span>
              </label>
              <div class="flex h-[44px] items-center rounded-[8px] border border-[#D4D4D4] bg-[#F5F5F5] px-[14px] font-inter text-base text-[#666666]">
                {{default portfolio.course.name (default course.name 'Program')}}
              </div>
              <p class="pt-1 font-inter text-xs text-[#737373]">
                {{t "test.myPortfolio.modal.programLockedHint"}}
              </p>
            </div>

            <!-- Link -->
            <div>
              <label for="link" class="block text-base sm:text-lg font-semibold text-[#003060] mb-2 font-inter">
                {{t "test.myPortfolio.editPortfolio.link"}}<span class="text-red-500">*</span>
              </label>
              <input
                type="url"
                id="link"
                name="link"
                x-model="form.link"
                required
                placeholder="{{t "test.myPortfolio.editPortfolio.placeholderLink"}}"
                class="w-full h-[44px] px-[14px] bg-white border border-[#D4D4D4] rounded-[8px] font-inter text-base text-[#404040] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-colors shadow-[0px_1px_2px_rgba(0,0,0,0.05)]"
              />
              <p class="pt-1 font-inter text-xs text-[#737373]">
                {{t "test.myPortfolio.editPortfolio.spanLink"}}
              </p>
            </div>
          </div>

          <!-- Kolom Kanan -->
          <div class="space-y-6">
            <!-- Project Overview -->
            <div>
              <label class="block text-base sm:text-lg font-semibold text-[#003060] mb-2 font-inter">
                {{t "test.myPortfolio.editPortfolio.overview"}}
              </label>
              {{> components/ui/admin/form/editor-input
                id="portfolio_edit_editor"
                name="content"
                inputId="portfolio_edit_content_input"
              }}
            </div>

            <!-- Upload Images Section -->
            <div class="space-y-4">
              <!-- Existing Images -->
              <div x-show="existingImages.length > 0" class="space-y-2">
                <label class="block text-base sm:text-lg font-semibold text-[#003060] font-inter">
                  {{t "test.myPortfolio.editPortfolio.currentImages"}}
                </label>
                <div class="space-y-2 max-h-[160px] overflow-y-auto p-1">
                  <template x-for="(url, index) in existingImages" :key="url">
                    <div class="flex items-center gap-3 rounded-[8px] border border-[#D4D4D4] bg-white px-3 py-2">
                      <span class="relative grid h-10 w-16 shrink-0 place-items-center overflow-hidden rounded bg-[#F1F5F9] text-[#94A3B8]">
                        <img :src="url" alt="" class="h-full w-full object-cover" onerror="this.remove()">
                      </span>
                      <span class="min-w-0 flex-1 truncate font-inter text-xs text-[#676767]" x-text="url.split('/').pop()"></span>
                      <input type="hidden" name="keepImages" :value="url">
                      <button
                        type="button"
                        @click="removeExistingImage(url)"
                        class="shrink-0 px-2 py-1 text-xs text-red-500 transition-colors hover:text-red-700 cursor-pointer"
                        title="{{t 'test.myPortfolio.modal.removeThisImage'}}"
                      >
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </div>
                  </template>
                </div>
              </div>

              <!-- Add New Images -->
              <div class="space-y-3">
                <label class="block text-base sm:text-lg font-semibold text-[#003060] font-inter">
                  {{t "test.myPortfolio.editPortfolio.addNewImages"}}
                </label>
                <p class="font-inter text-xs text-[#737373]">
                  {{t "test.myPortfolio.editPortfolio.spanUploadImages"}}
                </p>

                <div class="space-y-3 max-h-[180px] overflow-y-auto p-1">
                  <template x-for="(upload, idx) in imageUploads" :key="upload.id">
                    <div class="flex h-[52px] w-full items-center justify-between gap-3 rounded-[8px] border border-[#D4D4D4] bg-white px-3 hover:shadow-sm">
                      <div class="flex min-w-0 items-center gap-3">
                        <label class="flex-shrink-0 cursor-pointer rounded-[6px] bg-[#0B1F3B1A] px-3.5 py-1.5 font-inter text-sm font-medium text-black transition-colors hover:bg-slate-200">
                          {{t "test.myPortfolio.modal.chooseFile"}}
                          <input type="file" name="image" class="hidden" accept="image/jpeg,image/jpg,image/png,image/gif" @change="handleFile($event, idx)">
                        </label>
                        <span class="truncate font-inter text-xs sm:text-sm text-[#676767]" x-text="upload.name"></span>
                      </div>
                      <button
                        type="button"
                        x-show="imageUploads.length > 1"
                        @click="imageUploads.splice(idx, 1)"
                        class="cursor-pointer px-2 py-1 text-xs text-red-500 transition-colors hover:text-red-700"
                        title="{{t 'test.myPortfolio.modal.removeImage'}}"
                      >
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </div>
                  </template>
                </div>

                <template x-for="upload in imageUploads.filter(u => u.error)" :key="'err-' + upload.id">
                  <p class="flex items-start gap-1.5 font-inter text-xs text-[#dc2626]">
                    <i class="fa-solid fa-circle-exclamation mt-0.5"></i>
                    <span x-text="upload.name + ': ' + upload.error"></span>
                  </p>
                </template>

                <div
                  @click="addImageRow()"
                  class="mt-2 flex h-[48px] w-full cursor-pointer items-center justify-center gap-2 rounded-[8px] border border-dashed border-[#D4D4D4] font-inter text-sm font-medium text-[#666666] transition-colors hover:bg-[#FAFAFA]"
                >
                  <i class="fa-solid fa-plus text-xs"></i>
                  <span>{{t "test.myPortfolio.editPortfolio.addImage"}}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-4 pt-8 mt-6 border-t border-[#E5E5E5]">
          <button
            type="submit"
            :disabled="loading || !canSubmit()"
            class="flex h-[44px] flex-1 cursor-pointer items-center justify-center rounded-[8px] bg-[#003060] font-inter text-base font-semibold text-white shadow-md transition-all hover:bg-[#001f3f] disabled:pointer-events-none disabled:opacity-50"
          >
            <span x-show="loading" class="loading loading-spinner loading-sm mr-2"></span>
            <span>{{t "test.myPortfolio.editPortfolio.updatePortfolio"}}</span>
          </button>
          <a
            href="{{#if isFromCourse}}/users/profile?tab=course-portfolio&courseId={{courseId}}{{else}}/users/profile?tab=portfolio{{/if}}"
            class="inline-flex h-[44px] flex-1 cursor-pointer items-center justify-center gap-2 rounded-[8px] border border-[#D4D4D4] bg-white font-inter text-base font-semibold text-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#F5F5F5]"
          >
            {{t "test.myPortfolio.editPortfolio.cancel"}}
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function editPortfolioForm() {
  return {
    form: {
      title: '{{portfolio.title}}',
      description: `{{portfolio.description}}`,
      link: '{{portfolio.link}}'
    },
    existingImages: {{#if portfolio.image}}{{{json portfolio.image}}}{{else}}[]{{/if}},
    imageUploads: [
      { id: 1, file: null, name: '{{t 'test.myPortfolio.modal.noFileChosen'}}', error: '' }
    ],
    loading: false,
    editorInstance: null,

    init() {
      let isInitializing = false;
      const initEditor = () => {
        if (isInitializing) return;
        if (!window.EditorJS || !window.EditorTools) {
          setTimeout(initEditor, 100);
          return;
        }
        isInitializing = true;
        const holder = document.getElementById('portfolio_edit_editor');
        if (holder) holder.innerHTML = '';

        if (this.editorInstance && typeof this.editorInstance.destroy === 'function') {
          try { this.editorInstance.destroy(); } catch (e) {}
        }

        let initialData = undefined;
        try {
          const raw = JSON.parse(document.getElementById('portfolio_bootstrap_data').textContent);
          if (raw && raw.content) {
            let parsed = raw.content;
            if (typeof parsed === 'string') {
              try { parsed = JSON.parse(parsed); } catch (e) {}
            }
            if (parsed && typeof parsed === 'object' && Array.isArray(parsed.blocks)) {
              initialData = parsed;
            }
          }
        } catch (e) {}

        try {
          this.editorInstance = new window.EditorJS({
            holder: 'portfolio_edit_editor',
            placeholder: 'Enter your content here...',
            data: initialData,
            tools: {
              header: {
                class: window.EditorTools.Header,
                inlineToolbar: ['link'],
                config: {
                  placeholder: 'Enter a heading...',
                  levels: [1, 2, 3, 4, 5, 6],
                  defaultLevel: 2
                }
              },
              paragraph: {
                class: window.EditorTools.Paragraph,
                inlineToolbar: true
              },
              list: {
                class: window.EditorTools.List,
                inlineToolbar: true
              },
              marker: {
                class: window.EditorTools.Marker,
                shortcut: 'CMD+SHIFT+M'
              },
              image: {
                class: window.EditorTools.ImageTool,
                tunes: {
                  stretched: false,
                  withBorder: false,
                  withBackground: false
                },
                config: {
                  endpoints: {
                    byFile: '/portfolio/upload-image',
                    byUrl: '/program/fetch-image'
                  }
                }
              },
              linkTool: {
                class: window.EditorTools.LinkTool,
                config: { endpoint: '/program/fetch-link' }
              }
            }
          });
        } catch (err) {
          console.error('[Portfolio] Failed to init EditorJS in edit mode:', err);
        }
      };
      initEditor();
    },

    removeExistingImage(url) {
      this.existingImages = this.existingImages.filter(item => item !== url);
    },

    addImageRow() {
      this.imageUploads.push({
        id: Date.now(),
        file: null,
        name: '{{t 'test.myPortfolio.modal.noFileChosen'}}',
        error: ''
      });
    },

    handleFile(event, idx) {
      const file = event.target.files[0];
      if (!file) return;
      this.imageUploads[idx].file = file;
      this.imageUploads[idx].name = file.name;
      this.imageUploads[idx].error = '';
      this.checkImage(file, idx);
    },

    checkImage(file, idx) {
      const TYPES = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
      const MAX = 5 * 1024 * 1024;
      if (!TYPES.includes(file.type)) {
        this.imageUploads[idx].error = '{{t 'test.myPortfolio.messages.invalidType'}}';
        return;
      }
      if (file.size > MAX) {
        this.imageUploads[idx].error = '{{t 'test.myPortfolio.messages.fileTooLarge'}}';
        return;
      }
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        const okW = img.naturalWidth >= 1900 && img.naturalWidth <= 1920;
        const okH = img.naturalHeight >= 1000 && img.naturalHeight <= 1080;
        this.imageUploads[idx].error = okW && okH
          ? ''
          : `${img.naturalWidth}x${img.naturalHeight} {{t 'test.myPortfolio.messages.dimensionError'}}`;
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        this.imageUploads[idx].error = '{{t 'test.myPortfolio.messages.unreadableImage'}}';
      };
      img.src = url;
    },

    canSubmit() {
      if (!this.form.title.trim() || !this.form.description.trim() || !this.form.link.trim()) return false;
      if (!/^https?:\/\/\S+$/i.test(this.form.link.trim())) return false;
      const validFiles = this.imageUploads.filter(u => u.file && !u.error);
      if (validFiles.length === 0 && this.existingImages.length === 0) return false;
      if (this.imageUploads.some(u => u.error)) return false;
      return true;
    },

    async handleSubmit(e) {
      if (!this.canSubmit() || this.loading) return;

      let editorData = null;
      if (this.editorInstance && typeof this.editorInstance.save === 'function') {
        try {
          editorData = await this.editorInstance.save();
        } catch (err) {
          console.error('[Portfolio] EditorJS save error:', err);
        }
      }

      const jsonContent = editorData ? JSON.stringify(editorData) : JSON.stringify({ time: Date.now(), blocks: [] });
      const contentInput = document.getElementById('portfolio_edit_content_input') || document.querySelector('input[name="content"]');
      if (contentInput) {
        contentInput.value = jsonContent;
      }

      this.loading = true;
      e.target.submit();
    }
  };
}
</script>
{{/user/shell_frame/index}}
