{{!-- Dibungkus chrome backoffice. Halaman ini ditautkan dari dalam area
     belajar tetapi punya rute sendiri; sebelumnya memakai navbar publik
     dan footer. Controller-nya merender dengan bareShell: true.
     Lihat docs/user-area-learning-consolidation-plan.md tahap 2. --}}
{{#> user/shell_frame/index
  user=user
  active='learning'
  pageTitle=(t 'test.myPortfolio.uploadPortfolio')
  back=false
  trail=(array
    (obj 'label' (t 'test.common.home') 'href' '/users/profile?tab=dashboard')
    (obj 'label' (t 'test.userSidebar.myLearning') 'href' '/users/profile?tab=learning')
    (obj 'label' (t 'test.startLearning.portfolio') 'href' (concat '/users/profile?tab=course-portfolio&courseId=' (default courseId course.id)))
    (obj 'label' (t 'test.myPortfolio.uploadPortfolio'))
  )
}}
<div class='min-h-full py-4 sm:py-6'>
  <div class='max-w-5xl mx-auto px-4 sm:px-6'>
    <div class='bg-white rounded-xl border border-[#E5E5E5] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] p-6 sm:p-8'>
      <h1
        class='text-2xl sm:text-3xl font-bold text-gray-900 mb-2 text-center font-inter'
      >{{t 'test.myPortfolio.createPortfolio.createYourPortfolio'}}</h1>
      <p class='text-sm sm:text-base text-[#718096] mb-8 font-inter text-center'>
        {{t 'test.myPortfolio.createPortfolio.placeholderDescription'}}
      </p>

      {{> user/portfolio/create/form}}
    </div>
  </div>
</div>
{{/user/shell_frame/index}}
