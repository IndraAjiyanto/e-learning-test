{{!-- Dibungkus chrome backoffice. Halaman ini ditautkan dari dalam area
     belajar tetapi punya rute sendiri; sebelumnya memakai navbar publik
     dan footer. Controller-nya merender dengan bareShell: true.
     Lihat docs/user-area-learning-consolidation-plan.md tahap 2. --}}
{{#> user/shell_frame/index user=user active='portfolio'}}
<div
  class='min-h-full bg-[#FAFAFA] py-8'
>
  <div class='max-w-6xl mx-auto px-6'>
    <div class='bg-white rounded-xl border border-[#E5E5E5] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] p-6'>
      <h2
        class='text-2xl sm:text-3xl font-bold text-gray-900 mb-8 text-center font-montserrat'
      >{{t 'test.myPortfolio.createPortfolio.createYourPortfolio'}}</h2>

{{> user/portfolio/create/form}}
    </div>
  </div>
</div>

<style>
  .codex-editor .ce-block__content,
  .codex-editor .ce-toolbar__content {
    max-width: 100% !important;
    margin-left: 16px !important;
    margin-right: auto !important;
  }

  .codex-editor__redactor {
    padding-left: 0 !important;
  }

  #editor img {
    max-width: 300px;
    margin: auto;
    border-radius: 1rem;
  }

  #editor h4 {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 600;
  }

  #editor h5 {
    margin-bottom: 0.5rem;
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 500;
  }

  #editor h6 {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
  }
</style>
{{/user/shell_frame/index}}
