<div
  x-data="{
      tab: 'all',
      categories: ['all', {{#each kategori}}'{{this.nama_kategori}}',{{/each}}],
      selectedCategory: 'all',
      selectedMethod: 'all',
      searchQuery: '',
      courseCategories: ['all', {{#each jenis_kelas}}`{{this.nama_jenis_kelas}}`,{{/each}}],
      currentPage: 1,
      itemsPerPage: 6,
      categoryDropdownOpen: false,
      typeDropdownOpen: false,
      methodDropdownOpen: false,
      
      categoriesData: [
        { value: 'all', icon: 'fa-th', title: '{{t "test.home.programSection.allCategory"}}', desc: '{{t "test.home.programSection.deskripsiAllCategory"}}' },
        {{#each kategori}}
        { value: '{{this.nama_kategori}}', icon: '{{this.icon}}', title: '{{this.nama_kategori}}', desc: `{{truncate (getByLang this.deskripsi ../lang) 10}}` },
        {{/each}}
      ],
      
      courseCategoriesData: [
        { value: 'all', icon: 'fa-layer-group', title: '{{t "test.home.programSection.allTypes"}}', desc: '{{t "test.home.programSection.deskripsiAllTypes"}}' },
        {{#each jenis_kelas}}
        { value: `{{this.nama_jenis_kelas }}`, icon: '{{computeIcon this.icon}}', title: `{{this.nama_jenis_kelas}}`, desc: `{{truncate (getByLang this.deskripsi ../lang) 10}}` },
        {{/each}}
      ],
      
      methodOptions: [
        { value: 'all', icon: 'fa-th', title: '{{t "test.home.programSection.allMethod"}}', desc: '{{t "test.home.programSection.deskripsiAllMethod"}}' },
        { value: 'online', icon: 'fa-laptop', title: '{{t "test.home.programSection.online"}}', desc: '{{t "test.home.programSection.deskripsiOnline"}}' },
        { value: 'offline', icon: 'fa-map-marker-alt', title: '{{t "test.home.programSection.offline"}}', desc: '{{t "test.home.programSection.deskripsiOffline"}}' }
      ],

      get selectedCategoryItem() {
        return this.categoriesData.find(c => c.value === this.tab) || this.categoriesData[0];
      },
      
      get selectedTypeItem() {
        return this.courseCategoriesData.find(c => c.value === this.selectedCategory) || this.courseCategoriesData[0];
      },

      get selectedMethodItem() {
        return this.methodOptions.find(m => m.value === this.selectedMethod) || this.methodOptions[0];
      },

      get filteredKelas() {
          return [...$refs.kelasList.children].filter(el => {
              const matchesTab = this.tab === 'all' || el.dataset.kategori === this.tab;
              const matchesCategory = this.selectedCategory === 'all' || 
                                    el.dataset.category?.toLowerCase() === this.selectedCategory.toLowerCase();
              const matchesMethod = this.selectedMethod === 'all' || 
                                   el.dataset.location?.toLowerCase() === this.selectedMethod.toLowerCase();
              const matchesSearch = this.searchQuery === '' || 
                                  el.dataset.nama?.toLowerCase().includes(this.searchQuery.toLowerCase()) ||
                                  el.dataset.deskripsi?.toLowerCase().includes(this.searchQuery.toLowerCase());
              
              return matchesTab && matchesCategory && matchesMethod && matchesSearch;
          })
      },

      get totalPages() {
          return Math.ceil(this.filteredKelas.length / this.itemsPerPage)
      },

      paginatedKelas(el) {
          const idx = this.filteredKelas.indexOf(el)
          return idx >= (this.currentPage - 1) * this.itemsPerPage &&
                 idx < this.currentPage * this.itemsPerPage
      },

      resetFilters() {
          this.selectedCategory = 'all';
          this.selectedMethod = 'all';
          this.tab = 'all';
          this.searchQuery = '';
          this.currentPage = 1;
      }
  }"
  class='bg-gradient-to-br from-white via-gray-50 to-white py-20 px-6 lg:px-20 relative overflow-visible'
  x-init="$watch('tab', () => currentPage = 1); $watch('selectedMethod', () => currentPage = 1); $watch('selectedCategory', () => currentPage = 1); $watch('searchQuery', () => currentPage = 1)"
  id='courses-section'
>

  <!-- Header Section -->
  <div class='text-center mb-16 relative'>
    <h1 class="text-4xl md:text-5xl font-bold leading-tight font-montserrat text-gray-900">{{t "test.mycourse.title"}}</h1>

    <p class='text-lg mt-4 text-gray-600 max-w-2xl mx-auto relative z-10'>
      {{t "test.mycourse.description"}}
    </p>
  </div>

  <!-- Filter Section -->
  <div class='max-w-6xl mx-auto mb-16 relative z-10 overflow-visible'>
    <div
      class='bg-white backdrop-blur-md border border-gray-200 rounded-2xl p-8 shadow-xl'
    >
      <!-- Filter Title -->
      <div class='flex items-center gap-3 mb-6'>
        <div
          class='w-1 h-8 bg-gradient-to-b from-slate-600 to-slate-800 rounded-full'
        ></div>
        <h3 class='text-2xl font-bold text-gray-900'>{{t "test.home.programSection.find"}}</h3>
      </div>

      <!-- Filter Controls -->
      <div
        class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6 relative z-50'
      >

        <!-- Category Filter -->
        <div @click.away='categoryDropdownOpen = false' class='group relative'>
          <label
            class='flex items-center gap-2 text-gray-700 font-semibold mb-3 text-sm uppercase tracking-wide'
          >
            <i class='fas fa-filter text-slate-600'></i>
            {{t "test.home.programSection.category"}}
          </label>

          <button
            @click='categoryDropdownOpen = !categoryDropdownOpen'
            type='button'
            class='w-full px-5 py-4 pr-12 bg-white border border-gray-300 rounded-2xl text-gray-900 font-medium focus:outline-none focus:ring-2 focus:ring-slate-500 transition-all duration-300 hover:border-slate-400 text-left relative shadow-sm'
          >
            <div class='flex items-center gap-3'>
              <img x-show="selectedCategoryItem.value !== 'all'" :src="selectedCategoryItem.icon" class="w-5 h-5 object-cover rounded" alt="icon">
              <i x-show="selectedCategoryItem.value === 'all'" :class='selectedCategoryItem.icon' class='fas text-slate-600'></i>
              <span x-text='selectedCategoryItem.title'></span>
            </div>
            <div
              class='absolute right-4 top-1/2 -translate-y-1/2 transition-transform duration-300'
              :class="categoryDropdownOpen ? 'rotate-180' : ''"
            >
              <i class='fas fa-chevron-down text-gray-500 text-lg'></i>
            </div>
          </button>

          <!-- Dropdown Menu -->
          <div
            x-show='categoryDropdownOpen'
            x-transition
            style='z-index: 9999'
            class='absolute w-full mt-2 bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden'
          >
            <template x-for='category in categoriesData' :key='category.value'>
              <button
                type='button'
                @click='tab = category.value; categoryDropdownOpen = false'
                class='w-full px-5 py-4 text-left hover:bg-slate-50 transition-colors duration-200 flex items-start gap-4 group/item'
                :class="tab === category.value ? 'bg-slate-100' : ''"
              >
                <div
                  class='w-10 h-10 rounded-full bg-secondary flex items-center justify-center flex-shrink-0 group-hover/item:bg-slate-200 transition-colors text-white'
                  :class="tab === category.value ? 'bg-gradient-to-br from-primary via-secondary to-gray-900' : ''"
                >
                  <img x-show="category.value !== 'all'" :src="category.icon" class="w-8 h-8 object-cover rounded-full" alt="icon">
                  <i x-show="category.value === 'all'" :class='category.icon' class='fas'></i>
                </div>
                <div class='flex-1'>
                  <h4
                    class='font-bold text-gray-900 mb-1'
                    x-text='category.title'
                  ></h4>
                  <p class='text-sm text-gray-600' x-text='category.desc'></p>
                </div>
                <div x-show='tab === category.value' class='flex-shrink-0'>
                  <i class='fas fa-check text-slate-600'></i>
                </div>
              </button>
            </template>
          </div>
        </div>

        <!-- Course Type Filter -->
        <div @click.away='typeDropdownOpen = false' class='group relative'>
          <label
            class='flex items-center gap-2 text-gray-700 font-semibold mb-3 text-sm uppercase tracking-wide'
          >
            <i class='fas fa-layer-group text-slate-600'></i>
            {{t "test.home.programSection.programType"}}
          </label>

          <button
            @click='typeDropdownOpen = !typeDropdownOpen'
            type='button'
            class='w-full px-5 py-4 pr-12 bg-white border border-gray-300 rounded-2xl text-gray-900 font-medium focus:outline-none focus:ring-2 focus:ring-slate-500 transition-all duration-300 hover:border-slate-400 text-left relative shadow-sm'
          >
            <div class='flex items-center gap-3'>
              <i :class='selectedTypeItem.icon' class='fas text-slate-600'></i>
              <span x-text='selectedTypeItem.title'></span>
            </div>
            <div
              class='absolute right-4 top-1/2 -translate-y-1/2 transition-transform duration-300'
              :class="typeDropdownOpen ? 'rotate-180' : ''"
            >
              <i class='fas fa-chevron-down text-gray-500 text-lg'></i>
            </div>
          </button>

          <div
            x-show='typeDropdownOpen'
            x-transition
            style='z-index: 9999'
            class='absolute w-full mt-2 bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden max-h-96 overflow-y-auto'
          >
            <template x-for='type in courseCategoriesData' :key='type.value'>
              <button
                type='button'
                @click='selectedCategory = type.value; typeDropdownOpen = false'
                class='w-full px-5 py-4 text-left hover:bg-slate-50 transition-colors duration-200 flex items-start gap-4 group/item'
                :class="selectedCategory === type.value ? 'bg-slate-100' : ''"
              >
                <div
                  class='w-10 h-10 rounded-full bg-secondary flex items-center justify-center text-white flex-shrink-0 group-hover/item:bg-slate-200 transition-colors'
                  :class="selectedCategory === type.value ? 'bg-gradient-to-br from-primary via-secondary to-gray-900' : ''"
                >
                  <i :class='type.icon' class='fas'></i>
                </div>
                <div class='flex-1'>
                  <h4
                    class='font-bold text-gray-900 mb-1'
                    x-text='type.title'
                  ></h4>
                  <p class='text-sm text-gray-600' x-text='type.desc'></p>
                </div>
                <div
                  x-show='selectedCategory === type.value'
                  class='flex-shrink-0'
                >
                  <i class='fas fa-check text-slate-600'></i>
                </div>
              </button>
            </template>
          </div>
        </div>

        <!-- Method Filter (Online/Offline) -->
        <div @click.away='methodDropdownOpen = false' class='group relative'>
          <label
            class='flex items-center gap-2 text-gray-700 font-semibold mb-3 text-sm uppercase tracking-wide'
          >
            <i class='fas fa-laptop text-slate-600'></i>
            {{t "test.home.programSection.method"}}
          </label>

          <button
            @click='methodDropdownOpen = !methodDropdownOpen'
            type='button'
            class='w-full px-5 py-4 pr-12 bg-white border border-gray-300 rounded-2xl text-gray-900 font-medium focus:outline-none focus:ring-2 focus:ring-slate-500 transition-all duration-300 hover:border-slate-400 text-left relative shadow-sm'
          >
            <div class='flex items-center gap-3'>
              <i
                :class='selectedMethodItem.icon'
                class='fas text-slate-600'
              ></i>
              <span x-text='selectedMethodItem.title'></span>
            </div>
            <div
              class='absolute right-4 top-1/2 -translate-y-1/2 transition-transform duration-300'
              :class="methodDropdownOpen ? 'rotate-180' : ''"
            >
              <i class='fas fa-chevron-down text-gray-500 text-lg'></i>
            </div>
          </button>

          <!-- Method Dropdown -->
          <div
            x-show='methodDropdownOpen'
            x-transition
            style='z-index: 9999'
            class='absolute w-full mt-2 bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden'
          >
            <template x-for='method in methodOptions' :key='method.value'>
              <button
                type='button'
                @click='selectedMethod = method.value; methodDropdownOpen = false'
                class='w-full px-5 py-4 text-left hover:bg-slate-50 transition-colors duration-200 flex items-start gap-4 group/item'
                :class="selectedMethod === method.value ? 'bg-slate-100' : ''"
              >
                <div
                  class='w-10 h-10 rounded-full bg-secondary flex items-center justify-center text-white flex-shrink-0 group-hover/item:bg-slate-200 transition-colors'
                  :class="selectedMethod === method.value ? 'bg-gradient-to-br from-primary via-secondary to-gray-900' : ''"
                >
                  <i :class='method.icon' class='fas'></i>
                </div>
                <div class='flex-1'>
                  <h4
                    class='font-bold text-gray-900 mb-1'
                    x-text='method.title'
                  ></h4>
                  <p class='text-sm text-gray-600' x-text='method.desc'></p>
                </div>
                <div
                  x-show='selectedMethod === method.value'
                  class='flex-shrink-0'
                >
                  <i class='fas fa-check text-slate-600'></i>
                </div>
              </button>
            </template>
          </div>
        </div>

        <!-- Search Input -->
        <div class='group'>
          <label
            class='flex items-center gap-2 text-gray-700 font-semibold mb-3 text-sm uppercase tracking-wide'
          >
            <i class='fas fa-search text-slate-600'></i>
            {{t "test.home.programSection.search"}}
          </label>
          <div class='relative'>
            <input
              type='text'
              x-model='searchQuery'
              placeholder='{{t "test.mycourse.placeholderSearch"}}'
              class='w-full px-5 py-4 pr-12 bg-white border border-gray-300 rounded-2xl text-gray-900 placeholder-gray-400 font-medium focus:outline-none focus:ring-2 focus:ring-slate-500 transition-all duration-300 hover:border-slate-400 shadow-sm'
            />
            <button
              x-show="searchQuery !== ''"
              @click="searchQuery = ''"
              class='absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-slate-600 transition-colors duration-200'
            >
              <i class='fas fa-times-circle text-xl'></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Active Filters & Reset -->
      <div
        class='flex items-center justify-between flex-wrap gap-4'
        x-show="selectedCategory !== 'all' || tab !== 'all' || searchQuery !== '' || selectedMethod !== 'all'"
      >
        <div class='flex items-center gap-3 flex-wrap'>
          <span class='text-gray-600 text-sm font-medium'>{{t "test.home.programSection.ActiveFilters"}}</span>
          <span
            x-show="tab !== 'all'"
            class='px-4 py-2 bg-slate-100 text-slate-700 rounded-lg text-sm font-medium border border-slate-300'
          >
            <i class='fas fa-tag mr-2'></i><span x-text='tab'></span>
          </span>
          <span
            x-show="selectedCategory !== 'all'"
            class='px-4 py-2 bg-slate-100 text-slate-700 rounded-lg text-sm font-medium border border-slate-300'
          >
            <i class='fas fa-layer-group mr-2'></i><span
              x-text='selectedCategory'
            ></span>
          </span>
          <span
            x-show="selectedMethod !== 'all'"
            class='px-4 py-2 bg-slate-100 text-slate-700 rounded-lg text-sm font-medium border border-slate-300'
          >
            <i :class="'fas ' + selectedMethodItem.icon + ' mr-2'"></i><span
              x-text='selectedMethodItem.title'
            ></span>
          </span>
          <span
            x-show="searchQuery !== ''"
            class='px-4 py-2 bg-slate-100 text-slate-700 rounded-lg text-sm font-medium border border-slate-300'
          >
            <i class='fas fa-search mr-2'></i>"<span
              x-text='searchQuery'
            ></span>"
          </span>
        </div>
        <button
          @click='resetFilters()'
          class='px-6 py-2.5 bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg font-medium'
        >
          <i class='fas fa-redo mr-2'></i>{{t "test.home.programSection.resetAll"}}
        </button>
      </div>
    </div>

    <!-- Results Counter -->
    <div class='mt-6 text-center'>
      <p class='text-gray-600'>
        {{t "test.home.programSection.showing"}}
        <span
          class='text-gray-900 font-bold'
          x-text='filteredKelas.filter((el, idx) => paginatedKelas(el)).length'
        ></span>
        {{t "test.home.programSection.of"}}
        <span class='text-gray-900 font-bold' x-text='filteredKelas.length'></span>
        {{t "test.mycourse.programsAvailable"}}
      </p>
    </div>
  </div>

  <!-- Classes Grid -->
  <div
    class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto'
    x-ref='kelasList'
  >
    {{#each kelas}}
      <div
        data-animate="scale-up"
        data-delay="100"
        class='group card bg-white shadow-2xl border-0 rounded-2xl overflow-hidden transition-all duration-300 transform hover:-translate-y-2 hover:shadow-3xl'
        data-kategori='{{kategori.nama_kategori}}'
        data-category='{{ jenis_kelas.nama_jenis_kelas }}'
        data-nama='{{nama_kelas}}'
        data-deskripsi='{{getByLang deskripsi ../lang}}'
        data-location='{{metode}}'
        x-show="(tab === 'all' || tab === '{{kategori.nama_kategori}}') && paginatedKelas($el)"
        x-transition
      >
        <!-- Gambar lebih bescar -->
        <img
          src='{{gambar}}'
          alt='{{nama_kelas}}'
          class='h-48 w-full object-cover
 group-hover:scale-105 transition-transform duration-300 drop-shadow-lg'
        />

        <div class='card-body p-6'>
          <div class='flex gap-2 mb-3'>
            <span
              class='badge flex justify-center h-fit items-center bg-slate-100 text-slate-700 px-3 py-1 text-xs font-semibold rounded-full'
            >
              {{kategori.nama_kategori}}
            </span>
            <span
              class='badge flex justify-center h-fit items-center bg-gradient-to-r from-slate-500 to-slate-600 text-white px-3 py-1 text-xs font-semibold rounded-full'
            >
              {{ jenis_kelas.nama_jenis_kelas }}
            </span>

          </div>

          <div class='flex flex-wrap gap-2 mb-4 text-sm text-gray-700'>
            <div
              class='flex items-center gap-2 bg-gray-100 px-3 py-1 rounded-full'
            >
            {{#if (eq metode "online")}}
              <i class='fas fa-laptop text-slate-500'></i>
              <span>{{t "test.home.programSection.online"}}</span>
              {{else if (eq metode "offline")}}
              <i class='fas fa-map-marker-alt text-slate-500'></i>
              <span>{{t "test.home.programSection.offline"}}</span>
              {{/if}}
            </div>
            <div
              class='flex items-center gap-2 bg-gray-100 px-3 py-1 rounded-full'
            >
              <i class='fas fa-user-tie text-slate-500'></i>
              <span>{{getByLang lokasi ../lang}}</span>
            </div>
          </div>

          <h2
            class='card-title text-gray-900 text-xl font-bold mb-3'
          >{{nama_kelas}}</h2>

          <p class='text-sm text-gray-600 line-clamp-1 mb-4 leading-relaxed'>
            {{getByLang deskripsi ../lang}}
          </p>


        <div class='card-actions'>
            <a
            href='/kelass/{{id}}'
            class='btn bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white text-lg px-8 py-3 w-full border-0 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex justify-center items-center text-center'
          >
            {{t "test.home.programSection.buttonViewProgram"}}
          </a>
        </div>
        </div>
      </div>
    {{/each}}

  </div>

  <!-- No Results -->
  <div
    x-show='filteredKelas.length === 0'
    class='text-center py-20'
    x-transition
  >
    <div
      class='bg-slate-100 w-32 h-32 mx-auto mb-6 rounded-full flex items-center justify-center border border-slate-200 shadow-md'
    >
      <i class='fas fa-inbox text-5xl text-slate-500'></i>
    </div>
    <h3 class='text-3xl font-bold text-gray-900 mb-3'>{{t "test.home.programSection.noProgram"}}</h3>
    <p class='text-slate-600 text-lg mb-6'>{{t "test.home.programSection.spanNoProgram"}}</p>
    <button
      @click='resetFilters()'
      class='px-6 py-3 bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white rounded-lg transition-all duration-300 transform hover:scale-105 font-semibold shadow-xl'
    >
      <i class='fas fa-redo mr-2'></i>{{t "test.home.programSection.clearFilters"}}
    </button>
  </div>

  <!-- Pagination -->
  <div
    class='flex justify-center items-center gap-4 mt-12'
    x-show='totalPages > 1'
  >
    <button
      @click='currentPage = Math.max(1, currentPage - 1)'
      :disabled='currentPage === 1'
      class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'
    >
      <i class='fas fa-chevron-left'></i>
    </button>

    <template x-for='page in totalPages' :key='page'>
      <button
        @click='currentPage = page'
        class='w-12 h-12 rounded-xl text-lg font-semibold transition-all duration-300 border shadow-sm'
        :class="currentPage === page ? 'bg-gradient-to-r from-slate-600 to-slate-800 text-white border-slate-700 shadow-md' : 'bg-white text-gray-700 border-gray-300 hover:bg-slate-50'"
        x-text='page'
      ></button>
    </template>

    <button
      @click='currentPage = Math.min(totalPages, currentPage + 1)'
      :disabled='currentPage === totalPages'
      class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 shadow-sm'
    >
      <i class='fas fa-chevron-right'></i>
    </button>
  </div>
</div>