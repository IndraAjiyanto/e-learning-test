<div
  x-data="{
      tab: 'all',
    selectedCategory: 'all',
    selectedMethod: 'all',
    searchQuery: '',
    currentPage: 1,
    totalPages: 1,
    totalItems: 0,
    itemsPerPage: 6,
    loading: false,
    kelasItems: [],
    lang: '{{lang}}',

      categoriesData: [
        { value: 'all', icon: 'fa-th', title: '{{t "test.home.programSection.allCategory"}}', desc: '{{t "test.home.programSection.deskripsiAllCategory"}}' },
        {{#each category}}
        { value: '{{this.name}}', icon: `{{this.icon}}`, title: '{{this.name}}', desc: `{{truncate (getByLang this.description ../lang) 10}}` },
        {{/each}}
      ],
      
      courseCategoriesData: [
        { value: 'all', icon: 'fa-layer-group', title: '{{t "test.home.programSection.allTypes"}}', desc: '{{t "test.home.programSection.deskripsiAllTypes"}}' },
        {{#each courseType}}
        { value: `{{this.nameClassesType }}`, icon: '/{{computeIcon this.icon}}', title: `{{this.nameClassesType}}`, desc: `{{truncate (getByLang this.description ../lang) 10}}` },
        {{/each}}
      ],
      
      methodOptions: [
        { value: 'all', icon: 'fa-th', title: '{{t "test.home.programSection.allMethod"}}', desc: '{{t "test.home.programSection.deskripsiAllMethod"}}' },
        { value: 'online', icon: 'fa-laptop', title: '{{t "test.home.programSection.online"}}', desc: '{{t "test.home.programSection.deskripsiOnline"}}' },
        { value: 'offline', icon: 'fa-map-marker-alt', title: '{{t "test.home.programSection.offline"}}', desc: '{{t "test.home.programSection.deskripsiOffline"}}' }
      ],

    categoryDropdownOpen: false,
    typeDropdownOpen: false,
    methodDropdownOpen: false,

    async init() {
      // Hapus $watch lama, ganti dengan watch yang trigger fetch
      this.$watch('tab', () => { this.currentPage = 1; this.fetchKelas(); });
      this.$watch('selectedCategory', () => { this.currentPage = 1; this.fetchKelas(); });
      this.$watch('selectedMethod', () => { this.currentPage = 1; this.fetchKelas(); });
      this.$watch('searchQuery', () => { this.currentPage = 1; this.fetchKelas(); });
      await this.fetchKelas();
    },

    async fetchKelas() {
      this.loading = true;
      try {
        const params = new URLSearchParams();
        params.set('userId', `{{user.id}}`)
        if (this.tab !== 'all') params.set('category', this.tab);
        if (this.selectedCategory !== 'all') params.set('courseType', this.selectedCategory);
        if (this.selectedMethod !== 'all') params.set('method', this.selectedMethod);
        if (this.searchQuery) params.set('search', this.searchQuery);
        params.set('page', this.currentPage);
        params.set('limit', this.itemsPerPage);

        const res = await fetch(`/dashboard/course/filter?${params.toString()}`);
        const json = await res.json();

        this.kelasItems = json.data;
        this.totalItems = json.totalItems;
        this.totalPages = json.totalPages;
        this.currentPage = json.currentPage;
      } catch (err) {
        console.error('Fetch course error:', err);
      } finally {
        this.loading = false;
      }
    },

    async changePage(page) {
      this.currentPage = page;
      await this.fetchKelas();
    },

            getByLang(obj, lang) {
      if (!obj || typeof obj !== 'object') return '';
      return obj[lang] || obj.id || obj.en || '';
    },

    async resetFilters() {
      this.tab = 'all';
      this.selectedCategory = 'all';
      this.selectedMethod = 'all';
      this.searchQuery = '';
      // currentPage akan di-reset oleh $watch tab
    },

    // Computed tetap bisa pakai ini
    get selectedCategoryItem() {
      return this.categoriesData.find(c => c.value === this.tab) || this.categoriesData[0];
    },
    get selectedTypeItem() {
      return this.courseCategoriesData.find(c => c.value === this.selectedCategory) || this.courseCategoriesData[0];
    },
    get selectedMethodItem() {
      return this.methodOptions.find(m => m.value === this.selectedMethod) || this.methodOptions[0];
    },
  }"
  class='bg-gradient-to-br from-white via-gray-50 to-white py-20 px-6 lg:px-20 relative overflow-visionsble'
  x-init="$watch('tab', () => currentPage = 1); $watch('selectedMethod', () => currentPage = 1); $watch('selectedCategory', () => currentPage = 1); $watch('searchQuery', () => currentPage = 1)"
  id='courses-section'
>

{{> user/myProgram/header}}

{{> user/myProgram/filter}}

{{> user/myProgram/content}}
</div>