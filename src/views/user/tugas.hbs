<div class="bg-gradient-to-br from-slate-50 via-white to-slate-100 min-h-screen pt-28 py-20">
  <div class="max-w-7xl mx-auto px-6">
    <div class="bg-white rounded-2xl shadow-2xl p-10 border border-slate-200">
<div class="flex justify-start mb-8">
  <a href="/kelass/{{tugas.pertemuan.minggu.kelas.id}}" 
     class="btn bg-white inline-flex items-center gap-3 px-6 py-3 rounded-xl border border-slate-300 shadow-lg hover:shadow-xl text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-all duration-300 font-semibold text-base transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    {{t "test.assigment.backProgram"}}
  </a>
</div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Kolom Kiri: Assignment Material -->
        <div class="space-y-6">
          <div class="bg-gradient-to-br from-white to-slate-50 p-6 rounded-2xl border border-slate-200 shadow-lg">
            <div class="flex items-center mb-4">
              <h4 class="text-xl text-gray-900 font-bold font-montserrat">{{t "test.assigment.assigment"}}</h4>
            </div>
            <div class="overflow-hidden rounded-xl border border-slate-200 shadow-sm bg-white">
              <iframe
                  class="w-full h-[500px] border-0" 
  src="{{tugas.file}}"
  type="application/pdf"
></iframe>
            </div>
          </div>

          <!-- Submit Answer Form -->

        </div>

        <!-- Kolom Kanan: Your Answer -->
        <div class="space-y-6">
          <div class="bg-gradient-to-br from-white to-slate-50 p-6 rounded-2xl border border-slate-200 shadow-lg ">
            <div class="flex items-center mb-4">
              <h4 class="text-xl text-gray-900 font-bold font-montserrat">{{t "test.assigment.yourAnswer"}}</h4>
            </div>
            
            {{#if jawaban_tugas.length}}
              <div class="space-y-4 max-h-[500px] overflow-y-auto pr-2">
                {{#each jawaban_tugas}}
                  <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-300">
                    <div class="flex flex-col gap-3 mb-4">
                      {{#if (eq this.proses 'acc')}}
                                            <a 
                        href="{{this.file}}" 
                        target="_blank"
                        class="text-base text-slate-700 font-semibold hover:text-slate-900 hover:underline transition-colors break-words"
                      >
                        {{this.file}}
                      </a>
                      {{else}}
                      <a 
                        href="{{this.file}}" 
                        target="_blank"
                        class="text-base text-slate-700 font-semibold hover:text-slate-900 hover:underline transition-colors break-words"
                      >
                        {{this.file}}
                      </a>
                      {{/if}}
                    </div>
                    
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="inline-flex items-center px-3 py-1 text-xs font-semibold rounded-full
                        {{#if (roles this.proses 'acc')}} 
                          bg-gradient-to-r from-emerald-50 to-green-50 text-emerald-700 border border-emerald-200
                        {{else if (roles this.proses 'proces')}} 
                          bg-gradient-to-r from-amber-50 to-yellow-50 text-amber-700 border border-amber-200
                        {{else if (roles this.proses 'rejected')}} 
                          bg-gradient-to-r from-red-50 to-rose-50 text-red-700 border border-red-200
                        {{/if}}">
                        {{#if (roles this.proses 'acc')}}
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                          </svg>
                          {{t "test.assigment.approved"}}
                        {{else if (roles this.proses 'proces')}}
                          <svg class="w-3 h-3 mr-1 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                          </svg>
                          {{t "test.assigment.underReview"}}
                        {{else if (roles this.proses 'rejected')}}
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                          </svg>
                          {{t "test.assigment.needsRevision"}}
                        {{/if}}
                      </span>
                      {{#unless (eq this.proses 'acc')}}
                        <button 
                          type="button" 
                          onclick="toggleEditForm({{this.id}})"
                          class="inline-flex items-center px-3 py-1 text-xs font-semibold rounded-full bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100 transition-colors"
                        >
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                          </svg>
                          Edit
                        </button>
                      {{/unless}}
                    </div>

                    {{#if this.komentar}}
                      <div class="mt-4 space-y-2">
                        {{#each komentar}}
                          <div class="p-3 bg-gradient-to-r from-slate-50 to-slate-100 border border-slate-200 rounded-lg">
                            <div class="flex items-start gap-2">
                              <div class="w-1.5 h-1.5 bg-slate-400 rounded-full mt-2 flex-shrink-0"></div>
                              <div class="flex-1">
                                <p class="text-sm text-slate-700 leading-relaxed ">{{this.komentar}}</p>
                       
                              </div>
                            </div>
                          </div>
                        {{/each}}
                      </div>
                    {{/if}}

                    <div id="edit-form-{{this.id}}" class="mt-4 hidden">
                      <form 
                            x-data="{ loading: false }"
  @submit="loading = true"
                        action="/answer-assigment/{{../tugas.id}}/{{this.id}}?_method=PATCH" 
                        method="POST" 
                        class="space-y-4"
                      >
                        <input 
                          type="text" 
                          name="file" 
                          value="{{this.file}}"
                          placeholder="https://drive.google.com/..." 
                          required
                          class="w-full px-4 py-3 border border-slate-300 rounded-xl bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-all duration-300 hover:bg-white"
                        >
                          <button 
                            :disabled="loading"
                            type="submit" 
                            class="btn border-0 px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors"
                          >
                            <span x-show="loading" class="loading loading-spinner loading-sm"></span>
                            <span x-show="!loading">{{t "test.assigment.update"}}</span>
                          </button>
                          <button 
                            type="button"
                            :disabled="loading"
                            onclick="toggleEditForm({{this.id}})"
                            class="btn border-0 px-4 py-2 bg-gray-500 text-white font-semibold rounded-lg hover:bg-gray-600 transition-colors"
                          >
                            {{t "test.assigment.cancel"}}
                          </button>
                      </form>
                    </div>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <div >
            <p class="text-sm text-slate-600 mb-4 leading-relaxed ">
              {{t "test.assigment.spanSubmitYourAnswer"}}
            </p>
            <form 
                  x-data="{ loading: false }"
  @submit="loading = true"
              action="/answer-assigment/{{tugas.id}}/{{tugas.pertemuan.id}}" 
              method="POST" 
              class="space-y-4"
            >
              <input 
                type="text" 
                name="file" 
                placeholder="https://drive.google.com/..." 
                required
                class="w-full px-4 py-3 border border-slate-300 rounded-xl bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-all duration-300 hover:bg-white"
              >
              <button 
              :disabled="loading"
                type="submit" 
                class="btn border-0 w-full px-6 py-3 bg-gradient-to-br from-primary via-secondary to-gray-900 hover:from-primary hover:to-secondary text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2"
              >
              <span x-show="loading" class="loading loading-spinner loading-sm"></span>
              <span x-show="!loading">{{t "test.assigment.submitAnswer"}}</span>
              </button>
            </form>
              </div>
            {{/if}}
          </div>
        </div>
      </div>

      <!-- Back Button -->

    </div>
  </div>
</div>

<script>
  function toggleEditForm(id) {
    const form = document.getElementById('edit-form-' + id);
    if (form.classList.contains('hidden')) {
      form.classList.remove('hidden');
    } else {
      form.classList.add('hidden');
    }
  }
</script>