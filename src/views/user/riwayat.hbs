

<section class="py-16 bg-gradient-to-br from-slate-50 via-white to-slate-100 pt-28" 
         x-data="{ open: false, imageSrc: '', mainTab: 'pembayaran', statusTab: 'all' }">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="text-center mb-12">
        <div class="bg-white rounded-xl px-8 py-4">
          <h2 class="text-4xl font-bold bg-gradient-to-r from-slate-700 to-slate-900 bg-clip-text text-transparent font-montserrat">
            Transaction History
          </h2>
      </div>
      <p class="text-slate-600 text-lg max-w-2xl mx-auto font-inter">
        Track and manage all your payment and registration transactions
      </p>
    </div>

    <!-- Main Tabs: Pembayaran & Pendaftaran -->
    <div class="flex flex-wrap justify-center gap-3 md:gap-4 mb-8 px-4">
      <button @click="mainTab = 'pembayaran'; statusTab = 'all'"
        :class="mainTab === 'pembayaran' ? 'bg-gradient-to-r from-slate-600 to-slate-800 text-white shadow-lg scale-105' : 'bg-white text-slate-700 hover:bg-slate-50 border border-slate-200'"
        class="px-6 md:px-8 py-3 md:py-4 rounded-xl font-bold transition-all duration-300 transform hover:scale-105 hover:shadow-md flex items-center gap-2 text-base md:text-lg">
        <i class="fas fa-credit-card"></i>
        <span>Payments</span>
      </button>
      <button @click="mainTab = 'pendaftaran'; statusTab = 'all'"
        :class="mainTab === 'pendaftaran' ? 'bg-gradient-to-r from-emerald-600 to-green-700 text-white shadow-lg scale-105' : 'bg-white text-slate-700 hover:bg-emerald-50 border border-slate-200'"
        class="px-6 md:px-8 py-3 md:py-4 rounded-xl font-bold transition-all duration-300 transform hover:scale-105 hover:shadow-md flex items-center gap-2 text-base md:text-lg">
        <i class="fas fa-user-plus"></i>
        <span>Registrations</span>
      </button>
    </div>

    <!-- Status Filter Tabs -->
    <div class="flex flex-wrap justify-center gap-3 md:gap-4 mb-12 px-4">
      <button @click="statusTab = 'all'"
        :class="statusTab === 'all' ? 'bg-gradient-to-r from-slate-500 to-slate-700 text-white shadow-lg scale-105' : 'bg-white text-slate-700 hover:bg-slate-50 border border-slate-200'"
        class="px-4 md:px-6 py-2.5 md:py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 hover:shadow-md flex items-center gap-2 text-sm md:text-base">
        <i class="fas fa-list text-xs md:text-sm"></i>
        <span class="hidden sm:inline">All Status</span>
        <span class="sm:hidden">All</span>
      </button>
      <button @click="statusTab = 'acc'"
        :class="statusTab === 'acc' ? 'bg-gradient-to-r from-emerald-500 to-emerald-700 text-white shadow-lg scale-105' : 'bg-white text-slate-700 hover:bg-emerald-50 border border-slate-200'"
        class="px-4 md:px-6 py-2.5 md:py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 hover:shadow-md flex items-center gap-2 text-sm md:text-base">
        <i class="fas fa-check-circle text-xs md:text-sm"></i>
        <span class="hidden sm:inline">Accepted</span>
        <span class="sm:hidden">Accept</span>
      </button>
      <button @click="statusTab = 'proces'"
        :class="statusTab === 'proces' ? 'bg-gradient-to-r from-amber-500 to-orange-600 text-white shadow-lg scale-105' : 'bg-white text-slate-700 hover:bg-amber-50 border border-slate-200'"
        class="px-4 md:px-6 py-2.5 md:py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 hover:shadow-md flex items-center gap-2 text-sm md:text-base">
        <i class="fas fa-clock text-xs md:text-sm"></i>
        <span class="hidden sm:inline">Processing</span>
        <span class="sm:hidden">Process</span>
      </button>
      <button @click="statusTab = 'rejected'"
        :class="statusTab === 'rejected' ? 'bg-gradient-to-r from-red-500 to-red-700 text-white shadow-lg scale-105' : 'bg-white text-slate-700 hover:bg-red-50 border border-slate-200'"
        class="px-4 md:px-6 py-2.5 md:py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 hover:shadow-md flex items-center gap-2 text-sm md:text-base">
        <i class="fas fa-times-circle text-xs md:text-sm"></i>
        <span class="hidden sm:inline">Rejected</span>
        <span class="sm:hidden">Reject</span>
      </button>
    </div>

    <!-- Pembayaran Content -->
    <div x-show="mainTab === 'pembayaran'" x-transition>
      {{#if pembayaran.length}}
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
          {{#each pembayaran}}
            <div 
              x-show="statusTab === 'all' 
                || (statusTab === 'acc' && '{{this.proses}}' === 'acc') 
                || (statusTab === 'proces' && '{{this.proses}}' === 'proces') 
                || (statusTab === 'rejected' && '{{this.proses}}' === 'rejected')"
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 transform scale-95"
              x-transition:enter-end="opacity-100 transform scale-100"
              class="group relative rounded-2xl shadow-lg overflow-hidden border transition-all duration-300 transform hover:scale-105 hover:shadow-2xl
                {{#if (roles this.proses 'acc')}} bg-gradient-to-br from-emerald-50 to-emerald-100 border-emerald-200 hover:from-emerald-100 hover:to-emerald-200
                {{else if (roles this.proses 'proces')}} bg-gradient-to-br from-amber-50 to-orange-100 border-amber-200 hover:from-amber-100 hover:to-orange-200
                {{else}} bg-gradient-to-br from-red-50 to-red-100 border-red-200 hover:from-red-100 hover:to-red-200 {{/if}}">

              <div class="absolute top-4 right-4 z-10">
                {{#if (roles this.proses 'acc')}}
                  <div class="bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-2 md:px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1">
                    <i class="fas fa-check"></i>
                    <span class="hidden sm:inline">ACCEPTED</span>
                    <span class="sm:hidden">ACC</span>
                  </div>
                {{else if (roles this.proses 'proces')}}
                  <div class="bg-gradient-to-r from-amber-500 to-orange-600 text-white px-2 md:px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1">
                    <i class="fas fa-clock"></i>
                    <span class="hidden sm:inline">PROCESSING</span>
                    <span class="sm:hidden">PROC</span>
                  </div>
                {{else}}
                  <div class="bg-gradient-to-r from-red-500 to-red-600 text-white px-2 md:px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1">
                    <i class="fas fa-times"></i>
                    <span class="hidden sm:inline">REJECTED</span>
                    <span class="sm:hidden">REJ</span>
                  </div>
                {{/if}}
              </div>

              <div class="p-4 md:p-6 lg:p-8 space-y-4 md:space-y-6">
                <div class="space-y-2 md:space-y-3">
                  <div class="bg-slate-600 text-white px-3 py-1 rounded-lg inline-flex items-center gap-2 text-xs font-semibold mb-2">
                    <i class="fas fa-credit-card"></i>
                    <span>PAYMENT</span>
                  </div>
                  
                  <h3 class="text-lg md:text-xl font-bold text-slate-900 group-hover:text-slate-800 transition-colors font-montserrat line-clamp-2">
                    <i class="fas fa-graduation-cap mr-2 text-slate-600 text-sm md:text-base"></i>
                    {{this.kelas.nama_kelas}}
                  </h3>
                  
                  <div class="flex items-center text-slate-600 text-xs md:text-sm font-inter">
                    <i class="fas fa-calendar-alt mr-2"></i>
                    <span class="font-medium">Payment Date:</span>
                    <span class="ml-2">{{formatTanggal this.createdAt}}</span>
                  </div>

                  <div class="flex items-center text-xs md:text-sm">
                    <i class="fas fa-info-circle mr-2 text-slate-500"></i>
                    <span class="font-medium text-slate-700">Status:</span>
                    {{#if (roles this.proses 'acc')}}
                      <span class="ml-2 text-emerald-700 font-bold">ACCEPTED</span>
                    {{else if (roles this.proses 'proces')}}
                      <span class="ml-2 text-amber-700 font-bold">PROCESSING</span>
                    {{else}}
                      <span class="ml-2 text-red-700 font-bold">REJECTED</span>
                    {{/if}}
                  </div>
                </div>

                <!-- WhatsApp Contact for Processing and Rejected -->
                {{#if (roles this.proses 'proces')}}
                  <div class="bg-amber-100 border border-amber-300 rounded-xl p-3 md:p-4 space-y-2">
                    <div class="flex items-center gap-2 text-amber-800 font-semibold text-xs md:text-sm">
                      <i class="fas fa-info-circle"></i>
                      <span>Payment Under Review</span>
                    </div>
                    <p class="text-amber-700 text-xs md:text-sm">Your payment is being verified. If you have questions, contact us:</p>
                    <a 
                      href="https://wa.me/6281234567890?text=Hi,%20I%20have%20a%20question%20about%20my%20payment%20for%20{{this.kelas.nama_kelas}}" 
                      target="_blank"
                      class="flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white px-3 md:px-4 py-2 rounded-lg font-semibold text-xs md:text-sm transition-all duration-300 transform hover:scale-105 shadow-md w-full justify-center">
                      <i class="fab fa-whatsapp text-base md:text-lg"></i>
                      <span>Contact Admin via WhatsApp</span>
                    </a>
                  </div>
                {{else if (roles this.proses 'rejected')}}
                  <div class="bg-red-100 border border-red-300 rounded-xl p-3 md:p-4 space-y-2">
                    <div class="flex items-center gap-2 text-red-800 font-semibold text-xs md:text-sm">
                      <i class="fas fa-exclamation-triangle"></i>
                      <span>Payment Rejected</span>
                    </div>
                    <p class="text-red-700 text-xs md:text-sm">Your payment was rejected. Please contact admin for assistance:</p>
                    <a 
                      href="https://wa.me/6281234567890?text=Hi,%20my%20payment%20for%20{{this.kelas.nama_kelas}}%20was%20rejected.%20I%20need%20help." 
                      target="_blank"
                      class="flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white px-3 md:px-4 py-2 rounded-lg font-semibold text-xs md:text-sm transition-all duration-300 transform hover:scale-105 shadow-md w-full justify-center">
                      <i class="fab fa-whatsapp text-base md:text-lg"></i>
                      <span>Contact Admin via WhatsApp</span>
                    </a>
                  </div>
                {{/if}}

                <div class="flex flex-col sm:flex-row gap-2 md:gap-3 pt-4 md:pt-6">
                  <button 
                    @click="open = true; imageSrc = '{{this.file}}'" 
                    class="flex-1 py-2.5 md:py-3 px-3 md:px-4 rounded-xl bg-gradient-to-r from-slate-600 to-slate-800 text-white font-semibold text-xs md:text-sm hover:from-slate-700 hover:to-slate-900 transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                    <i class="fas fa-eye"></i>
                    <span>View Proof</span>
                  </button>
                  <a 
                    href="/kelass/{{this.kelas.id}}" 
                    class="flex-1 py-2.5 md:py-3 px-3 md:px-4 rounded-xl bg-white text-slate-800 border-2 border-slate-200 font-semibold text-xs md:text-sm hover:bg-slate-50 hover:border-slate-300 transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                    <i class="fas fa-external-link-alt"></i>
                    <span>View Class</span>
                  </a>
                </div>
              </div>

              <div class="absolute inset-0 bg-gradient-to-t from-black/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="text-center py-12 md:py-16 px-4">
          <div class="p-8 md:p-12 max-w-md mx-auto">
            <i class="fas fa-receipt text-5xl md:text-6xl text-slate-400 mb-4 md:mb-6"></i>
            <h3 class="text-lg md:text-xl font-bold text-slate-700 mb-2 md:mb-3 font-montserrat">No Payment History</h3>
            <p class="text-sm md:text-base text-slate-600 font-inter">You haven't made any payments yet. Start exploring our courses!</p>
          </div>
        </div>
      {{/if}}
    </div>

    <!-- Pendaftaran Content -->
    <div x-show="mainTab === 'pendaftaran'" x-transition>
      {{#if pendaftaran.length}}
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
          {{#each pendaftaran}}
            <div 
              x-show="statusTab === 'all' 
                || (statusTab === 'acc' && '{{this.proses}}' === 'acc') 
                || (statusTab === 'proces' && '{{this.proses}}' === 'proces') 
                || (statusTab === 'rejected' && '{{this.proses}}' === 'rejected')"
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 transform scale-95"
              x-transition:enter-end="opacity-100 transform scale-100"
              class="group relative rounded-2xl shadow-lg overflow-hidden border transition-all duration-300 transform hover:scale-105 hover:shadow-2xl
                {{#if (roles this.proses 'acc')}} bg-gradient-to-br from-emerald-50 to-emerald-100 border-emerald-200 hover:from-emerald-100 hover:to-emerald-200
                {{else if (roles this.proses 'proces')}} bg-gradient-to-br from-amber-50 to-orange-100 border-amber-200 hover:from-amber-100 hover:to-orange-200
                {{else}} bg-gradient-to-br from-red-50 to-red-100 border-red-200 hover:from-red-100 hover:to-red-200 {{/if}}">

              <div class="absolute top-4 right-4 z-10">
                {{#if (roles this.proses 'acc')}}
                  <div class="bg-gradient-to-r from-emerald-500 to-emerald-600 text-white px-2 md:px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1">
                    <i class="fas fa-check"></i>
                    <span class="hidden sm:inline">ACCEPTED</span>
                    <span class="sm:hidden">ACC</span>
                  </div>
                {{else if (roles this.proses 'proces')}}
                  <div class="bg-gradient-to-r from-amber-500 to-orange-600 text-white px-2 md:px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1">
                    <i class="fas fa-clock"></i>
                    <span class="hidden sm:inline">PROCESSING</span>
                    <span class="sm:hidden">PROC</span>
                  </div>
                {{else}}
                  <div class="bg-gradient-to-r from-red-500 to-red-600 text-white px-2 md:px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1">
                    <i class="fas fa-times"></i>
                    <span class="hidden sm:inline">REJECTED</span>
                    <span class="sm:hidden">REJ</span>
                  </div>
                {{/if}}
              </div>

              <div class="p-4 md:p-6 lg:p-8 space-y-4 md:space-y-6">
                <div class="space-y-2 md:space-y-3">
                  <div class="bg-emerald-600 text-white px-3 py-1 rounded-lg inline-flex items-center gap-2 text-xs font-semibold mb-2">
                    <i class="fas fa-user-plus"></i>
                    <span>REGISTRATION</span>
                  </div>
                  
                  <h3 class="text-lg md:text-xl font-bold text-slate-900 group-hover:text-slate-800 transition-colors font-montserrat line-clamp-2">
                    <i class="fas fa-graduation-cap mr-2 text-slate-600 text-sm md:text-base"></i>
                    {{this.kelas.nama_kelas}}
                  </h3>
                  
                  <div class="flex items-center text-slate-600 text-xs md:text-sm font-inter">
                    <i class="fas fa-calendar-alt mr-2"></i>
                    <span class="font-medium">Registration Date:</span>
                    <span class="ml-2">{{formatTanggal this.createdAt}}</span>
                  </div>

                  <div class="flex items-center text-xs md:text-sm">
                    <i class="fas fa-info-circle mr-2 text-slate-500"></i>
                    <span class="font-medium text-slate-700">Status:</span>
                    {{#if (roles this.proses 'acc')}}
                      <span class="ml-2 text-emerald-700 font-bold">ACCEPTED</span>
                    {{else if (roles this.proses 'proces')}}
                      <span class="ml-2 text-amber-700 font-bold">PROCESSING</span>
                    {{else}}
                      <span class="ml-2 text-red-700 font-bold">REJECTED</span>
                    {{/if}}
                  </div>
                </div>

                <!-- WhatsApp Contact for Processing and Rejected -->
                {{#if (roles this.proses 'proces')}}
                  <div class="bg-amber-100 border border-amber-300 rounded-xl p-3 md:p-4 space-y-2">
                    <div class="flex items-center gap-2 text-amber-800 font-semibold text-xs md:text-sm">
                      <i class="fas fa-info-circle"></i>
                      <span>Registration Under Review</span>
                    </div>
                    <p class="text-amber-700 text-xs md:text-sm">Your registration is being verified. If you have questions, contact us:</p>
                    <a 
                      href="https://wa.me/6281234567890?text=Hi,%20I%20have%20a%20question%20about%20my%20registration%20for%20{{this.kelas.nama_kelas}}" 
                      target="_blank"
                      class="flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white px-3 md:px-4 py-2 rounded-lg font-semibold text-xs md:text-sm transition-all duration-300 transform hover:scale-105 shadow-md w-full justify-center">
                      <i class="fab fa-whatsapp text-base md:text-lg"></i>
                      <span>Contact Admin via WhatsApp</span>
                    </a>
                  </div>
                {{else if (roles this.proses 'rejected')}}
                  <div class="bg-red-100 border border-red-300 rounded-xl p-3 md:p-4 space-y-2">
                    <div class="flex items-center gap-2 text-red-800 font-semibold text-xs md:text-sm">
                      <i class="fas fa-exclamation-triangle"></i>
                      <span>Registration Rejected</span>
                    </div>
                    <p class="text-red-700 text-xs md:text-sm">Your registration was rejected. Please contact admin for assistance:</p>
                    <a 
                      href="https://wa.me/6281234567890?text=Hi,%20my%20registration%20for%20{{this.kelas.nama_kelas}}%20was%20rejected.%20I%20need%20help." 
                      target="_blank"
                      class="flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white px-3 md:px-4 py-2 rounded-lg font-semibold text-xs md:text-sm transition-all duration-300 transform hover:scale-105 shadow-md w-full justify-center">
                      <i class="fab fa-whatsapp text-base md:text-lg"></i>
                      <span>Contact Admin via WhatsApp</span>
                    </a>
                  </div>
                {{/if}}

                <div class="flex flex-col sm:flex-row gap-2 md:gap-3 pt-4 md:pt-6">
                  <button 
                    @click="open = true; imageSrc = '{{this.file}}'" 
                    class="flex-1 py-2.5 md:py-3 px-3 md:px-4 rounded-xl bg-gradient-to-r from-emerald-600 to-green-700 text-white font-semibold text-xs md:text-sm hover:from-emerald-700 hover:to-green-800 transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                    <i class="fas fa-eye"></i>
                    <span>View Proof</span>
                  </button>
                  <a 
                    href="/kelass/{{this.kelas.id}}" 
                    class="flex-1 py-2.5 md:py-3 px-3 md:px-4 rounded-xl bg-white text-slate-800 border-2 border-slate-200 font-semibold text-xs md:text-sm hover:bg-slate-50 hover:border-slate-300 transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                    <i class="fas fa-external-link-alt"></i>
                    <span>View Class</span>
                  </a>
                </div>
              </div>

              <div class="absolute inset-0 bg-gradient-to-t from-black/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="text-center py-12 md:py-16 px-4">
          <div class="p-8 md:p-12 max-w-md mx-auto">
            <i class="fas fa-user-plus text-5xl md:text-6xl text-emerald-400 mb-4 md:mb-6"></i>
            <h3 class="text-lg md:text-xl font-bold text-slate-700 mb-2 md:mb-3 font-montserrat">No Registration History</h3>
            <p class="text-sm md:text-base text-slate-600 font-inter">You haven't registered for any free classes yet. Start learning today!</p>
          </div>
        </div>
      {{/if}}
    </div>
  </div>

  <div 
    x-show="open" 
    class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click.self="open = false"
    x-cloak>

    <div 
      class="bg-white rounded-2xl md:rounded-3xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden relative"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 transform scale-95"
      x-transition:enter-end="opacity-100 transform scale-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 transform scale-100"
      x-transition:leave-end="opacity-0 transform scale-95">
      
      <div class="bg-gradient-to-r from-slate-600 to-slate-800 p-4 md:p-6 flex items-center justify-between">
        <h3 class="text-base md:text-xl font-bold text-white flex items-center gap-2 font-montserrat">
          <i class="fas fa-image text-sm md:text-base"></i>
          <span>Payment Proof</span>
        </h3>
        <button 
          @click="open = false" 
          class="text-white hover:text-slate-200 text-xl md:text-2xl w-8 h-8 md:w-10 md:h-10 rounded-full hover:bg-white/20 transition-all duration-200 flex items-center justify-center">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <div class="p-4 md:p-6 bg-slate-50 overflow-auto max-h-[calc(90vh-80px)]">
        <img 
          :src="imageSrc" 
          alt="Payment Proof" 
          class="rounded-xl md:rounded-2xl w-full max-h-[70vh] object-contain shadow-lg mx-auto">
      </div>
    </div>
  </div>
</section>
