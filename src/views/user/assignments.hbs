{{!-- Dibungkus chrome backoffice. Halaman ini ditautkan dari dalam area
     belajar tetapi punya rute sendiri; sebelumnya memakai navbar publik
     dan footer. Controller-nya merender dengan bareShell: true.
     Lihat docs/user-area-learning-consolidation-plan.md tahap 2. --}}
{{#> user/shell_frame/index user=user active='learning' pageTitle=(t 'test.startLearning.assignment') back=false
 trail=(array
      (obj 'label' (t 'test.common.home') 'href' '/users/profile?tab=dashboard')
      (obj 'label' (t 'test.userSidebar.myLearning') 'href' '/users/profile?tab=learning')
      (obj
        'label' (t 'test.startLearning.startLearning')
        'href' (concat '/program/myProgram/' user.id '?courseId=' assignment.session.weeks.course.id))
      (obj 'label' (t 'test.startLearning.assignment')))
      }}

{{#> components/ui/learning/assignment_page/index
      title=(t 'test.startLearning.assignment')
      subtitle=(t 'test.assigment.spanSubmitYourAnswer') }}
  {{#> components/ui/learning/assignment_page/viewer/index
        title=assignment.title
        fileUrl=assignment.file
        showFileActions=true }}
      {{#if assignment.file}}
        <iframe
          src="{{assignment.file}}"
          class="w-full border-0"
          style="min-height:369px;height:100%;flex:1;"
          allowfullscreen
          loading="lazy"
        ></iframe>
      {{else}}
        {{!-- Fallback: no file uploaded --}}
        <div class="w-full flex flex-col items-center justify-center gap-4 p-10" style="min-height:369px;">
          <svg class="w-12 h-12 text-[#CBD5E1]" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M28 4H12C9.79 4 8.02 5.79 8.02 8L8 40C8 42.21 9.77 44 11.98 44H36C38.21 44 40 42.21 40 40V16L28 4ZM36 40H12V8H26V18H36V40Z" fill="#CBD5E1"/>
          </svg>
          <p class="font-inter font-medium text-[14px] text-[#94A3B8] text-center">
            File belum tersedia
          </p>
        </div>
      {{/if}}
  {{/components/ui/learning/assignment_page/viewer/index}}

  {{#> components/ui/learning/assignment_page/submission/index
        heading=(t 'test.assigment.yourAnswer') }}

  {{#if assignment_answer.length}}
    {{!-- Existing answers list --}}
    <div class="w-full space-y-4 max-h-[420px] overflow-y-auto">
      {{#each assignment_answer}}
        <div class="p-4 bg-[#F8FAFC] border border-[#E2E8F0] rounded-[12px] flex flex-col gap-3">
          <a
            href="{{this.file}}"
            target="_blank"
            class="font-inter font-medium text-[13px] leading-[17px] text-[#2563EB] hover:underline break-all"
            style="font-family:'Geist Mono',monospace;"
          >
            {{this.file}}
          </a>

          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center px-3 py-1 text-xs font-semibold rounded-full
              {{#if (roles this.process 'approved')}}bg-[#f0fdf4] text-[#15803d] border border-[#bbf7d0]
              {{else if (roles this.process 'process')}}bg-[#FEFCE8] text-[#A16207] border border-[#FEF08A]
              {{else if (roles this.process 'rejected')}}bg-[#FEF2F2] text-[#B42318] border border-[#FECACA]
              {{/if}}">
              {{#if (roles this.process 'approved')}}
                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {{t "test.assigment.approved"}}
              {{else if (roles this.process 'process')}}
                <svg class="w-3 h-3 mr-1 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                {{t "test.assigment.underReview"}}
              {{else if (roles this.process 'rejected')}}
                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                {{t "test.assigment.needsRevision"}}
              {{/if}}
            </span>
            {{#unless (eq this.process 'approved')}}
              <button
                type="button"
                onclick="toggleEditForm('{{this.id}}')"
                class="inline-flex items-center px-3 py-1 text-xs font-semibold rounded-full bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100 transition-colors"
              >
                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                Edit
              </button>
            {{/unless}}
          </div>

          {{#if this.comment}}
            <div class="space-y-2">
              {{#each this.comment}}
                <div class="p-3 bg-white border border-[#E2E8F0] rounded-[8px]">
                  <div class="flex items-start gap-2">
                    <div class="w-1.5 h-1.5 bg-slate-400 rounded-full mt-2 shrink-0"></div>
                    <p class="font-inter text-sm text-[#475569] leading-relaxed">{{this.comment}}</p>
                  </div>
                </div>
              {{/each}}
            </div>
          {{/if}}

          {{!-- Edit form (hidden by default) --}}
          <div id="edit-form-{{this.id}}" class="hidden">
            <form
              x-data="{ loading: false }"
              @submit="loading = true"
              action="/answer-assigment/{{../assignment.id}}/{{this.id}}?_method=PATCH"
              method="POST"
              class="flex flex-col gap-3"
            >
              {{!-- link-input-container --}}
              <div class="w-full flex flex-row items-center px-[16px] gap-[10px] h-[48px] bg-[#F8FAFC] border border-[#E2E8F0] rounded-[12px]">
                <svg class="w-4 h-4 shrink-0 text-[#94A3B8]" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M7.40533 9.88C7.20533 9.88 7.00533 9.80667 6.852 9.65333C5.92533 8.72667 5.92533 7.22 6.852 6.29333L8.852 4.29333C9.31867 3.82667 9.93867 3.57333 10.5987 3.57333C11.2587 3.57333 11.8787 3.83333 12.3453 4.29333C13.272 5.22 13.272 6.72667 12.3453 7.65333L11.3453 8.65333C11.0387 8.96 10.5387 8.96 10.232 8.65333C9.92533 8.34667 9.92533 7.84667 10.232 7.54L11.232 6.54C11.5787 6.19333 11.5787 5.63333 11.232 5.28667C10.8853 4.94 10.3253 4.94 9.97867 5.28667L7.97867 7.28667C7.632 7.63333 7.632 8.19333 7.97867 8.54C8.28533 8.84667 8.28533 9.34667 7.97867 9.65333C7.82533 9.80667 7.62533 9.88 7.40533 9.88Z" fill="#94A3B8"/>
                  <path d="M5.39867 12.4267C4.73867 12.4267 4.11867 12.1667 3.652 11.7067C2.72533 10.78 2.72533 9.27333 3.652 8.34667L4.652 7.34667C4.95867 7.04 5.45867 7.04 5.76533 7.34667C6.072 7.65333 6.072 8.15333 5.76533 8.46L4.76533 9.46C4.41867 9.80667 4.41867 10.3667 4.76533 10.7133C5.112 11.06 5.672 11.06 6.01867 10.7133L8.01867 8.71333C8.36533 8.36667 8.36533 7.80667 8.01867 7.46C7.712 7.15333 7.712 6.65333 8.01867 6.34667C8.32533 6.04 8.82533 6.04 9.132 6.34667C10.0587 7.27333 10.0587 8.78 9.132 9.70667L7.132 11.7067C6.65867 12.1667 6.05867 12.4267 5.39867 12.4267Z" fill="#94A3B8"/>
                </svg>
                <input
                  type="text"
                  name="file"
                  value="{{this.file}}"
                  placeholder="https://github.com/..."
                  required
                  class="flex-1 bg-transparent font-inter font-normal text-[13px] leading-[17px] text-[#475569] placeholder:text-[#94A3B8] outline-none"
                  style="font-family:'Geist Mono',monospace;"
                />
              </div>
              <div class="flex gap-2">
                <button
                  :disabled="loading"
                  type="submit"
                  class="flex-1 flex flex-row justify-center items-center py-[14px] font-inter font-semibold text-[14px] leading-[17px] text-white rounded-[12px] shadow-[0px_4px_12px_rgba(37,99,235,0.169)]"
                  style="background:linear-gradient(90deg,#1E3A8A 0%,#3B82F6 100%);"
                >
                  <span x-show="loading" class="loading loading-spinner loading-sm"></span>
                  <span x-show="!loading">{{t "test.assigment.update"}}</span>
                </button>
                <button
                  type="button"
                  :disabled="loading"
                  onclick="toggleEditForm('{{this.id}}')"
                  class="flex-1 flex flex-row justify-center items-center py-[14px] font-inter font-semibold text-[14px] leading-[17px] text-[#003060] bg-white border border-[#E2E8F0] rounded-[12px] hover:bg-[#F8FAFC] transition-colors"
                >
                  {{t "test.assigment.cancel"}}
                </button>
              </div>
            </form>
          </div>
        </div>
      {{/each}}
    </div>

  {{else}}
    {{!-- Empty state: submit form --}}
    <div class="w-full flex flex-col items-start gap-[8px]">
      <h3 class="w-full font-semibold text-[18px] leading-[22px] text-[#0F172A]" style="font-family:'Schibsted Grotesk',sans-serif;">
        Submit File Link
      </h3>
      <p class="w-full font-inter font-normal text-[14px] leading-[150%] text-[#475569]">
        Enter a GitHub link, Google Drive, or any online file-sharing link containing your assignment.
      </p>
    </div>

    <form
      x-data="{ loading: false }"
      @submit="loading = true"
      action="/answer-assigment/{{assignment.id}}/{{assignment.session.id}}"
      method="POST"
      class="w-full flex flex-col gap-[24px]"
    >
      {{!-- link-input-container --}}
      <div class="w-full flex flex-row items-center px-[16px] gap-[10px] h-[48px] bg-[#F8FAFC] border border-[#E2E8F0] rounded-[12px]">
        <svg class="w-4 h-4 shrink-0 text-[#94A3B8]" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7.40533 9.88C7.20533 9.88 7.00533 9.80667 6.852 9.65333C5.92533 8.72667 5.92533 7.22 6.852 6.29333L8.852 4.29333C9.31867 3.82667 9.93867 3.57333 10.5987 3.57333C11.2587 3.57333 11.8787 3.83333 12.3453 4.29333C13.272 5.22 13.272 6.72667 12.3453 7.65333L11.3453 8.65333C11.0387 8.96 10.5387 8.96 10.232 8.65333C9.92533 8.34667 9.92533 7.84667 10.232 7.54L11.232 6.54C11.5787 6.19333 11.5787 5.63333 11.232 5.28667C10.8853 4.94 10.3253 4.94 9.97867 5.28667L7.97867 7.28667C7.632 7.63333 7.632 8.19333 7.97867 8.54C8.28533 8.84667 8.28533 9.34667 7.97867 9.65333C7.82533 9.80667 7.62533 9.88 7.40533 9.88Z" fill="#94A3B8"/>
          <path d="M5.39867 12.4267C4.73867 12.4267 4.11867 12.1667 3.652 11.7067C2.72533 10.78 2.72533 9.27333 3.652 8.34667L4.652 7.34667C4.95867 7.04 5.45867 7.04 5.76533 7.34667C6.072 7.65333 6.072 8.15333 5.76533 8.46L4.76533 9.46C4.41867 9.80667 4.41867 10.3667 4.76533 10.7133C5.112 11.06 5.672 11.06 6.01867 10.7133L8.01867 8.71333C8.36533 8.36667 8.36533 7.80667 8.01867 7.46C7.712 7.15333 7.712 6.65333 8.01867 6.34667C8.32533 6.04 8.82533 6.04 9.132 6.34667C10.0587 7.27333 10.0587 8.78 9.132 9.70667L7.132 11.7067C6.65867 12.1667 6.05867 12.4267 5.39867 12.4267Z" fill="#94A3B8"/>
        </svg>
        <input
          type="text"
          name="file"
          placeholder="https://github.com/bisa-ai/sains-excel-assignment-submission"
          required
          class="flex-1 bg-transparent font-inter font-normal text-[13px] leading-[17px] text-[#475569] placeholder:text-[#94A3B8] outline-none"
          style="font-family:'Geist Mono',monospace;"
        />
      </div>

      {{!-- submit-button --}}
      <button
        :disabled="loading"
        type="submit"
        class="w-full flex flex-row justify-center items-center py-[14px] font-inter font-semibold text-[14px] leading-[17px] text-white rounded-[12px] shadow-[0px_4px_12px_rgba(37,99,235,0.169)] hover:opacity-90 transition-opacity"
        style="background:linear-gradient(90deg,#1E3A8A 0%,#3B82F6 100%);"
      >
        <span x-show="loading" class="loading loading-spinner loading-sm mr-2"></span>
        <span x-show="!loading">{{t "test.assigment.submitAnswer"}}</span>
      </button>
    </form>
  {{/if}}
  {{/components/ui/learning/assignment_page/submission/index}}
{{/components/ui/learning/assignment_page/index}}


<script>
  function toggleEditForm(id) {
    const form = document.getElementById('edit-form-' + id);
    if (form.classList.contains('hidden')) {
      form.classList.remove('hidden');
    } else {
      form.classList.add('hidden');
    }
  }
</script>
{{/user/shell_frame/index}}
