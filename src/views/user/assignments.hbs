{{!-- Dibungkus chrome backoffice. Halaman ini ditautkan dari dalam area
     belajar tetapi punya rute sendiri; sebelumnya memakai navbar publik
     dan footer. Controller-nya merender dengan bareShell: true.
     Lihat docs/user-area-learning-consolidation-plan.md tahap 2. --}}
{{#> user/shell_frame/index user=user active='learning' pageTitle=(t 'test.startLearning.assignment') back=(concat '/program/' assignment.session.weeks.course.id)}}
<div class="min-h-full py-8">
  <div class="max-w-7xl mx-auto px-6">
    <div class="bg-white rounded-xl border border-[#E5E5E5] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] p-6">
<div class="flex justify-start mb-8">
</div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Kolom Kiri: Assignment Material -->
        <div class="space-y-6">
          <div class="bg-white p-6 rounded-xl border border-[#E5E5E5] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]">
            <div class="flex items-center mb-4">
              <h4 class="text-xl text-gray-900 font-bold font-inter">{{t "test.assigment.assigment"}}</h4>
            </div>
            <div class="overflow-hidden rounded-xl border border-[#E5E5E5] shadow-sm bg-white">
              <iframe
                  class="w-full h-[500px] border-0" 
  src="{{assignment.file}}"
  type="application/pdf"
></iframe>
            </div>
          </div>

          <!-- Submit Answer Form -->

        </div>

        <!-- Kolom Kanan: Your Answer -->
        <div class="space-y-6">
          <div class="bg-white p-6 rounded-xl border border-[#E5E5E5] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]">
            <div class="flex items-center mb-4">
              <h4 class="text-xl text-gray-900 font-bold font-inter">{{t "test.assigment.yourAnswer"}}</h4>
            </div>
            
            {{#if assignment_answer.length}}
              <div class="space-y-4 max-h-[500px] overflow-y-auto pr-2">
                {{#each assignment_answer}}
                  <div class="p-5 bg-white border border-[#E5E5E5] rounded-xl shadow-sm transition-all duration-300">
                    <div class="flex flex-col gap-3 mb-4">
                      {{#if (eq this.process 'approved')}}
                                            <a 
                        href="{{this.file}}" 
                        target="_blank"
                        class="text-base text-[#404040] font-semibold hover:text-[#171717] hover:underline transition-colors break-words"
                      >
                        {{this.file}}
                      </a>
                      {{else}}
                      <a 
                        href="{{this.file}}" 
                        target="_blank"
                        class="text-base text-[#404040] font-semibold hover:text-[#171717] hover:underline transition-colors break-words"
                      >
                        {{this.file}}
                      </a>
                      {{/if}}
                    </div>
                    
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="inline-flex items-center px-3 py-1 text-xs font-semibold rounded-full
                        {{#if (roles this.process 'approved')}} 
                          bg-[#f0fdf4] text-[#15803d] border border-[#bbf7d0]
                        {{else if (roles this.process 'process')}} 
                          bg-[#FEFCE8] text-[#A16207] border border-[#FEF08A]
                        {{else if (roles this.process 'rejected')}} 
                          bg-[#FEF2F2] text-[#B42318] border border-[#FECACA]
                        {{/if}}">
                        {{#if (roles this.process 'approved')}}
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                          </svg>
                          {{t "test.assigment.approved"}}
                        {{else if (roles this.process 'process')}}
                          <svg class="w-3 h-3 mr-1 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                          </svg>
                          {{t "test.assigment.underReview"}}
                        {{else if (roles this.process 'rejected')}}
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                          </svg>
                          {{t "test.assigment.needsRevision"}}
                        {{/if}}
                      </span>
                      {{#unless (eq this.process 'approved')}}
                        <button 
                          type="button" 
                          onclick="toggleEditForm('{{this.id}}')"
                          class="inline-flex items-center px-3 py-1 text-xs font-semibold rounded-full bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100 transition-colors"
                        >
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                          </svg>
                          Edit
                        </button>
                      {{/unless}}
                    </div>

                    {{#if this.comment}}
                      <div class="mt-4 space-y-2">
                        {{#each this.comment}}
                          <div class="p-3 bg-[#FAFAFA] border border-[#E5E5E5] rounded-[8px]">
                            <div class="flex items-start gap-2">
                              <div class="w-1.5 h-1.5 bg-slate-400 rounded-full mt-2 flex-shrink-0"></div>
                              <div class="flex-1">
                                <p class="text-sm text-[#404040] leading-relaxed">{{this.comment}}</p>
                       
                              </div>
                            </div>
                          </div>
                        {{/each}}
                      </div>
                    {{/if}}

                    <div id="edit-form-{{this.id}}" class="mt-4 hidden">
                      <form 
                            x-data="{ loading: false }"
  @submit="loading = true"
                        action="/answer-assigment/{{../assignment.id}}/{{this.id}}?_method=PATCH" 
                        method="POST" 
                        class="space-y-4"
                      >
                        <input 
                          type="text" 
                          name="file" 
                          value="{{this.file}}"
                          placeholder="https://drive.google.com/..." 
                          required
                          class="w-full px-4 py-3 border border-[#D4D4D4] rounded-xl bg-white text-[#171717] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-all duration-300 hover:bg-white"
                        >
                          <button 
                            :disabled="loading"
                            type="submit" 
                            class="inline-flex h-9 items-center justify-center rounded-[8px] bg-[#003060] px-3.5 font-inter text-sm font-semibold text-white transition-colors hover:bg-[#00254a]"
                          >
                            <span x-show="loading" class="loading loading-spinner loading-sm"></span>
                            <span x-show="!loading">{{t "test.assigment.update"}}</span>
                          </button>
                          <button 
                            type="button"
                            :disabled="loading"
                            onclick="toggleEditForm('{{this.id}}')"
                            class="inline-flex h-9 items-center justify-center rounded-[8px] border border-[#D4D4D4] bg-white px-3.5 font-inter text-sm font-semibold text-[#003060] transition-colors hover:bg-[#F5F5F5]"
                          >
                            {{t "test.assigment.cancel"}}
                          </button>
                      </form>
                    </div>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <div >
            <p class="text-sm text-[#525252] mb-4 leading-relaxed">
              {{t "test.assigment.spanSubmitYourAnswer"}}
            </p>
            <form 
                  x-data="{ loading: false }"
  @submit="loading = true"
              action="/answer-assigment/{{assignment.id}}/{{assignment.session.id}}" 
              method="POST" 
              class="space-y-4"
            >
              <input 
                type="text" 
                name="file" 
                placeholder="https://drive.google.com/..." 
                required
                class="w-full px-4 py-3 border border-[#D4D4D4] rounded-xl bg-white text-[#171717] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-all duration-300 hover:bg-white"
              >
              <button 
              :disabled="loading"
                type="submit" 
                class="inline-flex h-[44px] items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-[18px] font-inter text-base font-semibold text-white transition-colors hover:bg-[#00254a] w-full"
              >
              <span x-show="loading" class="loading loading-spinner loading-sm"></span>
              <span x-show="!loading">{{t "test.assigment.submitAnswer"}}</span>
              </button>
            </form>
              </div>
            {{/if}}
          </div>
        </div>
      </div>

      <!-- Back Button -->

    </div>
  </div>
</div>

<script>
  function toggleEditForm(id) {
    const form = document.getElementById('edit-form-' + id);
    if (form.classList.contains('hidden')) {
      form.classList.remove('hidden');
    } else {
      form.classList.add('hidden');
    }
  }
</script>
{{/user/shell_frame/index}}
