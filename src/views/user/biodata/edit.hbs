<div class="bg-gradient-to-br from-slate-50 via-white to-slate-100 min-h-screen py-20">
  <div class="max-w-4xl mx-auto px-6">
    <div class="bg-white rounded-2xl shadow-2xl p-10 border border-slate-200">
      <h2 class="text-4xl font-bold text-gray-900 mb-10 text-center font-montserrat">{{t "test.profile.editBiodata.tittle"}}</h2>

      <form action="/biodata/{{biodata.id}}?_method=PATCH"
  @submit="loading = true" method="POST" x-data="{
  loading: false,
        educationOpen: false,
        selectedEducation: '{{biodata.education}}',
        selectEducation(value) {
          this.selectedEducation = value;
          this.educationOpen = false;
        }
      }">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <!-- Kolom Kiri -->
          <div class="space-y-6">
            <!-- Nama Lengkap -->
            <div>
              <label for="full_name" class="block text-lg font-semibold text-gray-700 mb-3">{{t "test.profile.editBiodata.fullName"}}</label>
              <input type="text" id="full_name" name="full_name" value="{{biodata.full_name}}" required
                placeholder="{{t "test.profile.editBiodata.placeholderFullName"}}"
                class="w-full border text-gray-700 border-slate-300 rounded-xl px-5 py-4 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-400 transition-all duration-300 bg-white/70 hover:bg-white">
            </div>
            <!-- No WA -->
            <div>
              <label for="no" class="block text-lg font-semibold text-gray-700 mb-3">{{t "test.profile.editBiodata.whatsAppNumber"}}</label>
              <input type="text" id="no" name="no" value="{{biodata.no}}" required
                placeholder="{{t "test.profile.editBiodata.placeholderWhatsAppNumber"}}"
                class="w-full border text-gray-700 border-slate-300 rounded-xl px-5 py-4 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-400 transition-all duration-300 bg-white/70 hover:bg-white">
            </div>

            <!-- Jenis Kelamin (Radio) -->
            <div>
              <label class="block text-lg font-semibold text-gray-700 mb-3">{{t "test.profile.editBiodata.gender"}}</label>
              <div class="flex flex-col gap-3">
                <label class="inline-flex items-center gap-3 cursor-pointer group">
                  <input type="radio" name="gender" value="Laki laki" 
                    {{#if (roles biodata.gender "Laki laki")}}checked{{/if}} required
                    class="radio border-gray-700 checked:text-gray-700 checked:bg-white">
                  <span class="text-gray-700 text-lg group-hover:text-slate-900 transition-colors">{{t "test.profile.editBiodata.male"}}</span>
                </label>
                <label class="inline-flex items-center gap-3 cursor-pointer group">
                  <input type="radio" name="gender" value="Perempuan"
                    {{#if (roles biodata.gender "Perempuan")}}checked{{/if}} required
                    class="radio border-gray-700 checked:text-gray-700 checked:bg-white">
                  <span class="text-gray-700 text-lg group-hover:text-slate-900 transition-colors">{{t "test.profile.editBiodata.female"}}</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Kolom Kanan -->
          <div class="space-y-6">
            <!-- Kota -->
            <div>
              <label for="city" class="block text-lg font-semibold text-gray-700 mb-3">{{t "test.profile.editBiodata.city"}}</label>
              <input type="text" id="city" name="city" value="{{biodata.city}}" required
                placeholder="{{t "test.profile.editBiodata.placeholderCity"}}"
                class="w-full border text-gray-700 border-slate-300 rounded-xl px-5 py-4 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-400 transition-all duration-300 bg-white/70 hover:bg-white">
            </div>

            <!-- Pendidikan (Custom Dropdown) -->
            <div>
              <label class="block text-lg font-semibold text-gray-700 mb-3">{{t "test.profile.editBiodata.education"}}</label>
              <div class="relative" x-data="{ open: false }">
                <!-- Hidden Input untuk Form -->
                <input type="hidden" name="education" :value="selectedEducation" required>
                
                <!-- Dropdown Trigger -->
                <button 
                  type="button"
                  @click="open = !open"
                  :class="selectedEducation ? 'text-gray-700' : 'text-gray-400'"
                  class="w-full border border-slate-300 rounded-xl px-5 py-4 bg-white hover:bg-white transition-all duration-300 text-left flex justify-between items-center focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-400"
                >
                                    <span
                    x-text="if(selectedEducation == 'Junior High School') { return '{{t 'test.profile.editBiodata.juniorHighSchool'}}'; } else if(selectedEducation == 'Senior High School') { return '{{t 'test.profile.editBiodata.seniorHighSchool'}}'; } else if(selectedEducation == 'Diploma (D3/D4)') { return '{{t 'test.profile.editBiodata.diploma'}}'; } else if(selectedEducation == 'Bachelor Degree (S1)') { return '{{t 'test.profile.editBiodata.bachelorDegree'}}'; } else { return '{{t 'test.profile.editBiodata.placeholderEducation'}}'; }"
                  ></span>
                  <svg 
                    viewBox="0 0 20 20" 
                    fill="currentColor" 
                    class="w-5 h-5 text-gray-500 transform transition-transform duration-300" 
                    :class="open ? 'rotate-180' : ''"
                  >
                    <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                  </svg>
                </button>
                
                <!-- Dropdown Menu -->
                <div 
                  x-show="open"
                  x-transition:enter="transition ease-out duration-200"
                  x-transition:enter-start="opacity-0 scale-95"
                  x-transition:enter-end="opacity-100 scale-100"
                  x-transition:leave="transition ease-in duration-150"
                  x-transition:leave-start="opacity-100 scale-100"
                  x-transition:leave-end="opacity-0 scale-95"
                  @click.outside="open = false"
                  class="absolute z-10 w-full mt-2 bg-white rounded-xl shadow-2xl border border-slate-200 overflow-hidden"
                >
                  <div class="py-2">
                    <button 
                      type="button"
                      @click="selectedEducation = 'Junior High School'; open = false;"
                      class="w-full text-left px-5 py-3 hover:bg-slate-50 transition-colors duration-200 text-gray-700 text-lg"
                    >
                      {{t "test.profile.editBiodata.juniorHighSchool"}}
                    </button>
                    <button 
                      type="button"
                      @click="selectedEducation = 'Senior High School'; open = false;"
                      class="w-full text-left px-5 py-3 hover:bg-slate-50 transition-colors duration-200 text-gray-700 text-lg"
                    >
                      {{t "test.profile.editBiodata.seniorHighSchool"}}
                    </button>
                    <button 
                      type="button"
                      @click="selectedEducation = 'Diploma (D3/D4)'; open = false;"
                      class="w-full text-left px-5 py-3 hover:bg-slate-50 transition-colors duration-200 text-gray-700 text-lg"
                    >
                      {{t "test.profile.editBiodata.diploma"}}
                    </button>
                    <button 
                      type="button"
                      @click="selectedEducation = 'Bachelor Degree (S1)'; open = false;"
                      class="w-full text-left px-5 py-3 hover:bg-slate-50 transition-colors duration-200 text-gray-700 text-lg"
                    >
                      {{t "test.profile.editBiodata.bachelorDegree"}}
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Program Studi -->
            <div>
              <label for="study_program" class="block text-lg font-semibold text-gray-700 mb-3">{{t "test.profile.editBiodata.studyProgram"}}</label>
              <input type="text" id="study_program" name="study_program" value="{{biodata.study_program}}" required
                placeholder="{{t "test.profile.editBiodata.placeholderStudyProgram"}}"
                class="w-full border text-gray-700 border-slate-300 rounded-xl px-5 py-4 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-400 transition-all duration-300 bg-white/70 hover:bg-white">
            </div>
          </div>
        </div>

        <!-- Tombol (Full Width di Bawah) -->
        <div class="flex items-center gap-4 pt-10 mt-8 border-t border-slate-200">
          <button type="submit" :disabled="loading"
            class="btn bg-gradient-to-br from-primary via-secondary to-gray-900 text-white hover:from-primary hover:to-secondary rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 font-semibold text-lg flex-1 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2">
            <span x-show="loading" class="loading loading-spinner loading-sm"></span>
            <span x-show="!loading"></span>{{t "test.profile.editBiodata.updateProfile"}}</span>
          </button>
          <a href="/users/profile"
          :disabled="loading"
            class="btn bg-white rounded-xl border border-slate-300 shadow-lg hover:shadow-xl text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-all duration-300 font-semibold text-lg flex-1 transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 ">
            {{t "test.profile.editBiodata.backToProfile"}}
          </a>
        </div>

      </form>
    </div>
  </div>
</div>