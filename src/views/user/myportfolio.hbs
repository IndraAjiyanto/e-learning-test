<div class='pt-24 min-h-screen bg-white' x-data='portfolioApp()'>
  <div class='container mx-auto px-4 pb-16'>
{{> user/myPortfolio/header}}

    <div class='grid grid-cols-1 lg:grid-cols-4 gap-8'>
{{> user/myPortfolio/filter}}

{{> user/myPortfolio/content}}
      </div>
      </div>
    </div>
  </div>
</div>

<script>
  function portfolioApp() {
    return {
      allPortfolio: {{#if portfolio}}{{{json portfolio}}}{{else}}[]{{/if}},
      displayedPortfolio: [],
      allKategori: {{{json kategori}}},
      allJenisKelas: {{{json jenis_kelas}}},
      selectedKategori: '',
      selectedJenisKelas: '',
      selectedKategoriId: '',
      selectedJenisKelasId: '',
      currentPage: 1,
      itemsPerPage: 6,
      totalPages: 1,
      loading: false,

      init() {
        console.log('Total Portfolio:', this.allPortfolio.length);
        this.filterAndPaginate();
      },

      filterAndPaginate() {
        // Filter berdasarkan kategori dan jenis kelas
        let filtered = this.allPortfolio;
        
        if (this.selectedKategoriId) {
          filtered = filtered.filter(item => {
            const kategoriId = item.kelas?.kategori?.id || item.kategori?.id;
            return kategoriId == this.selectedKategoriId;
          });
        }
        
        if (this.selectedJenisKelasId) {
          filtered = filtered.filter(item => {
            const jenisKelasId = item.kelas?.jenis_kelas?.id || item.jenis_kelas?.id;
            return jenisKelasId == this.selectedJenisKelasId;
          });
        }
        
        // Hitung total pages
        this.totalPages = Math.ceil(filtered.length / this.itemsPerPage);
        
        // Pagination
        const startIndex = (this.currentPage - 1) * this.itemsPerPage;
        const endIndex = startIndex + this.itemsPerPage;
        
        this.displayedPortfolio = filtered.slice(startIndex, endIndex);
      },

      get portfolioItems() {
        return this.displayedPortfolio || [];
      },

      get totalItems() {
        let filtered = this.allPortfolio;
        
        if (this.selectedKategoriId) {
          filtered = filtered.filter(item => {
            const kategoriId = item.kelas?.kategori?.id || item.kategori?.id;
            return kategoriId == this.selectedKategoriId;
          });
        }
        
        if (this.selectedJenisKelasId) {
          filtered = filtered.filter(item => {
            const jenisKelasId = item.kelas?.jenis_kelas?.id || item.jenis_kelas?.id;
            return jenisKelasId == this.selectedJenisKelasId;
          });
        }
        
        return filtered.length;
      },

      selectKategori(kategoriId) {
        this.selectedKategoriId = kategoriId;
        this.currentPage = 1;
        this.filterAndPaginate();
        
        // Set selected name untuk display
        if (kategoriId) {
          const kat = this.allKategori.find(k => k.id == kategoriId);
          this.selectedKategori = kat ? kat.nama_kategori : '';
        } else {
          this.selectedKategori = '';
        }
      },

      selectJenisKelas(jenisKelasId) {
        this.selectedJenisKelasId = jenisKelasId;
        this.currentPage = 1;
        this.filterAndPaginate();
        
        // Set selected name untuk display
        if (jenisKelasId) {
          const jenis = this.allJenisKelas.find(j => j.id == jenisKelasId);
          this.selectedJenisKelas = jenis ? jenis.nama_jenis_kelas : '';
        } else {
          this.selectedJenisKelas = '';
        }
      },

      changePage(page) {
        this.currentPage = page;
        this.filterAndPaginate();
      },

      resetFilters() {
        this.selectedKategoriId = '';
        this.selectedJenisKelasId = '';
        this.selectedKategori = '';
        this.selectedJenisKelas = '';
        this.currentPage = 1;
        this.filterAndPaginate();
      },

      getCategoryName(item) {
        if (item.kelas?.kategori?.nama_kategori)
          return item.kelas.kategori.nama_kategori;
        if (item.kategori?.nama_kategori)
          return item.kategori.nama_kategori;
        if (item.kelas?.nama_kategori)
          return item.kelas.nama_kategori;
        return null;
      },

      getJenisKelasName(item) {
        if (item.kelas?.jenis_kelas?.nama_jenis_kelas)
          return item.kelas.jenis_kelas.nama_jenis_kelas;
        if (item.jenis_kelas?.nama_jenis_kelas)
          return item.jenis_kelas.nama_jenis_kelas;
        if (item.kelas?.nama_jenis_kelas)
          return item.kelas.nama_jenis_kelas;
        return null;
      }
    };
  }
</script>
