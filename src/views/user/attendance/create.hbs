{{!-- Dibungkus chrome backoffice. Halaman ini ditautkan dari dalam area
     belajar tetapi punya rute sendiri; sebelumnya memakai navbar publik
     dan footer. Controller-nya merender dengan bareShell: true.
     Lihat docs/user-area-learning-consolidation-plan.md tahap 2. --}}
{{#> user/shell_frame/index user=user active='learning' pageTitle=(t 'test.startLearning.attendance') back=(concat '/program/' session.weeks.course.id)}}
<div
  class='min-h-full py-8'
>
  <div class='max-w-2xl mx-auto px-6'>
    <div class='bg-white rounded-xl border border-[#E5E5E5] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] p-6'>
      <h2
        class='text-2xl sm:text-3xl font-bold text-gray-900 mb-8 text-center font-inter'
      >{{t 'test.attendance.title'}}</h2>

      <form
        @submit='loading = true'
        action='/attendance/{{session.id}}/{{user.id}}/{{session.weeks.course.id}}'
        method='POST'
        class='space-y-8'
        x-data="{
        loading: false,
          statusOpen: false,
          selectedStatus: '',
          selectStatus(value) {
            this.selectedStatus = value;
            this.statusOpen = false;
          }
        }"
      >

        <!-- Attendance Status Dropdown -->
        <div>
          <label
            class='block text-lg font-semibold text-[#404040] mb-3 font-inter'
          >{{t 'test.attendance.attendanceStatus'}}</label>
          <div class='relative' x-data='{ open: false }'>
            <!-- Hidden Input -->
            <input
              type='hidden'
              name='status'
              :value='selectedStatus'
              required
            />

            <!-- Dropdown Trigger -->
            <button
              type='button'
              @click='open = !open'
              :class="selectedStatus ? 'text-[#404040]' : 'text-[#A3A3A3]'"
              class='w-full h-[44px] px-[14px] bg-white border border-[#D4D4D4] rounded-[8px] font-inter text-base text-[#404040] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-colors text-left flex justify-between items-center'
            >
              <span
                x-text="selectedStatus || 'Select attendance status'"
              ></span>
              <svg
                viewBox='0 0 20 20'
                fill='currentColor'
                class='w-5 h-5 text-[#737373] transition-transform duration-300'
                :class="open ? 'rotate-180' : ''"
              >
                <path
                  fill-rule='evenodd'
                  d='M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z'
                  clip-rule='evenodd'
                />
              </svg>
            </button>

            <!-- Dropdown Menu -->
            <div
              x-show='open'
              x-transition:enter='transition ease-out duration-200'
              x-transition:enter-start='opacity-0 scale-95'
              x-transition:enter-end='opacity-100 scale-100'
              x-transition:leave='transition ease-in duration-150'
              x-transition:leave-start='opacity-100 scale-100'
              x-transition:leave-end='opacity-0 scale-95'
              @click.outside='open = false'
              class='absolute z-10 w-full mt-2 bg-white rounded-xl border border-[#E5E5E5] shadow-[0px_8px_8px_-4px_rgba(16,24,40,0.03),0px_20px_24px_-4px_rgba(16,24,40,0.08)] overflow-hidden'
            >
              <div class='py-2'>
                <button
                  type='button'
                  @click="selectedStatus = 'present'; open = false;"
                  class='w-full text-left px-5 py-3 hover:bg-[#FAFAFA] transition-colors duration-200 text-[#404040] text-lg flex items-center gap-3'
                >
                  <span>{{t 'test.attendance.present'}}</span>
                </button>
                <button
                  type='button'
                  @click="selectedStatus = 'permission'; open = false;"
                  class='w-full text-left px-5 py-3 hover:bg-[#FAFAFA] transition-colors duration-200 text-[#404040] text-lg flex items-center gap-3'
                >
                  <span>{{t 'test.attendance.permission'}}</span>
                </button>
                <button
                  type='button'
                  @click="selectedStatus = 'sick'; open = false;"
                  class='w-full text-left px-5 py-3 hover:bg-[#FAFAFA] transition-colors duration-200 text-[#404040] text-lg flex items-center gap-3'
                >
                  <span>{{t 'test.attendance.sick'}}</span>
                </button>
                <button
                  type='button'
                  @click="selectedStatus = 'absent'; open = false;"
                  class='w-full text-left px-5 py-3 hover:bg-[#FAFAFA] transition-colors duration-200 text-[#404040] text-lg flex items-center gap-3'
                >
                  <span>{{t 'test.attendance.absent'}}</span>
                </button>
                <button
                  type='button'
                  @click="selectedStatus = 'no_information'; open = false;"
                  class='w-full text-left px-5 py-3 hover:bg-[#FAFAFA] transition-colors duration-200 text-[#404040] text-lg flex items-center gap-3'
                >
                  <span>{{t 'test.attendance.noInformation'}}</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Notes Input -->
        <div>
          <label
            for="notes"
            class='block text-lg font-semibold text-[#404040] mb-3 font-inter'
          >{{t 'test.attendance.notes'}}</label>
          <input
            type='text'
            id="notes"
            name="notes"
            required
            placeholder='Enter attendance notes...'
            class='w-full h-[44px] px-[14px] bg-white border border-[#D4D4D4] rounded-[8px] font-inter text-base text-[#404040] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-colors'
          />
        </div>

        <!-- Action Buttons -->
        <div class='flex items-center gap-4 pt-6'>
          <button
            type='submit'
            class='inline-flex h-[44px] items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-[18px] font-inter text-base font-semibold text-white transition-colors hover:bg-[#00254a] flex-1'
            :disabled='!selectedStatus || loading'
            :class="!selectedStatus || loading ? 'opacity-50 cursor-not-allowed' : ''"
          >
            <span
              x-show='loading'
              class='loading loading-spinner loading-sm'
            ></span>
            <span x-show='!loading'>{{t
                'test.attendance.saveAttendance'
              }}</span>
          </button>
          <a
            href='/program/{{session.weeks.course.id}}'
            :disabled='loading'
            {{!-- Ternary tanpa cabang else bukan JavaScript yang sah, sehingga Alpine
                 gagal mengompilasi ekspresi ini dan melempar SyntaxError di konsol. --}}
            :class="loading ? 'opacity-50 cursor-not-allowed' : ''"
            class='inline-flex h-[44px] items-center justify-center gap-2 rounded-[8px] border border-[#D4D4D4] bg-white px-[18px] font-inter text-base font-semibold text-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#F5F5F5] flex-1'
          >
            {{t 'test.attendance.cancel'}}
          </a>
        </div>
      </form>
    </div>
  </div>
</div>
{{/user/shell_frame/index}}
