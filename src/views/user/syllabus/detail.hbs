{{!--
  Halaman: Detail Silabus (area student, program non_bootcamp)
  Rute   : GET /syllabus/learn/:syllabusId  (syllabus.controller.ts)

  Menampilkan konten (dasar teori) milik silabus dan kartu quiz di sampingnya.
  Konten disimpan sebagai EditorJS JSON atau HTML (syllabus.content);
  dirender lewat components/ui/content-preview.
--}}
{{#> user/shell_frame/index
  user=user
  active='learning'
  pageTitle='Silabus'
  back=false
  trail=(array
    (obj 'label' (t 'test.common.home') 'href' '/users/profile?tab=dashboard')
    (obj 'label' (t 'test.userSidebar.myLearning') 'href' '/users/profile?tab=learning')
    (obj
      'label' (t 'test.startLearning.startLearning')
      'href' (concat '/program/myProgram/' user.id '?courseId=' course.id))
    (obj 'label' 'Silabus')
  )
}}
<div class="min-h-full px-4 pb-10 pt-6 sm:px-8 font-inter">
  <div class="max-w-[1440px] mx-auto flex flex-col gap-8 items-start">

    <div class="flex flex-col gap-2 items-start">
      <h1 class="font-bold text-[32px] leading-[39px] text-[#003060]">
        {{syllabus.title}}
      </h1>
      {{!-- <p class="font-medium text-[14px] leading-[17px] text-[#718096]">
        {{default next.title (default course.name syllabus.description)}}
      </p> --}}
    </div>

    <div class="w-full bg-white rounded-[22px]">
      <div class="flex flex-col gap-[18px] p-5 py-[20px] sm:px-6 lg:px-7 lg:pb-7">
        <div class="w-full grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_360px]">

          <section
            class="box-border flex flex-col items-start gap-6 p-6 sm:p-8 bg-white border border-[#D9D9D9] rounded-[16px] min-w-0"
          >
            {{> components/ui/content-preview/index content=syllabus.content emptyMessage="Belum ada konten untuk silabus ini."}}
          </section>

          <aside class="flex flex-col items-start gap-6">
            <section class="box-border w-full bg-white border border-[#D9D9D9] rounded-[16px] p-6 flex flex-col items-center gap-5">
              {{#if quiz}}
                <span class="inline-flex items-center gap-1.5 px-3 py-[6px] rounded-[100px] {{#if quizStatus.isPassed}}bg-[#F0FDF4] text-[#15803D]{{else if quizStatus.hasAttempt}}bg-[#FEF2F2] text-[#B42318]{{else}}bg-[#FEF3C7] text-[#D97706]{{/if}}">
                  <i class="fa-solid fa-award text-[14px]"></i>
                  {{#if quizStatus.isPassed}}Lulus{{else if quizStatus.hasAttempt}}Belum Lulus{{else}}Belum dikerjakan{{/if}}
                </span>

                <p class="font-medium text-[12px] leading-[18px] text-center text-[#718096]">
                  {{#if quizStatus.isPassed}}
                    Selamat, kamu sudah lulus quiz silabus ini. Nilai minimal {{minScore}} untuk lulus.
                  {{else if quizStatus.hasAttempt}}
                    Skor terbaik kamu {{quizStatus.bestScore}}. Kerjakan ulang untuk mencapai nilai minimal {{minScore}}.
                  {{else}}
                    Kerjakan quiz silabus ini untuk menandai modul sebagai lulus.
                  {{/if}}
                </p>

                <a
                  href="/quiz/form/{{quiz.id}}"
                  class="inline-flex w-full h-10 items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-6 font-semibold text-[14px] leading-[20px] text-white no-underline hover:bg-[#00254a] transition-colors"
                >
                  {{#if quizStatus.isPassed}}Lihat Quiz{{else if quizStatus.hasAttempt}}Kerjakan Ulang{{else}}Kerjakan Quiz{{/if}}
                </a>

                {{#if (and next (not syllabus.isFinal))}}
                  <p class="font-medium text-[11px] leading-[16px] text-center text-[#718096]">
                    Setelah lulus, lanjut ke: {{next.title}}
                  </p>
                {{/if}}
              {{else}}
                <span class="grid place-items-center w-11 h-11 rounded-full bg-[#F5F5F5] text-[#a3a3a3]">
                  <i class="fa-solid fa-circle-question text-base"></i>
                </span>
                <p class="font-medium text-[12px] leading-[18px] text-center text-[#718096]">
                  Quiz belum tersedia untuk silabus ini.
                </p>
              {{/if}}
            </section>

            <section class="box-border w-full bg-white border border-[#D9D9D9] rounded-[16px] p-6 flex flex-col items-start gap-5">
              <div class="w-full flex flex-row items-center gap-2">
                <span class="grid place-items-center w-4 h-4 shrink-0">
                  <i class="fa-solid fa-circle-info text-[#003060] text-[16px]"></i>
                </span>
                <h3 class="font-bold text-[14px] leading-[17px] text-[#003060]">
                  Cara Belajar
                </h3>
              </div>

              <ul class="flex flex-col items-start gap-3 font-normal text-[12px] leading-[18px] text-[#718096]">
                <li class="flex flex-row items-start gap-2">
                  <span class="w-[4px] shrink-0">•</span>
                  <span>Tonton video dan baca dasar teori di samping</span>
                </li>
                <li class="flex flex-row items-start gap-2">
                  <span class="w-[4px] shrink-0">•</span>
                  <span>Kerjakan quiz, nilai minimal {{default minScore 70}} untuk lulus</span>
                </li>
                <li class="flex flex-row items-start gap-2">
                  <span class="w-[4px] shrink-0">•</span>
                  <span>Setelah lulus, silabus berikutnya otomatis terbuka</span>
                </li>
              </ul>
            </section>
          </aside>
        </div>
      </div>
    </div>
  </div>
</div>
{{/user/shell_frame/index}}