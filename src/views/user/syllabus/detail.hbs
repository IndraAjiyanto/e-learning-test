{{!--
  Halaman: Detail Silabus (area student, program non_bootcamp)
  Rute   : GET /syllabus/learn/:syllabusId  (syllabus.controller.ts)

  Menampilkan konten (dasar teori) milik silabus dan kartu quiz di sampingnya.
  Konten disimpan sebagai EditorJS JSON atau HTML (syllabus.content);
  dirender lewat components/ui/content-preview.

  Berkas materi silabus (PDF, PPT, Video) TIDAK ditampilkan inline. Tiap berkas
  direpresentasikan sebagai tombol; klik tombolnya memunculkan modal viewer
  (components/ui/user/modal/material_viewer). Unduhan berkas juga lewat modal
  itu, jadi kartu materi cukup satu baris tombol.

  Semua teks halaman ini memakai i18n (test.syllabus.*), dengan teks cadangan
  berbahasa Indonesia untuk jaga-jaga kalau kunci terjemahannya belum ada.
--}}
{{#> user/shell_frame/index
  user=user
  active='learning'
  pageTitle=(default (t 'test.syllabus.pageTitle') 'Silabus')
  back=false
  trail=(array
    (obj 'label' (t 'test.common.home') 'href' '/users/profile?tab=dashboard')
    (obj 'label' (t 'test.userSidebar.myLearning') 'href' '/users/profile?tab=learning')
    (obj
      'label' (t 'test.startLearning.startLearning')
      'href' (concat '/program/myProgram/' user.id '?courseId=' course.id))
    (obj 'label' (default (t 'test.syllabus.breadcrumb') 'Silabus'))
  )
}}
<div class="min-h-full px-4 pb-10 pt-6 sm:px-8 font-inter">
  <div class="max-w-[1440px] mx-auto flex flex-col gap-8 items-start">

    <div class="flex flex-col gap-2 items-start">
      <h1 class="font-bold text-[32px] leading-[39px] text-[#003060]">
        {{syllabus.title}}
      </h1>
    </div>

    <div class="w-full bg-white rounded-[22px]">
      <div class="flex flex-col gap-[18px] p-5 py-[20px] sm:px-6 lg:px-7 lg:pb-7">
        <div class="w-full grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_360px]">

          <section
            class="box-border flex flex-col items-start gap-6 p-6 sm:p-8 bg-white border border-[#D9D9D9] rounded-[16px] min-w-0"
          >
            {{> components/ui/content-preview/index content=syllabus.content emptyMessage=(default (t 'test.syllabus.content.empty') 'Belum ada konten untuk silabus ini.')}}
          </section>

          {{!-- Kolom Kanan: Sidebar --}}
          <aside class="flex flex-col items-start gap-6">

            {{!-- Card: Materi Pembelajaran (PDF / PPT / Video sebagai tombol) --}}
            <section class="box-border w-full bg-white border border-[#D9D9D9] rounded-[16px] p-6 flex flex-col items-start gap-4">
              <div class="w-full flex flex-col gap-1 border-b border-[#F1F5F9] pb-3">
                <div class="flex items-center gap-2">
                  <span class="grid place-items-center w-5 h-5 shrink-0 text-[#003060]">
                    <i class="fa-solid fa-book-bookmark text-[15px]"></i>
                  </span>
                  <h3 class="font-bold text-[15px] leading-[20px] text-[#003060]">
                    {{default (t 'test.syllabus.materi.title') 'Materi Pembelajaran'}}
                  </h3>
                </div>
                <p class="font-medium text-[11px] leading-[16px] text-[#718096]">
                  {{default (t 'test.syllabus.materi.description') 'Lihat atau unduh materi pendukung sebelum mengerjakan quiz.'}}
                </p>
              </div>

              {{#if hasAnyMaterial}}
                <div class="w-full flex flex-col gap-2.5">
                  {{#each pdfMaterials}}
                    <button
                      type="button"
                      @click="$dispatch('open-syllabus-material', {{json this}})"
                      class="w-full flex items-center gap-3 p-3 bg-[#FFFFFF] border border-[#E2E8F0] rounded-[12px] text-left hover:border-[#003060] transition-colors shadow-sm"
                    >
                      <span class="px-2 py-0.5 rounded bg-[#FEF2F2] border border-[#FEE2E2] text-[#DC2626] font-bold text-[11px] shrink-0">
                        {{default (t 'test.syllabus.materi.pdfLabel') 'PDF'}}
                      </span>
                      <span class="flex flex-col min-w-0 flex-1">
                        <span class="font-semibold text-xs text-[#1E293B] truncate">
                          {{default this.title (default (t 'test.syllabus.materi.defaultPdfTitle') 'Modul PDF')}}
                        </span>
                        <span class="text-[11px] text-[#64748B] truncate">
                          {{default this.originalFileName 'Modul.pdf'}}{{#if this.formattedSize}} · {{this.formattedSize}}{{/if}}
                        </span>
                      </span>
                      <span class="shrink-0 inline-flex items-center gap-1.5 rounded-[6px] bg-[#003060] px-3 h-8 text-white text-xs font-semibold">
                        <i class="fa-regular fa-eye text-[12px]"></i>
                        <span>{{default (t 'test.syllabus.materi.openPdf') 'Buka PDF'}}</span>
                      </span>
                    </button>
                  {{/each}}

                  {{#each pptMaterials}}
                    <button
                      type="button"
                      @click="$dispatch('open-syllabus-material', {{json this}})"
                      class="w-full flex items-center gap-3 p-3 bg-[#FFFFFF] border border-[#E2E8F0] rounded-[12px] text-left hover:border-[#003060] transition-colors shadow-sm"
                    >
                      <span class="px-2 py-0.5 rounded bg-[#EFF6FF] border border-[#DBEAFE] text-[#2563EB] font-bold text-[11px] shrink-0">
                        {{default (t 'test.syllabus.materi.pptLabel') 'PPTX'}}
                      </span>
                      <span class="flex flex-col min-w-0 flex-1">
                        <span class="font-semibold text-xs text-[#1E293B] truncate">
                          {{default this.title (default (t 'test.syllabus.materi.defaultPptTitle') 'Slide PPTX')}}
                        </span>
                        <span class="text-[11px] text-[#64748B] truncate">
                          {{default this.originalFileName 'Slide.pptx'}}{{#if this.formattedSize}} · {{this.formattedSize}}{{/if}}
                        </span>
                      </span>
                      <span class="shrink-0 inline-flex items-center gap-1.5 rounded-[6px] bg-[#003060] px-3 h-8 text-white text-xs font-semibold">
                        <i class="fa-regular fa-eye text-[12px]"></i>
                        <span>{{default (t 'test.syllabus.materi.openPpt') 'Buka Slide'}}</span>
                      </span>
                    </button>
                  {{/each}}

                  {{#if videoMaterial}}
                    <button
                      type="button"
                      @click="$dispatch('open-syllabus-material', {{json videoMaterial}})"
                      class="w-full flex items-center gap-3 p-3 bg-[#FFFFFF] border border-[#E2E8F0] rounded-[12px] text-left hover:border-[#003060] transition-colors shadow-sm"
                    >
                      <span class="px-2 py-0.5 rounded bg-[#ECFDF5] border border-[#A7F3D0] text-[#047857] font-bold text-[11px] shrink-0">
                        {{default (t 'test.syllabus.materi.videoLabel') 'VIDEO'}}
                      </span>
                      <span class="flex flex-col min-w-0 flex-1">
                        <span class="font-semibold text-xs text-[#1E293B] truncate">
                          {{default videoMaterial.title (default (t 'test.syllabus.materi.defaultVideoTitle') 'Video Pembelajaran')}}
                        </span>
                        {{#if videoMaterial.originalFileName}}
                          <span class="text-[11px] text-[#64748B] truncate">
                            {{videoMaterial.originalFileName}}{{#if videoMaterial.formattedSize}} · {{videoMaterial.formattedSize}}{{/if}}
                          </span>
                        {{/if}}
                      </span>
                      <span class="shrink-0 inline-flex items-center gap-1.5 rounded-[6px] bg-[#003060] px-3 h-8 text-white text-xs font-semibold">
                        <i class="fa-solid fa-play text-[11px]"></i>
                        <span>{{default (t 'test.syllabus.materi.openVideo') 'Tonton Video'}}</span>
                      </span>
                    </button>
                  {{/if}}
                </div>
              {{else}}
                {{!-- Empty State Materi: Header Tetap Utuh --}}
                <div class="w-full p-4 bg-[#F8FAFC] border border-dashed border-[#CBD5E1] rounded-[12px] flex flex-col items-center justify-center text-center gap-2">
                  <span class="grid size-9 place-items-center rounded-full bg-[#E2E8F0] text-[#64748B]">
                    <i class="fa-regular fa-folder-open text-base"></i>
                  </span>
                  <p class="font-medium text-xs text-[#64748B]">
                    {{default (t 'test.syllabus.materi.empty') 'Belum ada materi PDF, slide, atau video untuk silabus ini.'}}
                  </p>
                </div>
              {{/if}}
            </section>

            {{!-- Card: Status & Aksi Quiz --}}
            <section class="box-border w-full bg-white border border-[#D9D9D9] rounded-[16px] p-6 flex flex-col items-center gap-5">
              {{#if quiz}}
                <span class="inline-flex items-center gap-1.5 px-3 py-[6px] rounded-[100px] {{#if quizStatus.isPassed}}bg-[#F0FDF4] text-[#15803D]{{else if quizStatus.hasAttempt}}bg-[#FEF2F2] text-[#B42318]{{else}}bg-[#FEF3C7] text-[#D97706]{{/if}}">
                  <i class="fa-solid fa-award text-[14px]"></i>
                  {{#if quizStatus.isPassed}}{{default (t 'test.syllabus.quiz.passed') 'Lulus'}}{{else if quizStatus.hasAttempt}}{{default (t 'test.syllabus.quiz.notPassed') 'Belum Lulus'}}{{else}}{{default (t 'test.syllabus.quiz.notAttempted') 'Belum dikerjakan'}}{{/if}}
                </span>

                <p class="font-medium text-[12px] leading-[18px] text-center text-[#718096]">
                  {{#if quizStatus.isPassed}}
                    {{default (t 'test.syllabus.quiz.passedMessage' minScore=minScore) 'Selamat, kamu sudah lulus quiz silabus ini. Nilai minimal {minScore} untuk lulus.'}}
                  {{else if quizStatus.hasAttempt}}
                    {{default (t 'test.syllabus.quiz.hasAttemptMessage' bestScore=quizStatus.bestScore minScore=minScore) 'Skor terbaik kamu {bestScore}. Kerjakan ulang untuk mencapai nilai minimal {minScore}.'}}
                  {{else}}
                    {{default (t 'test.syllabus.quiz.startMessage') 'Kerjakan quiz silabus ini untuk menandai modul sebagai lulus.'}}
                  {{/if}}
                </p>

                <a
                  href="/quiz/form/{{quiz.id}}"
                  class="inline-flex w-full h-10 items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-6 font-semibold text-[14px] leading-[20px] text-white no-underline hover:bg-[#00254a] transition-colors"
                >
                  {{#if quizStatus.isPassed}}{{default (t 'test.syllabus.quiz.ctaPassed') 'Lihat Quiz'}}{{else if quizStatus.hasAttempt}}{{default (t 'test.syllabus.quiz.ctaRetry') 'Kerjakan Ulang'}}{{else}}{{default (t 'test.syllabus.quiz.ctaStart') 'Kerjakan Quiz'}}{{/if}}
                </a>

                {{#if (and next (not syllabus.isFinal))}}
                  <p class="font-medium text-[11px] leading-[16px] text-center text-[#718096]">
                    {{default (t 'test.syllabus.quiz.nextSyllabus' title=next.title) 'Setelah lulus, lanjut ke: {title}'}}
                  </p>
                {{/if}}
              {{else}}
                <span class="grid place-items-center w-11 h-11 rounded-full bg-[#F5F5F5] text-[#a3a3a3]">
                  <i class="fa-solid fa-circle-question text-base"></i>
                </span>
                <p class="font-medium text-[12px] leading-[18px] text-center text-[#718096]">
                  {{default (t 'test.syllabus.quiz.unavailable') 'Quiz belum tersedia untuk silabus ini.'}}
                </p>
              {{/if}}
            </section>

            {{!-- Card: Cara Belajar --}}
            <section class="box-border w-full bg-white border border-[#D9D9D9] rounded-[16px] p-6 flex flex-col items-start gap-5">
              <div class="w-full flex flex-row items-center gap-2">
                <span class="grid place-items-center w-4 h-4 shrink-0">
                  <i class="fa-solid fa-circle-info text-[#003060] text-[16px]"></i>
                </span>
                <h3 class="font-bold text-[14px] leading-[17px] text-[#003060]">
                  {{default (t 'test.syllabus.howTo.title') 'Cara Belajar'}}
                </h3>
              </div>

              <ul class="flex flex-col items-start gap-3 font-normal text-[12px] leading-[18px] text-[#718096]">
                <li class="flex flex-row items-start gap-2">
                  <span class="w-[4px] shrink-0">•</span>
                  <span>{{default (t 'test.syllabus.howTo.item1') 'Tonton video dan baca dasar teori di samping'}}</span>
                </li>
                <li class="flex flex-row items-start gap-2">
                  <span class="w-[4px] shrink-0">•</span>
                  <span>{{default (t 'test.syllabus.howTo.item2' minScore=minScore) 'Kerjakan quiz, nilai minimal {minScore} untuk lulus'}}</span>
                </li>
                <li class="flex flex-row items-start gap-2">
                  <span class="w-[4px] shrink-0">•</span>
                  <span>{{default (t 'test.syllabus.howTo.item3') 'Setelah lulus, silabus berikutnya otomatis terbuka'}}</span>
                </li>
              </ul>
            </section>
          </aside>
        </div>
      </div>
    </div>
  </div>

  {{!-- Modal viewer materi (PDF / PPT / Video) --}}
  {{> components/ui/user/modal/material_viewer/index syllabusId=syllabus.id}}
</div>
{{/user/shell_frame/index}}
