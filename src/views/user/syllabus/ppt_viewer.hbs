{{!--
  Halaman: Penampil Slide Presentasi Silabus (Google Slides Preview)
  Rute   : GET /syllabus/learn/:syllabusId/view/ppt
--}}
{{#> user/shell_frame/index
  user=user
  active='learning'
  pageTitle=(default selected.title 'Slide Presentasi')
  back=false
  trail=(array
    (obj 'label' (t 'test.common.home') 'href' '/users/profile?tab=dashboard')
    (obj 'label' (t 'test.userSidebar.myLearning') 'href' '/users/profile?tab=learning')
    (obj
      'label' (t 'test.startLearning.startLearning')
      'href' (concat '/program/myProgram/' user.id '?courseId=' course.id))
    (obj 'label' syllabus.title 'href' (concat '/syllabus/learn/' syllabus.id))
    (obj 'label' 'Slide Presentasi')
  )
}}
<div class="min-h-full px-4 pb-12 pt-6 sm:px-8 font-inter">
  <div class="max-w-[1540px] mx-auto flex flex-col gap-6 items-start">

    <!-- Header Bar: Back to Syllabus + Title -->
    <div class="w-full flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#E2E8F0] pb-4">
      <div class="flex items-center gap-3">
        <a
          href="/syllabus/learn/{{syllabus.id}}"
          class="grid size-10 place-items-center rounded-lg border border-[#D9D9D9] bg-white text-[#003060] hover:bg-[#F8FAFC] transition-colors no-underline shadow-sm"
          title="Kembali ke Silabus"
        >
          <i class="fa-solid fa-arrow-left text-sm"></i>
        </a>
        <div class="flex flex-col">
          <span class="text-xs font-semibold text-[#64748B] flex items-center gap-1.5">
            <i class="fa-solid fa-book-open text-[#003060]"></i>
            <span>{{syllabus.title}}</span>
          </span>
          <h1 class="font-bold text-xl sm:text-2xl text-[#003060]">
            {{default selected.title 'Slide Presentasi Silabus'}}
          </h1>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/syllabus/learn/{{syllabus.id}}/materials/{{selected.id}}/download"
          class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-[#003060] px-4 font-semibold text-xs sm:text-sm text-white no-underline hover:bg-[#002244] transition-colors shadow-sm"
        >
          <i class="fa-solid fa-download text-xs"></i>
          <span>Unduh Slide Asli (.pptx)</span>
        </a>
      </div>
    </div>

    <!-- Presentation Workspace Card -->
    <div class="w-full bg-white rounded-[22px] p-4 sm:p-6 lg:p-7 shadow-[0px_12px_32px_rgba(15,23,42,0.04)] border border-[#E2E8F0]">
      <div class="w-full flex flex-col lg:flex-row items-start gap-6">

        <!-- Left/Main Column: Google Slides Screen -->
        <div class="flex-1 w-full min-w-0 flex flex-col items-start gap-4">
          <div class="w-full h-[520px] sm:h-[640px] lg:h-[720px] bg-[#0F172A] rounded-[20px] overflow-hidden flex flex-col shadow-inner relative">
            {{#if selected.isGoogleSlides}}
              <iframe
                class="w-full h-full rounded-[20px] border-none bg-slate-900"
                src="{{selected.embedUrl}}"
                allowfullscreen="true"
                mozallowfullscreen="true"
                webkitallowfullscreen="true"
              ></iframe>
            {{else if selected.isLocalFile}}
              <div class="w-full h-full flex flex-col items-center justify-center p-8 text-center text-white gap-4 bg-gradient-to-b from-[#0F172A] to-[#1E293B]">
                <div class="w-20 h-20 rounded-2xl bg-[#2563EB]/20 border border-[#2563EB]/40 flex items-center justify-center shadow-lg">
                  <i class="fa-solid fa-file-powerpoint text-4xl text-[#60A5FA]"></i>
                </div>
                <div class="flex flex-col gap-1.5 max-w-md">
                  <h3 class="font-bold text-lg text-white">
                    {{default selected.originalFileName 'Slide-Presentasi.pptx'}}
                  </h3>
                  <p class="text-xs text-slate-300">
                    File presentasi PowerPoint telah tersimpan aman di server ({{default selected.formattedSize '31.9 KB'}}). Berkas ini siap diunduh untuk dibuka di Microsoft PowerPoint, LibreOffice, atau Google Slides Anda.
                  </p>
                </div>
                <div class="flex flex-col sm:flex-row items-center gap-3 mt-2">
                  <a
                    href="/syllabus/learn/{{syllabus.id}}/materials/{{selected.id}}/download"
                    class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-[#2563EB] px-6 font-semibold text-sm text-white no-underline hover:bg-[#1D4ED8] transition-colors shadow-md"
                  >
                    <i class="fa-solid fa-download text-sm"></i>
                    <span>Unduh & Buka Berkas (.pptx)</span>
                  </a>
                </div>
                <div class="mt-4 px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 max-w-md text-[11px] text-slate-400">
                  <i class="fa-solid fa-circle-info text-blue-400 mr-1"></i>
                  <span><strong>Tips:</strong> Jika ingin slide dapat dipratinjau interaktif langsung di halaman ini seperti di Bootcamp, tempelkan <em>Link Google Slides</em> pada menu Edit Silabus.</span>
                </div>
              </div>
            {{else if selected.embedUrl}}
              <iframe
                class="w-full h-full rounded-[20px] border-none bg-slate-900"
                src="{{selected.embedUrl}}"
                allowfullscreen="true"
                mozallowfullscreen="true"
                webkitallowfullscreen="true"
              ></iframe>
            {{else}}
              <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center text-white gap-3">
                <i class="fa-solid fa-file-powerpoint text-4xl text-blue-400"></i>
                <p class="font-semibold text-base">Pratinjau slide tidak tersedia secara langsung.</p>
                <p class="text-xs text-slate-400 max-w-sm">Silakan gunakan tombol unduh di kanan atas untuk melihat file presentasi di komputermu.</p>
              </div>
            {{/if}}
          </div>
        </div>

        <!-- Right Column: Slide List / Information Card -->
        <aside class="w-full lg:w-[320px] flex flex-col gap-4 shrink-0">
          <div class="w-full bg-[#F8FAFC] border border-[#E2E8F0] rounded-[16px] p-5 flex flex-col gap-3.5">
            <div class="flex items-center gap-2 border-b border-[#E2E8F0] pb-2.5">
              <span class="px-2 py-0.5 rounded bg-[#EFF6FF] border border-[#DBEAFE] text-[#2563EB] font-bold text-xs">PPTX</span>
              <h3 class="font-bold text-sm text-[#003060]">Informasi Slide</h3>
            </div>
            <div class="flex flex-col gap-2 text-xs text-[#64748B]">
              <div class="flex justify-between items-center py-1 border-b border-[#F1F5F9]">
                <span class="font-medium text-[#718096]">Nama Berkas:</span>
                <span class="font-semibold text-[#1E293B] truncate max-w-[170px]" title="{{selected.originalFileName}}">
                  {{default selected.originalFileName 'Slide.pptx'}}
                </span>
              </div>
              {{#if selected.formattedSize}}
                <div class="flex justify-between items-center py-1 border-b border-[#F1F5F9]">
                  <span class="font-medium text-[#718096]">Ukuran:</span>
                  <span class="font-semibold text-[#1E293B]">{{selected.formattedSize}}</span>
                </div>
              {{/if}}
              <div class="flex justify-between items-center py-1">
                <span class="font-medium text-[#718096]">Penampil:</span>
                <span class="font-semibold text-[#003060]">
                  {{#if selected.isGoogleSlides}}Google Slides Embed{{else}}Berkas Lokal PPTX{{/if}}
                </span>
              </div>
          </div>

          {{#if (gt pptList.length 1)}}
            <div class="w-full bg-white border border-[#E2E8F0] rounded-[16px] p-4 flex flex-col gap-2.5">
              <h4 class="font-bold text-xs text-[#003060] uppercase tracking-wider">Slide Lainnya</h4>
              <div class="flex flex-col gap-2">
                {{#each pptList}}
                  <a
                    href="/syllabus/learn/{{../syllabus.id}}/view/ppt?materialId={{this.id}}"
                    class="p-2.5 rounded-lg border text-xs font-medium no-underline transition-colors flex items-center justify-between {{#if (eq this.id ../selected.id)}}bg-[#EBF5FF] border-[#003060] text-[#003060]{{else}}bg-white border-[#E2E8F0] text-[#64748B] hover:bg-[#F8FAFC]{{/if}}"
                  >
                    <span class="truncate max-w-[210px]">{{this.title}}</span>
                    <i class="fa-solid fa-chevron-right text-[10px]"></i>
                  </a>
                {{/each}}
              </div>
            </div>
          {{/if}}

          <a
            href="/syllabus/learn/{{syllabus.id}}"
            class="w-full h-10 inline-flex items-center justify-center gap-2 rounded-lg border border-[#003060] text-[#003060] font-semibold text-xs hover:bg-[#F0F7FF] transition-colors no-underline"
          >
            <i class="fa-solid fa-arrow-left text-[11px]"></i>
            <span>Kembali ke Modul Silabus</span>
          </a>
        </aside>

      </div>
    </div>

  </div>
</div>
{{/user/shell_frame/index}}
