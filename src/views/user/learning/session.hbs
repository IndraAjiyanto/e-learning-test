{{!--
  Halaman: Detail Sesi (area student)
  Rute   : GET /program/session/detail/:sessionId  (courses.controller.ts)

  Sebelumnya isi sesi hanya ada sebagai akordeon di dalam akordeon minggu pada
  panel Start Learning. Untuk melihat satu tugas, student membuka minggu, lalu
  membuka sesi, lalu membaca di dalam ruang selebar setengah layar. Sekarang
  sesi punya halamannya sendiri.

  Penguncian dihitung di server (CoursesService.findSessionDetail) dan sesi yang
  terkunci dialihkan kembali oleh controller, jadi halaman ini boleh
  mengasumsikan sesinya memang boleh dibuka.

  Data: session, week, course, previous, next, position, totalSessions,
        attended, logbookDone, materials{pdf,ppt,video}, materialsCount,
        assignments[{...,answer,submitted}], logbook, steps, stepsDone,
        stepsTotal, stepsPercent
--}}
{{#> user/shell_frame/index user=user active='learning' pageTitle=(default session.topic (t 'test.startLearning.session')) back=(concat '/program/myProgram/' user.id '?courseId=' course.id)}}
<div class="min-h-full px-4 pb-10 pt-6 sm:px-8">
  <div class="flex w-full flex-col gap-6">

    {{!-- Kepala halaman: posisi sesi, judul, keterangan waktu dan tempat, lalu
         kemajuan langkahnya. --}}
    <div class="rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-6">
      <p class="font-inter text-xs font-semibold uppercase tracking-wide text-[#a3a3a3]">
        {{t 'test.startLearning.week'}} {{week.weekNumber}}
        &middot;
        {{t 'test.startLearning.session'}} {{position}} {{t 'test.startLearning.of'}} {{totalSessions}}
      </p>
      <h1 class="mt-1 font-inter text-xl font-bold leading-snug text-[#003060] sm:text-2xl">
        {{default session.topic (concat (t 'test.startLearning.session') ' ' position)}}
      </h1>

      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 font-inter text-sm text-[#525252]">
        {{#if session.date}}
          <span class="inline-flex items-center gap-1.5">
            <i class="fa-regular fa-calendar text-xs text-[#718096]"></i>
            {{formatDate session.date}}
          </span>
        {{/if}}
        {{#if session.startTime}}
          <span class="inline-flex items-center gap-1.5">
            <i class="fa-regular fa-clock text-xs text-[#718096]"></i>
            {{session.startTime}}{{#if session.endTime}} - {{session.endTime}}{{/if}}
          </span>
        {{/if}}
        {{#if session.location}}
          <span class="inline-flex items-center gap-1.5">
            <i class="fa-solid fa-location-dot text-xs text-[#718096]"></i>
            {{session.location}}
          </span>
        {{/if}}
      </div>

      {{!-- Kemajuan langkah. Menjawab "tinggal apa lagi" tanpa harus menggulung
           seluruh halaman. --}}
      {{#if stepsTotal}}
        <div class="mt-5">
          <div class="mb-2 flex items-center justify-between gap-3 font-inter text-sm">
            <span class="text-[#525252]">
              {{stepsDone}} {{t 'test.startLearning.of'}} {{stepsTotal}} {{t 'test.startLearning.stepsDone'}}
            </span>
            <span class="font-semibold text-[#003060]">{{stepsPercent}}%</span>
          </div>
          <div
            class="h-2 w-full overflow-hidden rounded-full bg-[#E5E5E5]"
            role="progressbar"
            aria-label="{{t 'test.startLearning.sessionProgress'}}"
            aria-valuenow="{{stepsPercent}}"
            aria-valuemin="0"
            aria-valuemax="100"
          >
            <div class="h-full rounded-full bg-[#22C55E] transition-all duration-500" style="width: {{stepsPercent}}%"></div>
          </div>
        </div>
      {{/if}}
    </div>

    {{!-- 1. Absensi. Diletakkan paling atas karena menjadi syarat langkah lain. --}}
    <section class="rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-6">
      <div class="mb-4 flex items-center gap-2.5">
        <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-[#E4F1F7] text-[#003060]">
          <i class="fa-solid fa-user-check text-sm"></i>
        </span>
        <h2 class="font-inter text-base font-bold text-[#171717]">{{t 'test.startLearning.attendance'}}</h2>
      </div>

      {{#if attended}}
        <div class="flex items-center gap-2 rounded-lg border border-[#bbf7d0] bg-[#f0fdf4] px-4 py-3">
          <i class="fa-solid fa-circle-check text-sm text-[#15803d]"></i>
          <p class="font-inter text-sm font-medium text-[#15803d]">{{t 'test.startLearning.attendaceRecorded'}}</p>
        </div>
      {{else}}
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <p class="font-inter text-sm text-[#525252]">{{t 'test.startLearning.attendanceRequired'}}</p>
          <a
            href="/attendance/form/{{session.id}}"
            class="inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-[18px] font-inter text-base font-semibold text-white no-underline transition-colors hover:bg-[#00254a]"
          >
            <i class="fa-solid fa-user-check text-xs"></i>
            {{t 'test.startLearning.markAttendance'}}
          </a>
        </div>
      {{/if}}
    </section>

    {{!-- 2. Materi. Dikelompokkan per jenis; jenis yang tidak ada tidak
         ditampilkan sama sekali, tidak lagi sebagai ubin kosong. --}}
    <section class="rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-6">
      <div class="mb-4 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-[#E4F1F7] text-[#003060]">
            <i class="fa-solid fa-book-open text-sm"></i>
          </span>
          <h2 class="font-inter text-base font-bold text-[#171717]">{{t 'test.startLearning.materials'}}</h2>
        </div>
        {{#if materialsCount}}
          <span class="rounded-full bg-[#F5F5F5] px-2.5 py-0.5 font-inter text-xs font-semibold text-[#525252]">{{materialsCount}}</span>
        {{/if}}
      </div>

      {{#if materialsCount}}
        {{#unless attended}}
          <div class="mb-4 flex items-start gap-2 rounded-lg border border-[#FEF08A] bg-[#FEFCE8] px-4 py-3">
            <i class="fa-solid fa-lock mt-0.5 text-xs text-[#A16207]"></i>
            <p class="font-inter text-xs text-[#A16207]">{{t 'test.startLearning.materialsLockedHint'}}</p>
          </div>
        {{/unless}}

        {{!--
          Materi disebut satu per satu, bukan diringkas jadi ubin "PDF Material 3".
          Satu sesi bisa punya beberapa berkas sejenis, dan angka saja tidak
          memberi tahu apa isinya. Tiap baris menuju penampil dengan berkas itu
          sudah terpilih, jadi student tidak perlu memilih dua kali.
        --}}
        <div class="space-y-5">
          {{#each materialGroups}}
            <div>
              <p class="mb-2 font-inter text-xs font-semibold uppercase tracking-wide text-[#a3a3a3]">
                {{#if (eq this.type 'pdf')}}{{t 'test.startLearning.pdfMaterial'}}{{/if}}
                {{#if (eq this.type 'ppt')}}{{t 'test.startLearning.presentation'}}{{/if}}
                {{#if (eq this.type 'video')}}{{t 'test.startLearning.videoLeassons'}}{{/if}}
                <span class="text-[#d4d4d4]">&middot;</span> {{this.items.length}}
              </p>

              <ul class="flex flex-col gap-2">
                {{#each this.items}}
                  <li>
                    {{#if ../../materialsLocked}}
                      <span
                        class="flex cursor-not-allowed items-center gap-3 rounded-lg border border-dashed border-[#D4D4D4] bg-[#FAFAFA] px-4 py-3"
                        aria-disabled="true"
                      >
                        <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-[#E5E5E5] text-[#a3a3a3]">
                          <i class="fa-solid fa-lock text-xs"></i>
                        </span>
                        <span class="min-w-0 flex-1 truncate font-inter text-sm font-medium text-[#a3a3a3]">{{this.title}}</span>
                      </span>
                    {{else}}
                      <a
                        href="/learning-material/{{../this.type}}/{{../../session.id}}?materialId={{this.id}}"
                        class="group flex items-center gap-3 rounded-lg border border-[#D4D4D4] bg-white px-4 py-3 no-underline shadow-[0px_1px_2px_rgba(0,0,0,0.05)] transition-colors hover:border-[#003060] hover:bg-[#F5F5F5]"
                      >
                        <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-[#E4F1F7] text-[#003060]">
                          <i class="fa-solid {{../this.icon}} text-sm"></i>
                        </span>
                        <span class="min-w-0 flex-1 truncate font-inter text-sm font-medium text-[#003060]">{{this.title}}</span>
                        <i class="fa-solid fa-arrow-right shrink-0 text-xs text-[#718096] transition-transform group-hover:translate-x-0.5"></i>
                      </a>
                    {{/if}}
                  </li>
                {{/each}}
              </ul>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="font-inter text-sm text-[#737373]">{{t 'test.startLearning.noMaterials'}}</p>
      {{/if}}
    </section>

    {{!-- 3. Tugas. --}}
    <section class="rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-6">
      <div class="mb-4 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-[#E4F1F7] text-[#003060]">
            <i class="fa-solid fa-list-check text-sm"></i>
          </span>
          <h2 class="font-inter text-base font-bold text-[#171717]">{{t 'test.startLearning.assignment'}}</h2>
        </div>
        {{#if assignments.length}}
          <span class="rounded-full bg-[#F5F5F5] px-2.5 py-0.5 font-inter text-xs font-semibold text-[#525252]">{{assignments.length}}</span>
        {{/if}}
      </div>

      {{#if assignments.length}}
        <ul class="flex flex-col divide-y divide-[#E5E5E5]">
          {{#each assignments}}
            <li class="flex flex-col gap-3 py-3 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0">
                <p class="truncate font-inter text-sm font-semibold text-[#171717]">{{this.title}}</p>
                {{!-- Empat keadaan, bukan dua. Sebelumnya jawaban yang DITOLAK
                     pun tertulis "Assignment Completed", sehingga student
                     mengira tugasnya beres padahal harus dikirim ulang. --}}
                {{#if (eq this.status 'approved')}}
                  <span class="mt-1 inline-flex items-center gap-1.5 rounded-full bg-[#f0fdf4] px-2.5 py-0.5 font-inter text-xs font-semibold text-[#15803d]">
                    <i class="fa-solid fa-circle-check text-[0.65rem]"></i>
                    {{t 'test.startLearning.assignmentCompleted'}}
                  </span>
                {{else if (eq this.status 'rejected')}}
                  <span class="mt-1 inline-flex items-center gap-1.5 rounded-full bg-[#FEF2F2] px-2.5 py-0.5 font-inter text-xs font-semibold text-[#B42318]">
                    <i class="fa-solid fa-circle-xmark text-[0.65rem]"></i>
                    {{t 'test.startLearning.assignmentRejected'}}
                  </span>
                {{else if (eq this.status 'in_review')}}
                  <span class="mt-1 inline-flex items-center gap-1.5 rounded-full bg-[#FEFCE8] px-2.5 py-0.5 font-inter text-xs font-semibold text-[#A16207]">
                    <i class="fa-regular fa-clock text-[0.65rem]"></i>
                    {{t 'test.startLearning.assignmentInReview'}}
                  </span>
                {{else}}
                  <span class="mt-1 inline-flex items-center gap-1.5 rounded-full bg-[#F5F5F5] px-2.5 py-0.5 font-inter text-xs font-semibold text-[#525252]">
                    {{t 'test.startLearning.notSubmitted'}}
                  </span>
                {{/if}}
              </div>
              <a
                href="/answer-assigment/{{../session.id}}/{{this.id}}"
                class="inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-[8px] px-4 font-inter text-sm font-semibold no-underline transition-colors {{#if (eq this.status 'rejected')}}bg-[#003060] text-white hover:bg-[#00254a]{{else}}border border-[#D4D4D4] bg-white text-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] hover:bg-[#F5F5F5]{{/if}}"
              >
                {{#if (eq this.status 'rejected')}}{{t 'test.startLearning.resubmitAssignment'}}
                {{else if this.submitted}}{{t 'test.startLearning.viewSubmission'}}
                {{else}}{{t 'test.startLearning.startAssignment'}}{{/if}}
                <i class="fa-solid fa-arrow-right text-xs"></i>
              </a>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="font-inter text-sm text-[#737373]">{{t 'test.startLearning.noAssignments'}}</p>
      {{/if}}
    </section>

    {{!-- Logbook hanya dirender kalau program ini memakainya. Pada program
         SPL sakelarnya bisa dimatikan admin, dan menampilkan kartu yang
         tidak punya jalan diselesaikan lebih buruk daripada tidak ada. --}}
    {{#if caps.logbookEnabled}}
    {{!-- 4. Logbook. Keadaannya menentukan satu tombol saja, supaya student
         tidak perlu menebak mana yang berlaku. --}}
    <section class="rounded-xl border border-[#E5E5E5] bg-white p-5 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] sm:p-6">
      <div class="mb-4 flex items-center gap-2.5">
        <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-[#E4F1F7] text-[#003060]">
          <i class="fa-regular fa-clipboard text-sm"></i>
        </span>
        <h2 class="font-inter text-base font-bold text-[#171717]">{{t 'test.startLearning.myLogbook'}}</h2>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="min-w-0">
          {{#if logbook}}
            {{#if (eq logbook.process 'approved')}}
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#f0fdf4] px-2.5 py-0.5 font-inter text-xs font-semibold text-[#15803d]">
                <i class="fa-solid fa-circle-check text-[0.65rem]"></i> {{t 'test.startLearning.viewApprovedLogBook'}}
              </span>
            {{else if (eq logbook.process 'rejected')}}
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#FEF2F2] px-2.5 py-0.5 font-inter text-xs font-semibold text-[#B42318]">
                <i class="fa-solid fa-circle-xmark text-[0.65rem]"></i> {{t 'test.startLearning.updateRejectedLogBook'}}
              </span>
            {{else}}
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#FEFCE8] px-2.5 py-0.5 font-inter text-xs font-semibold text-[#A16207]">
                <i class="fa-regular fa-clock text-[0.65rem]"></i> {{t 'test.startLearning.logBookUnderReview'}}
              </span>
            {{/if}}
            <p class="mt-1.5 line-clamp-2 font-inter text-sm text-[#525252]">{{logbook.activity}}</p>
          {{else}}
            <p class="font-inter text-sm text-[#525252]">{{t 'test.startLearning.logbookHint'}}</p>
          {{/if}}
        </div>

        {{#if logbook}}
          {{#if (eq logbook.process 'rejected')}}
            <a href="/logbooks/formEdit/{{logbook.id}}" class="inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-[18px] font-inter text-base font-semibold text-white no-underline transition-colors hover:bg-[#00254a]">
              {{t 'test.startLearning.updateRejectedLogBook'}}
            </a>
          {{else}}
            <a href="/logbooks/{{logbook.id}}" class="inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-[8px] border border-[#D4D4D4] bg-white px-[18px] font-inter text-base font-semibold text-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] no-underline transition-colors hover:bg-[#F5F5F5]">
              {{t 'test.startLearning.viewLogbook'}}
            </a>
          {{/if}}
        {{else}}
          <a href="/logbooks/formCreate/{{session.id}}/{{course.id}}" class="inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-[18px] font-inter text-base font-semibold text-white no-underline transition-colors hover:bg-[#00254a]">
            <i class="fa-solid fa-plus text-xs"></i>
            {{t 'test.startLearning.createLogBook'}}
          </a>
        {{/if}}
      </div>
    </section>
    {{/if}}

    {{!-- Pindah sesi tanpa kembali ke daftar. --}}
    <nav class="flex flex-col gap-3 sm:flex-row sm:items-stretch sm:justify-between" aria-label="{{t 'test.startLearning.sessionNav'}}">
      {{#if previous}}
        <a href="/program/session/detail/{{previous.id}}" class="flex min-w-0 flex-1 items-center gap-3 rounded-xl border border-[#E5E5E5] bg-white p-4 no-underline shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#FAFAFA]">
          <i class="fa-solid fa-arrow-left shrink-0 text-xs text-[#718096]"></i>
          <span class="min-w-0">
            <span class="block font-inter text-xs text-[#a3a3a3]">{{t 'test.startLearning.previousSession'}}</span>
            <span class="block truncate font-inter text-sm font-semibold text-[#003060]">{{default previous.topic (t 'test.startLearning.session')}}</span>
          </span>
        </a>
      {{else}}
        <span class="hidden flex-1 sm:block"></span>
      {{/if}}

      {{#if next}}
        <a href="/program/session/detail/{{next.id}}" class="flex min-w-0 flex-1 items-center justify-end gap-3 rounded-xl border border-[#E5E5E5] bg-white p-4 text-right no-underline shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#FAFAFA]">
          <span class="min-w-0">
            <span class="block font-inter text-xs text-[#a3a3a3]">{{t 'test.startLearning.nextSession'}}</span>
            <span class="block truncate font-inter text-sm font-semibold text-[#003060]">{{default next.topic (t 'test.startLearning.session')}}</span>
          </span>
          <i class="fa-solid fa-arrow-right shrink-0 text-xs text-[#718096]"></i>
        </a>
      {{/if}}
    </nav>

  </div>
</div>
{{/user/shell_frame/index}}
