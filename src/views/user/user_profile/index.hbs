{{!-- Toast sukses (flash `toast`) untuk aksi yang redirect ke /users/profile:
     change password, update profile, dan update akun. Ditaruh di luar
     percabangan role supaya kedua varian halaman profil (admin & user)
     memakainya, dan di luar x-data lain sesuai kontrak komponen. --}}
{{> components/ui/super_admin/toast/success/index toast=toast }}

{{#if (or (eq user.role 'admin') (eq user.role 'super_admin'))}}
  {{> components/ui/profile/index 
    user=user 
  }}
{{else}}


{{!-- USER PROFILE INDEX VIEW --}}
<script>
  window.userLogbooks = {{{json logbooks}}};
  window.userCourses = {{{json userWithCourses.userCourses}}};
</script>
<div 
  class="relative h-screen supports-[height:100dvh]:h-[100dvh] flex flex-col bg-[#F2F2F3] font-montserrat overflow-hidden"
  x-data="{
    lang: '{{lang}}',
    activeSection: new URLSearchParams(window.location.search).get('tab') || '{{activeSection}}' || '{{#if (or (eq user.role "admin") (eq user.role "super_admin"))}}profile{{else}}dashboard{{/if}}',
    openMyLearning: true,
    openRoblox: false,
    openedCourses: {},
    activeCourseId: {{#if activeCourse}}'{{activeCourse.id}}'{{else}}null{{/if}},
    userCourses: window.userCourses || [],
    allLogbooks: window.userLogbooks || [],
    logbookSearchInput: '',
    logbookCurrentPage: 1,
    logbookItemsPerPage: 10,
    logbookImageErrors: {},
    handledSections: [
      'dashboard', 'profile', 'password', 'learning', 'uiux', 'portfolio', 'history-payment',
      'assignment', 'logbook', 'quiz', 'quiz-start', 'certificate',
      'group-class', 'presentation'
    ],
    sectionFragmentConfig: {
      uiux: { url: '/program/myProgram/{{user.id}}/fragment', container: 'start-learning-container' },
      assignment: { url: '/program/myProgram/{{user.id}}/fragment/assignment', container: 'assignment-container' },
      presentation: { url: '/program/myProgram/{{user.id}}/fragment/presentation', container: 'presentation-container' },
      quiz: { url: '/program/myProgram/{{user.id}}/fragment/quiz', container: 'quiz-container' }
    },
    toggleActiveSection(section) {
      this.activeSection = section;
      if (this.sectionFragmentConfig[section]) {
        const courseId = this.activeCourseId || (this.userCourses[0] && this.userCourses[0].course && this.userCourses[0].course.id);
        if (courseId) {
          this.activeCourseId = courseId;
          this.loadCourseFragment(section, courseId);
        }
      }
    },
    {{!-- Bagian yang memang milik sebuah program. Kepala program dan baris tab
         hanya muncul untuk section ini; Dashboard, Profile, My Portfolio, dan
         Payment History tidak boleh kebagian gambar program. --}}
    programSections: ['uiux', 'presentation', 'assignment', 'quiz', 'logbook', 'certificate', 'group-class', 'quiz-start'],
    get isProgramSection() {
      return this.programSections.includes(this.activeSection);
    },

    {{!-- Course yang sedang dibuka, diambil dari data yang SUDAH ada di sisi
         klien (window.userCourses). Dengan begitu kepala program ikut benar di
         kedua rute yang merender shell, tanpa menyentuh controller. --}}
    get activeCourseData() {
      const found = this.userCourses.find((uc) => uc.course && uc.course.id === this.activeCourseId);
      if (found) return found.course;
      return this.userCourses[0] ? this.userCourses[0].course : null;
    },
    byLang(obj) {
      if (!obj || typeof obj !== 'object') return '';
      return obj[this.lang] || obj.id || obj.en || '';
    },

    get activeCourseName() {
      const found = this.userCourses.find((uc) => uc.course && uc.course.id === this.activeCourseId);
      return found ? found.course.name : 'My Program';
    },
    get filteredLogbooks() {
      if (!this.activeCourseId) return [];
      const search = this.logbookSearchInput.trim().toLowerCase();
      return this.allLogbooks.filter((lb) => {
        const courseId = lb.session && lb.session.weeks && lb.session.weeks.course ? lb.session.weeks.course.id : null;
        if (courseId !== this.activeCourseId) return false;
        if (!search) return true;
        return (lb.activity || '').toLowerCase().includes(search) ||
          (lb.activityDetails || '').toLowerCase().includes(search) ||
          (lb.obstacles || '').toLowerCase().includes(search);
      });
    },
    get totalLogbookPages() {
      return Math.max(1, Math.ceil(this.filteredLogbooks.length / this.logbookItemsPerPage));
    },
    get paginatedLogbooks() {
      const start = (this.logbookCurrentPage - 1) * this.logbookItemsPerPage;
      return this.filteredLogbooks.slice(start, start + this.logbookItemsPerPage);
    },
    async loadCourseFragment(section, courseId) {
      const config = this.sectionFragmentConfig[section];
      if (!config) return;
      const container = document.getElementById(config.container);
      if (!container) return;
      // Penahan tempat memakai skeleton yang tingginya mendekati isi akhirnya.
      // Sebelumnya hanya tulisan 'Loading...' setinggi ~120px, sementara isinya
      // ~1026px - selisih itulah yang terlihat sebagai halaman melompat.
      const skeleton = document.getElementById('learning-skeleton-source');
      container.innerHTML = skeleton ? skeleton.innerHTML : '';
      try {
        const res = await fetch(config.url + '?courseId=' + courseId);

        // Sesi berumur satu jam. Begitu kedaluwarsa, AuthMiddleware mengalihkan
        // permintaan fragment ke /login, dan fetch MENGIKUTI pengalihan itu
        // secara diam-diam. Tanpa penjagaan ini seluruh halaman login ikut
        // disuntikkan ke dalam panel, lengkap dengan navbar publiknya, sementara
        // shell di sekelilingnya masih tampak seperti sudah login.
        if (res.redirected) {
          window.location.href = res.url;
          return;
        }
        if (!res.ok) throw new Error('Request failed');

        const html = await res.text();
        // Tinggi wadah dikunci sepanjang pertukaran isi. Tanpa ini ada satu
        // frame ketika skeleton sudah dilepas tetapi isi barunya belum selesai
        // ditata, dan wadahnya sempat memendek - satu frame itu saja sudah
        // terhitung sebagai pergeseran tata letak.
        container.style.minHeight = container.offsetHeight + 'px';
        container.innerHTML = html;
        Alpine.initTree(container);
        requestAnimationFrame(() => { container.style.minHeight = ''; });
      } catch (e) {
        container.innerHTML = '<div class=\'p-12 text-center text-red-500\'>Failed to load. Please try again.</div>';
      }
    },
    async selectCourseSection(courseId, section) {
      this.activeCourseId = courseId;
      this.logbookCurrentPage = 1;
      this.toggleActiveSection(section);
    },
    async selectCourse(courseId) {
      this.openedCourses = this.openedCourses[courseId] ? {} : { [courseId]: true };
      await this.selectCourseSection(courseId, 'uiux');
    }
  }"
  x-init="if (sectionFragmentConfig[activeSection] && activeCourseId) { loadCourseFragment(activeSection, activeCourseId); }"
>
  {{!-- Application bar (Figma 830:9156). Markup ada di partial supaya halaman student
       standalone memakai bar yang sama; gating role admin/super_admin ada di dalamnya. --}}
  {{> user/app_bar/index user=user sidebarToggle=true }}

  <div class="relative z-10 max-w-full flex-1 min-h-0 flex flex-col mb-0">

    {{#unless (or (eq user.role 'admin') (eq user.role 'super_admin'))}}
    <!-- Mobile Horizontal Scroll Navigation -->
    <div class="lg:hidden shrink-0 mb-6 -mx-4 sm:mx-0 px-4 sm:px-0">
      <div class="overflow-x-auto no-scrollbar">
        <nav class="flex space-x-3 min-w-max sm:min-w-0 pb-4">

          <!-- Dashboard Button -->
          <button
            @click="toggleActiveSection('dashboard');"
            :class="activeSection === 'dashboard' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] bg-transparent'"
            class="h-12 px-4 py-2.5 gap-2.5 rounded-lg transition-all duration-200 flex items-center whitespace-nowrap text-sm font-medium font-montserrat leading-none"
          >
            <i class="fas fa-table-cells-large w-5 text-center"></i>
            <span>Dashboard</span>
          </button>

          <!-- Profile Button -->
          <button
            @click="toggleActiveSection('profile');"
            :class="(activeSection === 'profile' || activeSection === 'password') ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] bg-transparent'"
            class="h-12 px-4 py-2.5 gap-2.5 rounded-lg transition-all duration-200 flex items-center whitespace-nowrap text-sm font-medium font-montserrat leading-none"
          >
            <img src="/public/image/user_profile/profile.svg" alt="Profile" class="w-5 h-5 object-contain brightness-0">
            <span>Profile</span>
          </button>

          <!-- My Learning Button -->
          <button
            @click="toggleActiveSection('learning');"
            :class="activeSection === 'learning' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] bg-transparent'"
            class="h-12 px-4 py-2.5 gap-2.5 rounded-lg transition-all duration-200 flex items-center whitespace-nowrap text-sm font-medium font-montserrat leading-none"
          >
            <img src="/public/image/user_profile/myLearning.svg" alt="My Learning" class="w-5 h-5 object-contain brightness-0">
            <span>My Learning</span>
          </button>

          <!-- My Portfolio Button -->
          <button
            @click="toggleActiveSection('portfolio');"
            :class="activeSection === 'portfolio' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] bg-transparent'"
            class="h-12 px-4 py-2.5 gap-2.5 rounded-lg transition-all duration-200 flex items-center whitespace-nowrap text-sm font-medium font-montserrat leading-none"
          >
            <img src="/public/image/user_profile/myPortofolio.svg" alt="My Portfolio" class="w-5 h-5 object-contain brightness-0">
            <span>My Portfolio</span>
          </button>

          <!-- History Payment Button -->
          <button
            @click="toggleActiveSection('history-payment');"
            :class="activeSection === 'history-payment' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] bg-transparent'"
            class="h-12 px-4 py-2.5 gap-2.5 rounded-lg transition-all duration-200 flex items-center whitespace-nowrap text-sm font-medium font-montserrat leading-none"
          >
            <img src="/public/image/user_profile/historyPayment.svg" alt="History Payment" class="w-5 h-5 object-contain brightness-0">
            <span>Payment History</span>
          </button>

          <!-- Logout Button -->
          <a
            href='/logout'
            class="h-11 px-4 gap-2.5 rounded-lg transition-colors duration-150 flex items-center whitespace-nowrap text-sm font-medium font-montserrat leading-none text-white bg-[#C0392B] hover:bg-[#a5311f] cursor-pointer"
          >
            <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i>
            <span>Log Out</span>
          </a>

        </nav>
      </div>

      {{!-- Pohon course dihapus: frame desain hanya menampilkan lima item datar
           di sidebar. Titik masuk per-course kini ada di kartu program pada
           kolom kanan Start Learning. Lihat docs/user-area-submenu-removal-plan.md. --}}

    </div>
    {{/unless}}

    <!-- Flex Main Layout (Flex-1 Full Height to Footer) -->
    <div class="flex flex-col lg:flex-row items-stretch w-full flex-1 min-h-0">

      {{#unless (or (eq user.role 'admin') (eq user.role 'super_admin'))}}
      <!-- Desktop Sidebar Navigation: the outer box self-stretches to match the taller
           content column (so the white background + border never "cuts off" early). Nav
           is its own scrolling region within that box. Log Out is a genuinely
           separate `fixed` element pinned to the viewport bottom - not flex-distributed
           with nav - so it never moves regardless of how tall the nav content gets. -->
      <div class="js-user-sidebar hidden lg:flex flex-shrink-0 self-stretch bg-white border-r border-[#D9D9D9] transition-[width] duration-300 mb-0">
        <nav class="js-user-sidebar-nav w-full h-full overflow-y-auto space-y-2.5 pb-24">

          <!-- 1. Dashboard Button - flat per Figma 830:9186: active = #E4F1F7 bg + #003060 text,
               inactive = transparent + #718096, no border/shadow/blur anywhere -->
          <button
            @click="toggleActiveSection('dashboard');"
            :class="[
              activeSection === 'dashboard' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'
            ]"
            aria-label="{{t 'test.userSidebar.dashboard'}}" title="{{t 'test.userSidebar.dashboard'}}" class="js-user-sidebar-item rounded-lg text-left transition-colors duration-150 flex items-center font-montserrat font-medium text-sm leading-none cursor-pointer group"
          >
            <div class="w-5 flex justify-center items-center flex-shrink-0">
              <i class="fas fa-table-cells-large text-base"></i>
            </div>
            <span class="js-user-sidebar-label whitespace-nowrap">Dashboard</span>
          </button>

          <!-- 2. Profile Button -->
          <button
            @click="toggleActiveSection('profile');"
            :class="[
              (activeSection === 'profile' || activeSection === 'password') ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'
            ]"
            aria-label="{{t 'test.userSidebar.profile'}}" title="{{t 'test.userSidebar.profile'}}" class="js-user-sidebar-item rounded-lg text-left transition-colors duration-150 flex items-center font-montserrat font-medium text-sm leading-none cursor-pointer group"
          >
            <div class="w-5 flex justify-center items-center flex-shrink-0">
              <span class="block size-5" :class="(activeSection === 'profile' || activeSection === 'password') ? 'bg-[#003060]' : 'bg-[#718096]'" style="-webkit-mask:url('/public/image/user_profile/profile.svg') center/contain no-repeat;mask:url('/public/image/user_profile/profile.svg') center/contain no-repeat;"></span>
            </div>
            <span class="js-user-sidebar-label whitespace-nowrap">Profile</span>
          </button>

          <!-- 3. My Learning Accordion Button -->
          <div class="space-y-2">
            <button
              @click="toggleActiveSection('learning');"
              :class="[
                activeSection === 'learning' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'
              ]"
              aria-label="{{t 'test.userSidebar.myLearning'}}" title="{{t 'test.userSidebar.myLearning'}}" class="js-user-sidebar-item rounded-lg text-left transition-colors duration-150 flex items-center font-montserrat font-medium text-sm leading-none cursor-pointer"
            >
              <div class="flex items-center gap-3">
                <div class="w-5 flex justify-center items-center flex-shrink-0">
                  <span class="block size-5" :class="activeSection === 'learning' ? 'bg-[#003060]' : 'bg-[#718096]'" style="-webkit-mask:url('/public/image/user_profile/myLearning.svg') center/contain no-repeat;mask:url('/public/image/user_profile/myLearning.svg') center/contain no-repeat;"></span>
                </div>
                <span class="js-user-sidebar-label whitespace-nowrap">My Learning</span>
              </div>
            </button>

            {{!-- Pohon course dihapus, lihat catatan pada navigasi mobile di atas. --}}

          </div>

          <!-- 4. My Portfolio Button -->
          <button
            @click="toggleActiveSection('portfolio');"
            :class="[
              activeSection === 'portfolio' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'
            ]"
            aria-label="{{t 'test.userSidebar.myPortfolio'}}" title="{{t 'test.userSidebar.myPortfolio'}}" class="js-user-sidebar-item rounded-lg text-left transition-colors duration-150 flex items-center font-montserrat font-medium text-sm leading-none cursor-pointer"
          >
            <div class="w-5 flex justify-center items-center flex-shrink-0">
              <span class="block size-5" :class="activeSection === 'portfolio' ? 'bg-[#003060]' : 'bg-[#718096]'" style="-webkit-mask:url('/public/image/user_profile/myPortofolio.svg') center/contain no-repeat;mask:url('/public/image/user_profile/myPortofolio.svg') center/contain no-repeat;"></span>
            </div>
            <span class="js-user-sidebar-label whitespace-nowrap">My Portfolio</span>
          </button>

          <!-- 5. History Payment Button -->
          <button
            @click="toggleActiveSection('history-payment');"
            :class="[
              activeSection === 'history-payment' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'
            ]"
            aria-label="{{t 'test.userSidebar.paymentHistory'}}" title="{{t 'test.userSidebar.paymentHistory'}}" class="js-user-sidebar-item rounded-lg text-left transition-colors duration-150 flex items-center font-montserrat font-medium text-sm leading-none cursor-pointer"
          >
            <div class="w-5 flex justify-center items-center flex-shrink-0">
              <span class="block size-5" :class="activeSection === 'history-payment' ? 'bg-[#003060]' : 'bg-[#718096]'" style="-webkit-mask:url('/public/image/user_profile/historyPayment.svg') center/contain no-repeat;mask:url('/public/image/user_profile/historyPayment.svg') center/contain no-repeat;"></span>
            </div>
            <span class="js-user-sidebar-label whitespace-nowrap">Payment History</span>
          </button>

        </nav>
      </div>

      <!-- Log Out: genuinely `fixed` to the viewport bottom-left - a completely separate
           element from the scrolling <nav> above, so it can never be pushed around by
           however many menu items end up in the sidebar. -->
      <div
        class="js-user-sidebar-logout hidden lg:flex flex-shrink-0 fixed bottom-0 left-0 z-30 bg-white border-r border-t border-[#D9D9D9] transition-[width] duration-300"

      >
        {{!-- Warna Log Out ikut keadaan sidebar lewat CSS, bukan :class, dengan
             alasan yang sama seperti item lain: Alpine baru berjalan setelah
             halaman tergambar. --}}
        <a
          href='/logout'
          class="js-user-sidebar-item js-user-sidebar-logout-link rounded-lg transition-colors duration-150 flex items-center font-montserrat font-medium leading-none cursor-pointer"
        >
          <div class="w-5 flex justify-center items-center flex-shrink-0">
            <i class="fa-solid fa-arrow-right-from-bracket text-base"></i>
          </div>
          <span class="js-user-sidebar-label whitespace-nowrap text-sm">Log Out</span>
        </a>
      </div>
      {{/unless}}

      <!-- Right Content Section -->
      <div class="flex-1 w-full min-w-0 min-h-0 overflow-y-auto">

        {{!--
          Remah dan tombol kembali untuk panel di dalam shell.

          Halaman berdiri sendiri mendapatkannya dari shell_frame; panel di sini
          bukan halaman tersendiri, jadi barisnya dirakit dari `activeSection`.
          Tombol kembali hanya muncul untuk panel yang memang berada DI DALAM
          sebuah program (Start Learning dan turunannya) - pada tab tingkat atas
          tidak ada tempat untuk kembali, jadi tombolnya tidak dirender.
        --}}
        <div
          class="px-4 pt-6 sm:px-[34px]"
          x-data="{
            labels: {
              dashboard: '{{t 'test.userSidebar.dashboard'}}',
              profile: '{{t 'test.userSidebar.profile'}}',
              password: '{{t 'test.profile.changePassword'}}',
              learning: '{{t 'test.userSidebar.myLearning'}}',
              portfolio: '{{t 'test.userSidebar.myPortfolio'}}',
              'history-payment': '{{t 'test.userSidebar.paymentHistory'}}',
              uiux: '{{t 'test.startLearning.startLearning'}}',
              assignment: '{{t 'test.startLearning.assignment'}}',
              presentation: '{{t 'test.startLearning.presentation'}}',
              quiz: '{{t 'test.startLearning.quiz'}}',
              logbook: '{{t 'test.startLearning.myLogbook'}}',
              certificate: '{{t 'test.startLearning.certificate'}}',
              'group-class': '{{t 'test.startLearning.joinGroup'}}'
            },
            nested: ['uiux','assignment','presentation','quiz','logbook','certificate','group-class'],
            get isNested() { return this.nested.includes(this.activeSection); },
            get label() { return this.labels[this.activeSection] || this.labels.dashboard; }
          }"
        >
          {{!-- min-h-9 menyamai tinggi tombol kembali. Tanpa ini, barisnya
               tumbuh 16px begitu tombolnya muncul, dan seluruh isi halaman
               ikut terdorong turun - itulah lompatan yang tersisa setelah
               skeleton dipasang. --}}
          <div class="flex min-h-9 flex-wrap items-center gap-x-3 gap-y-2">
            <button
              type="button"
              x-show="isNested"
              {{!-- Keadaan awal ditentukan server supaya tombolnya tidak
                   berkedip muncul sesudah halaman tampil. --}}
              {{#unless (or (eq initialSection 'uiux') (eq initialSection 'assignment') (eq initialSection 'presentation') (eq initialSection 'quiz') (eq initialSection 'logbook') (eq initialSection 'certificate') (eq initialSection 'group-class'))}}style="display:none"{{/unless}}
              @click="toggleActiveSection('learning')"
              class="inline-flex h-9 shrink-0 cursor-pointer items-center gap-2 rounded-[8px] border border-[#D4D4D4] bg-white px-3.5 font-inter text-sm font-semibold text-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#F5F5F5]"
            >
              <i class="fa-solid fa-arrow-left text-xs"></i>
              {{t 'test.common.back'}}
            </button>

            <nav aria-label="{{t 'test.common.breadcrumb'}}" class="min-w-0">
              <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-inter text-sm text-[#737373]">
                <li>
                  <button type="button" @click="toggleActiveSection('dashboard')" class="cursor-pointer text-[#525252] transition-colors hover:text-[#003060] hover:underline">
                    {{t 'test.common.home'}}
                  </button>
                </li>
                <template x-if="isNested">
                  <li class="flex min-w-0 items-center gap-2">
                    <span aria-hidden="true" class="text-[#D4D4D4]">/</span>
                    <button type="button" @click="toggleActiveSection('learning')" class="cursor-pointer text-[#525252] transition-colors hover:text-[#003060] hover:underline">
                      {{t 'test.userSidebar.myLearning'}}
                    </button>
                  </li>
                </template>
                <li class="flex min-w-0 items-center gap-2">
                  <span aria-hidden="true" class="text-[#D4D4D4]">/</span>
                  <span aria-current="page" class="truncate font-semibold text-[#003060]" x-text="label"></span>
                </li>
              </ol>
            </nav>
          </div>
        </div>


        {{!--
          Kepala program beserta baris tab.

          Sebelumnya gambar, judul, dan tombol-tombol program berada DI DALAM
          panel Start Learning. Begitu student membuka Assignment atau Quiz,
          seluruh konteks programnya hilang dan tidak ada jalan pindah antar
          bagian selain kembali dulu. Sekarang keduanya berada di luar panel,
          jadi tetap terlihat di semua tab milik program.

          Datanya dari window.userCourses yang sudah ada di sisi klien, bukan
          dari controller - dengan begitu kedua rute yang merender shell
          (users/profile dan program/myProgram) sama-sama benar.

          Keadaan awal ditentukan server lewat `initialSection` supaya kepala
          ini tidak berkedip muncul sesudah halaman tampil.
        --}}
        <div
          x-show="isProgramSection"
          {{#unless (or (eq initialSection 'uiux') (eq initialSection 'presentation') (eq initialSection 'assignment') (eq initialSection 'quiz') (eq initialSection 'logbook') (eq initialSection 'certificate') (eq initialSection 'group-class') (eq initialSection 'quiz-start'))}}style="display:none"{{/unless}}
          class="px-4 pt-4 sm:px-8"
        >
          {{#if activeCourse}}
            <div class="overflow-hidden rounded-xl border border-[#E5E5E5] bg-white shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]">
              {{!-- Tinggi tetap: tanpa ini gambar yang baru selesai dimuat
                   mendorong seluruh halaman turun. --}}
              <div class="h-[160px] w-full overflow-hidden bg-[#EEF2F6] sm:h-[200px]">
                <img
                  src="{{activeCourse.image}}"
                  alt="{{activeCourse.name}}"
                  onerror="this.onerror=null;this.src='/public/image/dashboard/bgHeroSection.png'"
                  class="h-full w-full object-cover"
                />
              </div>

              <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-start sm:justify-between sm:p-6">
                <div class="min-w-0">
                  {{#if activeCourse.category.name}}
                    <span class="mb-2 inline-flex items-center rounded-[6px] bg-[#CFE6F5] px-2.5 py-1 font-inter text-xs font-medium leading-none text-[#003060]">{{activeCourse.category.name}}</span>
                  {{/if}}
                  <h1 class="font-montserrat text-xl font-bold leading-snug text-[#003060] sm:text-2xl">{{activeCourse.name}}</h1>
                  <p class="mt-1 line-clamp-2 font-inter text-sm text-[#737373]">{{getByLang activeCourse.description lang}}</p>
                </div>

                {{!-- Dua aksi ini bukan tab: yang satu pergi ke halaman lain,
                     yang satu dilakukan sekali - bukan tempat yang dihuni. --}}
                <div class="flex shrink-0 flex-wrap items-center gap-2">
                  <a
                    href="/program/program/detail/{{activeCourse.id}}"
                    class="inline-flex h-10 items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-4 font-inter text-sm font-semibold text-white no-underline transition-colors hover:bg-[#00254a]"
                  >
                    <i class="fa-regular fa-file-lines text-xs"></i>
                    {{t 'test.startLearning.detailProgram'}}
                  </a>
                  <button
                    type="button"
                    @click="toggleActiveSection('group-class')"
                    class="inline-flex h-10 cursor-pointer items-center justify-center gap-2 rounded-[8px] border border-[#003060] bg-white px-4 font-inter text-sm font-semibold text-[#003060] transition-colors hover:bg-[#E4F1F7]"
                  >
                    <i class="fa-solid fa-users text-xs"></i>
                    {{t 'test.startLearning.joinGroup'}}
                  </button>
                </div>
              </div>

              {{!-- Baris tab. Menempel di bawah app bar saat digulung supaya
                   berpindah tab tidak menuntut gulung balik ke atas, dan bisa
                   digeser mendatar di layar sempit. --}}
              <div class="sticky top-0 z-20 border-t border-[#E5E5E5] bg-white">
                <div class="overflow-x-auto no-scrollbar">
                  <nav class="flex min-w-max items-stretch gap-1 px-3" role="tablist" aria-label="{{t 'test.startLearning.programTabs'}}">
                    {{#each (array
                      (obj 'key' 'uiux' 'label' 'tabSessions' 'icon' 'fa-list-check')
                      (obj 'key' 'presentation' 'label' 'presentation' 'icon' 'fa-display')
                      (obj 'key' 'assignment' 'label' 'assignment' 'icon' 'fa-file-pen')
                      (obj 'key' 'quiz' 'label' 'quiz' 'icon' 'fa-circle-question')
                      (obj 'key' 'logbook' 'label' 'myLogbook' 'icon' 'fa-clipboard')
                      (obj 'key' 'certificate' 'label' 'certificate' 'icon' 'fa-award')
                    )}}
                      <button
                        type="button"
                        role="tab"
                        :aria-selected="activeSection === '{{this.key}}' ? 'true' : 'false'"
                        @click="toggleActiveSection('{{this.key}}')"
                        class="relative flex cursor-pointer items-center gap-2 whitespace-nowrap px-3 py-3.5 font-inter text-sm font-semibold transition-colors"
                        :class="activeSection === '{{this.key}}' ? 'text-[#003060]' : 'text-[#718096] hover:text-[#003060]'"
                      >
                        <i class="fa-solid {{this.icon}} text-xs"></i>
                        {{t (concat 'test.startLearning.' this.label)}}
                        <span
                          x-show="activeSection === '{{this.key}}'"
                          class="absolute inset-x-2 bottom-0 h-0.5 rounded-t bg-[#003060]"
                        ></span>
                      </button>
                    {{/each}}
                  </nav>
                </div>
              </div>
            </div>
          {{/if}}
        </div>

        <!-- Dashboard Tab Content -->
        <div x-show="activeSection === 'dashboard'"{{#unless (eq initialSection 'dashboard')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/dashboard/index }}
        </div>

        <!-- Profile Tab Content -->
        <div x-show="activeSection === 'profile'"{{#unless (eq initialSection 'profile')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/profile/index }}
        </div>

        <!-- Change Password Tab Content -->
        <div x-show="activeSection === 'password'"{{#unless (eq initialSection 'password')}} style="display:none"{{/unless}}>
          {{> components/ui/profile/change_password/index user=user isTab=true }}
        </div>

        <!-- My Learning Tab Content -->
        <div x-show="activeSection === 'learning'"{{#unless (eq initialSection 'learning')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/my_learning/index }}
        </div>

        <!-- Start Learning Tab Content -->
        {{!-- Sengaja kosong: isinya SELALU dimuat lewat loadCourseFragment.
             Panel ini butuh `minggu`, `user_kelas`, dan `portfolio` yang hanya
             disiapkan controller fragment; merendernya di server dari sini akan
             selalu menghasilkan keadaan kosong karena data itu tidak ada di
             sini. Lihat docs/user-area-learning-consolidation-plan.md tahap 3. --}}
        <template id="learning-skeleton-source">
          {{> components/ui/learning/skeleton/index }}
        </template>
        <div x-show="activeSection === 'uiux'" id="start-learning-container"{{#unless (eq initialSection 'uiux')}} style="display:none"{{/unless}}>
          {{> components/ui/learning/skeleton/index }}
        </div>

        <!-- My Portfolio Tab Content -->
        <div x-show="activeSection === 'portfolio'"{{#unless (eq initialSection 'portfolio')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/my_portofolio/index }}
        </div>

        <!-- History Payment Tab Content -->
        <div x-show="activeSection === 'history-payment'"{{#unless (eq initialSection 'history-payment')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/history_payment/index }}
        </div>

        <!-- Assignment Tab Content (loaded per course via loadCourseFragment) -->
        <div x-show="activeSection === 'assignment'" id="assignment-container"{{#unless (eq initialSection 'assignment')}} style="display:none"{{/unless}}>
          {{> components/ui/learning/skeleton/index }}
        </div>

        <!-- Logbook Tab Content -->
        <div x-show="activeSection === 'logbook'"{{#unless (eq initialSection 'logbook')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/logbook/index }}
        </div>

        <!-- Quiz Tab Content (loaded per course via loadCourseFragment) -->
        <div x-show="activeSection === 'quiz'" id="quiz-container"{{#unless (eq initialSection 'quiz')}} style="display:none"{{/unless}}>
          {{> components/ui/learning/skeleton/index }}
        </div>

        <!-- Quiz Start Tab Content (direct quiz-taking page from /quiz/start/:quizId) -->
        <div x-show="activeSection === 'quiz-start'"{{#unless (eq initialSection 'quiz-start')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/my_learning/start_learning/quiz/week/start/index }}
        </div>

        <!-- Join Group Class Tab Content -->
        <div x-show="activeSection === 'group-class'"{{#unless (eq initialSection 'group-class')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/my_learning/start_learning/join_group/index course=activeCourse }}
        </div>

        <!-- Presentation Tab Content (loaded per course via loadCourseFragment) -->
        <div x-show="activeSection === 'presentation'" id="presentation-container"{{#unless (eq initialSection 'presentation')}} style="display:none"{{/unless}}>
          {{> components/ui/learning/skeleton/index }}
        </div>

        <!-- Certificate Tab Content -->
        <div x-show="activeSection === 'certificate'" class="bg-white p-8 sm:p-12 rounded-[16px] border border-[#E5E5E5] text-center space-y-4 m-5 shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition">
          <div class="w-16 h-16 bg-[#003060]/10 rounded-full flex items-center justify-center mx-auto text-[#003060]">
            <i class="fas fa-award text-2xl"></i>
          </div>
          {{!-- Judul dihapus: label tab sudah menyebut bagian ini. --}}
          <template x-if="activeCourseId">
            <a :href="'/certificates/' + activeCourseId" target="_blank" class="inline-flex items-center justify-center px-6 py-3 bg-[#003060] text-white rounded-[6px] font-montserrat font-medium hover:bg-[#001F3F] transition-colors cursor-pointer">
              Download Certificate
            </a>
          </template>
          <template x-if="!activeCourseId">
            <p class="text-slate-600 font-medium max-w-sm mx-auto">Select a course to download its certificate.</p>
          </template>
        </div>

        <!-- Other Tabs Placeholder Content -->
        <div x-show="!handledSections.includes(activeSection)" class="bg-white p-8 sm:p-12 rounded-[16px] border border-[#E5E5E5] text-center space-y-4 m-5 shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition">
          <div class="w-16 h-16 bg-[#003060]/10 rounded-full flex items-center justify-center mx-auto text-[#003060]">
            <i class="fas fa-folder-open text-2xl"></i>
          </div>
          <h3 class="text-2xl font-bold text-[#003060] capitalize" x-text="activeSection.replace('-', ' ')"></h3>
          <p class="text-slate-600 font-medium max-w-sm mx-auto">
            This feature section is under development.
          </p>
        </div>

      </div>

    </div>

  </div>
</div>
{{/if}}
