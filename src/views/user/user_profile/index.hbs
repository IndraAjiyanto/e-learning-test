{{!-- Toast sukses (flash `toast`) untuk aksi yang redirect ke /users/profile:
     change password, update profile, dan update akun. Ditaruh di luar
     percabangan role supaya kedua varian halaman profil (admin & user)
     memakainya, dan di luar x-data lain sesuai kontrak komponen. --}}
{{> components/ui/super_admin/toast/success/index toast=toast }}

{{#if (or (eq user.role 'admin') (eq user.role 'super_admin'))}}
  {{> components/ui/profile/index 
    user=user 
  }}
{{else}}

{{!-- USER PROFILE INDEX VIEW --}}
<script>
  window.userLogbooks = {{{json logbooks}}};
  window.userCourses = {{{json userWithCourses.userCourses}}};
  window.portfolioCourseIds = {{{json portfolioCourseIds}}};
  window.certificateCourseIds = {{{json certificateCourseIds}}};
  window.hasBiodata = {{{json hasBiodata}}};
  window.certificateTemplates = {{{json certificateTemplates}}};
  // Kapabilitas per program, dihitung server (courses/program-type.ts). Sisi
  // klien TIDAK menghitung ulang aturannya - kalau ia ikut menghitung, aturan
  // yang sama hidup di dua tempat dan akan berbeda suatu hari.
  window.programCaps = {{{json programCaps}}};
  // Sakelar logbook dipasang pada <html> SEBELUM Alpine jalan: sessionUnlock
  // membacanya untuk memutuskan apakah logbook ikut mengunci sesi berikutnya,
  // dan keputusan itu sudah dipakai pada gambar pertama.
  (function () {
    var caps = {{{json caps}}};
    document.documentElement.dataset.logbookRequired =
      caps && caps.logbookEnabled === false ? 'false' : 'true';
  })();
</script>
<div 
  class="relative h-screen supports-[height:100dvh]:h-[100dvh] flex flex-col bg-[#F2F2F3] font-inter overflow-hidden"
  x-data="{
    lang: '{{lang}}',
    activeSection: (() => {
      const p = new URLSearchParams(window.location.search);
      const t = p.get('tab');
      if (t === 'portfolio' && p.get('courseId')) return 'course-portfolio';
      return t || '{{activeSection}}' || '{{#if (or (eq user.role "admin") (eq user.role "super_admin"))}}profile{{else}}dashboard{{/if}}';
    })(),
    openMyLearning: true,
    openRoblox: false,
    openedCourses: {},
    activeCourseId: {{#if activeCourse}}'{{activeCourse.id}}'{{else}}null{{/if}},
    userCourses: window.userCourses || [],
    portfolioCourseIds: window.portfolioCourseIds || [],
    certificateCourseIds: window.certificateCourseIds || [],
    hasBiodata: window.hasBiodata === true,
    certificateTemplates: window.certificateTemplates || {},
    allLogbooks: window.userLogbooks || [],
    logbookSearchInput: '',
    logbookCurrentPage: 1,
    logbookItemsPerPage: 10,
    logbookImageErrors: {},
    handledSections: [
      'dashboard', 'profile', 'password', 'learning', 'uiux', 'portfolio', 'course-portfolio', 'history-payment',
      'assignment', 'logbook', 'quiz', 'quiz-start', 'certificate',
      'group-class', 'presentation'
    ],
    sectionFragmentConfig: {
      uiux: { url: '/program/myProgram/{{user.id}}/fragment', container: 'start-learning-container' },
      assignment: { url: '/program/myProgram/{{user.id}}/fragment/assignment', container: 'assignment-container' },
      presentation: { url: '/program/myProgram/{{user.id}}/fragment/presentation', container: 'presentation-container' },
      quiz: { url: '/program/myProgram/{{user.id}}/fragment/quiz', container: 'quiz-container' },
      'course-portfolio': { url: '/portfolio/fragment', container: 'course-portfolio-container' }
    },
    toggleActiveSection(section, status) {
      // Student bisa sampai di ?tab=logbook lewat tautan lama atau riwayat
      // peramban, termasuk untuk program yang logbooknya dimatikan. Tanpa
      // penjagaan ini ia mendapat panel kosong tanpa penjelasan.
      if (section === 'logbook' && this.activeCaps.logbookEnabled === false) {
        section = 'uiux';
      }
      if (section === 'assignment' && !this.activeCaps.finalAssignment && this.activeCaps.structure !== 'weeks') {
        section = 'uiux';
      }
      this.activeSection = section;
      if (section === 'learning' && status) {
        const url = new URL(window.location);
        if (status !== 'all') url.searchParams.set('status', status);
        else url.searchParams.delete('status');
        history.replaceState({}, '', url);
      }
      if (section === 'certificate' && this.activeCourseId) {
        const url = new URL(window.location);
        url.searchParams.set('tab', 'certificate');
        url.searchParams.set('courseId', this.activeCourseId);
        history.replaceState({}, '', url);
      }
      window.dispatchEvent(new CustomEvent('section-changed', { detail: { section } }));
      if (this.sectionFragmentConfig[section]) {
        const courseId = this.activeCourseId || (this.userCourses[0] && this.userCourses[0].course && this.userCourses[0].course.id);
        if (courseId) {
          this.activeCourseId = courseId;
          this.loadCourseFragment(section, courseId);
        }
      }
    },

    goToLearningSection(section, status = 'all') {
      const url = new URL(window.location.href);
      url.searchParams.set('tab', section);
      if (status && status !== 'all') {
        url.searchParams.set('status', status);
      } else {
        url.searchParams.delete('status');
      }
      window.location.href = url.toString();
    },
    {{!-- Bagian yang memang milik sebuah program. Kepala program dan baris tab
         hanya muncul untuk section ini; Dashboard, Profile, My Portfolio, dan
         Payment History tidak boleh kebagian gambar program. --}}
    programSections: ['uiux', 'presentation', 'assignment', 'quiz', 'course-portfolio', 'logbook', 'certificate', 'group-class', 'quiz-start'],
    get isProgramSection() {
      return this.programSections.includes(this.activeSection);
    },

    {{!-- Course yang sedang dibuka, diambil dari data yang SUDAH ada di sisi
         klien (window.userCourses). Dengan begitu kepala program ikut benar di
         kedua rute yang merender shell, tanpa menyentuh controller. --}}
    get activeCourseData() {
      const found = this.userCourses.find((uc) => uc.course && uc.course.id === this.activeCourseId);
      if (found) return found.course;
      return this.userCourses[0] ? this.userCourses[0].course : null;
    },
    byLang(obj) {
      if (!obj || typeof obj !== 'object') return '';
      return obj[this.lang] || obj.id || obj.en || '';
    },

    get activeCourseName() {
      const found = this.userCourses.find((uc) => uc.course && uc.course.id === this.activeCourseId);
      return found ? found.course.name : 'My Program';
    },
    get hasActiveCoursePortfolio() {
      return this.portfolioCourseIds
        .map((courseId) => String(courseId))
        .includes(String(this.activeCourseId));
    },
    get hasActiveCourseCertificate() {
      return this.certificateCourseIds
        .map((courseId) => String(courseId))
        .includes(String(this.activeCourseId));
    },
    get hasCertificateRequirements() {
      return this.hasActiveCourseCertificate ||
        (this.hasActiveCoursePortfolio && this.hasBiodata);
    },
    get activeCertificateTemplate() {
      return this.certificateTemplates[this.activeCourseId] || 'bootcamp.html';
    },
    get filteredLogbooks() {
      if (!this.activeCourseId) return [];
      const search = this.logbookSearchInput.trim().toLowerCase();
      return this.allLogbooks.filter((lb) => {
        const courseId = lb.session && lb.session.weeks && lb.session.weeks.course ? lb.session.weeks.course.id : null;
        if (courseId !== this.activeCourseId) return false;
        if (!search) return true;
        return (lb.activity || '').toLowerCase().includes(search) ||
          (lb.activityDetails || '').toLowerCase().includes(search) ||
          (lb.obstacles || '').toLowerCase().includes(search);
      });
    },
    get totalLogbookPages() {
      return Math.max(1, Math.ceil(this.filteredLogbooks.length / this.logbookItemsPerPage));
    },
    get paginatedLogbooks() {
      const start = (this.logbookCurrentPage - 1) * this.logbookItemsPerPage;
      return this.filteredLogbooks.slice(start, start + this.logbookItemsPerPage);
    },
    async loadCourseFragment(section, courseId) {
      const config = this.sectionFragmentConfig[section];
      if (!config) return;
      const container = document.getElementById(config.container);
      if (!container) return;
      // Penahan tempat memakai skeleton yang tingginya mendekati isi akhirnya.
      // Sebelumnya hanya tulisan 'Loading...' setinggi ~120px, sementara isinya
      // ~1026px - selisih itulah yang terlihat sebagai halaman melompat.
      const skeleton = document.getElementById('learning-skeleton-source');
      container.innerHTML = skeleton ? skeleton.innerHTML : '';
      try {
        const res = await fetch(config.url + '?courseId=' + courseId);

        // Sesi berumur satu jam. Begitu kedaluwarsa, AuthMiddleware mengalihkan
        // permintaan fragment ke /login, dan fetch MENGIKUTI pengalihan itu
        // secara diam-diam. Tanpa penjagaan ini seluruh halaman login ikut
        // disuntikkan ke dalam panel, lengkap dengan navbar publiknya, sementara
        // shell di sekelilingnya masih tampak seperti sudah login.
        if (res.redirected) {
          window.location.href = res.url;
          return;
        }
        if (!res.ok) throw new Error('Request failed');

        const html = await res.text();
        // Tinggi wadah dikunci sepanjang pertukaran isi. Tanpa ini ada satu
        // frame ketika skeleton sudah dilepas tetapi isi barunya belum selesai
        // ditata, dan wadahnya sempat memendek - satu frame itu saja sudah
        // terhitung sebagai pergeseran tata letak.
        container.style.minHeight = container.offsetHeight + 'px';
        container.innerHTML = html;
        Alpine.initTree(container);
        requestAnimationFrame(() => { container.style.minHeight = ''; });
      } catch (e) {
        container.innerHTML = '<div class=\'p-12 text-center text-red-500\'>Failed to load. Please try again.</div>';
      }
    },
    {{!-- Program berikutnya bisa punya sakelar logbook yang berbeda, dan
         berpindah program tidak memuat ulang halaman. --}}
    syncProgramCaps() {
      const caps = (window.programCaps || {})[this.activeCourseId];
      document.documentElement.dataset.logbookRequired =
        caps && caps.logbookEnabled === false ? 'false' : 'true';
    },
    get activeCaps() {
      return (window.programCaps || {})[this.activeCourseId] || {};
    },
    async selectCourseSection(courseId, section) {
      this.activeCourseId = courseId;
      this.logbookCurrentPage = 1;
      this.syncProgramCaps();
      this.toggleActiveSection(section);
    },
    async selectCourse(courseId) {
      this.openedCourses = this.openedCourses[courseId] ? {} : { [courseId]: true };
      await this.selectCourseSection(courseId, 'uiux');
    }
  }"
  x-init="
    if (activeSection === 'logbook' && activeCaps.logbookEnabled === false) { activeSection = 'uiux'; }
    if (activeSection === 'assignment' && !activeCaps.finalAssignment && activeCaps.structure !== 'weeks') { activeSection = 'uiux'; }
    if (sectionFragmentConfig[activeSection] && activeCourseId) { loadCourseFragment(activeSection, activeCourseId); }
  "
>
  {{!-- Application bar. Markup ada di partial supaya halaman student
       standalone memakai bar yang sama; gating role admin/super_admin ada di dalamnya. --}}
  {{!-- Navigasi mobile kini berupa drawer hamburger di dalam app bar
       (lihat partial user/app_bar/index, prop `mobileNav='tabs'`); strip pil
       horizontal scroll sebelumnya sudah dihapus. --}}
  {{> user/app_bar/index user=user sidebarToggle=true mobileNav='tabs' }}

  <div class="relative max-w-full flex-1 min-h-0 flex flex-col mb-0">

    <!-- Flex Main Layout (Flex-1 Full Height to Footer) -->
    <div class="flex flex-col lg:flex-row items-stretch w-full flex-1 min-h-0">

      {{#unless (or (eq user.role 'admin') (eq user.role 'super_admin'))}}
      <!-- Desktop Sidebar Navigation: the outer box self-stretches to match the taller
           content column (so the white background + border never "cuts off" early). Nav
           is its own scrolling region within that box. Log Out is a genuinely
           separate `fixed` element pinned to the viewport bottom - not flex-distributed
           with nav - so it never moves regardless of how tall the nav content gets. -->
      <div class="js-user-sidebar hidden lg:flex flex-shrink-0 self-stretch bg-white border-r border-[#D9D9D9] transition-[width] duration-300 mb-0">
        <nav class="js-user-sidebar-nav w-full h-full overflow-y-auto space-y-2.5 pb-24">

          <!-- 1. Dashboard Button - flat: active = #E4F1F7 bg + #003060 text,
               inactive = transparent + #718096, no border/shadow/blur anywhere -->
          <button
            @click="toggleActiveSection('dashboard');"
            :class="[
              activeSection === 'dashboard' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'
            ]"
            aria-label="{{t 'test.userSidebar.dashboard'}}" title="{{t 'test.userSidebar.dashboard'}}" class="js-user-sidebar-item rounded-lg text-left transition-colors duration-150 flex items-center font-inter font-medium text-sm leading-none cursor-pointer group"
          >
            <div class="w-5 flex justify-center items-center flex-shrink-0">
              <i class="fas fa-table-cells-large text-base"></i>
            </div>
            <span class="js-user-sidebar-label whitespace-nowrap">Dashboard</span>
          </button>

          <!-- 2. Profile Button -->
          <button
            @click="toggleActiveSection('profile');"
            :class="[
              (activeSection === 'profile' || activeSection === 'password') ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'
            ]"
            aria-label="{{t 'test.userSidebar.profile'}}" title="{{t 'test.userSidebar.profile'}}" class="js-user-sidebar-item rounded-lg text-left transition-colors duration-150 flex items-center font-inter font-medium text-sm leading-none cursor-pointer group"
          >
            <div class="w-5 flex justify-center items-center flex-shrink-0">
              <span class="block size-5" :class="(activeSection === 'profile' || activeSection === 'password') ? 'bg-[#003060]' : 'bg-[#718096]'" style="-webkit-mask:url('/public/image/user_profile/profile.svg') center/contain no-repeat;mask:url('/public/image/user_profile/profile.svg') center/contain no-repeat;"></span>
            </div>
            <span class="js-user-sidebar-label whitespace-nowrap">{{t 'test.userSidebar.profile'}}</span>
          </button>

          <!-- 3. My Learning Accordion Button -->
          <div class="space-y-2">
            <button
              @click="toggleActiveSection('learning');"
              :class="[
                activeSection === 'learning' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'
              ]"
              aria-label="{{t 'test.userSidebar.myLearning'}}" title="{{t 'test.userSidebar.myLearning'}}" class="js-user-sidebar-item rounded-lg text-left transition-colors duration-150 flex items-center font-inter font-medium text-sm leading-none cursor-pointer"
            >
              <div class="flex items-center gap-3">
                <div class="w-5 flex justify-center items-center flex-shrink-0">
                  <span class="block size-5" :class="activeSection === 'learning' ? 'bg-[#003060]' : 'bg-[#718096]'" style="-webkit-mask:url('/public/image/user_profile/myLearning.svg') center/contain no-repeat;mask:url('/public/image/user_profile/myLearning.svg') center/contain no-repeat;"></span>
                </div>
                <span class="js-user-sidebar-label whitespace-nowrap">My Learning</span>
              </div>
            </button>

            {{!-- Pohon course dihapus: frame desain hanya menampilkan lima item
                 datar di sidebar. Titik masuk per-course kini ada di kartu
                 program pada kolom kanan Start Learning.
                 Lihat docs/user-area-submenu-removal-plan.md. --}}

          </div>

          <!-- 4. My Portfolio Button -->
          <button
            @click="toggleActiveSection('portfolio');"
            :class="[
              activeSection === 'portfolio' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'
            ]"
            aria-label="{{t 'test.startLearning.portfolio'}}" title="{{t 'test.startLearning.portfolio'}}" class="js-user-sidebar-item rounded-lg text-left transition-colors duration-150 flex items-center font-inter font-medium text-sm leading-none cursor-pointer"
          >
            <div class="w-5 flex justify-center items-center flex-shrink-0">
              <span class="block size-5" :class="activeSection === 'portfolio' ? 'bg-[#003060]' : 'bg-[#718096]'" style="-webkit-mask:url('/public/image/user_profile/myPortofolio.svg') center/contain no-repeat;mask:url('/public/image/user_profile/myPortofolio.svg') center/contain no-repeat;"></span>
            </div>
            <span class="js-user-sidebar-label whitespace-nowrap">{{t 'test.startLearning.portfolio'}}</span>
          </button>

          <!-- 5. History Payment Button -->
          <button
            @click="toggleActiveSection('history-payment');"
            :class="[
              activeSection === 'history-payment' ? 'bg-[#E4F1F7] text-[#003060]' : 'text-[#718096] hover:bg-[#F4F7FC]'
            ]"
            aria-label="{{t 'test.userSidebar.paymentHistory'}}" title="{{t 'test.userSidebar.paymentHistory'}}" class="js-user-sidebar-item rounded-lg text-left transition-colors duration-150 flex items-center font-inter font-medium text-sm leading-none cursor-pointer"
          >
            <div class="w-5 flex justify-center items-center flex-shrink-0">
              <span class="block size-5" :class="activeSection === 'history-payment' ? 'bg-[#003060]' : 'bg-[#718096]'" style="-webkit-mask:url('/public/image/user_profile/historyPayment.svg') center/contain no-repeat;mask:url('/public/image/user_profile/historyPayment.svg') center/contain no-repeat;"></span>
            </div>
            <span class="js-user-sidebar-label whitespace-nowrap">Payment History</span>
          </button>

        </nav>
      </div>

      <!-- Log Out: genuinely `fixed` to the viewport bottom-left - a completely separate
           element from the scrolling <nav> above, so it can never be pushed around by
           however many menu items end up in the sidebar. -->
      <div
        class="js-user-sidebar-logout hidden lg:flex flex-shrink-0 fixed bottom-0 left-0 z-30 bg-white border-r border-t border-[#D9D9D9] transition-[width] duration-300"

      >
        {{!-- Warna Log Out ikut keadaan sidebar lewat CSS, bukan :class, dengan
             alasan yang sama seperti item lain: Alpine baru berjalan setelah
             halaman tergambar. --}}
        <button
          type="button"
          onclick="openLogoutModal()"
          class="js-user-sidebar-item js-user-sidebar-logout-link rounded-lg transition-colors duration-150 flex items-center font-montserrat font-semibold leading-5 cursor-pointer"
        >
          <div class="w-5 flex justify-center items-center flex-shrink-0">
            <i class="fa-solid fa-arrow-right-from-bracket text-[18px]"></i>
          </div>
          <span class="js-user-sidebar-label whitespace-nowrap text-sm">Log Out</span>
        </button>
      </div>
      {{/unless}}

      <!-- Right Content Section -->
      <div class="flex-1 w-full min-w-0 min-h-0 overflow-y-auto">

        {{!--
          Remah untuk panel di dalam shell.

          Halaman berdiri sendiri mendapatkannya dari shell_frame; panel di sini
          bukan halaman tersendiri, jadi barisnya dirakit dari `activeSection`.
        --}}
        <div
          class="px-4 pt-4 sm:px-8 sm:pt-6"
          x-data="{
            labels: {
              dashboard: '{{t 'test.userSidebar.dashboard'}}',
              profile: '{{t 'test.userSidebar.profile'}}',
              password: '{{t 'test.profile.changePassword'}}',
              learning: '{{t 'test.userSidebar.myLearning'}}',
              portfolio: '{{t 'test.startLearning.portfolio'}}',
              'course-portfolio': '{{t 'test.startLearning.portfolio'}}',
              'history-payment': '{{t 'test.userSidebar.paymentHistory'}}',
              uiux: '{{t 'test.startLearning.startLearning'}}',
              assignment: '{{t 'test.startLearning.finalAssignment'}}',
              {{!-- Label tabnya sudah jadi Attendance; remahnya ikut, kalau
                   tidak halaman yang sama punya dua nama. --}}
              presentation: '{{t 'test.startLearning.tabAttendance'}}',
              quiz: '{{t 'test.startLearning.quiz'}}',
              logbook: '{{t 'test.startLearning.myLogbook'}}',
              certificate: '{{t 'test.startLearning.certificate'}}',
              'group-class': '{{t 'test.startLearning.joinGroup'}}'
            },
            icons: {
              dashboard: 'ph ph-squares-four',
              profile: 'ph ph-user',
              password: 'ph ph-user',
              learning: 'ph ph-book-open',
              portfolio: 'ph ph-briefcase',
              'course-portfolio': 'ph ph-briefcase',
              'history-payment': 'ph ph-receipt',
              uiux: 'ph ph-play-circle',
              assignment: 'ph ph-clipboard-text',
              presentation: 'ph ph-presentation-chart',
              quiz: 'ph ph-question',
              logbook: 'ph ph-notebook',
              certificate: 'ph ph-certificate',
              'group-class': 'ph ph-users'
            },
            nested: ['uiux','assignment','course-portfolio','presentation','quiz','logbook','certificate','group-class'],
            get isNested() { return this.nested.includes(this.activeSection); },
            get label() { return this.labels[this.activeSection] || this.labels.dashboard; },
            get sectionIcon() { return this.icons[this.activeSection] || 'ph ph-squares-four'; }
          }"
        >
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <nav aria-label="{{t 'test.common.breadcrumb'}}" class="min-w-0">
              <template x-if="isNested">
                <ol class="flex flex-wrap items-center gap-2 font-inter text-xs text-[#718096]">
                  <li class="flex items-center gap-1.5">
                    <button type="button" @click="toggleActiveSection('dashboard')" class="inline-flex items-center gap-1.5 cursor-pointer font-medium text-[#718096] hover:text-[#003060] hover:underline">
                      <i class="ph ph-house text-xs text-[#718096]"></i>
                      <span>{{t 'test.common.home'}}</span>
                    </button>
                  </li>
                  <li class="flex items-center gap-2">
                    <span aria-hidden="true" class="text-[#718096]">/</span>
                    <button type="button" @click="toggleActiveSection('learning')" class="inline-flex items-center gap-1.5 cursor-pointer font-medium text-[#718096] hover:text-[#003060] hover:underline">
                      <i class="ph ph-book-open text-xs text-[#718096]"></i>
                      <span>{{t 'test.userSidebar.myLearning'}}</span>
                    </button>
                  </li>
                  <li class="flex items-center gap-2">
                    <span aria-hidden="true" class="text-[#718096]">/</span>
                    <span class="inline-flex items-center gap-1.5 font-semibold text-[#003060]">
                      <i :class="sectionIcon" class="text-xs text-[#003060]"></i>
                      <span aria-current="page" x-text="label"></span>
                    </span>
                  </li>
                </ol>
              </template>
              <template x-if="!isNested">
                <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-inter text-sm text-[#737373]">
                  <li class="flex items-center gap-1.5">
                    <button type="button" @click="toggleActiveSection('dashboard')" class="inline-flex items-center gap-1.5 cursor-pointer text-[#525252] transition-colors hover:text-[#003060] hover:underline">
                      <i class="ph ph-house text-sm text-[#737373]"></i>
                      <span>{{t 'test.common.home'}}</span>
                    </button>
                  </li>
                  <li class="flex min-w-0 items-center gap-2">
                    <span aria-hidden="true" class="text-[#D4D4D4]">/</span>
                    <span aria-current="page" class="inline-flex items-center gap-1.5 truncate font-semibold text-[#003060]">
                      <i :class="sectionIcon" class="text-sm text-[#003060]"></i>
                      <span x-text="label"></span>
                    </span>
                  </li>
                </ol>
              </template>
            </nav>
          </div>
        </div>

        <div
          x-show="isProgramSection"
          {{#unless (or (eq initialSection 'uiux') (eq initialSection 'presentation') (eq initialSection 'assignment') (eq initialSection 'quiz') (eq initialSection 'course-portfolio') (eq initialSection 'logbook') (eq initialSection 'certificate') (eq initialSection 'group-class') (eq initialSection 'quiz-start'))}}style="display:none"{{/unless}}
          class="px-4 pt-4 sm:px-8 sm:pt-6 max-w-[1334px] mx-auto w-full"
        >
          <!-- Page Header -->
          <div class="mb-5 flex flex-col gap-1">
            <h1 class="font-inter text-2xl sm:text-[34px] font-bold leading-tight sm:leading-[42px] text-[#003060]">
              {{t 'test.startLearning.startLearning'}}
            </h1>
            <p class="font-inter text-sm sm:text-[14px] font-normal leading-[20px] text-[#718096]">
              {{t 'test.startLearning.spanStartLearning'}}
            </p>
          </div>

          <!-- CARD -->
          <div class="flex flex-col gap-5 rounded-[32px] bg-white p-5 shadow-[0px_12px_32px_-4px_rgba(0,0,0,0.25)]">
            <!-- Banner: Japanese Internship -->
            <div class="relative h-[270px] w-full overflow-hidden rounded-[16px] bg-black/40">
              <img
                src="{{#if activeCourse.image}}{{activeCourse.image}}{{else}}/public/image/dashboard/bgHeroSection.png{{/if}}"
                alt="{{#if activeCourse.name}}{{activeCourse.name}}{{else}}Japanese Internship{{/if}}"
                onerror="this.onerror=null;this.src='/public/image/dashboard/bgHeroSection.png'"
                class="absolute inset-0 h-full w-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-tr from-[#FF6BCE]/30 via-transparent to-transparent"></div>
              <div class="absolute inset-0 bg-black/40"></div>


            </div>

            <!-- Tags Row -->
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center rounded-full border border-[#D0E1FD] bg-[#EEF2F6] px-4 py-1.5 font-inter text-xs font-semibold text-[#5B7EB1]">
                {{#if activeCourse.category.type}}{{activeCourse.category.type}}{{else if category.name}}{{category.type}}{{else}}Japanese Class{{/if}}
              </span>
              <span class="inline-flex items-center rounded-full bg-[#1E293B] px-4 py-1.5 font-inter text-xs font-semibold text-white">
                {{#if activeCourse.category.name}}{{activeCourse.category.name}}{{else if category.type}}{{category.name}}{{else}}Special Program{{/if}}
              </span>
            </div>

            <!-- Course Info -->
            <div class="flex flex-col gap-3">
              <h3 class="font-inter text-xl sm:text-[22px] font-bold leading-[28px] text-[#1E293B]">
                {{#if activeCourse.name}}{{activeCourse.name}}{{else}}Japanese Internship{{/if}}
              </h3>
              <p class="font-inter text-[13px] font-normal leading-[20px] text-[#64748B]">
                {{#if activeCourse.description}}{{getByLang activeCourse.description lang}}{{else}}Program magang intensif ke Jepang yang membekali peserta dengan keterampilan teknis, pemahaman budaya, serta etika kerja profesional berstandar internasional.{{/if}}
              </p>
            </div>
          </div>

          <!-- Tabs Navigation -->
          <div class="mt-5 flex flex-wrap items-center gap-3 rounded-[16px] border border-[#D9D9D9] bg-white p-3">
            <button
              type="button"
              role="tab"
              :aria-selected="activeSection === 'uiux' ? 'true' : 'false'"
              @click="toggleActiveSection('uiux')"
              class="rounded-full px-5 py-2 font-inter text-sm font-semibold transition-colors cursor-pointer"
              :class="activeSection === 'uiux' ? 'bg-[#1D2D5B] text-white shadow-sm' : 'text-[#718096] hover:text-[#1D2D5B] hover:bg-[#F8FAFC]'"
            >
              {{t 'test.startLearning.startLearning'}}
            </button>
            <button
              type="button"
              role="tab"
              x-show="activeCaps.finalAssignment || activeCaps.structure === 'weeks'"
              :aria-selected="activeSection === 'assignment' ? 'true' : 'false'"
              @click="toggleActiveSection('assignment')"
              class="rounded-full px-4 py-2 font-inter text-sm font-semibold transition-colors cursor-pointer"
              :class="activeSection === 'assignment' ? 'bg-[#1D2D5B] text-white shadow-sm' : 'text-[#718096] hover:text-[#1D2D5B] hover:bg-[#F8FAFC]'"
            >
              {{t 'test.startLearning.finalAssignment'}}
            </button>
            <button
              type="button"
              role="tab"
              :aria-selected="activeSection === 'course-portfolio' ? 'true' : 'false'"
              @click="toggleActiveSection('course-portfolio')"
              class="rounded-full px-4 py-2 font-inter text-sm font-semibold transition-colors cursor-pointer"
              :class="activeSection === 'course-portfolio' ? 'bg-[#1D2D5B] text-white shadow-sm' : 'text-[#718096] hover:text-[#1D2D5B] hover:bg-[#F8FAFC]'"
            >
              {{t 'test.startLearning.portfolio'}}
            </button>
            <button
              type="button"
              role="tab"
              x-show="activeCaps.logbookEnabled !== false && (activeCourseData?.programType ?? activeCourseData?.program_type) !== 'non_bootcamp'"
              @click="toggleActiveSection('logbook')"
              class="rounded-full px-4 py-2 font-inter text-sm font-semibold transition-colors cursor-pointer"
              :class="activeSection === 'logbook' ? 'bg-[#1D2D5B] text-white shadow-sm' : 'text-[#718096] hover:text-[#1D2D5B] hover:bg-[#F8FAFC]'"
            >
              {{t 'test.startLearning.myLogbook'}}
            </button>
            <button
              type="button"
              role="tab"
              @click="toggleActiveSection('group-class')"
              class="rounded-full px-4 py-2 font-inter text-sm font-semibold transition-colors cursor-pointer"
              :class="activeSection === 'group-class' ? 'bg-[#1D2D5B] text-white shadow-sm' : 'text-[#718096] hover:text-[#1D2D5B] hover:bg-[#F8FAFC]'"
            >
              {{t 'test.startLearning.joinGroup'}}
            </button>
            <button
              type="button"
              role="tab"
              :aria-selected="activeSection === 'certificate' ? 'true' : 'false'"
              @click="toggleActiveSection('certificate')"
              class="inline-flex items-center gap-2 rounded-full px-4 py-2 font-inter text-sm font-semibold transition-colors cursor-pointer"
              :class="activeSection === 'certificate' ? 'bg-[#1D2D5B] text-white shadow-sm' : 'text-[#718096] hover:text-[#1D2D5B] hover:bg-[#F8FAFC]'"
            >
              <i class="ph ph-certificate text-base"></i>
              {{t 'test.startLearning.certificate'}}
            </button>
          </div>
        </div>

        <!-- Dashboard Tab Content -->
        <div x-show="activeSection === 'dashboard'"{{#unless (eq initialSection 'dashboard')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/dashboard/index }}
        </div>

        <!-- Profile Tab Content -->
        <div x-show="activeSection === 'profile'"{{#unless (eq initialSection 'profile')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/profile/index }}
        </div>

        <!-- Change Password Tab Content -->
        <div x-show="activeSection === 'password'"{{#unless (eq initialSection 'password')}} style="display:none"{{/unless}}>
          {{> components/ui/profile/change_password/index user=user isTab=true }}
        </div>

        <!-- My Learning Tab Content -->
        <div x-show="activeSection === 'learning'"{{#unless (eq initialSection 'learning')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/my_learning/index }}
        </div>

        <!-- Start Learning Tab Content -->
        {{!-- Sengaja kosong: isinya SELALU dimuat lewat loadCourseFragment.
             Panel ini butuh `minggu`, `user_kelas`, dan `portfolio` yang hanya
             disiapkan controller fragment; merendernya di server dari sini akan
             selalu menghasilkan keadaan kosong karena data itu tidak ada di
             sini. Lihat docs/user-area-learning-consolidation-plan.md tahap 3. --}}
        <template id="learning-skeleton-source">
          {{> components/ui/learning/skeleton/index }}
        </template>
        <div x-show="activeSection === 'uiux'" id="start-learning-container" class="max-w-[1334px] mx-auto w-full"{{#unless (eq initialSection 'uiux')}} style="display:none"{{/unless}}>
          {{> components/ui/learning/skeleton/index }}
        </div>

        <!-- My Portfolio Tab Content (User Profile) -->
        <div x-show="activeSection === 'portfolio'"{{#unless (eq initialSection 'portfolio')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/profile_portfolio/index }}
        </div>

        <!-- Course Portfolio Tab Content (Start Learning level, loaded per course via loadCourseFragment) -->
        <div
          x-show="activeSection === 'course-portfolio'"
          id="course-portfolio-container"
          class="max-w-[1334px] mx-auto w-full"
          {{#unless (eq initialSection 'course-portfolio')}}style="display:none"{{/unless}}
        >
          {{> components/ui/learning/skeleton/index }}
        </div>

        <!-- History Payment Tab Content -->
        <div x-show="activeSection === 'history-payment'"{{#unless (eq initialSection 'history-payment')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/history_payment/index }}
        </div>

        <!-- Assignment Tab Content (loaded per course via loadCourseFragment) -->
        <div x-show="activeSection === 'assignment'" id="assignment-container"{{#unless (eq initialSection 'assignment')}} style="display:none"{{/unless}}>
          {{> components/ui/learning/skeleton/index }}
        </div>

        <!-- Logbook Tab Content -->
        <div x-show="activeSection === 'logbook'"{{#unless (eq initialSection 'logbook')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/logbook/index }}
        </div>

        <!-- Quiz Tab Content (loaded per course via loadCourseFragment) -->
        <div x-show="activeSection === 'quiz'" id="quiz-container"{{#unless (eq initialSection 'quiz')}} style="display:none"{{/unless}}>
          {{> components/ui/learning/skeleton/index }}
        </div>

        <!-- Quiz Start Tab Content (direct quiz-taking page from /quiz/start/:quizId) -->
        <div x-show="activeSection === 'quiz-start'"{{#unless (eq initialSection 'quiz-start')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/my_learning/start_learning/quiz/week/start/index }}
        </div>

        <!-- Join Group Class Tab Content -->
        <div x-show="activeSection === 'group-class'" class="max-w-[1334px] mx-auto w-full"{{#unless (eq initialSection 'group-class')}} style="display:none"{{/unless}}>
          {{> user/sidebar_user_profile/my_learning/start_learning/join_group/index course=activeCourse }}
        </div>

        <!-- Presentation Tab Content (loaded per course via loadCourseFragment) -->
        <div x-show="activeSection === 'presentation'" id="presentation-container"{{#unless (eq initialSection 'presentation')}} style="display:none"{{/unless}}>
          {{> components/ui/learning/skeleton/index }}
        </div>

        <!-- Certificate Tab Content -->
        <div x-show="activeSection === 'certificate'" class="max-w-[1334px] mx-auto w-full my-4 sm:my-6">
          <template x-if="!hasActiveCourseCertificate && !hasActiveCoursePortfolio">
            <div class="w-full overflow-hidden rounded-[24px] border border-[#E5E7EB] bg-white shadow-[0px_12px_32px_-12px_rgba(0,48,96,0.18)]">
              <div class="flex flex-col items-center px-5 py-12 text-center sm:px-8 sm:py-16">
                <span class="grid size-16 place-items-center rounded-full bg-[#FFF7E6] text-[#B7791F]">
                  <i class="ph ph-lock-key text-3xl"></i>
                </span>
                <p class="mt-5 font-inter text-xs font-bold uppercase tracking-[0.16em] text-[#8B6B1D]">{{t 'test.startLearning.certificate'}}</p>
                <h2 class="mt-2 font-inter text-2xl font-bold text-[#003060]">{{t 'test.startLearning.certificatePortfolioRequiredTitle'}}</h2>
                <p class="mx-auto mt-2 max-w-md font-inter text-sm leading-6 text-[#718096]">{{t 'test.startLearning.certificatePortfolioRequiredBody'}}</p>
                <button
                  type="button"
                  @click="toggleActiveSection('course-portfolio')"
                  class="mt-6 inline-flex h-11 items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-5 font-inter text-sm font-semibold text-white transition-colors hover:bg-[#00254A]"
                >
                  <i class="ph ph-briefcase text-base"></i>
                  {{t 'test.startLearning.portfolio'}}
                  <i class="ph ph-arrow-right text-base"></i>
                </button>
              </div>
            </div>
          </template>

          <template x-if="hasActiveCoursePortfolio && !hasBiodata">
            <div class="w-full overflow-hidden rounded-[24px] border border-[#E5E7EB] bg-white shadow-[0px_12px_32px_-12px_rgba(0,48,96,0.18)]">
              <div class="flex flex-col items-center px-5 py-12 text-center sm:px-8 sm:py-16">
                <span class="grid size-16 place-items-center rounded-full bg-[#FFF7E6] text-[#B7791F]">
                  <i class="ph ph-lock-key text-3xl"></i>
                </span>
                <p class="mt-5 font-inter text-xs font-bold uppercase tracking-[0.16em] text-[#8B6B1D]">{{t 'test.startLearning.certificate'}}</p>
                <h2 class="mt-2 font-inter text-2xl font-bold text-[#003060]">{{t 'test.startLearning.certificateBiodataRequiredTitle'}}</h2>
                <p class="mx-auto mt-2 max-w-md font-inter text-sm leading-6 text-[#718096]">{{t 'test.startLearning.certificateBiodataRequiredBody'}}</p>
                <button
                  type="button"
                  @click="toggleActiveSection('profile')"
                  class="mt-6 inline-flex h-11 items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-5 font-inter text-sm font-semibold text-white transition-colors hover:bg-[#00254A]"
                >
                  <i class="ph ph-user-circle text-base"></i>
                  {{t 'test.profile.personalInfo'}}
                  <i class="ph ph-arrow-right text-base"></i>
                </button>
              </div>
            </div>
          </template>

          <template x-if="hasCertificateRequirements">
          <div class="w-full overflow-hidden rounded-[24px] border border-[#D9E3EF] bg-white shadow-[0px_12px_32px_-12px_rgba(0,48,96,0.25)]">
            <div class="border-b border-[#E5EAF0] bg-[#F7FAFC] px-5 py-6 sm:px-8">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="font-inter text-xs font-bold uppercase tracking-[0.16em] text-[#6B86A5]">{{t 'test.startLearning.certificate'}}</p>
                  <h2 class="mt-1 font-inter text-2xl font-bold text-[#003060]">{{t 'test.startLearning.certificateReadyTitle'}}</h2>
                  <p class="mt-1 font-inter text-sm text-[#718096]" x-text="'{{t 'test.startLearning.certificateReadyBody'}}'.replace('%s', activeCourseName)"></p>
                </div>
                <span class="inline-flex w-fit items-center gap-2 rounded-full border border-[#B9E2C5] bg-[#F0FFF4] px-3 py-1.5 font-inter text-xs font-semibold text-[#287A3D]">
                  <i class="ph ph-seal-check text-base"></i>
                  {{t 'test.startLearning.certificate' }}
                </span>
              </div>
            </div>

            <div class="grid gap-6 p-5 sm:p-8">
              <div class="relative aspect-[1.414/1] overflow-hidden rounded-[12px] border border-[#D9E3EF] bg-[#E5E7EB] shadow-[0px_10px_24px_-12px_rgba(0,48,96,0.45)]">
                <iframe
                  :src="'/certificates/' + activeCourseId + '/preview'"
                  title="Certificate preview"
                  class="absolute inset-0 h-full w-full border-0"
                ></iframe>
              </div>

              <div class="rounded-[16px] border border-[#E5EAF0] bg-[#F8FAFC] p-5 sm:p-6 flex flex-col items-center text-center">
                <div class="mb-5 flex size-12 items-center justify-center rounded-[12px] bg-[#E4F1F7] text-[#003060]">
                  <i class="ph ph-download-simple text-2xl"></i>
                </div>
                <h3 class="font-inter text-lg font-bold text-[#003060]">{{t 'test.startLearning.downloadCertificate'}}</h3>
                <p class="mt-2 font-inter text-sm leading-6 text-[#718096] max-w-md" x-text="'{{t 'test.startLearning.certificateReadyBody'}}'.replace('%s', activeCourseName)"></p>
                <a
                  :href="'/certificates/' + activeCourseId + '/download'"
                  target="_blank"
                  rel="noopener"
                  class="mt-6 inline-flex h-11 items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-6 font-inter text-sm font-semibold text-white no-underline transition-colors hover:bg-[#00254A]"
                >
                  <i class="ph ph-download-simple text-base"></i>
                  {{t 'test.startLearning.downloadCertificate'}}
                </a>
                <p class="mt-3 text-center font-inter text-xs text-[#8A98A8]">PDF</p>
              </div>
            </div>
          </div>
          </template>
        </div>

        <!-- Other Tabs Placeholder Content -->
        <div x-show="!handledSections.includes(activeSection)" class="bg-white p-8 sm:p-12 rounded-[16px] border border-[#E5E5E5] text-center space-y-4 mx-4 my-4 sm:mx-8 sm:my-6 shadow-[0px_2px_8px_-2px_rgba(11,31,59,0.06)] hover:shadow-[0px_4px_12px_-2px_rgba(11,31,59,0.1)] transition">
          <div class="w-16 h-16 bg-[#003060]/10 rounded-full flex items-center justify-center mx-auto text-[#003060]">
            <i class="fas fa-folder-open text-2xl"></i>
          </div>
          <h3 class="text-2xl font-bold text-[#003060] capitalize" x-text="activeSection.replace('-', ' ')"></h3>
          <p class="text-slate-600 font-medium max-w-sm mx-auto">
            This feature section is under development.
          </p>
        </div>

      </div>

    </div>

  </div>
</div>
{{!-- `renderOverview` dipanggil dari Alpine (`x-html`) di panel detail
     portfolio. Panel itu dimuat lewat loadCourseFragment, jadi skrip yang
     menempel di dalam partial tidak akan dieksekusi - fungsinya harus sudah
     ada sebelum fragment masuk. --}}
<script src="/public/js/portfolio-overview.js"></script>
{{/if}}

