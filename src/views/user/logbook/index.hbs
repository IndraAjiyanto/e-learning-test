<div class='pt-24 min-h-screen bg-white' x-data='logbookApp()'>
  <div class='container mx-auto px-4 pb-16'>
    <!-- Header -->
    <div class='text-center mb-12'>
      <!-- Back Button -->
      <div class='mb-6'>
        <a
          href='/kelass/{{logbook.minggu.kelas.id}}'
          class='inline-flex items-center text-gray-600 text-base font-medium hover:underline'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            class='h-5 w-5 mr-1'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M15 19l-7-7 7-7'
            />
          </svg>
          Back to Class
        </a>
      </div>

      <h1
        class='text-4xl font-bold text-gray-900 mb-4 font-montserrat'
      >Logbook</h1>
      <p class='text-gray-600 max-w-2xl mx-auto text-lg font-inter'>
        Manage and monitor your logbook activities easily
      </p>
    </div>

    <!-- Filter & Actions -->
    <div class='bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6'>
      <div class='grid grid-cols-1 lg:grid-cols-2 gap-6'>
        <!-- Left: Search & Filters -->
        <div class='space-y-4'>
          <!-- Search -->
          <div class='relative'>
            <input
              type='text'
              placeholder='Search activities, details, or issues...'
              x-model='searchInput'
              @input='debounceSearch()'
              class='w-full border border-gray-300 bg-white text-gray-900 rounded-lg px-4 py-3 pl-11 focus:outline-none focus:ring-2 focus:ring-slate-600 focus:border-transparent transition-all'
            />
            <i
              class='fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400'
            ></i>
          </div>

          <!-- Filters Row -->
          <div class='flex flex-wrap gap-3'>
            <!-- Reset Button -->
            <button
              @click='resetFilters()'
              class='bg-gray-100 hover:bg-gray-200 text-gray-700 px-5 py-2.5 rounded-lg transition-all flex items-center gap-2 border border-gray-300'
            >
              <i class='fas fa-undo-alt text-sm'></i>
              <span class='font-medium'>Reset</span>
            </button>
          </div>
        </div>

        <!-- Right: Export Button -->
        <div class='flex items-end justify-end'>
          <button
            @click='exportToExcel()'
            class='bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white px-6 py-3 rounded-lg flex items-center gap-2 transition-all shadow-md hover:shadow-lg transform hover:-translate-y-0.5'
          >
            <i class='fas fa-file-excel text-lg'></i>
            <span class='font-semibold'>Export Excel</span>
          </button>
        </div>
      </div>

      <!-- Active Filters Info -->
      <div
        x-show='hasActiveFilters()'
        class='mt-4 pt-4 border-t border-gray-200'
        x-transition:enter='transition ease-out duration-200'
        x-transition:enter-start='opacity-0 -translate-y-2'
        x-transition:enter-end='opacity-100 translate-y-0'
      >
        <div class='flex flex-wrap items-center gap-2 text-sm'>
          <div class='flex items-center gap-2 text-gray-600 font-semibold'>
            <i class='fas fa-filter'></i>
            <span>Active filters:</span>
          </div>
          <span
            x-show='search'
            class='px-3 py-1.5 bg-slate-100 border border-slate-300 rounded-full text-slate-700 font-medium flex items-center gap-1'
          >
            <i class='fas fa-search text-xs'></i>
            <span x-text='search'></span>
          </span>
        </div>
      </div>
    </div>

    <!-- Loading Skeleton -->
    <div
      x-show='false'
      class='bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden'
    >
      <div class='overflow-x-auto'>
        <table class='min-w-full divide-y divide-gray-200'>
          <thead class='bg-gray-100'>
            <tr>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
              >No</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
              >Activity</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
              >Details</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
              >Issues</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
              >Documentation</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
              >Kelas</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
              >Status</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
              >Tanggal</th>
              <th
                class='px-6 py-3 text-left text-sm font-semibold text-gray-700'
              >Action</th>
            </tr>
          </thead>
          <tbody class='divide-y divide-gray-200'>
            <template x-for='i in itemsPerPage' :key='i'>
              <tr class='animate-pulse'>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-8'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-32'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-48'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-32'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='w-16 h-16 bg-gray-200 rounded'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-24'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-6 bg-gray-200 rounded w-20'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-28'
                  ></div></td>
                <td class='px-6 py-4'><div
                    class='h-4 bg-gray-200 rounded w-16'
                  ></div></td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Data Table -->
    <div
      x-show='true'
      class='bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden'
    >

      <div class='overflow-x-auto'>
        <table class='min-w-full divide-y divide-gray-200'>
          <thead class='bg-gradient-to-r from-slate-50 to-slate-100'>
            <tr>
              <th
                class='px-3 py-2 text-left text-xs font-bold text-slate-700 uppercase tracking-wider'
              >No</th>
              <th
                class='px-3 py-2 text-left text-xs font-bold text-slate-700 uppercase tracking-wider'
              >Activity</th>
              <th
                class='px-3 py-2 text-left text-xs font-bold text-slate-700 uppercase tracking-wider'
              >Details</th>
              <th
                class='px-3 py-2 text-left text-xs font-bold text-slate-700 uppercase tracking-wider'
              >Issues</th>
              <th
                class='px-3 py-2 text-left text-xs font-bold text-slate-700 uppercase tracking-wider'
              >Documentation</th>
              <th
                class='px-3 py-2 text-left text-xs font-bold text-slate-700 uppercase tracking-wider'
              >Kelas</th>
              <th
                class='px-3 py-2 text-left text-xs font-bold text-slate-700 uppercase tracking-wider'
              >Status</th>
              <th
                class='px-3 py-2 text-left text-xs font-bold text-slate-700 uppercase tracking-wider'
              >Tanggal</th>
            </tr>
          </thead>
          <tbody class='divide-y divide-gray-200 bg-white'>
            <template
              x-for='(logbook, index) in paginatedLogbooks'
              :key='logbook.id'
            >
              <tr class='hover:bg-slate-50 transition-colors'>
                <td
                  class='px-3 py-2 text-xs font-medium text-gray-900'
                  x-text='((currentPage - 1) * itemsPerPage) + index + 1'
                ></td>
                <td
                  class='px-3 py-2 text-xs font-semibold text-gray-900'
                  x-text='logbook.kegiatan || "-"'
                ></td>
                <td class='px-3 py-2 text-xs text-gray-700'>
                  <div
                    class='max-w-xs truncate'
                    :title='logbook.rincian_kegiatan'
                    x-text='logbook.rincian_kegiatan || "-"'
                  ></div>
                </td>
                <td class='px-3 py-2 text-xs text-gray-700'>
                  <div
                    class='max-w-xs truncate'
                    :title='logbook.kendala'
                    x-text='logbook.kendala || "-"'
                  ></div>
                </td>
                <td class='px-3 py-2'>
                  <img
                    :src='logbook.dokumentasi'
                    alt='Documentation'
                    class='w-12 h-12 object-cover rounded-lg border border-gray-200 cursor-pointer hover:border-slate-400 hover:shadow-md transition-all transform hover:scale-105'
                    @click="window.open(logbook.dokumentasi, '_blank')"
                  />
                </td>
                <td class='px-3 py-2'>
                  <span
                    class='inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-300'
                  >
                    <i class='fas fa-graduation-cap mr-1 text-xs'></i>
                    <span
                      x-text='logbook.pertemuan?.minggu?.kelas?.nama_kelas || "-"'
                    ></span>
                  </span>
                </td>
                <td class='px-3 py-2'>
                  <span
                    class='inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold uppercase tracking-wide'
                    :class="{
                      'bg-green-100 text-green-700 border border-green-300': logbook.proses === 'acc',
                      'bg-yellow-100 text-yellow-700 border border-yellow-300': logbook.proses === 'proces',
                      'bg-red-100 text-red-700 border border-red-300': logbook.proses === 'rejected'
                    }"
                  >
                    <i
                      class='fas mr-1 text-xs'
                      :class="{
                      'fa-check-circle': logbook.proses === 'acc',
                      'fa-clock': logbook.proses === 'proces',
                      'fa-times-circle': logbook.proses === 'rejected'
                    }"
                    ></i>
                    <span
                      x-text="logbook.proses === 'acc' ? 'Approved' : logbook.proses === 'proces' ? 'Process' : 'Rejected'"
                    ></span>
                  </span>
                </td>
                <td
                  class='px-3 py-2 text-xs text-gray-700'
                  x-text='formatDate(logbook.createdAt)'
                ></td>

              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- No Data -->
      <div x-show='filteredLogbooks.length === 0' class='text-center py-16'>
        <div
          class='w-24 h-24 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4'
        >
          <i class='fas fa-clipboard-list text-slate-400 text-4xl'></i>
        </div>
        <h3 class='text-xl font-bold text-gray-900 mb-2 font-montserrat'>No
          Logbook Found</h3>
        <p class='text-gray-600 mb-6 font-inter max-w-md mx-auto'>
          No logbook data matches your selected filters.
        </p>
        <button
          @click='resetFilters()'
          class='bg-gradient-to-r from-slate-600 to-slate-800 hover:from-slate-700 hover:to-slate-900 text-white px-8 py-3 rounded-lg transition-all shadow-md hover:shadow-lg transform hover:-translate-y-0.5 font-semibold'
        >
          <i class='fas fa-undo-alt mr-2'></i>
          Reset Filters
        </button>
      </div>
    </div>

    <!-- Pagination -->
    <div
      class='flex justify-center items-center gap-4 mt-12'
      x-show='totalPages > 1'
    >
      <button
        @click='currentPage = Math.max(1, currentPage - 1)'
        :disabled='currentPage === 1'
        class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all shadow-sm hover:shadow-md'
      >
        <i class='fas fa-chevron-left'></i>
      </button>

      <template x-for='page in totalPages' :key='page'>
        <button
          @click='currentPage = page'
          class='w-12 h-12 rounded-xl text-lg font-semibold transition-all border shadow-sm'
          :class="currentPage === page ? 'bg-gradient-to-r from-slate-600 to-slate-800 text-white border-slate-700 shadow-md' : 'bg-white text-gray-700 border-gray-300 hover:bg-slate-50'"
          x-text='page'
        ></button>
      </template>

      <button
        @click='currentPage = Math.min(totalPages, currentPage + 1)'
        :disabled='currentPage === totalPages'
        class='px-5 py-3 bg-white border border-gray-300 hover:bg-slate-50 text-gray-700 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed transition-all shadow-sm hover:shadow-md'
      >
        <i class='fas fa-chevron-right'></i>
      </button>
    </div>
  </div>
</div>

<!-- SheetJS Library for Excel Export -->
<script
  src='https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js'
></script>

<script>
  function logbookApp() {
    return {
      allLogbooksRaw: {{{json logbook}}},
      allLogbooks: [],
      searchInput: '',
      search: '',
      currentPage: 1,
      itemsPerPage: 10,
      searchTimeout: null,

      debounceSearch() {
        clearTimeout(this.searchTimeout);
        this.searchTimeout = setTimeout(() => {
          this.search = this.searchInput;
          this.currentPage = 1;
        }, 500);
      },

      get filteredLogbooks() {
        let filtered = this.allLogbooksRaw;

        if (this.search) {
          const s = this.search.toLowerCase();

          filtered = filtered.filter(log =>
            (log.kegiatan || '').toLowerCase().includes(s) ||
            (log.rincian_kegiatan || '').toLowerCase().includes(s) ||
            (log.kendala || '').toLowerCase().includes(s) ||
            (log.pertemuan?.minggu?.kelas?.nama_kelas || '').toLowerCase().includes(s)
          );
        }

        return filtered;
      },

      get totalPages() {
        return Math.ceil(this.filteredLogbooks.length / this.itemsPerPage);
      },

      get paginatedLogbooks() {
        const start = (this.currentPage - 1) * this.itemsPerPage;
        return this.filteredLogbooks.slice(start, start + this.itemsPerPage);
      },

      resetFilters() {
        this.searchInput = '';
        this.search = '';
        this.currentPage = 1;
      },

      hasActiveFilters() {
        return this.search;
      },

      formatDate(date) {
        if (!date) return '-';

        return new Date(date).toLocaleDateString('id-ID', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
      },

      async exportToExcel() {
        try {
          const dataToExport = this.filteredLogbooks.map((log, index) => ({
            No: index + 1,
            Activity: log.kegiatan || '-',
            'Activity Details': log.rincian_kegiatan || '-',
            Issues: log.kendala || '-',
            Class: log.pertemuan?.minggu?.kelas?.nama_kelas || '-',
            Status:
              log.proses === 'acc'
                ? 'Approved'
                : log.proses === 'proces'
                ? 'Process'
                : 'Rejected',
            Date: this.formatDate(log.createdAt),
            Documentation: log.dokumentasi || '-'
          }));

          const wb = XLSX.utils.book_new();
          const ws = XLSX.utils.json_to_sheet(dataToExport);

          ws['!cols'] = [
            { wch: 5 },
            { wch: 30 },
            { wch: 50 },
            { wch: 40 },
            { wch: 25 },
            { wch: 12 },
            { wch: 20 },
            { wch: 60 }
          ];

          XLSX.utils.book_append_sheet(wb, ws, 'Logbook');
          XLSX.writeFile(wb, `Logbook_${new Date().toISOString().slice(0, 10)}.xlsx`);
        } catch (err) {
          alert('Failed to export data to Excel');
          console.error(err);
        }
      },

      confirmDelete(event) {
        if (confirm('Are you sure you want to delete this logbook?')) {
          event.target.closest('form').submit();
        }
      }
    };
  }
</script>
