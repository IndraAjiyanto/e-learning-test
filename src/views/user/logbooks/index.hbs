  <div class='container mx-auto pb-16'>

{{> user/logbook/index/header}}

{{> user/logbook/index/filter}}

{{> user/logbook/index/content}}
  </div>
</div>

{{> components/ui/super_admin/table/export_excel }}

<script>
  function logbookApp() {
    return {

      allLogbooksRaw: {{{json logbook}}},
      allLogbooks: [],
      searchInput: "",
      search: "",
      currentPage: 1,
      itemsPerPage: 10,
      searchTimeout: null,

      debounceSearch() {
        clearTimeout(this.searchTimeout);

        this.searchTimeout = setTimeout(() => {
          this.search = this.searchInput;
          this.currentPage = 1;
        }, 500);
      },

      get filteredLogbooks() {
        let filtered = this.allLogbooksRaw;

        if (this.search) {
          const s = this.search.toLowerCase();

          filtered = filtered.filter((log) =>
            (log.activity || "").toLowerCase().includes(s) ||
            (log.activityDetails || "").toLowerCase().includes(s) ||
            (log.obstacles || "").toLowerCase().includes(s) ||
            (log.session?.weeks?.course?.name || "")
              .toLowerCase()
              .includes(s)
          );
        }

        return filtered;
      },

      get totalPages() {
        return Math.ceil(this.filteredLogbooks.length / this.itemsPerPage);
      },

      get paginatedLogbooks() {
        const start = (this.currentPage - 1) * this.itemsPerPage;

        return this.filteredLogbooks.slice(
          start,
          start + this.itemsPerPage
        );
      },

      resetFilters() {
        this.searchInput = "";
        this.search = "";
        this.currentPage = 1;
      },

      hasActiveFilters() {
        return this.search;
      },

      formatDate(date) {
        if (!date) return "-";

        return new Date(date).toLocaleDateString("id-ID", {
          year: "numeric",
          month: "short",
          day: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        });
      },

      async exportToExcel() {
        try {
          await exportRowsToExcel({
            rows: this.filteredLogbooks,
            sheetName: 'Logbook',
            filePrefix: 'Logbook',
            columns: [
              { header: 'No', width: 5, value: (log, index) => index + 1 },
              { header: 'Activity', width: 30, value: (log) => log.activity || '-' },
              { header: 'Activity Details', width: 50, value: (log) => log.activityDetails || '-' },
              { header: 'Issues', width: 40, value: (log) => log.obstacles || '-' },
              { header: 'Class', width: 25, value: (log) => log.session?.weeks?.course?.name || '-' },
              {
                header: 'Status',
                width: 15,
                value: (log) =>
                  log.process === 'approved'
                    ? 'Approved'
                    : log.process === 'process'
                    ? 'Process'
                    : 'Rejected',
              },
              { header: 'Date', width: 20, value: (log) => this.formatDate(log.createdAt) },
              { header: 'Documentation', width: 28, value: (log) => log.documentation, isImage: true },
            ],
          });
        } catch (err) {
          showErrorToast('Export failed', 'The logbook could not be exported to Excel.');
          console.error(err);
        }
      },
    };
  }
</script>
{{/user/shell_frame/index}}
