<div class='py-20 min-h-screen bg-white' x-data='logbookApp()'>
  <div class='container mx-auto px-4 pb-16'>

{{> user/logbook/index/header}}

{{> user/logbook/index/filter}}

{{> user/logbook/index/content}}
  </div>
</div>

<script
  src='https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js'
></script>

<script>
  function logbookApp() {
    return {

      allLogbooksRaw: {{{json logbook}}},
      allLogbooks: [],
      searchInput: "",
      search: "",
      currentPage: 1,
      itemsPerPage: 10,
      searchTimeout: null,

      debounceSearch() {
        clearTimeout(this.searchTimeout);

        this.searchTimeout = setTimeout(() => {
          this.search = this.searchInput;
          this.currentPage = 1;
        }, 500);
      },

      get filteredLogbooks() {
        let filtered = this.allLogbooksRaw;

        if (this.search) {
          const s = this.search.toLowerCase();

          filtered = filtered.filter((log) =>
            (log.activity || "").toLowerCase().includes(s) ||
            (log.activityDetails || "").toLowerCase().includes(s) ||
            (log.obstacles || "").toLowerCase().includes(s) ||
            (log.session?.weeks?.course?.name || "")
              .toLowerCase()
              .includes(s)
          );
        }

        return filtered;
      },

      get totalPages() {
        return Math.ceil(this.filteredLogbooks.length / this.itemsPerPage);
      },

      get paginatedLogbooks() {
        const start = (this.currentPage - 1) * this.itemsPerPage;

        return this.filteredLogbooks.slice(
          start,
          start + this.itemsPerPage
        );
      },

      resetFilters() {
        this.searchInput = "";
        this.search = "";
        this.currentPage = 1;
      },

      hasActiveFilters() {
        return this.search;
      },

      formatDate(date) {
        if (!date) return "-";

        return new Date(date).toLocaleDateString("id-ID", {
          year: "numeric",
          month: "short",
          day: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        });
      },

      async exportToExcel() {
        try {
          const dataToExport = this.filteredLogbooks.map((log, index) => ({
            No: index + 1,
            Activity: log.activity || "-",
            "Activity Details": log.activityDetails || "-",
            Issues: log.obstacles || "-",
            Class: log.session?.weeks?.course?.name || "-",
            Status:
              log.process === "acc"
                ? "Approved"
                : log.process === "proces"
                ? "Process"
                : "Rejected",
            Date: this.formatDate(log.createdAt),
            Documentation: log.dokumentasi || "-",
          }));

          const wb = XLSX.utils.book_new();
          const ws = XLSX.utils.json_to_sheet(dataToExport);

          ws["!cols"] = [
            { wch: 5 },
            { wch: 30 },
            { wch: 50 },
            { wch: 40 },
            { wch: 25 },
            { wch: 12 },
            { wch: 20 },
            { wch: 60 },
          ];

          XLSX.utils.book_append_sheet(wb, ws, "Logbook");

          XLSX.writeFile(
            wb,
            `Logbook_${new Date().toISOString().slice(0, 10)}.xlsx`
          );
        } catch (err) {
          alert("Failed to export data to Excel");
          console.error(err);
        }
      },
    };
  }
</script>