{{!-- Dibungkus chrome backoffice. Halaman ini ditautkan dari dalam area
     belajar tetapi punya rute sendiri; sebelumnya memakai navbar publik
     dan footer. Controller-nya merender dengan bareShell: true.
     Lihat docs/user-area-learning-consolidation-plan.md tahap 2. --}}
{{#> user/shell_frame/index user=user active='learning'}}
<div
  class='min-h-full bg-[#FAFAFA] py-8'
>
  <div class='max-w-6xl mx-auto px-6'>
    <div class='bg-white rounded-xl border border-[#E5E5E5] shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] p-6'>
      <h2
        class='text-2xl sm:text-3xl font-bold text-gray-900 mb-8 text-center font-montserrat'
      >{{t 'test.logbook.createLogBook.logbookForm'}}</h2>

      <form
        x-data='{ loading: false }'
        @submit='loading = true'
        action='/logbooks/{{sessionId}}'
        method='POST'
        enctype='multipart/form-data'
      >
        <div class='grid grid-cols-1 lg:grid-cols-2 gap-8'>

          <!-- Kolom Kiri -->
          <div class='space-y-6'>
            <!-- Activity -->
            <div>
              <label
                for="activity"
                class='block text-lg font-semibold text-[#404040] mb-3'
              >{{t 'test.logbook.createLogBook.activity'}}</label>
              <input
                type='text'
                id="activity"
                name="activity"
                required
                placeholder='{{t
                  "test.logbook.createLogBook.placeholderActivity"
                }}'
                class='w-full h-[44px] px-[14px] bg-white border border-[#D4D4D4] rounded-[8px] font-inter text-base text-[#404040] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-colors'
              />
            </div>

            <!-- Activity Details -->
            <div>
              <label
                for="activityDetails"
                class='block text-lg font-semibold text-[#404040] mb-3'
              >{{t 'test.logbook.createLogBook.activityDetails'}}</label>
              <textarea
                name="activityDetails"
                id="activityDetails"
                required
                placeholder='{{t
                  "test.logbook.createLogBook.placeholderActivityDetails"
                }}'
                rows='6'
                class='w-full px-[14px] py-[10px] bg-white border border-[#D4D4D4] rounded-[8px] font-inter text-base text-[#404040] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-colors resize-none'
              ></textarea>
            </div>
          </div>

          <!-- Kolom Kanan -->
          <div class='space-y-6'>

            <div>
              <label
                for="obstacles"
                class='block text-lg font-semibold text-[#404040] mb-3'
              >{{t 'test.logbook.createLogBook.obstacles'}}</label>
              <input
                type='text'
                id="obstacles"
                name="obstacles"
                required
                placeholder='{{t
                  "test.logbook.createLogBook.placeholderObstacles"
                }}'
                class='w-full h-[44px] px-[14px] bg-white border border-[#D4D4D4] rounded-[8px] font-inter text-base text-[#404040] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-colors'
              />
            </div>

            <!-- Photo Documentation — dengan crop agar tidak terlalu zoom -->
            <div x-data='{ previewUrl: null, showFull:false }' class='space-y-4'
              @crop-done-documentation.window="previewUrl = URL.createObjectURL($event.detail.file)"
              @crop-cancel-documentation.window="previewUrl = null; $refs.fileInput && ($refs.fileInput.value = null)"
            >
              <label
                for='documentation'
                class='block text-lg font-semibold text-[#404040] mb-3'
              >
                {{t 'test.logbook.createLogBook.photoDocumentation'}}
              </label>
              <p class='-mt-2 text-xs text-[#737373]'>Pilih foto lalu atur crop — preview memakai <span class='font-semibold'>object-contain</span> agar tidak terpotong/zoom.</p>
              <input
                type='file'
                id='documentation'
                name='documentation'
                accept='image/jpeg,image/jpg,image/png,.jpg,.jpeg,.png'
                x-ref='fileInput'
                class='w-full border border-[#D4D4D4] rounded-xl px-5 py-4 bg-white/70 hover:bg-white focus:outline-none focus:border-[#003060] focus:border-[#D4D4D4] transition-all duration-300 text-[#404040] file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-slate-100 file:text-[#404040] hover:file:bg-slate-200'
                @change="$dispatch('crop-open-documentation', { file: $event.target.files[0] })"
              />

              <!-- Image Preview — diperbesar memenuhi layar, object-contain -->
              <template x-if='previewUrl'>
                <div class='relative'>
                  <div
                    class='p-2 sm:p-4 bg-white rounded-xl border border-[#E5E5E5] flex justify-center cursor-zoom-in group'
                    @click='showFull=true'
                  >
                    <img
                      :src='previewUrl'
                      alt='Photo Preview'
                      class='w-full max-h-[520px] min-h-[320px] object-contain rounded-lg border border-[#E5E5E5] bg-white p-1 shadow-sm mx-auto group-hover:border-[#93c5fd]'
                    />
                    <div class='absolute left-4 top-4 rounded-full bg-black/60 px-3 py-1 text-xs font-medium text-white'>Klik untuk fullscreen</div>
                    <button
                      type='button'
                      class='absolute -top-2 -right-2 bg-red-500 text-white w-8 h-8 rounded-full flex items-center justify-center shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)] hover:bg-red-600 transition-all duration-300'
                      @click.stop='previewUrl = null; $refs.fileInput.value = null;'
                    >
                      <svg
                        class='w-4 h-4'
                        fill='none'
                        stroke='currentColor'
                        viewBox='0 0 24 24'
                      >
                        <path
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          stroke-width='2'
                          d='M6 18L18 6M6 6l12 12'
                        />
                      </svg>
                    </button>
                  </div>
                </div>
              </template>
              <div x-show='showFull && previewUrl' x-transition.opacity x-cloak @click.self='showFull=false' @keydown.escape.window='showFull=false' class='fixed inset-0 z-[70] flex items-center justify-center bg-black/85 p-4 sm:p-8'>
                <button @click='showFull=false' class='absolute right-4 top-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-[#0f172a] hover:bg-white'>
                  <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg>
                </button>
                <img :src='previewUrl' alt='Fullscreen' class='max-h-[88vh] max-w-[92vw] w-auto h-auto object-contain rounded-xl bg-white p-1 shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]' />
              </div>
              {{> components/ui/admin/logbook/logbook-crop-modal inputId='documentation' size=1200 }}
            </div>

            <div>
              <label
                for="otherDocumentation"
                class='block text-lg font-semibold text-[#404040] mb-3'
              >
                {{t 'test.logbook.createLogBook.linkDocumentation'}}
              </label>
              <input
                type='text'
                id="otherDocumentation"
                name="otherDocumentation"
                required
                placeholder='{{t
                  "test.logbook.createLogBook.placeholderLinkDocumentation"
                }}'
                class='w-full h-[44px] px-[14px] bg-white border border-[#D4D4D4] rounded-[8px] font-inter text-base text-[#404040] placeholder:text-[#A3A3A3] focus:outline-none focus:border-[#003060] transition-colors'
              />
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div
          class='flex items-center gap-4 pt-10 mt-8 border-t border-[#E5E5E5]'
        >
          <button
            type='submit'
            class='inline-flex h-[44px] items-center justify-center gap-2 rounded-[8px] bg-[#003060] px-[18px] font-inter text-base font-semibold text-white transition-colors hover:bg-[#00254a] flex-1'
          >
            <span
              x-show='loading'
              class='loading loading-spinner loading-sm'
            ></span>
            <span x-show='!loading'>{{t
                'test.logbook.createLogBook.addLogbook'
              }}</span>
          </button>
          <a
            href='/program/{{courseId}}'
            :disabled='loading'
            class='inline-flex h-[44px] items-center justify-center gap-2 rounded-[8px] border border-[#D4D4D4] bg-white px-[18px] font-inter text-base font-semibold text-[#003060] shadow-[0px_1px_2px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#F5F5F5] flex-1'
          >
            {{t 'test.logbook.createLogBook.cancel'}}
          </a>
        </div>
      </form>
    </div>
  </div>
</div>
{{/user/shell_frame/index}}
