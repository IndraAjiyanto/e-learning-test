# --- App ---
PORT=3069
APP_URL=http://localhost:3069
APP_URL_LMS=http://localhost:3069

# --- Database (TypeORM / Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=e_learning_test

# --- Cloudinary (media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Slides conversion (Google Drive API) ---
# For a regular Gmail account, prefer OAuth credentials. The refresh token is
# generated once with the Drive scope and uses that user's storage quota.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Share GOOGLE_DRIVE_FOLDER_ID with this service account as Editor.
# For a Google Workspace Shared Drive, use a folder inside that Shared Drive.
# For a regular My Drive folder, optionally impersonate a Workspace user with
# domain-wide delegation so uploads use that user's storage quota.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_IMPERSONATED_USER=
GOOGLE_SLIDES_PUBLIC=true

# --- Xendit (payments) ---
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# --- Mail (nodemailer) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=E-Learning

# --- LibreOffice (pptx/pdf conversion) ---
LIBREOFFICE_PATH=/usr/bin/soffice
LIBREOFFICE_TEMP_DIR=/tmp
