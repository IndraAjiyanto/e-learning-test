# --- App ---
PORT=3069
APP_URL=http://localhost:3069
APP_URL_LMS=http://localhost:3069

# --- Database (TypeORM / Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=e_learning_test
# set to true only for first run if you want auto-schema; prefer migrations
SYNCHRONIZE=false

# --- Cloudinary (media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Xendit (payments) ---
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# --- Mail (nodemailer) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=E-Learning

# --- LibreOffice (pptx/pdf conversion) ---
LIBREOFFICE_PATH=/usr/bin/soffice
LIBREOFFICE_TEMP_DIR=/tmp
