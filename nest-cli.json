{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
        "assets": [
      {
        "include": "common/public/**/*",
        "outDir": "dist"
      },
      {
        "include": "i18n/**/*",
        "outDir": "dist"
      },
      {
        "include": "views/**/*",
        "outDir": "dist"
      }
    ],
    "watchAssets": true
  }
}
